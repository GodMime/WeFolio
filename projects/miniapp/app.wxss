/**app.wxss**/
page {
  min-height: 100vh;
  color: #17202a;
  background: #f5f7fb;
  font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue", sans-serif;
}

button {
  margin: 0;
  padding: 0;
  line-height: 1;
  border-radius: 0;
  background: transparent;
}

button::after {
  border: 0;
}

.page-shell {
  min-height: 100vh;
  background:
    linear-gradient(180deg, #eef6f4 0%, #f5f7fb 34%, #f5f7fb 100%);
}
