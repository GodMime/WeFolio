/**app.wxss**/
page {
  min-height: 100vh;
  color: #212529;
  background: #f5f6f7;
  font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue",
    "PingFang SC", "Microsoft YaHei", sans-serif;
}

button {
  margin: 0;
  padding: 0;
  line-height: 1;
  border-radius: 0;
  background: transparent;
}

button::after {
  border: 0;
}

.page-shell {
  min-height: 100vh;
  background: #f5f6f7;
}

.user-authored-text,
.profile-bio,
.section-desc,
.text-content,
.work-desc,
.message-content,
.summary-desc,
.team-summary,
.member-summary,
.candidate-summary,
.confirm-desc,
.visit-summary {
  white-space: pre-wrap;
  overflow-wrap: break-word;
  word-break: break-word;
}
