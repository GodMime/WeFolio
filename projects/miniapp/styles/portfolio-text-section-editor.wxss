.text-section-form {
  flex: 1 1 auto;
  height: 0;
  min-height: 0;
}

.text-section-form-content {
  padding: 4rpx 0 8rpx;
}

.text-section-actions {
  flex: none;
}

.text-section-font-list {
  margin-top: 12rpx;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.text-section-font-option {
  min-height: 104rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding: 16rpx 18rpx;
  border: 1rpx solid var(--pe-color-border, #E9ECEF);
  border-radius: var(--pe-radius-control, 28rpx);
  background: var(--pe-color-page, #F5F6F7);
  box-sizing: border-box;
}

.text-section-font-option[aria-checked="true"] .schedule-query-mode-radio {
  border-color: var(--pe-color-text-primary, #212529);
  background: var(--pe-color-text-primary, #212529);
  box-shadow: inset 0 0 0 7rpx var(--pe-color-surface, #FFFFFF);
}

.text-section-font-option[aria-checked="true"] .text-section-alignment-radio {
  border-color: var(--pe-color-text-primary, #212529);
  background: var(--pe-color-text-primary, #212529);
  box-shadow: inset 0 0 0 7rpx var(--pe-color-surface, #FFFFFF);
}

.text-section-font-option.disabled[aria-checked="false"] {
  opacity: 0.56;
}

.text-section-font-copy {
  min-width: 0;
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.text-section-font-label {
  color: var(--pe-color-text-primary, #212529);
  font-size: 24rpx;
  font-weight: 900;
}

.text-section-font-sample {
  color: var(--pe-color-text-strong, #495057);
  font-size: 25rpx;
  line-height: 1.4;
}

.text-section-font-hint {
  color: var(--pe-color-text-muted, #ADB5BD);
  font-size: 20rpx;
  font-weight: 700;
}

.text-section-font-hint.current {
  color: var(--pe-color-text-secondary, #868E96);
}

.text-section-size-list {
  margin-top: 12rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.text-section-size-option {
  min-width: 104rpx;
  min-height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 18rpx;
  color: var(--pe-color-text-secondary, #868E96);
  font-size: 23rpx;
  font-weight: 800;
  border: 1rpx solid var(--pe-color-border, #E9ECEF);
  border-radius: var(--pe-radius-pill, 999rpx);
  background: var(--pe-color-page, #F5F6F7);
  box-sizing: border-box;
}

.text-section-size-option.custom {
  min-width: 176rpx;
}
