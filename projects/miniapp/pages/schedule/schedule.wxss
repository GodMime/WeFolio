.schedule-page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  background-color: #f5f6f7;
}

.schedule-scroll {
  flex: 1;
  min-height: 0;
}

.schedule-content {
  padding: 20rpx 32rpx calc(144rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.schedule-segmented {
  position: relative;
  display: flex;
  gap: 0;
  padding: 0;
  border: 0;
  border-bottom: 1rpx solid #e9ecef;
  border-radius: 0;
  background: transparent;
}

.segment {
  position: relative;
  flex: 1 1 0;
  min-width: 0;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0;
  color: #868e96;
  font-size: 26rpx;
  font-weight: 500;
  line-height: 1;
  border-radius: 0;
  background: transparent;
}

.segment::after,
.tab::after,
.outline-button::after,
.mini-action::after,
.primary-button::after,
.secondary-button::after,
.month-control::after {
  border: 0;
}

.segment.active {
  color: #212529;
  font-weight: 600;
  background: transparent;
  box-shadow: none;
}

.segment-indicator {
  position: absolute;
  left: 25%;
  bottom: -1rpx;
  z-index: 2;
  width: 48rpx;
  height: 5rpx;
  margin-left: -24rpx;
  border-radius: 999rpx;
  background: #212529;
  pointer-events: none;
  transition: left 220ms cubic-bezier(0.22, 1, 0.36, 1);
}

.segment-indicator.second-active {
  left: 75%;
}

.panel,
.calendar-group,
.day-panel {
  margin-top: 20rpx;
  padding: 28rpx;
  border: 1rpx solid #e9ecef;
  border-radius: 48rpx;
  background: #ffffff;
  box-shadow: none;
  box-sizing: border-box;
}

.calendar-group {
  padding: 0;
  overflow: hidden;
  border-color: #e9ecef;
  border-radius: 48rpx;
  background: #ffffff;
}

.panel-heading,
.slot-line,
.schedule-line,
.slot-main,
.schedule-slot-card-top,
.schedule-slot-grid,
.schedule-status-row,
.calendar-toolbar,
.tabbar,
.tab,
.button-row,
.choice-row {
  display: flex;
  align-items: center;
}

.panel-heading,
.slot-line,
.schedule-line,
.calendar-toolbar,
.button-row {
  justify-content: space-between;
}

.panel-title {
  color: #212529;
  font-size: 28rpx;
  font-weight: 800;
  line-height: 1.3;
}

.panel-meta,
.slot-desc,
.month-sub,
.empty-desc,
.legend-empty {
  color: #868e96;
  font-size: 23rpx;
  line-height: 1.4;
}

.outline-button,
.mini-action {
  width: 128rpx;
  min-width: 128rpx;
  max-width: 128rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
  margin: 0;
  padding: 0;
  box-sizing: border-box;
  color: #0f766e;
  font-size: 24rpx;
  font-weight: 800;
  line-height: 1;
  border: 1rpx solid #bfd7d2;
  border-radius: 999rpx;
  background: #f2fbf8;
}

.mini-action.warn {
  color: #8a4b09;
  border-color: #f0d4a5;
  background: #fff8ea;
}

.mini-action.danger {
  color: #a9354f;
  border-color: #f3c5cf;
  background: #fff3f6;
}

.slot-toggle-action {
  width: 112rpx;
  min-width: 112rpx;
  max-width: 112rpx;
  height: 56rpx;
  color: #212529;
  font-size: 22rpx;
  font-weight: 600;
  border: 0;
  border-radius: 999rpx;
  background: #f5f6f7;
}

.mini-action.warn.slot-toggle-action {
  color: #212529;
  border: 0;
  background: #f5f6f7;
}

.color-legend {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 18rpx;
}

.swatch-option {
  min-width: 0;
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 10rpx 14rpx;
  color: #495057;
  font-size: 22rpx;
  border-radius: 999rpx;
  background: #f5f6f7;
}

.swatch {
  width: 22rpx;
  height: 22rpx;
  flex: none;
  border-radius: 50%;
}

.slot-line,
.schedule-line {
  min-height: 0;
  padding: 18rpx 0;
  gap: 18rpx;
}

.slot-swipe-row {
  position: relative;
  overflow: hidden;
  border-top: 1rpx solid #f1f3f5;
}

.schedule-swipe-row {
  position: relative;
  overflow: hidden;
  border-top: 1rpx solid #f1f3f5;
}

.slot-swipe-row:first-of-type,
.schedule-swipe-row:first-of-type {
  border-top: 0;
}

.slot-swipe-row .slot-line {
  position: relative;
  z-index: 2;
  border-top: 0;
  background: #ffffff;
  transition: transform 180ms ease;
}

.schedule-swipe-row .schedule-line {
  position: relative;
  z-index: 2;
  border-top: 0;
  background: #ffffff;
  transition: transform 180ms ease;
}

.slot-swipe-row.revealed .slot-line {
  transform: translateX(-140rpx);
}

.schedule-swipe-row.revealed .schedule-line {
  transform: translateX(-140rpx);
}

.slot-delete-pane {
  position: absolute;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 1;
  width: 128rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.schedule-delete-pane {
  position: absolute;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 1;
  width: 128rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.slot-main {
  flex: 1;
  min-width: 0;
  justify-content: flex-start;
  gap: 16rpx;
}

.slot-copy {
  min-width: 0;
}

.slot-actions {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  flex: none;
  gap: 12rpx;
}

.slot-name {
  overflow: hidden;
  color: #17202a;
  font-size: 28rpx;
  font-weight: 800;
  line-height: 1.3;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.calendar-toolbar {
  min-height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: flex-start;
  flex-wrap: nowrap;
  gap: 12rpx;
  margin-bottom: 0;
  padding: 12rpx 16rpx;
  border-bottom: 1rpx solid #d8e0e8;
  box-sizing: border-box;
}

.month-control {
  width: 64rpx;
  min-width: 64rpx;
  max-width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 64rpx;
  margin: 0;
  padding: 0;
  box-sizing: border-box;
  color: #36516e;
  font-size: 32rpx;
  font-weight: 800;
  line-height: 1;
  border: 2rpx solid #d8e0e8;
  border-radius: 50%;
  background: #f8fbfd;
}

.month-control.wide {
  width: 132rpx;
  min-width: 132rpx;
  max-width: 132rpx;
  flex: none;
  padding: 0 18rpx;
  color: #17202a;
  font-size: 26rpx;
  border-radius: 999rpx;
  white-space: nowrap;
}

.month-picker {
  flex: none;
  min-width: 0;
  margin-right: 12rpx;
}

.month-title {
  flex: 1 1 0;
  min-width: 0;
  display: flex;
  align-items: center;
  justify-content: flex-start;
  padding: 0 4rpx;
  overflow: hidden;
  text-align: left;
  box-sizing: border-box;
}

.month-main {
  max-width: 100%;
  overflow: hidden;
  color: #17202a;
  font-size: 36rpx;
  font-weight: 900;
  line-height: 1.1;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.month-sub {
  max-width: 100%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.day-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  padding: 12rpx 0 18rpx;
}

.day-date-copy {
  flex: 1 1 0;
  min-width: 0;
  display: flex;
  align-items: baseline;
  gap: 18rpx;
}

.day-title {
  min-width: 0;
  overflow: hidden;
  color: #17202a;
  font-size: 36rpx;
  font-weight: 900;
  line-height: 1.2;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.day-lunar-title {
  flex: none;
  color: #66727f;
  font-size: 26rpx;
  font-weight: 800;
  line-height: 1.2;
  white-space: nowrap;
}

.day-summary {
  flex: none;
  color: #758190;
  font-size: 24rpx;
  font-weight: 800;
  line-height: 1.3;
  text-align: right;
  white-space: nowrap;
}

.calendar {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx 0;
  justify-content: space-between;
  padding: 18rpx 20rpx 20rpx;
  background: #ffffff;
  box-sizing: border-box;
}

.weekday {
  flex: 0 0 calc((100% - 36rpx) / 7);
  width: calc((100% - 36rpx) / 7);
  min-height: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  color: #17202a;
  font-size: 28rpx;
  font-weight: 900;
  text-align: center;
}

.calendar-day {
  position: relative;
  flex: 0 0 calc((100% - 36rpx) / 7);
  width: calc((100% - 36rpx) / 7);
  min-height: 112rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: space-between;
  padding: 12rpx 6rpx 10rpx;
  box-sizing: border-box;
  color: #17202a;
  border: 2rpx solid #d8e0e8;
  border-radius: 14rpx;
  background: #ffffff;
  text-align: center;
  overflow: hidden;
}

.calendar-day.muted {
  color: #b6c0ca;
}

.calendar-day.selected {
  color: #17202a;
  border-color: #d8e0e8;
  background: #ffffff;
}

.date-stack {
  min-width: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
}

.calendar-day.selected .date-stack {
  width: 76rpx;
  height: 76rpx;
  color: #ffffff;
  border-radius: 50%;
  background: #212529;
  box-shadow: none;
}

.day-number {
  font-size: 34rpx;
  font-weight: 900;
  line-height: 1;
}

.day-meta {
  max-width: 100%;
  overflow: hidden;
  color: #66727f;
  font-size: 22rpx;
  font-weight: 800;
  line-height: 1.1;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.calendar-day.muted .day-meta {
  color: #b6c0ca;
}

.calendar-day.selected .day-meta {
  color: #ffffff;
}

.day-colors {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  align-items: center;
  gap: 6rpx;
  min-height: 12rpx;
  margin-top: 8rpx;
}

.day-color {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
}

.schedule-status {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  flex: none;
  padding: 0;
  font-size: 22rpx;
  font-weight: 800;
  line-height: 1;
  background: transparent;
}

.schedule-status::before {
  width: 12rpx;
  height: 12rpx;
  flex: none;
  content: "";
  border-radius: 50%;
  background: currentColor;
}

.slot-status {
  flex: none;
  padding: 12rpx 24rpx;
  font-size: 24rpx;
  font-weight: 800;
  line-height: 1;
  border: 2rpx solid transparent;
  border-radius: 999rpx;
  box-sizing: border-box;
}

.schedule-status.teal {
  color: #0f766e;
}

.slot-status.active {
  color: #529463;
  border-color: #cde2d4;
  background: #ffffff;
}

.schedule-status.amber {
  color: #8a4b09;
}

.schedule-status.rose {
  color: #a9354f;
}

.schedule-status.muted {
  color: #66727f;
}

.slot-status.muted {
  color: #868e96;
  border-color: #d9dee2;
  background: #ffffff;
}

.inline-empty,
.empty-state {
  padding: 72rpx 28rpx;
  text-align: center;
  box-sizing: border-box;
}

.empty-state {
  min-height: 520rpx;
}

.inline-empty.compact {
  padding: 32rpx 20rpx;
}

.component-loading {
  min-height: 168rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  padding: 36rpx 24rpx;
  box-sizing: border-box;
  color: #758190;
  font-size: 24rpx;
  font-weight: 700;
  text-align: center;
}

.component-loading.compact {
  min-height: 96rpx;
  width: 100%;
  padding: 18rpx 0;
  flex-direction: row;
}

.calendar-region {
  position: relative;
  min-height: 724rpx;
  background: #ffffff;
}

.calendar.loading {
  opacity: 0.42;
}

.day-list-region {
  min-height: 168rpx;
}

.day-list-loading {
  min-height: 210rpx;
}

.component-loading-overlay,
.component-error-overlay {
  position: absolute;
  left: 20rpx;
  right: 20rpx;
  top: 18rpx;
  bottom: 20rpx;
  z-index: 2;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  padding: 28rpx;
  box-sizing: border-box;
  border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.84);
  text-align: center;
}

.component-error-overlay {
  background: rgba(255, 255, 255, 0.96);
}

.loading-spinner {
  width: 36rpx;
  height: 36rpx;
  border: 4rpx solid #d8e0e8;
  border-top-color: #3d6fad;
  border-radius: 50%;
  animation: loading-spin 820ms linear infinite;
  box-sizing: border-box;
}

.loading-copy {
  color: #758190;
  font-size: 24rpx;
  font-weight: 800;
  line-height: 1.3;
}

.empty-icon {
  width: 92rpx;
  height: 92rpx;
  margin: 0 auto 26rpx;
  border-radius: 50%;
  background: #dce7e4;
}

.empty-title {
  color: #17202a;
  font-size: 32rpx;
  font-weight: 800;
}

.empty-title.small {
  font-size: 28rpx;
}

.primary-button,
.secondary-button {
  height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 1 1 0;
  min-width: 0;
  margin: 0;
  font-size: 28rpx;
  font-weight: 800;
  border-radius: 999rpx;
}

.primary-button {
  height: 96rpx;
  color: #ffffff;
  border-radius: 999rpx;
  background: #212529;
}

.primary-button.compact {
  display: inline-flex;
  min-width: 176rpx;
  height: 76rpx;
  margin-top: 30rpx;
  padding: 0 30rpx;
  flex: none;
}

.schedule-add-button {
  width: 100%;
  min-width: 100%;
  max-width: 100%;
  margin-top: 24rpx;
  flex: none;
  box-sizing: border-box;
}

.definition-add-button {
  width: 100%;
  min-width: 100%;
  max-width: 100%;
  margin-top: 24rpx;
  flex: none;
  box-sizing: border-box;
}

.secondary-button {
  color: #212529;
  border: 0;
  background: #f5f6f7;
}

.skeleton-panel {
  min-height: 120rpx;
  border-color: transparent;
  background: linear-gradient(90deg, #eef1f4 0%, #f8fafb 52%, #eef1f4 100%);
  background-size: 400rpx 100%;
  animation: skeleton 1.2s ease-in-out infinite;
}

.skeleton-panel.tall {
  min-height: 560rpx;
}

.definition-sheet-overlay {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 20;
  display: flex;
  align-items: flex-end;
  padding: 0;
  opacity: 0;
  pointer-events: none;
  background: rgba(23, 32, 42, 0.36);
  transition: opacity 180ms ease;
  box-sizing: border-box;
}

.schedule-sheet-overlay {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 20;
  display: flex;
  align-items: flex-end;
  padding: 0;
  opacity: 0;
  pointer-events: none;
  background: rgba(23, 32, 42, 0.36);
  transition: opacity 180ms ease;
  box-sizing: border-box;
}

.definition-sheet-overlay.visible {
  opacity: 1;
  pointer-events: auto;
}

.schedule-sheet-overlay.visible {
  opacity: 1;
  pointer-events: auto;
}

.definition-sheet {
  width: 100%;
  padding: 28rpx 32rpx calc(28rpx + env(safe-area-inset-bottom));
  border-radius: 56rpx 56rpx 0 0;
  background: #ffffff;
  box-sizing: border-box;
  transform: translateY(32rpx);
  transition: transform 180ms ease;
}

.schedule-sheet {
  width: 100%;
  max-height: calc(92vh - env(safe-area-inset-bottom));
  padding: 28rpx 32rpx calc(28rpx + env(safe-area-inset-bottom));
  overflow-y: auto;
  border-radius: 56rpx 56rpx 0 0;
  background: #ffffff;
  box-sizing: border-box;
  transform: translateY(32rpx);
  transition: transform 180ms ease;
}

.definition-sheet-overlay.visible .definition-sheet {
  transform: translateY(0);
}

.schedule-sheet-overlay.visible .schedule-sheet {
  transform: translateY(0);
}

.sheet-grabber {
  width: 72rpx;
  height: 8rpx;
  margin: 0 auto 22rpx;
  border-radius: 999rpx;
  background: #d8e0e8;
}

.form-grid {
  display: flex;
  gap: 16rpx;
  margin-top: 18rpx;
}

.slot-control-row {
  align-items: flex-start;
}

.slot-control-row > picker {
  flex: 1 1 0;
  min-width: 0;
}

.form-row {
  flex: 1 1 0;
  min-width: 0;
}

.form-row.full {
  margin-top: 22rpx;
}

.status-form-row {
  flex: 2 1 0;
}

.field-label {
  color: #868e96;
  font-size: 22rpx;
  font-weight: 700;
}

.field-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.field-limit {
  flex: none;
  color: #adb5bd;
  font-size: 22rpx;
  font-weight: 700;
  line-height: 1.3;
}

.field-label.standalone {
  margin-top: 22rpx;
}

.field-input {
  width: 100%;
  height: 84rpx;
  min-height: 84rpx;
  margin-top: 10rpx;
  padding: 0 18rpx;
  color: #212529;
  font-size: 26rpx;
  border-radius: 999rpx;
  background: #f5f6f7;
  box-sizing: border-box;
}

.field-input.textarea {
  min-height: 156rpx;
  border-radius: 40rpx;
  padding-top: 18rpx;
  line-height: 1.45;
}

.picker-value {
  display: flex;
  align-items: center;
}

.choice-row,
.slot-color-grid,
.schedule-slot-grid,
.schedule-status-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 12rpx;
}

.slot-color-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx 0;
  justify-content: space-between;
}

.schedule-slot-grid {
  display: flex;
  flex-wrap: wrap;
  align-items: stretch;
  gap: 16rpx;
}

.schedule-status-row {
  display: flex;
  flex-wrap: wrap;
}

.schedule-slot-card {
  width: calc(50% - 8rpx);
  min-height: 126rpx;
  padding: 20rpx;
  border: 2rpx solid #f1f3f5;
  border-radius: 36rpx;
  background: #ffffff;
  box-sizing: border-box;
}

.schedule-slot-card.active {
  border-color: #212529;
  background: #ffffff;
}

.schedule-slot-card.disabled {
  opacity: 0.48;
}

.schedule-slot-card-top {
  justify-content: space-between;
  gap: 12rpx;
}

.schedule-status-choice {
  height: 58rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 22rpx;
  color: #868e96;
  font-size: 24rpx;
  font-weight: 800;
  border-radius: 999rpx;
  background: #f5f6f7;
}

.schedule-status-choice.active.teal {
  color: #ffffff;
  background: #212529;
}

.schedule-status-choice.active.amber {
  color: #ffffff;
  background: #212529;
}

.schedule-status-choice.active.rose {
  color: #ffffff;
  background: #212529;
}

.schedule-status-choice.active.muted {
  color: #ffffff;
  background: #212529;
}

.inline-choice-row {
  height: 76rpx;
  flex-wrap: nowrap;
  gap: 8rpx;
  margin-top: 10rpx;
}

.slot-status-choice {
  height: 76rpx;
  flex: 1 1 0;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 10rpx;
  color: #868e96;
  font-size: 24rpx;
  font-weight: 800;
  border: 0;
  border-radius: 999rpx;
  background: #f5f6f7;
  box-sizing: border-box;
}

.slot-status-choice.teal {
  color: #868e96;
  border-color: transparent;
  background: #f5f6f7;
}

.slot-status-choice.muted {
  color: #868e96;
  border-color: transparent;
  background: #f5f6f7;
}

.slot-status-choice.active {
  color: #ffffff;
  background: #212529;
  box-shadow: none;
}

.slot-color-choice {
  width: calc((100% - 36rpx) / 4);
  min-height: 64rpx;
  min-width: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  flex: 0 0 calc((100% - 36rpx) / 4);
  padding: 0 10rpx;
  color: #40464d;
  border: 4rpx solid transparent;
  border-radius: 999rpx;
  background: #f3f5f6;
  box-sizing: border-box;
}

.slot-color-choice.active {
  color: #1e2125;
  border-color: #1e2125;
  background: #ffffff;
}

.slot-color-choice.disabled {
  opacity: 0.36;
}

.slot-color-swatch {
  width: 20rpx;
  height: 20rpx;
  flex: none;
  border-radius: 50%;
}

.slot-color-name {
  overflow: hidden;
  font-size: 21rpx;
  font-weight: 800;
  line-height: 1;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.button-row {
  gap: 16rpx;
  margin-top: 22rpx;
}

.tabbar {
  position: fixed;
  left: 28rpx;
  right: 28rpx;
  bottom: calc(28rpx + env(safe-area-inset-bottom));
  z-index: 10;
  height: 116rpx;
  padding: 0;
  justify-content: space-around;
  box-sizing: border-box;
  border: 2rpx solid #e9ecef;
  border-radius: 999rpx;
  background: #ffffff;
  box-shadow: 0 24rpx 56rpx rgba(33, 37, 41, 0.1);
}

.tab {
  position: relative;
  width: 25%;
  height: 116rpx;
  flex-direction: column;
  justify-content: center;
  color: #868e96;
  background: transparent;
}

.tab.active {
  color: #212529;
}

.schedule-tab-icon::before,
.schedule-tab-icon::after,
.work-tab-icon::before,
.work-tab-icon::after,
.portfolio-tab-icon::before,
.portfolio-tab-icon::after,
.mine-tab-icon::before,
.mine-tab-icon::after {
  position: absolute;
  content: "";
  box-sizing: border-box;
}

.tab-icon-wrap {
  width: 68rpx;
  height: 52rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #ffffff;
  border-radius: 999rpx;
}

.tab.active .tab-icon-wrap {
  color: #ffffff;
  background: #212529;
}

.tab-icon-image {
  display: block;
  width: 38rpx;
  height: 38rpx;
}

.tab-icon {
  position: relative;
  z-index: 1;
  width: 42rpx;
  height: 42rpx;
}

.schedule-tab-icon::before {
  left: 6rpx;
  top: 6rpx;
  width: 30rpx;
  height: 30rpx;
  border: 4rpx solid currentColor;
  border-radius: 10rpx;
}

.schedule-tab-icon::after {
  left: 12rpx;
  top: 18rpx;
  width: 18rpx;
  height: 4rpx;
  border-radius: 999rpx;
  background: currentColor;
}

.work-tab-icon::before {
  left: 6rpx;
  top: 6rpx;
  width: 30rpx;
  height: 30rpx;
  border: 4rpx solid currentColor;
  border-radius: 10rpx;
}

.work-tab-icon::after {
  left: 13rpx;
  bottom: 11rpx;
  width: 18rpx;
  height: 14rpx;
  border-left: 4rpx solid currentColor;
  border-bottom: 4rpx solid currentColor;
  transform: rotate(-45deg);
}

.portfolio-tab-icon::before {
  left: 10rpx;
  top: 8rpx;
  width: 28rpx;
  height: 28rpx;
  border: 4rpx solid currentColor;
  border-radius: 8rpx;
  background: rgba(255, 255, 255, 0.96);
  z-index: 2;
}

.portfolio-tab-icon::after {
  left: 4rpx;
  top: 14rpx;
  width: 28rpx;
  height: 28rpx;
  border: 4rpx solid currentColor;
  border-radius: 8rpx;
  z-index: 1;
}

.mine-tab-icon::before {
  left: 13rpx;
  top: 6rpx;
  width: 16rpx;
  height: 16rpx;
  border: 4rpx solid currentColor;
  border-radius: 50%;
}

.mine-tab-icon::after {
  left: 6rpx;
  bottom: 6rpx;
  width: 30rpx;
  height: 16rpx;
  border: 4rpx solid currentColor;
  border-bottom-width: 3rpx;
  border-radius: 20rpx 20rpx 8rpx 8rpx;
}

.tab-label {
  position: relative;
  z-index: 1;
  margin-top: 4rpx;
  font-size: 18rpx;
  font-weight: 500;
  line-height: 1.2;
}

@keyframes skeleton {
  0% {
    background-position: -320rpx 0;
  }
  100% {
    background-position: 320rpx 0;
  }
}

@keyframes loading-spin {
  0% {
    transform: rotate(0deg);
  }
  100% {
    transform: rotate(360deg);
  }
}
