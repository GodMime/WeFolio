<view class="page-shell schedule-page">
  <navigation-bar title="档期" back="{{false}}" color="#17202a" background="rgba(245, 247, 251, 0.94)"></navigation-bar>

  <scroll-view class="schedule-scroll" scroll-y type="list">
    <view class="schedule-content">
      <view class="schedule-segmented">
        <button class="segment {{activeMode === 'maintenance' ? 'active' : ''}}" data-mode="maintenance" bindtap="handleModeTap">档期维护</button>
        <button class="segment {{activeMode === 'definitions' ? 'active' : ''}}" data-mode="definitions" bindtap="handleModeTap">档位定义</button>
      </view>

      <block wx:if="{{activeMode === 'definitions'}}">
          <view class="panel definition-list-panel">
            <view class="panel-heading">
              <view>
                <view class="panel-title">所有定义</view>
                <view class="panel-meta">启用 / 停用可切换</view>
              </view>
            </view>

            <view wx:if="{{slotDefinitionsLoading}}" class="component-loading">
              <view class="loading-spinner"></view>
              <view class="loading-copy">档位定义加载中</view>
            </view>

            <view wx:elif="{{slotDefinitionsErrorMessage}}" class="inline-empty">
              <view class="empty-title small">档位定义加载失败</view>
              <view class="empty-desc">{{slotDefinitionsErrorMessage}}</view>
              <button class="primary-button compact" bindtap="loadSlotDefinitions">重试</button>
            </view>

            <block wx:else>
              <view wx:if="{{overview.slotDefinitions.length === 0}}" class="inline-empty">
                <view class="empty-title small">暂无档位定义</view>
                <view class="empty-desc">新增后才会出现在维护档期的可选列表中</view>
              </view>

              <view
                wx:for="{{overview.slotDefinitions}}"
                wx:key="id"
                data-id="{{item.id}}"
                class="slot-swipe-row {{revealedSlotId === item.id && !item.enabled ? 'revealed' : ''}}"
                bindtouchstart="handleSlotTouchStart"
                bindtouchmove="handleSlotTouchMove"
                bindtouchend="handleSlotTouchEnd"
                bindtouchcancel="handleSlotTouchCancel"
              >
                <view class="slot-delete-pane" wx:if="{{!item.enabled}}">
                  <button
                    class="mini-action danger"
                    loading="{{deletingSlotId === item.id}}"
                    disabled="{{deletingSlotId === item.id}}"
                    catchtap="handleDeleteSlotDefinition"
                    data-id="{{item.id}}"
                  >删除</button>
                </view>
                <view
                  class="slot-line"
                  data-id="{{item.id}}"
                  bindtap="handleSlotEdit"
                >
                  <view class="slot-main">
                    <view class="swatch" style="{{item.colorStyle}}"></view>
                    <view class="slot-copy">
                      <view class="slot-name">{{item.name}}</view>
                      <view class="slot-desc">{{item.timeRangeText}} · {{item.statusText}}</view>
                    </view>
                  </view>
                  <view class="slot-actions">
                    <button
                      class="mini-action {{item.enabled ? 'warn' : ''}}"
                      catchtap="handleToggleSlotStatus"
                      data-id="{{item.id}}"
                    >{{item.enabled ? '停用' : '启用'}}</button>
                  </view>
                </view>
              </view>
            </block>
            <button class="primary-button definition-add-button" bindtap="handleSlotAdd">新增定义</button>
          </view>
        </block>

        <block wx:else>
          <view class="panel schedule-color-card">
            <view class="panel-heading">
              <view>
                <view class="panel-title">档位定义</view>
                <view class="panel-meta">名称 / 时间 / 颜色</view>
              </view>
            </view>
            <view class="color-legend">
              <view wx:if="{{slotDefinitionsLoading}}" class="component-loading compact">
                <view class="loading-spinner"></view>
                <view class="loading-copy">档位定义加载中</view>
              </view>
              <view wx:elif="{{slotDefinitionsErrorMessage}}" class="legend-empty">{{slotDefinitionsErrorMessage}}</view>
              <block wx:else>
                <view class="swatch-option" wx:for="{{overview.slotDefinitions}}" wx:key="id">
                  <view class="swatch" style="{{item.colorStyle}}"></view>
                  <text>{{item.name}} {{item.timeRangeText}}</text>
                </view>
                <view wx:if="{{overview.slotDefinitions.length === 0}}" class="legend-empty">暂无档位定义</view>
              </block>
            </view>
          </view>

          <view class="calendar-group">
            <view class="calendar-toolbar">
              <button class="month-control" bindtap="handlePrevMonth">‹</button>
              <view class="month-title">
                <view class="month-main">{{overview.month.titleText}}</view>
              </view>
              <picker class="month-picker" mode="date" fields="month" value="{{selectedMonth}}" bindchange="handleMonthPickerChange">
                <view class="month-control wide">切换年月</view>
              </picker>
              <button class="month-control" bindtap="handleNextMonth">›</button>
            </view>

            <view class="calendar-region">
              <view class="calendar {{calendarLoading ? 'loading' : ''}}">
                <view class="weekday" wx:for="{{weekdays}}" wx:key="*this">{{item}}</view>
                <view
                  class="{{item.dayClass}}"
                  wx:for="{{overview.month.days}}"
                  wx:key="date"
                  data-date="{{item.date}}"
                  bindtap="handleDayTap"
                >
                  <view class="date-stack">
                    <view class="day-number">{{item.dayNumber}}</view>
                    <view class="day-meta" wx:if="{{item.metaText}}">{{item.metaText}}</view>
                  </view>
                  <view class="day-colors">
                    <view
                      class="day-color"
                      wx:for="{{item.markerColors}}"
                      wx:for-item="marker"
                      wx:key="color"
                      style="{{marker.style}}"
                    ></view>
                  </view>
                </view>
              </view>
              <view wx:if="{{calendarLoading}}" class="component-loading-overlay">
                <view class="loading-spinner"></view>
                <view class="loading-copy">月历加载中</view>
              </view>
              <view wx:if="{{calendarErrorMessage && !calendarLoading}}" class="component-error-overlay">
                <view class="empty-title small">月历加载失败</view>
                <view class="empty-desc">{{calendarErrorMessage}}</view>
                <button class="primary-button compact" bindtap="loadCalendar">重试</button>
              </view>
            </view>
          </view>

          <view class="day-panel">
            <view class="day-heading">
              <view class="day-date-copy">
                <view class="day-title">{{overview.selectedDate.titleText}}</view>
                <view class="day-lunar-title">{{overview.selectedDate.lunarTitleText}}</view>
              </view>
              <view class="day-summary">{{overview.selectedDate.summaryText}}</view>
            </view>

            <view class="day-list-region">
              <view wx:if="{{dayLoading}}" class="component-loading day-list-loading">
                <view class="loading-spinner"></view>
                <view class="loading-copy">当天档期加载中</view>
              </view>

              <view wx:elif="{{dayErrorMessage}}" class="inline-empty">
                <view class="empty-title small">当天档期加载失败</view>
                <view class="empty-desc">{{dayErrorMessage}}</view>
                <button class="primary-button compact" bindtap="loadDaySchedules">重试</button>
              </view>

              <block wx:else>
                <view wx:if="{{overview.selectedDate.empty}}" class="inline-empty">
                  <view class="empty-title small">当天暂无档期</view>
                  <view class="empty-desc">点击新增档期，为这个日期选择一个已定义档位</view>
                </view>

                <view
                  wx:for="{{overview.selectedDate.schedules}}"
                  wx:key="id"
                  data-id="{{item.id}}"
                  class="schedule-swipe-row {{revealedScheduleId === item.id ? 'revealed' : ''}}"
                  bindtouchstart="handleScheduleTouchStart"
                  bindtouchmove="handleScheduleTouchMove"
                  bindtouchend="handleScheduleTouchEnd"
                  bindtouchcancel="handleScheduleTouchCancel"
                >
                  <view class="schedule-delete-pane">
                    <button
                      class="mini-action danger"
                      loading="{{deletingScheduleId === item.id}}"
                      disabled="{{deletingScheduleId === item.id}}"
                      catchtap="handleDeleteScheduleItem"
                      data-id="{{item.id}}"
                    >删除</button>
                  </view>
                  <view
                    class="schedule-line"
                    data-id="{{item.id}}"
                    data-date="{{item.scheduleDate}}"
                    bindtap="handleScheduleTap"
                  >
                    <view class="slot-main">
                      <view class="swatch" style="{{item.colorStyle}}"></view>
                      <view class="slot-copy">
                        <view class="slot-name">{{item.slotName}}</view>
                        <view class="slot-desc">{{item.timeRangeText}} · {{item.contactText}}</view>
                      </view>
                    </view>
                    <view class="{{item.statusClass}}">{{item.statusText}}</view>
                  </view>
                </view>
              </block>
            </view>
            <button class="primary-button schedule-add-button" bindtap="handleMaintainDate">新增档期</button>
          </view>
        </block>
    </view>
  </scroll-view>

  <view class="tabbar">
    <button
      class="tab {{item.active ? 'active' : ''}}"
      wx:for="{{tabs}}"
      wx:key="key"
      data-label="{{item.label}}"
      bindtap="handleTabTap"
    >
      <view class="tab-icon {{item.icon}}-tab-icon"></view>
      <view class="tab-label">{{item.label}}</view>
    </button>
  </view>

  <view class="definition-sheet-overlay {{slotFormVisible ? 'visible' : ''}}" catchtap="handleSlotCancel">
    <view class="definition-sheet" catchtap="noop">
      <view class="sheet-grabber"></view>
      <view class="panel-heading">
        <view class="panel-title">{{slotSheetTitle}}</view>
        <view class="slot-status {{slotForm.status === 'ACTIVE' ? 'active' : 'muted'}}">{{slotForm.status === 'ACTIVE' ? '启用' : '停用'}}</view>
      </view>

      <view class="form-grid">
        <view class="form-row">
          <view class="field-heading">
            <view class="field-label">档位名称</view>
            <view class="field-limit">{{slotFieldCounters.name}}</view>
          </view>
          <input class="field-input" value="{{slotForm.name}}" data-field="name" bindinput="handleSlotInput" maxlength="30" placeholder="如 中午档" />
        </view>
      </view>

      <view class="form-grid slot-control-row">
        <picker mode="time" value="{{slotForm.startTime}}" data-field="startTime" bindchange="handleSlotTimeChange">
          <view class="form-row">
            <view class="field-label">开始时间</view>
            <view class="field-input picker-value">{{slotForm.startTime}}</view>
          </view>
        </picker>
        <picker mode="time" value="{{slotForm.endTime}}" data-field="endTime" bindchange="handleSlotTimeChange">
          <view class="form-row">
            <view class="field-label">结束时间</view>
            <view class="field-input picker-value">{{slotForm.endTime}}</view>
          </view>
        </picker>
        <view class="form-row status-form-row">
          <view class="field-label">启用状态</view>
          <view class="choice-row inline-choice-row">
            <view
              wx:for="{{slotStatusOptions}}"
              wx:key="value"
              class="slot-status-choice {{item.tone}} {{slotForm.status === item.value ? 'active' : ''}}"
              data-status="{{item.value}}"
              bindtap="handleSlotStatusTap"
            >{{item.text}}</view>
          </view>
        </view>
      </view>

      <view class="field-label standalone">档位颜色</view>
      <view class="slot-color-grid">
        <view
          wx:for="{{slotColorOptions}}"
          wx:key="color"
          class="slot-color-choice {{slotForm.color === item.color ? 'active' : ''}}"
          style="{{item.choiceStyle}}"
          data-color="{{item.color}}"
          bindtap="handleSlotColorTap"
          aria-role="button"
          aria-label="选择{{item.name}}档位颜色"
        >
          <view class="slot-color-swatch" style="{{item.swatchStyle}}"></view>
          <text class="slot-color-name">{{item.name}}</text>
        </view>
      </view>

      <view class="button-row">
        <button class="secondary-button" bindtap="handleSlotCancel">取消</button>
        <button class="primary-button" loading="{{saving}}" bindtap="handleSaveSlot">保存定义</button>
      </view>
    </view>
  </view>

  <view class="schedule-sheet-overlay {{scheduleFormVisible ? 'visible' : ''}}" catchtap="handleScheduleCancel">
    <view class="schedule-sheet" catchtap="noop">
      <view class="sheet-grabber"></view>
      <view class="panel-heading">
        <view>
          <view class="panel-title">{{scheduleSheetTitle}}</view>
          <view class="panel-meta">{{overview.selectedDate.titleText}}</view>
        </view>
      </view>

      <view class="field-label standalone">选择档位定义</view>
      <view class="schedule-slot-grid">
        <view
          wx:for="{{overview.slotDefinitions}}"
          wx:key="id"
          class="schedule-slot-card {{scheduleForm.slotDefinitionId === item.id ? 'active' : ''}} {{item.enabled ? '' : 'disabled'}}"
          data-id="{{item.id}}"
          bindtap="handleScheduleSlotTap"
        >
          <view class="schedule-slot-card-top">
            <view class="slot-name">{{item.name}}</view>
            <view class="swatch" style="{{item.colorStyle}}"></view>
          </view>
          <view class="slot-desc">{{item.timeRangeText}}</view>
        </view>
      </view>
      <view wx:if="{{overview.slotDefinitions.length === 0}}" class="inline-empty compact">
        <view class="empty-title small">暂无可选档位</view>
        <view class="empty-desc">请先新增档位定义</view>
      </view>

      <view class="field-label standalone">档期状态</view>
      <view class="schedule-status-row">
        <view
          wx:for="{{statusOptions}}"
          wx:key="value"
          class="schedule-status-choice {{scheduleForm.status === item.value ? 'active' : ''}} {{item.tone}}"
          data-status="{{item.value}}"
          bindtap="handleScheduleStatusTap"
        >{{item.text}}</view>
      </view>

      <view class="form-grid">
        <view class="form-row">
          <view class="field-heading">
            <view class="field-label">联系人姓名</view>
            <view class="field-limit">{{scheduleFieldCounters.contactName}}</view>
          </view>
          <input class="field-input" value="{{scheduleForm.contactName}}" maxlength="50" data-field="contactName" bindinput="handleScheduleInput" placeholder="如 陈女士" />
        </view>
        <view class="form-row">
          <view class="field-heading">
            <view class="field-label">联系电话</view>
            <view class="field-limit">{{scheduleFieldCounters.contactPhone}}</view>
          </view>
          <input class="field-input" value="{{scheduleForm.contactPhone}}" maxlength="50" data-field="contactPhone" bindinput="handleScheduleInput" placeholder="手机号 / 微信号" />
        </view>
      </view>

      <view class="form-row full">
        <view class="field-heading">
          <view class="field-label">档期备注</view>
          <view class="field-limit">{{scheduleFieldCounters.note}}</view>
        </view>
        <textarea class="field-input textarea" value="{{scheduleForm.note}}" maxlength="1000" data-field="note" bindinput="handleScheduleInput" placeholder="仅维护者可见，访客端不展示"></textarea>
      </view>

      <view class="button-row">
        <button class="secondary-button" bindtap="handleScheduleCancel">取消</button>
        <button class="primary-button" loading="{{saving}}" bindtap="handleSaveSchedule">保存档期</button>
      </view>
    </view>
  </view>
</view>
