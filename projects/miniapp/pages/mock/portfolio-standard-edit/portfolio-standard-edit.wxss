@import "../styles/portfolio-standard-edit.wxss";
@import "../common.wxss";

.mock-component-copy {
  flex-direction: column;
  align-items: flex-start;
  gap: 6rpx;
}

.page-setting-panel {
  padding: 28rpx;
}

.background-color-row,
.bottom-nav-count-row,
.editor-menu-bar,
.editor-menu-rename {
  display: flex;
  align-items: center;
}

.background-color-row {
  gap: 20rpx;
  margin-top: 16rpx;
}

.background-color-swatch {
  width: 56rpx;
  height: 56rpx;
  flex: none;
  border: 1rpx solid #dee2e6;
  border-radius: 50%;
  box-sizing: border-box;
}

.background-color-current {
  width: 92rpx;
  height: 56rpx;
  flex: none;
  border: 1rpx solid #dee2e6;
  border-radius: 20rpx;
  box-sizing: border-box;
}

.background-color-swatch.active {
  box-shadow: 0 0 0 4rpx #ffffff, 0 0 0 8rpx #212529;
}

.background-custom-button {
  min-width: 116rpx;
  height: 56rpx;
  margin: 0;
  padding: 0 22rpx;
  color: #212529;
  font-size: 23rpx;
  font-weight: 700;
  line-height: 56rpx;
  border-radius: 999rpx;
  background: #f1f3f5;
}

.bottom-nav-count-row {
  gap: 12rpx;
  margin-top: 16rpx;
}

.bottom-nav-count-option {
  flex: 1;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #212529;
  font-size: 24rpx;
  font-weight: 700;
  border-radius: 999rpx;
  background: #f1f3f5;
}

.bottom-nav-count-option.active {
  color: #ffffff;
  background: #212529;
}

.editor-menu-bar {
  gap: 8rpx;
  margin-top: 20rpx;
  padding: 8rpx;
  border-radius: 999rpx;
  background: #212529;
}

.editor-menu-item {
  flex: 1;
  min-width: 0;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: rgba(255, 255, 255, 0.62);
  font-size: 24rpx;
  font-weight: 700;
  border-radius: 999rpx;
}

.editor-menu-item.active {
  color: #212529;
  background: #ffffff;
}

.editor-menu-rename {
  gap: 16rpx;
  margin-top: 16rpx;
}

.editor-menu-title-input {
  flex: 1;
  height: 72rpx;
  padding: 0 24rpx;
  font-size: 24rpx;
  font-weight: 700;
  border-radius: 999rpx;
  background: #f1f3f5;
  box-sizing: border-box;
}

.editor-menu-title-count {
  flex: none;
  color: #adb5bd;
  font-size: 22rpx;
}

.editor-menu-remove {
  height: 64rpx;
  margin: 0;
  padding: 0 22rpx;
  color: #b55656;
  font-size: 22rpx;
  line-height: 64rpx;
  border-radius: 999rpx;
  background: #fff1f1;
}

.mock-background-color-panel {
  padding: 0 28rpx calc(28rpx + env(safe-area-inset-bottom));
}

.background-color-pad {
  position: relative;
  height: 360rpx;
  overflow: hidden;
  border: 1rpx solid #e9ecef;
  border-radius: 40rpx;
}

.background-color-pad-white,
.background-color-pad-black {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
}

.background-color-pad-white {
  background: linear-gradient(to right, #ffffff, rgba(255, 255, 255, 0));
}

.background-color-pad-black {
  background: linear-gradient(to top, #000000, rgba(0, 0, 0, 0));
}

.background-color-pad-dot {
  position: absolute;
  width: 36rpx;
  height: 36rpx;
  border: 6rpx solid #ffffff;
  border-radius: 50%;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.35);
  transform: translate(-50%, -50%);
  box-sizing: border-box;
}

.background-hue-slider {
  position: relative;
  height: 32rpx;
  margin-top: 24rpx;
  border-radius: 999rpx;
  background: linear-gradient(to right, #ff3b30, #ffcc00, #34c759, #0a84ff, #5856d6, #af52de, #ff3b30);
}

.background-hue-slider slider {
  position: absolute;
  left: 0;
  right: 0;
  top: 50%;
  z-index: 2;
  width: 100%;
  margin: 0;
  transform: translateY(-50%);
}

.background-hue-thumb {
  position: absolute;
  top: 50%;
  z-index: 1;
  width: 44rpx;
  height: 44rpx;
  border: 6rpx solid #ffffff;
  border-radius: 50%;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.3);
  transform: translate(-50%, -50%);
  box-sizing: border-box;
  pointer-events: none;
}

.mock-background-color-input {
  height: 84rpx;
  margin-top: 28rpx;
  padding: 0 28rpx;
  color: #212529;
  font-size: 26rpx;
  font-weight: 700;
  border-radius: 999rpx;
  background: #f5f6f7;
  text-transform: uppercase;
  box-sizing: border-box;
}

.background-color-preview-bar {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-top: 20rpx;
  padding: 16rpx 24rpx;
  border: 1rpx solid #e9ecef;
  border-radius: 40rpx;
}

.background-color-preview-chip {
  width: 80rpx;
  height: 56rpx;
  flex: none;
  border: 1rpx solid #e9ecef;
  border-radius: 20rpx;
}

.background-color-preview-text {
  color: #868e96;
  font-size: 24rpx;
}

.mock-background-color-confirm {
  width: 148rpx;
  height: 60rpx;
  margin: 0;
  padding: 0;
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 800;
  line-height: 60rpx;
  border-radius: 999rpx;
  background: #212529;
}

.mock-component-summary {
  overflow: hidden;
  width: 100%;
  color: #697786;
  font-size: 22rpx;
  line-height: 1.35;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.component-swipe-row.active .component-row {
  border-color: #212529;
  background: #ffffff;
}

.component-swipe-row.active.revealed .component-row,
.component-swipe-row.active.dragging .component-row {
  background: #ffffff;
}

.mock-component-empty {
  min-height: 112rpx;
  align-items: center;
  justify-content: center;
  padding: 24rpx;
  border: 1rpx dashed #ced4da;
  border-radius: 28rpx;
  background: #f5f6f7;
  box-sizing: border-box;
}

.mock-component-edit-panel {
  max-height: 78vh;
}

.mock-component-edit-scroll {
  height: 54vh;
  min-height: 360rpx;
  max-height: 54vh;
}

.mock-component-edit-content {
  gap: 20rpx;
}

.mock-editor-desc {
  margin-top: 0;
}

.mock-work-list {
  margin-top: 18rpx;
}

.mock-profile-editor {
  margin-top: 24rpx;
  padding: 18rpx;
  border: 1rpx solid #e9ecef;
  border-radius: 48rpx;
  background: #ffffff;
  box-sizing: border-box;
}

.profile-avatar-preview image {
  width: 100%;
  height: 100%;
}

.mock-single-work-title-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  margin-top: 24rpx;
  padding: 22rpx;
  border: 1rpx solid #e9ecef;
  border-radius: 48rpx;
  background: #ffffff;
  box-sizing: border-box;
}

.mock-single-work-title-copy {
  flex: 1;
  min-width: 0;
}
