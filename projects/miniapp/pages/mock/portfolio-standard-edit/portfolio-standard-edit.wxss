@import "../styles/portfolio-standard-edit.wxss";
@import "../common.wxss";
@import "../../../styles/portfolio-editor-foundation.wxss";
@import "../../../styles/portfolio-text-section-editor.wxss";

.mock-component-copy {
  flex-direction: column;
  align-items: flex-start;
  gap: 6rpx;
}

.background-color-row,
.bottom-nav-count-row,
.editor-menu-bar,
.editor-menu-rename {
  display: flex;
  align-items: center;
}

.background-color-row {
  gap: 20rpx;
  margin-top: 16rpx;
}

.background-color-swatch {
  width: 56rpx;
  height: 56rpx;
  flex: none;
  border: 1rpx solid var(--pe-color-border-strong, #DEE2E6);
  border-radius: 50%;
  box-sizing: border-box;
}

.background-color-current {
  width: 92rpx;
  height: 56rpx;
  flex: none;
  border: 1rpx solid var(--pe-color-border-strong, #DEE2E6);
  border-radius: 20rpx;
  box-sizing: border-box;
}

.background-color-swatch.active {
  box-shadow: 0 0 0 4rpx var(--pe-color-surface, #FFFFFF), 0 0 0 8rpx var(--pe-color-text-primary, #212529);
}

.background-custom-button {
  min-width: 116rpx;
  height: 56rpx;
  margin: 0;
  padding: 0 22rpx;
  color: var(--pe-color-text-primary, #212529);
  font-size: 23rpx;
  font-weight: 700;
  line-height: 56rpx;
  border-radius: 999rpx;
  background: var(--pe-color-secondary-disabled, #F1F3F5);
}

.bottom-nav-count-row {
  gap: 12rpx;
  margin-top: 16rpx;
}

.bottom-nav-count-option {
  flex: 1;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--pe-color-text-primary, #212529);
  font-size: 24rpx;
  font-weight: 700;
  border-radius: 999rpx;
  background: var(--pe-color-secondary-disabled, #F1F3F5);
}

.bottom-nav-count-option.active {
  color: var(--pe-color-surface, #FFFFFF);
  background: var(--pe-color-text-primary, #212529);
}

.editor-menu-bar {
  gap: 8rpx;
  margin-top: 20rpx;
  padding: 8rpx;
  border-radius: 999rpx;
  background: var(--pe-color-text-primary, #212529);
}

.editor-menu-item {
  flex: 1;
  min-width: 0;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: rgba(255, 255, 255, 0.62);
  font-size: 24rpx;
  font-weight: 700;
  border-radius: 999rpx;
}

.editor-menu-item.active {
  color: var(--pe-color-text-primary, #212529);
  background: var(--pe-color-surface, #FFFFFF);
}

.editor-menu-rename {
  gap: 16rpx;
  margin-top: 16rpx;
}

.editor-menu-title-input {
  flex: 1;
  height: 72rpx;
  padding: 0 24rpx;
  font-size: 24rpx;
  font-weight: 700;
  border-radius: 999rpx;
  background: var(--pe-color-secondary-disabled, #F1F3F5);
  box-sizing: border-box;
}

.editor-menu-title-count {
  flex: none;
  color: var(--pe-color-text-muted, #ADB5BD);
  font-size: 22rpx;
}

.editor-menu-remove {
  height: 64rpx;
  margin: 0;
  padding: 0 22rpx;
  color: var(--pe-color-danger, #B55656);
  font-size: 22rpx;
  line-height: 64rpx;
  border-radius: 999rpx;
  background: var(--pe-color-danger-surface, #FFF1F1);
}

.background-color-pad {
  position: relative;
  height: 360rpx;
  overflow: hidden;
  border: 1rpx solid var(--pe-color-border, #E9ECEF);
  border-radius: 40rpx;
}

.background-color-pad-white,
.background-color-pad-black {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
}

.background-color-pad-white {
  background: linear-gradient(to right, var(--pe-color-surface, #FFFFFF), rgba(255, 255, 255, 0));
}

.background-color-pad-black {
  background: linear-gradient(to top, #000000, rgba(0, 0, 0, 0));
}

.background-color-pad-dot {
  position: absolute;
  width: 36rpx;
  height: 36rpx;
  border: 6rpx solid var(--pe-color-surface, #FFFFFF);
  border-radius: 50%;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.35);
  transform: translate(-50%, -50%);
  box-sizing: border-box;
}

.background-hue-slider {
  position: relative;
  height: 32rpx;
  margin-top: 24rpx;
  border-radius: 999rpx;
  background: linear-gradient(to right, #ff3b30, #ffcc00, #34c759, #0a84ff, #5856d6, #af52de, #ff3b30);
}

.background-hue-slider slider {
  position: absolute;
  left: 0;
  right: 0;
  top: 50%;
  z-index: 2;
  width: 100%;
  margin: 0;
  transform: translateY(-50%);
}

.background-hue-thumb {
  position: absolute;
  top: 50%;
  z-index: 1;
  width: 44rpx;
  height: 44rpx;
  border: 6rpx solid var(--pe-color-surface, #FFFFFF);
  border-radius: 50%;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.3);
  transform: translate(-50%, -50%);
  box-sizing: border-box;
  pointer-events: none;
}

.mock-background-color-input {
  margin-top: 28rpx;
  font-weight: 700;
  text-transform: uppercase;
}

.background-color-preview-bar {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-top: 20rpx;
  padding: 16rpx 24rpx;
  border: 1rpx solid var(--pe-color-border, #E9ECEF);
  border-radius: 40rpx;
}

.background-color-preview-chip {
  width: 80rpx;
  height: 56rpx;
  flex: none;
  border: 1rpx solid var(--pe-color-border, #E9ECEF);
  border-radius: 20rpx;
}

.background-color-preview-text {
  color: var(--pe-color-text-secondary, #868E96);
  font-size: 24rpx;
}

.mock-component-summary {
  overflow: hidden;
  width: 100%;
  line-height: 1.35;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.component-swipe-row.active .component-row {
  border-color: var(--pe-color-text-primary, #212529);
  background: var(--pe-color-surface, #FFFFFF);
}

.component-swipe-row.active.revealed .component-row,
.component-swipe-row.active.dragging .component-row {
  background: var(--pe-color-surface, #FFFFFF);
}

.mock-component-empty {
  min-height: 112rpx;
  align-items: center;
  justify-content: center;
  padding: 24rpx;
  border: 1rpx dashed var(--pe-color-primary-disabled, #CED4DA);
  border-radius: 28rpx;
  background: var(--pe-color-page, #F5F6F7);
  box-sizing: border-box;
}

.mock-component-edit-scroll {
  height: 54vh;
  min-height: 360rpx;
  max-height: 54vh;
}

.mock-component-edit-content {
  gap: 20rpx;
}

.mock-editor-desc {
  margin-top: 0;
}

.mock-work-list {
  margin-top: 18rpx;
}

.work-filter-tools {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.work-filter-input {
  width: 100%;
  height: 72rpx;
  padding: 0 24rpx;
  border: 1rpx solid var(--pe-color-border-strong, #DEE2E6);
  border-radius: 999rpx;
  background: var(--pe-color-surface, #FFFFFF);
  box-sizing: border-box;
}

.work-filter-scroll {
  width: 100%;
  white-space: nowrap;
}

.work-filter-row {
  display: inline-flex;
  gap: 12rpx;
}

.work-filter-tag {
  min-width: 112rpx;
  height: 50rpx;
  padding: 0 20rpx;
  justify-content: center;
  border: 1rpx solid var(--pe-color-border-strong, #DEE2E6);
  border-radius: 999rpx;
  box-sizing: border-box;
}

.mock-profile-editor {
  margin-top: 24rpx;
  padding: 18rpx;
  border: 1rpx solid var(--pe-color-border, #E9ECEF);
  border-radius: 48rpx;
  background: var(--pe-color-surface, #FFFFFF);
  box-sizing: border-box;
}

.profile-avatar-preview image {
  width: 100%;
  height: 100%;
}

.mock-single-work-title-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  margin-top: 24rpx;
  padding: 22rpx;
  border: 1rpx solid var(--pe-color-border, #E9ECEF);
  border-radius: 48rpx;
  background: var(--pe-color-surface, #FFFFFF);
  box-sizing: border-box;
}

.mock-single-work-title-copy {
  flex: 1;
  min-width: 0;
}

.mock-setting-row { display:flex; align-items:center; justify-content:space-between; gap:16rpx; padding:16rpx 0; }
.mock-choice-row { display:flex; flex-wrap:wrap; gap:12rpx; padding:12rpx 0; }
.mock-choice-row button { margin:0; flex:1; font-size:24rpx; }
.mock-small-thumb { width:96rpx; height:96rpx; margin-right:20rpx; border-radius:12rpx; }
.mock-group-editor { padding:16rpx; margin:12rpx 0; border:1rpx solid #d7dadd; border-radius:16rpx; }
.mock-validation-error { padding:20rpx 0; color:var(--pe-color-danger, #B55656); font-size:26rpx; }

.component-work-thumb {
  position: relative;
}

.component-work-no-cover {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 8rpx;
  box-sizing: border-box;
  color: var(--pe-color-text-secondary, #868E96);
  background: var(--pe-color-secondary-disabled, #F1F3F5);
  font-size: 18rpx;
  text-align: center;
}

.component-work-video-indicator {
  position: absolute;
  right: 4rpx;
  bottom: 4rpx;
  width: 28rpx;
  height: 28rpx;
  border-radius: 50%;
  color: var(--pe-color-surface, #FFFFFF);
  background: rgba(0, 0, 0, 0.55);
  font-size: 16rpx;
  line-height: 28rpx;
  text-align: center;
}

.component-spacing-slider {
  margin: 20rpx 0 12rpx;
}

.component-spacing-range {
  display: flex;
  justify-content: space-between;
  color: var(--pe-color-text-secondary, #868E96);
  font-size: 22rpx;
}

.background-audio-styles { display: flex; flex-direction: column; margin-top: 20rpx; }
.background-audio-style { display: flex; align-items: center; justify-content: space-between; min-height: 48px; padding: 8px 12px; margin-bottom: 8px; border: 1px solid var(--pe-color-border, #E9ECEF); border-radius: 8px; background: var(--pe-color-surface, #FFFFFF); }
.background-audio-style.audio-style-selected { border-color: var(--pe-color-text-primary, #212529); background: var(--pe-color-border, #E9ECEF); }
.background-audio-sample { display: flex; align-items: center; min-width: 180px; min-height: 48px; }
.background-audio-style-label { font-size: 22rpx; color: var(--pe-color-text-secondary, #868E96); margin-left: 8px; text-align: right; }
.background-audio-action {
  width: 100%;
  min-width: 100%;
  flex: none;
  margin-top: 16rpx;
}

.background-audio-options { padding: 16rpx 0; }
.background-audio-option { display: flex; align-items: center; min-height: 44px; margin-top: 12rpx; padding: 12rpx 16rpx; font-size: 26rpx; text-align: left; }


.component-option-disabled { opacity: 0.45; }

.video-carousel-editor-settings {
  width: 100%;
  display: flex;
  flex: none;
  flex-direction: column;
  align-items: stretch;
  padding-bottom: 12rpx;
}

.video-carousel-editor-settings-collapsed {
  display: none;
}

.video-carousel-editor-panel .component-work-heading {
  gap: 16rpx;
  margin-bottom: 12rpx;
}

.video-carousel-editor-panel .component-work-count {
  padding: 0;
  border: 0;
}

.video-carousel-settings-toggle {
  display: flex;
  flex: none;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  min-width: 80rpx;
  min-height: 72rpx;
  color: var(--pe-color-text-secondary, #868E96);
  font-size: 22rpx;
}

.video-carousel-settings-chevron {
  width: 10rpx;
  height: 10rpx;
  border-top: 2rpx solid var(--pe-color-text-secondary, #868E96);
  border-left: 2rpx solid var(--pe-color-text-secondary, #868E96);
  transform: translateY(4rpx) rotate(45deg);
}

.video-carousel-settings-chevron.collapsed {
  transform: translateY(-2rpx) rotate(225deg);
}

.video-carousel-settings-summary {
  flex: none;
  padding-bottom: 20rpx;
  color: var(--pe-color-text-secondary, #868E96);
  font-size: 23rpx;
}

.video-carousel-title-setting,
.video-carousel-switch-setting {
  width: 100%;
  display: flex;
  align-items: center;
  gap: 16rpx;
  min-height: 80rpx;
  box-sizing: border-box;
}

.video-carousel-title-setting {
  padding: 6rpx 0;
}

.video-carousel-setting-label {
  flex: none;
  font-size: 26rpx;
  color: var(--pe-color-text-primary, #212529);
}

.video-carousel-title-count {
  flex: none;
  color: var(--pe-color-text-secondary, #868E96);
  font-size: 21rpx;
  line-height: 1.35;
}

.video-carousel-title-field {
  display: flex;
  align-items: center;
  flex: 1;
  min-width: 0;
  height: 72rpx;
  gap: 8rpx;
  padding: 0 18rpx;
  border: 1rpx solid var(--pe-color-border, #E9ECEF);
  border-radius: 14rpx;
  background: var(--pe-color-page, #F5F6F7);
  box-sizing: border-box;
}

.video-carousel-title-input {
  flex: 1;
  width: 0;
  min-width: 0;
  height: 100%;
  min-height: 0;
  padding: 0;
  border: 0;
  border-radius: 0;
  background: transparent;
}

.video-carousel-title-hidden {
  flex: 1;
  color: var(--pe-color-text-secondary, #868E96);
  font-size: 23rpx;
  text-align: right;
}

.video-carousel-toggle {
  display: flex;
  flex: none;
  align-items: center;
  justify-content: flex-end;
  width: 80rpx;
  height: 72rpx;
}

.video-carousel-toggle switch {
  flex: none;
  transform: scale(0.72);
  transform-origin: right center;
}

.video-carousel-switch-copy {
  display: flex;
  align-items: center;
  min-width: 0;
  flex: 1 1 0;
}

.video-carousel-switch-title {
  color: var(--pe-color-text-primary, #212529);
  font-size: 26rpx;
  font-weight: 500;
  line-height: 1.35;
}

.video-carousel-setting-help {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 64rpx;
  height: 80rpx;
  color: var(--pe-color-text-secondary, #868E96);
}

.video-carousel-setting-help text {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 24rpx;
  height: 24rpx;
  border: 1rpx solid var(--pe-color-text-secondary, #868E96);
  border-radius: 50%;
  font-size: 20rpx;
  line-height: 1;
}

.video-carousel-editor-panel .component-work-tools {
  flex: none;
  padding-top: 16rpx;
  border-top: 1rpx solid var(--pe-color-border, #E9ECEF);
}

.video-carousel-editor-panel .component-work-search {
  height: 72rpx;
  border-color: transparent;
}

.video-carousel-editor-panel .component-work-filter-scroll,
.video-carousel-editor-panel .component-work-filter-row {
  height: 60rpx;
}

.video-carousel-editor-panel .component-work-filter-pill {
  height: 54rpx;
  padding: 0 18rpx;
  font-size: 22rpx;
}

.video-carousel-editor-panel .component-work-list-content {
  gap: 0;
}

.video-carousel-editor-panel .component-work-option {
  min-height: 112rpx;
  padding: 14rpx 0;
  border: 0;
  border-bottom: 1rpx solid var(--pe-color-border, #E9ECEF);
  border-radius: 0;
  background: var(--pe-color-surface, #FFFFFF);
}

.video-carousel-editor-panel .component-work-title {
  font-weight: 500;
}

.video-carousel-editor-panel .component-work-meta-row {
  margin-top: 6rpx;
  gap: 8rpx;
}

.video-carousel-editor-panel .component-work-ratio {
  min-height: 0;
  padding: 0;
  border: 0;
  font-weight: 400;
}

.video-carousel-editor-panel .component-work-check {
  border: 1rpx solid var(--pe-color-border, #E9ECEF);
  background: var(--pe-color-surface, #FFFFFF);
  box-sizing: border-box;
}

.video-carousel-editor-panel .component-work-option[aria-checked="true"] .component-work-check {
  border-color: var(--pe-color-text-primary, #212529);
  background: var(--pe-color-text-primary, #212529);
}

.video-carousel-editor-panel .component-work-actions {
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid var(--pe-color-border, #E9ECEF);
}

.profile-sheet-fields-panel,
.profile-form-section {
  padding: 24rpx;
  border: 1rpx solid var(--pe-color-border, #E9ECEF);
  border-radius: 32rpx;
  background: var(--pe-color-surface, #FFFFFF);
  box-sizing: border-box;
}

.profile-layout-options {
  display: flex;
  gap: 16rpx;
  margin-top: 18rpx;
}

.profile-layout-option {
  flex: 1;
  min-width: 0;
  padding: 24rpx 12rpx;
  text-align: center;
  font-size: 26rpx;
}

.profile-border-settings {
  max-height: 0;
  opacity: 0;
  overflow: hidden;
  pointer-events: none;
  transition: max-height 200ms ease, opacity 200ms ease;
}

.profile-border-settings.is-expanded {
  /* 覆盖内联色板的展开高度，保证色值输入和确认按钮都可滚动到达。 */
  max-height: 2400rpx;
  opacity: 1;
  pointer-events: auto;
}

.profile-border-settings-content {
  padding: 24rpx 0;
}

.profile-border-auto {
  padding: 10rpx 20rpx;
  font-size: 24rpx;
}

.profile-field-limit {
  flex: none;
  color: var(--pe-color-text-muted, #ADB5BD);
  font-size: 22rpx;
  font-weight: 700;
  line-height: 1.3;
}

.profile-visibility-list {
  margin-top: 14rpx;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.profile-visibility-option {
  min-height: 72rpx;
  justify-content: space-between;
  gap: 18rpx;
}

.profile-visibility-label {
  color: var(--pe-color-text-strong, #495057);
  font-size: 24rpx;
  font-weight: 800;
  line-height: 1.3;
}

.display-group-picker-panel {
  height: auto;
  max-height: calc(100vh - 176rpx - env(safe-area-inset-top));
}

.display-group-scroll {
  width: 100%;
  height: 84rpx;
  min-height: 84rpx;
  max-height: 84rpx;
  flex: none;
  padding-top: 12rpx;
  overflow: hidden;
  white-space: nowrap;
  box-sizing: border-box;
}

.display-group-list-content {
  width: max-content;
  display: inline-flex;
  flex-wrap: nowrap;
  gap: 12rpx;
  padding-right: 32rpx;
  box-sizing: border-box;
}

.display-group-pill {
  width: auto;
  min-width: 0;
  min-height: 60rpx;
  flex: 0 0 auto;
  justify-content: space-between;
  gap: 12rpx;
  padding: 0 18rpx;
  overflow: hidden;
  border-radius: var(--pe-radius-pill, 999rpx);
}

.display-group-main {
  flex: none;
  min-width: 0;
  justify-content: flex-start;
  gap: 12rpx;
}

.display-group-name {
  overflow: hidden;
  flex: none;
  min-width: 0;
  color: inherit;
  font-size: 26rpx;
  font-weight: 900;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.display-group-count {
  flex: none;
  min-width: 36rpx;
  min-height: 36rpx;
  justify-content: center;
  padding: 0 10rpx;
  color: inherit;
  font-size: 20rpx;
  font-weight: 800;
  border: 1rpx solid currentColor;
  border-radius: 999rpx;
  background: transparent;
  box-sizing: border-box;
}

.display-group-badges {
  display: flex;
  align-items: center;
  flex: none;
  gap: 8rpx;
}

.display-group-order {
  width: 34rpx;
  height: 34rpx;
  flex: none;
  justify-content: center;
  align-items: center;
  color: var(--pe-color-text-muted, #ADB5BD);
  font-size: 20rpx;
  font-weight: 900;
  line-height: 1;
  border-radius: 50%;
  border: 2rpx solid var(--pe-color-border-strong, #DEE2E6);
  background: var(--pe-color-surface, #FFFFFF);
  box-sizing: border-box;
}

.display-group-order[aria-checked="true"] {
  color: var(--pe-color-surface, #FFFFFF);
  border-color: var(--pe-color-text-primary, #212529);
  background: var(--pe-color-text-primary, #212529);
}

.display-group-work-section {
  display: flex;
  flex-direction: column;
  align-items: stretch;
  gap: 18rpx;
  padding: 18rpx;
  border: 1rpx solid var(--pe-color-border-strong, #DEE2E6);
  border-radius: 16rpx;
  background: var(--pe-color-page, #F5F6F7);
  box-sizing: border-box;
}

.display-group-work-header {
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.display-group-work-copy {
  min-width: 0;
  flex: 1 1 0;
}

.display-group-work-title {
  color: var(--pe-color-text-primary, #212529);
  font-size: 26rpx;
  font-weight: 900;
