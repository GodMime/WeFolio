@import "../styles/portfolio-standard-edit.wxss";
@import "../common.wxss";

.mock-component-copy {
  flex-direction: column;
  align-items: flex-start;
  gap: 6rpx;
}

.mock-component-summary {
  overflow: hidden;
  width: 100%;
  color: #697786;
  font-size: 22rpx;
  line-height: 1.35;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.component-swipe-row.active .component-row {
  border-color: #212529;
  background: #ffffff;
}

.component-swipe-row.active.revealed .component-row,
.component-swipe-row.active.dragging .component-row {
  background: #ffffff;
}

.mock-component-empty {
  min-height: 112rpx;
  align-items: center;
  justify-content: center;
  padding: 24rpx;
  border: 1rpx dashed #ced4da;
  border-radius: 28rpx;
  background: #f5f6f7;
  box-sizing: border-box;
}

.mock-component-edit-panel {
  max-height: 78vh;
}

.mock-component-edit-scroll {
  height: 54vh;
  min-height: 360rpx;
  max-height: 54vh;
}

.mock-component-edit-content {
  gap: 20rpx;
}

.mock-editor-desc {
  margin-top: 0;
}

.mock-work-list {
  margin-top: 18rpx;
}

.mock-profile-editor {
  margin-top: 24rpx;
  padding: 18rpx;
  border: 1rpx solid #e9ecef;
  border-radius: 48rpx;
  background: #ffffff;
  box-sizing: border-box;
}

.profile-avatar-preview image {
  width: 100%;
  height: 100%;
}

.mock-single-work-title-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  margin-top: 24rpx;
  padding: 22rpx;
  border: 1rpx solid #e9ecef;
  border-radius: 48rpx;
  background: #ffffff;
  box-sizing: border-box;
}

.mock-single-work-title-copy {
  flex: 1;
  min-width: 0;
}
