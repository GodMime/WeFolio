<view class="page-shell portfolio-edit-page mock-portfolio-edit-page">
  <navigation-bar title="编辑作品集" color="#212529" background="rgba(245, 246, 247, 0.94)"></navigation-bar>

  <scroll-view class="edit-scroll" scroll-y type="list" scroll-top="{{editScrollTop}}">
    <view class="edit-content">
      <view class="panel share-panel">
        <view class="panel-heading">
          <view class="heading-copy">
            <view class="section-title">分享信息</view>
            <view class="section-desc">体验版可本地编辑并预览，保存和发布需要注册登录。</view>
          </view>
          <view class="status-pill muted">体验</view>
        </view>

        <view class="form-row cover-form-row">
          <view class="field-heading">
            <view class="field-label">分享封面</view>
          </view>
          <view class="cover-row">
            <view class="cover-preview" bindtap="handleLockedAction" aria-role="button" aria-label="选择分享封面">
              <image wx:if="{{draft.config.share.coverUrl}}" src="{{draft.config.share.coverUrl}}" mode="aspectFill"></image>
              <view wx:else class="cover-empty">封面</view>
            </view>
          </view>
        </view>

        <view class="form-row">
          <view class="field-heading">
            <view class="field-label">作品集标题</view>
          </view>
          <input class="input" value="{{draft.config.share.title}}" data-field="title" bindinput="handleShareInput" maxlength="50" />
        </view>
      </view>

      <view class="panel page-setting-panel">
        <view class="panel-heading">
          <view class="heading-copy">
            <view class="section-title">页面设置</view>
            <view class="section-desc">背景与菜单只保存在本地体验草稿中。</view>
          </view>
        </view>

        <view class="form-row">
          <view class="field-heading">
            <view class="field-label">背景色</view>
            <view class="field-limit">{{draft.config.style.backgroundColor}}</view>
          </view>
          <view class="background-color-row">
            <view class="background-color-current" style="background-color: {{draft.config.style.backgroundColor}};"></view>
            <view
              wx:for="{{backgroundColorOptions}}"
              wx:key="*this"
              class="background-color-swatch {{draft.config.style.backgroundColor === item ? 'active' : ''}}"
              style="background-color: {{item}};"
              data-color="{{item}}"
              bindtap="handleBackgroundColorTap"
              aria-role="button"
              aria-label="选择背景色{{item}}"
            ></view>
            <button class="background-custom-button" bindtap="handleOpenBackgroundColorSheet">自定义</button>
          </view>
        </view>

        <view class="form-row">
          <view class="field-heading">
            <view class="field-label">底部导航</view>
            <view class="field-limit">2~4 个菜单</view>
          </view>
          <view class="bottom-nav-count-row">
            <view
              wx:for="{{bottomNavCountOptions}}"
              wx:key="*this"
              class="bottom-nav-count-option {{bottomNavCount === item ? 'active' : ''}}"
              data-count="{{item}}"
              bindtap="handleBottomNavCountTap"
              aria-role="button"
            >{{item === 1 ? '不开启' : item + ' 个'}}</view>
          </view>
        </view>

        <view wx:if="{{draft.config.bottomNav.enabled}}" class="editor-menu-bar">
          <view
            wx:for="{{draft.config.bottomNav.items}}"
            wx:key="key"
            class="editor-menu-item {{activeMenuKey === item.key ? 'active' : ''}}"
            data-key="{{item.key}}"
            bindtap="handleEditorMenuTap"
          >{{item.title}}</view>
        </view>

        <view wx:if="{{draft.config.bottomNav.enabled}}" class="editor-menu-rename">
          <input
            class="editor-menu-title-input"
            value="{{activeMenuTitle}}"
            data-key="{{activeMenuKey}}"
            bindinput="handleEditorMenuTitleInput"
            maxlength="5"
          />
          <view class="editor-menu-title-count">{{activeMenuTitleCount}}/5</view>
          <button
            wx:if="{{draft.config.bottomNav.items.length > 2}}"
            class="editor-menu-remove"
            data-key="{{activeMenuKey}}"
            bindtap="handleRemoveEditorMenu"
          >删除菜单</button>
        </view>
      </view>

      <view class="panel component-panel">
        <view class="panel-heading">
          <view class="heading-copy">
            <view class="section-title">组件编排</view>
            <view class="section-desc">已使用的组件按当前菜单顺序展示</view>
          </view>
          <button class="link-button" bindtap="handleOpenComponentSheet">添加组件</button>
        </view>

        <view class="component-list">
          <view
            wx:for="{{componentRows}}"
            wx:key="componentKey"
            class="component-swipe-row {{item.active ? 'active' : ''}} {{revealedComponentKey === item.componentKey ? 'revealed' : ''}} {{draggingIndex === index ? 'dragging' : ''}}"
            data-index="{{index}}"
            data-key="{{item.componentKey}}"
            data-type="{{item.componentType}}"
            bindtouchstart="handleComponentTouchStart"
            bindlongpress="handleComponentDragStart"
            bindtouchmove="handleComponentTouchMove"
            bindtouchend="handleComponentTouchEnd"
            bindtouchcancel="handleComponentTouchCancel"
          >
            <view class="component-remove-pane" catchtap="noop">
              <button class="component-remove-button" data-key="{{item.componentKey}}" catchtap="handleRemoveComponent">删除</button>
            </view>
            <view
              class="component-row editable {{item.active ? 'active' : ''}} {{draggingIndex === index ? 'dragging' : ''}} {{dragTargetIndex === index && draggingIndex !== -1 ? 'drag-target' : ''}}"
              style="{{draggingIndex === index ? componentDragStyle : ''}}"
              data-key="{{item.componentKey}}"
              data-type="{{item.componentType}}"
              catchtap="handleComponentTap"
              aria-role="button"
              aria-label="编辑{{item.name}}组件"
            >
              <view class="component-order">{{index + 1}}</view>
              <view class="component-copy mock-component-copy">
                <view class="component-title">{{item.name}}</view>
                <view class="mock-component-summary">{{item.summary}}</view>
              </view>
              <view class="component-drag-handle"></view>
              <view class="component-row-arrow">
                <view class="component-row-arrow-icon"></view>
              </view>
            </view>
          </view>
          <view wx:if="{{componentRows.length === 0}}" class="mock-component-empty">
            <view class="section-desc">暂无组件，请添加组件后编辑。</view>
          </view>
        </view>
      </view>

    </view>
  </scroll-view>

  <view class="component-picker-mask {{backgroundColorSheetVisible ? 'visible' : ''}}" catchtap="handleCloseBackgroundColorSheet">
    <view class="component-picker-panel mock-background-color-panel" catchtap="noop">
      <view class="component-picker-grabber"></view>
      <view class="component-picker-heading">
        <view class="component-picker-title">自定义背景色</view>
        <view class="component-picker-count">HEX</view>
      </view>
      <view
        class="background-color-pad"
        style="background-color: {{backgroundHueColor}};"
        bindtouchstart="handleBackgroundColorPadTouch"
        catchtouchmove="handleBackgroundColorPadTouch"
      >
        <view class="background-color-pad-white"></view>
        <view class="background-color-pad-black"></view>
        <view class="background-color-pad-dot" style="{{backgroundColorPadDotStyle}}"></view>
      </view>
      <view class="background-hue-slider">
        <slider
          min="0"
          max="359"
          value="{{backgroundColorHsv.hue}}"
          bindchanging="handleBackgroundHueChange"
          backgroundColor="transparent"
          activeColor="transparent"
          block-color="transparent"
          block-size="22"
        ></slider>
        <view
          class="background-hue-thumb"
          style="left: {{backgroundColorHsv.hue / 3.59}}%; background-color: {{backgroundHueColor}};"
        ></view>
      </view>
      <input
        class="background-hex-input mock-background-color-input"
        value="{{customBackgroundColor}}"
        bindinput="handleCustomBackgroundColorInput"
        bindblur="handleCustomBackgroundColorBlur"
        maxlength="7"
        placeholder="#FFFFFF"
      />
      <view class="background-color-preview-bar">
        <view class="background-color-preview-chip" style="background-color: {{customBackgroundColor}};"></view>
        <view class="background-color-preview-text">预览 {{customBackgroundColor}}</view>
      </view>
      <view class="component-picker-actions">
        <button class="component-picker-cancel" catchtap="handleCloseBackgroundColorSheet">取消</button>
        <button class="mock-background-color-confirm" catchtap="handleConfirmBackgroundColor">应用</button>
      </view>
    </view>
  </view>

  <view class="component-picker-mask {{componentSheetVisible ? 'visible' : ''}}" catchtap="handleCloseComponentSheet">
    <view class="component-picker-panel" catchtap="noop">
      <view class="component-picker-grabber"></view>
      <view class="component-picker-heading">
        <view class="component-picker-title">选择组件</view>
        <view class="component-picker-count">{{componentOptions.length}} 个可选</view>
      </view>

      <scroll-view class="component-option-scroll" scroll-y type="list">
        <view class="component-option-list-content">
          <view
            wx:for="{{componentOptions}}"
            wx:key="componentType"
            class="component-option"
            data-type="{{item.componentType}}"
            catchtap="handleSelectComponent"
            aria-role="button"
            aria-label="添加{{item.name}}组件"
          >
            <view class="component-option-copy">
              <view class="component-option-name">{{item.name}}</view>
              <view class="component-option-desc">{{item.description}}</view>
            </view>
            <view class="component-option-plus">+</view>
          </view>
        </view>
      </scroll-view>

      <view class="component-picker-actions">
        <button class="component-picker-cancel" catchtap="handleCloseComponentSheet">取消</button>
      </view>
    </view>
  </view>

  <view class="mock-component-edit-mask component-work-picker-mask {{componentEditSheetVisible ? 'visible' : ''}}" catchtap="handleCloseComponentEditSheet">
    <view class="mock-component-edit-panel component-work-picker-panel" catchtap="noop">
      <view class="component-picker-grabber"></view>
      <view class="component-picker-heading">
        <view class="component-picker-title">{{selectedComponentName || '编辑组件'}}</view>
        <view class="component-picker-count">可编辑</view>
      </view>

      <scroll-view class="mock-component-edit-scroll profile-form-scroll" scroll-y type="list">
        <view class="profile-form-list-content mock-component-edit-content">
          <block wx:if="{{selectedComponentType === 'CAROUSEL'}}">
            <view class="section-desc mock-editor-desc">轮播图仅展示图片作品。</view>
            <view class="component-work-list-content mock-work-list">
              <view wx:for="{{workOptions}}" wx:key="id" class="component-work-option {{item.selected ? 'selected' : ''}}" data-id="{{item.id}}" bindtap="handleWorkToggle">
                <view class="component-work-thumb">
                  <image src="{{item.coverUrl}}" mode="aspectFill"></image>
                </view>
                <view class="component-work-copy">
                  <view class="component-work-title">{{item.title}}</view>
                  <view class="component-work-meta">图片 / 风景作品</view>
                </view>
                <view class="component-work-check">{{item.selected ? '✓' : ''}}</view>
              </view>
            </view>
          </block>

          <block wx:elif="{{selectedComponentType === 'WORK_GRID'}}">
            <view class="section-desc mock-editor-desc">双列作品列表支持图片和视频作品。</view>
            <view class="component-work-list-content mock-work-list">
              <view wx:for="{{workOptions}}" wx:key="id" class="component-work-option {{item.selected ? 'selected' : ''}}" data-id="{{item.id}}" bindtap="handleWorkToggle">
                <view class="component-work-thumb">
                  <image src="{{item.coverUrl}}" mode="aspectFill"></image>
                </view>
                <view class="component-work-copy">
                  <view class="component-work-title">{{item.title}}</view>
                  <view class="component-work-meta">{{item.mediaType === 'VIDEO' ? '视频' : '图片'}} / 风景作品</view>
                </view>
                <view class="component-work-check">{{item.selected ? '✓' : ''}}</view>
              </view>
            </view>
          </block>

          <block wx:elif="{{selectedComponentType === 'WORK_LIST'}}">
            <view class="section-desc mock-editor-desc">单列作品列表支持图片和视频作品。</view>
            <view class="component-work-list-content mock-work-list">
              <view wx:for="{{workOptions}}" wx:key="id" class="component-work-option {{item.selected ? 'selected' : ''}}" data-id="{{item.id}}" bindtap="handleWorkToggle">
                <view class="component-work-thumb">
                  <image src="{{item.coverUrl}}" mode="aspectFill"></image>
                </view>
                <view class="component-work-copy">
                  <view class="component-work-title">{{item.title}}</view>
                  <view class="component-work-meta">{{item.mediaType === 'VIDEO' ? '视频' : '图片'}} / 风景作品</view>
                </view>
                <view class="component-work-check">{{item.selected ? '✓' : ''}}</view>
              </view>
            </view>
          </block>

          <block wx:elif="{{selectedComponentType === 'SINGLE_WORK'}}">
            <view class="section-desc mock-editor-desc">单个作品支持一张图片或一个视频，点击当前作品不会取消选择。</view>
            <view class="component-work-list-content mock-work-list">
              <view
                wx:for="{{workOptions}}"
                wx:key="id"
                class="component-work-option {{item.selected ? 'selected' : ''}}"
                data-id="{{item.id}}"
                bindtap="handleWorkToggle"
                aria-role="radio"
                aria-checked="{{item.selected}}"
              >
                <view class="component-work-thumb">
                  <image src="{{item.coverUrl}}" mode="aspectFill"></image>
                </view>
                <view class="component-work-copy">
                  <view class="component-work-title">{{item.title}}</view>
                  <view class="component-work-meta">{{item.mediaType === 'VIDEO' ? '视频' : '图片'}} / 风景作品</view>
                </view>
                <view class="component-work-check">{{item.selected ? '✓' : ''}}</view>
              </view>
            </view>
            <view class="mock-single-work-title-row">
              <view class="mock-single-work-title-copy">
                <view class="field-label">展示作品名</view>
                <view class="section-desc">关闭后预览不显示标题及占位。</view>
              </view>
              <switch checked="{{singleWorkShowTitle}}" bindchange="handleSingleWorkShowTitleChange" color="#212529"></switch>
            </view>
          </block>

          <block wx:elif="{{selectedComponentType === 'PROFILE'}}">
            <view class="profile-avatar-editor mock-profile-editor">
              <view class="profile-avatar-preview" catchtap="handleLockedAction" aria-role="button" aria-label="上传头像">
                <image src="{{profileForm.avatarUrl}}" mode="aspectFill"></image>
              </view>
              <view class="profile-avatar-copy">
                <view class="field-label">{{profileForm.displayName}}</view>
                <view class="profile-avatar-state">{{profileForm.profession}} · {{profileForm.city}}</view>
              </view>
              <button class="profile-avatar-button" catchtap="handleLockedAction">上传头像</button>
            </view>
            <view class="form-row">
              <view class="field-heading">
                <view class="field-label">昵称</view>
              </view>
              <input class="input profile-sheet-input" value="{{profileForm.displayName}}" data-field="displayName" bindinput="handleProfileInput" />
            </view>
            <view class="form-row">
              <view class="field-heading">
                <view class="field-label">职业</view>
              </view>
              <input class="input profile-sheet-input" value="{{profileForm.profession}}" data-field="profession" bindinput="handleProfileInput" />
            </view>
            <view class="form-row">
              <view class="field-heading">
                <view class="field-label">城市</view>
              </view>
              <input class="input profile-sheet-input" value="{{profileForm.city}}" data-field="city" bindinput="handleProfileInput" />
            </view>
            <view class="form-row">
              <view class="field-heading">
                <view class="field-label">简介</view>
              </view>
              <textarea class="input textarea profile-sheet-textarea" value="{{profileForm.bio}}" data-field="bio" bindinput="handleProfileInput"></textarea>
            </view>
          </block>

          <block wx:elif="{{selectedComponentType === 'SCHEDULE_QUERY'}}">
            <view class="form-row">
              <view class="field-heading">
                <view class="field-label">标题</view>
              </view>
              <input class="input" value="{{scheduleQueryForm.title}}" data-field="title" bindinput="handleScheduleInput" />
            </view>
            <view class="form-row">
              <view class="field-heading">
                <view class="field-label">说明</view>
              </view>
              <textarea class="input textarea" value="{{scheduleQueryForm.description}}" data-field="description" bindinput="handleScheduleInput"></textarea>
            </view>
          </block>

          <block wx:elif="{{selectedComponentType === 'CONTACT_FORM'}}">
            <view class="form-row">
              <view class="field-heading">
                <view class="field-label">标题</view>
              </view>
              <input class="input" value="{{contactFormConfig.title}}" data-field="title" bindinput="handleContactInput" />
            </view>
            <view class="form-row">
              <view class="field-heading">
                <view class="field-label">说明</view>
              </view>
              <textarea class="input textarea" value="{{contactFormConfig.description}}" data-field="description" bindinput="handleContactInput"></textarea>
            </view>
          </block>

          <block wx:elif="{{selectedComponentType === 'QR_CONTACT'}}">
            <view class="section-desc mock-editor-desc">二维码联系组件已加入作品集。体验版不上传二维码图片，注册登录后可在正式页面配置。</view>
            <view class="form-row">
              <view class="field-heading">
                <view class="field-label">二维码来源</view>
              </view>
              <view class="qr-source-tabs" aria-role="tablist">
                <button class="qr-source-tab active" aria-role="tab" aria-selected="{{true}}" catchtap="handleLockedAction">个人资料</button>
                <button class="qr-source-tab" aria-role="tab" aria-selected="{{false}}" catchtap="handleLockedAction">自定义图片</button>
              </view>
            </view>
            <view class="qr-contact-image-editor">
              <view class="qr-contact-image-preview profile" catchtap="handleLockedAction" aria-role="button" aria-label="上传二维码">
                <view class="qr-contact-image-placeholder">二维码</view>
              </view>
              <button class="profile-avatar-button" catchtap="handleLockedAction">上传二维码</button>
            </view>
          </block>

          <block wx:elif="{{selectedComponentType === 'TEXT_SECTION'}}">
            <view class="form-row">
              <view class="field-heading">
                <view class="field-label">说明</view>
              </view>
              <textarea class="input textarea profile-sheet-textarea text-section-sheet-textarea" value="{{textSectionForm.content}}" placeholder="请输入给访客看的说明文字" maxlength="200" bindinput="handleTextSectionInput"></textarea>
            </view>
            <view class="form-row">
              <view class="field-heading">
                <view class="field-label">对齐方式</view>
              </view>
              <view class="schedule-query-mode-list">
                <view
                  wx:for="{{textSectionAlignmentOptions}}"
                  wx:key="value"
                  class="schedule-query-mode-option {{textSectionForm.alignment === item.value ? 'active' : ''}}"
                  data-value="{{item.value}}"
                  catchtap="handleTextSectionAlignmentTap"
                  aria-role="radio"
                  aria-checked="{{textSectionForm.alignment === item.value}}"
                >
                  <view class="schedule-query-mode-radio"></view>
                  <view class="schedule-query-mode-label">{{item.label}}</view>
                </view>
              </view>
            </view>
          </block>

          <block wx:elif="{{selectedComponentType === 'DIVIDER'}}">
            <view class="form-row">
              <view class="field-heading">
                <view class="field-label">颜色</view>
              </view>
              <view class="divider-color-list">
                <view
                  wx:for="{{dividerColorOptions}}"
                  wx:key="value"
                  class="divider-color-option {{dividerForm.color === item.value ? 'active' : ''}}"
                  data-value="{{item.value}}"
                  catchtap="handleDividerColorTap"
                  aria-role="radio"
                  aria-checked="{{dividerForm.color === item.value}}"
                >
                  <view class="divider-color-swatch" style="background-color: {{item.colorValue}};"></view>
                  <view class="divider-color-label">{{item.label}}</view>
                </view>
              </view>
            </view>
            <view class="form-row">
              <view class="field-heading">
                <view class="field-label">高度(px)</view>
              </view>
              <input class="input divider-height-input" type="number" value="{{dividerForm.heightPx}}" placeholder="16" bindinput="handleDividerHeightInput" />
            </view>
          </block>

          <view wx:else class="component-work-state">请先选择组件</view>
        </view>
      </scroll-view>

      <view class="component-work-actions">
        <button class="component-work-cancel" catchtap="handleCloseComponentEditSheet">取消</button>
        <button class="component-work-confirm" catchtap="handleConfirmComponentEditSheet">完成</button>
      </view>
    </view>
  </view>

  <view class="bottom-actions">
    <button class="action-button primary-button" bindtap="handleSaveDraft">保存草稿</button>
    <view class="preview-action-stack">
      <button class="action-button secondary-button preview-draft-button" bindtap="handlePreview">
        <view class="preview-action-title">预览</view>
        <view class="preview-action-note">本地草稿</view>
      </button>
    </view>
    <button class="action-button publish-button" bindtap="handlePublish">发布</button>
  </view>
</view>
