@import "../styles/works.wxss";
@import "../common.wxss";

.image-preview-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 42;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 36rpx;
  opacity: 0;
  pointer-events: none;
  background: rgba(10, 14, 20, 0.88);
  transition: opacity 260ms ease;
  box-sizing: border-box;
}

.image-preview-mask.visible {
  opacity: 1;
  pointer-events: auto;
}

.image-preview-panel {
  width: 100%;
  max-height: calc(86vh - env(safe-area-inset-bottom));
  display: flex;
  flex-direction: column;
  gap: 18rpx;
  transform: translateY(18rpx) scale(0.97);
  transition: transform 260ms cubic-bezier(0.18, 0, 0.12, 1);
}

.image-preview-mask.visible .image-preview-panel {
  transform: translateY(0) scale(1);
}

.image-preview-heading,
.video-preview-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.image-preview-title,
.video-preview-title {
  flex: 1 1 auto;
  min-width: 0;
  overflow: hidden;
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 900;
  line-height: 1.3;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.image-preview-close,
.video-preview-close {
  width: 58rpx;
  height: 58rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
  color: #ffffff;
  font-size: 36rpx;
  font-weight: 700;
  line-height: 1;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.18);
}

.image-preview-media {
  width: 100%;
  height: 72vh;
  max-height: 900rpx;
  border-radius: 12rpx;
  overflow: hidden;
  background: #000000;
}

.video-preview-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 42;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 36rpx;
  opacity: 0;
  pointer-events: none;
  background: rgba(10, 14, 20, 0.88);
  transition: opacity 260ms ease;
  box-sizing: border-box;
}

.video-preview-mask.visible {
  opacity: 1;
  pointer-events: auto;
}

.video-preview-panel {
  width: 100%;
  max-height: calc(86vh - env(safe-area-inset-bottom));
  display: flex;
  flex-direction: column;
  gap: 18rpx;
  transform: translateY(18rpx) scale(0.97);
  transition: transform 260ms cubic-bezier(0.18, 0, 0.12, 1);
}

.video-preview-mask.visible .video-preview-panel {
  transform: translateY(0) scale(1);
}

.video-preview-player {
  width: 100%;
  height: 62vh;
  max-height: 720rpx;
  border-radius: 12rpx;
  overflow: hidden;
  background: #000000;
}
