@import "../styles/works.wxss";
@import "../common.wxss";

.image-preview-mask,
.video-preview-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 40;
  display: flex;
  align-items: flex-end;
  background: rgba(0, 0, 0, 0.56);
  opacity: 0;
  pointer-events: none;
  transition: opacity 220ms ease;
}

.image-preview-mask.visible,
.video-preview-mask.visible {
  opacity: 1;
  pointer-events: auto;
}

.image-preview-panel,
.video-preview-panel {
  width: 100%;
  padding: 24rpx 32rpx calc(32rpx + env(safe-area-inset-bottom));
  border-radius: 56rpx 56rpx 0 0;
  background: #111827;
  box-sizing: border-box;
  transform: translateY(100%);
  transition: transform 260ms cubic-bezier(0.2, 0, 0, 1);
}

.image-preview-mask.visible .image-preview-panel,
.video-preview-mask.visible .video-preview-panel {
  transform: translateY(0);
}

.video-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 18rpx;
}

.video-title {
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 900;
}

.video-close {
  width: 56rpx;
  height: 56rpx;
  color: #ffffff;
  font-size: 44rpx;
  line-height: 56rpx;
  text-align: center;
}

.video-player {
  width: 100%;
  height: 420rpx;
  border-radius: 40rpx;
  overflow: hidden;
  background: #000000;
}

.image-player {
  width: 100%;
  height: 560rpx;
  border-radius: 40rpx;
  overflow: hidden;
  background: #000000;
}
