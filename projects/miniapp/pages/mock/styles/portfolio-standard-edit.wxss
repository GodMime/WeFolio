.portfolio-edit-page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.edit-scroll {
  flex: 1;
  min-height: 0;
}

.field-heading,
.link-button,
.status-pill,
.component-drag-handle,
.component-row-arrow,
.component-option,
.component-option-plus,
.component-option-added,
.component-work-option,
.component-work-check,
.component-work-state,
.component-work-retry,
.component-work-tools,
.component-work-search,
.component-work-search-clear,
.component-work-filter-row,
.component-work-filter-pill,
.component-work-footer,
.component-work-meta-row,
.component-work-ratio,
.profile-refresh-button,
.profile-visibility-option,
.cover-row,
.cover-preview,
.cover-empty {
  display: flex;
  align-items: center;
}

.heading-copy,
.component-copy {
  flex: 1 1 auto;
  min-width: 0;
}

.component-copy {
  display: flex;
  align-items: center;
}

.component-copy.with-summary {
  flex-direction: column;
  align-items: flex-start;
  justify-content: center;
}

.section-desc {
  margin-top: 8rpx;
  color: var(--pe-color-text-secondary, #868E96);
  font-size: 24rpx;
  line-height: 1.45;
}

.status-pill {
  flex: none;
  min-width: 96rpx;
  height: 48rpx;
  justify-content: center;
  padding: 0 18rpx;
  color: var(--pe-color-text-secondary, #868E96);
  font-size: 22rpx;
  font-weight: 800;
  line-height: 1;
  border: 1rpx solid var(--pe-color-border-strong, #DEE2E6);
  border-radius: 999rpx;
  background: var(--pe-color-page, #F5F6F7);
  box-sizing: border-box;
}

.status-pill.published {
  color: #5c9e6e;
  border-color: #c7ddcd;
  background: #f1f7f2;
}

.status-pill.muted {
  color: var(--pe-color-text-secondary, #868E96);
  border-color: var(--pe-color-border-strong, #DEE2E6);
  background: var(--pe-color-page, #F5F6F7);
}

.form-row {
  margin-top: 24rpx;
}

.field-heading {
  justify-content: space-between;
}

.field-label {
  color: var(--pe-color-text-strong, #495057);
  font-size: 24rpx;
  font-weight: 800;
  line-height: 1.3;
}

.field-limit {
  flex: none;
  color: var(--pe-color-text-muted, #ADB5BD);
  font-size: 22rpx;
  font-weight: 700;
  line-height: 1.3;
}

.cover-row {
  gap: 20rpx;
  margin-top: 12rpx;
  align-items: flex-start;
}

.cover-preview {
  width: 360rpx;
  height: 288rpx;
  flex: 0 0 360rpx;
  justify-content: center;
  overflow: hidden;
  border: 1rpx solid var(--pe-color-border, #E9ECEF);
  border-radius: 32rpx;
  background: var(--pe-color-secondary-disabled, #F1F3F5);
  box-sizing: border-box;
}

.cover-preview image {
  width: 100%;
  height: 100%;
}

.cover-empty {
  justify-content: center;
  width: 100%;
  height: 100%;
  color: var(--pe-color-text-muted, #ADB5BD);
  font-size: 24rpx;
  font-weight: 800;
}

.link-button {
  width: 136rpx;
  min-width: 136rpx;
  max-width: 136rpx;
  height: 56rpx;
  flex: 0 0 136rpx;
  justify-content: center;
  margin: 0;
  padding: 0;
  color: var(--pe-color-text-strong, #495057);
  font-size: 24rpx;
  font-weight: 900;
  line-height: 1;
  border: 1rpx solid var(--pe-color-border-strong, #DEE2E6);
  border-radius: 999rpx;
  background: var(--pe-color-page, #F5F6F7);
  box-sizing: border-box;
}

.component-list {
  margin-top: 24rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.component-swipe-row {
  position: relative;
  overflow: hidden;
  border-radius: var(--pe-radius-control, 28rpx);
}

.component-swipe-row.dragging {
  z-index: 3;
  overflow: visible;
}

.component-swipe-row.revealed .component-row {
  transform: translateX(-140rpx);
}

.component-row.dragging {
  border-color: var(--pe-color-border-strong, #DEE2E6);
  background: var(--pe-color-page, #F5F6F7);
  box-shadow: none;
}

.component-row.drag-target {
  border-color: var(--pe-color-text-primary, #212529);
}

.component-remove-pane {
  position: absolute;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 1;
  width: 128rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  transform: translateX(100%);
  opacity: 0;
  pointer-events: none;
  transition: transform 180ms ease, opacity 160ms ease;
}

.component-swipe-row.revealed .component-remove-pane {
  transform: translateX(0);
  opacity: 1;
  pointer-events: auto;
}

.component-swipe-row.dragging .component-remove-pane {
  transform: translateX(100%);
  opacity: 0;
  pointer-events: none;
}

.component-drag-handle {
  width: 42rpx;
  height: 48rpx;
  flex: none;
  align-self: center;
  justify-content: center;
  border-radius: 12rpx;
  background: linear-gradient(
    to bottom,
    transparent 0,
    transparent 10rpx,
    #6f7f90 10rpx,
    #6f7f90 14rpx,
    transparent 14rpx,
    transparent 22rpx,
    #6f7f90 22rpx,
    #6f7f90 26rpx,
    transparent 26rpx,
    transparent 34rpx,
    #6f7f90 34rpx,
    #6f7f90 38rpx,
    transparent 38rpx,
    transparent 48rpx
  );
  background-position: center center;
  background-size: 22rpx 48rpx;
  background-repeat: no-repeat;
}

.component-row-arrow {
  width: 28rpx;
  height: 48rpx;
  flex: none;
  align-self: center;
  justify-content: center;
  color: var(--pe-color-text-secondary, #868E96);
  font-size: 0;
  font-weight: 700;
  line-height: 0;
}

.component-row-arrow-icon {
  width: 16rpx;
  height: 16rpx;
  border-right: 5rpx solid var(--pe-color-text-secondary, #868E96);
  border-bottom: 5rpx solid var(--pe-color-text-secondary, #868E96);
  transform: rotate(-45deg);
  box-sizing: border-box;
}

.component-row-arrow.placeholder {
  visibility: hidden;
}

.component-option-scroll {
  height: 46vh;
  min-height: 320rpx;
  max-height: 46vh;
  flex: 1 1 auto;
}

.component-option-list-content {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.component-option {
  width: 100%;
  min-width: 100%;
  max-width: 100%;
  min-height: 106rpx;
  justify-content: space-between;
  margin: 0;
}

.component-option.disabled {
  opacity: 0.5;
}

.component-option-copy {
  min-width: 0;
  flex: 1 1 auto;
  text-align: left;
}

.component-option-name {
  color: var(--pe-color-text-primary, #212529);
  font-size: 26rpx;
  font-weight: 900;
  line-height: 1.25;
}

.component-option-desc {
  overflow: hidden;
  margin-top: 8rpx;
  color: var(--pe-color-text-secondary, #868E96);
  font-size: 22rpx;
  line-height: 1.3;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.component-option-plus {
  width: 44rpx;
  height: 44rpx;
  flex: none;
  justify-content: center;
  margin-left: 18rpx;
  color: var(--pe-color-surface, #FFFFFF);
  font-size: 28rpx;
  font-weight: 900;
  line-height: 1;
  border-radius: 50%;
  background: var(--pe-color-text-primary, #212529);
}

.component-option-added {
  width: auto;
  min-width: 104rpx;
  height: 44rpx;
  flex: none;
  justify-content: center;
  margin-left: 18rpx;
  padding: 0 18rpx;
  color: var(--pe-color-surface, #FFFFFF);
  font-size: 22rpx;
  font-weight: 800;
  line-height: 1;
  border-radius: 999rpx;
  background: var(--pe-color-text-primary, #212529);
  box-sizing: border-box;
  white-space: nowrap;
}

.component-work-tools {
  width: 100%;
  flex-direction: column;
  align-items: stretch;
  gap: 12rpx;
}

.component-work-search {
  width: 100%;
  height: 64rpx;
  gap: 14rpx;
  padding: 0 18rpx;
  border: 1rpx solid var(--pe-color-border-strong, #DEE2E6);
  border-radius: 14rpx;
  background: var(--pe-color-page, #F5F6F7);
  box-sizing: border-box;
}

.component-work-search-icon {
  position: relative;
  width: 20rpx;
  height: 20rpx;
  flex: none;
  border: 3rpx solid var(--pe-color-text-muted, #ADB5BD);
  border-radius: 50%;
  box-sizing: border-box;
}

.component-work-search-icon::after {
  content: "";
  position: absolute;
  right: -8rpx;
  bottom: -7rpx;
  width: 10rpx;
  height: 3rpx;
  border-radius: 999rpx;
  background: var(--pe-color-text-muted, #ADB5BD);
  transform: rotate(45deg);
}

.component-work-search-input {
  height: 64rpx;
  min-width: 0;
  flex: 1 1 0;
  color: var(--pe-color-text-primary, #212529);
  font-size: 24rpx;
  font-weight: 700;
  line-height: 64rpx;
}

.component-work-search-clear {
  width: 34rpx;
  height: 34rpx;
  flex: none;
  justify-content: center;
  color: var(--pe-color-text-secondary, #868E96);
  font-size: 24rpx;
  font-weight: 900;
  line-height: 1;
  border-radius: 50%;
  background: var(--pe-color-border-strong, #DEE2E6);
}

.component-work-filter-scroll {
  width: 100%;
  height: 58rpx;
  white-space: nowrap;
}

.component-work-filter-row {
  width: auto;
  height: 58rpx;
  min-width: 0;
  display: inline-flex;
  justify-content: flex-start;
  gap: 12rpx;
}

.component-work-filter-pill {
  width: auto;
  max-width: 236rpx;
  height: 50rpx;
  flex: 0 0 auto;
  justify-content: center;
  margin: 0;
  padding: 0 18rpx;
  overflow: hidden;
  color: var(--pe-color-text-secondary, #868E96);
  font-size: 22rpx;
  font-weight: 800;
  line-height: 1;
  text-overflow: ellipsis;
  white-space: nowrap;
  border: 1rpx solid var(--pe-color-border-strong, #DEE2E6);
  border-radius: 999rpx;
  background: var(--pe-color-surface, #FFFFFF);
  box-sizing: border-box;
}

.component-work-scroll {
  flex: 1 1 auto;
  height: 0;
  min-height: 0;
  max-height: none;
}

.component-work-list-content {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.component-work-option {
  width: 100%;
  min-height: 112rpx;
  gap: 18rpx;
  padding: 14rpx;
  border: 1rpx solid var(--pe-color-border-strong, #DEE2E6);
  border-radius: 14rpx;
  background: var(--pe-color-page, #F5F6F7);
  box-sizing: border-box;
}

.component-work-thumb {
  width: 92rpx;
  height: 76rpx;
  flex: none;
  overflow: hidden;
  border-radius: 12rpx;
  background: var(--pe-color-page, #F5F6F7);
}

.component-work-thumb image {
  width: 100%;
  height: 100%;
}

.component-work-thumb-empty {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--pe-color-text-muted, #ADB5BD);
  font-size: 20rpx;
  font-weight: 800;
}

.component-work-copy {
  min-width: 0;
  flex: 1 1 0;
}

.component-work-title {
  overflow: hidden;
  color: var(--pe-color-text-primary, #212529);
  font-size: 26rpx;
  font-weight: 900;
  line-height: 1.3;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.component-work-meta-row {
  min-width: 0;
  margin-top: 8rpx;
  gap: 10rpx;
}

.component-work-meta {
  min-width: 0;
  flex: 0 1 auto;
  overflow: hidden;
  color: var(--pe-color-text-secondary, #868E96);
  font-size: 22rpx;
  line-height: 1.25;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.component-work-ratio {
  min-height: 32rpx;
  flex: none;
  justify-content: center;
  padding: 0 10rpx;
  color: var(--pe-color-text-secondary, #868E96);
  font-size: 20rpx;
  font-weight: 900;
  line-height: 1;
  border: 1rpx solid var(--pe-color-border-strong, #DEE2E6);
  border-radius: 999rpx;
  background: var(--pe-color-surface, #FFFFFF);
  box-sizing: border-box;
}

.component-work-check {
  width: 44rpx;
  height: 44rpx;
  flex: none;
  justify-content: center;
  color: var(--pe-color-surface, #FFFFFF);
  font-size: 24rpx;
  font-weight: 900;
  line-height: 1;
  border-radius: 50%;
  background: var(--pe-color-border-strong, #DEE2E6);
}

.component-work-check.carousel-order {
  font-size: 22rpx;
}

.component-work-option[aria-checked="true"] .component-work-check {
  background: var(--pe-color-text-primary, #212529);
}

.component-work-footer {
  min-height: 48rpx;
  justify-content: center;
  color: var(--pe-color-text-muted, #ADB5BD);
  font-size: 22rpx;
  font-weight: 700;
  line-height: 1.3;
}

.component-work-state {
  min-height: 220rpx;
  justify-content: center;
  gap: 16rpx;
  color: var(--pe-color-text-secondary, #868E96);
  font-size: 24rpx;
  line-height: 1.5;
}

.component-work-state.error {
  color: var(--pe-color-danger, #B55656);
}

.component-work-retry {
  min-height: 48rpx;
  padding: 0 18rpx;
  color: var(--pe-color-text-primary, #212529);
  font-weight: 800;
  border: 1rpx solid var(--pe-color-border-strong, #DEE2E6);
  border-radius: 999rpx;
  background: var(--pe-color-page, #F5F6F7);
}

.single-work-title-setting {
  min-height: 96rpx;
  justify-content: space-between;
  gap: 24rpx;
  padding: 16rpx 4rpx;
  border-top: 1rpx solid var(--pe-color-border, #E9ECEF);
}

.single-work-title-setting-copy {
  flex: 1;
  flex-direction: column;
  align-items: flex-start;
}

.single-work-title-setting-label {
  color: var(--pe-color-text-primary, #212529);
  font-size: 26rpx;
  font-weight: 900;
}

.single-work-title-setting-note {
  color: var(--pe-color-text-muted, #ADB5BD);
  font-size: 21rpx;
}

.profile-refresh-button {
  width: auto;
  min-width: 176rpx;
  height: 56rpx;
  flex: none;
  justify-content: center;
  margin: 0;
  padding: 0 18rpx;
  color: var(--pe-color-text-primary, #212529);
  font-size: 22rpx;
  font-weight: 900;
  line-height: 56rpx;
  border: 1rpx solid var(--pe-color-border-strong, #DEE2E6);
  border-radius: 999rpx;
  background: var(--pe-color-page, #F5F6F7);
  box-sizing: border-box;
}

.profile-form-scroll {
  max-height: 54vh;
}

.profile-sheet-scroll {
  flex: 1 1 auto;
  height: 0;
  min-height: 0;
  max-height: none;
}

.profile-form-list-content {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.profile-sheet-fields-panel,
.profile-form-section {
  padding: 24rpx;
  border: 1rpx solid var(--pe-color-border, #E9ECEF);
  border-radius: 32rpx;
  background: var(--pe-color-surface, #FFFFFF);
  box-sizing: border-box;
}

.profile-avatar-editor {
  display: flex;
  align-items: center;
  gap: 16rpx;
  width: 100%;
}

.profile-avatar-preview {
  width: 96rpx;
  height: 96rpx;
  flex: none;
  overflow: hidden;
  border-radius: 50%;
  background: var(--pe-color-page, #F5F6F7);
}

.profile-avatar-preview image {
  width: 100%;
  height: 100%;
}

.profile-avatar-placeholder {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--pe-color-text-muted, #ADB5BD);
  font-size: 22rpx;
  font-weight: 800;
}

.profile-avatar-copy {
  min-width: 0;
  flex: 1 1 0;
}

.profile-avatar-state {
  margin-top: 8rpx;
  color: var(--pe-color-text-muted, #ADB5BD);
  font-size: 22rpx;
  font-weight: 700;
  line-height: 1.2;
}

.profile-avatar-button {
  height: 56rpx;
  flex: none;
  justify-content: center;
  margin: 0;
  padding: 0 18rpx;
  font-size: 22rpx;
  font-weight: 900;
  line-height: 56rpx;
  border-radius: 999rpx;
  box-sizing: border-box;
}

.profile-avatar-button {
  min-width: 144rpx;
  color: var(--pe-color-text-primary, #212529);
  border: 1rpx solid var(--pe-color-border-strong, #DEE2E6);
  background: var(--pe-color-page, #F5F6F7);
}

.profile-qr-editor {
  display: flex;
  align-items: center;
  gap: 18rpx;
  width: 100%;
}

.profile-qr-preview {
  width: 160rpx;
  height: 160rpx;
  flex: none;
  overflow: hidden;
  border: 1rpx solid var(--pe-color-border, #E9ECEF);
  border-radius: 16rpx;
  background: var(--pe-color-page, #F5F6F7);
  box-sizing: border-box;
}

.profile-qr-preview image {
  width: 100%;
  height: 100%;
}

.profile-qr-placeholder {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--pe-color-text-muted, #ADB5BD);
  font-size: 22rpx;
  font-weight: 800;
}

.qr-source-row {
  gap: 14rpx;
}

.qr-source-tabs {
  display: flex;
  min-height: 76rpx;
  margin: 8rpx 0 12rpx;
  padding: 8rpx;
  gap: 8rpx;
  border: 1rpx solid var(--pe-color-border, #E9ECEF);
  border-radius: 24rpx;
  background: var(--pe-color-page, #F5F6F7);
  box-sizing: border-box;
}

.qr-source-tab {
  display: flex;
  align-items: center;
  height: 60rpx;
  flex: 1 1 0;
  justify-content: center;
  margin: 0;
  padding: 0 16rpx;
  color: var(--pe-color-text-secondary, #868E96);
  font-size: 24rpx;
  font-weight: 800;
  line-height: 1;
  border-radius: 10rpx;
  background: transparent;
  box-sizing: border-box;
}

.qr-source-tab-panel {
  margin-top: 2rpx;
  width: 100%;
}

.qr-contact-image-editor {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 18rpx;
  width: 100%;
}

.qr-contact-image-preview {
  width: 220rpx;
  height: 220rpx;
  flex: none;
  overflow: hidden;
  border: 1rpx solid var(--pe-color-border, #E9ECEF);
  border-radius: 16rpx;
  background: var(--pe-color-page, #F5F6F7);
  box-sizing: border-box;
}

.qr-contact-image-preview image {
  width: 100%;
  height: 100%;
}

.qr-contact-image-placeholder {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--pe-color-text-muted, #ADB5BD);
  font-size: 22rpx;
  font-weight: 800;
}

.profile-field-limit {
  flex: none;
  color: var(--pe-color-text-muted, #ADB5BD);
  font-size: 22rpx;
  font-weight: 700;
  line-height: 1.3;
}

.profile-sheet-input {
  background: var(--pe-color-page, #F5F6F7);
}

.profile-sheet-textarea {
  min-height: 160rpx;
  background: var(--pe-color-page, #F5F6F7);
}

.profile-sheet-error {
  min-height: 72rpx;
}

.profile-visibility-list {
  margin-top: 14rpx;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.profile-visibility-option {
  min-height: 72rpx;
  justify-content: space-between;
  gap: 18rpx;
  padding: 0 4rpx;
}

.profile-visibility-label {
  color: var(--pe-color-text-strong, #495057);
  font-size: 24rpx;
  font-weight: 800;
  line-height: 1.3;
}

.schedule-query-form {
  padding: 4rpx 0 8rpx;
}

.text-section-form {
  padding: 4rpx 0 8rpx;
}

.divider-form {
  padding: 4rpx 0 8rpx;
}

.text-section-sheet-textarea {
  height: 220rpx;
  min-height: 220rpx;
}

.divider-color-list {
  margin-top: 16rpx;
  display: flex;
  align-items: stretch;
  gap: 12rpx;
}

.divider-color-option {
  flex: 1 1 0;
  min-width: 0;
  min-height: 88rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  padding: 12rpx 8rpx;
  border: 1rpx solid var(--pe-color-border, #E9ECEF);
  border-radius: 14rpx;
  background: var(--pe-color-page, #F5F6F7);
  box-sizing: border-box;
}

.divider-color-swatch {
  width: 42rpx;
  height: 24rpx;
  border: 1rpx solid var(--pe-color-border-strong, #DEE2E6);
  border-radius: 6rpx;
  box-sizing: border-box;
}

.divider-color-label {
  color: var(--pe-color-text-primary, #212529);
  font-size: 24rpx;
  font-weight: 800;
  line-height: 1.25;
}

.divider-height-input {
  margin-top: 12rpx;
}

.schedule-query-mode-list {
  margin-top: 16rpx;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.schedule-query-mode-option {
  width: 100%;
  min-height: 88rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 0 20rpx;
  border: 1rpx solid var(--pe-color-border, #E9ECEF);
  border-radius: 14rpx;
  background: var(--pe-color-page, #F5F6F7);
  box-sizing: border-box;
}

.schedule-query-mode-radio {
  width: 28rpx;
  height: 28rpx;
  flex: none;
  border: 3rpx solid var(--pe-color-border-strong, #DEE2E6);
  border-radius: 50%;
  background: var(--pe-color-surface, #FFFFFF);
  box-sizing: border-box;
}

.schedule-query-mode-option[aria-checked="true"] .schedule-query-mode-radio {
  border-color: var(--pe-color-text-primary, #212529);
  background: var(--pe-color-text-primary, #212529);
  box-shadow: inset 0 0 0 7rpx var(--pe-color-surface, #FFFFFF);
}

.schedule-query-mode-label {
  flex: 1 1 0;
  min-width: 0;
  color: var(--pe-color-text-primary, #212529);
  font-size: 28rpx;
  font-weight: 800;
  line-height: 1.3;
}

.preview-action-stack {
  flex: 1 1 0;
  min-width: 0;
}

.preview-action-stack .action-button {
  width: 100%;
}

.preview-draft-button {
  flex-direction: column;
  gap: 6rpx;
}

.preview-action-title {
  color: var(--pe-color-text-primary, #212529);
  font-size: 28rpx;
  font-weight: 900;
  line-height: 1;
}

.preview-action-note {
  color: var(--pe-color-text-secondary, #868E96);
  font-size: 20rpx;
  font-weight: 700;
  line-height: 1;
  text-align: center;
}

.link-button::after,
.action-button::after,
.component-remove-button::after,
.component-picker-cancel::after,
.component-work-cancel::after,
.component-work-confirm::after,
.profile-refresh-button::after,
.profile-avatar-button::after,
.qr-source-tab::after {
  border: 0;
}
