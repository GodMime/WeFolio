.portfolios-page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  background: #f5f6f7;
}

.portfolio-scroll {
  flex: 1;
  min-height: 0;
}

.portfolio-content {
  height: 100%;
  padding: 24rpx 32rpx calc(140rpx + env(safe-area-inset-bottom));
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
}

.portfolio-segment-shell {
  flex: none;
  padding: 20rpx 32rpx 0;
}

.portfolio-segment-shell.switching {
  pointer-events: none;
}

.portfolio-switch-viewport {
  flex: 1;
  min-height: 0;
  overflow: hidden;
}

.portfolio-switch-track {
  width: 200%;
  height: 100%;
  display: flex;
  transform: translate3d(0, 0, 0);
  transition: transform 220ms cubic-bezier(0.22, 1, 0.36, 1);
}

.portfolio-switch-track.team-active {
  transform: translate3d(-50%, 0, 0);
}

.portfolio-switch-panel {
  width: 50%;
  height: 100%;
  flex: none;
  min-width: 0;
}

.portfolio-switch-panel .portfolio-list-panel {
  margin-top: 0;
}

.portfolio-list-panel,
.portfolio-item-card,
.inline-state,
.empty-state {
  background: #ffffff;
  border: 1rpx solid #e9ecef;
}

.segment {
  position: relative;
  display: flex;
  min-height: 72rpx;
  gap: 0;
  padding: 0;
  border: 0;
  border-bottom: 1rpx solid #e9ecef;
  box-sizing: border-box;
}

.segment-indicator {
  position: absolute;
  left: 25%;
  bottom: -1rpx;
  z-index: 2;
  width: 48rpx;
  height: 5rpx;
  margin-left: -24rpx;
  border-radius: 999rpx;
  background: #212529;
  pointer-events: none;
  transition: left 220ms cubic-bezier(0.22, 1, 0.36, 1);
}

.segment-indicator.team-active {
  left: 75%;
}

.segment-item {
  position: relative;
  z-index: 1;
  flex: 1;
  min-width: 0;
  height: 72rpx;
  margin: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #868e96;
  font-size: 26rpx;
  font-weight: 500;
  line-height: 1;
  border-radius: 0;
  background: transparent;
}

.portfolio-filter-trigger::after,
.segment-item::after,
.create-action::after,
.portfolio-delete-button::after,
.portfolio-action-button::after,
.small-button::after,
.tab::after {
  border: 0;
}

.segment-item.active {
  color: #212529;
  font-weight: 600;
  background: transparent;
}

.portfolio-list-panel {
  flex: 1;
  min-height: 0;
  margin-top: 20rpx;
  padding: 0;
  display: flex;
  flex-direction: column;
  border: 0;
  border-radius: 0;
  background: transparent;
  box-sizing: border-box;
}

.portfolio-list-scroll {
  height: 0;
  flex: 1;
  min-height: 0;
}

.list-heading,
.summary-pills,
.portfolio-item-card,
.portfolio-side,
.portfolio-action-row,
.portfolio-badges,
.portfolio-delete-pane,
.tabbar,
.tab {
  display: flex;
  align-items: center;
}

.list-heading {
  flex: none;
  justify-content: space-between;
  height: 96rpx;
  gap: 16rpx;
}

/* 覆盖微信默认按钮的固定宽度和自动外边距，保持与卡片左缘对齐。 */
.list-heading .portfolio-filter-trigger {
  width: auto;
  flex: none;
  min-width: 0;
  min-height: 44px;
  margin: 0;
  padding: 0;
  display: flex;
  align-items: center;
  color: #212529;
  font-size: 28rpx;
  white-space: nowrap;
  font-weight: 600;
  line-height: 1.2;
  border: 0;
  background: transparent;
}

.summary-pills {
  flex: none;
  gap: 12rpx;
}

.summary-pill,
.status-badge {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  white-space: nowrap;
}

.summary-pill::before {
  width: 12rpx;
  height: 12rpx;
  flex: none;
  content: "";
  border-radius: 50%;
  background: currentColor;
}

.status-badge::before {
  width: 12rpx;
  height: 12rpx;
  flex: none;
  content: "";
  border-radius: 50%;
  background: currentColor;
}

.summary-pill {
  height: 48rpx;
  padding: 0;
  font-size: 21rpx;
  font-weight: 500;
}

.summary-pill.published {
  color: #5c9e6e;
}

.summary-pill.draft {
  color: #868e96;
}

.portfolio-list {
  margin-top: 0;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

/* 骨架保持真实卡片的外尺寸，避免加载完成后列表明显跳动。 */
.portfolio-loading-skeleton {
  pointer-events: none;
}

.portfolio-skeleton-list {
  margin-top: 0;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.portfolio-skeleton-row {
  min-height: 192rpx;
  padding: 16rpx 20rpx;
  display: flex;
  align-items: center;
  gap: 20rpx;
  border: 1rpx solid #edf0f2;
  border-radius: 14px;
  box-sizing: border-box;
}

.portfolio-skeleton-row-3 {
  opacity: 0.7;
}

.portfolio-skeleton-row-4 {
  opacity: 0.4;
}

.portfolio-skeleton-bone {
  position: relative;
  overflow: hidden;
  background: #e9edef;
}

.portfolio-skeleton-bone::after {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  content: "";
  background: linear-gradient(105deg, transparent 18%, #fafbfc 50%, transparent 82%);
  transform: translateX(-140%);
  animation: portfolio-skeleton-sweep 2.2s ease-in-out infinite;
}

.portfolio-skeleton-cover {
  width: 200rpx;
  height: 160rpx;
  flex: none;
  border-radius: 14px;
}

.portfolio-skeleton-copy {
  min-width: 0;
  flex: 1 1 0;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 16rpx;
}

.portfolio-skeleton-title {
  width: 90%;
  height: 18rpx;
  border-radius: 10rpx;
}

.portfolio-skeleton-row-2 .portfolio-skeleton-title {
  width: 72%;
}

.portfolio-skeleton-row-3 .portfolio-skeleton-title {
  width: 84%;
}

.portfolio-skeleton-row-4 .portfolio-skeleton-title {
  width: 64%;
}

.portfolio-skeleton-meta {
  width: 72%;
  height: 12rpx;
  border-radius: 8rpx;
}

.portfolio-skeleton-badge {
  width: 68rpx;
  height: 20rpx;
  border-radius: 10rpx;
  background: #f3f5f6;
}

.portfolio-skeleton-actions {
  flex: none;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.portfolio-skeleton-action {
  width: 116rpx;
  height: 64rpx;
  flex: none;
  border-radius: 20rpx;
  background: #f3f5f6;
}

.portfolio-loading-hint {
  margin: 46rpx 0 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 14rpx;
  color: #838b92;
  font-size: 24rpx;
  line-height: 36rpx;
}

.portfolio-loading-spinner {
  width: 24rpx;
  height: 24rpx;
  flex: none;
  border: 3rpx solid #edf0f2;
  border-top-color: #838b92;
  border-right-color: #838b92;
  border-radius: 50%;
  box-sizing: border-box;
  animation: portfolio-loading-spin 1s linear infinite;
}

.summary-refresh-spinner {
  width: 20rpx;
  height: 20rpx;
}

@keyframes portfolio-skeleton-sweep {
  0%,
  10% {
    transform: translateX(-140%);
  }

  70%,
  100% {
    transform: translateX(140%);
  }
}

@keyframes portfolio-loading-spin {
  to {
    transform: rotate(360deg);
  }
}

@media (prefers-reduced-motion: reduce) {
  .portfolio-skeleton-bone::after,
  .portfolio-loading-spinner {
    animation: none;
  }
}

.portfolio-swipe-row {
  position: relative;
  overflow: hidden;
  border-radius: 14px;
}

.portfolio-delete-pane {
  position: absolute;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 1;
  width: 128rpx;
  justify-content: center;
  background: #b55656;
  border-radius: 14px;
  transform: translateX(100%);
  opacity: 0;
  pointer-events: none;
  transition: transform 180ms ease, opacity 120ms ease;
}

.portfolio-delete-button {
  width: 128rpx;
  height: 100%;
  display: flex;
  flex-direction: column;
  gap: 14rpx;
  align-items: center;
  justify-content: center;
  margin: 0;
  padding: 0;
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 600;
  line-height: 1;
  border: 0;
  border-radius: 14px;
  background: #b55656;
  box-shadow: none;
  box-sizing: border-box;
}

.portfolio-swipe-row.revealed .portfolio-delete-pane {
  transform: translateX(0);
  opacity: 1;
  pointer-events: auto;
}

.portfolio-item-card {
  position: relative;
  z-index: 2;
  min-height: 192rpx;
  padding: 16rpx 20rpx;
  display: flex;
  align-items: center;
  gap: 20rpx;
  border: 1rpx solid #e9ecef;
  border-radius: 14px;
  box-sizing: border-box;
  transition: transform 180ms ease;
}

.portfolio-swipe-row.revealed .portfolio-item-card {
  transform: translateX(-140rpx);
}

.portfolio-cover {
  width: 200rpx;
  height: 160rpx;
  flex: none;
  overflow: hidden;
  border-radius: 14px;
  background: #e9ecef;
}

.portfolio-cover-image {
  display: block;
  width: 100%;
  height: 100%;
}

.portfolio-copy {
  min-width: 0;
  flex: 1 1 0;
}

.team-portfolio-affiliation {
  min-width: 0;
  margin-top: 6rpx;
  display: flex;
  align-items: center;
  gap: 8rpx;
  color: #8d969e;
  font-size: 21rpx;
  line-height: 1.3;
  white-space: nowrap;
  pointer-events: none;
}

.portfolio-title {
  min-width: 0;
  flex: 1 1 0;
  overflow: hidden;
  color: #212529;
  font-size: 32rpx;
  font-weight: 700;
  line-height: 1.25;
  white-space: nowrap;
}

.portfolio-title-track {
  display: inline-flex;
  align-items: center;
  white-space: nowrap;
  transform: translateX(0);
}

.portfolio-title-text {
  flex: none;
}

.portfolio-title.scrolling .portfolio-title-track {
  animation: portfolio-title-marquee 8s linear infinite;
}

.portfolio-title.scrolling .portfolio-title-text {
  padding-right: 80rpx;
}

@keyframes portfolio-title-marquee {
  0%,
  14% {
    transform: translateX(0);
  }

  86%,
  100% {
    transform: translateX(-50%);
  }
}

.portfolio-meta {
  margin-top: 10rpx;
  color: #adb5bd;
  font-size: 22rpx;
  line-height: 1.35;
  white-space: nowrap;
}

.portfolio-badges {
  margin-top: 14rpx;
  gap: 12rpx;
  flex-wrap: nowrap;
  min-height: 36rpx;
}

.status-badge {
  padding: 0;
  font-size: 21rpx;
  font-weight: 500;
}

.status-badge.published {
  color: #5c9e6e;
}

.status-badge.draft {
  color: #868e96;
}

.status-badge.muted {
  color: #b55656;
}

.portfolio-side {
  flex: none;
  min-width: 0;
}

.portfolio-action-row {
  flex: none;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
}

.portfolio-action-button {
  width: 116rpx;
  min-width: 116rpx;
  max-width: 116rpx;
  height: 64rpx;
  flex: none;
  margin: 0;
  padding: 0 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #212529;
  font-size: 23rpx;
  font-weight: 600;
  line-height: 1;
  border: 1rpx solid #e9ecef;
  border-radius: 20rpx;
  background: #f5f6f7;
  box-sizing: border-box;
}

/* 卡片操作按钮的线框跟随所属作品集类型。 */
.portfolio-item-card.advanced .portfolio-action-button {
  border-color: #d9c28d;
}

.portfolio-action-button.publish {
  color: #ffffff;
  background: #212529;
}

.portfolio-action-button.share {
  color: #212529;
  background: #f5f6f7;
}

.portfolio-action-button:active {
  background: #e9eff5;
}

.portfolio-action-button.publish:active {
  background: #343a40;
}

.portfolio-action-button.share:active {
  background: #e9eff5;
}

.portfolio-arrow {
  width: 10rpx;
  height: 10rpx;
  flex: none;
  border-top: 2rpx solid #b5bcc1;
  border-right: 2rpx solid #b5bcc1;
  transform: rotate(45deg);
}

.portfolio-item-card.advanced {
  border-color: #d9c28d;
  background: #faf6ed;
}

.portfolio-type-badge {
  min-width: 74rpx;
  height: 36rpx;
  flex: none;
  padding: 0 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #f1d39a;
  font-size: 18rpx;
  font-weight: 600;
  line-height: 1;
  white-space: nowrap;
  border: 1rpx solid #b79a5d;
  border-radius: 8rpx;
  background: #252b2c;
  box-sizing: border-box;
  pointer-events: none;
}

.portfolio-delete-icon {
  position: relative;
  width: 26rpx;
  height: 28rpx;
  margin-top: 8rpx;
  border: 2rpx solid #ffffff;
  border-top: 0;
  border-radius: 0 0 4rpx 4rpx;
  box-sizing: border-box;
  pointer-events: none;
}

.portfolio-delete-icon::before {
  position: absolute;
  top: -6rpx;
  left: -5rpx;
  width: 32rpx;
  height: 2rpx;
  content: "";
  background: #ffffff;
}

.portfolio-delete-icon::after {
  position: absolute;
  top: -12rpx;
  left: 5rpx;
  width: 12rpx;
  height: 6rpx;
  content: "";
  border: 2rpx solid #ffffff;
  border-bottom: 0;
  border-radius: 4rpx 4rpx 0 0;
  box-sizing: border-box;
}

.portfolio-title-row {
  min-width: 0;
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding-right: 4rpx;
}

.team-portfolio-name {
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.team-portfolio-separator,
.team-portfolio-role {
  flex: none;
}

.team-portfolio-card .portfolio-meta {
  margin-top: 6rpx;
}

.team-portfolio-card .portfolio-badges {
  margin-top: 8rpx;
}

.portfolio-action-button.preview {
  color: #79848d;
  background: transparent;
}

.inline-state,
.empty-state {
  margin-top: 22rpx;
  padding: 36rpx 28rpx;
  color: #697786;
  border-radius: 14rpx;
  box-sizing: border-box;
}

.inline-state.error {
  color: #b55656;
}

.empty-title {
  color: #212529;
  font-size: 30rpx;
  font-weight: 900;
}

.empty-desc {
  margin-top: 10rpx;
  color: #697786;
  font-size: 24rpx;
  line-height: 1.5;
}

.small-button {
  width: 140rpx;
  height: 60rpx;
  margin: 20rpx 0 0;
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 800;
  line-height: 1;
  border-radius: 999rpx;
  background: #212529;
}

.empty-state .small-button {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 260rpx;
  margin: 20rpx 0 0;
  padding: 0;
}

.create-actions {
  width: 100%;
  max-width: 100%;
  min-width: 0;
  flex: none;
  display: flex;
  align-items: stretch;
  gap: 16rpx;
  margin: 20rpx 0 0;
  padding-bottom: 28rpx;
  box-sizing: border-box;
}

.create-action {
  flex: 1 1 0;
  width: auto;
  min-width: 0;
  height: 92rpx;
  margin: 0;
  padding: 0 18rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #ffffff;
  font-size: 26rpx;
  font-weight: 600;
  line-height: 1.2;
  border-radius: 999rpx;
  background: #212529;
}

.create-action.advanced {
  color: #212529;
  background: #e9ecef;
}

.tabbar {
  position: fixed;
  left: 32rpx;
  right: 32rpx;
  bottom: calc(16rpx + env(safe-area-inset-bottom));
  z-index: 10;
  height: 112rpx;
  padding: 8rpx 12rpx;
  justify-content: space-around;
  box-sizing: border-box;
  border: 0;
  border-radius: 999rpx;
  background: #212529;
  box-shadow: 0 18rpx 44rpx rgba(33, 37, 41, 0.18);
}

.tab {
  position: relative;
  width: 25%;
  height: 96rpx;
  flex-direction: column;
  justify-content: center;
  color: rgba(255, 255, 255, 0.72);
  background: transparent;
}

.tab.active {
  color: #212529;
}

.tab.active::before,
.schedule-tab-icon::before,
.schedule-tab-icon::after,
.work-tab-icon::before,
.work-tab-icon::after,
.portfolio-tab-icon::before,
.portfolio-tab-icon::after,
.mine-tab-icon::before,
.mine-tab-icon::after {
  position: absolute;
  content: "";
  box-sizing: border-box;
}

.tab.active::before {
  top: 8rpx;
  left: 50%;
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: #ffffff;
  box-shadow: none;
  transform: translateX(-50%);
}

.tab-icon {
  position: relative;
  z-index: 1;
  width: 42rpx;
  height: 42rpx;
  margin-bottom: 7rpx;
}

.schedule-tab-icon::before {
  left: 6rpx;
  top: 6rpx;
  width: 30rpx;
  height: 30rpx;
  border: 4rpx solid currentColor;
  border-radius: 10rpx;
}

.schedule-tab-icon::after {
  left: 12rpx;
  top: 18rpx;
  width: 18rpx;
  height: 4rpx;
  border-radius: 999rpx;
  background: currentColor;
}

.work-tab-icon::before {
  left: 6rpx;
  top: 6rpx;
  width: 30rpx;
  height: 30rpx;
  border: 4rpx solid currentColor;
  border-radius: 10rpx;
}

.work-tab-icon::after {
  left: 13rpx;
  bottom: 11rpx;
  width: 18rpx;
  height: 14rpx;
  border-left: 4rpx solid currentColor;
  border-bottom: 4rpx solid currentColor;
  transform: rotate(-45deg);
  transform-origin: center;
}

.portfolio-tab-icon::before {
  left: 10rpx;
  top: 8rpx;
  width: 28rpx;
  height: 28rpx;
  border: 4rpx solid currentColor;
  border-radius: 8rpx;
  background: rgba(255, 255, 255, 0.96);
  z-index: 2;
}

.portfolio-tab-icon::after {
  left: 4rpx;
  top: 14rpx;
  width: 28rpx;
  height: 28rpx;
  border: 4rpx solid currentColor;
  border-radius: 8rpx;
  z-index: 1;
}

.mine-tab-icon::before {
  left: 13rpx;
  top: 6rpx;
  width: 16rpx;
  height: 16rpx;
  border: 4rpx solid currentColor;
  border-radius: 50%;
}

.mine-tab-icon::after {
  left: 6rpx;
  bottom: 6rpx;
  width: 30rpx;
  height: 18rpx;
  border: 4rpx solid currentColor;
  border-top-left-radius: 18rpx;
  border-top-right-radius: 18rpx;
  border-bottom-width: 3rpx;
}

.tab-label {
  position: relative;
  z-index: 1;
  font-size: 22rpx;
  font-weight: 800;
  line-height: 1;
}

.inline-hint {
  margin-top: 18rpx;
  color: #697786;
  font-size: 24rpx;
  line-height: 1.5;
  text-align: center;
}

.team-action-hint-slot {
  flex: none;
  display: flex;
  align-items: flex-end;
}

.team-action-hint-slot .inline-hint {
  width: 100%;
}

/* 筛选浮层使用视口坐标，避免被列表滚动及横向切换容器裁切。 */
.portfolio-filter-layer {
  position: fixed;
  width: 100%;
  height: 100%;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 120;
  background: transparent;
}

.portfolio-filter-menu {
  position: absolute;
  padding: 4px;
  box-sizing: border-box;
  border: 1px solid #e9ecef;
  border-radius: 12px;
  background: #ffffff;
  box-shadow: 0 5px 18px rgba(38, 50, 61, 0.11);
  transform-origin: top left;
  animation: portfolio-filter-menu-enter 160ms ease-out;
}

.portfolio-filter-option {
  height: 48px;
  padding: 0 12px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-radius: 8px;
  color: #495057;
  font-size: 13px;
}

.portfolio-filter-option.selected {
  background: #f1f3f5;
  color: #212529;
  font-weight: 600;
}

.portfolio-filter-check {
  margin-left: 12px;
}

.portfolio-filter-chevron {
  width: 10rpx;
  height: 10rpx;
  margin: 0 2rpx 5rpx 14rpx;
  border-right: 2rpx solid #868e96;
  border-bottom: 2rpx solid #868e96;
  transform: rotate(45deg);
  transition: transform 160ms ease;
}

/* 筛选加载与结果都在列表区域内过渡，工具栏和底部操作保持稳定。 */
.portfolio-results-enter {
  animation: portfolio-results-enter 200ms ease-out;
}

.portfolio-filter-chevron.open {
  transform: rotate(225deg);
}

@keyframes portfolio-results-enter {
  from { opacity: 0; transform: translateY(10rpx); }
  to { opacity: 1; transform: translateY(0); }
}

@keyframes portfolio-filter-menu-enter {
  from { opacity: 0; transform: translateY(-4px) scale(0.98); }
  to { opacity: 1; transform: translateY(0) scale(1); }
}

@media (prefers-reduced-motion: reduce) {
  .portfolio-results-enter,
  .portfolio-filter-menu {
    animation: none;
  }
  .portfolio-filter-chevron {
    transition: none;
  }
}
