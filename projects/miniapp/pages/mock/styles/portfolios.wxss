.portfolios-page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  background: #f5f6f7;
}

.portfolio-content {
  height: 100%;
  padding: 24rpx 32rpx calc(140rpx + env(safe-area-inset-bottom));
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
}

.portfolio-segment-shell {
  flex: none;
  padding: 20rpx 32rpx 0;
}

.portfolio-segment-shell.switching {
  pointer-events: none;
}

.portfolio-switch-viewport {
  flex: 1;
  min-height: 0;
  overflow: hidden;
}

.portfolio-switch-track {
  width: 200%;
  height: 100%;
  display: flex;
  transform: translate3d(0, 0, 0);
  transition: transform 220ms cubic-bezier(0.22, 1, 0.36, 1);
}

.portfolio-switch-track.team-active {
  transform: translate3d(-50%, 0, 0);
}

.portfolio-switch-panel {
  width: 50%;
  height: 100%;
  flex: none;
  min-width: 0;
}

.portfolio-switch-panel .portfolio-list-panel {
  margin-top: 0;
}

.portfolio-list-panel,
.portfolio-item-card,
.inline-state,
.empty-state {
  background: #ffffff;
  border: 1rpx solid #e9ecef;
}

.segment {
  position: relative;
  display: flex;
  min-height: 72rpx;
  gap: 0;
  padding: 0;
  border: 0;
  border-bottom: 1rpx solid #e9ecef;
  box-sizing: border-box;
}

.segment-indicator {
  position: absolute;
  left: 25%;
  bottom: -1rpx;
  z-index: 2;
  width: 48rpx;
  height: 5rpx;
  margin-left: -24rpx;
  border-radius: 999rpx;
  background: #212529;
  pointer-events: none;
  transition: left 220ms cubic-bezier(0.22, 1, 0.36, 1);
}

.segment-indicator.team-active {
  left: 75%;
}

.segment-item {
  position: relative;
  z-index: 1;
  flex: 1;
  min-width: 0;
  height: 72rpx;
  margin: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #868e96;
  font-size: 26rpx;
  font-weight: 500;
  line-height: 1;
  border-radius: 0;
  background: transparent;
}

.segment-item::after,
.create-action::after,
.portfolio-delete-button::after,
.portfolio-action-button::after,
.small-button::after,
.tab::after {
  border: 0;
}

.segment-item.active {
  color: #212529;
  font-weight: 600;
  background: transparent;
}

.portfolio-list-panel {
  flex: 1;
  min-height: 0;
  margin-top: 20rpx;
  padding: 28rpx;
  display: flex;
  flex-direction: column;
  border-radius: 48rpx;
  box-sizing: border-box;
}

.portfolio-list-scroll {
  height: 0;
  flex: 1;
  min-height: 0;
}

.list-heading,
.summary-pills,
.portfolio-item-card,
.portfolio-side,
.portfolio-action-row,
.portfolio-badges,
.portfolio-delete-pane,
.tabbar,
.tab {
  display: flex;
  align-items: center;
}

.list-heading {
  flex: none;
  justify-content: space-between;
  gap: 18rpx;
}

.list-title {
  min-width: 0;
  flex: 1 1 auto;
  color: #212529;
  font-size: 36rpx;
  font-weight: 700;
  line-height: 1.2;
}

.summary-pills {
  flex: none;
  gap: 12rpx;
}

.summary-pill,
.status-badge {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  white-space: nowrap;
}

.summary-pill::before {
  width: 12rpx;
  height: 12rpx;
  flex: none;
  content: "";
  border-radius: 50%;
  background: currentColor;
}

.status-badge::before {
  width: 12rpx;
  height: 12rpx;
  flex: none;
  content: "";
  border-radius: 50%;
  background: currentColor;
}

.summary-pill {
  height: 48rpx;
  padding: 0 8rpx;
  font-size: 22rpx;
  font-weight: 500;
}

.summary-pill.published {
  color: #5c9e6e;
}

.summary-pill.draft {
  color: #868e96;
}

.portfolio-list {
  margin-top: 20rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.portfolio-swipe-row {
  position: relative;
  overflow: hidden;
  border-radius: 48rpx;
}

.portfolio-delete-pane {
  position: absolute;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 1;
  width: 128rpx;
  justify-content: center;
  background: #b55656;
  transform: translateX(100%);
  opacity: 0;
  pointer-events: none;
  transition: transform 180ms ease, opacity 120ms ease;
}

.portfolio-delete-button {
  width: 128rpx;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0;
  padding: 0;
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 600;
  line-height: 1;
  border: 0;
  border-radius: 0;
  background: #b55656;
  box-shadow: none;
  box-sizing: border-box;
}

.portfolio-swipe-row.revealed .portfolio-delete-pane {
  transform: translateX(0);
  opacity: 1;
  pointer-events: auto;
}

.portfolio-item-card {
  position: relative;
  z-index: 2;
  min-height: 184rpx;
  padding: 24rpx;
  display: flex;
  align-items: center;
  gap: 20rpx;
  border: 1rpx solid #e9ecef;
  border-radius: 48rpx;
  box-sizing: border-box;
  transition: transform 180ms ease;
}

.portfolio-swipe-row.revealed .portfolio-item-card {
  transform: translateX(-140rpx);
}

.portfolio-cover {
  width: 128rpx;
  height: 112rpx;
  flex: none;
  overflow: hidden;
  border-radius: 40rpx;
  background: #e9ecef;
}

.portfolio-cover-image {
  display: block;
  width: 100%;
  height: 100%;
}

.portfolio-copy {
  min-width: 0;
  flex: 1 1 0;
}

.team-portfolio-affiliation {
  position: absolute;
  top: 26rpx;
  right: 24rpx;
  z-index: 1;
  width: 256rpx;
  overflow: hidden;
  color: #adb5bd;
  font-size: 22rpx;
  line-height: 1.35;
  text-align: right;
  text-overflow: ellipsis;
  white-space: nowrap;
  pointer-events: none;
}

.portfolio-title {
  overflow: hidden;
  color: #212529;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 1.25;
  white-space: nowrap;
}

.portfolio-title-track {
  display: inline-flex;
  align-items: center;
  white-space: nowrap;
  transform: translateX(0);
}

.portfolio-title-text {
  flex: none;
}

.portfolio-title.scrolling .portfolio-title-track {
  animation: portfolio-title-marquee 8s linear infinite;
}

.portfolio-title.scrolling .portfolio-title-text {
  padding-right: 80rpx;
}

@keyframes portfolio-title-marquee {
  0%,
  14% {
    transform: translateX(0);
  }

  86%,
  100% {
    transform: translateX(-50%);
  }
}

.portfolio-meta {
  margin-top: 8rpx;
  color: #adb5bd;
  font-size: 22rpx;
  line-height: 1.35;
}

.portfolio-badges {
  margin-top: 12rpx;
  gap: 12rpx;
  flex-wrap: wrap;
}

.status-badge {
  padding: 0;
  font-size: 21rpx;
  font-weight: 500;
}

.status-badge.published {
  color: #5c9e6e;
}

.status-badge.draft {
  color: #868e96;
}

.status-badge.muted {
  color: #b55656;
}

.portfolio-side {
  flex: 0 0 auto;
  min-width: 0;
  gap: 12rpx;
}

.team-portfolio-card .portfolio-side {
  flex: 0 0 256rpx;
  justify-content: flex-end;
}

.portfolio-action-row {
  flex: 0 0 auto;
  max-width: 226rpx;
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.portfolio-action-button {
  width: 108rpx;
  min-width: 108rpx;
  max-width: 108rpx;
  height: 60rpx;
  flex: none;
  margin: 0;
  padding: 0 26rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #212529;
  font-size: 24rpx;
  font-weight: 600;
  line-height: 1;
  border: 0;
  border-radius: 999rpx;
  background: #f5f6f7;
  box-sizing: border-box;
}

.portfolio-action-button.publish {
  color: #ffffff;
  border-color: #212529;
  background: #212529;
}

.portfolio-action-button.share {
  color: #212529;
  background: #f5f6f7;
}

.portfolio-action-button:active {
  background: #e9eff5;
}

.portfolio-action-button.publish:active {
  background: #343a40;
}

.portfolio-action-button.share:active {
  background: #e9eff5;
}

.portfolio-arrow {
  width: 14rpx;
  height: 14rpx;
  flex: none;
  border-top: 4rpx solid #9aa6b2;
  border-right: 4rpx solid #9aa6b2;
  transform: rotate(45deg);
}

.inline-state,
.empty-state {
  margin-top: 22rpx;
  padding: 36rpx 28rpx;
  color: #697786;
  border-radius: 14rpx;
  box-sizing: border-box;
}

.inline-state.error {
  color: #b55656;
}

.empty-title {
  color: #212529;
  font-size: 30rpx;
  font-weight: 900;
}

.empty-desc {
  margin-top: 10rpx;
  color: #697786;
  font-size: 24rpx;
  line-height: 1.5;
}

.small-button {
  width: 140rpx;
  height: 60rpx;
  margin: 20rpx 0 0;
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 800;
  line-height: 1;
  border-radius: 999rpx;
  background: #212529;
}

.create-actions {
  width: 100%;
  max-width: 100%;
  min-width: 0;
  flex: none;
  display: flex;
  align-items: stretch;
  gap: 16rpx;
  margin: 20rpx 0 0;
  padding-bottom: 28rpx;
  box-sizing: border-box;
}

.create-action {
  flex: 1 1 0;
  width: auto;
  min-width: 0;
  height: 92rpx;
  margin: 0;
  padding: 0 18rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #ffffff;
  font-size: 26rpx;
  font-weight: 600;
  line-height: 1.2;
  border-radius: 999rpx;
  background: #212529;
}

.create-action.advanced {
  color: #212529;
  background: #e9ecef;
}

.tabbar {
  position: fixed;
  left: 32rpx;
  right: 32rpx;
  bottom: calc(16rpx + env(safe-area-inset-bottom));
  z-index: 10;
  height: 112rpx;
  padding: 8rpx 12rpx;
  justify-content: space-around;
  box-sizing: border-box;
  border: 0;
  border-radius: 999rpx;
  background: #212529;
  box-shadow: 0 18rpx 44rpx rgba(33, 37, 41, 0.18);
}

.tab {
  position: relative;
  width: 25%;
  height: 96rpx;
  flex-direction: column;
  justify-content: center;
  color: rgba(255, 255, 255, 0.72);
  background: transparent;
}

.tab.active {
  color: #212529;
}

.tab.active::before,
.schedule-tab-icon::before,
.schedule-tab-icon::after,
.work-tab-icon::before,
.work-tab-icon::after,
.portfolio-tab-icon::before,
.portfolio-tab-icon::after,
.mine-tab-icon::before,
.mine-tab-icon::after {
  position: absolute;
  content: "";
  box-sizing: border-box;
}

.tab.active::before {
  top: 8rpx;
  left: 50%;
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: #ffffff;
  box-shadow: none;
  transform: translateX(-50%);
}

.tab-icon {
  position: relative;
  z-index: 1;
  width: 42rpx;
  height: 42rpx;
  margin-bottom: 7rpx;
}

.schedule-tab-icon::before {
  left: 6rpx;
  top: 6rpx;
  width: 30rpx;
  height: 30rpx;
  border: 4rpx solid currentColor;
  border-radius: 10rpx;
}

.schedule-tab-icon::after {
  left: 12rpx;
  top: 18rpx;
  width: 18rpx;
  height: 4rpx;
  border-radius: 999rpx;
  background: currentColor;
}

.work-tab-icon::before {
  left: 6rpx;
  top: 6rpx;
  width: 30rpx;
  height: 30rpx;
  border: 4rpx solid currentColor;
  border-radius: 10rpx;
}

.work-tab-icon::after {
  left: 13rpx;
  bottom: 11rpx;
  width: 18rpx;
  height: 14rpx;
  border-left: 4rpx solid currentColor;
  border-bottom: 4rpx solid currentColor;
  transform: rotate(-45deg);
  transform-origin: center;
}

.portfolio-tab-icon::before {
  left: 10rpx;
  top: 8rpx;
  width: 28rpx;
  height: 28rpx;
  border: 4rpx solid currentColor;
  border-radius: 8rpx;
  background: rgba(255, 255, 255, 0.96);
  z-index: 2;
}

.portfolio-tab-icon::after {
  left: 4rpx;
  top: 14rpx;
  width: 28rpx;
  height: 28rpx;
  border: 4rpx solid currentColor;
  border-radius: 8rpx;
  z-index: 1;
}

.mine-tab-icon::before {
  left: 13rpx;
  top: 6rpx;
  width: 16rpx;
  height: 16rpx;
  border: 4rpx solid currentColor;
  border-radius: 50%;
}

.mine-tab-icon::after {
  left: 6rpx;
  bottom: 6rpx;
  width: 30rpx;
  height: 18rpx;
  border: 4rpx solid currentColor;
  border-top-left-radius: 18rpx;
  border-top-right-radius: 18rpx;
  border-bottom-width: 3rpx;
}

.tab-label {
  position: relative;
  z-index: 1;
  font-size: 22rpx;
  font-weight: 800;
  line-height: 1;
}

.inline-hint {
  margin-top: 18rpx;
  color: #697786;
  font-size: 24rpx;
  line-height: 1.5;
  text-align: center;
}

.team-action-hint-slot {
  flex: none;
  display: flex;
  align-items: flex-end;
}

.team-action-hint-slot .inline-hint {
  width: 100%;
}
