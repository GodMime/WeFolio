<view class="page-shell portfolio-preview-page mock-preview-page">
  <navigation-bar title="{{portfolio.title || '预览'}}" color="#212529" background="#ffffff"></navigation-bar>

  <scroll-view scroll-y class="preview-scroll">
    <view class="preview-toolbar">
      <view class="preview-note">体验预览：不请求后端，不统计访问，不提交真实表单。</view>
    </view>

    <view wx:for="{{portfolio.components}}" wx:key="componentKey" class="folio-component">
      <block wx:if="{{item.componentType === 'CAROUSEL'}}">
        <portfolio-carousel works="{{item.works}}" interval="{{item.carouselIntervalMs}}"></portfolio-carousel>
      </block>

      <mock-portfolio-renderer
        wx:else
        component="{{item}}"
        active-single-work-video-key="{{activeSingleWorkVideoKey}}"
        binddisplaytagtap="handleDisplayTagTap"
        bindworktap="handleWorkTap"
        bindsingleworktap="handleSingleWorkTap"
        bindsingleworkvideoerror="handleSingleWorkVideoError"
        bindpreviewqr="handlePreviewQr"
        bindlockedaction="handleSubmitContact"
      ></mock-portfolio-renderer>
    </view>

    <view class="folio-brand-footer">
      <image class="folio-brand-logo" src="/assets/system/folio-logo-stack-bold-small-50kb.png" mode="aspectFit"></image>
      <view class="folio-brand-name">映期Folio</view>
    </view>
  </scroll-view>

  <root-portal wx:if="{{videoPreviewVisible}}">
    <view class="work-video-mask {{videoPreviewVisible ? 'visible' : ''}}" catchtap="handleCloseVideoPreview">
      <view class="work-video-panel" catchtap="noop">
        <view class="work-video-heading">
          <view class="work-video-title">{{videoPreview.title}}</view>
          <view class="work-video-close" catchtap="handleCloseVideoPreview">×</view>
        </view>
        <video
          id="mockPortfolioWorkVideo"
          class="work-video-player"
          src="{{videoPreview.src}}"
          poster="{{videoPreview.poster}}"
          controls="{{true}}"
          autoplay="{{true}}"
          object-fit="contain"
        ></video>
      </view>
    </view>
  </root-portal>
</view>
