@import "../styles/portfolio-standard-preview.wxss";
@import "../common.wxss";
@import "../../../styles/portfolio-theme.wxss";
@import "../../../styles/portfolio-menu-transition.wxss";

.mock-section-desc {
  margin-top: 8rpx;
}

.mock-preview-page,
.preview-scroll {
  color: var(--portfolio-text-primary);
  background: transparent;
}

.portfolio-theme-dark .preview-toolbar {
  border-bottom-color: var(--portfolio-border);
}

.portfolio-theme-dark .preview-note,
.portfolio-theme-dark .folio-brand-name {
  color: var(--portfolio-text-muted);
}

.mock-modal-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 90;
  display: flex;
  align-items: flex-end;
  padding: 32rpx 24rpx calc(32rpx + env(safe-area-inset-bottom));
  background: rgba(10, 14, 20, 0.72);
  box-sizing: border-box;
}

.mock-modal-panel {
  width: 100%;
  max-height: 78vh;
  padding: 24rpx;
  overflow-y: auto;
  border-radius: 40rpx;
  background: #ffffff;
  box-sizing: border-box;
}

.mock-modal-heading,
.mock-schedule-row {
  display: flex;
  align-items: center;
}

.mock-modal-heading {
  justify-content: space-between;
  gap: 20rpx;
}

.mock-modal-title {
  color: #212529;
  font-size: 32rpx;
  font-weight: 900;
}

.mock-modal-close {
  width: 56rpx;
  height: 56rpx;
  margin: 0;
  padding: 0;
  color: #495057;
  font-size: 36rpx;
  line-height: 56rpx;
  border-radius: 50%;
  background: #f1f3f5;
}

.mock-modal-close::after {
  border: 0;
}

.mock-modal-desc,
.mock-schedule-time {
  color: #868e96;
  font-size: 24rpx;
  line-height: 1.6;
}

.mock-modal-desc {
  margin-top: 14rpx;
}

.mock-schedule-list {
  margin-top: 24rpx;
}

.mock-schedule-row {
  gap: 18rpx;
  padding: 20rpx 0;
  border-top: 1rpx solid #eef1f4;
}

.mock-schedule-color {
  width: 20rpx;
  height: 20rpx;
  flex: none;
  border-radius: 50%;
}

.mock-schedule-copy {
  min-width: 0;
  flex: 1;
}

.mock-schedule-date {
  color: #212529;
  font-size: 26rpx;
  font-weight: 800;
}

.mock-contact-input,
.mock-contact-textarea {
  width: 100%;
  margin-top: 18rpx;
  padding: 0 24rpx;
  border: 1rpx solid #dee2e6;
  border-radius: 24rpx;
  background: #ffffff;
  box-sizing: border-box;
}

.mock-contact-input {
  height: 76rpx;
}

.mock-contact-textarea {
  height: 164rpx;
  padding-top: 20rpx;
}

.mock-modal-primary {
  width: 100%;
  height: 76rpx;
  margin-top: 24rpx;
  color: #ffffff;
  font-size: 26rpx;
  font-weight: 800;
  line-height: 76rpx;
  border-radius: 999rpx;
  background: #212529;
}
