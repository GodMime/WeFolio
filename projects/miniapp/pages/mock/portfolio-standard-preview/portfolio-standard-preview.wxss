@import "../styles/portfolio-standard-preview.wxss";
@import "../common.wxss";

.mock-component-label {
  margin-bottom: 16rpx;
}

.profile-section .mock-component-label {
  margin-bottom: 24rpx;
}

.mock-section-desc {
  margin-top: 8rpx;
}

.mock-contact-section {
  text-align: left;
}

.mock-contact-section .component-title,
.mock-contact-section .section-desc {
  padding-left: 0;
  padding-right: 0;
  text-align: center;
}

.contact-input,
.contact-textarea {
  width: 100%;
  margin-top: 16rpx;
  border: 1rpx solid #d9e2eb;
  border-radius: 12rpx;
  background: #ffffff;
  color: #17202a;
  font-size: 26rpx;
  box-sizing: border-box;
  text-align: left;
}

.contact-input {
  height: 72rpx;
  padding: 0 18rpx;
}

.contact-textarea {
  height: 150rpx;
  padding: 16rpx 18rpx;
  line-height: 1.55;
}
