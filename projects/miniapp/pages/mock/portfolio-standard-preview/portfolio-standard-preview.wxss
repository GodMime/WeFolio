@import "../styles/portfolio-opening.wxss";
@import "../styles/portfolio-standard-preview.wxss";
@import "../common.wxss";
@import "../../../styles/portfolio-theme.wxss";
@import "../../../styles/portfolio-menu-transition.wxss";

.mock-section-desc {
  margin-top: 8rpx;
}

.mock-preview-page,
.preview-scroll {
  color: var(--portfolio-text-primary);
  background: transparent;
}

.portfolio-theme-dark .preview-toolbar {
  border-bottom-color: var(--portfolio-border);
}

.portfolio-theme-dark .preview-note,
.portfolio-theme-dark .folio-brand-name {
  color: var(--portfolio-text-muted);
}

.mock-copy-prompt { position:fixed; left:48rpx; right:48rpx; bottom:200rpx; padding:24rpx; border-radius:16rpx; background:rgba(0,0,0,.8); color:white; text-align:center; z-index:100; }
