@import "../styles/portfolio-standard-preview.wxss";
@import "../common.wxss";

.mock-component-label {
  margin-bottom: 16rpx;
}

.profile-section .mock-component-label {
  margin-bottom: 24rpx;
}

.profile-tags {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 16rpx;
}

.profile-tag {
  min-height: 48rpx;
  display: inline-flex;
  align-items: center;
  padding: 0 20rpx;
  color: #0f766e;
  font-size: 24rpx;
  line-height: 1.4;
  border: 1rpx solid #0f766e;
  border-radius: 999rpx;
  background: #ffffff;
  box-sizing: border-box;
}

.profile-tag-dot {
  width: 12rpx;
  height: 12rpx;
  flex: none;
  margin-right: 12rpx;
  border-radius: 50%;
}

.mock-section-desc {
  margin-top: 8rpx;
}

.mock-contact-section {
  text-align: left;
}

.mock-contact-section .component-title,
.mock-contact-section .section-desc {
  padding-left: 0;
  padding-right: 0;
  text-align: center;
}

.contact-input,
.contact-textarea {
  width: 100%;
  margin-top: 16rpx;
  border: 1rpx solid #e9ecef;
  border-radius: 40rpx;
  background: #f5f6f7;
  color: #212529;
  font-size: 26rpx;
  box-sizing: border-box;
  text-align: left;
}

.contact-input {
  height: 84rpx;
  padding: 0 18rpx;
}

.contact-textarea {
  height: 150rpx;
  padding: 16rpx 18rpx;
  line-height: 1.55;
}
