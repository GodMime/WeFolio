.mock-page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  background: #f5f6f7;
  color: #212529;
}

.mock-scroll {
  flex: 1;
  min-height: 0;
}

.mock-content {
  padding: 20rpx 32rpx calc(150rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.mock-section {
  margin-top: 20rpx;
  padding: 28rpx;
  border: 1rpx solid #e9ecef;
  border-radius: 48rpx;
  background: #ffffff;
  box-sizing: border-box;
  box-shadow: 0 18rpx 44rpx rgba(33, 37, 41, 0.05);
}

.mock-section:first-child {
  margin-top: 0;
}

.mock-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.mock-title {
  color: #212529;
  font-size: 34rpx;
  font-weight: 900;
  line-height: 1.35;
}

.mock-subtitle,
.mock-meta,
.mock-desc {
  color: #868e96;
  font-size: 24rpx;
  line-height: 1.55;
}

.mock-desc {
  margin-top: 8rpx;
}

.mock-primary-button,
.mock-secondary-button,
.mock-pill-button {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
  border-radius: 999rpx;
  font-size: 25rpx;
  font-weight: 800;
  line-height: 1;
}

.mock-primary-button {
  width: 100%;
  height: 88rpx;
  color: #ffffff;
  background: #212529;
}

.mock-secondary-button {
  min-width: 132rpx;
  height: 58rpx;
  padding: 0 22rpx;
  color: #212529;
  border: 1rpx solid #e9ecef;
  background: #ffffff;
}

.mock-pill-button {
  min-width: 112rpx;
  height: 52rpx;
  padding: 0 18rpx;
  color: #212529;
  border: 1rpx solid #e9ecef;
  background: #ffffff;
}

.mock-primary-button::after,
.mock-secondary-button::after,
.mock-pill-button::after {
  border: 0;
}

.mock-tag-row,
.mock-action-row {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 14rpx;
}

.mock-tag {
  display: inline-flex;
  min-height: 48rpx;
  align-items: center;
  padding: 0 18rpx;
  border-radius: 999rpx;
  color: #5c9e6e;
  background: #eef6f0;
  font-size: 22rpx;
  font-weight: 800;
  line-height: 1;
}

.mock-empty {
  padding: 36rpx 20rpx;
  color: #868e96;
  font-size: 25rpx;
  line-height: 1.6;
  text-align: center;
}

.mock-field {
  margin-top: 20rpx;
}

.mock-field-label {
  color: #6c757d;
  font-size: 24rpx;
  font-weight: 800;
  line-height: 1.35;
}

.mock-input,
.mock-textarea {
  width: 100%;
  margin-top: 10rpx;
  padding: 0 18rpx;
  border: 1rpx solid #e9ecef;
  border-radius: 40rpx;
  background: #f5f6f7;
  color: #212529;
  font-size: 26rpx;
  box-sizing: border-box;
}

.mock-input {
  height: 84rpx;
}

.mock-textarea {
  height: 150rpx;
  padding-top: 16rpx;
  line-height: 1.55;
}
