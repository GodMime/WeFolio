@import "../styles/portfolios.wxss";
@import "../common.wxss";

/* 版本菜单只覆盖当前点击层，不改变原卡片或底栏布局。 */
.preview-version-trigger-arrow {
  display: inline-block;
  width: 5px;
  height: 5px;
  margin-left: 6px;
  margin-bottom: 3px;
  border-right: 1px solid currentColor;
  border-bottom: 1px solid currentColor;
  transform: rotate(45deg);
}

.preview-version-menu-layer {
  position: fixed;
  width: 100%;
  height: 100%;
  z-index: 120;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  background: transparent;
}

/* 菜单与点击区域共用承接层坐标系，避免真机上的嵌套 fixed 命中差异。 */
.preview-version-menu {
  position: absolute;
  width: 238px;
  height: 104px;
  box-sizing: border-box;
  padding: 4px 0;
  border: 1px solid #e1e6ea;
  border-radius: 12px;
  background: var(--pe-color-surface, #FFFFFF);
  box-shadow: 0 5px 18px rgba(38, 50, 61, 0.11), 0 1px 4px rgba(38, 50, 61, 0.04);
}

.preview-version-menu__arrow {
  position: absolute;
  width: 8px;
  height: 8px;
  box-sizing: border-box;
  background: var(--pe-color-surface, #FFFFFF);
  transform: rotate(45deg);
}

.preview-version-menu--below .preview-version-menu__arrow {
  top: -5px;
  border-top: 1px solid #e1e6ea;
  border-left: 1px solid #e1e6ea;
}

.preview-version-menu--above .preview-version-menu__arrow {
  bottom: -5px;
  border-right: 1px solid #e1e6ea;
  border-bottom: 1px solid #e1e6ea;
}

.preview-version-menu__option {
  position: relative;
  height: 47px;
  min-height: 44px;
  box-sizing: border-box;
  margin: 0 4px;
  padding: 0 12px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 14px;
  border-radius: 7px;
}

.preview-version-menu__option + .preview-version-menu__option::before {
  content: '';
  position: absolute;
  top: 0;
  left: 11px;
  right: 11px;
  height: 1px;
  background: #edf0f2;
}

.preview-version-menu__label {
  flex-shrink: 0;
  font-size: 13px;
  font-weight: 600;
  color: var(--pe-color-text-primary, #212529);
  white-space: nowrap;
}

.preview-version-menu__description {
  font-size: 11px;
  color: #87919a;
  white-space: nowrap;
}
