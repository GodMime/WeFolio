.recharge-page { height: 100vh; display: flex; flex-direction: column; overflow: hidden; background: #f5f6f7; }
.recharge-scroll { flex: 1; min-height: 0; }
.recharge-content { padding: 20rpx 32rpx 56rpx; box-sizing: border-box; }
.balance-panel, .payment-panel, .notice-panel { border: 1rpx solid #e9ecef; border-radius: 48rpx; background: #ffffff; box-sizing: border-box; }
.balance-panel { min-height: 164rpx; display: flex; align-items: center; justify-content: space-between; padding: 28rpx; }
.balance-copy { flex: 1; min-width: 0; }
.balance-label { color: #868e96; font-size: 24rpx; }
.balance-value { margin-top: 8rpx; color: #212529; font-size: 48rpx; font-weight: 900; }
.balance-value text { font-size: 25rpx; font-weight: 700; }
.balance-warning { margin-top: 10rpx; color: #c08a3e; font-size: 22rpx; }
.records-link, .selected-pill, .rule-link { flex: none; color: #212529; font-size: 23rpx; font-weight: 800; border-radius: 999rpx; background: #f5f6f7; }
.records-link { min-height: 58rpx; display: flex; align-items: center; padding: 0 22rpx; }
.section-heading { margin: 30rpx 0 18rpx; color: #212529; font-size: 30rpx; font-weight: 900; }
.package-grid { display: flex; flex-wrap: wrap; gap: 16rpx 0; justify-content: space-between; }
.package-card { width: calc(50% - 8rpx); min-height: 190rpx; padding: 26rpx 24rpx; border: 1rpx solid #e9ecef; border-radius: 48rpx; background: #ffffff; box-sizing: border-box; }
.package-card.selected { border-color: #212529; background: #ffffff; box-shadow: none; }
.package-amount { color: #212529; font-size: 38rpx; font-weight: 900; }
.package-points { margin-top: 12rpx; color: #868e96; font-size: 24rpx; }
.package-bonus { margin-top: 18rpx; padding: 8rpx 14rpx; color: #868e96; font-size: 21rpx; font-weight: 800; border-radius: 999rpx; background: #f5f6f7; }
.package-bonus.has-bonus { color: #5c9e6e; background: #f5f6f7; }
.payment-panel { margin-top: 26rpx; padding: 26rpx; }
.panel-heading { display: flex; align-items: center; justify-content: space-between; }
.section-title { color: #212529; font-size: 30rpx; font-weight: 900; }
.selected-pill { padding: 10rpx 18rpx; }
.summary-row { min-height: 84rpx; display: flex; align-items: center; justify-content: space-between; margin-top: 18rpx; padding: 0 20rpx; border: 1rpx solid #e9ecef; border-radius: 32rpx; }
.summary-title { color: #212529; font-size: 27rpx; font-weight: 800; }
.summary-desc { margin-top: 8rpx; color: #868e96; font-size: 22rpx; }
.summary-value { color: #212529; font-size: 32rpx; font-weight: 900; }
.pay-button, .retry-button { display: flex; align-items: center; justify-content: center; color: #ffffff; font-weight: 900; border-radius: 999rpx; background: #212529; }
.pay-button { width: 100%; min-width: 100%; max-width: 100%; height: 96rpx; margin: 26rpx 0 0; box-sizing: border-box; font-size: 28rpx; border-radius: 999rpx; background: #212529; }
.pay-button[disabled] { color: rgba(255, 255, 255, 0.7); background: #868e96; }
.retry-button { width: 220rpx; height: 84rpx; margin: 28rpx auto 0; }
.notice-panel { min-height: 92rpx; display: flex; align-items: center; justify-content: space-between; margin-top: 22rpx; padding: 0 22rpx; color: #868e96; font-size: 22rpx; }
.rule-link { padding: 10rpx 20rpx; color: #212529; background: #f5f6f7; }
.skeleton-panel { min-height: 164rpx; background: #e9eef3; }
.empty-state { padding: 120rpx 32rpx; text-align: center; }
.empty-title { color: #212529; font-size: 32rpx; font-weight: 900; }
.empty-desc { margin-top: 14rpx; color: #868e96; font-size: 24rpx; }
