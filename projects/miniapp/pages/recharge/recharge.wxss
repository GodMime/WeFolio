.recharge-page { height: 100vh; display: flex; flex-direction: column; overflow: hidden; background: #f5f7fb; }
.recharge-scroll { flex: 1; min-height: 0; }
.recharge-content { padding: 28rpx 28rpx 56rpx; box-sizing: border-box; }
.balance-panel, .payment-panel, .notice-panel { border: 1rpx solid rgba(23, 32, 42, 0.08); border-radius: 18rpx; background: rgba(255, 255, 255, 0.96); box-sizing: border-box; }
.balance-panel { min-height: 164rpx; display: flex; align-items: center; justify-content: space-between; padding: 28rpx; }
.balance-copy { flex: 1; min-width: 0; }
.balance-label { color: #758190; font-size: 24rpx; }
.balance-value { margin-top: 8rpx; color: #17202a; font-size: 48rpx; font-weight: 900; }
.balance-value text { font-size: 25rpx; font-weight: 700; }
.balance-warning { margin-top: 10rpx; color: #8a4b09; font-size: 22rpx; }
.records-link, .selected-pill, .rule-link { flex: none; color: #2d5f9a; font-size: 23rpx; font-weight: 800; border-radius: 999rpx; background: #e6efff; }
.records-link { min-height: 58rpx; display: flex; align-items: center; padding: 0 22rpx; }
.section-heading { margin: 30rpx 0 18rpx; color: #17202a; font-size: 30rpx; font-weight: 900; }
.package-grid { display: flex; flex-wrap: wrap; gap: 16rpx 0; justify-content: space-between; }
.package-card { width: calc(50% - 8rpx); min-height: 190rpx; padding: 26rpx 24rpx; border: 2rpx solid #dce3ea; border-radius: 18rpx; background: #ffffff; box-sizing: border-box; }
.package-card.selected { border-color: #b98a45; background: #fffaf1; box-shadow: 0 16rpx 36rpx rgba(138, 75, 9, 0.08); }
.package-amount { color: #17202a; font-size: 38rpx; font-weight: 900; }
.package-points { margin-top: 12rpx; color: #657283; font-size: 24rpx; }
.package-bonus { margin-top: 18rpx; padding: 8rpx 14rpx; color: #657283; font-size: 21rpx; font-weight: 800; border-radius: 999rpx; background: #f0f4f7; }
.package-bonus.has-bonus { color: #b84a62; background: #fcecf0; }
.payment-panel { margin-top: 26rpx; padding: 26rpx; }
.panel-heading, .summary-row { display: flex; align-items: center; justify-content: space-between; }
.section-title { color: #17202a; font-size: 30rpx; font-weight: 900; }
.selected-pill { padding: 10rpx 18rpx; }
.summary-row { min-height: 112rpx; margin-top: 18rpx; padding: 0 20rpx; border: 1rpx solid #e1e7ed; border-radius: 16rpx; }
.summary-title { color: #17202a; font-size: 27rpx; font-weight: 800; }
.summary-desc { margin-top: 8rpx; color: #758190; font-size: 22rpx; }
.summary-value { color: #17202a; font-size: 32rpx; font-weight: 900; }
.pay-button, .retry-button { display: flex; align-items: center; justify-content: center; color: #ffffff; font-weight: 900; border-radius: 18rpx; background: #17202a; }
.pay-button { width: 100%; min-width: 100%; max-width: 100%; height: 100rpx; margin: 26rpx 0 0; box-sizing: border-box; font-size: 28rpx; }
.pay-button[disabled] { color: rgba(255, 255, 255, 0.7); background: #657283; }
.retry-button { width: 220rpx; height: 82rpx; margin: 28rpx auto 0; }
.notice-panel { min-height: 92rpx; display: flex; align-items: center; justify-content: space-between; margin-top: 22rpx; padding: 0 22rpx; color: #657283; font-size: 22rpx; }
.rule-link { padding: 10rpx 20rpx; color: #17202a; background: #f0f4f7; }
.skeleton-panel { min-height: 164rpx; background: #e9eef3; }
.empty-state { padding: 120rpx 32rpx; text-align: center; }
.empty-title { color: #17202a; font-size: 32rpx; font-weight: 900; }
.empty-desc { margin-top: 14rpx; color: #758190; font-size: 24rpx; }
