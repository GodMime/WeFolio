<view class="page-shell login-page">
  <navigation-bar title="映期Folio" back="{{false}}" color="#212529" background="rgba(245, 246, 247, 0.94)"></navigation-bar>

  <scroll-view class="login-scroll" scroll-y type="list">
    <view class="login-layout">
      <view class="login-hero {{activeTab === 'experience' ? 'experience-mode' : 'maintainer-mode'}}">
        <image class="hero-image" src="https://cdn2.we-folio.dingchenyong.top/system/backgroud.jpeg" mode="aspectFill"></image>
        <view class="hero-shade"></view>
        <view class="hero-copy">
          <view class="hero-title">把作品和档期，装进一张可分享名片</view>
        </view>
      </view>

      <view class="login-content">
        <view class="panel welcome-panel">
          <view class="welcome-copy">
            <view class="welcome-title">欢迎使用映期Folio</view>
            <view class="welcome-desc">适合分享你的照片与视频，并自由制作属于你的可分享名片。</view>
          </view>
          <image class="welcome-avatar" src="https://cdn2.we-folio.dingchenyong.top/system/folio-logo.png" mode="aspectFill"></image>
        </view>

        <view class="panel auth-panel">
          <view class="login-tabs">
            <button class="login-tab {{activeTab === 'experience' ? 'active' : ''}}" data-tab="experience" bindtap="handleTabTap">体验</button>
            <button class="login-tab {{activeTab === 'maintainer' ? 'active' : ''}}" data-tab="maintainer" bindtap="handleTabTap">登录 / 注册</button>
            <view class="tab-indicator {{activeTab}}"></view>
          </view>

          <view class="auth-body {{activeTab === 'experience' ? 'experience-mode' : 'maintainer-mode'}}">
            <view class="login-form experience-form {{activeTab === 'experience' ? 'active' : 'inactive'}}">
              <button class="primary-button" bindtap="handleExperienceTap">先体验</button>
              <view class="experience-hint">支持先体验基础功能再授权注册</view>
            </view>

            <view class="login-form maintainer-form {{activeTab === 'maintainer' ? 'active' : 'inactive'}}">
              <view class="form-row">
                <view class="field-heading">
                  <view class="field-label">推荐码</view>
                  <view class="field-limit">{{referralCode.length}}/16</view>
                </view>
                <view class="input-shell">
                  <input
                    class="referral-input"
                    value="{{referralCode}}"
                    placeholder="填写他人的个人唯一码"
                    placeholder-class="input-placeholder"
                    maxlength="16"
                    bindinput="handleReferralInput"
                  />
                  <text class="optional-text">选填</text>
                </view>
                <view class="referral-hint">推荐码仅新用户注册时有效</view>
              </view>
              <view wx:if="{{precheckErrorMessage}}" class="precheck-error">{{precheckErrorMessage}}</view>
              <button
                class="primary-button maintainer-auth-button"
                loading="{{prechecking || loading}}"
                disabled="{{prechecking || loading}}"
                open-type="{{phoneAuthorizationRequired ? 'getPhoneNumber' : ''}}"
                bindtap="handleMaintainerAuthTap"
                bindgetphonenumber="handleRegisterPhone"
              >
                {{maintainerButtonText}}
              </button>
            </view>
          </view>
        </view>
      </view>
    </view>
  </scroll-view>
</view>
