.login-page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  background: #f5f6f7;
}

.login-scroll {
  flex: 1;
  min-height: 0;
}

.login-layout {
  display: flex;
  height: 100%;
  min-height: 100%;
  flex-direction: column;
  box-sizing: border-box;
}

.login-hero {
  position: relative;
  flex: 1 1 0;
  min-height: 320rpx;
  margin: 20rpx 32rpx 0;
  overflow: hidden;
  border-radius: 48rpx;
  background: #17202a;
  box-shadow: 0 20rpx 52rpx rgba(23, 32, 42, 0.14);
  transition: min-height 0.62s cubic-bezier(0.22, 0.61, 0.36, 1),
    flex-basis 0.62s cubic-bezier(0.22, 0.61, 0.36, 1),
    transform 0.62s cubic-bezier(0.22, 0.61, 0.36, 1);
}

.login-hero.experience-mode {
  min-height: 500rpx;
}

.login-hero.maintainer-mode {
  min-height: 380rpx;
}

.hero-image,
.hero-shade {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
}

.hero-image {
  transition: transform 0.62s cubic-bezier(0.22, 0.61, 0.36, 1),
    filter 0.62s cubic-bezier(0.22, 0.61, 0.36, 1);
}

.login-hero.experience-mode .hero-image {
  transform: scale(1.1) translateY(-14rpx);
  filter: brightness(1.04);
}

.login-hero.maintainer-mode .hero-image {
  transform: scale(1.08) translateY(-8rpx);
  filter: brightness(1.03);
}

.hero-shade {
  background: linear-gradient(180deg, rgba(23, 32, 42, 0.06) 0%, rgba(23, 32, 42, 0.72) 100%);
  transition: background 0.62s cubic-bezier(0.22, 0.61, 0.36, 1);
}

.login-hero.experience-mode .hero-shade,
.login-hero.maintainer-mode .hero-shade {
  background: linear-gradient(180deg, rgba(23, 32, 42, 0.03) 0%, rgba(23, 32, 42, 0.66) 100%);
}

.hero-copy {
  position: absolute;
  left: 28rpx;
  right: 28rpx;
  bottom: 28rpx;
  color: #fff;
}

.hero-title {
  max-width: 520rpx;
  font-size: 38rpx;
  font-weight: 800;
  line-height: 1.25;
}

.login-content {
  display: flex;
  flex: none;
  flex-direction: column;
  gap: 20rpx;
  padding: 20rpx 32rpx;
  box-sizing: border-box;
}

.panel {
  border: 1rpx solid #e9ecef;
  border-radius: 48rpx;
  background: #ffffff;
  box-shadow: none;
}

.welcome-panel {
  display: flex;
  min-height: 150rpx;
  padding: 28rpx;
  align-items: center;
  justify-content: space-between;
  box-sizing: border-box;
  gap: 20rpx;
}

.welcome-copy {
  min-width: 0;
}

.welcome-title {
  color: #212529;
  font-size: 31rpx;
  font-weight: 800;
  line-height: 1.3;
}

.welcome-desc {
  margin-top: 8rpx;
  color: #868e96;
  font-size: 24rpx;
  line-height: 1.45;
}

.welcome-avatar {
  width: 86rpx;
  height: 86rpx;
  flex: none;
  overflow: hidden;
  border-radius: 50%;
  background: #eef6f4;
}

.auth-panel {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  padding: 28rpx;
}

.login-tabs {
  position: relative;
  display: flex;
  align-items: stretch;
  height: 52rpx;
  min-height: 52rpx;
  padding: 0;
  border: 0;
  border-bottom: 1rpx solid #e9ecef;
  border-radius: 0;
  background: transparent;
  box-sizing: border-box;
  box-shadow: none;
}

.login-tab {
  position: relative;
  display: flex;
  flex: 1;
  min-width: 0;
  height: 52rpx;
  align-items: center;
  justify-content: center;
  padding: 0 4rpx;
  box-sizing: border-box;
  color: #868e96;
  font-size: 22rpx;
  font-weight: 800;
  line-height: 1;
  border-radius: 0;
  background: transparent;
}

.login-tab::after,
.primary-button::after {
  border: 0;
}

.login-tab.active {
  color: #212529;
  background: transparent;
  box-shadow: none;
}

.tab-indicator {
  position: absolute;
  left: 25%;
  bottom: -1rpx;
  width: 48rpx;
  height: 5rpx;
  margin-left: -24rpx;
  border-radius: 999rpx;
  background: #212529;
  transition: left 0.28s cubic-bezier(0.22, 0.61, 0.36, 1);
}

.tab-indicator.experience {
  left: 25%;
}

.tab-indicator.maintainer {
  left: 75%;
}

.login-form {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
  margin-top: 0;
  max-height: 0;
  overflow: hidden;
  opacity: 0;
  pointer-events: none;
  transform: translateY(12rpx);
  transition: max-height 0.62s cubic-bezier(0.22, 0.61, 0.36, 1),
    opacity 0.28s ease,
    transform 0.42s cubic-bezier(0.22, 0.61, 0.36, 1);
}

.auth-body {
  max-height: 340rpx;
  overflow: hidden;
  transition: max-height 0.62s cubic-bezier(0.22, 0.61, 0.36, 1);
}

.auth-body.experience-mode {
  max-height: 142rpx;
}

.auth-body.maintainer-mode {
  max-height: 340rpx;
}

.login-form.active {
  opacity: 1;
  pointer-events: auto;
  transform: translateY(0);
}

.login-form.inactive {
  max-height: 0;
  opacity: 0;
  pointer-events: none;
  transform: translateY(12rpx);
}

.experience-form.active {
  max-height: 142rpx;
}

.maintainer-form.active {
  max-height: 340rpx;
}

.experience-hint {
  color: #868e96;
  font-size: 22rpx;
  font-weight: 700;
  line-height: 1.4;
  text-align: center;
}

.precheck-error {
  color: #b55656;
  font-size: 21rpx;
  font-weight: 700;
  line-height: 1.3;
}

.form-row {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  margin-bottom: 0;
}

.field-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.field-label {
  color: #212529;
  font-size: 23rpx;
  font-weight: 800;
}

.field-limit {
  color: #adb5bd;
  font-size: 22rpx;
}

.input-shell {
  display: flex;
  min-height: 84rpx;
  padding: 0 32rpx;
  align-items: center;
  border: 0;
  border-radius: 999rpx;
  background: #f5f6f7;
  box-sizing: border-box;
}

.referral-input {
  flex: 1;
  min-width: 0;
  height: 100%;
  color: #212529;
  font-size: 26rpx;
}

.input-placeholder {
  color: #adb5bd;
}

.optional-text {
  flex: none;
  margin-left: 18rpx;
  color: #868e96;
  font-size: 22rpx;
}

.referral-hint {
  color: #868e96;
  font-size: 21rpx;
  line-height: 1.4;
}

.primary-button {
  display: flex;
  width: 100%;
  min-width: 100%;
  max-width: 100%;
  height: 92rpx;
  margin-left: 0;
  margin-right: 0;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 26rpx;
  font-weight: 800;
  line-height: 1;
  border-radius: 999rpx;
  background: #212529;
  box-shadow: none;
  box-sizing: border-box;
}

.primary-button[disabled] {
  color: rgba(255, 255, 255, 0.78);
  background: #868e96;
  box-shadow: none;
}
