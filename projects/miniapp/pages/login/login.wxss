.login-page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  background: #f5f7fb;
}

.login-scroll {
  flex: 1;
  min-height: 0;
}

.login-layout {
  display: flex;
  height: 100%;
  min-height: 100%;
  flex-direction: column;
  box-sizing: border-box;
}

.login-hero {
  position: relative;
  flex: 1 1 0;
  min-height: 320rpx;
  margin: 24rpx 28rpx 0;
  overflow: hidden;
  border-radius: 16rpx;
  background: #17202a;
  box-shadow: 0 20rpx 52rpx rgba(23, 32, 42, 0.14);
  transition: min-height 0.62s cubic-bezier(0.22, 0.61, 0.36, 1),
    flex-basis 0.62s cubic-bezier(0.22, 0.61, 0.36, 1),
    transform 0.62s cubic-bezier(0.22, 0.61, 0.36, 1);
}

.login-hero.register-mode {
  min-height: 320rpx;
}

.login-hero.wechat-mode {
  min-height: 500rpx;
}

.hero-image,
.hero-shade {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
}

.hero-image {
  transition: transform 0.62s cubic-bezier(0.22, 0.61, 0.36, 1),
    filter 0.62s cubic-bezier(0.22, 0.61, 0.36, 1);
}

.login-hero.register-mode .hero-image {
  transform: scale(1.04) translateY(0);
  filter: brightness(1);
}

.login-hero.wechat-mode .hero-image {
  transform: scale(1.12) translateY(-20rpx);
  filter: brightness(1.06);
}

.hero-shade {
  background: linear-gradient(180deg, rgba(23, 32, 42, 0.06) 0%, rgba(23, 32, 42, 0.72) 100%);
  transition: background 0.62s cubic-bezier(0.22, 0.61, 0.36, 1);
}

.login-hero.wechat-mode .hero-shade {
  background: linear-gradient(180deg, rgba(23, 32, 42, 0.03) 0%, rgba(23, 32, 42, 0.66) 100%);
}

.hero-copy {
  position: absolute;
  left: 28rpx;
  right: 28rpx;
  bottom: 28rpx;
  color: #fff;
}

.hero-title {
  max-width: 520rpx;
  font-size: 38rpx;
  font-weight: 800;
  line-height: 1.25;
}

.login-content {
  display: flex;
  flex: none;
  flex-direction: column;
  gap: 20rpx;
  padding: 20rpx 28rpx 28rpx;
  box-sizing: border-box;
}

.panel {
  border: 1rpx solid rgba(23, 32, 42, 0.06);
  border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.94);
  box-shadow: 0 18rpx 48rpx rgba(23, 32, 42, 0.06);
}

.welcome-panel {
  display: flex;
  min-height: 150rpx;
  padding: 26rpx;
  align-items: center;
  justify-content: space-between;
  box-sizing: border-box;
  gap: 20rpx;
}

.welcome-copy {
  min-width: 0;
}

.welcome-title {
  color: #17202a;
  font-size: 31rpx;
  font-weight: 800;
  line-height: 1.3;
}

.welcome-desc {
  margin-top: 8rpx;
  color: #6b7785;
  font-size: 24rpx;
  line-height: 1.45;
}

.welcome-avatar {
  width: 86rpx;
  height: 86rpx;
  flex: none;
  overflow: hidden;
  border-radius: 50%;
  background: #eef6f4;
}

.auth-panel {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  padding: 22rpx;
}

.login-tabs {
  display: flex;
  align-items: stretch;
  height: 52rpx;
  min-height: 52rpx;
  padding: 0;
  border: 0;
  border-bottom: 1rpx solid #d7dee5;
  border-radius: 0;
  background: transparent;
  box-sizing: border-box;
  box-shadow: none;
}

.login-tab {
  position: relative;
  display: flex;
  flex: 1;
  min-width: 0;
  height: 52rpx;
  align-items: center;
  justify-content: center;
  padding: 0 4rpx;
  box-sizing: border-box;
  color: #66727f;
  font-size: 22rpx;
  font-weight: 800;
  line-height: 1;
  border-radius: 0;
  background: transparent;
}

.login-tab::after,
.primary-button::after {
  border: 0;
}

.login-tab.active {
  color: #17202a;
  background: transparent;
  box-shadow: none;
}

.login-tab.active::after {
  position: absolute;
  left: 32rpx;
  right: 32rpx;
  bottom: -1rpx;
  height: 4rpx;
  border-radius: 999rpx 999rpx 0 0;
  background: #315f9d;
  content: "";
}

.login-form {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
  margin-top: 0;
  max-height: 0;
  overflow: hidden;
  opacity: 0;
  pointer-events: none;
  transform: translateY(12rpx);
  transition: max-height 0.62s cubic-bezier(0.22, 0.61, 0.36, 1),
    opacity 0.28s ease,
    transform 0.42s cubic-bezier(0.22, 0.61, 0.36, 1);
}

.auth-body {
  max-height: 430rpx;
  overflow: hidden;
  transition: max-height 0.62s cubic-bezier(0.22, 0.61, 0.36, 1);
}

.auth-body.register-mode {
  max-height: 430rpx;
}

.auth-body.wechat-mode {
  max-height: 84rpx;
}

.login-form.active {
  opacity: 1;
  pointer-events: auto;
  transform: translateY(0);
}

.login-form.inactive {
  max-height: 0;
  opacity: 0;
  pointer-events: none;
  transform: translateY(12rpx);
}

.register-form.active {
  max-height: 430rpx;
}

.wechat-form.active {
  max-height: 84rpx;
}

.profile-row {
  gap: 8rpx;
}

.profile-auth-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.avatar-picker {
  display: flex;
  width: 68rpx;
  min-width: 68rpx;
  max-width: 68rpx;
  height: 68rpx;
  min-height: 68rpx;
  flex: none;
  margin: 0;
  padding: 0 !important;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  border: 2rpx solid transparent;
  border-radius: 999rpx;
  background: #eef6f4;
  box-sizing: border-box;
  box-shadow: none;
  color: #66727f;
  font-size: 19rpx;
  font-weight: 800;
  line-height: 1;
}

.avatar-picker::after {
  border: 0;
}

.avatar-picker.invalid {
  border-color: #d92d20;
  background: #fff7f7;
}

.picked-avatar {
  display: block;
  width: 100%;
  height: 100%;
  border-radius: 50%;
}

.avatar-placeholder {
  line-height: 1;
}

.nickname-auth-field {
  position: relative;
  display: flex;
  flex: 1;
  min-width: 0;
  height: 84rpx;
  padding: 0 22rpx;
  align-items: center;
  overflow: hidden;
  border: 1rpx solid #e4ebef;
  border-radius: 16rpx;
  background: #f8fafb;
  box-sizing: border-box;
}

.nickname-auth-field.invalid {
  border-color: #d92d20;
  background: #fff7f7;
}

.nickname-auth-text,
.nickname-auth-placeholder {
  position: relative;
  z-index: 1;
  max-width: 100%;
  overflow: hidden;
  font-size: 26rpx;
  line-height: 1.2;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.nickname-auth-text {
  color: #17202a;
}

.nickname-auth-placeholder {
  color: #8b96a3;
}

.nickname-native-input {
  position: absolute;
  left: 0;
  top: 0;
  z-index: 2;
  width: 100%;
  height: 100%;
  opacity: 0;
  color: transparent;
  caret-color: transparent;
}

.field-error {
  color: #d92d20;
  font-size: 21rpx;
  font-weight: 700;
  line-height: 1.3;
}

.form-row {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  margin-bottom: 0;
}

.field-label {
  color: #17202a;
  font-size: 23rpx;
  font-weight: 800;
}

.input-shell {
  display: flex;
  height: 84rpx;
  padding: 0 22rpx;
  align-items: center;
  border: 1rpx solid #e4ebef;
  border-radius: 16rpx;
  background: #f8fafb;
  box-sizing: border-box;
}

.referral-input {
  flex: 1;
  min-width: 0;
  height: 100%;
  color: #17202a;
  font-size: 26rpx;
}

.input-placeholder {
  color: #9aa5af;
}

.optional-text {
  flex: none;
  margin-left: 18rpx;
  color: #8b96a3;
  font-size: 22rpx;
}

.primary-button {
  display: flex;
  width: 100%;
  height: 84rpx;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 26rpx;
  font-weight: 800;
  line-height: 1;
  border-radius: 16rpx;
  background: linear-gradient(180deg, #263445, #111827);
  box-shadow: 0 20rpx 44rpx rgba(17, 24, 39, 0.2);
}
