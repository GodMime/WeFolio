.points-page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  background-color: #f5f7fb;
}

.points-scroll {
  flex: 1;
  min-height: 0;
}

.points-content {
  padding: 28rpx 28rpx 56rpx;
  box-sizing: border-box;
}

.panel {
  background: rgba(255, 255, 255, 0.94);
  border: 1rpx solid rgba(23, 32, 42, 0.06);
  border-radius: 16rpx;
  box-shadow: 0 18rpx 48rpx rgba(23, 32, 42, 0.06);
  box-sizing: border-box;
}

.points-balance-band {
  min-height: 224rpx;
  padding: 28rpx;
  color: #ffffff;
  border-radius: 16rpx;
  background: linear-gradient(135deg, #17202a 0%, #243241 64%, #326d64 100%);
  box-shadow: 0 20rpx 54rpx rgba(23, 32, 42, 0.16);
  box-sizing: border-box;
}

.balance-top,
.balance-bottom,
.panel-heading,
.ledger-row {
  display: flex;
  align-items: center;
}

.balance-top,
.balance-bottom,
.panel-heading {
  justify-content: space-between;
}

.balance-copy {
  flex: 1;
  min-width: 0;
}

.balance-label {
  color: rgba(255, 255, 255, 0.72);
  font-size: 24rpx;
  line-height: 1.35;
}

.balance-value {
  margin-top: 8rpx;
  color: #ffffff;
  font-size: 64rpx;
  font-weight: 900;
  line-height: 1;
}

.light-button {
  min-width: 136rpx;
  height: 88rpx;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  flex: none;
  margin-left: 24rpx;
  padding: 0 28rpx;
  color: #17202a;
  font-size: 26rpx;
  font-weight: 800;
  line-height: 1;
  text-align: center;
  white-space: nowrap;
  border-radius: 16rpx;
  background: #ffffff;
  box-shadow: 0 20rpx 44rpx rgba(17, 24, 39, 0.2);
  box-sizing: border-box;
}

.balance-bottom {
  gap: 18rpx;
  margin-top: 24rpx;
  color: rgba(255, 255, 255, 0.72);
  font-size: 23rpx;
  line-height: 1.35;
}

.points-metric-grid {
  display: flex;
  gap: 16rpx;
  margin-top: 22rpx;
}

.points-metric {
  flex: 1 1 0;
  min-width: 0;
  min-height: 136rpx;
  padding: 24rpx 12rpx;
  text-align: center;
  border: 1rpx solid rgba(23, 32, 42, 0.06);
  border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.94);
  box-sizing: border-box;
}

.metric-value {
  color: #17202a;
  font-size: 38rpx;
  font-weight: 800;
  line-height: 1.1;
}

.metric-label {
  margin-top: 12rpx;
  color: #758190;
  font-size: 22rpx;
  line-height: 1.25;
}

.ledger-panel {
  margin-top: 22rpx;
  padding: 24rpx 24rpx 10rpx;
}

.section-title {
  color: #17202a;
  font-size: 28rpx;
  font-weight: 800;
  line-height: 1.35;
}

.ledger-heading {
  width: 100%;
  align-items: flex-start;
}

.ledger-action {
  flex: 1 1 0;
  min-width: 0;
  display: flex;
  align-items: flex-start;
  justify-content: flex-end;
}

.rule-link {
  width: 196rpx;
  min-height: 52rpx;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 196rpx;
  margin: 0;
  padding: 0;
  color: #2d5f9a;
  font-size: 22rpx;
  font-weight: 800;
  line-height: 1;
  text-align: center;
  white-space: nowrap;
  border-radius: 999rpx;
  background: #e6efff;
  box-sizing: border-box;
}

.ledger-list {
  margin-top: 10rpx;
}

.ledger-row {
  gap: 20rpx;
  min-height: 112rpx;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #edf1f5;
  box-sizing: border-box;
}

.ledger-row:last-child {
  border-bottom: 0;
}

.ledger-copy {
  flex: 1;
  min-width: 0;
}

.ledger-title {
  overflow: hidden;
  color: #17202a;
  font-size: 27rpx;
  font-weight: 800;
  line-height: 1.35;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.ledger-desc-viewport {
  width: 100%;
  margin-top: 6rpx;
  overflow: hidden;
  white-space: nowrap;
}

.ledger-desc-text {
  display: inline-block;
  min-width: 100%;
  color: #758190;
  font-size: 22rpx;
  line-height: 1.35;
  white-space: nowrap;
}

.ledger-desc-text.is-auto-scrolling {
  will-change: transform;
  animation-name: ledger-desc-auto-scroll;
  animation-duration: var(--ledger-marquee-duration);
  animation-timing-function: linear;
  animation-iteration-count: infinite;
  animation-direction: alternate;
}

@keyframes ledger-desc-auto-scroll {
  0%, 15% {
    transform: translateX(0);
  }

  85%, 100% {
    transform: translateX(var(--ledger-marquee-distance));
  }
}

.points-change {
  flex: none;
  min-width: 78rpx;
  text-align: right;
  font-size: 30rpx;
  font-weight: 900;
  line-height: 1;
}

.points-change.plus {
  color: #0f766e;
}

.points-change.minus {
  color: #b84a62;
}

.points-change.neutral {
  color: #758190;
}

.load-more-text {
  padding: 18rpx 0 24rpx;
  color: #8b96a3;
  font-size: 22rpx;
  line-height: 1.3;
  text-align: center;
}

.ledger-empty,
.empty-state {
  min-height: 420rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
  text-align: center;
  box-sizing: border-box;
}

.ledger-empty {
  min-height: 260rpx;
}

.empty-icon {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: #dfe8e5;
}

.empty-title {
  margin-top: 24rpx;
  color: #17202a;
  font-size: 30rpx;
  font-weight: 800;
  line-height: 1.3;
}

.empty-title.small {
  margin-top: 0;
  font-size: 28rpx;
}

.empty-desc {
  margin-top: 10rpx;
  color: #778392;
  font-size: 24rpx;
  line-height: 1.55;
}

.primary-button.compact {
  min-width: 180rpx;
  min-height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 22rpx;
  padding: 0 28rpx;
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 800;
  line-height: 1;
  border-radius: 16rpx;
  background: #17202a;
  box-sizing: border-box;
}

.skeleton-panel {
  min-height: 136rpx;
  border-color: transparent;
  background: linear-gradient(90deg, #eef2f6 0%, #f7f9fc 48%, #eef2f6 100%);
  background-size: 280% 100%;
  animation: skeleton-loading 1.4s ease-in-out infinite;
}

.ledger-panel.skeleton-panel {
  min-height: 360rpx;
}

@keyframes skeleton-loading {
  0% {
    background-position: 100% 50%;
  }
  100% {
    background-position: 0 50%;
  }
}
