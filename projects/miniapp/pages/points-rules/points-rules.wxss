.points-rules-page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  background-color: #f5f6f7;
}

.points-rules-scroll {
  flex: 1;
  min-height: 0;
}

.points-rules-content {
  padding: 20rpx 32rpx 56rpx;
  box-sizing: border-box;
}

.panel {
  background: #ffffff;
  border: 1rpx solid #e9ecef;
  border-radius: 48rpx;
  box-shadow: none;
  box-sizing: border-box;
}

.intro-panel,
.account-panel,
.rules-empty {
  padding: 24rpx;
}

.panel-heading,
.cost-group,
.cost-line,
.rule-item {
  display: flex;
}

.panel-heading {
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.section-title {
  color: #212529;
  font-size: 28rpx;
  font-weight: 800;
  line-height: 1.35;
}

.rule-pill {
  min-height: 48rpx;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  flex: none;
  padding: 0 16rpx;
  color: #212529;
  font-size: 22rpx;
  font-weight: 800;
  line-height: 1;
  border-radius: 999rpx;
  background: #f5f6f7;
  box-sizing: border-box;
}

.rule-pill.muted {
  color: #868e96;
  background: #f5f6f7;
}

.cost-board {
  margin-top: 20rpx;
  overflow: hidden;
  border: 1rpx solid #e9ecef;
  border-radius: 48rpx;
  background: #ffffff;
  box-shadow: none;
  box-sizing: border-box;
}

.cost-group {
  display: flex;
  align-items: stretch;
  border-bottom: 1rpx solid #f1f3f5;
}

.cost-group:last-child {
  border-bottom: 0;
}

.cost-mark {
  width: 116rpx;
  flex: none;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #868e96;
  font-size: 24rpx;
  font-weight: 900;
  line-height: 1.2;
  text-align: center;
  background: #ffffff;
  border-right: 1rpx solid #f1f3f5;
  box-sizing: border-box;
}

.cost-mark.maintenance {
  color: #2d5f9a;
  background: #ffffff;
}

.cost-mark.visitor {
  color: #c08a3e;
  background: #ffffff;
}

.cost-mark.gift {
  color: #5c9e6e;
  background: #ffffff;
}

.cost-mark.maintenance::before,
.cost-mark.visitor::before,
.cost-mark.gift::before {
  width: 12rpx;
  height: 12rpx;
  flex: none;
  margin-right: 8rpx;
  content: "";
  border-radius: 50%;
  background: currentColor;
}

.cost-lines {
  flex: 1;
  min-width: 0;
}

.cost-line {
  display: flex;
  align-items: center;
  gap: 16rpx;
  min-height: 92rpx;
  padding: 18rpx 18rpx;
  border-bottom: 1rpx solid #f1f3f5;
  box-sizing: border-box;
}

.cost-line:last-child {
  border-bottom: 0;
}

.cost-copy {
  flex: 1;
  min-width: 0;
}

.cost-title {
  overflow: hidden;
  color: #212529;
  font-size: 26rpx;
  font-weight: 800;
  line-height: 1.35;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.cost-desc {
  margin-top: 6rpx;
  overflow: hidden;
  color: #868e96;
  font-size: 22rpx;
  line-height: 1.35;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.gift-desc {
  overflow: visible;
  text-overflow: clip;
  white-space: normal;
}

.cost-chip {
  min-width: 88rpx;
  min-height: 50rpx;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  flex: none;
  padding: 0 16rpx;
  color: #212529;
  font-size: 22rpx;
  font-weight: 900;
  line-height: 1;
  white-space: nowrap;
  border: 1rpx solid #e9ecef;
  border-radius: 999rpx;
  background: #ffffff;
  box-sizing: border-box;
}

.cost-chip.maintenance {
  color: #2d5f9a;
}

.cost-chip.visitor {
  color: #c08a3e;
}

.cost-chip.gift {
  color: #5c9e6e;
  border-color: #e9ecef;
  background: #ffffff;
}

.account-panel,
.rules-empty {
  margin-top: 20rpx;
}

.rule-list {
  margin-top: 20rpx;
}

.rule-item {
  align-items: flex-start;
  gap: 16rpx;
  margin-top: 16rpx;
  color: #868e96;
  font-size: 24rpx;
  line-height: 1.5;
}

.rule-item:first-child {
  margin-top: 0;
}

.check {
  width: 42rpx;
  height: 42rpx;
  flex: none;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #212529;
  font-size: 22rpx;
  font-weight: 900;
  line-height: 1;
  border-radius: 50%;
  background: #f5f6f7;
}

.empty-state {
  min-height: 520rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
  text-align: center;
  box-sizing: border-box;
}

.empty-icon {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: #dfe8e5;
}

.empty-title {
  margin-top: 24rpx;
  color: #212529;
  font-size: 30rpx;
  font-weight: 800;
  line-height: 1.3;
}

.empty-title.small {
  margin-top: 0;
  font-size: 28rpx;
}

.empty-desc {
  margin-top: 10rpx;
  color: #868e96;
  font-size: 24rpx;
  line-height: 1.55;
}

.primary-button.compact {
  min-width: 180rpx;
  min-height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 22rpx;
  padding: 0 28rpx;
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 800;
  line-height: 1;
  border-radius: 999rpx;
  background: #212529;
  box-sizing: border-box;
}

.skeleton-panel {
  min-height: 136rpx;
  border-color: transparent;
  background: linear-gradient(90deg, #eef2f6 0%, #f7f9fc 48%, #eef2f6 100%);
  background-size: 280% 100%;
  animation: skeleton-loading 1.4s ease-in-out infinite;
}

.cost-board.skeleton-panel {
  min-height: 520rpx;
}

.account-panel.skeleton-panel {
  min-height: 260rpx;
}

@keyframes skeleton-loading {
  0% {
    background-position: 100% 50%;
  }
  100% {
    background-position: 0 50%;
  }
}
