.teams-page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  background-color: #f5f7fb;
}

.teams-scroll {
  flex: 1;
  min-height: 0;
}

.teams-content {
  padding: 28rpx;
  box-sizing: border-box;
}

.panel {
  background: rgba(255, 255, 255, 0.94);
  border: 1rpx solid rgba(23, 32, 42, 0.06);
  border-radius: 16rpx;
  box-shadow: 0 18rpx 48rpx rgba(23, 32, 42, 0.06);
  box-sizing: border-box;
}

.summary-panel,
.panel-heading,
.team-card,
.avatar-field,
.field-heading {
  display: flex;
  align-items: center;
}

.summary-panel {
  justify-content: space-between;
  gap: 20rpx;
  min-height: 132rpx;
  padding: 24rpx;
}

.summary-copy,
.team-copy {
  flex: 1;
  min-width: 0;
}

.section-title {
  color: #17202a;
  font-size: 28rpx;
  font-weight: 800;
  line-height: 1.35;
}

.summary-desc,
.panel-desc,
.team-subtitle,
.create-note,
.empty-desc {
  color: #778392;
  font-size: 24rpx;
  line-height: 1.45;
}

.summary-desc {
  margin-top: 8rpx;
}

.count-pill,
.role-pill {
  flex: none;
  padding: 8rpx 14rpx;
  font-size: 22rpx;
  font-weight: 800;
  line-height: 1;
  border-radius: 999rpx;
  box-sizing: border-box;
}

.count-pill,
.role-pill.teal {
  color: #0f766e;
  background: #dcf7f1;
}

.role-pill.blue {
  color: #2d5f9a;
  background: #e6efff;
}

.role-pill.muted {
  color: #667085;
  background: #eef2f6;
}

.list-panel,
.create-form-panel {
  margin-top: 22rpx;
  padding: 24rpx;
}

.panel-heading {
  justify-content: space-between;
  gap: 16rpx;
}

.team-list {
  margin-top: 16rpx;
}

.team-card {
  min-height: 168rpx;
  gap: 20rpx;
  padding: 20rpx 0;
  border-top: 1rpx solid #edf1f5;
}

.team-card:first-child {
  border-top: 0;
}

.team-logo {
  width: 92rpx;
  height: 92rpx;
  flex: none;
  overflow: hidden;
  border-radius: 22rpx;
  background: #dfe8e5;
}

.team-logo.large {
  width: 116rpx;
  height: 116rpx;
  border-radius: 28rpx;
}

.team-logo-image,
.team-logo-fallback {
  width: 100%;
  height: 100%;
}

.team-logo-fallback {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #f7fbfa;
  font-size: 28rpx;
  font-weight: 900;
  background: linear-gradient(135deg, #17202a 0%, #2e7d73 100%);
}

.team-name {
  overflow: hidden;
  color: #17202a;
  font-size: 30rpx;
  font-weight: 800;
  line-height: 1.3;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.team-subtitle {
  margin-top: 7rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.pill-row {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 12rpx;
}

.team-actions {
  flex: none;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 12rpx;
}

.entry-arrow {
  width: 24rpx;
  height: 24rpx;
  border-top: 3rpx solid #a7b0ba;
  border-right: 3rpx solid #a7b0ba;
  transform: rotate(45deg);
}

.primary-button,
.secondary-button {
  min-height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 28rpx;
  font-size: 28rpx;
  font-weight: 800;
  line-height: 1;
  border-radius: 16rpx;
  box-sizing: border-box;
}

.primary-button {
  color: #fff;
  background: #17202a;
}

.secondary-button {
  color: #17202a;
  background: #eef2f6;
}

.full {
  width: 100%;
  margin-top: 22rpx;
}

.teams-content > .primary-button.full {
  width: 100%;
  min-width: 100%;
  max-width: 100%;
  margin-left: 0;
  margin-right: 0;
}

.create-section-body > .primary-button.full {
  width: 100%;
  min-width: 100%;
  max-width: 100%;
  margin-left: 0;
  margin-right: 0;
}

.create-section {
  max-height: 0;
  overflow: hidden;
  opacity: 0;
  transform: translateY(-12rpx);
  pointer-events: none;
  transition: max-height 420ms ease, opacity 260ms ease, transform 420ms ease;
}

.create-section.expanded {
  max-height: 900rpx;
  opacity: 1;
  transform: translateY(0);
  pointer-events: auto;
}

.create-section-body {
  padding-top: 22rpx;
}

.create-section .create-form-panel {
  margin-top: 0;
}

.avatar-field {
  align-items: flex-start;
  gap: 20rpx;
  margin-top: 22rpx;
}

.avatar-picker {
  width: 84rpx;
  height: 84rpx;
  margin-top: 43rpx;
  padding: 0;
  line-height: 1;
}

.avatar-name-field {
  flex: 1;
  min-width: 0;
  margin-top: 0;
}

.form-row {
  margin-top: 22rpx;
}

.field-heading {
  justify-content: space-between;
}

.label {
  color: #5f6b7a;
  font-size: 24rpx;
  font-weight: 700;
}

.field-limit {
  color: #8b96a3;
  font-size: 22rpx;
  font-weight: 700;
}

.input {
  width: 100%;
  min-height: 84rpx;
  margin-top: 12rpx;
  padding: 0 22rpx;
  color: #17202a;
  font-size: 28rpx;
  line-height: 84rpx;
  border-radius: 16rpx;
  background: #f6f8fb;
  box-sizing: border-box;
}

.textarea {
  min-height: 168rpx;
  padding-top: 20rpx;
  padding-bottom: 20rpx;
  line-height: 1.55;
}

.create-note {
  margin-top: 20rpx;
}

.team-empty,
.empty-state {
  min-height: 360rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
  text-align: center;
  box-sizing: border-box;
}

.empty-icon {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: #dfe8e5;
}

.empty-title {
  margin-top: 24rpx;
  color: #17202a;
  font-size: 30rpx;
  font-weight: 800;
}

.empty-title.small {
  margin-top: 0;
  font-size: 28rpx;
}

.compact {
  width: 180rpx;
  min-height: 72rpx;
  margin-top: 22rpx;
  font-size: 24rpx;
}

.skeleton-panel {
  min-height: 150rpx;
  border-color: transparent;
  background: linear-gradient(90deg, #eef2f6 0%, #f7f9fc 48%, #eef2f6 100%);
  background-size: 280% 100%;
  animation: skeleton-loading 1.4s ease-in-out infinite;
}

.list-panel.skeleton-panel {
  min-height: 520rpx;
}

button::after {
  border: 0;
}

@keyframes skeleton-loading {
  0% {
    background-position: 100% 50%;
  }
  100% {
    background-position: 0 50%;
  }
}
