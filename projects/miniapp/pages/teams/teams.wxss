.teams-page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  background-color: #f5f6f7;
}

.teams-scroll {
  flex: 1;
  min-height: 0;
}

.teams-content {
  padding: 20rpx 32rpx calc(56rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.panel {
  background: #ffffff;
  border: 1rpx solid #e9ecef;
  border-radius: 48rpx;
  box-shadow: 0 18rpx 48rpx rgba(33, 37, 41, 0.06);
  box-sizing: border-box;
}

.summary-panel,
.panel-heading,
.team-card,
.avatar-field,
.field-heading {
  display: flex;
  align-items: center;
}

.summary-panel {
  justify-content: space-between;
  gap: 20rpx;
  min-height: 128rpx;
  padding: 28rpx;
}

.summary-copy,
.team-copy {
  flex: 1;
  min-width: 0;
}

.section-title {
  color: #212529;
  font-size: 32rpx;
  font-weight: 700;
  line-height: 1.3;
}

.summary-desc,
.panel-desc,
.team-subtitle,
.create-note,
.empty-desc {
  color: #868e96;
  font-size: 24rpx;
  line-height: 1.45;
}

.summary-desc {
  margin-top: 8rpx;
}

.count-text {
  flex: none;
  color: #868e96;
  font-size: 22rpx;
  font-weight: 500;
  line-height: 1;
  white-space: nowrap;
}

.role-pill {
  flex: none;
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  font-size: 22rpx;
  font-weight: 500;
  line-height: 1;
  white-space: nowrap;
}

.role-pill::before {
  width: 12rpx;
  height: 12rpx;
  flex: none;
  content: "";
  border-radius: 50%;
  background: currentColor;
}

.role-pill.teal {
  color: #5c9e6e;
}

.role-pill.blue {
  color: #212529;
}

.role-pill.amber {
  color: #c08a3e;
}

.role-pill.muted {
  color: #868e96;
}

.list-panel,
.create-form-panel {
  margin-top: 20rpx;
  padding: 28rpx;
}

.panel-heading {
  justify-content: space-between;
  gap: 16rpx;
  padding: 0 4rpx;
}

.team-list {
  margin-top: 16rpx;
}

.team-card {
  min-height: 152rpx;
  gap: 20rpx;
  margin-top: 16rpx;
  padding: 20rpx 24rpx;
  border: 1rpx solid #e9ecef;
  border-radius: 40rpx;
  background: #ffffff;
  box-sizing: border-box;
}

.team-card:first-child {
  margin-top: 0;
}

.team-logo {
  width: 104rpx;
  height: 104rpx;
  flex: none;
  overflow: hidden;
  border-radius: 32rpx;
  background: #f1f3f5;
}

.team-logo.large {
  width: 116rpx;
  height: 116rpx;
  border-radius: 28rpx;
}

.team-logo-image {
  width: 100%;
  height: 100%;
}

.team-logo-fallback {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #212529;
  font-size: 28rpx;
  font-weight: 700;
  letter-spacing: 0.05em;
}

.team-name {
  overflow: hidden;
  color: #212529;
  font-size: 30rpx;
  font-weight: 700;
  letter-spacing: -0.01em;
  line-height: 1.3;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.team-subtitle {
  margin-top: 6rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.team-tags {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 10rpx;
  margin-bottom: 12rpx;
}

.entry-arrow {
  width: 16rpx;
  height: 16rpx;
  flex: none;
  margin-right: 8rpx;
  border-top: 4rpx solid #adb5bd;
  border-right: 4rpx solid #adb5bd;
  transform: rotate(45deg);
}

.primary-button,
.secondary-button {
  min-height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 28rpx;
  font-size: 28rpx;
  font-weight: 800;
  line-height: 1;
  border-radius: 999rpx;
  box-sizing: border-box;
}

.primary-button {
  color: #fff;
  background: #212529;
}

.secondary-button {
  color: #212529;
  background: #f1f3f5;
}

.full {
  width: 100%;
  margin-top: 22rpx;
}

.teams-content > .primary-button.full {
  width: 100%;
  min-width: 100%;
  max-width: 100%;
  margin-left: 0;
  margin-right: 0;
}

.create-section-body > .primary-button.full {
  width: 100%;
  min-width: 100%;
  max-width: 100%;
  margin-left: 0;
  margin-right: 0;
}

.create-section {
  max-height: 0;
  overflow: hidden;
  opacity: 0;
  transform: translateY(-12rpx);
  pointer-events: none;
  transition: max-height 420ms ease, opacity 260ms ease, transform 420ms ease;
}

.create-section.expanded {
  max-height: 900rpx;
  opacity: 1;
  transform: translateY(0);
  pointer-events: auto;
}

.create-section-body {
  padding-top: 22rpx;
}

.create-section .create-form-panel {
  margin-top: 0;
}

.avatar-field {
  align-items: flex-start;
  gap: 20rpx;
  margin-top: 22rpx;
}

.avatar-picker {
  width: 84rpx;
  height: 84rpx;
  margin-top: 43rpx;
  padding: 0;
  line-height: 1;
}

.avatar-name-field {
  flex: 1;
  min-width: 0;
  margin-top: 0;
}

.form-row {
  margin-top: 22rpx;
}

.field-heading {
  justify-content: space-between;
}

.label {
  color: #6c757d;
  font-size: 24rpx;
  font-weight: 700;
}

.field-limit {
  color: #868e96;
  font-size: 22rpx;
  font-weight: 700;
}

.input {
  width: 100%;
  min-height: 84rpx;
  margin-top: 12rpx;
  padding: 0 22rpx;
  color: #212529;
  font-size: 28rpx;
  line-height: 84rpx;
  border: 1rpx solid #e9ecef;
  border-radius: 40rpx;
  background: #ffffff;
  box-sizing: border-box;
}

.textarea {
  min-height: 168rpx;
  padding-top: 20rpx;
  padding-bottom: 20rpx;
  line-height: 1.55;
}

.create-note {
  margin-top: 20rpx;
}

.team-empty,
.empty-state {
  min-height: 360rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
  text-align: center;
  box-sizing: border-box;
}

.empty-icon {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: #e9ecef;
}

.empty-title {
  margin-top: 24rpx;
  color: #212529;
  font-size: 30rpx;
  font-weight: 800;
}

.empty-title.small {
  margin-top: 0;
  font-size: 28rpx;
}

.compact {
  width: 180rpx;
  min-height: 72rpx;
  margin-top: 22rpx;
  font-size: 24rpx;
}

.skeleton-panel {
  min-height: 150rpx;
  border-color: transparent;
  background: linear-gradient(90deg, #eef2f6 0%, #f7f9fc 48%, #eef2f6 100%);
  background-size: 280% 100%;
  animation: skeleton-loading 1.4s ease-in-out infinite;
}

.list-panel.skeleton-panel {
  min-height: 520rpx;
}

button::after {
  border: 0;
}

@keyframes skeleton-loading {
  0% {
    background-position: 100% 50%;
  }
  100% {
    background-position: 0 50%;
  }
}
