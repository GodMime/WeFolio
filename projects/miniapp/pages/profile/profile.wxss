.profile-page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  background-color: #f5f6f7;
}

.profile-scroll {
  flex: 1;
  min-height: 0;
}

.profile-content {
  padding: 20rpx 32rpx;
  box-sizing: border-box;
}

.panel {
  background: #ffffff;
  border: 1rpx solid #e9ecef;
  border-radius: 48rpx;
  box-shadow: none;
}

.profile-avatar-card {
  min-height: 154rpx;
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 28rpx;
  box-sizing: border-box;
}

.avatar {
  width: 96rpx;
  height: 96rpx;
  flex: none;
  overflow: hidden;
  border-radius: 50%;
  background: #e9ecef;
}

.avatar-image,
.avatar-fallback {
  width: 100%;
  height: 100%;
}

.avatar-fallback {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #f7fbfa;
  font-size: 28rpx;
  font-weight: 700;
  background: #868e96;
}

.profile-summary {
  flex: 1;
  min-width: 0;
}

.profile-name {
  overflow: hidden;
  color: #212529;
  font-size: 30rpx;
  font-weight: 800;
  line-height: 1.35;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.profile-code {
  margin-top: 8rpx;
  color: #868e96;
  font-size: 24rpx;
  line-height: 1.3;
}

.profile-fields-panel,
.tag-editor-panel,
.danger-panel {
  margin-top: 20rpx;
  padding: 28rpx;
  box-sizing: border-box;
}

.form-row + .form-row {
  margin-top: 22rpx;
}

.field-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.label {
  color: #868e96;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 1.3;
}

.field-limit {
  flex: none;
  color: #adb5bd;
  font-size: 22rpx;
  font-weight: 700;
  line-height: 1.3;
}

.input {
  width: 100%;
  min-height: 84rpx;
  margin-top: 12rpx;
  padding: 0 22rpx;
  color: #212529;
  font-size: 28rpx;
  line-height: 84rpx;
  border-radius: 32rpx;
  background: #f5f6f7;
  box-sizing: border-box;
}

.input.textarea {
  min-height: 144rpx;
  padding-top: 20rpx;
  padding-bottom: 20rpx;
  line-height: 1.55;
}

.qr-heading,
.tag-heading,
.pill-row,
.dialog-actions {
  display: flex;
  align-items: center;
}

.qr-heading,
.tag-heading {
  justify-content: space-between;
}

.qr-limit {
  flex: none;
  color: #868e96;
  font-size: 22rpx;
  font-weight: 700;
  line-height: 1.3;
}

.qr-body {
  display: flex;
  align-items: center;
  gap: 22rpx;
  margin-top: 22rpx;
}

.qr-preview {
  width: 156rpx;
  height: 156rpx;
  flex: none;
  overflow: hidden;
  border: 1rpx solid #e9ecef;
  border-radius: 40rpx;
  background: #f5f6f7;
}

.qr-image,
.qr-placeholder {
  width: 100%;
  height: 100%;
}

.qr-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #adb5bd;
  font-size: 28rpx;
  font-weight: 800;
  background: #f5f6f7;
}

.qr-actions {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: flex-start;
  min-width: 0;
}

.section-title {
  color: #212529;
  font-size: 28rpx;
  font-weight: 800;
  line-height: 1.35;
}

.count-pill {
  flex: none;
  padding: 8rpx 14rpx;
  color: #868e96;
  font-size: 22rpx;
  font-weight: 800;
  line-height: 1;
  border-radius: 999rpx;
  background: #f5f6f7;
}

.pill-row {
  flex-wrap: wrap;
  gap: 14rpx;
  margin-top: 20rpx;
}

.tag-pill,
.tag-add-trigger {
  min-height: 56rpx;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  max-width: 100%;
  padding: 0 18rpx;
  color: #0f766e;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 1;
  border: 1rpx solid transparent;
  border-radius: 999rpx;
  background: #ffffff;
  box-sizing: border-box;
}

.tag-dot {
  width: 12rpx;
  height: 12rpx;
  flex: none;
  margin-right: 14rpx;
  border-radius: 50%;
}

.tag-remove {
  width: 36rpx;
  height: 36rpx;
  min-width: 36rpx;
  flex: none;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  margin-left: 8rpx;
  color: #0f766e;
  font-size: 24rpx;
  font-weight: 800;
  line-height: 1;
  border-radius: 50%;
  border: 1rpx solid #e9ecef;
  background: #ffffff;
  box-sizing: border-box;
  overflow: hidden;
}

.tag-remove-mark {
  line-height: 1;
}

.tag-add-trigger {
  color: #212529;
  background: #f5f6f7;
}

.tag-note,
.danger-desc,
.empty-desc {
  color: #868e96;
  font-size: 24rpx;
  line-height: 1.55;
}

.tag-note {
  margin-top: 18rpx;
}

.danger-desc {
  margin-top: 8rpx;
}

.primary-button,
.secondary-button,
.danger-button {
  min-height: 92rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 28rpx;
  font-size: 28rpx;
  font-weight: 800;
  line-height: 1;
  border-radius: 999rpx;
  box-sizing: border-box;
}

.primary-button {
  color: #fff;
  border-radius: 999rpx;
  background: #212529;
}

.secondary-button {
  color: #212529;
  background: #f5f6f7;
}

.danger-button {
  margin-top: 20rpx;
  color: #b55656;
  border: 1rpx solid #e9c9c9;
  background: #ffffff;
}

.profile-action-button {
  flex: none;
  min-width: 140rpx;
  min-height: 72rpx;
  margin-left: 0;
  margin-right: 0;
  font-size: 24rpx;
}

.full {
  width: 100%;
  margin-top: 22rpx;
}

/* 一行一个按钮统一吃满父容器内容区：面板内等于输入框宽，面板外等于白色面板宽。 */
.wide-button {
  width: 100%;
  min-width: 100%;
  max-width: 100%;
  margin-left: auto;
  margin-right: auto;
  box-sizing: border-box;
}

.profile-content > .wide-button {
  width: 100%;
  min-width: 100%;
  max-width: 100%;
}

.tag-editor-panel .wide-button,
.danger-panel > .wide-button {
  width: 100%;
  min-width: 100%;
  max-width: 100%;
}

.compact {
  width: 180rpx;
  min-height: 72rpx;
  margin-top: 22rpx;
  font-size: 24rpx;
}

.empty-state {
  min-height: 520rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
  text-align: center;
  box-sizing: border-box;
}

.empty-icon {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: #dfe8e5;
}

.empty-title {
  margin-top: 24rpx;
  color: #17202a;
  font-size: 30rpx;
  font-weight: 800;
}

.empty-desc {
  margin-top: 10rpx;
}

.skeleton-panel {
  min-height: 150rpx;
  background: linear-gradient(90deg, #eef2f6 0%, #f7f9fc 48%, #eef2f6 100%);
  background-size: 280% 100%;
  animation: skeleton-loading 1.4s ease-in-out infinite;
}

.tag-dialog {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 30;
  opacity: 0;
  pointer-events: none;
  transition: opacity 215ms ease-out;
}

.tag-dialog.visible {
  opacity: 1;
  pointer-events: auto;
}

.tag-dialog-backdrop {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(23, 32, 42, 0.36);
}

.tag-dialog-panel {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  width: 100%;
  max-height: calc(100% - env(safe-area-inset-top));
  overflow-y: auto;
  padding: 28rpx 28rpx calc(28rpx + env(safe-area-inset-bottom));
  border-radius: 24rpx 24rpx 0 0;
  background: #fff;
  box-sizing: border-box;
  transform: translateY(40rpx);
  transition: transform 215ms cubic-bezier(0.2, 0, 0.1, 1);
}

.tag-dialog.visible .tag-dialog-panel {
  transform: translateY(0);
}

.wechat-qr-crop-dialog {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 32;
  opacity: 0;
  pointer-events: none;
  transition: opacity 215ms ease-out;
}

.wechat-qr-crop-dialog.visible {
  opacity: 1;
  pointer-events: auto;
}

.wechat-qr-crop-backdrop {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(23, 32, 42, 0.42);
}

.wechat-qr-crop-panel {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  width: 100%;
  display: flex;
  flex-direction: column;
  gap: 22rpx;
  padding: 28rpx 28rpx calc(28rpx + env(safe-area-inset-bottom));
  border-radius: 24rpx 24rpx 0 0;
  background: #ffffff;
  box-shadow: 0 -18rpx 48rpx rgba(23, 32, 42, 0.18);
  box-sizing: border-box;
  transform: translateY(40rpx);
  transition: transform 215ms cubic-bezier(0.2, 0, 0.1, 1);
}

.wechat-qr-crop-dialog.visible .wechat-qr-crop-panel {
  transform: translateY(0);
}

.wechat-qr-crop-stage {
  position: relative;
  align-self: center;
  flex: none;
  overflow: hidden;
  border-radius: 18rpx;
  background: #17202a;
}

.wechat-qr-crop-image {
  position: absolute;
  left: 0;
  top: 0;
  transform-origin: 0 0;
  will-change: transform;
}

.wechat-qr-crop-frame {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  border: 2rpx solid rgba(255, 255, 255, 0.95);
  box-shadow: inset 0 0 0 1rpx rgba(23, 32, 42, 0.22);
  pointer-events: none;
  box-sizing: border-box;
}

.wechat-qr-crop-error {
  color: #d83a3a;
  font-size: 24rpx;
  line-height: 1.4;
}

.wechat-qr-crop-canvas {
  position: fixed;
  left: -9999px;
  top: -9999px;
  opacity: 0;
  pointer-events: none;
}

.tag-error {
  margin-top: 14rpx;
  color: #d83a3a;
  font-size: 24rpx;
  line-height: 1.4;
}

.color-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  margin-top: 14rpx;
}

.color-choice {
  width: 31.3%;
  flex: none;
  min-height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  padding: 0 14rpx;
  overflow: hidden;
  color: #495057;
  font-size: 22rpx;
  font-weight: 500;
  line-height: 1;
  border: 1rpx solid #e9ecef;
  border-radius: 999rpx;
  background: #ffffff;
  box-sizing: border-box;
}

.color-choice.active {
  color: #212529;
  font-weight: 600;
  border-color: #212529;
}

.color-swatch {
  width: 12rpx;
  height: 12rpx;
  flex: none;
  border-radius: 50%;
}

.color-name {
  overflow: hidden;
  font-size: 22rpx;
  font-weight: inherit;
  line-height: 1;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.dialog-actions {
  gap: 16rpx;
  margin-top: 24rpx;
}

.dialog-button {
  flex: 1;
  margin-top: 0;
}

button::after {
  border: 0;
}

@keyframes skeleton-loading {
  0% {
    background-position: 100% 50%;
  }
  100% {
    background-position: 0 50%;
  }
}
