<view class="page-shell works-page">
  <navigation-bar title="作品" back="{{false}}" color="#212529" background="rgba(245, 246, 247, 0.94)"></navigation-bar>

  <view class="works-scroll">
    <view class="works-content" bindtap="handleCloseTagManageMode">
      <view class="search-panel">
        <view class="search-box">
          <view class="search-icon"></view>
          <input
            class="search-input"
            value="{{keyword}}"
            confirm-type="search"
            placeholder="搜索作品标题、标签"
            placeholder-class="search-placeholder"
            bindinput="handleSearchInput"
            bindconfirm="handleSearchConfirm"
          />
          <view class="search-clear" wx:if="{{keyword}}" catchtap="handleClearSearch" aria-role="button" aria-label="清空搜索">
            <text class="search-clear-mark">×</text>
          </view>
        </view>
      </view>

      <view class="filter-panel">
        <view class="filter-shell" catchtap="handleFilterShellTap">
          <scroll-view class="tag-scroll" scroll-x type="list">
            <view class="tag-row">
              <view
                wx:for="{{list.filterTags}}"
                wx:key="id"
                class="tag-pill {{(!selectedTagId && !item.id) || selectedTagId === item.id ? 'active' : ''}} {{tagManageMode && item.id ? 'manage' : ''}}"
                style="{{tagManageMode && item.id ? '' : (((!selectedTagId && !item.id) || selectedTagId === item.id) ? item.activeStyle : item.filterStyle)}}"
                data-id="{{item.id}}"
                bindtap="handleTagTap"
                bindlongpress="handleTagLongPress"
              >
                <view
                  wx:if="{{item.id && (tagManageMode || selectedTagId !== item.id)}}"
                  class="tag-color-dot"
                  style="background: {{item.color}};"
                ></view>
                <text class="tag-text">{{item.labelText}}</text>
                <view
                  wx:if="{{tagManageMode && item.id}}"
                  class="tag-delete"
                  data-id="{{item.id}}"
                  catchtap="handleTagDeleteTap"
                  aria-role="button"
                  aria-label="删除标签{{item.name}}"
                >
                  <text class="tag-delete-mark">×</text>
                </view>
              </view>
            </view>
          </scroll-view>
          <view class="tag-add-button" catchtap="handleOpenCreateTagDialog" aria-role="button" aria-label="新增作品标签">+</view>
        </view>
      </view>

      <view class="library-panel">
        <view class="list-heading">
          <view class="section-title">素材库</view>
          <view class="list-actions">
            <button class="text-action {{batchMode ? 'active' : ''}}" bindtap="handleBatchTap">{{batchMode ? '完成' : '批量管理'}}</button>
            <view class="tag-add-button work-add-button" catchtap="handleAddTap" aria-role="button" aria-label="添加作品">+</view>
          </view>
        </view>

        <view wx:if="{{loading}}" class="component-loading">
          <view class="loading-spinner"></view>
          <view class="loading-copy">作品加载中</view>
        </view>

        <view wx:elif="{{errorMessage}}" class="inline-empty">
          <view class="empty-title small">作品加载失败</view>
          <view class="empty-desc">{{errorMessage}}</view>
          <button class="primary-button compact" bindtap="handleRetry">重试</button>
        </view>

        <block wx:else>
          <view wx:if="{{list.empty}}" class="empty-state">
            <view class="empty-logo-frame">
              <image
                class="empty-logo"
                src="/assets/system/work-logo-100kb.jpg"
                mode="aspectFit"
              ></image>
            </view>
            <view class="empty-title">暂无作品</view>
            <view class="empty-desc">从相册选择图片、视频或动图，整理为可复用的作品素材</view>
          </view>

          <scroll-view
            wx:else
            class="work-list-scroll"
            scroll-y
            type="list"
            bindscrolltolower="handleScrollToLower"
            refresher-enabled="{{true}}"
            refresher-triggered="{{pullDownRefreshing}}"
            bindrefresherrefresh="handlePullDownRefresh"
          >
            <view class="work-list">
              <view
                wx:for="{{list.works}}"
                wx:for-index="workIndex"
                wx:key="id"
                class="work-swipe-row {{revealedWorkId === item.id ? 'revealed' : ''}} {{batchMode ? 'batch-mode' : ''}}"
                data-id="{{item.id}}"
                bindtouchstart="handleWorkTouchStart"
                bindtouchmove="handleWorkTouchMove"
                bindtouchend="handleWorkTouchEnd"
                bindtouchcancel="handleWorkTouchCancel"
              >
                <view class="work-delete-pane">
                  <button
                    class="work-delete-button"
                    loading="{{deletingWorkId === item.id}}"
                    disabled="{{deletingWorkId === item.id}}"
                    data-id="{{item.id}}"
                    catchtap="handleDeleteWorkTap"
                  >删除</button>
                </view>
                <view
                  class="work-card {{item.selected ? 'selected' : ''}}"
                  data-id="{{item.id}}"
                  bindtap="handleWorkTap"
                >
                  <view wx:if="{{batchMode}}" class="work-select {{item.selected ? 'selected' : ''}}">
                    <view class="work-select-dot"></view>
                  </view>
                  <view
                    class="thumb"
                    data-id="{{item.id}}"
                    catchtap="handleWorkPreviewTap"
                    aria-role="button"
                    aria-label="{{item.mediaType === 'VIDEO' ? '播放原视频' : (item.mediaType === 'ANIMATION' ? '查看原动图' : '查看原图')}}"
                  >
                    <image wx:if="{{item.hasCover}}" src="{{item.coverUrl}}" mode="aspectFill"></image>
                    <view wx:else class="thumb-placeholder">{{item.typeText}}</view>
                    <view
                      wx:if="{{item.mediaType === 'VIDEO'}}"
                      class="play-badge"
                      data-id="{{item.id}}"
                      catchtap="handlePlayVideoTap"
                      aria-role="button"
                      aria-label="播放视频"
                    ></view>
                  </view>
                  <view class="work-copy">
                    <view class="work-title">{{item.title}}</view>
                    <view class="work-meta">
                      <text>{{item.typeText}}</text>
                      <text wx:if="{{item.durationText}}"> · {{item.durationText}}</text>
                      <text> / {{item.tagText}}</text>
                      <text> / 长宽比 {{item.aspectRatioText}}</text>
                    </view>
                    <view class="work-status-row">
                      <view class="reference-pill {{item.referenceCount > 0 ? 'used' : ''}}">{{item.referenceText}}</view>
                      <view class="status-badge {{item.auditStatusTone}}">
                        <view class="status-dot"></view>
                        <text>{{item.auditStatusText}}</text>
                      </view>
                    </view>
                    <view wx:if="{{item.showAuditRejectReason}}" class="audit-reject-row">
                      <view class="audit-reject-icon">!</view>
                      <view class="audit-reject-content">
                        <view
                          wx:for="{{item.auditReasons}}"
                          wx:for-item="reason"
                          wx:key="code"
                          class="audit-reject-text"
                        >{{reason.message}}</view>
                        <view class="audit-resubmit-row">
                          <view class="audit-round-text">{{item.auditRoundText}}</view>
                          <button
                            wx:if="{{item.canResubmitAudit}}"
                            class="audit-resubmit-button"
                            loading="{{resubmittingWorkId === item.id}}"
                            disabled="{{resubmittingWorkId === item.id}}"
                            data-id="{{item.id}}"
                            catchtap="handleAuditResubmitTap"
                          >重新审核</button>
                        </view>
                      </view>
                    </view>
                  </view>
                  <view class="card-arrow"></view>
                </view>
              </view>

              <view wx:if="{{loadingMore}}" class="loading-more">加载更多作品</view>
              <view wx:if="{{!list.hasMore && list.works.length > 0}}" class="list-end">已显示全部作品</view>
            </view>
          </scroll-view>
        </block>
      </view>

      <view class="batch-panel" wx:if="{{batchMode && !loading && !errorMessage}}">
        <view class="batch-heading">
          <view class="batch-copy">
            <view class="batch-title">批量动作</view>
            <view class="batch-desc">选择多个作品后可统一删除或调整排序</view>
          </view>
          <view class="batch-heading-actions">
            <view class="batch-count">{{batchSelectedCountText}}</view>
            <button class="batch-select-all" bindtap="handleSelectAllBatchTap">{{batchSelectAllText}}</button>
          </view>
        </view>
        <view class="batch-actions">
          <button class="batch-action danger" loading="{{batchDeleting}}" disabled="{{batchDeleting}}" bindtap="handleBatchDeleteTap">删除</button>
          <button class="batch-action" bindtap="handleOpenSortMode">调整排序</button>
        </view>
      </view>
    </view>
  </view>

  <view class="sort-mode-mask {{sortMode ? 'visible' : ''}}" catchtap="handleCloseSortMode">
    <view class="sort-mode-panel" catchtap="handleEditPanelTap">
      <view class="sort-mode-grabber"></view>
      <view class="sort-mode-heading">
        <view>
          <view class="sort-mode-title">{{sortTitle}}</view>
          <view class="sort-mode-desc">调整完成后保存生效</view>
        </view>
        <view class="sort-mode-count">{{sortWorks.length}} 个</view>
      </view>

      <view wx:if="{{sortLoading}}" class="component-loading compact">
        <view class="loading-spinner"></view>
        <view class="loading-copy">排序列表加载中</view>
      </view>

      <view wx:elif="{{sortErrorText}}" class="inline-empty">
        <view class="empty-title small">排序列表加载失败</view>
        <view class="empty-desc">{{sortErrorText}}</view>
        <button class="primary-button compact" bindtap="handleOpenSortMode">重试</button>
      </view>

      <scroll-view wx:else class="sort-work-scroll" scroll-y="{{!sortDraggingWorkId}}" type="list">
        <view class="sort-work-list">
          <view
            wx:for="{{sortWorks}}"
            wx:for-index="sortIndex"
            wx:key="id"
            class="sort-work-row {{sortDraggingWorkId === item.id ? 'dragging' : ''}}"
            style="{{sortDraggingWorkId === item.id ? sortDragStyle : ''}}"
            data-index="{{sortIndex}}"
            data-id="{{item.id}}"
            bindlongpress="handleSortDragStart"
            bindtouchmove="handleSortDragMove"
            bindtouchend="handleSortDragEnd"
            bindtouchcancel="handleSortDragCancel"
          >
            <view class="sort-work-order">{{sortIndex + 1}}</view>
            <view class="sort-work-thumb">
              <image wx:if="{{item.hasCover}}" src="{{item.coverUrl}}" mode="aspectFill"></image>
              <view wx:else class="thumb-placeholder">{{item.typeText}}</view>
            </view>
            <view class="sort-work-copy">
              <view class="sort-work-title">{{item.title}}</view>
              <view class="sort-work-meta">{{item.typeText}}</view>
            </view>
            <view class="sort-drag-handle" aria-role="button" aria-label="拖动排序">
              <view class="sort-drag-line"></view>
              <view class="sort-drag-line"></view>
              <view class="sort-drag-line"></view>
            </view>
          </view>
        </view>
      </scroll-view>

      <view class="sort-mode-actions">
        <button class="work-edit-cancel" catchtap="handleCloseSortMode" disabled="{{sortSaving}}">取消</button>
        <button class="work-edit-confirm" loading="{{sortSaving}}" catchtap="handleSaveSort" disabled="{{sortSaving || sortLoading}}">保存排序</button>
      </view>
    </view>
  </view>

  <view class="image-preview-mask {{imagePreviewVisible ? 'visible' : ''}}" catchtap="handleCloseImagePreview">
    <view class="image-preview-panel" catchtap="handleImagePreviewPanelTap">
      <view class="image-preview-heading">
        <view class="image-preview-title">{{imagePreview.title}}</view>
        <view class="image-preview-close" catchtap="handleCloseImagePreview" aria-role="button" aria-label="关闭图片">×</view>
      </view>
      <image
        wx:if="{{imagePreviewVisible && imagePreview.src}}"
        class="image-preview-media"
        src="{{imagePreview.src}}"
        webp="{{true}}"
        mode="aspectFit"
      ></image>
    </view>
  </view>

  <view class="video-preview-mask {{videoPreviewVisible ? 'visible' : ''}}" catchtap="handleCloseVideoPreview">
    <view class="video-preview-panel" catchtap="handleVideoPreviewPanelTap">
      <view class="video-preview-heading">
        <view class="video-preview-title">{{videoPreview.title}}</view>
        <view class="video-preview-close" catchtap="handleCloseVideoPreview" aria-role="button" aria-label="关闭视频">×</view>
      </view>
      <video
        id="workPreviewVideo"
        class="video-preview-player"
        src="{{videoPreview.src}}"
        poster="{{videoPreview.poster}}"
        controls="{{true}}"
        autoplay="{{true}}"
        show-center-play-btn="{{true}}"
        enable-progress-gesture="{{true}}"
        object-fit="contain"
      ></video>
    </view>
  </view>

  <view class="tag-dialog {{tagDialogVisible ? 'visible' : ''}}">
    <view class="tag-dialog-backdrop" bindtap="handleCloseTagDialog"></view>
    <view class="tag-dialog-panel" catchtap="handleFilterShellTap">
      <view class="tag-dialog-grabber"></view>
      <view class="tag-dialog-heading">
        <view class="tag-dialog-title">{{tagDialogTitle}}</view>
      </view>

      <view class="tag-field">
        <view class="tag-field-label">标签文字</view>
        <input
          class="tag-input"
          value="{{tagForm.name}}"
          maxlength="10"
          placeholder="输入标签名称"
          placeholder-class="tag-input-placeholder"
          bindinput="handleTagNameInput"
        />
      </view>

      <view class="tag-field">
        <view class="tag-field-label">标签颜色</view>
        <view class="color-grid">
          <view
            wx:for="{{tagColorOptions}}"
            wx:key="color"
            class="color-choice {{tagForm.color === item.color ? 'active' : ''}}"
            data-color="{{item.color}}"
            bindtap="handleSelectTagColor"
          >
            <view class="color-swatch" style="{{item.swatchStyle}}"></view>
            <text>{{item.name}}</text>
          </view>
        </view>
      </view>

      <view wx:if="{{tagErrorText}}" class="tag-error">{{tagErrorText}}</view>

      <view class="tag-dialog-actions">
        <button class="secondary-button" disabled="{{tagSaving}}" bindtap="handleCloseTagDialog">取消</button>
        <button class="dialog-button" loading="{{tagSaving}}" bindtap="handleSaveTag">保存</button>
      </view>
    </view>
  </view>

  <view class="work-edit-mask image-edit-mask {{imageEditSheetVisible ? 'visible' : ''}}" catchtap="handleCloseImageEditor">
    <view class="work-edit-panel image-edit-panel" catchtap="handleEditPanelTap">
      <view class="work-edit-grabber"></view>
      <view class="work-edit-heading">
        <view class="work-edit-title">{{thumbnailCropVisible ? '编辑缩略图' : '编辑图片作品'}}</view>
        <view class="work-edit-type">{{thumbnailCropVisible ? (thumbnailSelectedRatioKey === 'original' ? '原图比例' : thumbnailSelectedRatioKey) : '图片'}}</view>
      </view>

      <scroll-view wx:if="{{!thumbnailCropVisible}}" class="work-edit-scroll image-edit-scroll" scroll-y>
        <view class="work-edit-content">
          <view class="cover-section thumbnail-section">
            <view class="cover-heading">
              <view class="field-label">缩略图</view>
              <view class="thumbnail-state">{{imageEditForm.thumbnailEdited ? '已编辑' : '当前缩略图'}}</view>
            </view>
            <view class="local-cover-panel">
              <image
                wx:if="{{imageEditForm.thumbnailPreviewPath && !thumbnailPreviewRenderFlip}}"
                class="local-cover-preview thumbnail-preview"
                src="{{imageEditForm.thumbnailPreviewPath}}"
                mode="widthFix"
              ></image>
              <image
                wx:elif="{{imageEditForm.thumbnailPreviewPath}}"
                class="local-cover-preview thumbnail-preview"
                src="{{imageEditForm.thumbnailPreviewPath}}"
                mode="widthFix"
              ></image>
              <view wx:else class="work-preview-empty thumbnail-empty">缩略图</view>
              <view class="local-cover-actions">
                <view class="local-cover-copy">
                  <view class="local-cover-title">{{imageEditForm.thumbnailEdited ? '已编辑缩略图' : '列表缩略图'}}</view>
                  <view class="local-cover-desc">{{imageEditForm.thumbnailEdited ? '点完成后覆盖当前缩略图' : '可裁剪原图生成新缩略图'}}</view>
                </view>
                <button
                  class="cover-upload-button compact"
                  bindtap="handleOpenThumbnailCrop"
                  disabled="{{imageEditSaving || thumbnailCropSaving}}"
                >{{imageEditForm.thumbnailEdited ? '重新编辑' : '编辑'}}</button>
              </view>
              <view wx:if="{{imageEditSaving && imageThumbnailUploadProgress > 0}}" class="local-cover-progress">
                <view class="local-cover-progress-fill" style="width: {{imageThumbnailUploadProgress}}%;"></view>
              </view>
            </view>
          </view>

          <view class="field-group">
            <view class="field-heading">
              <view class="field-label">作品标题</view>
              <view class="field-limit">{{imageEditFieldCounters.title}}</view>
            </view>
            <input
              class="text-field"
              value="{{imageEditForm.title}}"
              maxlength="30"
              placeholder="填写作品标题"
              placeholder-class="search-placeholder"
              data-field="title"
              bindinput="handleImageEditInput"
            />
          </view>

          <view class="field-group">
            <view class="field-heading">
              <view class="field-label">作品说明</view>
              <view class="field-limit">{{imageEditFieldCounters.description}}</view>
            </view>
            <textarea
              class="textarea-field"
              value="{{imageEditForm.description}}"
              placeholder="填写作品说明"
              placeholder-class="search-placeholder"
              maxlength="1000"
              data-field="description"
              bindinput="handleImageEditInput"
              auto-height="{{false}}"
            ></textarea>
          </view>

          <view class="edit-tag-section">
            <view class="edit-tag-header">
              <view class="field-label">作品标签</view>
              <view wx:if="{{imageEditForm.tagEditNotice}}" class="edit-tag-note">{{imageEditForm.tagEditNotice}}</view>
            </view>
            <view wx:if="{{imageEditForm.tagOptions.length}}" class="edit-tag-list">
              <view
                wx:for="{{imageEditForm.tagOptions}}"
                wx:key="id"
                class="edit-tag-option {{item.selected ? 'is-selected' : ''}} {{item.locked ? 'is-locked' : ''}}"
                style="{{item.selected ? item.activeStyle : item.style}}"
                data-id="{{item.id}}"
                bindtap="handleImageEditTagToggle"
                aria-role="checkbox"
                aria-checked="{{item.selected}}"
              >
                <view class="edit-tag-checkbox {{item.selected ? 'is-checked' : ''}}">
                  <text wx:if="{{item.selected}}" class="edit-tag-checkmark">✓</text>
                </view>
                <text class="edit-tag-name">{{item.name}}</text>
              </view>
            </view>
            <view wx:else class="edit-tag-empty">暂无作品标签</view>
          </view>

          <view wx:if="{{imageEditErrorText}}" class="edit-error">{{imageEditErrorText}}</view>
        </view>
      </scroll-view>

      <scroll-view wx:else class="work-edit-scroll image-edit-scroll thumbnail-crop-editor" scroll-y>
        <view class="thumbnail-ratio-list">
          <button
            wx:for="{{thumbnailRatioOptions}}"
            wx:key="key"
            class="thumbnail-ratio {{item.key === thumbnailSelectedRatioKey ? 'active' : ''}}"
            data-key="{{item.key}}"
            catchtap="handleSelectThumbnailRatio"
            disabled="{{thumbnailCropSaving}}"
          >{{item.label}}</button>
        </view>

        <view
          wx:if="{{thumbnailCropState}}"
          class="thumbnail-crop-stage"
          style="{{thumbnailCropState.cropBoxStyle}}"
          catchtouchstart="handleThumbnailCropTouchStart"
          catchtouchmove="handleThumbnailCropTouchMove"
          catchtouchend="handleThumbnailCropTouchEnd"
          catchtouchcancel="handleThumbnailCropTouchCancel"
        >
          <image class="thumbnail-crop-image" src="{{thumbnailCropState.imagePath}}" mode="scaleToFill" style="{{thumbnailCropState.imageStyle}}"></image>
          <view class="thumbnail-crop-frame"></view>
        </view>

        <view wx:if="{{thumbnailCropErrorText}}" class="edit-error">{{thumbnailCropErrorText}}</view>
      </scroll-view>

      <view class="work-edit-actions">
        <button wx:if="{{!thumbnailCropVisible}}" class="work-edit-cancel" catchtap="handleCloseImageEditor" disabled="{{imageEditSaving}}">取消</button>
        <button wx:else class="work-edit-cancel" catchtap="handleCloseThumbnailCrop" disabled="{{thumbnailCropSaving}}">取消</button>
        <button wx:if="{{!thumbnailCropVisible}}" class="work-edit-confirm" loading="{{imageEditSaving}}" catchtap="handleConfirmImageEdit" disabled="{{imageEditSaving}}">完成</button>
        <button wx:else class="work-edit-confirm" catchtap="handleApplyThumbnailCrop" loading="{{thumbnailCropSaving}}" disabled="{{thumbnailCropSaving}}">应用裁剪</button>
      </view>
    </view>
  </view>

  <canvas
    id="workThumbnailCropCanvas"
    type="2d"
    class="thumbnail-crop-canvas"
    style="width: {{thumbnailCanvasWidth}}px; height: {{thumbnailCanvasHeight}}px;"
  ></canvas>

  <view class="work-edit-mask video-edit-mask {{videoEditSheetVisible ? 'visible' : ''}}" catchtap="handleCloseVideoEditor">
    <view class="work-edit-panel video-edit-panel" catchtap="handleEditPanelTap">
      <view class="work-edit-grabber"></view>
      <view class="work-edit-heading">
        <view class="work-edit-title">编辑视频作品</view>
        <view class="work-edit-type">视频</view>
      </view>

      <scroll-view class="work-edit-scroll video-edit-scroll" scroll-y>
        <view class="work-edit-content">
          <view class="work-preview">
            <image wx:if="{{videoEditForm.previewPath}}" class="work-preview-media" src="{{videoEditForm.previewPath}}" mode="aspectFill"></image>
            <view wx:else class="work-preview-empty">视频</view>
          </view>

          <view class="field-group">
            <view class="field-heading">
              <view class="field-label">作品标题</view>
              <view class="field-limit">{{videoEditFieldCounters.title}}</view>
            </view>
            <input
              class="text-field"
              value="{{videoEditForm.title}}"
              maxlength="30"
              placeholder="填写作品标题"
              placeholder-class="search-placeholder"
              data-field="title"
              bindinput="handleVideoEditInput"
            />
          </view>

          <view class="field-group">
            <view class="field-heading">
              <view class="field-label">作品说明</view>
              <view class="field-limit">{{videoEditFieldCounters.description}}</view>
            </view>
            <textarea
              class="textarea-field"
              value="{{videoEditForm.description}}"
              placeholder="填写作品说明"
              placeholder-class="search-placeholder"
              maxlength="1000"
              data-field="description"
              bindinput="handleVideoEditInput"
              auto-height="{{false}}"
            ></textarea>
          </view>

          <view class="edit-tag-section">
            <view class="edit-tag-header">
              <view class="field-label">作品标签</view>
              <view wx:if="{{videoEditForm.tagEditNotice}}" class="edit-tag-note">{{videoEditForm.tagEditNotice}}</view>
            </view>
            <view wx:if="{{videoEditForm.tagOptions.length}}" class="edit-tag-list">
              <view
                wx:for="{{videoEditForm.tagOptions}}"
                wx:key="id"
                class="edit-tag-option {{item.selected ? 'is-selected' : ''}} {{item.locked ? 'is-locked' : ''}}"
                style="{{item.selected ? item.activeStyle : item.style}}"
                data-id="{{item.id}}"
                bindtap="handleVideoEditTagToggle"
                aria-role="checkbox"
                aria-checked="{{item.selected}}"
              >
                <view class="edit-tag-checkbox {{item.selected ? 'is-checked' : ''}}">
                  <text wx:if="{{item.selected}}" class="edit-tag-checkmark">✓</text>
                </view>
                <text class="edit-tag-name">{{item.name}}</text>
              </view>
            </view>
            <view wx:else class="edit-tag-empty">暂无作品标签</view>
          </view>

          <view class="cover-section">
            <view class="cover-heading">
              <view class="field-label">视频封面</view>
              <view wx:if="{{videoEditForm.coverEditMode === 'frame'}}" class="cover-time">{{videoFrameTimeText}} / {{videoEditForm.durationText}}</view>
            </view>
            <view wx:if="{{videoEditForm.coverEditMode === ''}}" class="cover-standby">
              <button
                class="cover-export-button"
                bindtap="handleStartVideoCoverEdit"
                loading="{{videoDownloading}}"
                disabled="{{videoEditSaving || videoDownloading || videoFrameExporting}}"
              >选帧修改封面</button>
              <button
                class="cover-upload-button"
                bindtap="handleChooseVideoCoverUpload"
                disabled="{{videoEditSaving || videoDownloading || videoFrameExporting}}"
              >上传封面</button>
            </view>
            <block wx:if="{{videoEditForm.coverEditMode === 'frame'}}">
              <view class="cover-edit-toolbar">
                <view class="cover-edit-time">{{videoFrameTimeText}} / {{videoEditForm.durationText}}</view>
                <button
                  class="cover-use-frame-button"
                  bindtap="handleExportVideoCover"
                  loading="{{videoFrameExporting}}"
                  disabled="{{videoEditSaving || videoDownloading || videoFrameExporting}}"
                >使用当前帧</button>
              </view>
              <video
                id="workCoverVideo"
                class="cover-video"
                src="{{videoEditForm.tempFilePath}}"
                controls
                show-center-play-btn="{{true}}"
                enable-progress-gesture="{{true}}"
                bindloadedmetadata="handleVideoEditMetadata"
                bindtimeupdate="handleVideoEditTimeUpdate"
              ></video>
              <slider
                class="cover-slider"
                min="0"
                max="{{videoEditForm.durationMs}}"
                step="100"
                value="{{videoFrameTimeMs}}"
                bindchanging="handleVideoCoverSliderChanging"
                bindchange="handleVideoCoverSliderChange"
              ></slider>
            </block>
            <view wx:if="{{videoEditForm.coverEditMode === 'local'}}" class="local-cover-panel">
              <image class="local-cover-preview" src="{{videoEditForm.localCoverPath}}" mode="aspectFill"></image>
              <view class="local-cover-actions">
                <view class="local-cover-copy">
                  <view class="local-cover-title">已选择本地封面</view>
                  <view class="local-cover-desc">点完成后上传并替换当前封面</view>
                </view>
                <button
                  class="cover-upload-button compact"
                  bindtap="handleChooseVideoCoverUpload"
                  disabled="{{videoEditSaving || videoDownloading || videoFrameExporting}}"
                >重新选择</button>
              </view>
              <view wx:if="{{videoEditSaving && videoCoverUploadProgress > 0}}" class="local-cover-progress">
                <view class="local-cover-progress-fill" style="width: {{videoCoverUploadProgress}}%;"></view>
              </view>
            </view>
          </view>

          <view wx:if="{{videoEditErrorText}}" class="edit-error">{{videoEditErrorText}}</view>
        </view>
      </scroll-view>

      <view class="work-edit-actions">
        <button class="work-edit-cancel" catchtap="handleCloseVideoEditor" disabled="{{videoEditSaving || videoDownloading || videoFrameExporting}}">取消</button>
        <button class="work-edit-confirm" loading="{{videoEditSaving}}" catchtap="handleConfirmVideoEdit" disabled="{{videoEditSaving || videoDownloading || videoFrameExporting}}">完成</button>
      </view>
    </view>
  </view>

  <view class="work-edit-mask animation-edit-mask {{animationEditSheetVisible ? 'visible' : ''}}" catchtap="handleCloseAnimationEditor">
    <view class="work-edit-panel animation-edit-panel" catchtap="handleEditPanelTap">
      <view class="work-edit-grabber"></view>
      <view class="work-edit-heading">
        <view class="work-edit-title">编辑动图作品</view>
        <view class="work-edit-type">动图</view>
      </view>

      <scroll-view class="work-edit-scroll animation-edit-scroll" scroll-y>
        <view class="work-edit-content">
          <view class="cover-section animation-cover-section">
            <view class="cover-heading">
              <view class="field-label">动图封面</view>
              <view class="cover-time">第 {{animationEditForm.coverEdit.selectedFrame}} / {{animationEditForm.coverEdit.frameCount}} 帧</view>
            </view>
            <view class="work-preview animation-frame-preview">
              <image
                wx:if="{{animationEditForm.coverEdit.previewUrl}}"
                class="work-preview-media"
                src="{{animationEditForm.coverEdit.previewUrl}}"
                mode="aspectFit"
              ></image>
              <view wx:else class="work-preview-empty">动图帧</view>
            </view>
            <slider
              class="cover-slider"
              min="1"
              max="{{animationEditForm.coverEdit.frameCount}}"
              step="1"
              value="{{animationEditForm.coverEdit.selectedFrame}}"
              bindchanging="handleAnimationCoverSliderChanging"
              bindchange="handleAnimationCoverSliderChange"
            ></slider>
            <view class="animation-cover-toolbar">
              <view class="animation-cover-state">
                <text wx:if="{{animationEditForm.coverFrameSelected}}">当前帧将在完成后成为新封面</text>
                <text wx:else>滑动选择帧后，点击使用当前帧</text>
              </view>
              <button
                class="cover-use-frame-button"
                bindtap="handleUseAnimationCoverFrame"
                disabled="{{animationEditSaving}}"
              >使用当前帧</button>
            </view>
          </view>

          <view class="field-group">
            <view class="field-heading">
              <view class="field-label">作品标题</view>
              <view class="field-limit">{{animationEditFieldCounters.title}}</view>
            </view>
            <input
              class="text-field"
              value="{{animationEditForm.title}}"
              maxlength="30"
              placeholder="填写作品标题"
              placeholder-class="search-placeholder"
              data-field="title"
              bindinput="handleAnimationEditInput"
            />
          </view>

          <view class="field-group">
            <view class="field-heading">
              <view class="field-label">作品说明</view>
              <view class="field-limit">{{animationEditFieldCounters.description}}</view>
            </view>
            <textarea
              class="textarea-field"
              value="{{animationEditForm.description}}"
              placeholder="填写作品说明"
              placeholder-class="search-placeholder"
              maxlength="1000"
              data-field="description"
              bindinput="handleAnimationEditInput"
              auto-height="{{false}}"
            ></textarea>
          </view>

          <view class="edit-tag-section">
            <view class="edit-tag-header">
              <view class="field-label">作品标签</view>
              <view wx:if="{{animationEditForm.tagEditNotice}}" class="edit-tag-note">{{animationEditForm.tagEditNotice}}</view>
            </view>
            <view wx:if="{{animationEditForm.tagOptions.length}}" class="edit-tag-list">
              <view
                wx:for="{{animationEditForm.tagOptions}}"
                wx:key="id"
                class="edit-tag-option {{item.selected ? 'is-selected' : ''}} {{item.locked ? 'is-locked' : ''}}"
                style="{{item.selected ? item.activeStyle : item.style}}"
                data-id="{{item.id}}"
                bindtap="handleAnimationEditTagToggle"
                aria-role="checkbox"
                aria-checked="{{item.selected}}"
              >
                <view class="edit-tag-checkbox {{item.selected ? 'is-checked' : ''}}">
                  <text wx:if="{{item.selected}}" class="edit-tag-checkmark">✓</text>
                </view>
                <text class="edit-tag-name">{{item.name}}</text>
              </view>
            </view>
            <view wx:else class="edit-tag-empty">暂无作品标签</view>
          </view>

          <view wx:if="{{animationEditErrorText}}" class="edit-error">{{animationEditErrorText}}</view>
        </view>
      </scroll-view>

      <view class="work-edit-actions">
        <button class="work-edit-cancel" catchtap="handleCloseAnimationEditor" disabled="{{animationEditSaving}}">取消</button>
        <button class="work-edit-confirm" loading="{{animationEditSaving}}" catchtap="handleConfirmAnimationEdit" disabled="{{animationEditSaving}}">完成</button>
      </view>
    </view>
  </view>

  <view class="tabbar">
    <button
      wx:for="{{tabs}}"
      wx:key="key"
      class="tab {{item.active ? 'active' : ''}}"
      data-label="{{item.label}}"
      bindtap="handleTabTap"
    >
      <view class="tab-icon-wrap">
        <image class="tab-icon-image" src="/assets/system/tabbar/{{item.icon}}{{item.active ? '-active' : ''}}.svg" mode="aspectFit"></image>
      </view>
      <view class="tab-label">{{item.label}}</view>
    </button>
  </view>
</view>
