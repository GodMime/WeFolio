.work-add-page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  background-color: #f5f6f7;
}

.work-add-scroll {
  flex: 1;
  min-height: 0;
}

.work-add-content {
  width: 100%;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  padding: 20rpx 32rpx calc(32rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.upload-box {
  width: 100%;
  min-width: 100%;
  max-width: 100%;
  align-self: stretch;
  min-height: 284rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 14rpx;
  margin: 0;
  padding: 32rpx;
  border: 2rpx dashed #ced4da;
  border-radius: 48rpx;
  background: #ffffff;
  box-shadow: 0 12rpx 36rpx rgba(33, 37, 41, 0.05);
  box-sizing: border-box;
}

.upload-plus {
  width: 84rpx;
  height: 84rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #212529;
  font-size: 52rpx;
  line-height: 1;
  font-weight: 900;
  border-radius: 50%;
  background: #f1f3f5;
  box-shadow: 0 6rpx 24rpx rgba(17, 24, 39, 0.05);
}

.upload-title,
.empty-title {
  color: #212529;
  font-size: 31rpx;
  line-height: 1.24;
  font-weight: 800;
}

.upload-desc,
.empty-desc,
.selected-work-meta,
.tag-note {
  color: #868e96;
  font-size: 24rpx;
  line-height: 1.55;
}

.selected-panel {
  width: 100%;
  min-width: 100%;
  max-width: 100%;
  align-self: stretch;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  padding: 28rpx;
  border: 1rpx solid rgba(33, 37, 41, 0.05);
  border-radius: 48rpx;
  background: #ffffff;
  box-shadow: 0 12rpx 36rpx rgba(33, 37, 41, 0.05);
  box-sizing: border-box;
  overflow: hidden;
}

.panel-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.panel-title {
  flex: 1;
  min-width: 0;
  color: #111827;
  font-size: 34rpx;
  line-height: 1.24;
  font-weight: 800;
}

.selected-count {
  min-height: 50rpx;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 0 20rpx;
  color: #536b82;
  font-size: 24rpx;
  font-weight: 800;
  border: 1rpx solid #cbd6df;
  border-radius: 999rpx;
  background: #eef3f7;
  white-space: nowrap;
}

.selected-work-list {
  height: 528rpx;
  max-height: 528rpx;
  overflow: hidden;
}

.selected-work-list.count-1 {
  height: 160rpx;
}

.selected-work-list.count-2 {
  height: 336rpx;
}

.selected-work-list.count-3 {
  height: 512rpx;
}

.selected-work-list-content {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  padding-right: 2rpx;
}

.selected-work-swipe-row {
  position: relative;
  overflow: hidden;
  border-radius: 16rpx;
}

.selected-work-row {
  position: relative;
  z-index: 2;
  min-height: 128rpx;
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 16rpx;
  border: 1rpx solid #d7dee5;
  border-radius: 16rpx;
  background: #fcfdfd;
  box-shadow: 0 6rpx 24rpx rgba(17, 24, 39, 0.05);
  box-sizing: border-box;
  transition: transform 180ms ease;
}

.selected-work-swipe-row.revealed .selected-work-row {
  transform: translateX(-140rpx);
}

.selected-work-remove-pane {
  position: absolute;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 1;
  width: 128rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.selected-work-remove-button {
  width: 108rpx;
  min-width: 108rpx;
  height: 64rpx;
  min-height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0;
  padding: 0;
  color: #b42318;
  font-size: 22rpx;
  font-weight: 800;
  line-height: 64rpx;
  border-radius: 14rpx;
  background: #fee4e2;
  box-sizing: border-box;
}

.selected-work-thumb {
  position: relative;
  width: 112rpx;
  height: 92rpx;
  overflow: hidden;
  border: 1rpx solid rgba(17, 24, 39, 0.06);
  border-radius: 14rpx;
  background: #d7dee5;
  box-shadow: 0 6rpx 24rpx rgba(17, 24, 39, 0.05);
}

.selected-work-thumb image,
.video-thumb {
  width: 100%;
  height: 100%;
}

.video-thumb {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #66727f;
  font-size: 24rpx;
  font-weight: 800;
  background: #eef3f7;
}

.play-badge {
  position: absolute;
  right: 10rpx;
  bottom: 10rpx;
  width: 44rpx;
  height: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #111827;
  font-size: 18rpx;
  font-weight: 900;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.92);
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.18);
}

.selected-work-copy {
  flex: 1 1 0;
  min-width: 0;
}

.selected-work-title {
  color: #111827;
  font-size: 31rpx;
  line-height: 1.25;
  font-weight: 800;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.selected-work-meta {
  margin-top: 4rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.selected-work-progress {
  width: 100%;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  margin-top: 12rpx;
  min-width: 0;
}

.selected-work-progress-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  color: #66727f;
  font-size: 20rpx;
  line-height: 1.2;
  font-weight: 700;
}

.selected-work-progress-track {
  width: 100%;
  height: 8rpx;
  overflow: hidden;
  border-radius: 999rpx;
  background: #e6ebf0;
}

.selected-work-progress-fill {
  height: 100%;
  border-radius: 999rpx;
  background: #212529;
  transition: width 160ms ease;
}

.selected-work-arrow {
  width: 28rpx;
  flex: none;
  color: #111827;
  font-size: 40rpx;
  line-height: 1;
  font-weight: 800;
  text-align: right;
}

.tag-panel {
  width: 100%;
  min-width: 100%;
  max-width: 100%;
  display: flex;
  flex-direction: column;
  padding: 28rpx;
  border: 1rpx solid rgba(33, 37, 41, 0.05);
  border-radius: 48rpx;
  background: #ffffff;
  box-shadow: 0 6rpx 24rpx rgba(17, 24, 39, 0.05);
  box-sizing: border-box;
}

.tag-label {
  color: #66727f;
  font-size: 24rpx;
  font-weight: 800;
}

.tag-row {
  margin-top: 12rpx;
  display: flex;
  flex-wrap: wrap;
  align-items: flex-start;
  justify-content: flex-start;
  gap: 12rpx;
}

.tag-chip,
.tag-add-trigger {
  height: 50rpx;
  min-height: 50rpx;
  display: inline-flex;
  align-items: center;
  border: 1rpx solid #d7dee5;
  border-radius: 999rpx;
  background: #f4f7f8;
  box-sizing: border-box;
}

.tag-chip {
  padding: 0 18rpx;
  color: #111827;
  font-size: 22rpx;
  font-weight: 800;
  white-space: nowrap;
}

.tag-chip.teal {
  color: #536b82;
  border-color: #cbd6df;
  background: #eef3f7;
}

.tag-chip.blue {
  color: #315f9d;
  border-color: #bdd5ff;
  background: #e8effa;
}

.tag-add-trigger {
  width: auto;
  height: 50rpx;
  min-width: 0;
  flex: 0 0 auto;
  align-self: flex-start;
  padding: 0 22rpx;
  color: #111827;
  font-size: 22rpx;
  font-weight: 800;
  background: #f8fafb;
  white-space: nowrap;
}

.tag-note {
  margin-top: 16rpx;
  padding: 18rpx 20rpx;
  border: 1rpx solid #d7dee5;
  border-radius: 16rpx;
  background: #f8fafb;
}

.tag-note.muted {
  color: #7b8794;
  background: #f4f7f8;
}

.empty-state {
  width: 100%;
  min-width: 100%;
  max-width: 100%;
  padding: 64rpx 32rpx;
  border: 1rpx solid rgba(33, 37, 41, 0.05);
  border-radius: 48rpx;
  background: #ffffff;
  text-align: center;
  box-shadow: 0 6rpx 24rpx rgba(17, 24, 39, 0.05);
  box-sizing: border-box;
}

.empty-desc {
  margin-top: 12rpx;
}

.error-copy {
  color: #b55656;
  font-size: 24rpx;
  line-height: 1.55;
}

.primary-button {
  width: 100%;
  min-width: 100%;
  max-width: 100%;
  align-self: stretch;
  height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0;
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 800;
  border-radius: 999rpx;
  background: #212529;
  box-shadow: 0 16rpx 32rpx rgba(33, 37, 41, 0.16);
  box-sizing: border-box;
}

.primary-button[disabled] {
  color: rgba(255, 255, 255, 0.62);
  background: #6c757d;
  box-shadow: 0 12rpx 28rpx rgba(17, 24, 39, 0.12);
}

.primary-button.empty-disabled {
  color: #5f6b78;
  border: 1rpx solid #d7dee5;
  background: #e6ebf0;
  box-shadow: none;
}

.primary-button-content {
  width: 100%;
  min-width: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
}

.primary-button-label {
  line-height: 1.2;
}

.primary-button-progress {
  width: 240rpx;
  height: 8rpx;
  overflow: hidden;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.2);
}

.primary-button-progress-fill {
  height: 100%;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.78);
  transition: width 160ms ease;
}

.tag-picker-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 20;
  display: flex;
  align-items: flex-end;
  padding: 0;
  opacity: 0;
  pointer-events: none;
  background: rgba(17, 24, 39, 0.35);
  transition: opacity 225ms ease-out;
  box-sizing: border-box;
}

.tag-picker-mask.visible {
  opacity: 1;
  pointer-events: auto;
}

.tag-picker-panel {
  width: 100%;
  max-height: 72vh;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  padding: 24rpx 32rpx calc(32rpx + env(safe-area-inset-bottom));
  border: 0;
  border-radius: 56rpx 56rpx 0 0;
  background: #ffffff;
  box-shadow: 0 -20rpx 48rpx rgba(17, 24, 39, 0.18);
  box-sizing: border-box;
  transform: translateY(36rpx);
  transition: transform 225ms cubic-bezier(0.2, 0, 0.1, 1);
}

.tag-picker-mask.visible .tag-picker-panel {
  transform: translateY(0);
}

.tag-picker-grabber {
  width: 72rpx;
  height: 8rpx;
  align-self: center;
  border-radius: 999rpx;
  background: #cbd6df;
}

.tag-picker-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.tag-picker-title {
  flex: 1;
  min-width: 0;
  color: #111827;
  font-size: 30rpx;
  line-height: 1.25;
  font-weight: 800;
}

.tag-picker-count {
  min-height: 48rpx;
  display: inline-flex;
  align-items: center;
  padding: 0 18rpx;
  color: #536b82;
  font-size: 22rpx;
  font-weight: 800;
  border: 1rpx solid #cbd6df;
  border-radius: 999rpx;
  background: #eef3f7;
  white-space: nowrap;
}

.tag-picker-state {
  min-height: 180rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  color: #66727f;
  font-size: 24rpx;
  line-height: 1.5;
  border: 1rpx solid #d7dee5;
  border-radius: 16rpx;
  background: #f8fafb;
  text-align: center;
}

.tag-picker-state.error {
  color: #b84762;
}

.tag-picker-retry {
  min-height: 48rpx;
  display: inline-flex;
  align-items: center;
  padding: 0 20rpx;
  color: #111827;
  font-size: 22rpx;
  font-weight: 800;
  border: 1rpx solid #d7dee5;
  border-radius: 999rpx;
  background: #ffffff;
}

.tag-option-list {
  max-height: 520rpx;
  flex: none;
  overflow: hidden;
}

.tag-option-list-content {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  padding: 2rpx;
}

.tag-option {
  width: auto;
  min-width: 0;
  max-width: 100%;
  height: 50rpx;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 auto;
  gap: 8rpx;
  padding: 0 20rpx;
  overflow: hidden;
  border: 1rpx solid #d4dee8;
  border-radius: 999rpx;
  background: #ffffff;
  box-sizing: border-box;
}

.tag-option-dot {
  width: 12rpx;
  height: 12rpx;
  flex: none;
  border-radius: 50%;
}

.tag-option-name {
  flex: none;
  max-width: 360rpx;
  overflow: hidden;
  color: inherit;
  font-size: 24rpx;
  font-weight: 800;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.tag-option-check {
  flex: none;
  color: inherit;
  font-size: 24rpx;
  font-weight: 900;
  line-height: 1;
}

.tag-picker-actions {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  flex: none;
  gap: 16rpx;
}

.tag-picker-clear,
.tag-picker-confirm {
  min-width: 156rpx;
  height: 72rpx;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  margin: 0;
  padding: 0 28rpx;
  font-size: 26rpx;
  font-weight: 800;
  border-radius: 14rpx;
  box-sizing: border-box;
}

.tag-picker-clear {
  color: #536b82;
  border: 1rpx solid #d7dee5;
  background: #f8fafb;
}

.tag-picker-confirm {
  color: #ffffff;
  background: linear-gradient(180deg, #263445, #111827);
  box-shadow: 0 12rpx 28rpx rgba(17, 24, 39, 0.16);
}

.work-edit-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 30;
  display: flex;
  align-items: flex-end;
  padding: 0;
  opacity: 0;
  pointer-events: none;
  background: rgba(17, 24, 39, 0.38);
  transition: opacity 235ms ease;
  box-sizing: border-box;
}

.work-edit-mask.visible {
  opacity: 1;
  pointer-events: auto;
}

.work-edit-panel {
  width: 100%;
  height: calc(84vh - env(safe-area-inset-bottom));
  max-height: calc(84vh - env(safe-area-inset-bottom));
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  padding: 24rpx 32rpx calc(32rpx + env(safe-area-inset-bottom));
  border: 0;
  border-radius: 56rpx 56rpx 0 0;
  background: #ffffff;
  box-shadow: 0 -20rpx 48rpx rgba(17, 24, 39, 0.18);
  box-sizing: border-box;
  transform: translateY(46rpx);
  transition: transform 235ms cubic-bezier(0.18, 0, 0.08, 1);
}

.work-edit-mask.visible .work-edit-panel {
  transform: translateY(0);
}

.work-edit-grabber {
  width: 72rpx;
  height: 8rpx;
  align-self: center;
  border-radius: 999rpx;
  background: #cbd6df;
}

.work-edit-heading,
.cover-heading,
.work-edit-actions {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.work-edit-title {
  flex: 1;
  min-width: 0;
  color: #111827;
  font-size: 30rpx;
  line-height: 1.25;
  font-weight: 800;
}

.work-edit-type,
.cover-time {
  flex: none;
  color: #536b82;
  font-size: 22rpx;
  font-weight: 800;
}

.work-edit-scroll {
  flex: 1 1 auto;
  height: 0;
  min-height: 0;
}

.image-edit-mask .work-edit-panel {
  height: auto;
  max-height: calc(78vh - env(safe-area-inset-bottom));
}

.image-edit-mask .work-edit-scroll {
  flex: 0 1 auto;
  height: auto;
  max-height: calc(78vh - 176rpx - env(safe-area-inset-bottom));
}

.work-edit-content {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
  padding-bottom: 8rpx;
}

.work-preview {
  width: 100%;
  height: 300rpx;
  overflow: hidden;
  border: 1rpx solid #d7dee5;
  border-radius: 16rpx;
  background: #eef3f7;
  box-sizing: border-box;
}

.work-preview-media,
.work-preview-empty {
  width: 100%;
  height: 100%;
}

.work-preview-empty {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #66727f;
  font-size: 26rpx;
  font-weight: 800;
}

.field-group,
.cover-section {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.field-label {
  color: #66727f;
  font-size: 24rpx;
  line-height: 1.3;
  font-weight: 800;
}

.text-field,
.textarea-field {
  width: 100%;
  min-width: 100%;
  max-width: 100%;
  color: #111827;
  font-size: 26rpx;
  line-height: 1.5;
  border: 1rpx solid #d7dee5;
  border-radius: 16rpx;
  background: #f8fafb;
  box-sizing: border-box;
}

.text-field {
  height: 76rpx;
  padding: 0 20rpx;
}

.textarea-field {
  height: 184rpx;
  padding: 18rpx 20rpx;
}

.cover-video {
  width: 100%;
  height: 300rpx;
  overflow: hidden;
  border-radius: 16rpx;
  background: #111827;
}

.cover-slider {
  min-width: 0;
}

.cover-edit-toolbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 14rpx;
  width: 100%;
  padding: 14rpx 16rpx;
  border: 1rpx solid #d7dee5;
  border-radius: 14rpx;
  background: #f8fafb;
  box-sizing: border-box;
}

.cover-edit-time {
  flex: 1 1 auto;
  min-width: 0;
  color: #536b82;
  font-size: 23rpx;
  font-weight: 800;
  line-height: 1.3;
}

.cover-use-frame-button {
  min-width: 176rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 auto;
  margin: 0;
  padding: 0 20rpx;
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 900;
  line-height: 1;
  border-radius: 14rpx;
  background: #17202a;
  box-sizing: border-box;
}

.cover-export-button {
  width: 100%;
  min-width: 100%;
  max-width: 100%;
  height: 76rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0;
  color: #17202a;
  font-size: 25rpx;
  font-weight: 800;
  border: 1rpx solid #cbd6df;
  border-radius: 14rpx;
  background: #eef3f7;
  box-sizing: border-box;
}

.edit-error {
  color: #b84762;
  font-size: 24rpx;
  line-height: 1.5;
}

.work-edit-cancel,
.work-edit-confirm {
  min-width: 156rpx;
  height: 72rpx;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  margin: 0;
  padding: 0 28rpx;
  font-size: 26rpx;
  font-weight: 800;
  border-radius: 14rpx;
  box-sizing: border-box;
}

.work-edit-cancel {
  color: #536b82;
  border: 1rpx solid #d7dee5;
  background: #f8fafb;
}

.work-edit-confirm {
  color: #ffffff;
  background: linear-gradient(180deg, #263445, #111827);
  box-shadow: 0 12rpx 28rpx rgba(17, 24, 39, 0.16);
}
