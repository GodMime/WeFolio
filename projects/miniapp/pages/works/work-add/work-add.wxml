<view class="page-shell work-add-page">
  <view class="work-add-navigation">
    <navigation-bar title="添加作品" color="#212529" background="rgba(245, 246, 247, 0.94)"></navigation-bar>
  </view>

  <view class="work-add-content">
    <view class="upload-entry-list">
      <view class="upload-box" bindtap="handleChooseMedia" aria-role="button" aria-disabled="{{saving || choosing}}" aria-label="选择图片、视频或动图">
        <view class="upload-plus {{saving || choosing ? 'is-disabled' : ''}}">+</view>
        <view class="upload-copy">
          <view class="upload-title {{saving || choosing ? 'is-disabled' : ''}}">选择图片、视频或动图</view>
          <view class="upload-desc">
            <view>一次最多勾选 9 个</view>
            <view>标题默认使用文件名</view>
          </view>
        </view>
      </view>

      <view class="upload-box" data-media-type="AUDIO" bindtap="handleChooseMedia" aria-role="button" aria-disabled="{{saving || choosing}}" aria-label="选择音频作品">
        <view class="upload-plus {{saving || choosing ? 'is-disabled' : ''}}">+</view>
        <view class="upload-copy">
          <view class="upload-title {{saving || choosing ? 'is-disabled' : ''}}">选择音频作品</view>
          <view class="upload-desc">
            <view>从聊天文件选择 MP3、M4A、AAC、WAV</view>
            <view>不超过 50MB、10 分钟</view>
          </view>
        </view>
      </view>
    </view>

    <view class="selected-panel">
      <view class="panel-heading">
        <view class="panel-title">{{choosing && files.length === 0 ? '正在处理作品' : '已选作品'}}</view>
        <view wx:if="{{choosing && files.length === 0}}" class="selected-count">{{choosingCountText}}</view>
        <view wx:else class="selected-count">{{files.length}} / 9</view>
      </view>
      <scroll-view class="selected-work-list" scroll-y type="list" scroll-into-view="{{choosing || saving ? 'selected-work-list-start' : ''}}">
        <view id="selected-work-list-start" class="selected-work-list-content">
          <view wx:if="{{choosing || (preparationCancelled && !saving)}}" class="compression-state">
            <view class="compression-state-main">
              <view wx:if="{{choosing}}" class="compression-icon" aria-hidden="true">
                <view class="compression-spinner"></view>
              </view>
              <view class="compression-state-copy">
                <view class="compression-state-title">{{choosing ? choosingTitle : '已取消处理'}}</view>
                <view class="compression-state-meta">{{choosing ? (files.length > 0 ? choosingCountText + ' · 请稍候' : choosingHint) : (files.length > 0 ? '原已选作品已保留' : '可重新选择作品')}}</view>
              </view>
              <view wx:if="{{canCancelPreparation && !saving}}" class="compression-cancel" bindtap="handleCancelPreparation" aria-role="button" aria-label="取消处理">{{cancelPreparationText}}</view>
            </view>
            <view class="compression-state-note">{{choosing ? (files.length > 0 ? '处理完成后，新作品将加入下方列表。' : '处理完成后，作品将显示在这里。') : (files.length > 0 ? '可以继续添加，或保存已选作品。' : '点击上方入口，重新选择要添加的作品。')}}</view>
          </view>
          <view wx:if="{{errorMessage}}" class="error-copy">{{errorMessage}}</view>
          <view wx:if="{{files.length === 0 && !choosing && !preparationCancelled}}" class="empty-state">
            <view class="empty-title">尚未选择作品</view>
            <view class="empty-desc">图片、视频和动图从相册选择，音频从聊天文件选择。</view>
          </view>
          <view
            wx:for="{{files}}"
            wx:key="id"
            class="selected-work-swipe-row {{revealedFileId === item.id ? 'revealed' : ''}}"
            data-id="{{item.id}}"
            bindtouchstart="handleFileTouchStart"
            bindtouchmove="handleFileTouchMove"
            bindtouchend="handleFileTouchEnd"
            bindtouchcancel="handleFileTouchCancel"
          >
            <view class="selected-work-remove-pane" catchtap="handleEditPanelTap">
              <button class="selected-work-remove-button" disabled="{{saving || choosing}}" data-index="{{index}}" catchtap="handleRemoveFile">移除</button>
            </view>
            <view class="selected-work-row" data-index="{{index}}" bindtap="handleOpenFileEditor">
              <view class="selected-work-summary">
                <view class="selected-work-thumb {{item.isVideo ? 'video' : ''}}">
                  <image wx:if="{{item.mediaType === 'IMAGE'}}" src="{{item.tempFilePath}}" mode="aspectFill"></image>
                  <image wx:elif="{{item.mediaType === 'ANIMATION'}}" src="{{item.tempFilePath}}" mode="aspectFill" webp="{{item.mimeType === 'image/webp'}}"></image>
                  <image wx:elif="{{item.mediaType === 'AUDIO'}}" src="{{item.audioCoverUrl}}" mode="aspectFill"></image>
                  <image wx:elif="{{item.coverPath}}" src="{{item.coverPath}}" mode="aspectFill"></image>
                  <view wx:else class="video-thumb">视频</view>
                  <view wx:if="{{item.isVideo}}" class="play-badge">▶</view>
                  <view wx:if="{{item.isAnimation}}" class="animation-badge">动图</view>
                </view>
                <view class="selected-work-copy">
                  <view class="selected-work-title">{{item.title || item.fileName}}</view>
                  <view class="selected-work-meta">{{item.metaText}}</view>
                  <view wx:if="{{item.compressed}}" class="selected-work-compression">{{item.compressionText}}</view>
                </view>
                <view class="selected-work-arrow">›</view>
              </view>
              <view
                wx:if="{{saving && (item.status === 'UPLOADING' || item.status === 'UPLOADED' || item.customCoverStatus === 'UPLOADING' || item.customCoverStatus === 'UPLOADED')}}"
                class="selected-work-progress"
              >
                <view class="selected-work-progress-head">
                  <view>{{item.customCoverStatus === 'UPLOADING' ? '处理封面' : item.customCoverStatus === 'UPLOADED' ? '封面已上传' : item.status === 'UPLOADED' ? '文件已上传' : '上传中'}}</view>
                  <view>{{item.customCoverStatus === 'UPLOADING' || item.customCoverStatus === 'UPLOADED' ? item.customCoverProgress : item.progress || 0}}%</view>
                </view>
                <view class="selected-work-progress-track">
                  <view class="selected-work-progress-fill" style="width: {{item.customCoverStatus === 'UPLOADING' || item.customCoverStatus === 'UPLOADED' ? item.customCoverProgress : item.progress || 0}}%;"></view>
                </view>
              </view>
              <view wx:if="{{!saving}}" class="selected-work-ready">已准备好，可以保存</view>
            </view>
          </view>
        </view>
      </scroll-view>
    </view>
  </view>

  <view class="work-add-footer">
    <view class="tag-panel">
      <view class="tag-label">统一标签（可选）</view>
      <view class="tag-row">
        <scroll-view wx:if="{{unifiedTags.length > 0}}" class="tag-selected-scroll" scroll-x type="list">
          <view class="tag-selected-list">
            <view wx:for="{{unifiedTags}}" wx:key="id" class="tag-chip" style="{{item.style}}">{{item.name}}</view>
          </view>
        </scroll-view>
        <view class="tag-add-trigger {{saving || choosing ? 'is-disabled' : ''}}" catchtap="handleOpenTagPicker" aria-role="button" aria-disabled="{{saving || choosing}}" aria-label="添加统一作品标签">+添加</view>
      </view>
      <view class="tag-note" wx:if="{{files.length > 0}}">
        <view>选中的标签应用到本次 {{files.length}} 个作品</view>
        <view>作品说明可保存后补充</view>
      </view>
      <view class="tag-note muted" wx:else>
        <view>{{choosing ? '选中的标签将在处理完成后应用' : '可先选择统一标签，添加后自动应用'}}</view>
        <view>作品说明可保存后补充</view>
      </view>
    </view>

    <view class="primary-button {{files.length === 0 || choosing ? 'empty-disabled' : ''}} {{saving ? 'is-saving' : ''}}" aria-role="button" aria-disabled="{{saving || choosing}}" bindtap="handleSubmit">
      <view class="primary-button-content">
        <view class="primary-button-label">{{saving ? uploadOverallText : choosing ? '处理完成后可保存' : '保存作品'}}</view>
        <view wx:if="{{saving}}" class="primary-button-progress">
          <view class="primary-button-progress-fill" style="width: {{uploadOverallProgress}}%;"></view>
        </view>
      </view>
    </view>
  </view>

  <view class="tag-picker-mask {{tagPickerVisible ? 'visible' : ''}}" catchtap="handleCloseTagPicker">
    <view class="tag-picker-panel" catchtap="handleTagPickerPanelTap">
      <view class="tag-picker-grabber"></view>
      <view class="tag-picker-heading">
        <view class="tag-picker-title">选择作品标签</view>
        <view class="tag-picker-count">{{selectedUnifiedTagCount}} 个已选</view>
      </view>

      <view wx:if="{{tagLoading}}" class="tag-picker-state">加载中...</view>
      <view wx:elif="{{tagErrorText}}" class="tag-picker-state error">
        <view>{{tagErrorText}}</view>
        <view class="tag-picker-retry" catchtap="handleRetryLoadTags" aria-role="button" aria-label="重新加载作品标签">重试</view>
      </view>
      <view wx:elif="{{tagPickerTags.length === 0}}" class="tag-picker-state">暂无作品标签</view>
      <scroll-view wx:else class="tag-option-list" style="height: {{tagOptionListHeight}}rpx;" scroll-y type="list">
        <view class="tag-option-list-content">
          <view
            wx:for="{{tagPickerTags}}"
            wx:key="id"
            class="tag-option {{item.selected ? 'selected' : ''}}"
            style="{{item.selected ? item.activeStyle : item.filterStyle}}"
            data-id="{{item.id}}"
            catchtap="handleToggleUnifiedTag"
            aria-role="checkbox"
            aria-checked="{{item.selected}}"
            aria-label="选择{{item.name}}标签"
          >
            <view
              class="tag-option-dot"
              style="background: {{item.selected ? '#ffffff' : item.color}};"
            ></view>
            <view class="tag-option-name" style="color: {{item.selected ? '#ffffff' : item.color}};">{{item.name}}</view>
            <view wx:if="{{item.selected}}" class="tag-option-check">✓</view>
          </view>
        </view>
      </scroll-view>

      <view class="tag-picker-actions">
        <button class="tag-picker-clear" catchtap="handleClearUnifiedTags" disabled="{{tagLoading || saving || choosing}}">清空</button>
        <button class="tag-picker-confirm" catchtap="handleConfirmTagPicker" disabled="{{tagLoading || saving || choosing}}">完成</button>
      </view>
    </view>
  </view>

  <view class="work-edit-mask {{editForm.isVideo ? 'video-edit-mask' : 'image-edit-mask'}} {{editSheetVisible ? 'visible' : ''}}" catchtap="handleCloseFileEditor">
    <view class="work-edit-panel" catchtap="handleEditPanelTap">
      <view class="work-edit-grabber"></view>
      <view class="work-edit-heading">
        <view class="work-edit-title">{{editForm.isAudio ? '编辑音频作品' : editForm.isVideo ? '编辑视频作品' : editForm.isAnimation ? '编辑动图作品' : '编辑图片作品'}}</view>
        <view class="work-edit-type">{{editForm.isAudio ? '音频' : editForm.isVideo ? '视频' : editForm.isAnimation ? '动图' : '图片'}}</view>
      </view>

      <scroll-view class="work-edit-scroll" scroll-y type="list">
        <view class="work-edit-content">
          <view class="work-preview">
            <image wx:if="{{editForm.isAudio}}" class="work-preview-media" src="{{editForm.audioCoverUrl}}" mode="aspectFit"></image>
            <image wx:elif="{{!editForm.isVideo}}" class="work-preview-media" src="{{editForm.tempFilePath}}" webp="{{true}}" mode="aspectFit"></image>
            <image wx:elif="{{editForm.coverPath}}" class="work-preview-media" src="{{editForm.coverPath}}" mode="aspectFill"></image>
            <view wx:else class="work-preview-empty">视频</view>
          </view>

          <view class="field-group">
            <view class="field-label">作品标题</view>
            <input
              class="text-field"
              value="{{editForm.title}}"
              maxlength="30"
              placeholder="填写作品标题"
              data-field="title"
              bindinput="handleEditInput"
              disabled="{{saving || choosing}}"
            />
          </view>

          <view class="field-group">
            <view class="field-label">作品说明</view>
            <textarea
              class="textarea-field"
              value="{{editForm.description}}"
              placeholder="填写作品说明"
              maxlength="1000"
              data-field="description"
              bindinput="handleEditInput"
              disabled="{{saving || choosing}}"
              auto-height="{{false}}"
            ></textarea>
          </view>

          <view wx:if="{{editErrorText}}" class="edit-error">{{editErrorText}}</view>
        </view>
      </scroll-view>

      <view class="work-edit-actions">
        <button class="work-edit-cancel" catchtap="handleCloseFileEditor" disabled="{{editFrameExporting}}">取消</button>
        <button class="work-edit-confirm" catchtap="handleConfirmFileEdit" disabled="{{editFrameExporting || saving || choosing}}">完成</button>
      </view>
    </view>
  </view>

  <canvas id="workCompressionCanvas" type="2d" class="work-compression-canvas" style="width: {{compressionCanvasWidth}}px; height: {{compressionCanvasHeight}}px;"></canvas>
</view>
