.probe-page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  background: #f5f6f7;
}

.probe-scroll {
  flex: 1;
  min-height: 0;
}

.probe-content {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  padding: 20rpx 32rpx calc(32rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.probe-panel {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  padding: 28rpx;
  border: 1rpx solid rgba(33, 37, 41, 0.05);
  border-radius: 48rpx;
  background: #ffffff;
  box-sizing: border-box;
}

.probe-title {
  color: #212529;
  font-size: 34rpx;
  line-height: 1.25;
  font-weight: 800;
}

.probe-desc,
.probe-meta,
.probe-path,
.probe-log-line {
  color: #868e96;
  font-size: 24rpx;
  line-height: 1.55;
}

.probe-label {
  color: #212529;
  font-size: 26rpx;
  line-height: 1.3;
  font-weight: 800;
}

.probe-button {
  width: 100%;
  min-width: 100%;
  max-width: 100%;
  height: 92rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0;
  color: #212529;
  font-size: 26rpx;
  font-weight: 800;
  border: 1rpx solid #dee2e6;
  border-radius: 999rpx;
  background: #f5f6f7;
  box-sizing: border-box;
}

.probe-button.dark {
  color: #ffffff;
  border-color: #212529;
  background: #212529;
}

.probe-video {
  width: 100%;
  height: 360rpx;
  border-radius: 32rpx;
  overflow: hidden;
  background: #111827;
}

.probe-slider-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.probe-time {
  width: 92rpx;
  flex: none;
  color: #212529;
  font-size: 24rpx;
  font-weight: 800;
}

.probe-slider {
  flex: 1 1 0;
  min-width: 0;
}

.probe-cover {
  width: 100%;
  height: 360rpx;
  border: 1rpx solid #dee2e6;
  border-radius: 32rpx;
  background: #e9ecef;
  box-sizing: border-box;
}

.probe-path {
  word-break: break-all;
}

.probe-log {
  min-height: 180rpx;
  max-height: 420rpx;
  overflow: hidden;
  padding: 18rpx;
  border-radius: 24rpx;
  background: #f1f3f5;
  box-sizing: border-box;
}

.probe-log-line {
  word-break: break-all;
}

.frame-probe-canvas {
  position: fixed;
  left: -9999px;
  top: -9999px;
  opacity: 0;
  pointer-events: none;
}
