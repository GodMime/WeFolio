.probe-page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  background: #f5f7fb;
}

.probe-scroll {
  flex: 1;
  min-height: 0;
}

.probe-content {
  display: grid;
  gap: 20rpx;
  padding: 28rpx 28rpx calc(28rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.probe-panel {
  display: grid;
  gap: 16rpx;
  padding: 24rpx;
  border: 1rpx solid #d7dee5;
  border-radius: 16rpx;
  background: #ffffff;
  box-sizing: border-box;
}

.probe-title {
  color: #111827;
  font-size: 34rpx;
  line-height: 1.25;
  font-weight: 800;
}

.probe-desc,
.probe-meta,
.probe-path,
.probe-log-line {
  color: #66727f;
  font-size: 24rpx;
  line-height: 1.55;
}

.probe-label {
  color: #17202a;
  font-size: 26rpx;
  line-height: 1.3;
  font-weight: 800;
}

.probe-button {
  width: 100%;
  min-width: 100%;
  max-width: 100%;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0;
  color: #17202a;
  font-size: 26rpx;
  font-weight: 800;
  border: 1rpx solid #d7dee5;
  border-radius: 16rpx;
  background: #f8fafb;
  box-sizing: border-box;
}

.probe-button.dark {
  color: #ffffff;
  border-color: #17202a;
  background: #17202a;
}

.probe-video {
  width: 100%;
  height: 360rpx;
  border-radius: 16rpx;
  overflow: hidden;
  background: #111827;
}

.probe-slider-row {
  display: grid;
  grid-template-columns: 92rpx minmax(0, 1fr);
  align-items: center;
  gap: 12rpx;
}

.probe-time {
  color: #17202a;
  font-size: 24rpx;
  font-weight: 800;
}

.probe-slider {
  min-width: 0;
}

.probe-cover {
  width: 100%;
  height: 360rpx;
  border: 1rpx solid #d7dee5;
  border-radius: 16rpx;
  background: #eef3f7;
  box-sizing: border-box;
}

.probe-path {
  word-break: break-all;
}

.probe-log {
  min-height: 180rpx;
  max-height: 420rpx;
  overflow: hidden;
  padding: 18rpx;
  border-radius: 14rpx;
  background: #f8fafb;
  box-sizing: border-box;
}

.probe-log-line {
  word-break: break-all;
}

.frame-probe-canvas {
  position: fixed;
  left: -9999px;
  top: -9999px;
  opacity: 0;
  pointer-events: none;
}
