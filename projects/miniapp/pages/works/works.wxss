  will-change: transform;
}

.thumbnail-crop-frame {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  border: 2rpx solid rgba(255, 255, 255, 0.94);
  box-shadow: inset 0 0 0 1rpx rgba(23, 32, 42, 0.2);
  pointer-events: none;
  box-sizing: border-box;
}

.thumbnail-crop-canvas {
  position: fixed;
  left: -9999px;
  top: -9999px;
  opacity: 0;
  pointer-events: none;
}

.edit-error {
  color: #a9354f;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 1.5;
}

.work-edit-cancel,
.work-edit-confirm {
  min-width: 156rpx;
  height: 72rpx;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  margin: 0;
  padding: 0 28rpx;
  font-size: 26rpx;
  font-weight: 900;
  border-radius: 14rpx;
  box-sizing: border-box;
}

.work-edit-cancel {
  color: #40546a;
  border: 1rpx solid #d8e0e8;
  background: #f8fafc;
}

.work-edit-confirm {
  color: #ffffff;
  background: #17202a;
  box-shadow: 0 12rpx 28rpx rgba(23, 32, 42, 0.16);
}

.loading-more,
.list-end {
  padding: 28rpx 0 0;
  text-align: center;
}

.tabbar {
  position: fixed;
  left: 28rpx;
  right: 28rpx;
  bottom: calc(28rpx + env(safe-area-inset-bottom));
  z-index: 10;
  height: 116rpx;
  padding: 0;
  justify-content: space-around;
  box-sizing: border-box;
  border: 2rpx solid #e9ecef;
  border-radius: 999rpx;
  background: #ffffff;
  box-shadow: 0 24rpx 56rpx rgba(33, 37, 41, 0.1);
}

.tab {
  position: relative;
  width: 25%;
  height: 116rpx;
  flex-direction: column;
  justify-content: center;
  color: #868e96;
  background: transparent;
}

.tab.active {
  color: #212529;
}

.tab-icon-wrap {
  width: 68rpx;
  height: 52rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #ffffff;
  border-radius: 999rpx;
}

.tab.active .tab-icon-wrap {
  color: #ffffff;
  background: #212529;
}

.tab-icon-image {
  display: block;
  width: 38rpx;
  height: 38rpx;
}

.tab-icon {
  position: relative;
  z-index: 1;
  width: 42rpx;
  height: 42rpx;
}

.schedule-tab-icon::before {
  left: 6rpx;
  top: 6rpx;
  width: 30rpx;
  height: 30rpx;
  border: 4rpx solid currentColor;
  border-radius: 10rpx;
}

.schedule-tab-icon::after {
  left: 12rpx;
  top: 18rpx;
  width: 18rpx;
  height: 4rpx;
  border-radius: 999rpx;
  background: currentColor;
}

.work-tab-icon::before {
  left: 6rpx;
  top: 6rpx;
  width: 30rpx;
  height: 30rpx;
  border: 4rpx solid currentColor;
  border-radius: 10rpx;
}

.work-tab-icon::after {
  left: 13rpx;
  bottom: 11rpx;
  width: 18rpx;
  height: 14rpx;
  border-left: 4rpx solid currentColor;
  border-bottom: 4rpx solid currentColor;
  transform: rotate(-45deg);
}

.portfolio-tab-icon::before {
  left: 10rpx;
  top: 8rpx;
  width: 28rpx;
  height: 28rpx;
  border: 4rpx solid currentColor;
  border-radius: 8rpx;
  background: rgba(255, 255, 255, 0.96);
  z-index: 2;
}

.portfolio-tab-icon::after {
  left: 4rpx;
  top: 14rpx;
  width: 28rpx;
  height: 28rpx;
  border: 4rpx solid currentColor;
  border-radius: 8rpx;
  z-index: 1;
}

.mine-tab-icon::before {
  left: 13rpx;
  top: 6rpx;
  width: 16rpx;
  height: 16rpx;
  border: 4rpx solid currentColor;
  border-radius: 50%;
}

.mine-tab-icon::after {
  left: 6rpx;
  bottom: 6rpx;
  width: 30rpx;
  height: 18rpx;
  border: 4rpx solid currentColor;
  border-bottom-width: 3rpx;
  border-radius: 20rpx 20rpx 8rpx 8rpx;
}

.tab-label {
  position: relative;
  z-index: 1;
  margin-top: 4rpx;
  font-size: 18rpx;
  font-weight: 500;
  line-height: 1.2;
}

@keyframes loading-spin {
  to {
    transform: rotate(360deg);
  }
}
