.works-page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  background-color: #f5f6f7;
}

.works-scroll {
  flex: 1;
  height: 0;
  min-height: 0;
  display: flex;
  flex-direction: column;
}

.works-content {
  height: 100%;
  min-height: 0;
  display: flex;
  flex-direction: column;
  padding: 20rpx 32rpx calc(172rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.search-panel,
.filter-panel,
.library-panel,
.batch-panel {
  border: 1rpx solid rgba(33, 37, 41, 0.05);
  border-radius: 40rpx;
  background: #ffffff;
  box-sizing: border-box;
}

.search-panel {
  flex: none;
  padding: 0;
}

.search-box,
.filter-shell,
.tag-row,
.tag-pill,
.tag-delete,
.search-clear,
.tag-add-button,
.list-heading,
.list-actions,
.work-delete-pane,
.work-delete-button,
.work-card,
.work-meta,
.work-status-row,
.reference-pill,
.status-badge,
.batch-heading,
.batch-heading-actions,
.batch-actions,
.batch-select-all,
.batch-action,
.tabbar,
.tab {
  display: flex;
  align-items: center;
}

.search-box {
  height: 86rpx;
  gap: 14rpx;
  padding: 0 26rpx;
  box-sizing: border-box;
}

.search-icon {
  position: relative;
  width: 22rpx;
  height: 22rpx;
  flex: none;
  border: 4rpx solid #6f7b89;
  border-radius: 50%;
  box-sizing: border-box;
}

.search-icon::after,
.card-arrow::before,
.play-badge::before,
.schedule-tab-icon::before,
.schedule-tab-icon::after,
.work-tab-icon::before,
.work-tab-icon::after,
.portfolio-tab-icon::before,
.portfolio-tab-icon::after,
.mine-tab-icon::before,
.mine-tab-icon::after {
  position: absolute;
  content: "";
  box-sizing: border-box;
}

.search-icon::after {
  width: 10rpx;
  height: 4rpx;
  right: -8rpx;
  bottom: -4rpx;
  background: #6f7b89;
  transform: rotate(45deg);
}

.search-input {
  flex: 1;
  min-width: 0;
  color: #17202a;
  font-size: 28rpx;
  font-weight: 600;
}

.search-placeholder {
  color: #6f7b89;
  font-weight: 600;
}

.search-clear {
  width: 44rpx;
  height: 44rpx;
  flex: none;
  justify-content: center;
  border-radius: 50%;
  color: #6f7b89;
  background: #edf3f8;
  font-size: 30rpx;
  font-weight: 700;
  line-height: 1;
}

.search-clear-mark {
  transform: translateY(-1rpx);
}

.filter-panel {
  flex: none;
  margin-top: 24rpx;
  padding: 12rpx 18rpx;
}

.media-filter-scroll {
  width: 100%;
  height: 58rpx;
  margin-bottom: 12rpx;
  white-space: nowrap;
}

.media-filter-row {
  display: inline-flex;
  align-items: center;
  gap: 12rpx;
}

.media-filter-pill {
  height: 50rpx;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 0 20rpx;
  color: #40546a;
  font-size: 24rpx;
  font-weight: 800;
  border: 1rpx solid #d4dee8;
  border-radius: 999rpx;
  background: #ffffff;
  box-sizing: border-box;
}

.media-filter-pill.active {
  color: #ffffff;
  border-color: #212529;
  background: #212529;
}

.filter-shell {
  display: flex;
  align-items: center;
  gap: 14rpx;
  min-height: 64rpx;
}

.tag-scroll {
  height: 64rpx;
  flex: 1 1 auto;
  min-width: 0;
  white-space: nowrap;
}

.tag-row {
  height: 64rpx;
  width: auto;
  min-width: 0;
  display: inline-flex;
  align-items: center;
  gap: 12rpx;
  justify-content: flex-start;
  padding: 0;
}

.tag-pill {
  width: auto;
  min-width: 0;
  max-width: 260rpx;
  height: 50rpx;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 auto;
  gap: 8rpx;
  margin: 0;
  padding: 0 20rpx;
  overflow: hidden;
  color: #17202a;
  font-size: 24rpx;
  font-weight: 800;
  line-height: 1;
  text-overflow: ellipsis;
  white-space: nowrap;
  border: 1rpx solid #d4dee8;
  border-radius: 999rpx;
  background: #ffffff;
  box-sizing: border-box;
}

.tag-text {
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.tag-pill.active {
  font-weight: 600;
}

.tag-pill.active::before {
  content: "";
  display: block;
  width: 10rpx;
  height: 10rpx;
  flex: none;
  border-radius: 50%;
  background: #ffffff;
}

.tag-pill.manage {
  gap: 10rpx;
  padding-left: 16rpx;
  padding-right: 8rpx;
  color: #212529;
  font-weight: 600;
  border-color: #e9ecef;
  background: #ffffff;
  box-shadow: none;
  transform: none;
}

.tag-pill.manage::before {
  display: none;
}

.tag-color-dot {
  width: 12rpx;
  height: 12rpx;
  flex: none;
  border-radius: 50%;
}

.tag-delete {
  width: 30rpx;
  height: 30rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
  color: #b55656;
  font-size: 22rpx;
  font-weight: 700;
  line-height: 1;
  border: 1rpx solid #e8caca;
  border-radius: 50%;
  background: #faf2f2;
  box-sizing: border-box;
}

.tag-delete-mark {
  width: 30rpx;
  height: 30rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
  transform: translateY(-1rpx);
}

.tag-add-button {
  width: 56rpx;
  height: 56rpx;
  justify-content: center;
  flex: none;
  color: #212529;
  font-size: 34rpx;
  font-weight: 500;
  line-height: 1;
  border: 1rpx solid #e9ecef;
  border-radius: 50%;
  background: #ffffff;
  box-sizing: border-box;
}

.library-panel,
.batch-panel {
  margin-top: 26rpx;
  padding: 28rpx;
  box-shadow: 0 18rpx 48rpx rgba(23, 32, 42, 0.06);
}

.library-panel {
  flex: 1 1 auto;
  min-height: 0;
  display: flex;
  flex-direction: column;
  border-radius: 48rpx;
}

.batch-panel {
  flex: none;
}

.list-heading,
.list-actions,
.batch-heading {
  width: 100%;
  justify-content: space-between;
  gap: 20rpx;
  box-sizing: border-box;
}

.list-actions {
  width: auto;
  flex: none;
  justify-content: flex-end;
  gap: 14rpx;
}

.section-title,
.batch-title {
  flex: 1 1 auto;
  min-width: 0;
  color: #212529;
  font-size: 34rpx;
  font-weight: 900;
  line-height: 1.25;
}

.text-action {
  width: 128rpx;
  min-width: 128rpx;
  max-width: 128rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
  margin: 0 0 0 auto;
  padding: 0;
  color: #495057;
  font-size: 24rpx;
  font-weight: 800;
  line-height: 1;
  border: 1rpx solid #dee2e6;
  border-radius: 999rpx;
  background: #f5f6f7;
  box-sizing: border-box;
}

.work-add-button {
  flex: none;
}

.text-action.active {
  color: #ffffff;
  border-color: #212529;
  background: #212529;
}

.work-list-scroll {
  flex: 1 1 auto;
  height: 0;
  min-height: 0;
  margin-top: 18rpx;
}

.work-list {
  padding-bottom: 4rpx;
  box-sizing: border-box;
}

.work-swipe-row {
  position: relative;
  overflow: hidden;
  border-radius: 40rpx;
}

.work-swipe-row + .work-swipe-row {
  margin-top: 18rpx;
}

.work-delete-pane {
  position: absolute;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 1;
  width: 128rpx;
  justify-content: center;
  background: #b55656;
}

.work-delete-button {
  width: 128rpx;
  height: 100%;
  justify-content: center;
  margin: 0;
  padding: 0;
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 900;
  line-height: 1;
  border: 0;
  border-radius: 0;
  background: #b55656;
  box-shadow: none;
  box-sizing: border-box;
}

.work-card {
  position: relative;
  z-index: 2;
  min-height: 166rpx;
  gap: 20rpx;
  padding: 20rpx;
  border: 1rpx solid rgba(33, 37, 41, 0.06);
  border-radius: 40rpx;
  background: #ffffff;
  box-sizing: border-box;
  transition: transform 180ms ease;
}

.work-card.selected {
  border-color: #212529;
  background: #f5f6f7;
}

.work-swipe-row.revealed .work-card {
  transform: translateX(-140rpx);
}

.work-swipe-row.batch-mode .work-delete-pane,
.work-swipe-row.batch-mode .card-arrow {
  display: none;
}

.work-select {
  width: 44rpx;
  height: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
  border: 2rpx solid #c7d4e1;
  border-radius: 50%;
  background: #ffffff;
  box-sizing: border-box;
}

.work-select.selected {
  border-color: #3d6fad;
  background: #3d6fad;
}

.work-select-dot {
  width: 18rpx;
  height: 18rpx;
  border-radius: 50%;
  background: transparent;
}

.work-select.selected .work-select-dot {
  background: #ffffff;
}

.thumb {
  position: relative;
  width: 148rpx;
  height: 128rpx;
  flex: none;
  overflow: hidden;
  border-radius: 12rpx;
  background: #e7edf4;
}

.thumb image,
.thumb-placeholder {
  width: 100%;
  height: 100%;
}

.thumb-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #66727f;
  font-size: 24rpx;
  font-weight: 800;
  background: linear-gradient(135deg, #edf3f7, #dce7e4);
}

.play-badge {
  position: absolute;
  left: 18rpx;
  top: 18rpx;
  width: 54rpx;
  height: 54rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 900;
  line-height: 1;
  border-radius: 50%;
  background: rgba(63, 91, 121, 0.9);
}

.play-badge {
  left: 50%;
  top: 50%;
  width: 58rpx;
  height: 58rpx;
  z-index: 3;
  background: rgba(255, 255, 255, 0.94);
  transform: translate(-50%, -50%);
}

.play-badge::before {
  left: 22rpx;
  top: 17rpx;
  width: 0;
  height: 0;
  border-top: 12rpx solid transparent;
  border-bottom: 12rpx solid transparent;
  border-left: 18rpx solid #17202a;
}

.work-copy {
  flex: 1;
  min-width: 0;
}

.work-title {
  overflow: hidden;
  color: #17202a;
  font-size: 30rpx;
  font-weight: 900;
  line-height: 1.32;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.work-meta {
  margin-top: 8rpx;
  overflow: hidden;
  color: #66727f;
  font-size: 25rpx;
  font-weight: 600;
  line-height: 1.35;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.work-status-row {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 12rpx;
}

.audit-reject-row {
  display: flex;
  align-items: flex-start;
  gap: 10rpx;
  margin-top: 12rpx;
  padding: 12rpx 14rpx;
  color: #7a4f0f;
  border: 1rpx solid #f1d38a;
  border-radius: 12rpx;
  background: #fff8e7;
  box-sizing: border-box;
}

.audit-reject-icon {
  width: 28rpx;
  height: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
  margin-top: 2rpx;
  color: #17202a;
  font-size: 20rpx;
  font-weight: 900;
  line-height: 1;
  border-radius: 50%;
  background: #f6c343;
}

.audit-reject-text {
  color: #7a4f0f;
  font-size: 23rpx;
  font-weight: 700;
  line-height: 1.38;
  word-break: break-all;
}

.audit-reject-text + .audit-reject-text {
  margin-top: 6rpx;
}

.audit-reject-content {
  flex: 1;
  min-width: 0;
}

.audit-resubmit-row {
  display: flex;
  flex-direction: column;
  align-items: stretch;
  gap: 10rpx;
  margin-top: 12rpx;
}

.audit-round-text {
  width: 100%;
  flex: none;
  min-width: 0;
  color: #8b661f;
  font-size: 21rpx;
  font-weight: 700;
  line-height: 1.3;
}

.audit-resubmit-button {
  width: 136rpx;
  min-width: 136rpx;
  max-width: 100%;
  height: 50rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
  align-self: flex-end;
  margin: 0;
  padding: 0 20rpx;
  color: #ffffff;
  font-size: 22rpx;
  font-weight: 800;
  line-height: 1;
  border: 0;
  border-radius: 999rpx;
  background: #3d6fad;
  box-sizing: border-box;
}

.audit-resubmit-button::after {
  border: 0;
}

.reference-pill {
  display: inline-flex;
  height: 42rpx;
  justify-content: center;
  padding: 0 18rpx;
  color: #868e96;
  font-size: 20rpx;
  font-weight: 500;
  line-height: 1;
  border: 1rpx solid #e9ecef;
  border-radius: 999rpx;
  background: #ffffff;
  box-sizing: border-box;
}

.reference-pill.used {
  color: #212529;
  font-weight: 600;
}

.status-badge {
  display: inline-flex;
  gap: 8rpx;
  color: #868e96;
  font-size: 22rpx;
  font-weight: 500;
  line-height: 1;
}

.status-dot {
  width: 12rpx;
  height: 12rpx;
  flex: none;
  border-radius: 50%;
}

.status-badge.pending,
.status-badge.auditing {
  color: #868e96;
}

.status-badge.pending .status-dot,
.status-badge.auditing .status-dot {
  background: #868e96;
}

.status-badge.passed {
  color: #5c9e6e;
}

.status-badge.passed .status-dot {
  background: #5c9e6e;
}

.status-badge.rejected {
  color: #b55656;
}

.status-badge.rejected .status-dot {
  background: #b55656;
}

.status-badge.failed {
  color: #b55656;
}

.status-badge.failed .status-dot {
  background: #b55656;
}

.status-badge.review {
  color: #c08a3e;
}

.status-badge.review .status-dot {
  background: #c08a3e;
}

.card-arrow {
  position: relative;
  width: 28rpx;
  height: 28rpx;
  flex: none;
}

.card-arrow::before {
  right: 6rpx;
  top: 5rpx;
  width: 16rpx;
  height: 16rpx;
  border-top: 4rpx solid #17202a;
  border-right: 4rpx solid #17202a;
  transform: rotate(45deg);
}

.batch-desc,
.empty-desc,
.loading-more,
.list-end {
  color: #66727f;
  font-size: 25rpx;
  line-height: 1.45;
}

.batch-copy {
  flex: 1 1 auto;
  min-width: 0;
}

.batch-heading-actions {
  display: flex;
  align-items: center;
  flex: none;
  gap: 12rpx;
}

.batch-count {
  min-width: 104rpx;
  height: 50rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
  color: #9a6512;
  font-size: 24rpx;
  font-weight: 900;
  border: 1rpx solid #f0c45d;
  border-radius: 999rpx;
  background: #fff8e7;
  box-sizing: border-box;
}

.batch-select-all {
  width: auto;
  min-width: 88rpx;
  max-width: 136rpx;
  height: 50rpx;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 auto;
  margin: 0;
  padding: 0 16rpx;
  color: #2f66aa;
  font-size: 24rpx;
  font-weight: 900;
  line-height: 1;
  border: 1rpx solid #bdd6ff;
  border-radius: 999rpx;
  background: #f2f7ff;
  box-sizing: border-box;
}

.batch-actions {
  gap: 16rpx;
  margin-top: 24rpx;
}

.batch-action {
  height: 86rpx;
  flex: 1 1 0;
  justify-content: center;
  color: #17202a;
  font-size: 28rpx;
  font-weight: 900;
  line-height: 1;
  border: 1rpx solid #d8e0e8;
  border-radius: 14rpx;
  background: #ffffff;
  box-sizing: border-box;
}

.batch-action.danger {
  color: #a9354f;
  border-color: #efc9d3;
  background: #fff5f7;
}

.batch-action.muted {
  color: #6f7b89;
  background: #f4f6f8;
}

.component-loading.compact {
  min-height: 220rpx;
  padding: 40rpx 28rpx;
}

.component-loading,
.inline-empty,
.empty-state {
  padding: 72rpx 28rpx;
  text-align: center;
  box-sizing: border-box;
}

.library-panel > .component-loading,
.library-panel > .inline-empty,
.library-panel .empty-state {
  flex: 1 1 auto;
  min-height: 0;
}

.component-loading {
  min-height: 260rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
}

.loading-spinner {
  width: 36rpx;
  height: 36rpx;
  border: 4rpx solid #d8e0e8;
  border-top-color: #3d6fad;
  border-radius: 50%;
  animation: loading-spin 820ms linear infinite;
  box-sizing: border-box;
}

.loading-copy {
  color: #66727f;
  font-size: 24rpx;
  font-weight: 800;
}

.empty-logo-frame {
  width: 112rpx;
  height: 112rpx;
  overflow: hidden;
  border-radius: 50%;
  margin: 0 auto 26rpx;
}

.empty-logo {
  width: 100%;
  height: 100%;
  display: block;
  transform: scale(1.42);
  transform-origin: center;
}

.empty-title {
  color: #17202a;
  font-size: 32rpx;
  font-weight: 900;
}

.empty-title.small {
  font-size: 28rpx;
}

.primary-button {
  min-height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0;
  padding: 0 28rpx;
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 800;
  line-height: 1;
  border-radius: 999rpx;
  background: #212529;
  box-sizing: border-box;
}

.primary-button.compact {
  display: inline-flex;
  min-width: 176rpx;
  height: 76rpx;
  margin-top: 30rpx;
  padding: 0 30rpx;
}

.full {
  width: 100%;
}

.tag-dialog {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 30;
  display: flex;
  align-items: flex-end;
  padding: 0;
  opacity: 0;
  pointer-events: none;
  transition: opacity 230ms ease-out;
  box-sizing: border-box;
}

.tag-dialog.visible {
  opacity: 1;
  pointer-events: auto;
}

.tag-dialog-backdrop {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(23, 32, 42, 0.38);
}

.tag-dialog-panel {
  position: relative;
  z-index: 1;
  width: 100%;
  max-height: calc(92vh - env(safe-area-inset-bottom));
  padding: 24rpx 32rpx calc(32rpx + env(safe-area-inset-bottom));
  overflow-y: auto;
  border-radius: 56rpx 56rpx 0 0;
  background: #ffffff;
  box-shadow: 0 22rpx 58rpx rgba(23, 32, 42, 0.2);
  box-sizing: border-box;
  transform: translateY(44rpx);
  transition: transform 230ms cubic-bezier(0.2, 0, 0, 1);
}

.tag-dialog.visible .tag-dialog-panel {
  transform: translateY(0);
}

.tag-dialog-grabber {
  width: 72rpx;
  height: 8rpx;
  margin: 0 auto 22rpx;
  border-radius: 999rpx;
  background: #d8e0e8;
}

.tag-dialog-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.tag-dialog-title {
  color: #212529;
  font-size: 34rpx;
  font-weight: 700;
  line-height: 1.2;
}

.tag-field {
  margin-top: 24rpx;
}

.tag-field-label {
  color: #868e96;
  font-size: 22rpx;
  font-weight: 500;
}

.tag-input {
  width: 100%;
  height: 88rpx;
  margin-top: 12rpx;
  padding: 0 32rpx;
  color: #212529;
  font-size: 28rpx;
  font-weight: 500;
  border: 0;
