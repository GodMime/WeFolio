.portfolio-preview-page {
  background: #f5f7fb;
}

.preview-scroll {
  height: 100vh;
}

.preview-banner,
.preview-component {
  margin: 24rpx 28rpx;
  padding: 24rpx;
  background: #ffffff;
  border: 1rpx solid #e2e8f0;
  border-radius: 12rpx;
}

.preview-title {
  font-size: 36rpx;
  font-weight: 800;
}

.preview-desc,
.preview-note,
.component-type {
  margin-top: 10rpx;
  color: #6b7787;
  font-size: 24rpx;
}
