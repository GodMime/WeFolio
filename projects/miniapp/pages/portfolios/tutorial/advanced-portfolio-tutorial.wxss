page { height:100%; background:#000; color:#fff; }
.tutorial-page { height:100%; display:flex; flex-direction:column; background:#000; }
/* 竖屏视频占满操作区之外的剩余高度，保持原始比例。 */
.tutorial-video { display:block; flex:1; width:100%; height:0; min-height:0; background:#000; }
.tutorial-footer { flex-shrink:0; padding:24rpx 32rpx; padding-bottom:calc(24rpx + env(safe-area-inset-bottom)); }
.tutorial-title { font-size:30rpx; line-height:1.5; }
.tutorial-actions { display:flex; gap:20rpx; margin-top:20rpx; }
.tutorial-button { min-height:88rpx; margin:0; padding:0 24rpx; border:1rpx solid #555; border-radius:16rpx; background:#222; color:#fff; font-size:28rpx; line-height:86rpx; }
.tutorial-button::after { border:0; }
.tutorial-actions .tutorial-button { flex:1; min-width:0; }
.tutorial-share { background:#fff; border-color:#fff; color:#17202a; }
.tutorial-button[disabled] { background:#222; color:#aaa; }
.tutorial-hint { margin-top:16rpx; color:#aaa; font-size:24rpx; line-height:1.5; }
.tutorial-error { display:flex; flex-direction:column; align-items:center; gap:20rpx; padding:24rpx 32rpx; color:#ccc; font-size:28rpx; }
.tutorial-code-mask { position:fixed; inset:0; z-index:1000; display:flex; align-items:center; justify-content:center; padding:32rpx; background:rgba(0,0,0,.72); }
.tutorial-code-card { display:flex; flex-direction:column; align-items:center; width:100%; max-width:640rpx; max-height:90%; box-sizing:border-box; overflow-y:auto; padding:32rpx; border-radius:24rpx; background:#fff; color:#17202a; }
.tutorial-code-title { font-size:32rpx; font-weight:600; line-height:1.5; }
/* 官方透明码保留原始 PNG，白底确保黑色码点在深色页面中仍清晰可读。 */
.tutorial-code-image { display:block; width:560rpx; max-width:100%; height:560rpx; flex-shrink:0; margin-top:24rpx; background:#fff; }
.tutorial-code-hint { margin-top:16rpx; color:#667085; font-size:24rpx; line-height:1.5; text-align:center; }
.tutorial-code-status { display:flex; flex-direction:column; align-items:center; gap:16rpx; margin-top:16rpx; font-size:26rpx; }
.tutorial-code-close { width:100%; margin-top:24rpx; flex-shrink:0; }
