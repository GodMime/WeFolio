@import "../../../../styles/portfolio-text-typography.wxss";
@import "../../../../styles/portfolio-theme.wxss";
/* 背景规则随组件编译，避免独立样式依赖在增量编译时漏载。 */
.text-background-enabled { background: #212529; }
.text-background-image, .text-background-video, .text-background-poster, .text-background-mask { position: absolute; top: 0; left: 0; width: 100%; height: 100%; }
.text-background-mask { pointer-events: none; }
.text-background--original { background: transparent; }
.text-background--dark-mask { background: rgba(0, 0, 0, 0.4); }
.text-background--gradient { background: linear-gradient(180deg, rgba(0, 0, 0, 0.12) 0%, rgba(0, 0, 0, 0.4) 50%, rgba(0, 0, 0, 0.88) 100%); }
.text-background-warning { position: relative; color: #F8F9FA; background: rgba(0, 0, 0, 0.4); padding: 16rpx; font-size: 24rpx; }

.text-section {
  position: relative;
  padding: 12rpx 32rpx;
  text-align: center;
  box-sizing: border-box;
}

.text-section-content { position: relative; z-index: 1; }
.text-section.text-background-enabled { display: flex; flex-direction: column; padding: 32rpx; }
.text-background-enabled .component-title, .text-background-enabled .text-content { color: #F8F9FA; }
.text-vertical-top { justify-content: flex-start; }
.text-vertical-center { justify-content: center; }
.text-vertical-bottom { justify-content: flex-end; }

.component-title {
  padding: 0 24rpx;
  color: var(--portfolio-text-primary);
  font-size: 32rpx;
  font-weight: 900;
  line-height: 1.35;
  box-sizing: border-box;
}

.text-content {
  display: block;
  margin-top: 12rpx;
  color: var(--portfolio-text-secondary);
  line-height: 1.75;
  text-align: left;
  white-space: pre-wrap;
  overflow-wrap: break-word;
  word-break: break-word;
}

.text-section.align-left,
.text-section.align-left .component-title,
.text-section.align-left .text-content {
  text-align: left;
}

.text-section.align-center,
.text-section.align-center .component-title,
.text-section.align-center .text-content {
  text-align: center;
}

.text-section.align-right,
.text-section.align-right .component-title,
.text-section.align-right .text-content {
  text-align: right;
}
.text-section {
  color: var(--portfolio-text-primary);
}

/* 视频只承载背景，滚动和点击交给文字与页面。 */
.text-background-video, .text-background-poster { z-index: 0; pointer-events: none; }
.text-background-mask { pointer-events: none; }
