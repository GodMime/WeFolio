@import "../../../../styles/portfolio-theme.wxss";

.qr-section {
  padding: 12rpx 32rpx;
  text-align: center;
  box-sizing: border-box;
}

.qr-image {
  display: block;
  width: 280rpx;
  height: 280rpx;
  margin: 24rpx auto 0;
  border-radius: 32rpx;
}
.qr-section {
  color: var(--portfolio-text-primary);
}
