<view wx:if="{{works.length}}" class="video-carousel theme-{{themeMode}}">
  <view wx:if="{{showComponentTitle && title}}" class="video-carousel-title">{{title}}</view>
  <view
    wx:if="{{displayStyle !== 'PORTRAIT_CARDS'}}"
    class="video-carousel-stage"
    bindtouchstart="handleTouchStart"
    bindtouchmove="handleTouchMove"
    bindtouchend="handleTouchEnd"
    bindtouchcancel="handleTouchCancel"
  >
    <block wx:for="{{cardStates}}" wx:key="workKey">
    <view
      wx:if="{{!item.hidden}}"
      class="video-carousel-card {{item.isCenter ? 'is-center' : ''}}"
      style="transform: translate(-50%, -50%) translateX({{item.translateX}}rpx) scale({{item.scale}}); z-index: {{item.zIndex}}; opacity: {{item.opacity}}; filter: brightness({{item.brightness}});"
      data-index="{{item.workIndex}}"
      bindtap="handleCardTap"
      aria-role="button"
      aria-label="{{item.isCenter ? '播放' : '切换至'}}视频{{item.work.title}}"
    >
      <image wx:if="{{item.work.coverUrl}}" class="video-carousel-cover" src="{{item.work.coverUrl}}" mode="aspectFill" />
      <view wx:else class="video-carousel-placeholder">暂无封面</view>
      <view class="video-carousel-shade {{showTitle || (showDescription && item.work.description) ? 'has-caption' : ''}}"></view>
      <view wx:if="{{showTitle || (showDescription && item.work.description)}}" class="video-carousel-caption">
        <view class="video-carousel-caption-rule" aria-hidden="true"></view>
        <view wx:if="{{showTitle}}" class="video-carousel-caption-title">{{item.work.title || '未命名视频'}}</view>
        <view wx:if="{{showDescription && item.work.description}}" class="video-carousel-caption-description {{showTitle ? 'with-title' : ''}}">{{item.work.description}}</view>
      </view>
      <view wx:if="{{showTitle || (showDescription && item.work.description)}}" class="video-carousel-entry" aria-hidden="true">
        <text>{{item.isCenter ? '观看视频' : '切换视频'}}</text>
        <text class="video-carousel-entry-arrow">→</text>
      </view>
      <view wx:else class="video-carousel-play" aria-hidden="true"><view class="video-carousel-play-mark"></view></view>
    </view>
    </block>
  </view>
  <swiper wx:if="{{displayStyle === 'PORTRAIT_CARDS'}}" class="video-carousel-portrait-track" style="height:{{portraitHeight}}px" current="{{currentIndex}}" next-margin="{{portraitNextMargin}}px" circular="{{false}}" bindchange="handlePortraitChange">
    <swiper-item wx:for="{{works}}" wx:key="workId">
      <view class="video-carousel-portrait-card" data-index="{{index}}" bindtap="handlePortraitPlay" aria-role="button" aria-label="{{index === currentIndex ? '播放' : '切换至'}}视频{{item.title}}">
        <image wx:if="{{item.coverUrl}}" class="video-carousel-cover" src="{{item.coverUrl}}" mode="aspectFill" />
        <view wx:else class="video-carousel-placeholder">暂无封面</view>
        <view class="video-carousel-shade {{showTitle || (showDescription && item.description) ? 'has-caption' : ''}}"></view>
        <view class="video-carousel-frame" aria-hidden="true"></view>
        <view wx:if="{{showTitle || (showDescription && item.description)}}" class="video-carousel-caption">
          <view class="video-carousel-caption-rule" aria-hidden="true"></view>
          <view wx:if="{{showTitle}}" class="video-carousel-caption-title">{{item.title || '未命名视频'}}</view>
          <view wx:if="{{showDescription && item.description}}" class="video-carousel-caption-description {{showTitle ? 'with-title' : ''}}">{{item.description}}</view>
        </view>
        <view wx:if="{{showTitle || (showDescription && item.description)}}" class="video-carousel-entry" aria-hidden="true">
          <text>{{index === currentIndex ? '观看视频' : '切换视频'}}</text>
          <text class="video-carousel-entry-arrow">→</text>
        </view>
        <view wx:else class="video-carousel-play" aria-hidden="true"><view class="video-carousel-play-mark"></view></view>
      </view>
    </swiper-item>
  </swiper>
  <view wx:if="{{displayStyle === 'PORTRAIT_CARDS' && works.length > 1}}" class="video-carousel-indicators">
    <view wx:for="{{works}}" wx:key="workId" class="video-carousel-dot {{index === currentIndex ? 'active' : ''}}"></view>
  </view>
  <view wx:if="{{showSwipeHint && works.length > 1}}" class="video-carousel-hint">左右滑动，点击观看视频</view>
</view>
