<view class="page-shell share-code-page">
  <canvas type="2d" id="portfolio-miniapp-code-canvas" class="share-code-canvas"></canvas>
  <navigation-bar title="作品集小程序码" back="{{true}}" color="#212529" background="#f5f6f7"></navigation-bar>
  <scroll-view class="share-code-scroll" scroll-y type="list">
    <view class="share-code-content">
      <view class="share-code-card">
        <image wx:if="{{displayFilePath}}" class="share-code-image" src="{{displayFilePath}}" mode="aspectFit" aria-label="作品集小程序码分享图片"></image>
        <view wx:if="{{status === 'error' || status === 'download-error' || status === 'render-error'}}" class="share-code-state">
          <view class="share-code-state-mark">!</view>
          <view class="share-code-state-title">{{status === 'error' ? '小程序码生成失败' : '图片准备失败'}}</view>
          <view class="share-code-state-desc">{{errorMessage || '请稍后重试'}}</view>
          <button class="retry-button" bindtap="handleRetry">{{status === 'error' ? '重新生成' : '重试'}}</button>
        </view>
        <view wx:elif="{{status !== 'ready'}}" class="share-code-state" aria-role="status" aria-label="正在生成图片">
          <view class="share-code-loading"></view>
          <view class="share-code-state-title">{{status === 'generating' ? '正在获取小程序码' : '正在生成图片'}}</view>
          <view class="share-code-state-desc">马上就好，请稍候</view>
        </view>
      </view>
      <view class="share-code-option">
        <view class="share-code-option-label">logo 使用头像</view>
        <switch checked="{{useAvatar}}" disabled="{{!canToggleAvatar}}" color="#212529" bindchange="handleUseAvatarChange" aria-label="logo 使用头像"></switch>
      </view>
      <view class="share-code-actions {{displayFilePath && !saving && (status === 'checking' || status === 'downloading' || status === 'rendering' || status === 'generating') ? 'share-code-actions-stable' : ''}}">
        <button class="primary-button" disabled="{{status !== 'ready' || saving}}" loading="{{saving}}" bindtap="handleSave">{{saving ? '正在保存…' : '保存到相册'}}</button>
        <button class="secondary-button" disabled="{{status !== 'ready' || saving}}" bindtap="handlePreview">查看大图</button>
        <view class="share-code-hint">保存后，可在微信中发送这张图片</view>
      </view>
    </view>
  </scroll-view>
</view>
