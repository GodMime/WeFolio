.visitor-schedule-page {
  background: #f5f7fb;
}

.query-panel,
.schedule-card {
  margin: 24rpx 28rpx;
  padding: 24rpx;
  background: #ffffff;
  border-radius: 12rpx;
  border: 1rpx solid #e2e8f0;
}

.field {
  margin-bottom: 16rpx;
  padding: 18rpx;
  min-height: 72rpx;
  background: #f8fafc;
  border-radius: 8rpx;
}

.primary-button {
  background: #2d5f9a;
  color: #ffffff;
  border-radius: 8rpx;
}

.schedule-date {
  font-weight: 700;
}

.schedule-time,
.schedule-status {
  margin-top: 8rpx;
  color: #6b7787;
}
