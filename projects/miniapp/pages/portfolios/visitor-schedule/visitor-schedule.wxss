.visitor-schedule-page {
  background: #ffffff;
}

.query-panel,
.schedule-card {
  margin: 20rpx 32rpx;
  padding: 28rpx;
  background: #ffffff;
  border-radius: 48rpx;
  border: 1rpx solid #e9ecef;
}

.field {
  margin-bottom: 16rpx;
  padding: 0 24rpx;
  min-height: 84rpx;
  color: #212529;
  background: #f5f6f7;
  border-radius: 24rpx;
}

.primary-button {
  height: 96rpx;
  color: #ffffff;
  border-radius: 999rpx;
  background: #212529;
}

.schedule-date {
  font-weight: 700;
}

.schedule-time,
.schedule-status {
  margin-top: 8rpx;
  color: #868e96;
}
