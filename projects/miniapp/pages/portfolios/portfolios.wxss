.portfolios-page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  background: #f5f6f7;
}

.portfolio-content {
  height: 100%;
  padding: 20rpx 32rpx calc(140rpx + env(safe-area-inset-bottom));
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
}

.portfolio-segment-shell {
  flex: none;
  padding: 24rpx 32rpx 0;
}

.portfolio-segment-shell.switching {
  pointer-events: none;
}

.portfolio-switch-viewport {
  flex: 1;
  min-height: 0;
  overflow: hidden;
}

.portfolio-switch-track {
  width: 200%;
  height: 100%;
  display: flex;
  transform: translate3d(0, 0, 0);
  transition: transform 220ms cubic-bezier(0.22, 1, 0.36, 1);
}

.portfolio-switch-track.team-active {
  transform: translate3d(-50%, 0, 0);
}

.portfolio-switch-panel {
  width: 50%;
  height: 100%;
  flex: none;
  min-width: 0;
}

.portfolio-switch-panel .portfolio-list-panel {
  margin-top: 0;
}

.portfolio-list-panel,
.portfolio-item-card,
.inline-state,
.empty-state {
  background: #ffffff;
  border: 1rpx solid #e9ecef;
}

.segment {
  position: relative;
  display: flex;
  min-height: 72rpx;
  gap: 0;
  padding: 0;
  border: 0;
  border-bottom: 1rpx solid #e9ecef;
  box-sizing: border-box;
}

.segment-indicator {
  position: absolute;
  left: 25%;
  bottom: -1rpx;
  z-index: 2;
  width: 48rpx;
  height: 5rpx;
  margin-left: -24rpx;
  border-radius: 999rpx;
  background: #212529;
  pointer-events: none;
  transition: left 220ms cubic-bezier(0.22, 1, 0.36, 1);
}

.segment-indicator.team-active {
  left: 75%;
}

.segment-item {
  position: relative;
  z-index: 1;
  flex: 1;
  min-width: 0;
  height: 72rpx;
  margin: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #868e96;
  font-size: 26rpx;
  font-weight: 500;
  line-height: 1;
  border-radius: 0;
  background: transparent;
}

.segment-item::after,
.create-action::after,
.portfolio-delete-button::after,
.portfolio-action-button::after,
.small-button::after,
.tab::after {
  border: 0;
}

.segment-item.active {
  color: #212529;
  font-weight: 600;
  background: transparent;
}

.portfolio-list-panel {
  flex: 1;
  min-height: 0;
  margin-top: 20rpx;
  padding: 28rpx;
  display: flex;
  flex-direction: column;
  border-radius: 48rpx;
  box-sizing: border-box;
}

.portfolio-list-scroll {
  height: 0;
  flex: 1;
  min-height: 0;
}

.list-heading,
.summary-pills,
.portfolio-item-card,
.portfolio-side,
.portfolio-action-row,
.portfolio-badges,
.portfolio-delete-pane,
.tabbar,
.tab {
  display: flex;
  align-items: center;
}

.list-heading {
  flex: none;
  justify-content: space-between;
  gap: 18rpx;
}

.list-title {
  min-width: 0;
  flex: 1 1 auto;
  color: #212529;
  font-size: 36rpx;
  font-weight: 700;
  line-height: 1.2;
}

.summary-pills {
  flex: none;
  gap: 12rpx;
}

.summary-pill,
.status-badge {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  white-space: nowrap;
}

.summary-pill::before {
  width: 12rpx;
  height: 12rpx;
  flex: none;
  content: "";
  border-radius: 50%;
  background: currentColor;
}

.status-badge::before {
  width: 12rpx;
  height: 12rpx;
  flex: none;
  content: "";
  border-radius: 50%;
  background: currentColor;
}

.summary-pill {
  height: 48rpx;
  padding: 0 8rpx;
  font-size: 22rpx;
  font-weight: 500;
}

.summary-pill.published {
  color: #5c9e6e;
}

.summary-pill.draft {
  color: #868e96;
}

.portfolio-list {
  margin-top: 20rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.portfolio-swipe-row {
  position: relative;
  overflow: hidden;
  border-radius: 48rpx;
}

.portfolio-delete-pane {
  position: absolute;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 1;
  width: 128rpx;
  justify-content: center;
  background: #b55656;
  transform: translateX(100%);
  opacity: 0;
  pointer-events: none;
  transition: transform 180ms ease, opacity 120ms ease;
}

.portfolio-delete-button {
  width: 128rpx;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0;
  padding: 0;
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 600;
  line-height: 1;
  border: 0;
  border-radius: 0;
  background: #b55656;
  box-shadow: none;
  box-sizing: border-box;
}

.portfolio-swipe-row.revealed .portfolio-delete-pane {
  transform: translateX(0);
  opacity: 1;
  pointer-events: auto;
}

.portfolio-item-card {
  position: relative;
  z-index: 2;
  min-height: 184rpx;
  padding: 24rpx;
  display: flex;
  align-items: center;
  gap: 20rpx;
  border: 1rpx solid #e9ecef;
  border-radius: 48rpx;
  box-sizing: border-box;
  transition: transform 180ms ease;
}

.portfolio-swipe-row.revealed .portfolio-item-card {
  transform: translateX(-140rpx);
}

.portfolio-cover {
  width: 152rpx;
  height: 133rpx;
  flex: none;
  overflow: hidden;
  border-radius: 40rpx;
  background: #e9ecef;
}

.portfolio-cover-image {
  display: block;
  width: 100%;
  height: 100%;
}

.portfolio-copy {
  min-width: 0;
  flex: 1 1 0;
}

.team-portfolio-affiliation {
  position: absolute;
  top: 26rpx;
  right: 24rpx;
  z-index: 1;
  width: 256rpx;
  overflow: hidden;
  color: #adb5bd;
  font-size: 22rpx;
  line-height: 1.35;
  text-align: right;
  text-overflow: ellipsis;
  white-space: nowrap;
  pointer-events: none;
}

.portfolio-title {
  overflow: hidden;
  color: #212529;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 1.25;
  white-space: nowrap;
}

.portfolio-title-track {
  display: inline-flex;
  align-items: center;
  white-space: nowrap;
  transform: translateX(0);
}

.portfolio-title-text {
  flex: none;
}

.portfolio-title.scrolling .portfolio-title-track {
  animation: portfolio-title-marquee 8s linear infinite;
}

.portfolio-title.scrolling .portfolio-title-text {
  padding-right: 80rpx;
}

@keyframes portfolio-title-marquee {
  0%,
  14% {
    transform: translateX(0);
  }

  86%,
  100% {
    transform: translateX(-50%);
  }
}

.portfolio-meta {
  margin-top: 8rpx;
  color: #adb5bd;
  font-size: 22rpx;
  line-height: 1.35;
}

.portfolio-badges {
  margin-top: 12rpx;
  gap: 12rpx;
  flex-wrap: wrap;
}

.status-badge {
  padding: 0;
  font-size: 21rpx;
  font-weight: 500;
}

.status-badge.published {
  color: #5c9e6e;
}

.status-badge.draft {
  color: #868e96;
}

.status-badge.muted {
  color: #b55656;
}

.portfolio-side {
  flex: 0 0 auto;
  min-width: 0;
  gap: 12rpx;
}

.team-portfolio-card .portfolio-side {
  flex: 0 0 256rpx;
  justify-content: flex-end;
}

.portfolio-action-row {
  flex: 0 0 auto;
  max-width: 226rpx;
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.portfolio-action-button {
  width: 108rpx;
  min-width: 108rpx;
  max-width: 108rpx;
  height: 60rpx;
  flex: none;
  margin: 0;
  padding: 0 26rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #212529;
  font-size: 24rpx;
  font-weight: 600;
  line-height: 1;
  border: 0;
  border-radius: 999rpx;
  background: #f5f6f7;
  box-sizing: border-box;
}

.portfolio-action-button.publish {
  color: #ffffff;
  border-color: #212529;
  background: #212529;
}

.portfolio-action-button.share {
  color: #212529;
  background: #f5f6f7;
}

.portfolio-action-button:active {
  background: #e9eff5;
}

.portfolio-action-button.publish:active {
  background: #343a40;
}

.portfolio-action-button.share:active {
  background: #e9eff5;
}

.portfolio-arrow {
  width: 14rpx;
  height: 14rpx;
  flex: none;
  border-top: 4rpx solid #9aa6b2;
  border-right: 4rpx solid #9aa6b2;
  transform: rotate(45deg);
}

.inline-state,
.empty-state {
  margin-top: 22rpx;
  padding: 36rpx 28rpx;
  color: #697786;
  border-radius: 14rpx;
  box-sizing: border-box;
}

.inline-state.error {
  color: #b55656;
}

.empty-title {
  color: #212529;
  font-size: 30rpx;
  font-weight: 900;
}

.empty-desc {
  margin-top: 10rpx;
  color: #697786;
  font-size: 24rpx;
  line-height: 1.5;
}

.small-button {
  width: 140rpx;
  height: 60rpx;
  margin: 20rpx 0 0;
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 800;
  line-height: 1;
  border-radius: 999rpx;
  background: #212529;
}

.create-actions {
  width: 100%;
  max-width: 100%;
  min-width: 0;
  flex: none;
  display: flex;
  align-items: stretch;
  gap: 16rpx;
  margin: 20rpx 0 0;
  padding-bottom: 28rpx;
  box-sizing: border-box;
}

.create-action {
  flex: 1 1 0;
  width: auto;
  min-width: 0;
  height: 92rpx;
  margin: 0;
  padding: 0 18rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #ffffff;
  font-size: 26rpx;
  font-weight: 600;
  line-height: 1.2;
  border-radius: 999rpx;
  background: #212529;
}

.create-action.advanced {
  color: #212529;
  background: #e9ecef;
}

.tabbar {
  position: fixed;
  left: 28rpx;
  right: 28rpx;
  bottom: calc(28rpx + env(safe-area-inset-bottom));
  z-index: 10;
  height: 116rpx;
  padding: 0;
  justify-content: space-around;
  box-sizing: border-box;
  border: 2rpx solid #e9ecef;
  border-radius: 999rpx;
  background: #ffffff;
  box-shadow: 0 24rpx 56rpx rgba(33, 37, 41, 0.1);
}

.tab {
  position: relative;
  width: 25%;
  height: 116rpx;
  flex-direction: column;
  justify-content: center;
  color: #868e96;
  background: transparent;
}

.tab.active {
  color: #212529;
}

.tab-icon-wrap {
  width: 68rpx;
  height: 52rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 999rpx;
}

.tab.active .tab-icon-wrap {
  background: #212529;
}

.tab-icon-image {
  display: block;
  width: 38rpx;
  height: 38rpx;
}

.tab-label {
  position: relative;
  z-index: 1;
  margin-top: 4rpx;
  font-size: 18rpx;
  font-weight: 500;
  line-height: 1.2;
}

.inline-hint {
  margin-top: 18rpx;
  color: #697786;
  font-size: 24rpx;
  line-height: 1.5;
  text-align: center;
}

.team-action-hint-slot {
  flex: none;
  display: flex;
  align-items: flex-end;
}

.team-action-hint-slot .inline-hint {
  width: 100%;
}

.team-select-sheet-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 90;
  display: flex;
  align-items: flex-end;
  justify-content: center;
  background: rgba(17, 24, 39, 0.42);
  box-sizing: border-box;
  animation: team-select-sheet-mask-in 225ms ease-out both;
}

.team-select-sheet-panel {
  width: 100%;
  max-height: 76vh;
  display: flex;
  flex-direction: column;
  padding: 24rpx 32rpx calc(32rpx + env(safe-area-inset-bottom));
  overflow: hidden;
  background: #ffffff;
  border-radius: 56rpx 56rpx 0 0;
  box-shadow: 0 -20rpx 48rpx rgba(17, 24, 39, 0.18);
  box-sizing: border-box;
  animation: team-select-sheet-panel-in 225ms cubic-bezier(0.2, 0, 0.1, 1) both;
}

.team-select-sheet-grabber {
  width: 72rpx;
  height: 8rpx;
  flex: none;
  margin: 0 auto 22rpx;
  border-radius: 999rpx;
  background: #dee2e6;
}

.team-select-sheet-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  flex: none;
  margin-bottom: 24rpx;
}

.team-select-sheet-title {
  min-width: 0;
  flex: 1;
  color: #212529;
  font-size: 32rpx;
  font-weight: 800;
  line-height: 1.35;
}

.team-select-sheet-count {
  flex: none;
  padding: 8rpx 16rpx;
  color: #868e96;
  border: 1rpx solid #e9ecef;
  border-radius: 999rpx;
  font-size: 22rpx;
  line-height: 1.2;
}

.team-select-sheet-list {
  max-height: 520rpx;
  flex: none;
  overflow: hidden;
}

.team-select-sheet-option {
  min-height: 112rpx;
  display: flex;
  align-items: center;
  gap: 18rpx;
  margin-bottom: 14rpx;
  padding: 18rpx 20rpx;
  color: #212529;
  border: 1rpx solid #e9ecef;
  border-radius: 28rpx;
  background: #f5f6f7;
  box-sizing: border-box;
}

.team-select-sheet-option:last-child {
  margin-bottom: 0;
}

.team-select-sheet-option.selected {
  border-color: #212529;
  background: #ffffff;
}

.team-select-sheet-avatar {
  width: 72rpx;
  height: 72rpx;
  flex: none;
  border-radius: 50%;
  background: #e9ecef;
  overflow: hidden;
}

.team-select-sheet-avatar-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #687787;
  font-size: 26rpx;
  font-weight: 800;
}

.team-select-sheet-copy {
  min-width: 0;
  flex: 1;
}

.team-select-sheet-name,
.team-select-sheet-role {
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.team-select-sheet-name {
  color: #212529;
  font-size: 28rpx;
  font-weight: 800;
  line-height: 1.35;
}

.team-select-sheet-role {
  margin-top: 6rpx;
  color: #868e96;
  font-size: 22rpx;
  line-height: 1.35;
}

.team-select-sheet-radio {
  width: 32rpx;
  height: 32rpx;
  flex: none;
  border: 3rpx solid #adb5bd;
  border-radius: 50%;
  box-sizing: border-box;
}

.team-select-sheet-option.selected .team-select-sheet-radio {
  border: 9rpx solid #212529;
}

.team-select-sheet-actions {
  display: flex;
  gap: 16rpx;
  flex: none;
  margin-top: 24rpx;
}

.team-select-sheet-cancel,
.team-select-sheet-confirm {
  height: 72rpx;
  flex: 1;
  margin: 0;
  padding: 0 24rpx;
  font-size: 25rpx;
  font-weight: 700;
  line-height: 72rpx;
  border: 0;
  border-radius: 999rpx;
  box-sizing: border-box;
}

.team-select-sheet-cancel::after,
.team-select-sheet-confirm::after {
  border: 0;
}

.team-select-sheet-cancel {
  color: #212529;
  background: #f1f3f5;
}

.team-select-sheet-confirm {
  color: #ffffff;
  background: #212529;
}

.team-select-sheet-confirm[disabled] {
  color: #495057;
  background: #ced4da;
  opacity: 1;
}

@keyframes team-select-sheet-mask-in {
  from { opacity: 0; }
  to { opacity: 1; }
}

@keyframes team-select-sheet-panel-in {
  from { transform: translateY(36rpx); }
  to { transform: translateY(0); }
}
