@import "../../../styles/portfolio-render-shared.wxss";

.visitor-portfolio-page {
  background: #ffffff;
}

.visitor-scroll {
  height: 100vh;
}

.folio-component {
  margin-top: 34rpx;
}

.folio-carousel {
  width: 100%;
  height: 760rpx;
  background: #f3f4f6;
}

.carousel-image,
.work-cover {
  display: block;
  width: 100%;
  height: 100%;
}

.profile-section,
.simple-section,
.qr-section,
.text-section {
  padding: 8rpx 34rpx;
  text-align: center;
  box-sizing: border-box;
}

.profile-avatar {
  display: block;
  margin: 0 auto;
  width: 132rpx;
  height: 132rpx;
  border-radius: 50%;
}

.profile-name {
  margin-top: 18rpx;
  color: #17202a;
  font-size: 36rpx;
  font-weight: 900;
  line-height: 1.25;
}

.profile-line,
.profile-bio,
.section-desc,
.text-content,
.work-desc {
  color: #59636f;
  font-size: 26rpx;
  line-height: 1.75;
  white-space: pre-wrap;
}

.profile-line {
  margin-top: 8rpx;
}

.profile-bio {
  display: block;
  margin: 22rpx auto 0;
  max-width: 620rpx;
}

.profile-tags {
  display: flex;
  align-items: center;
  gap: 22rpx;
}

.profile-tags {
  justify-content: center;
  flex-wrap: wrap;
  margin-top: 22rpx;
}

.profile-tag {
  color: #6b7280;
  font-size: 24rpx;
  line-height: 1.4;
}

.component-title {
  padding: 0 24rpx;
  color: #17202a;
  font-size: 32rpx;
  font-weight: 900;
  line-height: 1.35;
  box-sizing: border-box;
}

.work-section-title {
  padding: 0 24rpx;
  color: #000000;
  font-size: 34rpx;
  font-weight: 900;
  line-height: 1.35;
  box-sizing: border-box;
}

.work-card {
  min-width: 0;
  box-sizing: border-box;
}

.work-cover-wrap {
  position: relative;
  width: 100%;
  overflow: hidden;
  background: #f3f4f6;
}

.grid-card .work-cover-wrap {
  height: 236rpx;
}

.list-card .work-cover-wrap {
  height: 430rpx;
}

.work-play-badge {
  position: absolute;
  right: 16rpx;
  bottom: 16rpx;
  width: 54rpx;
  height: 54rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2rpx solid rgba(255, 255, 255, 0.82);
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.48);
  box-sizing: border-box;
}

.work-play-icon {
  width: 0;
  height: 0;
  margin-left: 5rpx;
  border-top: 10rpx solid transparent;
  border-bottom: 10rpx solid transparent;
  border-left: 16rpx solid #ffffff;
}

.work-title {
  overflow: hidden;
  margin-top: 10rpx;
  color: #17202a;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 1.35;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.secondary-action,
.primary-button {
  width: 260rpx;
  height: 72rpx;
  margin: 24rpx auto 0;
  padding: 0;
  font-size: 26rpx;
  line-height: 72rpx;
  border-radius: 8rpx;
}

.secondary-action {
  color: #17202a;
  border: 1rpx solid #d8dee5;
  background: #ffffff;
}

.primary-button {
  color: #ffffff;
  background: #17202a;
}

.qr-image {
  display: block;
  width: 280rpx;
  height: 280rpx;
  margin: 24rpx auto 0;
}

.text-content {
  display: block;
  margin-top: 12rpx;
  text-align: left;
}

.folio-brand-footer {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  padding: 56rpx 0 calc(160rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.folio-brand-logo {
  width: 56rpx;
  height: 56rpx;
}

.folio-brand-name {
  color: #a1a9b3;
  font-size: 24rpx;
  font-weight: 800;
  line-height: 1.4;
}

.work-video-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 80;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 32rpx 24rpx calc(32rpx + env(safe-area-inset-bottom));
  opacity: 0;
  pointer-events: none;
  background: rgba(0, 0, 0, 0.82);
  box-sizing: border-box;
  transition: opacity 180ms ease;
}

.work-video-mask.visible {
  opacity: 1;
  pointer-events: auto;
}

.work-video-panel {
  width: 100%;
  display: flex;
  flex-direction: column;
  gap: 18rpx;
  transform: translateY(18rpx) scale(0.97);
  transition: transform 220ms cubic-bezier(0.18, 0, 0.12, 1);
}

.work-video-mask.visible .work-video-panel {
  transform: translateY(0) scale(1);
}

.work-video-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.work-video-title {
  flex: 1 1 auto;
  min-width: 0;
  overflow: hidden;
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 900;
  line-height: 1.3;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.work-video-close {
  width: 58rpx;
  height: 58rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
  color: #ffffff;
  font-size: 36rpx;
  font-weight: 700;
  line-height: 1;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.18);
}

.work-video-player {
  width: 100%;
  height: 62vh;
  max-height: 720rpx;
  overflow: hidden;
  border-radius: 12rpx;
  background: #000000;
}

.visitor-profile-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 120;
  display: block;
  background: rgba(10, 16, 24, 0.56);
  box-sizing: border-box;
}

.visitor-profile-panel {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  width: 100%;
  max-height: 78vh;
  padding: 34rpx 34rpx calc(32rpx + env(safe-area-inset-bottom));
  overflow-y: auto;
  border-radius: 28rpx 28rpx 0 0;
  background: #ffffff;
  box-shadow: 0 -18rpx 52rpx rgba(17, 24, 39, 0.22);
  box-sizing: border-box;
}

.visitor-profile-title {
  color: #17202a;
  font-size: 34rpx;
  font-weight: 900;
  line-height: 1.3;
}

.visitor-profile-desc {
  margin-top: 10rpx;
  color: #667085;
  font-size: 24rpx;
  line-height: 1.5;
}

.visitor-profile-form {
  display: flex;
  align-items: flex-start;
  gap: 24rpx;
  margin-top: 30rpx;
}

.visitor-avatar-field {
  width: 160rpx;
  display: flex;
  align-items: center;
  flex: none;
  flex-direction: column;
}

.visitor-avatar-control {
  position: relative;
  width: 116rpx;
  height: 116rpx;
  flex: none;
}

.visitor-avatar-visual {
  width: 116rpx;
  height: 116rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1rpx solid #e3e8ee;
  border-radius: 50%;
  overflow: hidden;
  background: #f3f6fa;
  box-sizing: border-box;
}

.visitor-avatar-picker {
  position: absolute;
  left: 0;
  top: 0;
  z-index: 1;
  width: 116rpx;
  height: 116rpx;
  min-width: 116rpx;
  margin: 0;
  padding: 0;
  opacity: 0;
  border: 0;
  border-radius: 50%;
  background: transparent;
  line-height: normal;
  box-sizing: border-box;
}

.visitor-avatar-picker::after {
  border: 0;
}

.visitor-avatar-preview {
  display: block;
  width: 100%;
  height: 100%;
}

.visitor-avatar-placeholder {
  width: 116rpx;
  height: 116rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-direction: column;
  gap: 8rpx;
}

.visitor-avatar-placeholder-head {
  width: 32rpx;
  height: 32rpx;
  border-radius: 50%;
  background: #98a2b3;
}

.visitor-avatar-placeholder-body {
  width: 56rpx;
  height: 26rpx;
  border-radius: 999rpx 999rpx 18rpx 18rpx;
  background: #98a2b3;
}

.visitor-avatar-label {
  margin-top: 12rpx;
  color: #667085;
  font-size: 22rpx;
  font-weight: 700;
  line-height: 1.3;
  text-align: center;
  white-space: nowrap;
}

.visitor-nickname-field {
  flex: 1 1 auto;
  min-width: 0;
  padding-top: 12rpx;
  box-sizing: border-box;
}

.visitor-nickname-input {
  width: 100%;
  height: 88rpx;
  padding: 0 28rpx;
  color: #17202a;
  font-size: 30rpx;
  line-height: 88rpx;
  border: 1rpx solid #d9e0e8;
  border-radius: 14rpx;
  background: #f8fafc;
  box-sizing: border-box;
}

.visitor-nickname-placeholder {
  color: #98a2b3;
}

.visitor-profile-actions {
  display: flex;
  gap: 18rpx;
  margin-top: 34rpx;
}

.visitor-profile-secondary,
.visitor-profile-primary {
  flex: 1;
  height: 76rpx;
  margin: 0;
  padding: 0;
  font-size: 28rpx;
  font-weight: 800;
  line-height: 76rpx;
  border: 0;
  border-radius: 10rpx;
  box-sizing: border-box;
}

.visitor-profile-secondary::after,
.visitor-profile-primary::after {
  border: 0;
}

.visitor-profile-secondary {
  color: #17202a;
  background: #eef2f6;
}

.visitor-profile-primary {
  color: #ffffff;
  background: #17202a;
}

.maintenance-mask {
  position: fixed;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.78);
  backdrop-filter: blur(12rpx);
}

.maintenance-panel {
  padding: 42rpx;
  text-align: center;
}

.maintenance-primary {
  color: #17202a;
  font-size: 34rpx;
  font-weight: 900;
  letter-spacing: 0;
}

.maintenance-secondary {
  margin-top: 12rpx;
  color: #6b7787;
  font-size: 26rpx;
}
