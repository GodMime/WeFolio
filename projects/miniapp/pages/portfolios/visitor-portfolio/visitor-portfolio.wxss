@import "../../../styles/portfolio-theme.wxss";
@import "../../../styles/portfolio-menu-transition.wxss";

.visitor-portfolio-page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  color: var(--portfolio-text-primary);
}

.visitor-scroll {
  flex: 1;
  min-height: 0;
  background: transparent;
}

.folio-component {
  margin-top: 32rpx;
}

.folio-carousel {
  width: 100%;
  height: 760rpx;
  border-radius: 40rpx;
  background: #f1f3f5;
}

.carousel-image {
  display: block;
  width: 100%;
  height: 100%;
}

.secondary-action,
.primary-button {
  width: 260rpx;
  height: 96rpx;
  margin: 24rpx auto 0;
  padding: 0;
  font-size: 26rpx;
  line-height: 96rpx;
  border-radius: 999rpx;
}

.secondary-action {
  color: #212529;
  border: 1rpx solid #dee2e6;
  background: #f5f6f7;
}

.primary-button {
  color: #ffffff;
  background: #212529;
}

.folio-brand-footer {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  padding: 56rpx 0 calc(160rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.folio-brand-logo {
  width: 56rpx;
  height: 56rpx;
}

.folio-brand-name {
  color: var(--portfolio-text-muted);
  font-size: 24rpx;
  font-weight: 800;
  line-height: 1.4;
}

.work-video-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 80;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 32rpx 24rpx calc(32rpx + env(safe-area-inset-bottom));
  opacity: 0;
  pointer-events: none;
  background: rgba(0, 0, 0, 0.82);
  box-sizing: border-box;
  transition: opacity 180ms ease;
}

.work-video-mask.visible {
  opacity: 1;
  pointer-events: auto;
}

.work-video-panel {
  width: 100%;
  display: flex;
  flex-direction: column;
  gap: 18rpx;
  transform: translateY(18rpx) scale(0.97);
  transition: transform 220ms cubic-bezier(0.18, 0, 0.12, 1);
}

.work-video-mask.visible .work-video-panel {
  transform: translateY(0) scale(1);
}

.work-video-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.work-video-title {
  flex: 1 1 auto;
  min-width: 0;
  overflow: hidden;
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 900;
  line-height: 1.3;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.work-video-close {
  width: 58rpx;
  height: 58rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
  color: #ffffff;
  font-size: 36rpx;
  font-weight: 700;
  line-height: 1;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.18);
}

.work-video-player {
  width: 100%;
  height: 62vh;
  max-height: 720rpx;
  overflow: hidden;
  border-radius: 40rpx;
  background: #000000;
}

.visitor-profile-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 120;
  display: block;
  background: rgba(10, 16, 24, 0.56);
  box-sizing: border-box;
}

.visitor-profile-panel {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  width: 100%;
  max-height: 78vh;
  padding: 34rpx 34rpx calc(32rpx + env(safe-area-inset-bottom));
  overflow-y: auto;
  border-radius: 56rpx 56rpx 0 0;
  background: #ffffff;
  box-shadow: 0 -18rpx 52rpx rgba(17, 24, 39, 0.22);
  box-sizing: border-box;
}

.visitor-profile-title {
  color: #212529;
  font-size: 34rpx;
  font-weight: 900;
  line-height: 1.3;
}

.visitor-profile-desc {
  margin-top: 10rpx;
  color: #868e96;
  font-size: 24rpx;
  line-height: 1.5;
}

.visitor-profile-form {
  display: flex;
  align-items: flex-start;
  gap: 24rpx;
  margin-top: 30rpx;
}

.visitor-avatar-field {
  width: 160rpx;
  display: flex;
  align-items: center;
  flex: none;
  flex-direction: column;
}

.visitor-avatar-control {
  position: relative;
  width: 116rpx;
  height: 116rpx;
  flex: none;
}

.visitor-avatar-visual {
  width: 116rpx;
  height: 116rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1rpx solid #e3e8ee;
  border-radius: 50%;
  overflow: hidden;
  background: #f3f6fa;
  box-sizing: border-box;
}

.visitor-avatar-picker {
  position: absolute;
  left: 0;
  top: 0;
  z-index: 1;
  width: 116rpx;
  height: 116rpx;
  min-width: 116rpx;
  margin: 0;
  padding: 0;
  opacity: 0;
  border: 0;
  border-radius: 50%;
  background: transparent;
  line-height: normal;
  box-sizing: border-box;
}

.visitor-avatar-picker::after {
  border: 0;
}

.visitor-avatar-preview {
  display: block;
  width: 100%;
  height: 100%;
}

.visitor-avatar-placeholder {
  width: 116rpx;
  height: 116rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-direction: column;
  gap: 8rpx;
}

.visitor-avatar-placeholder-head {
  width: 32rpx;
  height: 32rpx;
  border-radius: 50%;
  background: #98a2b3;
}

.visitor-avatar-placeholder-body {
  width: 56rpx;
  height: 26rpx;
  border-radius: 999rpx 999rpx 18rpx 18rpx;
  background: #98a2b3;
}

.visitor-avatar-label {
  margin-top: 12rpx;
  color: #667085;
  font-size: 22rpx;
  font-weight: 700;
  line-height: 1.3;
  text-align: center;
  white-space: nowrap;
}

.visitor-avatar-label.invalid {
  color: #d92d20;
}

.visitor-nickname-field {
  flex: 1 1 auto;
  min-width: 0;
  padding-top: 12rpx;
  box-sizing: border-box;
}

.visitor-nickname-input {
  width: 100%;
  height: 88rpx;
  padding: 0 28rpx;
  color: #212529;
  font-size: 30rpx;
  line-height: 88rpx;
  border: 1rpx solid #d9e0e8;
  border-radius: 24rpx;
  background: #f5f6f7;
  box-sizing: border-box;
}

.visitor-nickname-placeholder {
  color: #98a2b3;
}

.visitor-avatar-visual.invalid,
.visitor-nickname-input.invalid {
  border-color: #d92d20;
  background: #fff7f7;
}

.visitor-profile-error {
  margin-top: 8rpx;
  color: #d92d20;
  font-size: 20rpx;
  font-weight: 700;
  line-height: 1.3;
}

.visitor-avatar-error {
  text-align: center;
  white-space: nowrap;
}

.visitor-nickname-error {
  text-align: left;
}

.visitor-avatar-field.shake,
.visitor-nickname-field.shake {
  animation: visitor-profile-shake 320ms ease-in-out;
}

@keyframes visitor-profile-shake {
  0%,
  100% {
    transform: translateX(0);
  }

  25% {
    transform: translateX(-8rpx);
  }

  75% {
    transform: translateX(8rpx);
  }
}

.visitor-profile-actions {
  display: flex;
  gap: 18rpx;
  margin-top: 34rpx;
}

.visitor-profile-secondary,
.visitor-profile-primary {
  flex: 1;
  height: 96rpx;
  margin: 0;
  padding: 0;
  font-size: 28rpx;
  font-weight: 800;
  line-height: 96rpx;
  border: 0;
  border-radius: 999rpx;
  box-sizing: border-box;
}

.clipboard-prompt-card {
  position: fixed;
  left: 50%;
  bottom: calc(160rpx + env(safe-area-inset-bottom));
  z-index: 10020;
  max-width: calc(100vw - 96rpx);
  padding: 22rpx 30rpx;
  color: #ffffff;
  font-size: 25rpx;
  font-weight: 800;
  line-height: 1.45;
  text-align: center;
  border: 1rpx solid rgba(255, 255, 255, 0.26);
  border-radius: 24rpx;
  background: rgba(33, 37, 41, 0.94);
  box-shadow: 0 16rpx 42rpx rgba(0, 0, 0, 0.22);
  transform: translateX(-50%);
  box-sizing: border-box;
}

.visitor-profile-secondary::after,
.visitor-profile-primary::after {
  border: 0;
}

.visitor-profile-secondary {
  color: #212529;
  background: #e9ecef;
}

.visitor-profile-primary {
  color: #ffffff;
  background: #212529;
}

.maintenance-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.78);
  backdrop-filter: blur(12rpx);
}

.maintenance-panel {
  padding: 42rpx;
  text-align: center;
}

.maintenance-primary {
  color: #212529;
  font-size: 34rpx;
  font-weight: 900;
  letter-spacing: 0;
}

.maintenance-secondary {
  margin-top: 12rpx;
  color: #6b7787;
  font-size: 26rpx;
}
