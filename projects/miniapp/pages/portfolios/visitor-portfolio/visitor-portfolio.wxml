<view class="page-shell visitor-portfolio-page">
  <navigation-bar title="{{portfolio.title || '个人作品集'}}" back="{{showNavigationBack && !timelineGuideVisible}}" color="#212529" background="#ffffff"></navigation-bar>

  <scroll-view scroll-y class="visitor-scroll">
    <view wx:for="{{portfolio.components}}" wx:key="componentKey" class="folio-component">
      <block wx:if="{{item.componentType === 'CAROUSEL'}}">
        <portfolio-carousel works="{{item.works}}" interval="{{item.carouselIntervalMs}}"></portfolio-carousel>
      </block>

      <block wx:elif="{{item.componentType === 'PROFILE'}}">
        <portfolio-profile
          profile="{{item.profile}}"
          bindpreviewqr="handlePreviewQr"
        ></portfolio-profile>
      </block>

      <block wx:elif="{{item.componentType === 'WORK_GRID'}}">
        <portfolio-work-grid
          component-key="{{item.componentKey}}"
          display-tags="{{item.displayTags}}"
          active-group="{{item.activeGroup}}"
          show-title="{{item.showTitle}}"
          show-description="{{item.showDescription}}"
          switching="{{displaySwitchingComponentKey === item.componentKey}}"
          binddisplaytagtap="handleDisplayTagTap"
          bindworktap="handleWorkTap"
        ></portfolio-work-grid>
      </block>

      <block wx:elif="{{item.componentType === 'WORK_LIST'}}">
        <portfolio-work-list
          component-key="{{item.componentKey}}"
          display-tags="{{item.displayTags}}"
          active-group="{{item.activeGroup}}"
          show-title="{{item.showTitle}}"
          show-description="{{item.showDescription}}"
          switching="{{displaySwitchingComponentKey === item.componentKey}}"
          binddisplaytagtap="handleDisplayTagTap"
          bindworktap="handleWorkTap"
        ></portfolio-work-list>
      </block>

      <block wx:elif="{{item.componentType === 'SINGLE_WORK'}}">
        <portfolio-single-work
          component-key="{{item.componentKey}}"
          work="{{item.work}}"
          show-title="{{item.showTitle}}"
          show-description="{{item.showDescription}}"
          active-video-key="{{activeSingleWorkVideoKey}}"
          repair-mode="{{false}}"
          class="portfolio-single-work-instance"
          bindsingleworktap="handleSingleWorkTap"
          bindvideoerror="handleSingleWorkVideoError"
        ></portfolio-single-work>
      </block>

      <block wx:elif="{{item.componentType === 'SCHEDULE_QUERY'}}">
        <portfolio-schedule-query
          share-code="{{shareCode}}"
          visitor-key="{{visitorKey}}"
          preview="{{false}}"
          component-key="{{item.componentKey}}"
          schedule-query="{{item.scheduleQuery}}"
        ></portfolio-schedule-query>
      </block>

      <block wx:elif="{{item.componentType === 'QR_CONTACT'}}">
        <portfolio-qr-contact
          qr-contact="{{item.qrContact}}"
          bindpreviewqr="handlePreviewQr"
        ></portfolio-qr-contact>
      </block>

      <block wx:elif="{{item.componentType === 'CONTACT_FORM'}}">
        <portfolio-contact-form
          contact-component="{{item}}"
          contact-form="{{contactForm}}"
          bindcontactinput="handleContactInput"
          bindsubmitcontact="handleSubmitContact"
          bindopenmodal="handleOpenContactFormModal"
        ></portfolio-contact-form>
      </block>

      <block wx:elif="{{item.componentType === 'TEXT_SECTION'}}">
        <portfolio-text-section text-section="{{item.textSection}}"></portfolio-text-section>
      </block>

      <block wx:elif="{{item.componentType === 'DIVIDER'}}">
        <portfolio-divider divider="{{item.divider}}"></portfolio-divider>
      </block>
    </view>

    <view class="folio-brand-footer">
      <image class="folio-brand-logo" src="/assets/system/folio-logo-stack-bold-small-50kb.png" mode="aspectFit"></image>
      <view class="folio-brand-name">映期Folio</view>
    </view>
  </scroll-view>

  <root-portal wx:if="{{videoPreviewVisible}}">
    <view class="work-video-mask {{videoPreviewVisible ? 'visible' : ''}}" catchtap="handleCloseVideoPreview">
      <view class="work-video-panel" catchtap="handleVideoPreviewPanelTap">
        <view class="work-video-heading">
          <view class="work-video-title">{{videoPreview.title}}</view>
          <view class="work-video-close" catchtap="handleCloseVideoPreview" aria-role="button" aria-label="关闭视频">×</view>
        </view>
        <video
          id="portfolioWorkVideo"
          class="work-video-player"
          src="{{videoPreview.src}}"
          poster="{{videoPreview.poster}}"
          controls="{{true}}"
          autoplay="{{true}}"
          show-fullscreen-btn="{{true}}"
          show-center-play-btn="{{true}}"
          enable-progress-gesture="{{true}}"
          object-fit="contain"
        ></video>
      </view>
    </view>
  </root-portal>

  <portfolio-contact-form
    view-mode="modal"
    modal-visible="{{contactFormModalVisible}}"
    contact-component="{{activeContactFormComponent}}"
    contact-form="{{contactForm}}"
    bindcontactinput="handleContactInput"
    bindsubmitcontact="handleSubmitContact"
    bindclosemodal="handleCloseContactFormModal"
  ></portfolio-contact-form>

  <root-portal wx:if="{{visitorProfileAuthVisible}}">
    <view class="visitor-profile-mask" catchtap="handleVisitorProfileMaskTap" catchtouchmove="handleVisitorProfileMaskTouchMove">
      <view class="visitor-profile-panel" catchtap="handleVisitorProfilePanelTap">
        <view class="visitor-profile-title">完善访客资料</view>
        <view class="visitor-profile-desc">选择头像并填写昵称，维护者查看访客记录时能识别你。</view>
        <view class="visitor-profile-form">
          <view class="visitor-avatar-field {{visitorProfileAvatarError && visitorProfileValidationShaking ? 'shake' : ''}}">
            <view class="visitor-avatar-control">
              <view class="visitor-avatar-visual {{visitorProfileAvatarError ? 'invalid' : ''}}">
                <image wx:if="{{visitorProfileForm.avatarUrl}}" class="visitor-avatar-preview" src="{{visitorProfileForm.avatarUrl}}" mode="aspectFill"></image>
                <view wx:else class="visitor-avatar-placeholder">
                  <view class="visitor-avatar-placeholder-head"></view>
                  <view class="visitor-avatar-placeholder-body"></view>
                </view>
              </view>
              <button class="visitor-avatar-picker" open-type="chooseAvatar" bindchooseavatar="handleVisitorAvatarChoose" aria-label="点击选择头像"></button>
            </view>
            <view class="visitor-avatar-label {{visitorProfileAvatarError ? 'invalid' : ''}}">点击选择头像</view>
            <view wx:if="{{visitorProfileAvatarError}}" class="visitor-profile-error visitor-avatar-error">请点击选择头像</view>
          </view>
          <view class="visitor-nickname-field {{visitorProfileNicknameError && visitorProfileValidationShaking ? 'shake' : ''}}">
            <input
              class="visitor-nickname-input {{visitorProfileNicknameError ? 'invalid' : ''}}"
              type="nickname"
              value="{{visitorProfileForm.nickname}}"
              placeholder="输入昵称或选择微信昵称"
              placeholder-class="visitor-nickname-placeholder"
              bindinput="handleVisitorNicknameInput"
            />
            <view wx:if="{{visitorProfileNicknameError}}" class="visitor-profile-error visitor-nickname-error">请点击输入或选择昵称</view>
          </view>
        </view>
        <view class="visitor-profile-actions">
          <button class="visitor-profile-secondary" bindtap="handleVisitorProfileSkip">跳过</button>
          <button class="visitor-profile-primary" loading="{{visitorProfileSaving}}" bindtap="handleVisitorProfileSubmit">保存</button>
        </view>
      </view>
    </view>
  </root-portal>

  <view wx:if="{{portfolio.underMaintenance}}" class="maintenance-mask">
    <view class="maintenance-panel">
      <view class="maintenance-primary">UNDER MAINTENANCE</view>
      <view class="maintenance-secondary">维护中</view>
    </view>
  </view>

  <timeline-share-guide
    visible="{{timelineGuideVisible}}"
    back="{{showNavigationBack}}"
    bindback="handleTimelineGuideBack"
    bindclose="handleCloseTimelineGuide"
  ></timeline-share-guide>
</view>
