.portfolio-edit-page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  background: #f5f6f7;
}

.edit-scroll {
  flex: 1;
  min-height: 0;
}

.edit-content {
  padding: 20rpx 32rpx calc(156rpx + env(safe-area-inset-bottom));
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  box-sizing: border-box;
}

.panel {
  background: #ffffff;
  border: 1rpx solid #e9ecef;
  border-radius: 48rpx;
  box-shadow: 0 16rpx 40rpx rgba(33, 37, 41, 0.05);
  box-sizing: border-box;
}

.share-panel,
.page-setting-panel,
.component-panel {
  padding: 28rpx;
}

.background-color-row,
.bottom-nav-count-row,
.editor-menu-bar,
.editor-menu-rename {
  display: flex;
  align-items: center;
}

.background-color-row {
  gap: 20rpx;
  margin-top: 16rpx;
}

.background-color-swatch {
  width: 56rpx;
  height: 56rpx;
  flex: none;
  border: 1rpx solid #dee2e6;
  border-radius: 50%;
  box-sizing: border-box;
}

.background-color-current {
  width: 92rpx;
  height: 56rpx;
  flex: none;
  border: 1rpx solid #dee2e6;
  border-radius: 20rpx;
  box-sizing: border-box;
}

.background-color-swatch.active {
  box-shadow: 0 0 0 4rpx #ffffff, 0 0 0 8rpx #212529;
}

.background-custom-button {
  min-width: 116rpx;
  height: 56rpx;
  margin: 0;
  padding: 0 22rpx;
  color: #212529;
  font-size: 23rpx;
  font-weight: 700;
  line-height: 56rpx;
  border-radius: 999rpx;
  background: #f1f3f5;
}

.bottom-nav-count-row {
  gap: 12rpx;
  margin-top: 16rpx;
}

.bottom-nav-count-option {
  flex: 1;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #212529;
  font-size: 24rpx;
  font-weight: 700;
  border-radius: 999rpx;
  background: #f1f3f5;
}

.bottom-nav-count-option.active {
  color: #ffffff;
  background: #212529;
}

.editor-menu-bar {
  gap: 8rpx;
  margin-top: 20rpx;
  padding: 8rpx;
  border-radius: 999rpx;
  background: #212529;
}

.editor-menu-item {
  flex: 1;
  min-width: 0;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: rgba(255, 255, 255, 0.62);
  font-size: 24rpx;
  font-weight: 700;
  border-radius: 999rpx;
  gap: 10rpx;
}

.editor-menu-item.active {
  color: #212529;
  background: #ffffff;
}

.editor-menu-error-dot {
  width: 12rpx;
  height: 12rpx;
  flex: none;
  border-radius: 50%;
  background: #b55656;
}

.editor-menu-error-banner {
  margin-top: 16rpx;
  padding: 18rpx 24rpx;
  color: #b55656;
  font-size: 24rpx;
  font-weight: 600;
  line-height: 1.5;
  border-radius: 32rpx;
  background: rgba(181, 86, 86, 0.08);
}

.editor-menu-rename {
  gap: 16rpx;
  margin-top: 16rpx;
}

.editor-menu-title-input {
  flex: 1;
  height: 72rpx;
  padding: 0 24rpx;
  font-size: 24rpx;
  font-weight: 700;
  border-radius: 999rpx;
  background: #f1f3f5;
  box-sizing: border-box;
}

.editor-menu-title-count {
  flex: none;
  color: #adb5bd;
  font-size: 22rpx;
}

.editor-menu-remove {
  height: 64rpx;
  margin: 0;
  padding: 0 22rpx;
  color: #b55656;
  font-size: 22rpx;
  line-height: 64rpx;
  border-radius: 999rpx;
  background: #fff1f1;
}

.background-color-panel {
  gap: 16rpx;
}

.background-color-pad {
  position: relative;
  height: 360rpx;
  overflow: hidden;
  border: 1rpx solid #e9ecef;
  border-radius: 40rpx;
}

.background-color-pad-white,
.background-color-pad-black {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
}

.background-color-pad-white {
  background: linear-gradient(to right, #ffffff, rgba(255, 255, 255, 0));
}

.background-color-pad-black {
  background: linear-gradient(to top, #000000, rgba(0, 0, 0, 0));
}

.background-color-pad-dot {
  position: absolute;
  width: 36rpx;
  height: 36rpx;
  border: 6rpx solid #ffffff;
  border-radius: 50%;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.35);
  transform: translate(-50%, -50%);
  box-sizing: border-box;
}

.background-hue-slider {
  position: relative;
  height: 32rpx;
  margin-top: 24rpx;
  border-radius: 999rpx;
  background: linear-gradient(to right, #ff3b30, #ffcc00, #34c759, #0a84ff, #5856d6, #af52de, #ff3b30);
}

.background-hue-slider slider {
  position: absolute;
  left: 0;
  right: 0;
  top: 50%;
  z-index: 2;
  width: 100%;
  margin: 0;
  transform: translateY(-50%);
}

.background-hue-thumb {
  position: absolute;
  top: 50%;
  z-index: 1;
  width: 44rpx;
  height: 44rpx;
  border: 6rpx solid #ffffff;
  border-radius: 50%;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.3);
  transform: translate(-50%, -50%);
  box-sizing: border-box;
  pointer-events: none;
}

.background-hex-input {
  height: 84rpx;
  margin-top: 28rpx;
  padding: 0 28rpx;
  color: #212529;
  font-size: 26rpx;
  font-weight: 700;
  border-radius: 999rpx;
  background: #f5f6f7;
  box-sizing: border-box;
}

.background-color-preview-bar {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-top: 20rpx;
  padding: 16rpx 24rpx;
  border: 1rpx solid #e9ecef;
  border-radius: 40rpx;
}

.background-color-preview-chip {
  width: 80rpx;
  height: 56rpx;
  flex: none;
  border: 1rpx solid #e9ecef;
  border-radius: 20rpx;
}

.background-color-preview-text {
  color: #868e96;
  font-size: 24rpx;
}

.component-picker-confirm {
  width: 148rpx;
  height: 60rpx;
  margin: 0;
  padding: 0;
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 800;
  line-height: 60rpx;
  border-radius: 999rpx;
  background: #212529;
}

.editor-component-empty {
  min-height: 208rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  border: 3rpx dashed #dee2e6;
  border-radius: 48rpx;
  background: #ffffff;
}

.editor-component-empty-text {
  color: #adb5bd;
  font-size: 24rpx;
}

.editor-component-empty-action {
  min-width: 220rpx;
  height: 72rpx;
  margin: 0;
  padding: 0 28rpx;
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 72rpx;
  border-radius: 999rpx;
  background: #212529;
}

.panel-heading,
.field-heading,
.component-row,
.bottom-actions,
.link-button,
.action-button,
.status-pill,
.component-order,
.component-drag-handle,
.component-row-arrow,
.component-remove-button,
.component-picker-heading,
.component-picker-count,
.component-picker-actions,
.component-picker-cancel,
.component-option,
.component-option-plus,
.component-option-added,
.component-work-option,
.component-work-check,
.component-work-actions,
.component-work-cancel,
.component-work-confirm,
.component-work-state,
.component-work-retry,
.component-work-tools,
.component-work-search,
.component-work-search-clear,
.component-work-filter-row,
.component-work-filter-pill,
.component-work-footer,
.component-work-meta-row,
.component-work-ratio,
.profile-refresh-button,
.profile-visibility-option,
.display-group-pill,
.display-group-main,
.display-group-count,
.display-group-order,
.display-group-work-meta-row,
.display-group-work-ratio,
.display-group-work-order,
.cover-row,
.cover-preview,
.cover-empty {
  display: flex;
  align-items: center;
}

.panel-heading,
.component-row {
  justify-content: space-between;
}

.panel-heading {
  gap: 20rpx;
}

.heading-copy,
.component-copy {
  flex: 1 1 auto;
  min-width: 0;
}

.component-copy {
  display: flex;
  align-items: center;
}

.component-copy.with-summary {
  flex-direction: column;
  align-items: flex-start;
  justify-content: center;
}

.component-summary {
  max-width: 100%;
  overflow: hidden;
  color: #7b8794;
  font-size: 21rpx;
  font-weight: 700;
  line-height: 1.35;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.section-title {
  color: #212529;
  font-size: 32rpx;
  font-weight: 900;
  line-height: 1.25;
}

.section-desc {
  margin-top: 8rpx;
  color: #697786;
  font-size: 24rpx;
  line-height: 1.45;
}

.status-pill {
  flex: none;
  min-width: 96rpx;
  height: 48rpx;
  justify-content: center;
  padding: 0 18rpx;
  color: #c08a3e;
  font-size: 22rpx;
  font-weight: 800;
  line-height: 1;
  border: 1rpx solid #ead8bc;
  border-radius: 999rpx;
  background: #fbf6ed;
  box-sizing: border-box;
}

.status-pill.published {
  color: #5c9e6e;
  border-color: #c7ddcd;
  background: #f1f7f2;
}

.status-pill.muted {
  color: #697786;
  border-color: #d5dee8;
  background: #f1f4f7;
}

.form-row {
  margin-top: 24rpx;
}

.field-heading {
  justify-content: space-between;
}

.field-label {
  color: #5f6b7a;
  font-size: 24rpx;
  font-weight: 800;
  line-height: 1.3;
}

.field-limit {
  flex: none;
  color: #8b96a3;
  font-size: 22rpx;
  font-weight: 700;
  line-height: 1.3;
}

.input {
  width: 100%;
  min-height: 84rpx;
  margin-top: 12rpx;
  padding: 0 22rpx;
  color: #212529;
  font-size: 28rpx;
  line-height: 84rpx;
  border-radius: 24rpx;
  background: #f1f3f5;
  box-sizing: border-box;
}

.textarea {
  height: 188rpx;
  min-height: 188rpx;
  padding-top: 20rpx;
  padding-bottom: 20rpx;
  line-height: 1.55;
}

.cover-row {
  gap: 20rpx;
  margin-top: 12rpx;
  align-items: flex-start;
}

.cover-preview {
  width: 360rpx;
  height: 288rpx;
  flex: 0 0 360rpx;
  justify-content: center;
  overflow: hidden;
  border: 1rpx solid #e9ecef;
  border-radius: 32rpx;
  background: #f1f3f5;
  box-sizing: border-box;
}

.cover-preview image {
  width: 100%;
  height: 100%;
}

.cover-empty {
  justify-content: center;
  width: 100%;
  height: 100%;
  color: #8793a0;
  font-size: 24rpx;
  font-weight: 800;
}

.link-button {
  width: 136rpx;
  min-width: 136rpx;
  max-width: 136rpx;
  height: 56rpx;
  flex: 0 0 136rpx;
  justify-content: center;
  margin: 0;
  padding: 0;
  color: #495057;
  font-size: 24rpx;
  font-weight: 900;
  line-height: 1;
  border: 1rpx solid #dee2e6;
  border-radius: 999rpx;
  background: #f5f6f7;
  box-sizing: border-box;
}

.component-list {
  margin-top: 24rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.component-swipe-row {
  position: relative;
  overflow: hidden;
  border-radius: 32rpx;
}

.component-swipe-row.dragging {
  z-index: 3;
  overflow: visible;
}

.component-row {
  position: relative;
  z-index: 2;
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 116rpx;
  gap: 16rpx;
  padding: 18rpx;
  border: 1rpx solid #e9ecef;
  border-radius: 32rpx;
  background: #f5f6f7;
  box-shadow: 0 6rpx 22rpx rgba(23, 32, 42, 0.04);
  box-sizing: border-box;
  transition: transform 180ms ease, box-shadow 160ms ease, border-color 160ms ease, background 160ms ease;
}

.component-row.editable {
  background: #ffffff;
}

.component-swipe-row.revealed .component-row {
  transform: translateX(-140rpx);
}

.component-row.dragging {
  border-color: #b8c9dc;
  background: #eef5fb;
  box-shadow: 0 12rpx 28rpx rgba(23, 32, 42, 0.1);
}

.component-row.drag-target {
  border-color: #212529;
}

.component-row.validation-error {
  border-color: #b55656;
  background: #fff5f5;
  box-shadow: 0 0 0 2rpx rgba(181, 86, 86, 0.12);
}

.component-remove-pane {
  position: absolute;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 1;
  width: 128rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  transform: translateX(100%);
  opacity: 0;
  pointer-events: none;
  transition: transform 180ms ease, opacity 160ms ease;
}

.component-swipe-row.revealed .component-remove-pane {
  transform: translateX(0);
  opacity: 1;
  pointer-events: auto;
}

.component-swipe-row.dragging .component-remove-pane {
  transform: translateX(100%);
  opacity: 0;
  pointer-events: none;
}

.component-remove-button {
  width: 108rpx;
  min-width: 108rpx;
  height: 100%;
  min-height: 100%;
  justify-content: center;
  margin: 0;
  padding: 0;
  color: #b55656;
  font-size: 22rpx;
  font-weight: 800;
  line-height: 1;
  border-radius: 14rpx;
  background: #feecef;
  box-sizing: border-box;
}

.component-order {
  width: 48rpx;
  height: 48rpx;
  flex: none;
  align-self: center;
  justify-content: center;
  color: #ffffff;
  font-size: 22rpx;
  font-weight: 900;
  line-height: 48rpx;
  border-radius: 14rpx;
  background: #212529;
}

.component-drag-handle {
  width: 42rpx;
  height: 48rpx;
  flex: none;
  align-self: center;
  justify-content: center;
  border-radius: 12rpx;
  background: linear-gradient(
    to bottom,
    transparent 0,
    transparent 10rpx,
    #6f7f90 10rpx,
    #6f7f90 14rpx,
    transparent 14rpx,
    transparent 22rpx,
    #6f7f90 22rpx,
    #6f7f90 26rpx,
    transparent 26rpx,
    transparent 34rpx,
    #6f7f90 34rpx,
    #6f7f90 38rpx,
    transparent 38rpx,
    transparent 48rpx
  );
  background-position: center center;
  background-size: 22rpx 48rpx;
  background-repeat: no-repeat;
}

.component-title {
  overflow: hidden;
  color: #212529;
  font-size: 28rpx;
  font-weight: 900;
  line-height: 48rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.component-row-arrow {
  width: 28rpx;
  height: 48rpx;
  flex: none;
  align-self: center;
  justify-content: center;
  color: #697786;
  font-size: 0;
  font-weight: 700;
  line-height: 0;
}

.component-row-arrow-icon {
  width: 16rpx;
  height: 16rpx;
  border-right: 5rpx solid #697786;
  border-bottom: 5rpx solid #697786;
  transform: rotate(-45deg);
  box-sizing: border-box;
}

.component-row-arrow.placeholder {
  visibility: hidden;
}

.component-picker-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 30;
  display: flex;
  align-items: flex-end;
  padding: 0;
  opacity: 0;
  pointer-events: none;
  background: rgba(17, 24, 39, 0.35);
  transition: opacity 225ms ease-out;
  box-sizing: border-box;
}

.component-picker-mask.visible {
  opacity: 1;
  pointer-events: auto;
}

.component-picker-panel {
  width: 100%;
  max-height: 72vh;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  padding: 24rpx 32rpx calc(32rpx + env(safe-area-inset-bottom));
  border: 0;
  border-radius: 56rpx 56rpx 0 0;
  background: #ffffff;
  box-shadow: 0 -20rpx 48rpx rgba(17, 24, 39, 0.18);
  box-sizing: border-box;
  transform: translateY(36rpx);
  transition: transform 225ms cubic-bezier(0.2, 0, 0.1, 1);
}

.component-picker-mask.visible .component-picker-panel {
  transform: translateY(0);
}

.component-picker-grabber {
  width: 72rpx;
  height: 8rpx;
  align-self: center;
  border-radius: 999rpx;
  background: #cbd6df;
}

.component-picker-heading {
  justify-content: space-between;
  gap: 20rpx;
}

.component-picker-title {
  flex: 1;
  min-width: 0;
  color: #111827;
  font-size: 30rpx;
  line-height: 1.25;
  font-weight: 800;
}

.component-picker-count {
  min-height: 48rpx;
  flex: none;
  padding: 0 18rpx;
  color: #536b82;
  font-size: 22rpx;
  font-weight: 800;
  border: 1rpx solid #cbd6df;
  border-radius: 999rpx;
  background: #eef3f7;
  white-space: nowrap;
}

.component-option-scroll {
  height: 46vh;
  min-height: 320rpx;
  max-height: 46vh;
  flex: 1 1 auto;
}

.component-option-list-content {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.component-option {
  width: 100%;
  min-width: 100%;
  max-width: 100%;
  min-height: 106rpx;
  justify-content: space-between;
  margin: 0;
  padding: 18rpx 20rpx;
  border: 1rpx solid #e9ecef;
  border-radius: 28rpx;
  background: #f5f6f7;
  box-sizing: border-box;
}

.component-option.disabled {
  opacity: 0.5;
}

.component-option-copy {
  min-width: 0;
  flex: 1 1 auto;
  text-align: left;
}

.component-option-name {
  color: #17202a;
  font-size: 26rpx;
  font-weight: 900;
  line-height: 1.25;
}

.component-option-desc {
  overflow: hidden;
  margin-top: 8rpx;
  color: #697786;
  font-size: 22rpx;
  line-height: 1.3;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.component-option-plus {
  width: 44rpx;
  height: 44rpx;
  flex: none;
  justify-content: center;
  margin-left: 18rpx;
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 900;
  line-height: 1;
  border-radius: 50%;
  background: #212529;
}

.component-option-added {
  width: auto;
  min-width: 104rpx;
  height: 44rpx;
  flex: none;
  justify-content: center;
  margin-left: 18rpx;
  padding: 0 18rpx;
  color: #ffffff;
  font-size: 22rpx;
  font-weight: 800;
  line-height: 1;
  border-radius: 999rpx;
  background: #212529;
  box-sizing: border-box;
  white-space: nowrap;
}

.component-picker-actions {
  justify-content: flex-end;
}

.component-picker-cancel {
  width: 148rpx;
  height: 60rpx;
  justify-content: center;
  margin: 0;
  padding: 0;
  color: #536b82;
  font-size: 24rpx;
  font-weight: 800;
  line-height: 1;
  border: 1rpx solid #cbd6df;
  border-radius: 999rpx;
  background: #eef3f7;
  box-sizing: border-box;
}

.component-work-picker-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 35;
  display: flex;
  align-items: flex-end;
  padding: 0;
  opacity: 0;
  pointer-events: none;
  background: rgba(17, 24, 39, 0.35);
  transition: opacity 225ms ease-out;
  box-sizing: border-box;
}

.component-work-picker-mask.visible {
  opacity: 1;
  pointer-events: auto;
}

.component-work-picker-panel {
  width: 100%;
  max-height: 76vh;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  padding: 24rpx 32rpx calc(32rpx + env(safe-area-inset-bottom));
  border: 0;
  border-radius: 56rpx 56rpx 0 0;
  background: #ffffff;
  box-shadow: 0 -20rpx 48rpx rgba(17, 24, 39, 0.18);
  box-sizing: border-box;
  transform: translateY(36rpx);
  transition: transform 225ms cubic-bezier(0.2, 0, 0.1, 1);
}

.component-work-list-panel {
  height: calc(76vh - env(safe-area-inset-bottom));
  max-height: calc(76vh - env(safe-area-inset-bottom));
}

.component-work-picker-mask.visible .component-work-picker-panel {
  transform: translateY(0);
}

.component-work-tools {
  width: 100%;
  flex-direction: column;
  align-items: stretch;
  gap: 12rpx;
}

.component-work-search {
  width: 100%;
  height: 64rpx;
  gap: 14rpx;
  padding: 0 18rpx;
  border: 1rpx solid #d4dee8;
  border-radius: 14rpx;
  background: #f8fafc;
  box-sizing: border-box;
