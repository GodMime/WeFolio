@import "../../../styles/portfolio-text-typography.wxss";
@import "../../../styles/portfolio-text-section-editor.wxss";
@import "../../../styles/portfolio-editor-foundation.wxss";

.portfolio-edit-page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.edit-scroll {
  flex: 1;
  min-height: 0;
}

.background-color-row,
.bottom-nav-count-row,
.editor-menu-bar,
.editor-menu-rename {
  display: flex;
  align-items: center;
}

.background-color-row {
  gap: 20rpx;
  margin-top: 16rpx;
}

.background-color-swatch {
  width: 56rpx;
  height: 56rpx;
  flex: none;
  border: 1rpx solid var(--pe-color-border-strong, #DEE2E6);
  border-radius: 50%;
  box-sizing: border-box;
}

.background-color-current {
  width: 92rpx;
  height: 56rpx;
  flex: none;
  border: 1rpx solid var(--pe-color-border-strong, #DEE2E6);
  border-radius: 20rpx;
  box-sizing: border-box;
}

.background-color-swatch.active {
  box-shadow: 0 0 0 4rpx var(--pe-color-surface, #FFFFFF), 0 0 0 8rpx var(--pe-color-text-primary, #212529);
}

.background-custom-button {
  min-width: 116rpx;
  height: 56rpx;
  margin: 0;
  padding: 0 22rpx;
  color: var(--pe-color-text-primary, #212529);
  font-size: 23rpx;
  font-weight: 700;
  line-height: 56rpx;
  border-radius: 999rpx;
  background: var(--pe-color-secondary-disabled, #F1F3F5);
}

.bottom-nav-count-row {
  gap: 12rpx;
  margin-top: 16rpx;
}

.bottom-nav-count-option {
  flex: 1;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--pe-color-text-primary, #212529);
  font-size: 24rpx;
  font-weight: 700;
  border-radius: 999rpx;
  background: var(--pe-color-secondary-disabled, #F1F3F5);
}

.bottom-nav-count-option.active {
  color: var(--pe-color-surface, #FFFFFF);
  background: var(--pe-color-text-primary, #212529);
}

.editor-menu-bar {
  gap: 8rpx;
  margin-top: 20rpx;
  padding: 8rpx;
  border-radius: 999rpx;
  background: var(--pe-color-text-primary, #212529);
}

.editor-menu-item {
  flex: 1;
  min-width: 0;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: rgba(255, 255, 255, 0.62);
  font-size: 24rpx;
  font-weight: 700;
  border-radius: 999rpx;
  gap: 10rpx;
}

.editor-menu-item.active {
  color: var(--pe-color-text-primary, #212529);
  background: var(--pe-color-surface, #FFFFFF);
}

.editor-menu-error-dot {
  width: 12rpx;
  height: 12rpx;
  flex: none;
  border-radius: 50%;
  background: var(--pe-color-danger, #B55656);
}

.editor-menu-error-banner {
  margin-top: 16rpx;
  padding: 18rpx 24rpx;
  color: var(--pe-color-danger, #B55656);
  font-size: 24rpx;
  font-weight: 600;
  line-height: 1.5;
  border-radius: 32rpx;
  background: rgba(181, 86, 86, 0.08);
}

.editor-menu-rename {
  gap: 16rpx;
  margin-top: 16rpx;
}

.editor-menu-title-input {
  flex: 1;
  height: 72rpx;
  padding: 0 24rpx;
  font-size: 24rpx;
  font-weight: 700;
  border-radius: 999rpx;
  background: var(--pe-color-secondary-disabled, #F1F3F5);
  box-sizing: border-box;
}

.editor-menu-title-count {
  flex: none;
  color: var(--pe-color-text-muted, #ADB5BD);
  font-size: 22rpx;
}

.editor-menu-remove {
  height: 64rpx;
  margin: 0;
  padding: 0 22rpx;
  color: var(--pe-color-danger, #B55656);
  font-size: 22rpx;
  line-height: 64rpx;
  border-radius: 999rpx;
  background: var(--pe-color-danger-surface, #FFF1F1);
}

.background-color-panel {
  gap: 16rpx;
}

.background-color-pad {
  position: relative;
  height: 360rpx;
  overflow: hidden;
  border: 1rpx solid var(--pe-color-border, #E9ECEF);
  border-radius: 40rpx;
}

.background-color-pad-white,
.background-color-pad-black {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
}

.background-color-pad-white {
  background: linear-gradient(to right, var(--pe-color-surface, #FFFFFF), rgba(255, 255, 255, 0));
}

.background-color-pad-black {
  background: linear-gradient(to top, #000000, rgba(0, 0, 0, 0));
}

.background-color-pad-dot {
  position: absolute;
  width: 36rpx;
  height: 36rpx;
  border: 6rpx solid var(--pe-color-surface, #FFFFFF);
  border-radius: 50%;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.35);
  transform: translate(-50%, -50%);
  box-sizing: border-box;
}

.background-hue-slider {
  position: relative;
  height: 32rpx;
  margin-top: 24rpx;
  border-radius: 999rpx;
  background: linear-gradient(to right, #ff3b30, #ffcc00, #34c759, #0a84ff, #5856d6, #af52de, #ff3b30);
}

.background-hue-slider slider {
  position: absolute;
  left: 0;
  right: 0;
  top: 50%;
  z-index: 2;
  width: 100%;
  margin: 0;
  transform: translateY(-50%);
}

.background-hue-thumb {
  position: absolute;
  top: 50%;
  z-index: 1;
  width: 44rpx;
  height: 44rpx;
  border: 6rpx solid var(--pe-color-surface, #FFFFFF);
  border-radius: 50%;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.3);
  transform: translate(-50%, -50%);
  box-sizing: border-box;
  pointer-events: none;
}

.background-hex-input {
  margin-top: 28rpx;
  font-weight: 700;
}

.background-color-preview-bar {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-top: 20rpx;
  padding: 16rpx 24rpx;
  border: 1rpx solid var(--pe-color-border, #E9ECEF);
  border-radius: 40rpx;
}

.background-color-preview-chip {
  width: 80rpx;
  height: 56rpx;
  flex: none;
  border: 1rpx solid var(--pe-color-border, #E9ECEF);
  border-radius: 20rpx;
}

.background-color-preview-text {
  color: var(--pe-color-text-secondary, #868E96);
  font-size: 24rpx;
}

.editor-component-empty {
  min-height: 208rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  border: 3rpx dashed var(--pe-color-border-strong, #DEE2E6);
  border-radius: 48rpx;
  background: var(--pe-color-surface, #FFFFFF);
}

.editor-component-empty-text {
  color: var(--pe-color-text-muted, #ADB5BD);
  font-size: 24rpx;
}

.editor-component-empty-action {
  min-width: 220rpx;
  height: 72rpx;
  margin: 0;
  padding: 0 28rpx;
  color: var(--pe-color-surface, #FFFFFF);
  font-size: 24rpx;
  font-weight: 700;
  line-height: 72rpx;
  border-radius: 999rpx;
  background: var(--pe-color-text-primary, #212529);
}

.field-heading,
.link-button,
.status-pill,
.component-drag-handle,
.component-row-arrow,
.component-option,
.component-option-plus,
.component-option-added,
.component-work-option,
.component-work-check,
.component-work-state,
.component-work-retry,
.component-work-tools,
.component-work-search,
.component-work-search-clear,
.component-work-filter-row,
.component-work-filter-pill,
.component-work-footer,
.component-work-meta-row,
.component-work-ratio,
.profile-refresh-button,
.profile-visibility-option,
.display-group-pill,
.display-group-main,
.display-group-count,
.display-group-order,
.display-group-work-meta-row,
.display-group-work-ratio,
.display-group-work-order,
.cover-row,
.cover-preview,
.cover-empty {
  display: flex;
  align-items: center;
}

.heading-copy,
.component-copy {
  flex: 1 1 auto;
  min-width: 0;
}

.component-copy {
  display: flex;
  align-items: center;
}

.component-copy.with-summary {
  flex-direction: column;
  align-items: flex-start;
  justify-content: center;
}

.status-pill {
  flex: none;
  gap: 8rpx;
  color: var(--pe-color-text-secondary, #868E96);
  font-size: 22rpx;
  font-weight: 500;
  line-height: 1.4;
}

.status-pill::before {
  width: 12rpx;
  height: 12rpx;
  flex: none;
  content: "";
  border-radius: 50%;
  background: currentColor;
}

.status-pill.published {
  color: #5c9e6e;
}

.status-pill.muted {
  color: var(--pe-color-text-secondary, #868E96);
}

.form-row {
  margin-top: 24rpx;
}

.field-heading {
  justify-content: space-between;
}

.field-label {
  color: var(--pe-color-text-strong, #495057);
  font-size: 24rpx;
  font-weight: 800;
  line-height: 1.3;
}

.field-limit {
  flex: none;
  color: var(--pe-color-text-muted, #ADB5BD);
  font-size: 22rpx;
  font-weight: 700;
  line-height: 1.3;
}

.cover-row {
  gap: 20rpx;
  margin-top: 12rpx;
  align-items: flex-start;
}

.cover-preview {
  width: 360rpx;
  height: 288rpx;
  flex: 0 0 360rpx;
  justify-content: center;
  overflow: hidden;
  border: 1rpx solid var(--pe-color-border, #E9ECEF);
  border-radius: 32rpx;
  background: var(--pe-color-secondary-disabled, #F1F3F5);
  box-sizing: border-box;
}

.cover-preview image {
  width: 100%;
  height: 100%;
}

.cover-empty {
  justify-content: center;
  width: 100%;
  height: 100%;
  color: var(--pe-color-text-muted, #ADB5BD);
  font-size: 24rpx;
  font-weight: 800;
}

.link-button {
  width: 136rpx;
  min-width: 136rpx;
  max-width: 136rpx;
  height: 56rpx;
  flex: 0 0 136rpx;
  justify-content: center;
  margin: 0;
  padding: 0;
  color: var(--pe-color-text-strong, #495057);
  font-size: 24rpx;
  font-weight: 900;
  line-height: 1;
  border: 1rpx solid var(--pe-color-border-strong, #DEE2E6);
  border-radius: 999rpx;
  background: var(--pe-color-page, #F5F6F7);
  box-sizing: border-box;
}

.component-list {
  margin-top: 24rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.component-swipe-row {
  position: relative;
  overflow: hidden;
  border-radius: var(--pe-radius-control, 28rpx);
}

.component-swipe-row.dragging {
  z-index: 3;
  overflow: visible;
}

.component-swipe-row.revealed .component-row {
  transform: translateX(-140rpx);
}

.component-row.dragging {
  border-color: var(--pe-color-border-strong, #DEE2E6);
  background: var(--pe-color-page, #F5F6F7);
  box-shadow: none;
}

.component-row.drag-target {
  border-color: var(--pe-color-text-primary, #212529);
}

.component-row.validation-error {
  border-color: var(--pe-color-danger, #B55656);
  background: var(--pe-color-danger-surface, #FFF1F1);
  box-shadow: 0 0 0 2rpx var(--pe-color-danger-shadow, rgba(181, 86, 86, 0.12));
}

.component-remove-pane {
  position: absolute;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 1;
  width: 128rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  transform: translateX(100%);
  opacity: 0;
  pointer-events: none;
  transition: transform 180ms ease, opacity 160ms ease;
}

.component-swipe-row.revealed .component-remove-pane {
  transform: translateX(0);
  opacity: 1;
  pointer-events: auto;
}

.component-swipe-row.dragging .component-remove-pane {
  transform: translateX(100%);
  opacity: 0;
  pointer-events: none;
}

.component-drag-handle {
  width: 42rpx;
  height: 48rpx;
  flex: none;
  align-self: center;
  justify-content: center;
  border-radius: 12rpx;
  background: linear-gradient(
    to bottom,
    transparent 0,
    transparent 10rpx,
    #6f7f90 10rpx,
    #6f7f90 14rpx,
    transparent 14rpx,
    transparent 22rpx,
    #6f7f90 22rpx,
    #6f7f90 26rpx,
    transparent 26rpx,
    transparent 34rpx,
    #6f7f90 34rpx,
    #6f7f90 38rpx,
    transparent 38rpx,
    transparent 48rpx
  );
  background-position: center center;
  background-size: 22rpx 48rpx;
  background-repeat: no-repeat;
}

.component-row-arrow {
  width: 28rpx;
  height: 48rpx;
  flex: none;
  align-self: center;
  justify-content: center;
  color: var(--pe-color-text-secondary, #868E96);
  font-size: 0;
  font-weight: 700;
  line-height: 0;
}

.component-row-arrow-icon {
  width: 16rpx;
  height: 16rpx;
  border-right: 5rpx solid var(--pe-color-text-secondary, #868E96);
  border-bottom: 5rpx solid var(--pe-color-text-secondary, #868E96);
  transform: rotate(-45deg);
  box-sizing: border-box;
}

.component-row-arrow.placeholder {
  visibility: hidden;
}

.component-option-scroll {
  height: 46vh;
  min-height: 320rpx;
  max-height: 46vh;
  flex: 1 1 auto;
}

.component-option-list-content {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.component-option {
  width: 100%;
  min-width: 100%;
  max-width: 100%;
  min-height: 106rpx;
  justify-content: space-between;
  margin: 0;
}

.component-option.disabled {
  opacity: 0.5;
}

.component-option-copy {
  min-width: 0;
  flex: 1 1 auto;
  text-align: left;
}

.component-option-name {
  color: var(--pe-color-text-primary, #212529);
  font-size: 26rpx;
  font-weight: 900;
  line-height: 1.25;
}

.component-option-desc {
  overflow: hidden;
  margin-top: 8rpx;
  color: var(--pe-color-text-secondary, #868E96);
  font-size: 22rpx;
  line-height: 1.3;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.component-option-plus {
  width: 44rpx;
  height: 44rpx;
  flex: none;
  justify-content: center;
  margin-left: 18rpx;
  color: var(--pe-color-surface, #FFFFFF);
  font-size: 28rpx;
  font-weight: 900;
  line-height: 1;
  border-radius: 50%;
  background: var(--pe-color-text-primary, #212529);
}

.component-option-added {
  width: auto;
  min-width: 104rpx;
  height: 44rpx;
  flex: none;
  justify-content: center;
  margin-left: 18rpx;
  padding: 0 18rpx;
  color: var(--pe-color-surface, #FFFFFF);
  font-size: 22rpx;
  font-weight: 800;
  line-height: 1;
  border-radius: 999rpx;
  background: var(--pe-color-text-primary, #212529);
  box-sizing: border-box;
  white-space: nowrap;
}

.component-work-tools {
  width: 100%;
  flex-direction: column;
  align-items: stretch;
  gap: 12rpx;
}

.video-carousel-editor-settings {
  width: 100%;
  flex-direction: column;
  align-items: stretch;
  gap: 4rpx;
  padding: 4rpx 0 14rpx;
  border-bottom: 1rpx solid var(--pe-color-border, #E9ECEF);
}

.video-carousel-title-setting,
.video-carousel-switch-setting {
  width: 100%;
  box-sizing: border-box;
}

.video-carousel-title-setting {
  flex-direction: column;
  align-items: stretch;
  gap: 10rpx;
  padding: 8rpx 0 14rpx;
}

.video-carousel-setting-heading,
.video-carousel-switch-setting {
  justify-content: space-between;
  gap: 24rpx;
}

.video-carousel-title-count,
.video-carousel-switch-note {
  color: var(--pe-color-text-secondary, #868E96);
  font-size: 21rpx;
  line-height: 1.35;
}

.video-carousel-title-input {
  width: 100%;
  min-height: 68rpx;
  padding: 0 18rpx;
  border: 1rpx solid var(--pe-color-border-strong, #DEE2E6);
  border-radius: 14rpx;
  background: var(--pe-color-page, #F5F6F7);
  box-sizing: border-box;
}

.video-carousel-switch-setting {
  min-height: 84rpx;
  padding: 14rpx 0;
}

.video-carousel-switch-copy {
  min-width: 0;
  flex: 1 1 0;
  flex-direction: column;
  align-items: flex-start;
  gap: 4rpx;
}

.video-carousel-switch-title {
  color: var(--pe-color-text-primary, #212529);
  font-size: 24rpx;
  font-weight: 800;
  line-height: 1.35;
}

.component-work-actions button[disabled] {
  opacity: 0.42;
}

.component-work-search {
  width: 100%;
  height: 64rpx;
  gap: 14rpx;
  padding: 0 18rpx;
  border: 1rpx solid var(--pe-color-border-strong, #DEE2E6);
  border-radius: 14rpx;
  background: var(--pe-color-page, #F5F6F7);
  box-sizing: border-box;
}

.component-work-search-icon {
  position: relative;
  width: 20rpx;
  height: 20rpx;
  flex: none;
  border: 3rpx solid var(--pe-color-text-muted, #ADB5BD);
  border-radius: 50%;
  box-sizing: border-box;
}

.component-work-search-icon::after {
  content: "";
  position: absolute;
  right: -8rpx;
  bottom: -7rpx;
  width: 10rpx;
  height: 3rpx;
  border-radius: 999rpx;
  background: var(--pe-color-text-muted, #ADB5BD);
  transform: rotate(45deg);
}

.component-work-search-input {
  min-width: 0;
  flex: 1 1 0;
  font-weight: 700;
}

.component-work-search-clear {
  width: 34rpx;
  height: 34rpx;
  flex: none;
  justify-content: center;
  color: var(--pe-color-text-secondary, #868E96);
  font-size: 24rpx;
  font-weight: 900;
  line-height: 1;
  border-radius: 50%;
  background: var(--pe-color-border-strong, #DEE2E6);
}

.component-work-filter-scroll {
  width: 100%;
  height: 58rpx;
  white-space: nowrap;
}

.component-work-filter-row {
  width: auto;
  height: 58rpx;
  min-width: 0;
  display: inline-flex;
  justify-content: flex-start;
  gap: 12rpx;
}

.component-work-filter-pill {
  width: auto;
  max-width: 236rpx;
  height: 50rpx;
  flex: 0 0 auto;
  justify-content: center;
  margin: 0;
  padding: 0 18rpx;
  overflow: hidden;
  color: var(--pe-color-text-secondary, #868E96);
  font-size: 22rpx;
  font-weight: 800;
  line-height: 1;
  text-overflow: ellipsis;
  white-space: nowrap;
  border: 1rpx solid var(--pe-color-border-strong, #DEE2E6);
  border-radius: 999rpx;
  background: var(--pe-color-surface, #FFFFFF);
  box-sizing: border-box;
}

.component-work-filter-dot,
.display-group-dot {
  width: 12rpx;
  height: 12rpx;
  flex: none;
  border-radius: 50%;
  background: var(--pe-color-text-primary, #212529);
}

.component-work-filter-dot {
  margin-right: 10rpx;
}

.component-work-scroll {
  flex: 1 1 auto;
  height: 0;
  min-height: 0;
  max-height: none;
}

.component-work-list-content {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.component-work-option {
  width: 100%;
  min-height: 112rpx;
  gap: 18rpx;
}

.component-work-thumb {
  width: 92rpx;
  height: 76rpx;
  flex: none;
  overflow: hidden;
  border-radius: 12rpx;
  background: var(--pe-color-page, #F5F6F7);
}

.component-work-thumb image {
  width: 100%;
  height: 100%;
}

.component-work-thumb-empty {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--pe-color-text-muted, #ADB5BD);
  font-size: 20rpx;
  font-weight: 800;
}

.component-work-copy {
  min-width: 0;
  flex: 1 1 0;
}

.component-work-title {
  overflow: hidden;
  color: var(--pe-color-text-primary, #212529);
  font-size: 26rpx;
  font-weight: 900;
  line-height: 1.3;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.component-work-meta-row {
  min-width: 0;
  margin-top: 8rpx;
  gap: 10rpx;
}

.component-work-meta {
  min-width: 0;
  flex: 0 1 auto;
  overflow: hidden;
  color: var(--pe-color-text-secondary, #868E96);
  font-size: 22rpx;
  line-height: 1.25;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.component-work-ratio {
  min-height: 32rpx;
  flex: none;
  justify-content: center;
  padding: 0 10rpx;
  color: var(--pe-color-text-secondary, #868E96);
  font-size: 20rpx;
  font-weight: 900;
  line-height: 1;
  border: 1rpx solid var(--pe-color-border-strong, #DEE2E6);
  border-radius: 999rpx;
  background: var(--pe-color-surface, #FFFFFF);
  box-sizing: border-box;
}

