      <view wx:if="{{profileTagErrorText}}" class="profile-tag-error">{{profileTagErrorText}}</view>
      <view class="component-work-actions profile-tag-dialog-actions pe-sheet-actions">
        <button class="pe-sheet-action-cancel" catchtap="handleCloseProfileTagDialog">取消</button>
        <button class="pe-sheet-action-confirm" catchtap="handleAddProfileTag">添加</button>
      </view>
    </view>
  </view>

  <view class="display-group-picker-mask pe-sheet-mask {{displayGroupSheetVisible ? 'pe-sheet-mask-visible' : ''}}" catchtap="handleCloseDisplayGroupSheet">
    <view class="display-group-picker-panel pe-sheet-panel pe-sheet-size-long {{displayGroupSheetVisible ? 'pe-sheet-panel-visible' : ''}}" catchtap="noop">
      <view class="pe-sheet-grabber"></view>
      <view class="pe-sheet-heading">
        <view class="pe-sheet-title">作品集展示标签</view>
        <view class="pe-sheet-meta">{{displayGroupOptions.length}} 个作品标签</view>
      </view>

      <view wx:if="{{displayGroupLoading}}" class="component-work-state">处理中...</view>
      <view wx:elif="{{displayGroupErrorText}}" class="component-work-state error">{{displayGroupErrorText}}</view>

      <scroll-view wx:else class="display-group-scroll" scroll-x>
        <view class="display-group-list-content">
          <view
            wx:for="{{displayGroupOptions}}"
            wx:key="groupKey"
            class="display-group-pill pe-sheet-choice {{item.active ? 'pe-sheet-choice-selected-filled' : ''}}"
            data-group-key="{{item.groupKey}}"
            catchtap="handleSelectDisplayGroup"
            aria-role="button"
            aria-current="{{item.active}}"
            aria-label="选择{{item.name}}"
          >
            <view class="display-group-main">
              <view class="display-group-dot" style="background: {{item.active ? '#ffffff' : item.color}};"></view>
              <view class="display-group-name">{{item.name}}</view>
            </view>
            <view class="display-group-badges">
              <view class="display-group-count">{{item.countText}}</view>
              <view
                class="display-group-order"
                data-tag-id="{{item.id}}"
                catchtap="handleToggleDisplayGroupTag"
                aria-role="checkbox"
                aria-checked="{{item.selected}}"
                aria-label="{{item.selected ? '取消选择' : '选择'}}{{item.name}}作品标签"
              >
                <text>{{item.selectionOrder ? item.selectionOrder : ''}}</text>
              </view>
            </view>
          </view>
        </view>
      </scroll-view>

      <view wx:if="{{!displayGroupLoading && !displayGroupErrorText}}" class="display-group-work-section">
        <view class="display-group-work-header">
          <view class="display-group-work-copy">
            <view class="display-group-work-title">当前作品标签作品</view>
            <view class="display-group-work-count">{{activeDisplayGroupWorkCountText}}</view>
          </view>
        </view>

        <scroll-view wx:if="{{displayGroupWorkOptions.length}}" class="display-group-work-scroll" style="height: {{displayGroupWorkScrollHeight}}rpx;" scroll-y type="list">
          <view class="display-group-work-list">
            <view
              wx:for="{{displayGroupWorkOptions}}"
              wx:key="id"
              class="display-group-work-item pe-sheet-choice {{item.selected ? 'pe-sheet-choice-selected' : ''}}"
              data-id="{{item.id}}"
              catchtap="handleToggleDisplayGroupWork"
              aria-role="checkbox"
              aria-checked="{{item.selected}}"
              aria-label="选择{{item.title}}"
            >
              <view class="display-group-work-thumb">
                <image wx:if="{{item.thumbUrl}}" src="{{item.thumbUrl}}" mode="aspectFill"></image>
                <view wx:else class="display-group-work-thumb-empty">作品</view>
              </view>
              <view class="display-group-work-item-copy">
                <view class="display-group-work-item-title">{{item.title}}</view>
                <view class="display-group-work-meta-row">
                  <view class="display-group-work-item-meta">{{item.metaText}}</view>
                  <view class="display-group-work-ratio">{{item.aspectRatioText}}</view>
                </view>
              </view>
              <view class="display-group-work-order">
                <text>{{item.selectionOrder ? item.selectionOrder : ''}}</text>
              </view>
            </view>
          </view>
        </scroll-view>
        <view wx:else class="display-group-work-empty">该作品标签暂无作品</view>
      </view>

      <view wx:if="{{!displayGroupLoading && !displayGroupErrorText}}" class="single-work-title-setting">
        <view class="single-work-title-setting-copy">
          <view class="single-work-title-setting-label">展示作品标题</view>
          <view class="single-work-title-setting-note">关闭后隐藏作品标题</view>
        </view>
        <switch checked="{{displayGroupShowTitle}}" color="#212529" bindchange="handleDisplayGroupShowTitleChange"></switch>
      </view>
      <view wx:if="{{!displayGroupLoading && !displayGroupErrorText}}" class="single-work-title-setting">
        <view class="single-work-title-setting-copy">
          <view class="single-work-title-setting-label">展示作品说明</view>
          <view class="single-work-title-setting-note">关闭后隐藏作品说明</view>
        </view>
        <switch checked="{{displayGroupShowDescription}}" color="#212529" bindchange="handleDisplayGroupShowDescriptionChange"></switch>
      </view>

      <view class="component-work-actions pe-sheet-actions">
        <button class="pe-sheet-action-cancel" catchtap="handleCancelDisplayGroupSheet">取消</button>
        <button class="pe-sheet-action-confirm" catchtap="handleConfirmDisplayGroupSheet">完成</button>
      </view>
    </view>
  </view>

