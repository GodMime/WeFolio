<wxs module="componentRows" src="./component-rows.wxs"></wxs>

<view class="page-shell portfolio-edit-page">
  <navigation-bar title="标准个人作品集" color="#212529" background="rgba(245, 246, 247, 0.94)"></navigation-bar>

  <scroll-view
    class="edit-scroll"
    scroll-y
    type="list"
    scroll-top="{{editScrollTop}}"
    scroll-into-view="{{validationComponentAnchor}}"
  >
    <view class="edit-content pe-page-content">
      <view class="panel share-panel pe-page-card">
        <view class="panel-heading pe-page-card-heading">
          <view class="heading-copy">
            <view class="section-title pe-page-card-title">分享信息</view>
            <view class="section-desc pe-page-card-description">用于微信分享卡片说明</view>
          </view>
          <view class="status-pill {{statusTone}}">{{statusText}}</view>
        </view>

        <view class="form-row cover-form-row">
          <view class="field-heading">
            <view class="field-label">分享封面</view>
          </view>
          <view class="cover-row">
            <view class="cover-preview" bindtap="handleChooseShareCover" aria-role="button" aria-label="选择分享封面">
              <image wx:if="{{config.share.coverUrl}}" src="{{config.share.coverUrl}}" mode="aspectFill"></image>
              <view wx:else class="cover-empty">封面</view>
            </view>
          </view>
        </view>

        <view class="form-row">
          <view class="field-heading">
            <view class="field-label">作品集标题</view>
            <view class="field-limit">{{shareFieldCounters.title}}</view>
          </view>
          <input class="pe-page-field" placeholder="未命名作品集" value="{{config.share.title}}" data-path="share.title" bindinput="handleShareInput" maxlength="50" />
        </view>
      </view>

      <view class="panel page-setting-panel pe-page-card">
        <view class="panel-heading pe-page-card-heading">
          <view class="heading-copy">
            <view class="section-title pe-page-card-title">页面设置</view>
            <view class="section-desc pe-page-card-description">设置作品集背景与底部导航</view>
          </view>
        </view>

        <view class="form-row">
          <view class="field-heading">
            <view class="field-label">背景色</view>
            <view class="field-limit">{{config.style.backgroundColor}}</view>
          </view>
          <view class="background-color-row">
            <view class="background-color-current" style="background-color: {{config.style.backgroundColor}};"></view>
            <view
              wx:for="{{backgroundColorOptions}}"
              wx:key="*this"
              class="background-color-swatch {{config.style.backgroundColor === item ? 'active' : ''}}"
              style="background-color: {{item}};"
              data-color="{{item}}"
              bindtap="handleBackgroundColorTap"
              aria-role="button"
              aria-label="选择背景色{{item}}"
            ></view>
            <button class="background-custom-button" bindtap="handleOpenBackgroundColorSheet">自定义</button>
          </view>
        </view>

        <view class="form-row">
          <view class="field-heading">
            <view class="field-label">底部导航</view>
            <view class="field-limit">2~4 个菜单</view>
          </view>
          <view class="bottom-nav-count-row">
            <view
              wx:for="{{bottomNavCountOptions}}"
              wx:key="*this"
              class="bottom-nav-count-option {{bottomNavCount === item ? 'active' : ''}}"
              data-count="{{item}}"
              bindtap="handleBottomNavCountTap"
              aria-role="button"
            >{{item === 1 ? '不开启' : item + ' 个'}}</view>
          </view>
        </view>

        <view wx:if="{{config.bottomNav.enabled}}" class="editor-menu-bar">
          <view
            wx:for="{{config.bottomNav.items}}"
            wx:key="key"
            class="editor-menu-item {{activeMenuKey === item.key ? 'active' : ''}}"
            data-key="{{item.key}}"
            bindtap="handleEditorMenuTap"
          >
            <text>{{item.title}}</text>
            <view wx:if="{{validationMenuKey === item.key}}" class="editor-menu-error-dot"></view>
          </view>
        </view>

        <view wx:if="{{validationMenuMessage}}" class="editor-menu-error-banner">{{validationMenuMessage}}</view>

        <view wx:if="{{config.bottomNav.enabled}}" class="editor-menu-rename">
          <input
            class="editor-menu-title-input"
            value="{{activeMenuTitle}}"
            data-key="{{activeMenuKey}}"
            bindinput="handleEditorMenuTitleInput"
            maxlength="5"
          />
          <view class="editor-menu-title-count">{{activeMenuTitleCount}}/5</view>
          <button
            wx:if="{{config.bottomNav.items.length > 2}}"
            class="editor-menu-remove"
            data-key="{{activeMenuKey}}"
            bindtap="handleRemoveEditorMenu"
          >删除菜单</button>
        </view>
      </view>

      <view class="panel component-panel pe-page-card">
        <view class="panel-heading pe-page-card-heading">
          <view class="heading-copy">
            <view class="section-title pe-page-card-title">组件编排</view>
            <view class="section-desc pe-page-card-description">访客将按当前菜单内的顺序浏览内容</view>
          </view>
          <button class="link-button" bindtap="handleOpenComponentSheet">添加组件</button>
        </view>

        <view class="component-list">
          <view
            wx:for="{{activeComponents}}"
            wx:key="componentKey"
            class="component-swipe-row {{revealedComponentKey === item.componentKey ? 'revealed' : ''}} {{draggingIndex === index ? 'dragging' : ''}}"
            data-index="{{index}}"
            data-key="{{item.componentKey}}"
            data-type="{{item.componentType}}"
            bindtouchstart="handleComponentTouchStart"
            bindlongpress="handleComponentDragStart"
            bindtouchmove="handleComponentTouchMove"
            bindtouchend="handleComponentTouchEnd"
            bindtouchcancel="handleComponentTouchCancel"
          >
            <view class="component-remove-pane" catchtap="noop">
              <button class="component-remove-button pe-component-delete" data-key="{{item.componentKey}}" catchtap="handleRemoveComponent">删除</button>
            </view>
            <view
              id="component-row-{{item.componentKey}}"
              class="component-row pe-component-row {{draggingIndex === index ? 'dragging' : ''}} {{dragTargetIndex === index && draggingIndex !== -1 ? 'drag-target' : ''}} {{componentRows.isEditable(item.componentType) ? 'editable' : ''}} {{validationComponentKey === item.componentKey ? 'validation-error' : ''}}"
              style="{{draggingIndex === index ? componentDragStyle : ''}}"
              data-key="{{item.componentKey}}"
              data-type="{{item.componentType}}"
              catchtap="handleComponentTap"
              aria-role="{{componentRows.resolveAriaRole(item.componentType)}}"
              aria-label="{{componentRows.resolveAriaLabel(item.componentType, item.name)}}"
            >
              <view class="component-order pe-component-index">{{index + 1}}</view>
              <view class="component-copy {{item.componentType === 'SINGLE_WORK' || item.componentType === 'HYPERLINK' ? 'with-summary' : ''}}">
                <view class="component-title pe-component-title">{{item.name || item.componentType}}</view>
                <view wx:if="{{item.componentType === 'SINGLE_WORK'}}" class="component-summary pe-component-description">{{componentRows.resolveSingleWorkSummary(item, singleWorkSummaries)}}</view>
                <view wx:elif="{{item.componentType === 'HYPERLINK'}}" class="component-summary pe-component-description">{{componentRows.resolveHyperlinkSummary(item, singleWorkSummaries)}}</view>
              </view>
              <view class="component-drag-handle">
                <view class="component-drag-line"></view>
                <view class="component-drag-line"></view>
                <view class="component-drag-line"></view>
              </view>
              <view class="component-row-arrow {{componentRows.isEditable(item.componentType) ? '' : 'placeholder'}}">
                <view wx:if="{{componentRows.isEditable(item.componentType)}}" class="component-row-arrow-icon"></view>
              </view>
            </view>
          </view>
          <view wx:if="{{activeComponents.length === 0}}" class="editor-component-empty">
            <view class="editor-component-empty-text">当前菜单还没有组件</view>
            <button class="editor-component-empty-action" bindtap="handleOpenComponentSheet">添加组件</button>
          </view>
        </view>
      </view>
    </view>
  </scroll-view>

  <view class="pe-sheet-mask {{backgroundColorSheetVisible ? 'pe-sheet-mask-visible' : ''}}" catchtap="handleCloseBackgroundColorSheet">
    <view class="background-color-panel pe-sheet-panel pe-sheet-size-compact {{backgroundColorSheetVisible ? 'pe-sheet-panel-visible' : ''}}" catchtap="noop">
      <view class="pe-sheet-grabber"></view>
      <view class="pe-sheet-heading">
        <view class="pe-sheet-title">自定义背景色</view>
        <view class="pe-sheet-meta">{{backgroundColorDraft}}</view>
      </view>
      <view
        class="background-color-pad"
        style="background-color: {{backgroundHueColor}};"
        bindtouchstart="handleBackgroundColorPadTouch"
        catchtouchmove="handleBackgroundColorPadTouch"
      >
        <view class="background-color-pad-white"></view>
        <view class="background-color-pad-black"></view>
        <view class="background-color-pad-dot" style="{{backgroundColorPadDotStyle}}"></view>
      </view>
      <view class="background-hue-slider">
        <slider
          min="0"
          max="359"
          value="{{backgroundColorHsv.hue}}"
          bindchanging="handleBackgroundHueChange"
          backgroundColor="transparent"
          activeColor="transparent"
          block-color="transparent"
          block-size="22"
        ></slider>
        <view
          class="background-hue-thumb"
          style="{{backgroundHueThumbStyle}}"
        ></view>
      </view>
      <input
        class="background-hex-input pe-sheet-field"
        value="{{backgroundColorDraft}}"
        bindinput="handleBackgroundHexInput"
        bindblur="handleBackgroundHexBlur"
        maxlength="7"
        placeholder="#FFFFFF"
      />
      <view class="background-color-preview-bar">
        <view class="background-color-preview-chip" style="background-color: {{backgroundColorDraft}};"></view>
        <view class="background-color-preview-text">预览 {{backgroundColorDraft}}</view>
      </view>
      <view class="pe-sheet-actions">
        <button class="pe-sheet-action-cancel" catchtap="handleCloseBackgroundColorSheet">取消</button>
        <button class="pe-sheet-action-confirm" catchtap="handleConfirmBackgroundColor">确定</button>
      </view>
    </view>
  </view>

  <view class="pe-sheet-mask {{componentSheetVisible ? 'pe-sheet-mask-visible' : ''}}" catchtap="handleCloseComponentSheet">
    <view class="pe-sheet-panel pe-sheet-size-compact {{componentSheetVisible ? 'pe-sheet-panel-visible' : ''}}" catchtap="noop">
      <view class="pe-sheet-grabber"></view>
      <view class="pe-sheet-heading">
        <view class="pe-sheet-title">选择组件</view>
        <view class="pe-sheet-meta">{{componentOptions.length}} 个可选</view>
      </view>

      <scroll-view class="component-option-scroll" scroll-y type="list">
        <view class="component-option-list-content">
          <view
            wx:for="{{componentOptions}}"
            wx:key="componentType"
            class="component-option pe-sheet-choice {{item.disabled ? 'disabled' : ''}}"
            data-type="{{item.componentType}}"
            data-disabled="{{item.disabled}}"
            catchtap="handleSelectComponent"
            aria-role="button"
            aria-label="添加{{item.name}}组件"
          >
            <view class="component-option-copy">
              <view class="component-option-name">{{item.name}}</view>
              <view class="component-option-desc">{{item.description}}</view>
            </view>
            <view class="{{item.disabled ? 'component-option-added' : 'component-option-plus'}}">{{item.disabled ? '已添加' : '+'}}</view>
          </view>
        </view>
      </scroll-view>

      <view class="pe-sheet-actions">
        <button class="pe-sheet-action-cancel" catchtap="handleCloseComponentSheet">取消</button>
      </view>
    </view>
  </view>

  <view class="pe-sheet-mask {{hyperlinkSheetVisible ? 'pe-sheet-mask-visible' : ''}}" catchtap="handleCloseHyperlinkSheet">
    <view class="hyperlink-sheet-panel pe-sheet-panel pe-sheet-size-long {{hyperlinkForm.actionType ? '' : 'hyperlink-sheet-panel-initial'}} {{hyperlinkSheetVisible ? 'pe-sheet-panel-visible' : ''}}" catchtap="noop">
      <view class="pe-sheet-grabber"></view>
      <view class="pe-sheet-heading">
        <view class="pe-sheet-title">编辑超链接</view>
        <view class="pe-sheet-meta hyperlink-sheet-meta">二选一配置</view>
      </view>

      <scroll-view class="hyperlink-form-scroll pe-sheet-scroll" scroll-y type="list">
        <view class="hyperlink-form-content">
          <view class="form-row">
            <view class="field-heading">
              <view class="field-label">展示图片（图片 / 动图作品）</view>
            </view>
            <view class="hyperlink-work-current {{hyperlinkForm.workId ? '' : 'hyperlink-work-current-empty'}}">
              <view class="hyperlink-work-current-label">当前已选</view>
              <view wx:if="{{hyperlinkForm.workId}}" class="hyperlink-work-current-content">
                <view class="hyperlink-work-thumbnail">
                  <image
                    wx:if="{{singleWorkSummaryMap[hyperlinkForm.workId] && singleWorkSummaryMap[hyperlinkForm.workId].thumbUrl}}"
                    class="hyperlink-work-thumbnail-image"
                    src="{{singleWorkSummaryMap[hyperlinkForm.workId].thumbUrl}}"
                    mode="aspectFill"
                  ></image>
                  <view wx:else class="hyperlink-work-thumbnail-placeholder">作品图</view>
                </view>
                <view class="hyperlink-work-copy">
                  <view class="hyperlink-work-title">{{hyperlinkWorkSummary}}</view>
                  <view class="hyperlink-work-note">{{singleWorkSummaryMap[hyperlinkForm.workId] ? (singleWorkSummaryMap[hyperlinkForm.workId].metaText || '图片 / 动图作品') : '图片 / 动图作品'}}</view>
                </view>
              </view>
              <view wx:else class="hyperlink-work-current-empty-text">请从下方选择图片或动图作品</view>
            </view>

            <scroll-view wx:if="{{componentWorkFilterTags.length}}" class="hyperlink-work-filter-scroll" scroll-x type="list">
              <view class="component-work-filter-row hyperlink-work-filter-row">
                <view
                  wx:for="{{componentWorkFilterTags}}"
                  wx:key="id"
                  class="component-work-filter-pill pe-sheet-choice {{(!componentWorkSelectedTagId && !item.id) || componentWorkSelectedTagId === item.id ? 'pe-sheet-choice-selected-filled' : ''}}"
                  data-tag-id="{{item.id}}"
                  catchtap="handleComponentWorkTagTap"
                  aria-role="button"
                  aria-label="筛选{{item.name}}"
                >
                  <view
                    class="component-work-filter-dot"
                    style="background: {{((!componentWorkSelectedTagId && !item.id) || componentWorkSelectedTagId === item.id) ? '#ffffff' : (item.color || '#212529')}};"
                  ></view>
                  <text>{{item.labelText}}</text>
                </view>
              </view>
            </scroll-view>

            <view wx:if="{{componentWorkLoading && componentWorkOptions.length === 0}}" class="component-work-state hyperlink-work-state">加载中...</view>
            <view wx:elif="{{componentWorkErrorText && componentWorkOptions.length === 0}}" class="component-work-state hyperlink-work-state error">
              <view>{{componentWorkErrorText}}</view>
              <view class="component-work-retry" catchtap="handleRetryHyperlinkWorks" aria-role="button" aria-label="重新加载超链接作品">重试</view>
            </view>
            <view wx:elif="{{componentWorkOptions.length === 0 && !componentWorkHasMore}}" class="component-work-state hyperlink-work-state">{{componentWorkEmptyText}}</view>
            <scroll-view
              wx:else
              class="hyperlink-work-scroll"
              scroll-x
              type="list"
              lower-threshold="80"
              bindscrolltolower="handleComponentWorkScrollToLower"
            >
              <view class="hyperlink-work-list">
                <view
                  wx:for="{{componentWorkOptions}}"
                  wx:key="id"
                  class="hyperlink-work-option pe-sheet-choice {{item.selected ? 'pe-sheet-choice-selected hyperlink-option-selected' : ''}}"
                  data-id="{{item.id}}"
                  catchtap="handleSelectHyperlinkWork"
                  aria-role="radio"
                  aria-checked="{{item.selected}}"
                  aria-label="选择{{item.title}}"
                >
                  <view class="hyperlink-work-option-thumbnail">
                    <image wx:if="{{item.thumbUrl}}" src="{{item.thumbUrl}}" mode="aspectFill"></image>
                    <view wx:else class="hyperlink-work-option-placeholder">作品</view>
                    <view class="schedule-query-mode-radio">
                      <view class="hyperlink-radio-dot" aria-hidden="true"></view>
                    </view>
                  </view>
                  <view class="hyperlink-work-option-title">{{item.title}}</view>
                  <view class="hyperlink-work-option-meta">{{item.metaText}}</view>
                </view>
                <view wx:if="{{componentWorkLoadingMore}}" class="hyperlink-work-tail">加载更多作品</view>
                <view wx:elif="{{componentWorkErrorText}}" class="hyperlink-work-tail hyperlink-work-tail-retry" catchtap="handleRetryHyperlinkWorks" aria-role="button">{{componentWorkErrorText}} · 重试</view>
                <view wx:elif="{{!componentWorkHasMore && componentWorkOptions.length > 0}}" class="hyperlink-work-tail">已显示全部作品</view>
              </view>
            </scroll-view>
          </view>

          <view class="form-row">
            <view class="field-heading"><view class="field-label">点击行为（二选一）</view></view>
            <view class="hyperlink-choice-list">
              <view
                wx:for="{{hyperlinkActionTypeOptions}}"
                wx:key="value"
                class="hyperlink-choice pe-sheet-choice {{hyperlinkForm.actionType === item.value ? 'pe-sheet-choice-selected hyperlink-option-selected' : ''}} {{hyperlinkForm.actionType && hyperlinkForm.actionType !== item.value ? 'hyperlink-choice-muted' : ''}}"
                data-value="{{item.value}}"
                catchtap="handleHyperlinkActionTypeTap"
                aria-role="radio"
                aria-checked="{{hyperlinkForm.actionType === item.value}}"
              >
                <view class="schedule-query-mode-radio">
                  <view class="hyperlink-radio-dot" aria-hidden="true"></view>
                </view>
                <view class="hyperlink-choice-copy">
                  <view class="hyperlink-choice-title">{{item.label}}</view>
                  <view class="hyperlink-choice-description">{{item.description}}</view>
                </view>
              </view>
            </view>
          </view>

          <view wx:if="{{hyperlinkForm.actionType === 'INTERNAL_PORTFOLIO'}}" class="form-row">
            <view class="field-heading"><view class="field-label">跳转作品集（仅已发布 · 左右滑动单选）</view></view>
            <view wx:if="{{hyperlinkTargetLoading}}" class="component-work-state">加载中...</view>
            <view wx:elif="{{hyperlinkTargetErrorText}}" class="component-work-state error">
              <view>{{hyperlinkTargetErrorText}}</view>
              <view class="component-work-retry" catchtap="handleRetryHyperlinkTargets">重试</view>
            </view>
            <view wx:elif="{{hyperlinkTargetOptions.length === 0}}" class="component-work-state">暂无可跳转的已发布作品集</view>
            <scroll-view wx:else class="hyperlink-target-scroll" scroll-x type="list">
              <view class="hyperlink-target-list">
                <view
                  wx:for="{{hyperlinkTargetOptions}}"
                  wx:key="portfolioId"
                  class="hyperlink-target-option pe-sheet-choice {{hyperlinkForm.targetPortfolioId === item.portfolioId ? 'pe-sheet-choice-selected hyperlink-option-selected' : ''}} {{item.selectable ? '' : 'disabled'}}"
                  data-id="{{item.portfolioId}}"
                  data-selectable="{{item.selectable}}"
                  catchtap="handleSelectHyperlinkTarget"
                  aria-role="radio"
                  aria-checked="{{hyperlinkForm.targetPortfolioId === item.portfolioId}}"
                  aria-disabled="{{!item.selectable}}"
                >
                  <view class="hyperlink-target-cover">
                    <image wx:if="{{item.coverUrl}}" class="hyperlink-target-cover-image" src="{{item.coverUrl}}" mode="aspectFill"></image>
                    <view wx:else class="hyperlink-target-cover-placeholder">封面</view>
                  </view>
                  <view class="hyperlink-target-copy">
                    <view class="hyperlink-target-title">{{item.title}}</view>
                    <view wx:if="{{item.currentSelection}}" class="hyperlink-target-current">当前选择·已失效</view>
                    <view wx:if="{{item.disabledReason}}" class="hyperlink-target-reason">{{item.disabledReason}}</view>
                  </view>
                  <view class="schedule-query-mode-radio">
                    <view class="hyperlink-radio-dot" aria-hidden="true"></view>
                  </view>
                </view>
              </view>
            </scroll-view>
            <view class="hyperlink-field-note hyperlink-target-note">仅展示已发布的个人作品集；左右滑动浏览，点按卡片单选。</view>
          </view>

          <block wx:if="{{hyperlinkForm.actionType === 'EXTERNAL_LINK'}}">
            <view class="form-row">
              <view class="field-heading">
                <view class="field-label">链接 / 分享内容</view>
                <view class="field-limit">{{hyperlinkExternalContentCount}} / {{hyperlinkExternalContentMaxLength}}</view>
              </view>
              <textarea
                class="hyperlink-content-input pe-sheet-field pe-sheet-field-textarea"
                value="{{hyperlinkForm.externalContent}}"
                placeholder="粘贴链接、口令或带说明的分享内容"
                bindinput="handleHyperlinkExternalContentInput"
                maxlength="-1"
              ></textarea>
            </view>
            <view class="form-row">
              <view class="field-heading">
                <view class="field-label">提示语（复制成功后展示）</view>
                <view class="field-limit">{{hyperlinkPromptTextCount}} / {{hyperlinkPromptTextMaxLength}}</view>
              </view>
              <input
                class="hyperlink-prompt-input pe-sheet-field"
                value="{{hyperlinkForm.promptText}}"
                placeholder="请打开小红书粘贴"
                bindinput="handleHyperlinkPromptTextInput"
                maxlength="-1"
              />
            </view>
          </block>

          <view class="form-row hyperlink-icon-switch-row">
            <view class="hyperlink-icon-switch-copy">
              <view class="field-label">展示点击图标</view>
            </view>
            <switch checked="{{hyperlinkForm.showClickIcon}}" color="#212529" bindchange="handleHyperlinkShowIconChange"></switch>
          </view>
          <view wx:if="{{hyperlinkForm.showClickIcon}}" class="form-row">
            <view class="hyperlink-choice-list">
              <view
                wx:for="{{hyperlinkIconPositionOptions}}"
                wx:key="value"
                class="hyperlink-choice hyperlink-position-choice pe-sheet-choice {{hyperlinkForm.iconPosition === item.value ? 'pe-sheet-choice-selected hyperlink-option-selected' : ''}}"
                data-value="{{item.value}}"
                catchtap="handleHyperlinkIconPositionTap"
                aria-role="radio"
                aria-checked="{{hyperlinkForm.iconPosition === item.value}}"
              >
                <view class="schedule-query-mode-radio">
                  <view class="hyperlink-radio-dot" aria-hidden="true"></view>
                </view>
                <view class="hyperlink-choice-copy">
                  <view class="hyperlink-choice-title">{{item.label}}</view>
                  <view class="hyperlink-choice-description">{{item.description}}</view>
                </view>
              </view>
            </view>
          </view>
          <view wx:if="{{!hyperlinkForm.actionType}}" class="hyperlink-sheet-note">选中「内部作品集跳转」后才展示跳转作品集配置；选中「外部链接复制」后才展示链接 / 分享内容与提示语；未选中时对应配置不出现。开关关闭时不展示图标位置选项。</view>
          <view wx:elif="{{hyperlinkForm.actionType === 'INTERNAL_PORTFOLIO'}}" class="hyperlink-sheet-note">预览页与访客页点击图片后跳转到目标作品集，可通过左上角返回来源页。</view>
          <view wx:else class="hyperlink-sheet-note">预览页与访客页点击图片后原样复制整段内容。微信系统「内容已复制」提示结束后，再显示上方维护者提示语，两个提示不叠加。</view>
        </view>
      </scroll-view>

      <view class="hyperlink-sheet-actions pe-sheet-actions">
        <button class="hyperlink-action-cancel pe-sheet-action-cancel" catchtap="handleCloseHyperlinkSheet">取消</button>
        <button class="hyperlink-action-confirm pe-sheet-action-confirm {{hyperlinkForm.actionType ? '' : 'hyperlink-action-confirm-initial'}}" catchtap="handleConfirmHyperlinkConfig">完成</button>
      </view>
    </view>
  </view>

  <view class="pe-sheet-mask {{componentWorkSheetVisible ? 'pe-sheet-mask-visible' : ''}}" catchtap="handleCloseComponentWorkSheet">
    <view class="component-work-list-panel pe-sheet-panel pe-sheet-size-long {{componentWorkSheetVisible ? 'pe-sheet-panel-visible' : ''}}" catchtap="noop">
      <view class="pe-sheet-grabber"></view>
      <view class="pe-sheet-heading">
        <view class="pe-sheet-title">{{componentWorkSheetTitle}}</view>
        <view class="pe-sheet-meta">{{componentWorkSelectedCountText}}</view>
      </view>

      <single-work-picker
        wx:if="{{editingComponentType === 'SINGLE_WORK'}}"
        current-selection="{{componentWorkCurrentSelection}}"
        keyword="{{componentWorkKeyword}}"
        filter-tags="{{componentWorkFilterTags}}"
        selected-tag-id="{{componentWorkSelectedTagId}}"
        options="{{componentWorkOptions}}"
        loading="{{componentWorkLoading}}"
        loading-more="{{componentWorkLoadingMore}}"
        error-text="{{componentWorkErrorText}}"
        empty-text="{{componentWorkEmptyText}}"
        has-more="{{componentWorkHasMore}}"
        show-title="{{componentWorkShowTitle}}"
        show-description="{{componentWorkShowDescription}}"
        bindkeywordchange="handleComponentWorkKeywordInput"
        bindsearch="handleComponentWorkSearchConfirm"
        bindclearsearch="handleClearComponentWorkSearch"
        bindtagchange="handleSingleWorkPickerTagChange"
        bindworkselect="handleSingleWorkPickerSelect"
        bindloadmore="handleComponentWorkScrollToLower"
        bindretryloadmore="handleRetrySingleWorkPicker"
        bindshowtitlechange="handleSingleWorkShowTitleChange"
        bindshowdescriptionchange="handleWorkShowDescriptionChange"
      ></single-work-picker>

      <block wx:else>
      <view wx:if="{{editingComponentType === 'VIDEO_CAROUSEL'}}" class="video-carousel-editor-settings">
        <view class="video-carousel-title-setting">
          <view class="video-carousel-setting-heading">
            <view class="field-label">组件标题</view>
            <view class="video-carousel-title-count">{{videoCarouselTitleCount}} / 10</view>
          </view>
          <input
            class="video-carousel-title-input pe-sheet-field"
            value="{{videoCarouselTitle}}"
            maxlength="-1"
            placeholder="视频作品"
            bindinput="handleVideoCarouselTitleInput"
          />
        </view>
        <view class="video-carousel-switch-setting">
          <view class="video-carousel-switch-copy">
            <view class="video-carousel-switch-title">显示作品标题</view>
            <view class="video-carousel-switch-note">在卡片下方展示每个视频的标题</view>
          </view>
          <switch checked="{{videoCarouselShowTitle}}" color="#212529" bindchange="handleVideoCarouselShowTitleChange" />
        </view>
        <view class="video-carousel-switch-setting">
          <view class="video-carousel-switch-copy">
            <view class="video-carousel-switch-title">显示滑动提示</view>
            <view class="video-carousel-switch-note">提示访客可左右拖动浏览视频</view>
          </view>
          <switch checked="{{videoCarouselShowSwipeHint}}" color="#212529" bindchange="handleVideoCarouselShowSwipeHintChange" />
        </view>
      </view>
      <view class="component-work-tools">
        <view class="component-work-search">
          <view class="component-work-search-icon"></view>
          <input
            class="component-work-search-input pe-sheet-field"
            value="{{componentWorkKeyword}}"
            confirm-type="search"
            placeholder="搜索作品名称"
            placeholder-class="search-placeholder"
            bindinput="handleComponentWorkKeywordInput"
            bindconfirm="handleComponentWorkSearchConfirm"
          />
          <view wx:if="{{componentWorkKeyword}}" class="component-work-search-clear" catchtap="handleClearComponentWorkSearch" aria-role="button" aria-label="清空作品搜索">
            <text>×</text>
          </view>
        </view>

        <scroll-view wx:if="{{componentWorkFilterTags.length}}" class="component-work-filter-scroll" scroll-x type="list">
          <view class="component-work-filter-row">
            <view
              wx:for="{{componentWorkFilterTags}}"
              wx:key="id"
              class="component-work-filter-pill pe-sheet-choice {{(!componentWorkSelectedTagId && !item.id) || componentWorkSelectedTagId === item.id ? 'pe-sheet-choice-selected-filled' : ''}}"
              data-tag-id="{{item.id}}"
              catchtap="handleComponentWorkTagTap"
              aria-role="button"
              aria-label="筛选{{item.name}}"
            >
              <view
                class="component-work-filter-dot"
                style="background: {{((!componentWorkSelectedTagId && !item.id) || componentWorkSelectedTagId === item.id) ? '#ffffff' : (item.color || '#212529')}};"
              ></view>
              <text>{{item.labelText}}</text>
            </view>
          </view>
        </scroll-view>
      </view>

      <view wx:if="{{componentWorkLoading}}" class="component-work-state">加载中...</view>
      <view wx:elif="{{componentWorkErrorText}}" class="component-work-state error">
        <view>{{componentWorkErrorText}}</view>
        <view class="component-work-retry" catchtap="handleRetryLoadComponentWorks" aria-role="button" aria-label="重新加载作品">重试</view>
      </view>
      <view wx:elif="{{componentWorkOptions.length === 0}}" class="component-work-state">{{componentWorkEmptyText}}</view>
      <scroll-view wx:else class="component-work-scroll" scroll-y type="list" bindscrolltolower="handleComponentWorkScrollToLower">
        <view class="component-work-list-content">
          <view
            wx:for="{{componentWorkOptions}}"
            wx:key="id"
            class="component-work-option pe-sheet-choice {{item.selected ? 'pe-sheet-choice-selected' : ''}}"
            data-id="{{item.id}}"
            catchtap="handleToggleComponentWork"
            aria-role="{{componentWorkSelectionMode === 'single' ? 'radio' : 'checkbox'}}"
            aria-checked="{{item.selected}}"
            aria-label="选择{{item.title}}"
          >
            <view class="component-work-thumb">
              <image wx:if="{{item.thumbUrl}}" src="{{item.thumbUrl}}" mode="aspectFill"></image>
              <view wx:else class="component-work-thumb-empty">{{editingComponentType === 'VIDEO_CAROUSEL' ? '视频' : '图片'}}</view>
            </view>
            <view class="component-work-copy">
              <view class="component-work-title">{{item.title}}</view>
              <view class="component-work-meta-row">
                <view class="component-work-meta">{{item.metaText}}</view>
                <view class="component-work-ratio">{{item.aspectRatioText}}</view>
                <view class="component-work-ratio">{{item.durationText}}</view>
              </view>
            </view>
            <view class="component-work-check {{editingComponentType === 'CAROUSEL' || editingComponentType === 'VIDEO_CAROUSEL' ? 'carousel-order' : ''}}">{{editingComponentType === 'CAROUSEL' || editingComponentType === 'VIDEO_CAROUSEL' ? (item.selectionOrder || '') : (item.selected ? '✓' : '')}}</view>
          </view>
          <view wx:if="{{componentWorkLoadingMore}}" class="component-work-footer">加载更多作品</view>
          <view wx:if="{{!componentWorkHasMore && componentWorkOptions.length > 0}}" class="component-work-footer">已显示全部作品</view>
        </view>
      </scroll-view>
      </block>

      <view class="component-work-actions pe-sheet-actions">
        <button class="pe-sheet-action-cancel" catchtap="handleCloseComponentWorkSheet">取消</button>
        <button class="pe-sheet-action-confirm" catchtap="handleConfirmComponentWorks" disabled="{{editingComponentType === 'VIDEO_CAROUSEL' && videoCarouselSelectedWorks.length < 3}}">完成</button>
      </view>
    </view>
  </view>

  <view class="profile-sheet-mask pe-sheet-mask {{profileSheetVisible ? 'pe-sheet-mask-visible' : ''}}" catchtap="handleCloseProfileSheet">
    <view class="profile-sheet-panel pe-sheet-panel pe-sheet-size-long {{profileSheetVisible ? 'pe-sheet-panel-visible' : ''}}" catchtap="noop">
      <view class="pe-sheet-grabber"></view>
      <view class="pe-sheet-heading">
        <view class="pe-sheet-title">编辑个人资料</view>
        <button class="profile-refresh-button {{profileSheetLoading ? 'pe-action-loading' : ''}}" catchtap="handleRefreshProfileFromBase" loading="{{profileSheetLoading}}" disabled="{{profileSheetLoading}}">从基础资料刷新</button>
      </view>

      <view wx:if="{{profileSheetErrorText}}" class="component-work-state error profile-sheet-error">{{profileSheetErrorText}}</view>

      <scroll-view class="profile-form-scroll profile-sheet-scroll pe-sheet-scroll" scroll-y type="list">
        <view class="profile-form-list-content">
          <view class="profile-sheet-fields-panel">
            <view class="form-row">
              <view class="profile-avatar-editor">
                <view class="profile-avatar-preview" catchtap="handleChooseProfileAvatar">
                  <image wx:if="{{profileForm.avatarUrl}}" src="{{profileForm.avatarUrl}}" mode="aspectFill"></image>
                  <view wx:else class="profile-avatar-placeholder">头像</view>
                </view>
                <view class="profile-avatar-copy">
                  <view class="field-label">头像</view>
                  <view class="profile-avatar-state">{{profileForm.avatarUrl ? '已选择' : '未选择'}}</view>
                </view>
                <button class="profile-avatar-button" catchtap="handleChooseProfileAvatar">更换头像</button>
              </view>
            </view>
            <view class="form-row">
              <view class="field-heading">
                <view class="field-label">姓名 / 艺名</view>
                <view class="profile-field-limit">{{profileFieldCounters.displayName}}</view>
              </view>
              <input class="profile-sheet-input pe-sheet-field" value="{{profileForm.displayName}}" data-field="displayName" bindinput="handleProfileInput" maxlength="50" />
            </view>
            <view class="form-row">
              <view class="field-heading">
                <view class="field-label">职业身份</view>
                <view class="profile-field-limit">{{profileFieldCounters.profession}}</view>
              </view>
              <input class="profile-sheet-input pe-sheet-field" value="{{profileForm.profession}}" data-field="profession" bindinput="handleProfileInput" maxlength="50" />
            </view>
            <view class="form-row">
              <view class="field-heading">
                <view class="field-label">服务城市</view>
                <view class="profile-field-limit">{{profileFieldCounters.city}}</view>
              </view>
              <input class="profile-sheet-input pe-sheet-field" value="{{profileForm.city}}" data-field="city" bindinput="handleProfileInput" maxlength="50" />
            </view>
            <view class="form-row">
              <view class="field-heading">
                <view class="field-label">个人简介</view>
                <view class="profile-field-limit">{{profileFieldCounters.bio}}</view>
              </view>
              <textarea class="profile-sheet-textarea pe-sheet-field pe-sheet-field-textarea" value="{{profileForm.bio}}" data-field="bio" bindinput="handleProfileInput" maxlength="500"></textarea>
            </view>
            <view class="form-row profile-tag-form-row">
              <view class="field-heading">
                <view class="field-label">个人标签</view>
                <view class="profile-field-limit">{{profileForm.tags.length}} / 10</view>
              </view>
              <view class="profile-tag-pill-row">
                <view class="profile-tag-pill" wx:for="{{profileForm.tags}}" wx:key="content" style="{{item.style}}">
                  <view class="profile-tag-dot" style="{{item.dotStyle}}"></view>
                  <text>{{item.content}}</text>
                  <view
                    class="profile-tag-remove"
                    style="{{item.removeStyle}}"
                    data-index="{{index}}"
                    catchtap="handleRemoveProfileTag"
                    aria-role="button"
                    aria-label="删除标签{{item.content}}"
                  >
                    <text class="profile-tag-remove-mark">×</text>
                  </view>
                </view>
                <button class="profile-tag-add-trigger" catchtap="handleOpenProfileTagDialog">+ 添加标签</button>
              </view>
              <view class="profile-tag-note">标签副本独立于基础资料，单个不超过 10 个字，最多保留 10 个。</view>
            </view>
            <view class="form-row">
              <view class="field-heading">
                <view class="field-label">微信二维码</view>
              </view>
              <view class="profile-qr-editor">
                <view class="profile-qr-preview" catchtap="handleChooseProfileWechatQr" aria-role="button" aria-label="选择微信二维码">
                  <image wx:if="{{profileForm.wechatQrUrl}}" src="{{profileForm.wechatQrUrl}}" mode="aspectFit"></image>
                  <view wx:else class="profile-qr-placeholder">二维码</view>
                </view>
                <view class="profile-avatar-copy">
                  <view class="profile-avatar-state">{{profileForm.wechatQrUrl ? '已选择' : '未选择'}}</view>
                </view>
                <button class="profile-avatar-button" catchtap="handleChooseProfileWechatQr">{{profileForm.wechatQrUrl ? '更换图片' : '选择图片'}}</button>
              </view>
            </view>
          </view>

          <view class="profile-form-section">
            <view class="profile-form-section-title">展示字段</view>
            <view class="profile-visibility-list">
              <view
                wx:for="{{profileVisibleOptions}}"
                wx:key="field"
                class="profile-visibility-option pe-sheet-choice"
              >
                <view class="profile-visibility-label">{{item.label}}</view>
                <switch checked="{{item.checked}}" color="#212529" data-field="{{item.field}}" bindchange="handleProfileVisibleFieldChange" />
              </view>
            </view>
          </view>
        </view>
      </scroll-view>

      <view class="component-work-actions pe-sheet-actions">
        <button class="pe-sheet-action-cancel" catchtap="handleCloseProfileSheet">取消</button>
        <button class="pe-sheet-action-confirm" catchtap="handleConfirmProfileSheet">完成</button>
      </view>
    </view>
  </view>

  <view class="profile-tag-dialog pe-sheet-mask {{profileTagDialogVisible ? 'pe-sheet-mask-visible' : ''}}">
    <view class="profile-tag-dialog-backdrop" catchtap="handleCloseProfileTagDialog"></view>
    <view class="profile-tag-dialog-panel pe-sheet-panel pe-sheet-size-compact {{profileTagDialogVisible ? 'pe-sheet-panel-visible' : ''}}" catchtap="noop">
      <view class="pe-sheet-grabber"></view>
      <view class="pe-sheet-heading">
        <view class="pe-sheet-title">新增标签</view>
        <view class="pe-sheet-meta">{{profileForm.tags.length}} / 10</view>
      </view>
      <view class="form-row">
        <view class="field-label">标签文字</view>
