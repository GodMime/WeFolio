<wxs module="componentRows" src="./component-rows.wxs"></wxs>

<view class="page-shell portfolio-edit-page">
  <navigation-bar title="标准个人作品集" color="#212529" background="rgba(245, 246, 247, 0.94)"></navigation-bar>

  <scroll-view class="edit-scroll" scroll-y type="list">
    <view class="edit-content">
      <view class="panel share-panel">
        <view class="panel-heading">
          <view class="heading-copy">
            <view class="section-title">分享信息</view>
            <view class="section-desc">用于微信分享卡片说明</view>
          </view>
          <view class="status-pill {{statusTone}}">{{statusText}}</view>
        </view>

        <view class="form-row cover-form-row">
          <view class="field-heading">
            <view class="field-label">分享封面</view>
          </view>
          <view class="cover-row">
            <view class="cover-preview" bindtap="handleChooseShareCover" aria-role="button" aria-label="选择分享封面">
              <image wx:if="{{config.share.coverUrl}}" src="{{config.share.coverUrl}}" mode="aspectFill"></image>
              <view wx:else class="cover-empty">封面</view>
            </view>
          </view>
        </view>

        <view class="form-row">
          <view class="field-heading">
            <view class="field-label">作品集标题</view>
            <view class="field-limit">{{shareFieldCounters.title}}</view>
          </view>
          <input class="input" placeholder="未命名作品集" value="{{config.share.title}}" data-path="share.title" bindinput="handleShareInput" maxlength="50" />
        </view>
      </view>

      <view class="panel component-panel">
        <view class="panel-heading">
          <view class="heading-copy">
            <view class="section-title">组件编排</view>
            <view class="section-desc">访客将按当前顺序浏览作品集内容</view>
          </view>
          <button class="link-button" bindtap="handleOpenComponentSheet">添加组件</button>
        </view>

        <view class="component-list">
          <view
            wx:for="{{config.components}}"
            wx:key="componentKey"
            class="component-swipe-row {{revealedComponentKey === item.componentKey ? 'revealed' : ''}} {{draggingIndex === index ? 'dragging' : ''}}"
            data-index="{{index}}"
            data-key="{{item.componentKey}}"
            data-type="{{item.componentType}}"
            bindtouchstart="handleComponentTouchStart"
            bindlongpress="handleComponentDragStart"
            bindtouchmove="handleComponentTouchMove"
            bindtouchend="handleComponentTouchEnd"
            bindtouchcancel="handleComponentTouchCancel"
          >
            <view class="component-remove-pane" catchtap="noop">
              <button class="component-remove-button" data-key="{{item.componentKey}}" catchtap="handleRemoveComponent">删除</button>
            </view>
            <view
              class="component-row {{draggingIndex === index ? 'dragging' : ''}} {{dragTargetIndex === index && draggingIndex !== -1 ? 'drag-target' : ''}} {{componentRows.isEditable(item.componentType) ? 'editable' : ''}}"
              style="{{draggingIndex === index ? componentDragStyle : ''}}"
              data-key="{{item.componentKey}}"
              data-type="{{item.componentType}}"
              catchtap="handleComponentTap"
              aria-role="{{componentRows.resolveAriaRole(item.componentType)}}"
              aria-label="{{componentRows.resolveAriaLabel(item.componentType, item.name)}}"
            >
              <view class="component-order">{{index + 1}}</view>
              <view class="component-copy {{item.componentType === 'SINGLE_WORK' ? 'with-summary' : ''}}">
                <view class="component-title">{{item.name || item.componentType}}</view>
                <view wx:if="{{item.componentType === 'SINGLE_WORK'}}" class="component-summary">{{componentRows.resolveSingleWorkSummary(item, singleWorkSummaries)}}</view>
              </view>
              <view class="component-drag-handle"></view>
              <view class="component-row-arrow {{componentRows.isEditable(item.componentType) ? '' : 'placeholder'}}">
                <view wx:if="{{componentRows.isEditable(item.componentType)}}" class="component-row-arrow-icon"></view>
              </view>
            </view>
          </view>
        </view>
      </view>
    </view>
  </scroll-view>

  <view class="component-picker-mask {{componentSheetVisible ? 'visible' : ''}}" catchtap="handleCloseComponentSheet">
    <view class="component-picker-panel" catchtap="noop">
      <view class="component-picker-grabber"></view>
      <view class="component-picker-heading">
        <view class="component-picker-title">选择组件</view>
        <view class="component-picker-count">{{componentOptions.length}} 个可选</view>
      </view>

      <scroll-view class="component-option-scroll" scroll-y type="list">
        <view class="component-option-list-content">
          <view
            wx:for="{{componentOptions}}"
            wx:key="componentType"
            class="component-option {{item.disabled ? 'disabled' : ''}}"
            data-type="{{item.componentType}}"
            data-disabled="{{item.disabled}}"
            catchtap="handleSelectComponent"
            aria-role="button"
            aria-label="添加{{item.name}}组件"
          >
            <view class="component-option-copy">
              <view class="component-option-name">{{item.name}}</view>
              <view class="component-option-desc">{{item.description}}</view>
            </view>
            <view class="{{item.disabled ? 'component-option-added' : 'component-option-plus'}}">{{item.disabled ? '已添加' : '+'}}</view>
          </view>
        </view>
      </scroll-view>

      <view class="component-picker-actions">
        <button class="component-picker-cancel" catchtap="handleCloseComponentSheet">取消</button>
      </view>
    </view>
  </view>

  <view class="component-work-picker-mask {{componentWorkSheetVisible ? 'visible' : ''}}" catchtap="handleCloseComponentWorkSheet">
    <view class="component-work-list-panel component-work-picker-panel" catchtap="noop">
      <view class="component-picker-grabber"></view>
      <view class="component-picker-heading">
        <view class="component-picker-title">{{componentWorkSheetTitle}}</view>
        <view class="component-picker-count">{{componentWorkSelectedCountText}}</view>
      </view>

      <view class="component-work-tools">
        <view class="component-work-search">
          <view class="component-work-search-icon"></view>
          <input
            class="component-work-search-input"
            value="{{componentWorkKeyword}}"
            confirm-type="search"
            placeholder="搜索作品名称"
            placeholder-class="search-placeholder"
            bindinput="handleComponentWorkKeywordInput"
            bindconfirm="handleComponentWorkSearchConfirm"
          />
          <view wx:if="{{componentWorkKeyword}}" class="component-work-search-clear" catchtap="handleClearComponentWorkSearch" aria-role="button" aria-label="清空作品搜索">
            <text>×</text>
          </view>
        </view>

        <scroll-view wx:if="{{componentWorkFilterTags.length}}" class="component-work-filter-scroll" scroll-x type="list">
          <view class="component-work-filter-row">
            <view
              wx:for="{{componentWorkFilterTags}}"
              wx:key="id"
              class="component-work-filter-pill {{(!componentWorkSelectedTagId && !item.id) || componentWorkSelectedTagId === item.id ? 'active' : ''}}"
              style="{{((!componentWorkSelectedTagId && !item.id) || componentWorkSelectedTagId === item.id) ? item.activeStyle : item.filterStyle}}"
              data-tag-id="{{item.id}}"
              catchtap="handleComponentWorkTagTap"
              aria-role="button"
              aria-label="筛选{{item.name}}"
            >
              <view
                class="component-work-filter-dot"
                style="background: {{((!componentWorkSelectedTagId && !item.id) || componentWorkSelectedTagId === item.id) ? '#ffffff' : (item.color || '#212529')}};"
              ></view>
              <text>{{item.labelText}}</text>
            </view>
          </view>
        </scroll-view>
      </view>

      <view wx:if="{{componentWorkLoading}}" class="component-work-state">加载中...</view>
      <view wx:elif="{{componentWorkErrorText}}" class="component-work-state error">
        <view>{{componentWorkErrorText}}</view>
        <view class="component-work-retry" catchtap="handleRetryLoadComponentWorks" aria-role="button" aria-label="重新加载作品">重试</view>
      </view>
      <view wx:elif="{{componentWorkOptions.length === 0}}" class="component-work-state">{{componentWorkEmptyText}}</view>
      <scroll-view wx:else class="component-work-scroll" scroll-y type="list" bindscrolltolower="handleComponentWorkScrollToLower">
        <view class="component-work-list-content">
          <view
            wx:for="{{componentWorkOptions}}"
            wx:key="id"
            class="component-work-option {{item.selected ? 'selected' : ''}}"
            data-id="{{item.id}}"
            catchtap="handleToggleComponentWork"
            aria-role="{{componentWorkSelectionMode === 'single' ? 'radio' : 'checkbox'}}"
            aria-checked="{{item.selected}}"
            aria-label="选择{{item.title}}"
          >
            <view class="component-work-thumb">
              <image wx:if="{{item.thumbUrl}}" src="{{item.thumbUrl}}" mode="aspectFill"></image>
              <view wx:else class="component-work-thumb-empty">图片</view>
            </view>
            <view class="component-work-copy">
              <view class="component-work-title">{{item.title}}</view>
              <view class="component-work-meta-row">
                <view class="component-work-meta">{{item.metaText}}</view>
                <view class="component-work-ratio">{{item.aspectRatioText}}</view>
              </view>
            </view>
            <view class="component-work-check {{editingComponentType === 'CAROUSEL' ? 'carousel-order' : ''}}">{{editingComponentType === 'CAROUSEL' ? (item.selectionOrder || '') : (item.selected ? '✓' : '')}}</view>
          </view>
          <view wx:if="{{componentWorkLoadingMore}}" class="component-work-footer">加载更多作品</view>
          <view wx:if="{{!componentWorkHasMore && componentWorkOptions.length > 0}}" class="component-work-footer">已显示全部作品</view>
        </view>
      </scroll-view>

      <view wx:if="{{componentWorkSelectionMode === 'single'}}" class="single-work-title-setting">
        <view class="single-work-title-setting-copy">
          <view class="single-work-title-setting-label">展示作品名</view>
          <view class="single-work-title-setting-note">关闭后隐藏作品标题</view>
        </view>
        <switch checked="{{componentWorkShowTitle}}" color="#c28b37" bindchange="handleSingleWorkShowTitleChange"></switch>
      </view>
      <view wx:if="{{componentWorkSelectionMode === 'single'}}" class="single-work-title-setting">
        <view class="single-work-title-setting-copy">
          <view class="single-work-title-setting-label">展示作品说明</view>
          <view class="single-work-title-setting-note">关闭后隐藏作品说明</view>
        </view>
        <switch checked="{{componentWorkShowDescription}}" color="#c28b37" bindchange="handleWorkShowDescriptionChange"></switch>
      </view>

      <view class="component-work-actions">
        <button class="component-work-cancel" catchtap="handleCloseComponentWorkSheet">取消</button>
        <button class="component-work-confirm" catchtap="handleConfirmComponentWorks">完成</button>
      </view>
    </view>
  </view>

  <view class="profile-sheet-mask component-work-picker-mask {{profileSheetVisible ? 'visible' : ''}}" catchtap="handleCloseProfileSheet">
    <view class="profile-sheet-panel component-work-picker-panel" catchtap="noop">
      <view class="component-picker-grabber"></view>
      <view class="component-picker-heading">
        <view class="component-picker-title">编辑个人资料</view>
        <button class="profile-refresh-button" catchtap="handleRefreshProfileFromBase" loading="{{profileSheetLoading}}">从基础资料刷新</button>
      </view>

      <view wx:if="{{profileSheetErrorText}}" class="component-work-state error profile-sheet-error">{{profileSheetErrorText}}</view>

      <scroll-view class="profile-form-scroll profile-sheet-scroll" scroll-y type="list">
        <view class="profile-form-list-content">
          <view class="profile-sheet-fields-panel">
            <view class="form-row">
              <view class="profile-avatar-editor">
                <view class="profile-avatar-preview" catchtap="handleChooseProfileAvatar">
                  <image wx:if="{{profileForm.avatarUrl}}" src="{{profileForm.avatarUrl}}" mode="aspectFill"></image>
                  <view wx:else class="profile-avatar-placeholder">头像</view>
                </view>
                <view class="profile-avatar-copy">
                  <view class="field-label">头像</view>
                  <view class="profile-avatar-state">{{profileForm.avatarUrl ? '已选择' : '未选择'}}</view>
                </view>
                <button class="profile-avatar-button" catchtap="handleChooseProfileAvatar">更换头像</button>
              </view>
            </view>
            <view class="form-row">
              <view class="field-heading">
                <view class="field-label">姓名 / 艺名</view>
                <view class="profile-field-limit">{{profileFieldCounters.displayName}}</view>
              </view>
              <input class="input profile-sheet-input" value="{{profileForm.displayName}}" data-field="displayName" bindinput="handleProfileInput" maxlength="50" />
            </view>
            <view class="form-row">
              <view class="field-heading">
                <view class="field-label">职业身份</view>
                <view class="profile-field-limit">{{profileFieldCounters.profession}}</view>
              </view>
              <input class="input profile-sheet-input" value="{{profileForm.profession}}" data-field="profession" bindinput="handleProfileInput" maxlength="50" />
            </view>
            <view class="form-row">
              <view class="field-heading">
                <view class="field-label">服务城市</view>
                <view class="profile-field-limit">{{profileFieldCounters.city}}</view>
              </view>
              <input class="input profile-sheet-input" value="{{profileForm.city}}" data-field="city" bindinput="handleProfileInput" maxlength="50" />
            </view>
            <view class="form-row">
              <view class="field-heading">
                <view class="field-label">个人简介</view>
                <view class="profile-field-limit">{{profileFieldCounters.bio}}</view>
              </view>
              <textarea class="input textarea profile-sheet-textarea" value="{{profileForm.bio}}" data-field="bio" bindinput="handleProfileInput" maxlength="500"></textarea>
            </view>
            <view class="form-row">
              <view class="field-heading">
                <view class="field-label">个人标签</view>
                <view class="profile-field-limit">{{profileFieldCounters.tagsText}}</view>
              </view>
              <input class="input profile-sheet-input" placeholder="多个标签用逗号分隔" value="{{profileForm.tagsText}}" data-field="tagsText" bindinput="handleProfileInput" maxlength="100" />
            </view>
            <view class="form-row">
              <view class="field-heading">
                <view class="field-label">微信二维码</view>
              </view>
              <view class="profile-qr-editor">
                <view class="profile-qr-preview" catchtap="handleChooseProfileWechatQr" aria-role="button" aria-label="选择微信二维码">
                  <image wx:if="{{profileForm.wechatQrUrl}}" src="{{profileForm.wechatQrUrl}}" mode="aspectFit"></image>
                  <view wx:else class="profile-qr-placeholder">二维码</view>
                </view>
                <view class="profile-avatar-copy">
                  <view class="profile-avatar-state">{{profileForm.wechatQrUrl ? '已选择' : '未选择'}}</view>
                </view>
                <button class="profile-avatar-button" catchtap="handleChooseProfileWechatQr">{{profileForm.wechatQrUrl ? '更换图片' : '选择图片'}}</button>
              </view>
            </view>
          </view>

          <view class="profile-form-section">
            <view class="profile-form-section-title">展示字段</view>
            <view class="profile-visibility-list">
              <view
                wx:for="{{profileVisibleOptions}}"
                wx:key="field"
                class="profile-visibility-option"
              >
                <view class="profile-visibility-label">{{item.label}}</view>
                <switch checked="{{item.checked}}" color="#17202a" data-field="{{item.field}}" bindchange="handleProfileVisibleFieldChange" />
              </view>
            </view>
          </view>
        </view>
      </scroll-view>

      <view class="component-work-actions">
        <button class="component-work-cancel" catchtap="handleCloseProfileSheet">取消</button>
        <button class="component-work-confirm" catchtap="handleConfirmProfileSheet">完成</button>
      </view>
    </view>
  </view>

  <view class="display-group-picker-mask {{displayGroupSheetVisible ? 'visible' : ''}}" catchtap="handleCloseDisplayGroupSheet">
    <view class="display-group-picker-panel" catchtap="noop">
      <view class="component-picker-grabber"></view>
      <view class="component-picker-heading">
        <view class="component-picker-title">作品集展示标签</view>
        <view class="component-picker-count">{{displayGroupOptions.length}} 个作品标签</view>
      </view>

      <view wx:if="{{displayGroupLoading}}" class="component-work-state">处理中...</view>
      <view wx:elif="{{displayGroupErrorText}}" class="component-work-state error">{{displayGroupErrorText}}</view>

      <scroll-view wx:else class="display-group-scroll" scroll-y type="list">
        <view class="display-group-list-content">
          <view
            wx:for="{{displayGroupOptions}}"
            wx:key="groupKey"
            class="display-group-pill {{item.active ? 'active' : ''}} {{item.selected ? 'selected' : ''}}"
            style="{{item.active ? item.activeStyle : item.filterStyle}}"
            data-group-key="{{item.groupKey}}"
            catchtap="handleSelectDisplayGroup"
            aria-role="button"
            aria-label="选择{{item.name}}"
          >
            <view class="display-group-main">
              <view class="display-group-dot" style="background: {{item.active ? '#ffffff' : item.color}};"></view>
              <view class="display-group-name">{{item.name}}</view>
              <view class="display-group-count">{{item.countText}}</view>
            </view>
            <view
              class="display-group-order {{item.selected ? 'selected' : ''}}"
              data-tag-id="{{item.id}}"
              catchtap="handleToggleDisplayGroupTag"
              aria-role="checkbox"
              aria-checked="{{item.selected}}"
              aria-label="{{item.selected ? '取消选择' : '选择'}}{{item.name}}作品标签"
            >
              <text>{{item.selectionOrder ? item.selectionOrder : ''}}</text>
            </view>
          </view>
        </view>
      </scroll-view>

      <view wx:if="{{!displayGroupLoading && !displayGroupErrorText}}" class="display-group-work-section">
        <view class="display-group-work-header">
          <view class="display-group-work-copy">
            <view class="display-group-work-title">当前作品标签作品</view>
            <view class="display-group-work-count">{{activeDisplayGroupWorkCountText}}</view>
          </view>
        </view>

        <scroll-view wx:if="{{displayGroupWorkOptions.length}}" class="display-group-work-scroll" scroll-y type="list">
          <view class="display-group-work-list">
            <view
              wx:for="{{displayGroupWorkOptions}}"
              wx:key="id"
              class="display-group-work-item {{item.selected ? 'selected' : ''}}"
              data-id="{{item.id}}"
              catchtap="handleToggleDisplayGroupWork"
              aria-role="checkbox"
              aria-checked="{{item.selected}}"
              aria-label="选择{{item.title}}"
            >
              <view class="display-group-work-thumb">
                <image wx:if="{{item.thumbUrl}}" src="{{item.thumbUrl}}" mode="aspectFill"></image>
                <view wx:else class="display-group-work-thumb-empty">作品</view>
              </view>
              <view class="display-group-work-item-copy">
                <view class="display-group-work-item-title">{{item.title}}</view>
                <view class="display-group-work-meta-row">
                  <view class="display-group-work-item-meta">{{item.metaText}}</view>
                  <view class="display-group-work-ratio">{{item.aspectRatioText}}</view>
                </view>
              </view>
              <view class="display-group-work-order {{item.selected ? 'selected' : ''}}">
                <text>{{item.selectionOrder ? item.selectionOrder : ''}}</text>
              </view>
            </view>
          </view>
        </scroll-view>
        <view wx:else class="display-group-work-empty">该作品标签暂无作品</view>
      </view>

      <view wx:if="{{!displayGroupLoading && !displayGroupErrorText}}" class="single-work-title-setting">
        <view class="single-work-title-setting-copy">
          <view class="single-work-title-setting-label">展示作品标题</view>
          <view class="single-work-title-setting-note">关闭后隐藏作品标题</view>
        </view>
        <switch checked="{{displayGroupShowTitle}}" color="#c28b37" bindchange="handleDisplayGroupShowTitleChange"></switch>
      </view>
      <view wx:if="{{!displayGroupLoading && !displayGroupErrorText}}" class="single-work-title-setting">
        <view class="single-work-title-setting-copy">
          <view class="single-work-title-setting-label">展示作品说明</view>
          <view class="single-work-title-setting-note">关闭后隐藏作品说明</view>
        </view>
        <switch checked="{{displayGroupShowDescription}}" color="#c28b37" bindchange="handleDisplayGroupShowDescriptionChange"></switch>
      </view>

      <view class="component-work-actions">
        <button class="component-work-cancel" catchtap="handleCancelDisplayGroupSheet">取消</button>
        <button class="component-work-confirm" catchtap="handleConfirmDisplayGroupSheet">完成</button>
      </view>
    </view>
  </view>

  <view class="qr-contact-sheet-mask component-work-picker-mask {{qrContactSheetVisible ? 'visible' : ''}}" catchtap="handleCloseQrContactSheet">
    <view class="qr-contact-sheet-panel component-work-picker-panel" catchtap="noop">
      <view class="component-picker-grabber"></view>
      <view class="component-picker-heading">
        <view class="component-picker-title">编辑二维码联系</view>
        <view class="component-picker-count">{{qrContactForm.qrUrlSource === 'CUSTOM' ? '自定义' : '资料'}}</view>
      </view>

      <scroll-view class="profile-form-scroll" scroll-y type="list">
        <view class="profile-form-list-content">
          <view class="profile-sheet-fields-panel">
            <view class="form-row qr-source-row">
              <view class="field-heading">
                <view class="field-label">二维码来源</view>
              </view>
              <view class="qr-source-tabs" aria-role="tablist">
                <button class="qr-source-tab {{qrContactForm.qrUrlSource !== 'CUSTOM' ? 'active' : ''}}" aria-role="tab" aria-selected="{{qrContactForm.qrUrlSource !== 'CUSTOM'}}" catchtap="handleUseProfileQrContact">个人资料</button>
                <button class="qr-source-tab {{qrContactForm.qrUrlSource === 'CUSTOM' ? 'active' : ''}}" aria-role="tab" aria-selected="{{qrContactForm.qrUrlSource === 'CUSTOM'}}" catchtap="handleUseCustomQrContact">自定义图片</button>
              </view>
              <view class="qr-source-tab-panel" aria-role="tabpanel">
                <view wx:if="{{qrContactForm.qrUrlSource !== 'CUSTOM'}}" class="qr-contact-image-editor">
                  <view class="qr-contact-image-preview profile">
                    <image wx:if="{{qrContactProfileQrUrl}}" src="{{qrContactProfileQrUrl}}" mode="aspectFit"></image>
                    <view wx:else class="qr-contact-image-placeholder">资料</view>
                  </view>
                </view>
                <view wx:else class="qr-contact-image-editor">
                  <view class="qr-contact-image-preview custom" catchtap="handleChooseQrContactImage" aria-role="button" aria-label="选择自定义二维码图片">
                    <image wx:if="{{qrContactForm.qrUrl}}" src="{{qrContactForm.qrUrl}}" mode="aspectFit"></image>
                    <view wx:else class="qr-contact-image-placeholder">二维码</view>
                  </view>
                </view>
              </view>
            </view>
          </view>
        </view>
      </scroll-view>

      <view class="component-work-actions">
        <button class="component-work-cancel" catchtap="handleCloseQrContactSheet">取消</button>
        <button class="component-work-confirm" catchtap="handleConfirmQrContactSheet">完成</button>
      </view>
    </view>
  </view>

  <view class="schedule-query-sheet-mask component-work-picker-mask {{scheduleQuerySheetVisible ? 'visible' : ''}}" catchtap="handleCloseScheduleQuerySheet">
    <view class="schedule-query-sheet-panel component-work-picker-panel" catchtap="noop">
      <view class="component-picker-grabber"></view>
      <view class="component-picker-heading">
        <view class="component-picker-title">编辑档期查询</view>
        <view class="component-picker-count">{{scheduleQueryForm.displayMode === 'INLINE_CALENDAR' ? '内联' : '弹层'}}</view>
      </view>

      <view class="schedule-query-form">
        <view class="form-row">
          <view class="field-heading">
            <view class="field-label">展示方式</view>
          </view>
          <view class="schedule-query-mode-list">
            <view
              wx:for="{{scheduleQueryDisplayModeOptions}}"
              wx:key="value"
              class="schedule-query-mode-option {{scheduleQueryForm.displayMode === item.value ? 'active' : ''}}"
              data-value="{{item.value}}"
              catchtap="handleScheduleQueryDisplayModeTap"
              aria-role="radio"
              aria-checked="{{scheduleQueryForm.displayMode === item.value}}"
            >
              <view class="schedule-query-mode-radio"></view>
              <view class="schedule-query-mode-label">{{item.label}}</view>
            </view>
          </view>
        </view>
      </view>

      <view class="component-work-actions">
        <button class="component-work-cancel" catchtap="handleCloseScheduleQuerySheet">取消</button>
        <button class="component-work-confirm" catchtap="handleConfirmScheduleQueryConfig">完成</button>
      </view>
    </view>
  </view>

  <view class="contact-form-sheet-mask component-work-picker-mask {{contactFormSheetVisible ? 'visible' : ''}}" catchtap="handleCloseContactFormSheet">
    <view class="contact-form-sheet-panel component-work-picker-panel" catchtap="noop">
      <view class="component-picker-grabber"></view>
      <view class="component-picker-heading">
        <view class="component-picker-title">编辑预留联系信息</view>
        <view class="component-picker-count">{{contactFormConfigForm.displayMode === 'INLINE_FORM' ? '直接' : '弹层'}}</view>
      </view>

      <view class="schedule-query-form">
        <view class="form-row">
          <view class="field-heading">
            <view class="field-label">展示方式</view>
          </view>
          <view class="schedule-query-mode-list">
            <view
              wx:for="{{contactFormDisplayModeOptions}}"
              wx:key="value"
              class="schedule-query-mode-option {{contactFormConfigForm.displayMode === item.value ? 'active' : ''}}"
              data-value="{{item.value}}"
              catchtap="handleContactFormDisplayModeTap"
              aria-role="radio"
              aria-checked="{{contactFormConfigForm.displayMode === item.value}}"
            >
              <view class="schedule-query-mode-radio"></view>
              <view class="schedule-query-mode-label">{{item.label}}</view>
            </view>
          </view>
        </view>
      </view>

      <view class="component-work-actions">
        <button class="component-work-cancel" catchtap="handleCloseContactFormSheet">取消</button>
        <button class="component-work-confirm" catchtap="handleConfirmContactFormConfig">完成</button>
      </view>
    </view>
  </view>

  <view class="text-section-sheet-mask component-work-picker-mask {{textSectionSheetVisible ? 'visible' : ''}}" catchtap="handleCloseTextSectionSheet">
    <view class="text-section-sheet-panel component-work-picker-panel" catchtap="noop">
      <view class="component-picker-grabber"></view>
      <view class="component-picker-heading">
        <view class="component-picker-title">编辑文字说明</view>
        <view class="component-picker-count">{{textSectionFieldCounters.content}}</view>
      </view>

      <view class="text-section-form">
        <view class="form-row">
          <view class="field-heading">
            <view class="field-label">说明</view>
            <view class="field-limit">{{textSectionFieldCounters.content}}</view>
          </view>
          <textarea
            class="input textarea profile-sheet-textarea text-section-sheet-textarea"
            value="{{textSectionForm.content}}"
            placeholder="请输入给访客看的说明文字"
            maxlength="{{textSectionMaxLength}}"
            bindinput="handleTextSectionInput"
          ></textarea>
        </view>

        <view class="form-row">
          <view class="field-heading">
            <view class="field-label">对齐方式</view>
          </view>
          <view class="schedule-query-mode-list">
            <view
              wx:for="{{textSectionAlignmentOptions}}"
              wx:key="value"
              class="schedule-query-mode-option {{textSectionForm.alignment === item.value ? 'active' : ''}}"
              data-value="{{item.value}}"
              catchtap="handleTextSectionAlignmentTap"
              aria-role="radio"
              aria-checked="{{textSectionForm.alignment === item.value}}"
            >
              <view class="schedule-query-mode-radio"></view>
              <view class="schedule-query-mode-label">{{item.label}}</view>
            </view>
          </view>
        </view>
      </view>

      <view class="component-work-actions">
        <button class="component-work-cancel" catchtap="handleCloseTextSectionSheet">取消</button>
        <button class="component-work-confirm" catchtap="handleConfirmTextSectionConfig">完成</button>
      </view>
    </view>
  </view>

  <view class="divider-sheet-mask component-work-picker-mask {{dividerSheetVisible ? 'visible' : ''}}" catchtap="handleCloseDividerSheet">
    <view class="divider-sheet-panel component-work-picker-panel" catchtap="noop">
      <view class="component-picker-grabber"></view>
      <view class="component-picker-heading">
        <view class="component-picker-title">编辑分割线</view>
        <view class="component-picker-count">{{dividerForm.heightPx}}px</view>
      </view>

      <view class="divider-form">
        <view class="form-row">
          <view class="field-heading">
            <view class="field-label">颜色</view>
          </view>
          <view class="divider-color-list">
            <view
              wx:for="{{dividerColorOptions}}"
              wx:key="value"
              class="divider-color-option {{dividerForm.color === item.value ? 'active' : ''}}"
              data-value="{{item.value}}"
              catchtap="handleDividerColorTap"
              aria-role="radio"
              aria-checked="{{dividerForm.color === item.value}}"
            >
              <view class="divider-color-swatch" style="background-color: {{item.colorValue}};"></view>
              <view class="divider-color-label">{{item.label}}</view>
            </view>
          </view>
        </view>

        <view class="form-row">
          <view class="field-heading">
            <view class="field-label">高度(px)</view>
          </view>
          <input
            class="input divider-height-input"
            type="number"
            value="{{dividerForm.heightPx}}"
            placeholder="16"
            bindinput="handleDividerHeightInput"
          />
        </view>
      </view>

      <view class="component-work-actions">
        <button class="component-work-cancel" catchtap="handleCloseDividerSheet">取消</button>
        <button class="component-work-confirm" catchtap="handleConfirmDividerConfig">完成</button>
      </view>
    </view>
  </view>

  <view class="share-cover-crop-mask {{shareCoverCropVisible ? 'visible' : ''}}" catchtap="handleCloseShareCoverCrop">
    <view class="share-cover-crop-panel" catchtap="noop">
      <view class="component-picker-grabber"></view>
      <view class="component-picker-heading">
        <view class="component-picker-title">裁剪分享封面</view>
        <view class="component-picker-count">5:4</view>
      </view>

      <view
        wx:if="{{shareCoverCropState}}"
        class="share-cover-crop-stage"
        style="{{shareCoverCropState.cropBoxStyle}}"
        catchtouchstart="handleShareCoverCropTouchStart"
        catchtouchmove="handleShareCoverCropTouchMove"
        catchtouchend="handleShareCoverCropTouchEnd"
        catchtouchcancel="handleShareCoverCropTouchCancel"
      >
        <image class="share-cover-crop-image" src="{{shareCoverCropState.imagePath}}" mode="scaleToFill" style="{{shareCoverCropState.imageStyle}}"></image>
        <view class="share-cover-crop-frame"></view>
      </view>

      <view wx:if="{{shareCoverCropErrorText}}" class="share-cover-crop-error">{{shareCoverCropErrorText}}</view>

      <view class="component-work-actions share-cover-crop-actions">
        <button class="component-work-cancel" catchtap="handleCloseShareCoverCrop">取消</button>
        <button class="component-work-confirm" catchtap="handleConfirmShareCoverCrop" loading="{{shareCoverCropSaving}}" disabled="{{shareCoverCropSaving}}">完成</button>
      </view>
    </view>
  </view>

  <canvas
    id="portfolioCoverCropCanvas"
    type="2d"
    class="share-cover-crop-canvas"
    style="width: {{shareCoverCropCanvasWidth}}px; height: {{shareCoverCropCanvasHeight}}px;"
  ></canvas>

  <view class="bottom-actions">
    <button class="action-button primary-button" bindtap="handleSaveDraft">保存草稿</button>
    <view class="preview-action-stack">
      <button class="action-button secondary-button preview-draft-button" bindtap="handlePreview">
        <view class="preview-action-title">预览草稿</view>
        <view class="preview-action-note">请保存后预览</view>
      </button>
    </view>
    <button wx:if="{{showPublishAction}}" class="action-button publish-button" bindtap="handlePublish">发布</button>
  </view>
</view>
