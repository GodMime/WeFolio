      </view>
    </view>
  </view>

  <view class="contact-form-sheet-mask pe-sheet-mask {{contactFormSheetVisible ? 'pe-sheet-mask-visible' : ''}}" catchtap="handleCloseContactFormSheet">
    <view class="contact-form-sheet-panel pe-sheet-panel pe-sheet-size-standard {{contactFormSheetVisible ? 'pe-sheet-panel-visible' : ''}}" catchtap="noop">
      <view class="pe-sheet-grabber"></view>
      <view class="pe-sheet-heading">
        <view class="pe-sheet-title">编辑预留联系信息</view>
        <view class="pe-sheet-meta">{{contactFormConfigForm.displayMode === 'INLINE_FORM' ? '直接' : '弹层'}}</view>
      </view>

      <view class="schedule-query-form">
        <view class="form-row">
          <view class="field-heading">
            <view class="field-label">展示方式</view>
          </view>
          <view class="schedule-query-mode-list">
            <view
              wx:for="{{contactFormDisplayModeOptions}}"
              wx:key="value"
              class="schedule-query-mode-option pe-sheet-choice {{contactFormConfigForm.displayMode === item.value ? 'pe-sheet-choice-selected' : ''}}"
              data-value="{{item.value}}"
              catchtap="handleContactFormDisplayModeTap"
              aria-role="radio"
              aria-checked="{{contactFormConfigForm.displayMode === item.value}}"
            >
              <view class="schedule-query-mode-radio"></view>
              <view class="schedule-query-mode-label">{{item.label}}</view>
            </view>
          </view>
        </view>
      </view>

      <view class="component-work-actions pe-sheet-actions">
        <button class="pe-sheet-action-cancel" catchtap="handleCloseContactFormSheet">取消</button>
        <button class="pe-sheet-action-confirm" catchtap="handleConfirmContactFormConfig">完成</button>
      </view>
    </view>
  </view>

  <view class="text-section-sheet-mask pe-sheet-mask {{textSectionSheetVisible ? 'pe-sheet-mask-visible' : ''}}" catchtap="handleCloseTextSectionSheet">
    <view class="text-section-sheet-panel pe-sheet-panel pe-sheet-size-long {{textSectionSheetVisible ? 'pe-sheet-panel-visible' : ''}}" catchtap="noop">
      <view class="pe-sheet-grabber"></view>
      <view class="pe-sheet-heading">
        <view class="pe-sheet-title">编辑文字说明</view>
      </view>

      <scroll-view class="text-section-form pe-sheet-scroll" scroll-y type="list">
        <view class="text-section-form-content">
          <view class="form-row">
            <view class="field-heading">
              <view class="field-label">说明</view>
              <view class="field-limit">{{textSectionFieldCounters.content}}</view>
            </view>
            <textarea
              class="profile-sheet-textarea text-section-sheet-textarea pe-sheet-field pe-sheet-field-textarea {{textSectionTypography.fontClass}}"
              style="{{textSectionTypography.fontSizeStyle}}"
              value="{{textSectionForm.content}}"
              placeholder="请输入给访客看的说明文字"
              maxlength="{{textSectionMaxLength}}"
              bindinput="handleTextSectionInput"
            ></textarea>
          </view>

          <view class="form-row">
            <view class="field-heading">
              <view class="field-label">字体</view>
            </view>
            <view class="text-section-font-list">
              <view
                wx:for="{{textSectionFontOptions}}"
                wx:key="value"
                class="text-section-font-option pe-sheet-choice {{textSectionForm.fontFamily === item.value ? 'pe-sheet-choice-selected' : ''}} {{item.available ? '' : 'disabled'}}"
                data-value="{{item.value}}"
                catchtap="handleTextSectionFontTap"
                aria-role="radio"
                aria-checked="{{textSectionForm.fontFamily === item.value}}"
                aria-disabled="{{!item.available}}"
                aria-label="{{item.label}}，映期 Folio 字体预览 123"
              >
                <view class="text-section-font-copy">
                  <view class="text-section-font-label">{{item.label}}</view>
                  <view class="text-section-font-sample {{item.fontClass}}">映期 Folio 字体预览 123</view>
                  <view wx:if="{{!item.available}}" class="text-section-font-hint">当前设备不可用</view>
                  <view
                    wx:if="{{textSectionForm.fontFamily === item.value && !item.available}}"
                    class="text-section-font-hint current"
                  >当前设备以系统字体预览</view>
                </view>
                <view class="schedule-query-mode-radio"></view>
              </view>
            </view>
          </view>

          <view class="form-row">
            <view class="field-heading">
              <view class="field-label">字号</view>
            </view>
            <view class="text-section-size-list">
              <view
                wx:for="{{textSectionSizeOptions}}"
                wx:key="value"
                class="text-section-size-option pe-sheet-choice {{textSectionForm.fontSizeRpx === item.value ? 'pe-sheet-choice-selected-filled' : ''}} {{item.custom ? 'custom' : ''}}"
                data-value="{{item.value}}"
                catchtap="handleTextSectionFontSizeTap"
                aria-role="radio"
                aria-checked="{{textSectionForm.fontSizeRpx === item.value}}"
              >{{item.label}}</view>
            </view>
          </view>

          <view class="form-row">
            <view class="field-heading">
              <view class="field-label">左右对齐方式</view>
            </view>
            <view class="schedule-query-mode-list">
              <view
                wx:for="{{textSectionAlignmentOptions}}"
                wx:key="value"
                class="schedule-query-mode-option pe-sheet-choice {{textSectionForm.alignment === item.value ? 'pe-sheet-choice-selected' : ''}}"
                data-value="{{item.value}}"
                catchtap="handleTextSectionAlignmentTap"
                aria-role="radio"
                aria-checked="{{textSectionForm.alignment === item.value}}"
              >
                <view class="schedule-query-mode-radio"></view>
                <view class="schedule-query-mode-label">{{item.label}}</view>
              </view>
            </view>
          </view>
          <view class="form-row">
            <view class="field-heading"><view class="field-label">颜色</view></view>
            <text-color-editor color="{{textSectionForm.color}}" active="{{textSectionSheetVisible}}" bindchange="handleTextSectionColorChange" />
          </view>
          <text-background-editor wx:if="{{textSectionSheetVisible}}" config="{{textSectionForm}}" options="{{textBackgroundOptions}}" loading="{{textBackgroundLoading}}" error="{{textBackgroundError}}" has-more="{{textBackgroundHasMore}}" bindchange="handleTextBackgroundChange" bindrequest="handleTextBackgroundRequest" />
        </view>
      </scroll-view>

      <view class="component-work-actions pe-sheet-actions">
        <button class="pe-sheet-action-cancel" catchtap="handleCloseTextSectionSheet">取消</button>
        <button class="pe-sheet-action-confirm" catchtap="handleConfirmTextSectionConfig">完成</button>
      </view>
    </view>
  </view>

  <structured-text-editor visible="{{structuredTextSheetVisible}}" config="{{structuredTextConfig}}" is-new="{{structuredTextIsNew}}" background-options="{{textBackgroundOptions}}" background-loading="{{textBackgroundLoading}}" background-error="{{textBackgroundError}}" background-has-more="{{textBackgroundHasMore}}" background-selection="{{textBackgroundSelection}}" bindconfirm="handleConfirmStructuredText" bindcancel="handleCancelStructuredText" bindbackgroundrequest="handleTextBackgroundRequest" bindbackgroundchange="handleStructuredTextBackgroundChange" />

  <view class="divider-sheet-mask pe-sheet-mask {{dividerSheetVisible ? 'pe-sheet-mask-visible' : ''}}" catchtap="handleCloseDividerSheet">
    <view class="divider-sheet-panel pe-sheet-panel pe-sheet-size-compact {{dividerSheetVisible ? 'pe-sheet-panel-visible' : ''}}" catchtap="noop">
      <view class="pe-sheet-grabber"></view>
      <view class="pe-sheet-heading">
        <view class="pe-sheet-title">编辑分割线</view>
        <view class="pe-sheet-meta">{{dividerForm.heightPx}}px</view>
      </view>

      <view class="divider-form">
        <view class="form-row">
          <view class="field-heading">
            <view class="field-label">颜色</view>
          </view>
          <view class="divider-color-list">
            <view
              wx:for="{{dividerColorOptions}}"
              wx:key="value"
              class="divider-color-option pe-sheet-choice {{dividerForm.color === item.value ? 'pe-sheet-choice-selected' : ''}}"
              data-value="{{item.value}}"
              catchtap="handleDividerColorTap"
              aria-role="radio"
              aria-checked="{{dividerForm.color === item.value}}"
            >
              <view class="divider-color-swatch" style="background-color: {{item.colorValue}};"></view>
              <view class="divider-color-label">{{item.label}}</view>
            </view>
          </view>
        </view>

        <view class="form-row">
          <view class="field-heading">
            <view class="field-label">高度(px)</view>
          </view>
          <input
            class="divider-height-input pe-sheet-field"
            type="number"
            value="{{dividerForm.heightPx}}"
            placeholder="16"
            bindinput="handleDividerHeightInput"
          />
        </view>
      </view>

      <view class="component-work-actions pe-sheet-actions">
        <button class="pe-sheet-action-cancel" catchtap="handleCloseDividerSheet">取消</button>
        <button class="pe-sheet-action-confirm" catchtap="handleConfirmDividerConfig">完成</button>
      </view>
    </view>
  </view>

  <view class="share-cover-crop-mask pe-sheet-mask {{shareCoverCropVisible ? 'pe-sheet-mask-visible' : ''}}" catchtap="handleCloseShareCoverCrop">
    <view class="share-cover-crop-panel pe-sheet-panel pe-sheet-size-standard {{shareCoverCropVisible ? 'pe-sheet-panel-visible' : ''}}" catchtap="noop">
      <view class="pe-sheet-grabber"></view>
      <view class="pe-sheet-heading">
        <view class="pe-sheet-title">裁剪分享封面</view>
        <view class="pe-sheet-meta">5:4</view>
      </view>

      <view
        wx:if="{{shareCoverCropState}}"
        class="share-cover-crop-stage"
        style="{{shareCoverCropState.cropBoxStyle}}"
        catchtouchstart="handleShareCoverCropTouchStart"
        catchtouchmove="handleShareCoverCropTouchMove"
        catchtouchend="handleShareCoverCropTouchEnd"
        catchtouchcancel="handleShareCoverCropTouchCancel"
      >
        <image class="share-cover-crop-image" src="{{shareCoverCropState.imagePath}}" mode="scaleToFill" style="{{shareCoverCropState.imageStyle}}"></image>
        <view class="share-cover-crop-frame"></view>
      </view>

      <view wx:if="{{shareCoverCropErrorText}}" class="share-cover-crop-error">{{shareCoverCropErrorText}}</view>

      <view class="share-cover-crop-actions pe-sheet-actions">
        <button class="pe-sheet-action-cancel" catchtap="handleCloseShareCoverCrop">取消</button>
        <button class="pe-sheet-action-confirm {{shareCoverCropSaving ? 'pe-action-loading' : ''}}" catchtap="handleConfirmShareCoverCrop" loading="{{shareCoverCropSaving}}" disabled="{{shareCoverCropSaving}}">完成</button>
      </view>
    </view>
  </view>

  <canvas
    id="portfolioCoverCropCanvas"
    type="2d"
    class="share-cover-crop-canvas"
    style="width: {{shareCoverCropCanvasWidth}}px; height: {{shareCoverCropCanvasHeight}}px;"
  ></canvas>

  <view class="bottom-actions pe-page-actions">
    <button class="action-button primary-button pe-page-action-primary" bindtap="handleSaveDraft">保存草稿</button>
    <view class="preview-action-stack">
      <button class="action-button secondary-button preview-draft-button pe-page-action-secondary" bindtap="handlePreview">
        <view class="preview-action-title">预览草稿</view>
        <view class="preview-action-note">请保存后预览</view>
      </button>
    </view>
    <button wx:if="{{showPublishAction}}" class="action-button publish-button pe-page-action-primary" bindtap="handlePublish">发布</button>
  </view>
</view>
