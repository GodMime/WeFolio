  <view class="schedule-query-sheet-mask pe-sheet-mask {{scheduleQuerySheetVisible ? 'pe-sheet-mask-visible' : ''}}" catchtap="handleCloseScheduleQuerySheet">
    <view class="schedule-query-sheet-panel pe-sheet-panel pe-sheet-size-compact {{scheduleQuerySheetVisible ? 'pe-sheet-panel-visible' : ''}}" catchtap="noop">
      <view class="pe-sheet-grabber"></view>
      <view class="pe-sheet-heading">
        <view class="pe-sheet-title">编辑档期查询</view>
        <view class="pe-sheet-meta">{{scheduleQueryForm.displayMode === 'INLINE_CALENDAR' ? '内联' : '弹层'}}</view>
      </view>

      <view class="schedule-query-form">
        <view class="form-row">
          <view class="field-heading">
