var EDIT_LABELS = {
  CAROUSEL: '编辑轮播图作品',
  VIDEO_CAROUSEL: '编辑视频轮播',
  PROFILE: '编辑个人资料',
  QR_CONTACT: '编辑二维码联系',
  SCHEDULE_QUERY: '编辑档期查询',
  CONTACT_FORM: '编辑预留联系信息',
  TEXT_SECTION: '编辑文字说明',
  STRUCTURED_TEXT_SECTION: '编辑结构化文字说明',
  DIVIDER: '编辑分割线',
  WORK_GRID: '编辑作品集展示标签',
  WORK_LIST: '编辑作品集展示标签',
  SINGLE_WORK: '编辑单个作品',
  HYPERLINK: '编辑超链接'
}
var SINGLE_WORK_SUMMARY_STATUS_LOADING = 'LOADING'
var SINGLE_WORK_SUMMARY_STATUS_FAILED = 'FAILED'
var SINGLE_WORK_SUMMARY_STATUS_UNAVAILABLE = 'UNAVAILABLE'

function isEditable(componentType) {
  return !!EDIT_LABELS[componentType]
}

function resolveAriaRole(componentType) {
  return isEditable(componentType) ? 'button' : 'text'
}

function resolveAriaLabel(componentType, fallbackName) {
  return EDIT_LABELS[componentType] || fallbackName || ''
}

function findSingleWorkSummary(workId, summaries) {
  summaries = summaries || []
  for (var index = 0; index < summaries.length; index += 1) {
    if (summaries[index] && summaries[index].id == workId) {
      return summaries[index]
    }
  }
  return null
}

function resolveSingleWorkSummary(component, summaries) {
  var config = component && component.config ? component.config : {}
  var workId = config.workId || 0
  if (!(workId > 0)) {
    return '请选择作品'
  }
  var work = findSingleWorkSummary(workId, summaries)
  if (!work || work.status == SINGLE_WORK_SUMMARY_STATUS_LOADING) {
    return '作品信息加载中'
  }
  if (work.status == SINGLE_WORK_SUMMARY_STATUS_FAILED) {
    return '作品信息加载失败'
  }
  if (work.status == SINGLE_WORK_SUMMARY_STATUS_UNAVAILABLE) {
    return '作品不可用，请重新选择'
  }
  return work.title || '作品不可用，请重新选择'
}

function resolveHyperlinkSummary(component, summaries) {
  var workSummary = resolveSingleWorkSummary(component, summaries)
  if (workSummary == '请选择作品' || workSummary == '作品信息加载中' ||
      workSummary == '作品信息加载失败' || workSummary == '作品不可用，请重新选择') {
    return workSummary
  }
  var config = component && component.config ? component.config : {}
  if (config.actionType == 'INTERNAL_PORTFOLIO') {
    return workSummary + ' · 内部跳转'
  }
  if (config.actionType == 'EXTERNAL_LINK') {
    return workSummary + ' · 外部复制'
  }
  return workSummary + ' · 请选择点击行为'
}

module.exports = {
  isEditable: isEditable,
  resolveAriaRole: resolveAriaRole,
  resolveAriaLabel: resolveAriaLabel,
  resolveSingleWorkSummary: resolveSingleWorkSummary,
  resolveHyperlinkSummary: resolveHyperlinkSummary
}
