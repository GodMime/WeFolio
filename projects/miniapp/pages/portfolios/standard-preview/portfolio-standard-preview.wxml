<view class="page-shell portfolio-preview-page portfolio-theme-{{portfolio.themeMode}}" style="background-color: {{portfolio.style.backgroundColor}};">
  <navigation-bar title="{{portfolio.title || '预览'}}" back="{{true}}" color="{{portfolio.themeMode === 'dark' ? '#f8f9fa' : '#212529'}}" background="{{portfolio.style.backgroundColor}}"></navigation-bar>

  <scroll-view scroll-y scroll-top="{{portfolioScrollTop}}" class="preview-scroll">
    <view class="preview-toolbar">
      <view class="preview-note">预览模式：禁用真实提交，不统计访问，不扣积分。</view>
    </view>

    <block wx:if="{{loading}}">
      <view class="preview-skeleton">
        <view class="preview-skeleton-hero"></view>
        <view class="preview-skeleton-line short"></view>
        <view class="preview-skeleton-line"></view>
        <view class="preview-skeleton-grid">
          <view class="preview-skeleton-tile"></view>
          <view class="preview-skeleton-tile"></view>
          <view class="preview-skeleton-tile"></view>
          <view class="preview-skeleton-tile"></view>
        </view>
      </view>
    </block>

    <block wx:elif="{{errorMessage}}">
      <view class="preview-error">
        <view class="preview-error-title">预览加载失败</view>
        <view class="preview-error-message">{{errorMessage}}</view>
        <button class="secondary-action" bindtap="handleRetryPreview">重试</button>
      </view>
    </block>

    <block wx:else>
      <view class="portfolio-menu-transition-content {{portfolioMenuTransitionClass}}">
      <view wx:for="{{portfolio.activeComponents}}" wx:key="componentKey" class="folio-component">
        <block wx:if="{{item.componentType === 'CAROUSEL'}}">
          <portfolio-carousel works="{{item.works}}" interval="{{item.carouselIntervalMs}}" theme-mode="{{portfolio.themeMode}}"></portfolio-carousel>
        </block>

        <block wx:elif="{{item.componentType === 'VIDEO_CAROUSEL'}}">
          <video-carousel component-key="{{item.componentKey}}" title="{{item.title}}" works="{{item.works}}" show-title="{{item.showTitle}}" show-swipe-hint="{{item.showSwipeHint}}" theme-mode="{{portfolio.themeMode}}" bindplay="handleVideoCarouselPlay"></video-carousel>
        </block>

        <block wx:elif="{{item.componentType === 'PROFILE'}}">
          <portfolio-profile
            profile="{{item.profile}}"
            theme-mode="{{portfolio.themeMode}}"
            bindpreviewqr="handlePreviewQr"
          ></portfolio-profile>
        </block>

        <block wx:elif="{{item.componentType === 'WORK_GRID'}}">
          <portfolio-work-grid
            component-key="{{item.componentKey}}"
            display-tags="{{item.displayTags}}"
            active-group="{{item.activeGroup}}"
            show-title="{{item.showTitle}}"
            show-description="{{item.showDescription}}"
            switching="{{displaySwitchingComponentKey === item.componentKey}}"
            theme-mode="{{portfolio.themeMode}}"
            binddisplaytagtap="handleDisplayTagTap"
            bindworktap="handleWorkTap"
          ></portfolio-work-grid>
        </block>

        <block wx:elif="{{item.componentType === 'WORK_LIST'}}">
          <portfolio-work-list
            component-key="{{item.componentKey}}"
            display-tags="{{item.displayTags}}"
            active-group="{{item.activeGroup}}"
            show-title="{{item.showTitle}}"
            show-description="{{item.showDescription}}"
            switching="{{displaySwitchingComponentKey === item.componentKey}}"
            theme-mode="{{portfolio.themeMode}}"
            binddisplaytagtap="handleDisplayTagTap"
            bindworktap="handleWorkTap"
          ></portfolio-work-list>
        </block>

        <block wx:elif="{{item.componentType === 'SINGLE_WORK'}}">
          <portfolio-single-work
            component-key="{{item.componentKey}}"
            work="{{item.work}}"
            show-title="{{item.showTitle}}"
            show-description="{{item.showDescription}}"
            active-video-key="{{activeSingleWorkVideoKey}}"
            repair-mode="{{true}}"
            theme-mode="{{portfolio.themeMode}}"
            class="portfolio-single-work-instance"
            bindsingleworktap="handleSingleWorkTap"
            bindvideoerror="handleSingleWorkVideoError"
          ></portfolio-single-work>
        </block>

        <block wx:elif="{{item.componentType === 'SCHEDULE_QUERY'}}">
          <portfolio-schedule-query
            portfolio-id="{{portfolioId}}"
            team-portfolio-id="{{teamPortfolioId}}"
            team-preview-scope="{{teamPreviewScope}}"
            preview="{{true}}"
            preview-scope="{{previewScope}}"
            component-key="{{item.componentKey}}"
            schedule-query="{{item.scheduleQuery}}"
            theme-mode="{{portfolio.themeMode}}"
          ></portfolio-schedule-query>
        </block>

        <block wx:elif="{{item.componentType === 'QR_CONTACT'}}">
          <portfolio-qr-contact
            qr-contact="{{item.qrContact}}"
            theme-mode="{{portfolio.themeMode}}"
            bindpreviewqr="handlePreviewQr"
          ></portfolio-qr-contact>
        </block>

        <block wx:elif="{{item.componentType === 'CONTACT_FORM'}}">
          <portfolio-contact-form
            contact-component="{{item}}"
            contact-form="{{contactForm}}"
            submit-text="预览提交"
            theme-mode="{{portfolio.themeMode}}"
            bindcontactinput="handleContactInput"
            bindsubmitcontact="handleSubmitContact"
            bindopenmodal="handleOpenContactFormModal"
          ></portfolio-contact-form>
        </block>

        <block wx:elif="{{item.componentType === 'TEXT_SECTION'}}">
          <portfolio-text-section text-section="{{item.textSection}}" theme-mode="{{portfolio.themeMode}}"></portfolio-text-section>
        </block>

        <block wx:elif="{{item.componentType === 'DIVIDER'}}">
          <portfolio-divider divider="{{item.divider}}" theme-mode="{{portfolio.themeMode}}"></portfolio-divider>
        </block>

        <block wx:elif="{{item.componentType === 'HYPERLINK'}}">
          <portfolio-hyperlink
            component-key="{{item.componentKey}}"
            hyperlink="{{item.hyperlink}}"
            repair-mode="{{true}}"
            theme-mode="{{portfolio.themeMode}}"
            bindhyperlinktap="handleHyperlinkTap"
          ></portfolio-hyperlink>
        </block>
      </view>

      <view class="folio-brand-footer">
        <image wx:if="{{portfolio.themeMode === 'dark'}}" class="folio-brand-logo" src="/assets/system/folio-logo-stack-bold-dark-50kb.png" mode="aspectFit"></image>
        <image wx:else class="folio-brand-logo" src="/assets/system/folio-logo-stack-bold-small-50kb.png" mode="aspectFit"></image>
        <view class="folio-brand-name">映期Folio</view>
      </view>
      </view>
    </block>
  </scroll-view>

  <portfolio-bottom-nav
    navigation="{{portfolio.bottomNav}}"
    active-menu-key="{{portfolio.activeMenuKey}}"
    theme-mode="{{portfolio.themeMode}}"
    bindchange="handleBottomNavChange"
  ></portfolio-bottom-nav>

  <root-portal wx:if="{{videoPreviewVisible}}">
    <view class="work-video-mask {{videoPreviewVisible ? 'visible' : ''}}" catchtap="handleCloseVideoPreview">
      <view class="work-video-panel" catchtap="handleVideoPreviewPanelTap">
        <view class="work-video-heading">
          <view class="work-video-title">{{videoPreview.title}}</view>
          <view class="work-video-close" catchtap="handleCloseVideoPreview" aria-role="button" aria-label="关闭视频">×</view>
        </view>
        <video
          id="portfolioWorkVideo"
          class="work-video-player"
          src="{{videoPreview.src}}"
          poster="{{videoPreview.poster}}"
          controls="{{true}}"
          autoplay="{{true}}"
          show-fullscreen-btn="{{true}}"
          show-center-play-btn="{{true}}"
          enable-progress-gesture="{{true}}"
          object-fit="contain"
          binderror="handleVideoPreviewError"
        ></video>
      </view>
    </view>
  </root-portal>

  <portfolio-contact-form
    view-mode="modal"
    modal-visible="{{contactFormModalVisible}}"
    contact-component="{{activeContactFormComponent}}"
    contact-form="{{contactForm}}"
    submit-text="预览提交"
    theme-mode="{{portfolio.themeMode}}"
    bindcontactinput="handleContactInput"
    bindsubmitcontact="handleSubmitContact"
    bindclosemodal="handleCloseContactFormModal"
  ></portfolio-contact-form>

  <root-portal wx:if="{{clipboardPromptVisible}}">
    <view class="clipboard-prompt-card portfolio-theme-{{portfolio.themeMode}}">{{clipboardPromptText}}</view>
  </root-portal>
</view>
