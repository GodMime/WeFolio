<view class="page-shell portfolio-preview-page">
  <navigation-bar title="{{portfolio.title || '预览'}}" back="{{true}}" color="#17202a" background="rgba(255, 255, 255, 0.94)"></navigation-bar>

  <scroll-view scroll-y class="preview-scroll">
    <view class="preview-toolbar">
      <view class="preview-note">预览模式：禁用真实提交，不统计访问，不扣积分。</view>
    </view>

    <block wx:if="{{loading}}">
      <view class="preview-skeleton">
        <view class="preview-skeleton-hero"></view>
        <view class="preview-skeleton-line short"></view>
        <view class="preview-skeleton-line"></view>
        <view class="preview-skeleton-grid">
          <view class="preview-skeleton-tile"></view>
          <view class="preview-skeleton-tile"></view>
          <view class="preview-skeleton-tile"></view>
          <view class="preview-skeleton-tile"></view>
        </view>
      </view>
    </block>

    <block wx:elif="{{errorMessage}}">
      <view class="preview-error">
        <view class="preview-error-title">预览加载失败</view>
        <view class="preview-error-message">{{errorMessage}}</view>
        <button class="secondary-action" bindtap="handleRetryPreview">重试</button>
      </view>
    </block>

    <block wx:else>
      <view wx:for="{{portfolio.components}}" wx:key="componentKey" class="folio-component">
        <block wx:if="{{item.componentType === 'CAROUSEL'}}">
          <portfolio-carousel works="{{item.works}}" interval="{{item.carouselIntervalMs}}"></portfolio-carousel>
        </block>

        <block wx:elif="{{item.componentType === 'PROFILE'}}">
          <view class="profile-section">
            <image wx:if="{{item.profile.avatarUrl}}" class="profile-avatar" src="{{item.profile.avatarUrl}}" mode="aspectFill"></image>
            <view wx:if="{{item.profile.displayName}}" class="profile-name">{{item.profile.displayName}}</view>
            <view wx:if="{{item.profile.profession}}" class="profile-line">{{item.profile.profession}}</view>
            <view wx:if="{{item.profile.city}}" class="profile-line">{{item.profile.city}}</view>
            <text wx:if="{{item.profile.bio}}" class="profile-bio" space="nbsp">{{item.profile.bio}}</text>
            <view wx:if="{{item.profile.tags.length}}" class="profile-tags">
              <view wx:for="{{item.profile.tags}}" wx:key="name" wx:for-item="tag" class="profile-tag">{{tag.name}}</view>
            </view>
            <image wx:if="{{item.profile.wechatQrUrl}}" class="profile-qr-image qr-image" src="{{item.profile.wechatQrUrl}}" mode="aspectFit" data-url="{{item.profile.wechatQrUrl}}" bindtap="handlePreviewQr"></image>
          </view>
        </block>

        <block wx:elif="{{item.componentType === 'WORK_GRID'}}">
          <view class="work-section-title">作品列表</view>
          <scroll-view wx:if="{{item.displayTags.length}}" scroll-x class="display-tag-scroll">
            <view class="display-tags">
              <view
                wx:for="{{item.displayTags}}"
                wx:key="groupKey"
                wx:for-item="tag"
                class="display-tag {{tag.active ? 'active' : ''}}"
                data-component-key="{{item.componentKey}}"
                data-group-key="{{tag.groupKey}}"
                bindtap="handleDisplayTagTap"
              >{{tag.name}}</view>
            </view>
          </scroll-view>
          <view class="work-grid {{displaySwitchingComponentKey === item.componentKey ? 'display-switching' : ''}}">
            <view wx:for="{{item.activeGroup.works}}" wx:key="workId" wx:for-item="work" class="work-card grid-card">
              <view
                class="work-cover-wrap"
                data-work-id="{{work.workId}}"
                data-media-type="{{work.mediaType}}"
                data-media-url="{{work.previewUrl}}"
                data-cover-url="{{work.thumbnailUrl}}"
                data-title="{{work.title}}"
                bindtap="handleWorkTap"
                aria-role="button"
                aria-label="{{work.isVideo ? '播放视频' : '查看原图'}}{{work.title}}"
              >
                <image class="work-cover" src="{{work.thumbnailUrl}}" mode="aspectFill"></image>
                <view wx:if="{{work.isVideo}}" class="work-play-badge" aria-hidden="true">
                  <view class="work-play-icon"></view>
                </view>
              </view>
              <view class="work-title">{{work.title}}</view>
            </view>
          </view>
        </block>

        <block wx:elif="{{item.componentType === 'WORK_LIST'}}">
          <view class="work-section-title">作品列表</view>
          <scroll-view wx:if="{{item.displayTags.length}}" scroll-x class="display-tag-scroll">
            <view class="display-tags">
              <view
                wx:for="{{item.displayTags}}"
                wx:key="groupKey"
                wx:for-item="tag"
                class="display-tag {{tag.active ? 'active' : ''}}"
                data-component-key="{{item.componentKey}}"
                data-group-key="{{tag.groupKey}}"
                bindtap="handleDisplayTagTap"
              >{{tag.name}}</view>
            </view>
          </scroll-view>
          <view class="work-list {{displaySwitchingComponentKey === item.componentKey ? 'display-switching' : ''}}">
            <view wx:for="{{item.activeGroup.works}}" wx:key="workId" wx:for-item="work" class="work-card list-card">
              <view
                class="work-cover-wrap"
                data-work-id="{{work.workId}}"
                data-media-type="{{work.mediaType}}"
                data-media-url="{{work.previewUrl}}"
                data-cover-url="{{work.thumbnailUrl}}"
                data-title="{{work.title}}"
                bindtap="handleWorkTap"
                aria-role="button"
                aria-label="{{work.isVideo ? '播放视频' : '查看原图'}}{{work.title}}"
              >
                <image class="work-cover" src="{{work.thumbnailUrl}}" mode="aspectFill"></image>
                <view wx:if="{{work.isVideo}}" class="work-play-badge" aria-hidden="true">
                  <view class="work-play-icon"></view>
                </view>
              </view>
              <view class="work-title">{{work.title}}</view>
              <view wx:if="{{work.description}}" class="work-desc">{{work.description}}</view>
            </view>
          </view>
        </block>

        <block wx:elif="{{item.componentType === 'SINGLE_WORK'}}">
          <view wx:if="{{!item.work}}" class="single-work-repair">作品不可用，请重新选择</view>
          <view wx:else class="single-work">
            <video
              wx:if="{{item.work.isVideo && activeSingleWorkVideoKey === item.componentKey}}"
              id="singleWorkVideo-{{item.componentKey}}"
              class="single-work-video"
              style="{{item.work.aspectRatioStyle}}"
              src="{{item.work.previewUrl}}"
              poster="{{item.work.thumbnailUrl}}"
              controls="{{true}}"
              autoplay="{{true}}"
              show-fullscreen-btn="{{true}}"
              show-center-play-btn="{{true}}"
              enable-progress-gesture="{{true}}"
              object-fit="cover"
              binderror="handleSingleWorkVideoError"
            ></video>
            <view
              wx:elif="{{item.work.isVideo}}"
              class="single-work-video-poster"
              style="{{item.work.aspectRatioStyle}}"
              data-component-key="{{item.componentKey}}"
              data-work-id="{{item.work.workId}}"
              data-media-type="{{item.work.mediaType}}"
              data-media-url="{{item.work.previewUrl}}"
              data-cover-url="{{item.work.thumbnailUrl}}"
              data-title="{{item.work.title}}"
              bindtap="handleSingleWorkTap"
              aria-role="button"
              aria-label="播放视频{{item.work.title}}"
            >
              <image wx:if="{{item.work.thumbnailUrl}}" class="single-work-video-cover" src="{{item.work.thumbnailUrl}}" mode="aspectFill"></image>
              <view wx:else class="single-work-media-placeholder">暂无视频封面</view>
              <view class="single-work-play-badge" aria-hidden="true"><view class="work-play-icon"></view></view>
            </view>
            <image
              wx:elif="{{item.work.previewUrl}}"
              class="single-work-image"
              src="{{item.work.previewUrl}}"
              mode="widthFix"
              data-component-key="{{item.componentKey}}"
              data-work-id="{{item.work.workId}}"
              data-media-type="{{item.work.mediaType}}"
              data-media-url="{{item.work.previewUrl}}"
              data-cover-url="{{item.work.thumbnailUrl}}"
              data-title="{{item.work.title}}"
              bindtap="handleSingleWorkTap"
            ></image>
            <view
              wx:else
              class="single-work-media-placeholder image"
              data-component-key="{{item.componentKey}}"
              data-work-id="{{item.work.workId}}"
              data-media-type="{{item.work.mediaType}}"
              bindtap="handleSingleWorkTap"
            >图片地址缺失</view>
            <view wx:if="{{item.showTitle}}" class="single-work-title">{{item.work.title}}</view>
          </view>
        </block>

        <block wx:elif="{{item.componentType === 'SCHEDULE_QUERY'}}">
          <portfolio-schedule-query
            portfolio-id="{{portfolioId}}"
            team-portfolio-id="{{teamPortfolioId}}"
            team-preview-scope="{{teamPreviewScope}}"
            preview="{{true}}"
            preview-scope="{{previewScope}}"
            component-key="{{item.componentKey}}"
            schedule-query="{{item.scheduleQuery}}"
          ></portfolio-schedule-query>
        </block>

        <block wx:elif="{{item.componentType === 'QR_CONTACT'}}">
          <view class="qr-section">
            <image wx:if="{{item.qrContact.qrUrl}}" class="qr-image" src="{{item.qrContact.qrUrl}}" mode="aspectFit" data-url="{{item.qrContact.qrUrl}}" bindtap="handlePreviewQr"></image>
          </view>
        </block>

        <block wx:elif="{{item.componentType === 'CONTACT_FORM'}}">
          <portfolio-contact-form
            contact-component="{{item}}"
            contact-form="{{contactForm}}"
            submit-text="预览提交"
            bindcontactinput="handleContactInput"
            bindsubmitcontact="handleSubmitContact"
            bindopenmodal="handleOpenContactFormModal"
          ></portfolio-contact-form>
        </block>

        <block wx:elif="{{item.componentType === 'TEXT_SECTION'}}">
          <view class="text-section {{item.textSection.alignmentClass}}">
            <view wx:if="{{item.textSection.title}}" class="component-title">{{item.textSection.title}}</view>
            <text class="text-content" space="nbsp">{{item.textSection.content}}</text>
          </view>
        </block>

        <block wx:elif="{{item.componentType === 'DIVIDER'}}">
          <view class="divider-section" style="{{item.divider.style}}"></view>
        </block>
      </view>

      <view class="folio-brand-footer">
        <image class="folio-brand-logo" src="/assets/system/folio-logo-stack-bold-small-50kb.png" mode="aspectFit"></image>
        <view class="folio-brand-name">映期Folio</view>
      </view>
    </block>
  </scroll-view>

  <root-portal wx:if="{{videoPreviewVisible}}">
    <view class="work-video-mask {{videoPreviewVisible ? 'visible' : ''}}" catchtap="handleCloseVideoPreview">
      <view class="work-video-panel" catchtap="handleVideoPreviewPanelTap">
        <view class="work-video-heading">
          <view class="work-video-title">{{videoPreview.title}}</view>
          <view class="work-video-close" catchtap="handleCloseVideoPreview" aria-role="button" aria-label="关闭视频">×</view>
        </view>
        <video
          id="portfolioWorkVideo"
          class="work-video-player"
          src="{{videoPreview.src}}"
          poster="{{videoPreview.poster}}"
          controls="{{true}}"
          autoplay="{{true}}"
          show-fullscreen-btn="{{true}}"
          show-center-play-btn="{{true}}"
          enable-progress-gesture="{{true}}"
          object-fit="contain"
        ></video>
      </view>
    </view>
  </root-portal>

  <portfolio-contact-form
    view-mode="modal"
    modal-visible="{{contactFormModalVisible}}"
    contact-component="{{activeContactFormComponent}}"
    contact-form="{{contactForm}}"
    submit-text="预览提交"
    bindcontactinput="handleContactInput"
    bindsubmitcontact="handleSubmitContact"
    bindclosemodal="handleCloseContactFormModal"
  ></portfolio-contact-form>
</view>
