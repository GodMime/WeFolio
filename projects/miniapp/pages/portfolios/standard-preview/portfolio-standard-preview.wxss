.portfolio-preview-page {
  background: #ffffff;
}

.preview-scroll {
  height: 100vh;
}

.preview-toolbar {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx 32rpx;
  border-bottom: 1rpx solid #eef1f4;
  box-sizing: border-box;
}

.preview-note {
  flex: 1;
  min-width: 0;
  color: #7a8490;
  font-size: 22rpx;
  line-height: 1.4;
}

.preview-skeleton {
  padding: 32rpx 24rpx;
  box-sizing: border-box;
}

.preview-skeleton-hero,
.preview-skeleton-line,
.preview-skeleton-tile {
  background: #eef1f4;
  border-radius: 8rpx;
}

.preview-skeleton-hero {
  height: 520rpx;
}

.preview-skeleton-line {
  width: 84%;
  height: 28rpx;
  margin: 28rpx auto 0;
}

.preview-skeleton-line.short {
  width: 46%;
}

.preview-skeleton-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 34rpx;
}

.preview-skeleton-tile {
  width: calc(50% - 6rpx);
  flex: 0 0 calc(50% - 6rpx);
  height: 236rpx;
}

.preview-error {
  padding: 120rpx 48rpx 0;
  text-align: center;
  box-sizing: border-box;
}

.preview-error-title {
  color: #212529;
  font-size: 34rpx;
  font-weight: 900;
  line-height: 1.35;
}

.preview-error-message {
  margin-top: 18rpx;
  color: #868e96;
  font-size: 26rpx;
  line-height: 1.7;
}

.folio-component {
  margin-top: 32rpx;
}

.folio-carousel {
  width: 100%;
  height: 760rpx;
  border-radius: 40rpx;
  background: #f1f3f5;
}

.carousel-image {
  display: block;
  width: 100%;
  height: 100%;
}

.secondary-action,
.primary-button {
  width: 260rpx;
  height: 96rpx;
  margin: 24rpx auto 0;
  padding: 0;
  font-size: 26rpx;
  line-height: 96rpx;
  border-radius: 999rpx;
}

.secondary-action {
  color: #212529;
  border: 1rpx solid #dee2e6;
  background: #f5f6f7;
}

.primary-button {
  color: #ffffff;
  background: #212529;
}

.folio-brand-footer {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  padding: 56rpx 0 calc(160rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.folio-brand-logo {
  width: 56rpx;
  height: 56rpx;
}

.folio-brand-name {
  color: #a1a9b3;
  font-size: 24rpx;
  font-weight: 800;
  line-height: 1.4;
}

.work-video-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 80;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 32rpx 24rpx calc(32rpx + env(safe-area-inset-bottom));
  opacity: 0;
  pointer-events: none;
  background: rgba(0, 0, 0, 0.82);
  box-sizing: border-box;
  transition: opacity 180ms ease;
}

.work-video-mask.visible {
  opacity: 1;
  pointer-events: auto;
}

.work-video-panel {
  width: 100%;
  display: flex;
  flex-direction: column;
  gap: 18rpx;
  transform: translateY(18rpx) scale(0.97);
  transition: transform 220ms cubic-bezier(0.18, 0, 0.12, 1);
}

.work-video-mask.visible .work-video-panel {
  transform: translateY(0) scale(1);
}

.work-video-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.work-video-title {
  flex: 1 1 auto;
  min-width: 0;
  overflow: hidden;
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 900;
  line-height: 1.3;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.work-video-close {
  width: 58rpx;
  height: 58rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
  color: #ffffff;
  font-size: 36rpx;
  font-weight: 700;
  line-height: 1;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.18);
}

.work-video-player {
  width: 100%;
  height: 62vh;
  max-height: 720rpx;
  overflow: hidden;
  border-radius: 40rpx;
  background: #000000;
}
