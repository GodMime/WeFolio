@import "../../../styles/portfolio-theme.wxss";
@import "../../../styles/portfolio-menu-transition.wxss";

.portfolio-preview-page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  color: var(--portfolio-text-primary);
}

.preview-scroll {
  flex: 1;
  min-height: 0;
  background: transparent;
}

.preview-toolbar {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx 32rpx;
  border-bottom: 1rpx solid var(--portfolio-border);
  box-sizing: border-box;
}

.preview-note {
  flex: 1;
  min-width: 0;
  color: var(--portfolio-text-secondary);
  font-size: 22rpx;
  line-height: 1.4;
}

.preview-skeleton {
  padding: 32rpx 24rpx;
  box-sizing: border-box;
}

.preview-skeleton-hero,
.preview-skeleton-line,
.preview-skeleton-tile {
  background: #eef1f4;
  border-radius: 8rpx;
}

.preview-skeleton-hero {
  height: 520rpx;
}

.preview-skeleton-line {
  width: 84%;
  height: 28rpx;
  margin: 28rpx auto 0;
}

.preview-skeleton-line.short {
  width: 46%;
}

.preview-skeleton-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 34rpx;
}

.preview-skeleton-tile {
  width: calc(50% - 6rpx);
  flex: 0 0 calc(50% - 6rpx);
  height: 236rpx;
}

.preview-error {
  padding: 120rpx 48rpx 0;
  text-align: center;
  box-sizing: border-box;
}

.preview-error-title {
  color: #212529;
  font-size: 34rpx;
  font-weight: 900;
  line-height: 1.35;
}

.preview-error-message {
  margin-top: 18rpx;
  color: #868e96;
  font-size: 26rpx;
  line-height: 1.7;
}

.folio-component {
  margin-top: var(--portfolio-component-spacing, 32rpx);
}

.folio-carousel {
  width: 100%;
  height: 760rpx;
  border-radius: 40rpx;
  background: #f1f3f5;
}

.carousel-image {
  display: block;
  width: 100%;
  height: 100%;
}

.secondary-action,
.primary-button {
  width: 260rpx;
  height: 96rpx;
  margin: 24rpx auto 0;
  padding: 0;
  font-size: 26rpx;
  line-height: 96rpx;
  border-radius: 999rpx;
}

.secondary-action {
  color: #212529;
  border: 1rpx solid #dee2e6;
  background: #f5f6f7;
}

.primary-button {
  color: #ffffff;
  background: #212529;
}

.folio-brand-footer {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  padding: 56rpx 0 calc(160rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.folio-brand-logo {
  width: 56rpx;
  height: 56rpx;
}

.folio-brand-name {
  color: var(--portfolio-text-muted);
  font-size: 24rpx;
  font-weight: 800;
  line-height: 1.4;
}

.clipboard-prompt-card {
  position: fixed;
  left: 50%;
  bottom: calc(160rpx + env(safe-area-inset-bottom));
  z-index: 10020;
  max-width: calc(100vw - 96rpx);
  padding: 22rpx 30rpx;
  color: #ffffff;
  font-size: 25rpx;
  font-weight: 800;
  line-height: 1.45;
  text-align: center;
  border: 1rpx solid rgba(255, 255, 255, 0.26);
  border-radius: 24rpx;
  background: rgba(33, 37, 41, 0.94);
  box-shadow: 0 16rpx 42rpx rgba(0, 0, 0, 0.22);
  transform: translateX(-50%);
  box-sizing: border-box;
}
