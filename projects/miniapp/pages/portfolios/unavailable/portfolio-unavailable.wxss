  background: #ffffff;
  border-radius: 48rpx;
  border: 1rpx solid #e9ecef;
}

.unavailable-title {
  font-size: 36rpx;
  font-weight: 800;
}

.unavailable-desc {
  margin-top: 16rpx;
  color: #868e96;
  line-height: 1.6;
}
