.component-library-page {
  background: #f5f7fb;
}

.library-list {
  padding: 28rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.library-card {
  padding: 24rpx;
  background: #ffffff;
  border-radius: 12rpx;
  border: 1rpx solid #e2e8f0;
}

.library-title {
  font-size: 30rpx;
  font-weight: 700;
}

.library-type,
.library-desc {
  margin-top: 8rpx;
  color: #6b7787;
  font-size: 24rpx;
}
