<view class="page-shell component-library-page">
  <navigation-bar title="组件库" color="#17202a" background="rgba(245, 247, 251, 0.94)"></navigation-bar>
  <view class="library-list">
    <view wx:for="{{components}}" wx:key="componentType" class="library-card">
      <view class="library-title">{{item.name}}</view>
      <view class="library-type">{{item.componentType}}</view>
      <view class="library-desc">{{item.description}}</view>
    </view>
    <block wx:if="{{!components.length}}">
      <view class="library-card">
        <view class="library-title">轮播图</view>
        <view class="library-type">CAROUSEL</view>
        <view class="library-desc">展示已选择的图片作品</view>
      </view>
      <view class="library-card">
        <view class="library-title">双列作品列表</view>
        <view class="library-type">WORK_GRID</view>
        <view class="library-desc">展示已选择的图片或视频作品</view>
      </view>
      <view class="library-card">
        <view class="library-title">二维码联系</view>
        <view class="library-type">QR_CONTACT</view>
        <view class="library-desc">展示微信二维码等联系入口</view>
      </view>
      <view class="library-card">
        <view class="library-title">预留联系信息</view>
        <view class="library-type">CONTACT_FORM</view>
        <view class="library-desc">收集访客姓名、电话或微信</view>
      </view>
    </block>
  </view>
</view>
