.team-portfolio-menu-transition-content {
  width: 100%;
  will-change: opacity, transform;
}

.team-portfolio-menu-transition-content.team-portfolio-menu-exit-forward {
  animation: team-portfolio-menu-exit-forward 120ms ease-in both;
}

.team-portfolio-menu-transition-content.team-portfolio-menu-enter-forward {
  animation: team-portfolio-menu-enter-forward 220ms cubic-bezier(0.22, 1, 0.36, 1) both;
}

.team-portfolio-menu-transition-content.team-portfolio-menu-exit-backward {
  animation: team-portfolio-menu-exit-backward 120ms ease-in both;
}

.team-portfolio-menu-transition-content.team-portfolio-menu-enter-backward {
  animation: team-portfolio-menu-enter-backward 220ms cubic-bezier(0.22, 1, 0.36, 1) both;
}

@keyframes team-portfolio-menu-exit-forward {
  from { opacity: 1; transform: translate3d(0, 0, 0); }
  to { opacity: 0; transform: translate3d(-24rpx, 0, 0); }
}

@keyframes team-portfolio-menu-enter-forward {
  from { opacity: 0; transform: translate3d(24rpx, 0, 0); }
  to { opacity: 1; transform: translate3d(0, 0, 0); }
}

@keyframes team-portfolio-menu-exit-backward {
  from { opacity: 1; transform: translate3d(0, 0, 0); }
  to { opacity: 0; transform: translate3d(24rpx, 0, 0); }
}

@keyframes team-portfolio-menu-enter-backward {
  from { opacity: 0; transform: translate3d(-24rpx, 0, 0); }
  to { opacity: 1; transform: translate3d(0, 0, 0); }
}
