<navigation-bar title="添加组件" back="{{true}}" />
<view class="page-shell"><view wx:if="{{loading}}" class="state">加载中...</view><view wx:elif="{{errorMessage}}" class="state"><text>{{errorMessage}}</text><button bindtap="handleRetry">重试</button></view><view wx:elif="{{empty}}" class="state">暂无可用组件</view><view wx:else><button wx:for="{{components}}" wx:key="componentType" class="component" data-type="{{item.componentType}}" data-disabled="{{item.disabled}}" bindtap="handleSelect" disabled="{{selectingType || item.disabled}}"><text>{{item.name}}</text><text>{{item.description}}</text></button></view></view>
