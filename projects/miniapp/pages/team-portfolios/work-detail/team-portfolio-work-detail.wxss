page { height:100%; }.work-detail-page { height:100%; display:flex; flex-direction:column; }.work-detail-scroll { flex:1; min-height:0; }.work-detail-media { display:block; width:100%; height:520rpx; background:#000; }.work-detail-image { display:block; width:100%; }.work-detail-copy { padding:40rpx 32rpx 80rpx; }.work-detail-title { font-size:40rpx; font-weight:700; line-height:1.45; margin-bottom:24rpx; overflow-wrap:anywhere; }.work-detail-description { display:block; font-size:28rpx; line-height:1.8; white-space:pre-wrap; overflow-wrap:anywhere; }.work-detail-unavailable { flex:1; display:flex; flex-direction:column; align-items:center; justify-content:center; gap:28rpx; color:#868e96; }.work-detail-unavailable button { background:#212529; color:#fff; border-radius:16rpx; font-size:28rpx; }.theme-dark .work-detail-unavailable button { background:#fff; color:#212529; }

