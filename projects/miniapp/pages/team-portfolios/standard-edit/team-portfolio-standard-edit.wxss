.page-shell{min-height:100vh;padding:24rpx 28rpx 140rpx;background:#f5f7fb;color:#17202a}.panel{margin-bottom:20rpx;padding:24rpx;background:#fff;border-radius:12rpx}.panel input,.panel textarea{width:100%;box-sizing:border-box;margin-bottom:16rpx;padding:16rpx;background:#f5f7fb}.panel-title{min-width:0;margin-bottom:16rpx;font-weight:600;overflow-wrap:anywhere}.component-header{display:flex;align-items:center;justify-content:space-between;gap:16rpx;min-width:0}.component-header .panel-title{margin-bottom:0}.component-header button{flex:none}.cover{width:100%;height:260rpx;aspect-ratio:3/1;margin-bottom:16rpx;border-radius:8rpx;background:#eef1f4}.component-stack{display:flex;flex-direction:column;gap:16rpx;margin-top:16rpx}.component-wrapper{min-width:0;padding:16rpx;border:1rpx solid #e2e8ed;border-radius:8rpx;overflow-wrap:anywhere}.component-heading,.arrange{display:flex;align-items:center;gap:12rpx;min-width:0}.component-heading{justify-content:space-between;margin-bottom:12rpx;color:#5b6775;font-size:24rpx}.component-heading text{min-width:0;overflow-wrap:anywhere}.source-state{min-width:0;margin-bottom:12rpx;padding:12rpx;background:#f5f7fb;color:#5b6775;font-size:24rpx;overflow-wrap:anywhere}.source-error{background:#fff1f2;color:#b42318}.source-state button{margin-top:8rpx;font-size:22rpx}.arrange{justify-content:flex-end;margin-top:12rpx}.arrange button{font-size:22rpx}.bottom-actions{position:fixed;right:0;bottom:0;left:0;display:flex;gap:12rpx;padding:20rpx 28rpx calc(20rpx + env(safe-area-inset-bottom));background:#fff}.bottom-actions button{flex:1;min-width:0;font-size:24rpx}.primary{background:#0f766e!important;color:#fff}.state{min-width:0;padding:80rpx 20rpx;text-align:center;color:#5b6775;overflow-wrap:anywhere}
