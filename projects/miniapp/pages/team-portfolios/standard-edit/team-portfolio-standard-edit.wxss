@import "../../../styles/portfolio-text-typography.wxss";
@import "../../../styles/portfolio-text-section-editor.wxss";

.portfolio-edit-page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  background: #f5f6f7;
}

.edit-scroll {
  flex: 1;
  min-height: 0;
}

.edit-content {
  padding: 20rpx 32rpx calc(156rpx + env(safe-area-inset-bottom));
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  box-sizing: border-box;
}

.panel {
  background: #ffffff;
  border: 1rpx solid #e9ecef;
  border-radius: 48rpx;
  box-shadow: 0 16rpx 40rpx rgba(33, 37, 41, 0.05);
  box-sizing: border-box;
}

.share-panel,
.page-setting-panel,
.component-panel {
  padding: 28rpx;
}

.panel-heading,
.field-heading,
.component-row,
.bottom-actions,
.link-button,
.action-button,
.status-pill,
.component-order,
.component-drag-handle,
.component-row-arrow,
.component-move-button,
.component-remove-button,
.component-picker-heading,
.component-picker-count,
.component-picker-actions,
.component-picker-cancel,
.component-option,
.component-option-plus,
.component-option-added,
.cover-row,
.cover-preview,
.cover-empty {
  display: flex;
  align-items: center;
}

.panel-heading,
.component-row {
  justify-content: space-between;
}

.panel-heading {
  gap: 20rpx;
}

.heading-copy,
.component-copy {
  flex: 1 1 auto;
  min-width: 0;
}

.component-copy {
  display: flex;
  align-items: center;
}

.section-title {
  color: #212529;
  font-size: 32rpx;
  font-weight: 900;
  line-height: 1.25;
}

.section-desc {
  margin-top: 8rpx;
  color: #697786;
  font-size: 24rpx;
  line-height: 1.45;
}

.status-pill {
  flex: none;
  gap: 8rpx;
  color: #868e96;
  font-size: 22rpx;
  font-weight: 500;
  line-height: 1.4;
}

.status-pill::before {
  width: 12rpx;
  height: 12rpx;
  flex: none;
  content: "";
  border-radius: 50%;
  background: currentColor;
}

.status-pill.published {
  color: #5c9e6e;
}

.status-pill.muted {
  color: #697786;
}

.form-row {
  margin-top: 24rpx;
}

.field-heading {
  justify-content: space-between;
}

.field-label {
  color: #5f6b7a;
  font-size: 24rpx;
  font-weight: 800;
  line-height: 1.3;
}

.field-limit {
  flex: none;
  color: #8b96a3;
  font-size: 22rpx;
  font-weight: 700;
  line-height: 1.3;
}

.field-help {
  margin-top: 10rpx;
  color: #8b96a3;
  font-size: 21rpx;
}

.input {
  width: 100%;
  min-height: 84rpx;
  margin-top: 12rpx;
  padding: 0 22rpx;
  color: #212529;
  font-size: 28rpx;
  line-height: 84rpx;
  border-radius: 24rpx;
  background: #f1f3f5;
  box-sizing: border-box;
}

.textarea {
  height: 188rpx;
  min-height: 188rpx;
  padding-top: 20rpx;
  padding-bottom: 20rpx;
  line-height: 1.55;
}

.cover-row {
  gap: 20rpx;
  margin-top: 12rpx;
  align-items: flex-start;
}

.cover-preview {
  width: 360rpx;
  height: 288rpx;
  flex: 0 0 360rpx;
  justify-content: center;
  overflow: hidden;
  border: 1rpx solid #e9ecef;
  border-radius: 32rpx;
  background: #f1f3f5;
  box-sizing: border-box;
}

.cover-preview.disabled {
  opacity: 0.65;
}

.cover-preview image {
  width: 100%;
  height: 100%;
}

.cover-empty {
  justify-content: center;
  width: 100%;
  height: 100%;
  color: #8793a0;
  font-size: 24rpx;
  font-weight: 800;
}

.link-button {
  width: 136rpx;
  min-width: 136rpx;
  max-width: 136rpx;
  height: 56rpx;
  flex: 0 0 136rpx;
  justify-content: center;
  margin: 0;
  padding: 0;
  color: #495057;
  font-size: 24rpx;
  font-weight: 900;
  line-height: 1;
  border: 1rpx solid #dee2e6;
  border-radius: 999rpx;
  background: #f5f6f7;
  box-sizing: border-box;
}

.component-empty {
  margin-top: 24rpx;
  padding: 36rpx 0;
  color: #8a98a8;
  font-size: 24rpx;
  text-align: center;
}

.component-list {
  margin-top: 24rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.component-swipe-row {
  position: relative;
  overflow: hidden;
  border-radius: 32rpx;
}

.component-swipe-row.dragging {
  z-index: 3;
  overflow: visible;
}

.component-row {
  position: relative;
  z-index: 2;
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 116rpx;
  gap: 16rpx;
  padding: 18rpx;
  border: 1rpx solid #e9ecef;
  border-radius: 32rpx;
  background: #f5f6f7;
  box-shadow: 0 6rpx 22rpx rgba(23, 32, 42, 0.04);
  box-sizing: border-box;
  transition: transform 180ms ease, box-shadow 160ms ease, border-color 160ms ease, background 160ms ease;
}

.component-row.editable {
  background: #fcfdfd;
}

.component-swipe-row.revealed .component-row {
  transform: translateX(-140rpx);
}

.component-swipe-row.with-move.revealed .component-row {
  transform: translateX(-272rpx);
}

.component-row.dragging {
  border-color: #b8c9dc;
  background: #eef5fb;
  box-shadow: 0 12rpx 28rpx rgba(23, 32, 42, 0.1);
}

.component-row.drag-target {
  border-color: #212529;
}

.component-remove-pane {
  position: absolute;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 1;
  width: 128rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  transform: translateX(100%);
  opacity: 0;
  pointer-events: none;
  transition: transform 180ms ease, opacity 160ms ease;
}

.component-swipe-row.with-move .component-remove-pane {
  width: 256rpx;
  gap: 12rpx;
}

.component-swipe-row.revealed .component-remove-pane {
  transform: translateX(0);
  opacity: 1;
  pointer-events: auto;
}

.component-swipe-row.dragging .component-remove-pane {
  transform: translateX(100%);
  opacity: 0;
  pointer-events: none;
}

.component-remove-button {
  width: 108rpx;
  min-width: 108rpx;
  height: 100%;
  min-height: 100%;
  justify-content: center;
  margin: 0;
  padding: 0;
  color: #b55656;
  font-size: 22rpx;
  font-weight: 800;
  line-height: 1;
  border-radius: 14rpx;
  background: #feecef;
  box-sizing: border-box;
}

.component-move-button {
  width: 116rpx;
  min-width: 116rpx;
  height: 100%;
  min-height: 100%;
  justify-content: center;
  margin: 0;
  padding: 0;
  color: #3d658e;
  font-size: 22rpx;
  font-weight: 800;
  line-height: 1;
  border-radius: 14rpx;
  background: #eaf2fa;
  box-sizing: border-box;
}

.component-row.highlighted {
  border-color: #3d658e;
  background: #eef5fb;
  box-shadow: 0 0 0 4rpx rgba(61, 101, 142, 0.12);
}

.component-order {
  width: 48rpx;
  height: 48rpx;
  flex: none;
  align-self: center;
  justify-content: center;
  color: #ffffff;
  font-size: 22rpx;
  font-weight: 900;
  line-height: 48rpx;
  border-radius: 14rpx;
  background: #212529;
}

.component-drag-handle {
  width: 42rpx;
  height: 48rpx;
  flex: none;
  align-self: center;
  justify-content: center;
  border-radius: 12rpx;
  background: linear-gradient(to bottom, transparent 0, transparent 10rpx, #6f7f90 10rpx, #6f7f90 14rpx, transparent 14rpx, transparent 22rpx, #6f7f90 22rpx, #6f7f90 26rpx, transparent 26rpx, transparent 34rpx, #6f7f90 34rpx, #6f7f90 38rpx, transparent 38rpx, transparent 48rpx);
  background-position: center center;
  background-size: 22rpx 48rpx;
  background-repeat: no-repeat;
}

.component-title {
  overflow: hidden;
  color: #212529;
  font-size: 28rpx;
  font-weight: 900;
  line-height: 48rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.component-row-arrow {
  width: 28rpx;
  height: 48rpx;
  flex: none;
  align-self: center;
  justify-content: center;
  color: #697786;
  font-size: 0;
  font-weight: 700;
  line-height: 0;
}

.component-row-arrow-icon {
  width: 16rpx;
  height: 16rpx;
  border-right: 5rpx solid #697786;
  border-bottom: 5rpx solid #697786;
  transform: rotate(-45deg);
  box-sizing: border-box;
}

.component-picker-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 30;
  display: flex;
  align-items: flex-end;
  padding: 0;
  opacity: 0;
  pointer-events: none;
  background: rgba(17, 24, 39, 0.35);
  transition: opacity 225ms ease-out;
  box-sizing: border-box;
}

.component-picker-mask.visible {
  opacity: 1;
  pointer-events: auto;
}

