@import "../../../styles/portfolio-text-typography.wxss";
@import "../../../styles/portfolio-text-section-editor.wxss";
@import "../../../styles/portfolio-editor-foundation.wxss";
@import "../styles/team-member-selector.wxss";

.portfolio-edit-page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.edit-scroll {
  flex: 1;
  min-height: 0;
}

.field-heading,
.link-button,
.status-pill,
.component-drag-handle,
.component-row-arrow,
.component-move-button,
.component-option,
.component-option-plus,
.component-option-added,
.cover-row,
.cover-preview,
.cover-empty {
  display: flex;
  align-items: center;
}

.heading-copy,
.component-copy {
  flex: 1 1 auto;
  min-width: 0;
}

.component-copy {
  display: flex;
  align-items: center;
}

.component-copy.with-summary {
  flex-direction: column;
  align-items: flex-start;
  justify-content: center;
}

.status-pill {
  flex: none;
  gap: 8rpx;
  color: var(--pe-color-text-secondary, #868E96);
  font-size: 22rpx;
  font-weight: 500;
  line-height: 1.4;
}

.status-pill::before {
  width: 12rpx;
  height: 12rpx;
  flex: none;
  content: "";
  border-radius: 50%;
  background: currentColor;
}

.status-pill.published {
  color: #5c9e6e;
}

.status-pill.muted {
  color: var(--pe-color-text-secondary, #868E96);
}

.form-row {
  margin-top: 24rpx;
}

.field-heading {
  justify-content: space-between;
}

.field-label {
  color: var(--pe-color-text-strong, #495057);
  font-size: 24rpx;
  font-weight: 800;
  line-height: 1.3;
}

.field-limit {
  flex: none;
  color: var(--pe-color-text-muted, #ADB5BD);
  font-size: 22rpx;
  font-weight: 700;
  line-height: 1.3;
}

.field-help {
  margin-top: 10rpx;
  color: var(--pe-color-text-muted, #ADB5BD);
  font-size: 21rpx;
}

.cover-row {
  gap: 20rpx;
  margin-top: 12rpx;
  align-items: flex-start;
}

.cover-preview {
  width: 360rpx;
  height: 288rpx;
  flex: 0 0 360rpx;
  justify-content: center;
  overflow: hidden;
  border: 1rpx solid var(--pe-color-border, #E9ECEF);
  border-radius: 32rpx;
  background: var(--pe-color-secondary-disabled, #F1F3F5);
  box-sizing: border-box;
}

.cover-preview.disabled {
  opacity: 0.65;
}

.cover-preview image {
  width: 100%;
  height: 100%;
}

.cover-empty {
  justify-content: center;
  width: 100%;
  height: 100%;
  color: var(--pe-color-text-muted, #ADB5BD);
  font-size: 24rpx;
  font-weight: 800;
}

.link-button {
  width: 136rpx;
  min-width: 136rpx;
  max-width: 136rpx;
  height: 56rpx;
  flex: 0 0 136rpx;
  justify-content: center;
  margin: 0;
  padding: 0;
  color: var(--pe-color-text-strong, #495057);
  font-size: 24rpx;
  font-weight: 900;
  line-height: 1;
  border: 1rpx solid var(--pe-color-border-strong, #DEE2E6);
  border-radius: 999rpx;
  background: var(--pe-color-page, #F5F6F7);
  box-sizing: border-box;
}

.component-empty {
  margin-top: 24rpx;
  padding: 36rpx 0;
  color: var(--pe-color-text-muted, #ADB5BD);
  font-size: 24rpx;
  text-align: center;
}

.component-list {
  margin-top: 24rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.component-swipe-row {
  position: relative;
  overflow: hidden;
  border-radius: var(--pe-radius-control, 28rpx);
}

.component-swipe-row.dragging {
  z-index: 3;
  overflow: visible;
}

.component-swipe-row.revealed .component-row {
  transform: translateX(-140rpx);
}

.component-swipe-row.with-move.revealed .component-row {
  transform: translateX(-272rpx);
}

.component-row.dragging {
  border-color: var(--pe-color-border-strong, #DEE2E6);
  background: var(--pe-color-page, #F5F6F7);
  box-shadow: none;
}

.component-row.drag-target {
  border-color: var(--pe-color-text-primary, #212529);
}

.component-remove-pane {
  position: absolute;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 1;
  width: 128rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  transform: translateX(100%);
  opacity: 0;
  pointer-events: none;
  transition: transform 180ms ease, opacity 160ms ease;
}

.component-swipe-row.with-move .component-remove-pane {
  width: 256rpx;
  gap: 12rpx;
}

.component-swipe-row.revealed .component-remove-pane {
  transform: translateX(0);
  opacity: 1;
  pointer-events: auto;
}

.component-swipe-row.dragging .component-remove-pane {
  transform: translateX(100%);
  opacity: 0;
  pointer-events: none;
}

.component-move-button {
  width: 116rpx;
  min-width: 116rpx;
  height: 100%;
  min-height: 100%;
  justify-content: center;
  margin: 0;
  padding: 0;
  color: var(--pe-color-text-primary, #212529);
  font-size: 22rpx;
  font-weight: 800;
  line-height: 1;
  border: 1rpx solid var(--pe-color-border, #E9ECEF);
  border-radius: var(--pe-radius-control, 28rpx);
  background: var(--pe-color-page, #F5F6F7);
  box-sizing: border-box;
}

.component-row.highlighted {
  border-color: var(--pe-color-text-primary, #212529);
  background: var(--pe-color-surface, #FFFFFF);
  box-shadow: none;
}

.component-drag-handle {
  width: 42rpx;
  height: 48rpx;
  flex: none;
  align-self: center;
  justify-content: center;
  border-radius: 12rpx;
  background: linear-gradient(to bottom, transparent 0, transparent 10rpx, #6f7f90 10rpx, #6f7f90 14rpx, transparent 14rpx, transparent 22rpx, #6f7f90 22rpx, #6f7f90 26rpx, transparent 26rpx, transparent 34rpx, #6f7f90 34rpx, #6f7f90 38rpx, transparent 38rpx, transparent 48rpx);
  background-position: center center;
  background-size: 22rpx 48rpx;
  background-repeat: no-repeat;
}

.component-row-arrow {
  width: 28rpx;
  height: 48rpx;
  flex: none;
  align-self: center;
  justify-content: center;
  color: var(--pe-color-text-secondary, #868E96);
  font-size: 0;
  font-weight: 700;
  line-height: 0;
}

.component-row-arrow-icon {
  width: 16rpx;
  height: 16rpx;
  border-right: 5rpx solid var(--pe-color-text-secondary, #868E96);
  border-bottom: 5rpx solid var(--pe-color-text-secondary, #868E96);
  transform: rotate(-45deg);
  box-sizing: border-box;
}

.contact-form-sheet-form {
  padding: 4rpx 0 8rpx;
}

.schedule-query-sheet-form,
.divider-sheet-form {
  padding: 4rpx 0 8rpx;
}

.contact-form-display-mode-list {
  margin-top: 16rpx;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.schedule-query-display-mode-list,
.divider-color-list {
  margin-top: 16rpx;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.contact-form-display-mode-option {
  width: 100%;
  min-height: 88rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.schedule-query-display-mode-option,
.divider-color-option {
  width: 100%;
  min-height: 88rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.contact-form-display-mode-radio {
  width: 28rpx;
  height: 28rpx;
  flex: none;
  border: 3rpx solid var(--pe-color-border-strong, #DEE2E6);
  border-radius: 50%;
  background: var(--pe-color-surface, #FFFFFF);
  box-sizing: border-box;
}

.schedule-query-display-mode-radio {
  width: 28rpx;
  height: 28rpx;
  flex: none;
  border: 3rpx solid var(--pe-color-border-strong, #DEE2E6);
  border-radius: 50%;
  background: var(--pe-color-surface, #FFFFFF);
  box-sizing: border-box;
}

.contact-form-display-mode-option[aria-checked="true"] .contact-form-display-mode-radio {
  border-color: var(--pe-color-text-primary, #212529);
  background: var(--pe-color-text-primary, #212529);
  box-shadow: inset 0 0 0 7rpx var(--pe-color-surface, #FFFFFF);
}

.schedule-query-display-mode-option[aria-checked="true"] .schedule-query-display-mode-radio {
  border-color: var(--pe-color-text-primary, #212529);
  background: var(--pe-color-text-primary, #212529);
  box-shadow: inset 0 0 0 7rpx var(--pe-color-surface, #FFFFFF);
}

.contact-form-display-mode-label {
  flex: 1 1 0;
  min-width: 0;
  color: var(--pe-color-text-primary, #212529);
  font-size: 28rpx;
  font-weight: 800;
  line-height: 1.3;
}

.schedule-query-display-mode-label,
.divider-color-label {
  flex: 1 1 0;
  min-width: 0;
  color: var(--pe-color-text-primary, #212529);
  font-size: 28rpx;
  font-weight: 800;
  line-height: 1.3;
}

.divider-color-swatch {
  width: 32rpx;
  height: 32rpx;
  flex: none;
  border: 1rpx solid var(--pe-color-border-strong, #DEE2E6);
  border-radius: 50%;
  box-sizing: border-box;
}

.text-section-sheet-textarea {
  height: 220rpx;
  min-height: 220rpx;
}

.text-section-alignment-list {
  margin-top: 16rpx;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.text-section-alignment-option {
  width: 100%;
  min-height: 88rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.text-section-alignment-radio {
  width: 28rpx;
  height: 28rpx;
  flex: none;
  border: 3rpx solid var(--pe-color-border-strong, #DEE2E6);
  border-radius: 50%;
  background: var(--pe-color-surface, #FFFFFF);
  box-sizing: border-box;
}

.text-section-alignment-option[aria-checked="true"] .text-section-alignment-radio {
  border-color: var(--pe-color-text-primary, #212529);
  background: var(--pe-color-text-primary, #212529);
  box-shadow: inset 0 0 0 7rpx var(--pe-color-surface, #FFFFFF);
}

.text-section-alignment-label {
  flex: 1 1 0;
  min-width: 0;
  color: var(--pe-color-text-primary, #212529);
  font-size: 28rpx;
  font-weight: 800;
  line-height: 1.3;
}

.component-option-scroll {
  height: 46vh;
  min-height: 320rpx;
  max-height: 46vh;
  flex: 1 1 auto;
}

.component-option-list-content {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.component-option {
  width: 100%;
  min-width: 100%;
  max-width: 100%;
  min-height: 106rpx;
  justify-content: space-between;
  margin: 0;
}

.component-option.disabled {
  opacity: 0.5;
}

.component-option-copy {
  min-width: 0;
  flex: 1 1 auto;
  text-align: left;
}

.component-option-name {
  color: var(--pe-color-text-primary, #212529);
  font-size: 26rpx;
  font-weight: 900;
  line-height: 1.25;
}

.component-option-desc {
  overflow: hidden;
  margin-top: 8rpx;
  color: var(--pe-color-text-secondary, #868E96);
  font-size: 22rpx;
  line-height: 1.3;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.component-option-plus {
  width: 44rpx;
  height: 44rpx;
  flex: none;
  justify-content: center;
  margin-left: 18rpx;
  color: var(--pe-color-surface, #FFFFFF);
  font-size: 28rpx;
  font-weight: 900;
  line-height: 1;
  border-radius: 50%;
  background: var(--pe-color-text-primary, #212529);
}

.component-option-added {
  width: auto;
  min-width: 104rpx;
  height: 44rpx;
  flex: none;
  justify-content: center;
  margin-left: 18rpx;
  padding: 0 18rpx;
  color: var(--pe-color-surface, #FFFFFF);
  font-size: 22rpx;
  font-weight: 800;
  line-height: 1;
  border-radius: 999rpx;
  background: var(--pe-color-text-primary, #212529);
  box-sizing: border-box;
  white-space: nowrap;
}

.component-editor-scroll {
  height: 58vh;
  min-height: 320rpx;
  max-height: 58vh;
  flex: 1 1 auto;
}

/* 单列、双列作品集的编辑内容已改为单行横向选择，使用更短的弹层。 */
.member-portfolio-editor-compact {
  height: auto;
  max-height: 76vh;
}

.member-portfolio-editor-compact .component-editor-scroll {
  height: 680rpx;
  min-height: 0;
  max-height: 58vh;
  flex: 0 1 auto;
}

/* 轮播图的列表与弹层按作品数同步伸缩，超出上限后仅滚动作品列表。 */
.carousel-editor-content-sized {
  min-height: 710rpx;
  max-height: calc(100vh - 176rpx - env(safe-area-inset-top));
  transition: transform 220ms ease-out, height 220ms ease-out;
}

.carousel-editor-content-sized .component-editor-scroll {
  min-height: 460rpx;
  max-height: 58vh;
  flex: 0 1 auto;
  transition: height 220ms ease-out;
}

.component-editor-content {
  padding: 2rpx 0 12rpx;
}

.editor-notice,
.source-state {
  padding: 16rpx;
  color: var(--pe-color-text-strong, #495057);
  font-size: 23rpx;
  border-radius: 28rpx;
  background: var(--pe-color-secondary-disabled, #F1F3F5);
}

.source-error {
  color: var(--pe-color-danger, #B55656);
  background: var(--pe-color-danger-surface, #FFF1F1);
}

.source-error button {
  margin-top: 10rpx;
}

.team-video-editor-settings {
  width: 100%;
  flex-direction: column;
  align-items: stretch;
  gap: 4rpx;
  padding-bottom: 14rpx;
  border-bottom: 1rpx solid var(--pe-color-border, #E9ECEF);
}

.team-video-title-setting,
.team-video-switch-copy {
  flex-direction: column;
  align-items: stretch;
}

.team-video-title-setting {
  gap: 10rpx;
  padding: 8rpx 0 14rpx;
}

.team-video-setting-heading,
.team-video-switch-setting {
  justify-content: space-between;
  gap: 24rpx;
}

.team-video-title-count,
.team-video-switch-note,
.team-video-work-meta {
  color: var(--pe-color-text-secondary, #868E96);
  font-size: 21rpx;
  line-height: 1.35;
}

.team-video-title-input,
.team-video-search {
  width: 100%;
  border: 1rpx solid var(--pe-color-border-strong, #DEE2E6);
  border-radius: 14rpx;
  background: var(--pe-color-page, #F5F6F7);
  box-sizing: border-box;
}

.team-video-title-input {
  min-height: 68rpx;
  padding: 0 18rpx;
}

.team-video-switch-setting {
  min-height: 84rpx;
  padding: 14rpx 0;
}

.team-video-switch-copy {
  min-width: 0;
  flex: 1 1 0;
  align-items: flex-start;
  gap: 4rpx;
}

.team-video-switch-title,
.team-video-work-title {
  color: var(--pe-color-text-primary, #212529);
  font-size: 24rpx;
  font-weight: 800;
  line-height: 1.35;
}

.team-video-source-state {
  min-height: 112rpx;
  justify-content: center;
  gap: 12rpx;
  color: var(--pe-color-text-secondary, #868E96);
  font-size: 23rpx;
  text-align: center;
}

.team-video-member-field {
  margin-top: 20rpx;
}

.team-video-search {
  height: 64rpx;
  gap: 14rpx;
  margin-top: 12rpx;
  padding: 0 18rpx;
}

.team-video-search-icon {
  width: 18rpx;
  height: 18rpx;
  flex: none;
  border: 3rpx solid var(--pe-color-text-muted, #ADB5BD);
  border-radius: 50%;
}

.team-video-search-input {
  min-width: 0;
  flex: 1 1 0;
}

.team-video-search-clear {
  width: 34rpx;
  height: 34rpx;
  justify-content: center;
  border-radius: 50%;
  background: var(--pe-color-border-strong, #DEE2E6);
}

.team-video-work-scroll {
  width: 100%;
  height: 520rpx;
  margin-top: 14rpx;
}

.team-video-work-list {
  flex-direction: column;
  align-items: stretch;
  gap: 12rpx;
}

.team-video-work-option {
  width: 100%;
  min-height: 112rpx;
  gap: 16rpx;
}

.team-video-work-thumb {
  width: 92rpx;
  height: 76rpx;
  flex: none;
  overflow: hidden;
  border-radius: 12rpx;
  background: var(--pe-color-page, #F5F6F7);
}

.team-video-work-thumb image,
.team-video-work-placeholder {
  width: 100%;
  height: 100%;
}

.team-video-work-placeholder {
  justify-content: center;
  color: var(--pe-color-text-muted, #ADB5BD);
  font-size: 20rpx;
}

.team-video-work-copy {
  min-width: 0;
  flex: 1 1 0;
  flex-direction: column;
  align-items: flex-start;
  gap: 7rpx;
}

.team-video-work-order {
  width: 44rpx;
  height: 44rpx;
  flex: none;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--pe-color-surface, #FFFFFF);
  font-size: 22rpx;
  font-weight: 900;
  line-height: 1;
  border-radius: 50%;
  background: var(--pe-color-border-strong, #DEE2E6);
}

.team-video-work-option[aria-checked="true"] .team-video-work-order {
  background: var(--pe-color-text-primary, #212529);
}

.team-video-work-footer {
  min-height: 48rpx;
  justify-content: center;
  color: var(--pe-color-text-muted, #ADB5BD);
  font-size: 22rpx;
}

.component-editor-actions button[disabled] {
  opacity: 0.42;
}

.share-cover-crop-stage {
  position: relative;
  width: 100%;
  aspect-ratio: 5 / 4;
  overflow: hidden;
  border-radius: 40rpx;
  background: var(--pe-color-text-primary, #212529);
}

.share-cover-crop-image {
  display: block;
  width: 100%;
  height: 100%;
}

.share-cover-crop-frame {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  border: 3rpx solid rgba(255, 255, 255, 0.9);
  box-sizing: border-box;
}

.qr-contact-crop-backdrop {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
}

.qr-contact-crop-stage {
  position: relative;
  align-self: center;
  flex: none;
  overflow: hidden;
  border-radius: 40rpx;
  background: var(--pe-color-text-primary, #212529);
}

.qr-contact-crop-image {
  position: absolute;
  left: 0;
  top: 0;
  transform-origin: 0 0;
  will-change: transform;
}

.qr-contact-crop-frame {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  border: 2rpx solid rgba(255, 255, 255, 0.95);
  box-shadow: inset 0 0 0 1rpx rgba(23, 32, 42, 0.22);
  pointer-events: none;
  box-sizing: border-box;
}

.qr-contact-crop-error {
  color: var(--pe-color-danger, #B55656);
  font-size: 24rpx;
  line-height: 1.4;
}

.qr-contact-crop-canvas {
  position: fixed;
  left: -9999px;
  top: -9999px;
  opacity: 0;
  pointer-events: none;
}

.page-state {
  padding: 120rpx 40rpx;
  color: var(--pe-color-text-secondary, #868E96);
  text-align: center;
}

.state-retry {
  width: 180rpx;
  margin-top: 24rpx;
}

.error-state {
  color: var(--pe-color-danger, #B55656);
}

.preview-action-stack {
  flex: 1 1 0;
  min-width: 0;
}

.preview-action-stack .action-button {
  width: 100%;
}

.preview-draft-button {
  flex-direction: column;
  gap: 6rpx;
}

.preview-action-title {
  color: var(--pe-color-text-primary, #212529);
  font-size: 28rpx;
  font-weight: 900;
  line-height: 1;
}

.preview-action-note {
  color: var(--pe-color-text-secondary, #868E96);
  font-size: 20rpx;
  font-weight: 700;
  line-height: 1;
  text-align: center;
}

.background-custom-button {
  min-width: 116rpx;
  height: 56rpx;
  margin: 0;
  padding: 0 22rpx;
  color: var(--pe-color-text-primary, #212529);
  font-size: 23rpx;
  font-weight: 700;
  line-height: 56rpx;
  border-radius: 999rpx;
  background: var(--pe-color-secondary-disabled, #F1F3F5);
}

.background-color-current {
  width: 92rpx;
  height: 56rpx;
  flex: none;
  border: 1rpx solid var(--pe-color-border-strong, #DEE2E6);
  border-radius: 20rpx;
  box-sizing: border-box;
}

.background-color-panel {
  gap: 16rpx;
}

.team-background-color-pad {
  position: relative;
  height: 360rpx;
  overflow: hidden;
  border: 1rpx solid var(--pe-color-border, #E9ECEF);
  border-radius: 40rpx;
}

.background-color-pad-white,
.background-color-pad-black {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
}

.background-color-pad-white {
  background: linear-gradient(to right, var(--pe-color-surface, #FFFFFF), rgba(255, 255, 255, 0));
}

.background-color-pad-black {
  background: linear-gradient(to top, #000000, rgba(0, 0, 0, 0));
}

.background-color-pad-dot {
  position: absolute;
  width: 36rpx;
  height: 36rpx;
  border: 6rpx solid var(--pe-color-surface, #FFFFFF);
  border-radius: 50%;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.35);
  transform: translate(-50%, -50%);
  box-sizing: border-box;
}

.background-hue-slider {
  position: relative;
  height: 32rpx;
  margin-top: 24rpx;
  border-radius: 999rpx;
  background: linear-gradient(to right, #ff3b30, #ffcc00, #34c759, #0a84ff, #5856d6, #af52de, #ff3b30);
}

.background-hue-slider slider {
  position: absolute;
  left: 0;
  right: 0;
  top: 50%;
  z-index: 2;
  width: 100%;
  margin: 0;
  transform: translateY(-50%);
}

.background-hue-thumb {
  position: absolute;
  top: 50%;
  z-index: 1;
  width: 44rpx;
  height: 44rpx;
  border: 6rpx solid var(--pe-color-surface, #FFFFFF);
  border-radius: 50%;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.3);
  transform: translate(-50%, -50%);
  box-sizing: border-box;
  pointer-events: none;
}

.background-hex-input {
  margin-top: 28rpx;
  font-weight: 700;
}

.background-color-preview-bar {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-top: 20rpx;
  padding: 16rpx 24rpx;
  border: 1rpx solid var(--pe-color-border, #E9ECEF);
  border-radius: 40rpx;
}

.background-color-preview-chip {
  width: 80rpx;
  height: 56rpx;
  flex: none;
  border: 1rpx solid var(--pe-color-border, #E9ECEF);
  border-radius: 20rpx;
}

.background-color-preview-text {
  color: var(--pe-color-text-secondary, #868E96);
  font-size: 24rpx;
}

.page-setting-panel .form-row {
  padding-bottom: 0;
  border-bottom: 0;
}

.background-color-row,
.bottom-nav-count-row,
.editor-menu-bar,
.editor-menu-rename {
  display: flex;
  align-items: center;
}

.background-color-row {
  gap: 20rpx;
  margin-top: 16rpx;
}

.background-color-swatch {
  width: 56rpx;
  height: 56rpx;
  flex: none;
  border: 1rpx solid var(--pe-color-border-strong, #DEE2E6);
  border-radius: 50%;
  box-sizing: border-box;
}

.background-color-swatch.active {
  box-shadow: 0 0 0 4rpx var(--pe-color-surface, #FFFFFF), 0 0 0 8rpx var(--pe-color-text-primary, #212529);
}

.bottom-nav-count-row {
  gap: 12rpx;
  margin-top: 16rpx;
}

.bottom-nav-count-option {
  flex: 1;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--pe-color-text-primary, #212529);
  font-size: 24rpx;
  font-weight: 700;
  border-radius: 999rpx;
  background: var(--pe-color-secondary-disabled, #F1F3F5);
}

.bottom-nav-count-option.active {
  color: var(--pe-color-surface, #FFFFFF);
  background: var(--pe-color-text-primary, #212529);
}

.editor-menu-bar {
  gap: 8rpx;
  margin-top: 20rpx;
  padding: 8rpx;
  border-radius: 999rpx;
  background: var(--pe-color-text-primary, #212529);
}

.editor-menu-item {
  flex: 1;
  min-width: 0;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: rgba(255, 255, 255, 0.62);
  font-size: 24rpx;
  font-weight: 700;
  border-radius: 999rpx;
  gap: 10rpx;
}

.editor-menu-item.active {
  color: var(--pe-color-text-primary, #212529);
  background: var(--pe-color-surface, #FFFFFF);
}

.editor-menu-rename {
  gap: 16rpx;
  margin-top: 16rpx;
}

.editor-menu-title-input {
  flex: 1;
  height: 72rpx;
  padding: 0 24rpx;
  font-size: 24rpx;
  font-weight: 700;
  border-radius: 999rpx;
  background: var(--pe-color-secondary-disabled, #F1F3F5);
  box-sizing: border-box;
}

.editor-menu-title-count {
  flex: none;
  color: var(--pe-color-text-muted, #ADB5BD);
  font-size: 22rpx;
}

.editor-menu-remove {
  height: 64rpx;
  margin: 0;
  padding: 0 22rpx;
  color: var(--pe-color-danger, #B55656);
  font-size: 22rpx;
  line-height: 64rpx;
  border-radius: 999rpx;
  background: var(--pe-color-danger-surface, #FFF1F1);
}

.component-move-target {
  display: flex;
  align-items: center;
}

.component-move-target-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  padding: 0 28rpx 24rpx;
}

.component-move-target {
  justify-content: space-between;
  min-height: 104rpx;
}

.component-move-target-copy {
  min-width: 0;
}

.component-move-target-title {
  color: var(--pe-color-text-primary, #212529);
  font-size: 26rpx;
  font-weight: 900;
}

.component-move-target-count {
  margin-top: 6rpx;
  color: var(--pe-color-text-muted, #ADB5BD);
  font-size: 22rpx;
}

.link-button::after,
.action-button::after,
.background-custom-button::after,
.component-move-button::after,
.component-remove-button::after,
.editor-menu-remove::after,
.component-picker-cancel::after,
.component-picker-confirm::after,
.editor-close::after,
.sheet-cancel::after,
.sheet-confirm::after {
  border: 0;
}
