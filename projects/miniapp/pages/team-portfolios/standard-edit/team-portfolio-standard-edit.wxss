  background: #212529;
}

.editor-notice,
.source-state {
  padding: 16rpx;
  color: #685019;
  font-size: 23rpx;
  border-radius: 28rpx;
  background: #fbf3e7;
}

.source-error {
  color: #b55656;
  background: #fbefef;
}

.source-error button {
  margin-top: 10rpx;
}

.share-cover-crop-stage {
  position: relative;
  width: 100%;
  aspect-ratio: 5 / 4;
  overflow: hidden;
  border-radius: 40rpx;
  background: #212529;
}

.share-cover-crop-image {
  display: block;
  width: 100%;
  height: 100%;
}

.share-cover-crop-frame {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  border: 3rpx solid rgba(255, 255, 255, 0.9);
  box-sizing: border-box;
}

.sheet-actions {
  display: flex;
  flex: none;
  gap: 16rpx;
}

.sheet-actions button {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 1 1 0;
  height: 72rpx;
  margin: 0;
  padding: 0;
  line-height: 1;
  border-radius: 999rpx;
  box-sizing: border-box;
}

.sheet-cancel {
  color: #536b82;
  background: #eef3f7;
}

.sheet-confirm {
  color: #ffffff;
  background: #212529;
}

.qr-contact-crop-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 45;
  display: flex;
  align-items: flex-end;
  opacity: 0;
  pointer-events: none;
  transition: opacity 215ms ease-out;
}

.qr-contact-crop-mask.visible {
  opacity: 1;
  pointer-events: auto;
}

.qr-contact-crop-backdrop {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(23, 32, 42, 0.42);
}

.qr-contact-crop-panel {
  position: relative;
  width: 100%;
  display: flex;
  flex-direction: column;
  gap: 22rpx;
  padding: 28rpx 32rpx calc(32rpx + env(safe-area-inset-bottom));
  border-radius: 56rpx 56rpx 0 0;
  background: #ffffff;
  box-shadow: 0 -18rpx 48rpx rgba(23, 32, 42, 0.18);
  box-sizing: border-box;
  transform: translateY(40rpx);
  transition: transform 215ms cubic-bezier(0.2, 0, 0.1, 1);
}

.qr-contact-crop-mask.visible .qr-contact-crop-panel {
  transform: translateY(0);
}

.qr-contact-crop-stage {
  position: relative;
  align-self: center;
  flex: none;
  overflow: hidden;
  border-radius: 40rpx;
  background: #212529;
}

.qr-contact-crop-image {
  position: absolute;
  left: 0;
  top: 0;
  transform-origin: 0 0;
  will-change: transform;
}

.qr-contact-crop-frame {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  border: 2rpx solid rgba(255, 255, 255, 0.95);
  box-shadow: inset 0 0 0 1rpx rgba(23, 32, 42, 0.22);
  pointer-events: none;
  box-sizing: border-box;
}

.qr-contact-crop-error {
  color: #d83a3a;
  font-size: 24rpx;
  line-height: 1.4;
}

.qr-contact-crop-canvas {
  position: fixed;
  left: -9999px;
  top: -9999px;
  opacity: 0;
  pointer-events: none;
}

.page-state {
  padding: 120rpx 40rpx;
  color: #697786;
  text-align: center;
}

.state-retry {
  width: 180rpx;
  margin-top: 24rpx;
}

.error-state {
  color: #b55656;
}

.bottom-actions {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 10;
  display: flex;
  gap: 12rpx;
  padding: 18rpx 32rpx calc(18rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid rgba(23, 32, 42, 0.08);
  background: rgba(255, 255, 255, 0.96);
  box-shadow: 0 -12rpx 36rpx rgba(23, 32, 42, 0.08);
  box-sizing: border-box;
}

.action-button {
  flex: 1 1 0;
  min-width: 0;
  height: 96rpx;
  justify-content: center;
  margin: 0;
  padding: 0 12rpx;
  font-size: 28rpx;
  font-weight: 900;
  line-height: 1;
  border-radius: 999rpx;
  box-sizing: border-box;
}

.preview-action-stack {
  flex: 1 1 0;
  min-width: 0;
}

.preview-action-stack .action-button {
  width: 100%;
}

.preview-draft-button {
  flex-direction: column;
  gap: 6rpx;
}

.preview-action-title {
  color: #212529;
  font-size: 28rpx;
  font-weight: 900;
  line-height: 1;
}

.preview-action-note {
  color: #697786;
  font-size: 20rpx;
  font-weight: 700;
  line-height: 1;
  text-align: center;
}

.primary-button {
  color: #ffffff;
  background: #212529;
  box-shadow: 0 18rpx 44rpx rgba(23, 32, 42, 0.16);
}

.secondary-button {
  color: #212529;
  background: #e9ecef;
}

.publish-button {
  color: #ffffff;
  background: #212529;
  box-shadow: 0 18rpx 44rpx rgba(33, 37, 41, 0.16);
}

.background-custom-button {
  min-width: 116rpx;
  height: 56rpx;
  margin: 0;
  padding: 0 22rpx;
  color: #212529;
  font-size: 23rpx;
  font-weight: 700;
  line-height: 56rpx;
  border-radius: 999rpx;
  background: #f1f3f5;
}

.background-color-current {
  width: 92rpx;
  height: 56rpx;
  flex: none;
  border: 1rpx solid #dee2e6;
  border-radius: 20rpx;
  box-sizing: border-box;
}

.background-color-panel {
  gap: 16rpx;
}

.team-background-color-pad {
  position: relative;
  height: 360rpx;
  overflow: hidden;
  border: 1rpx solid #e9ecef;
  border-radius: 40rpx;
}

.background-color-pad-white,
.background-color-pad-black {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
}

.background-color-pad-white {
  background: linear-gradient(to right, #ffffff, rgba(255, 255, 255, 0));
}

.background-color-pad-black {
  background: linear-gradient(to top, #000000, rgba(0, 0, 0, 0));
}

.background-color-pad-dot {
  position: absolute;
  width: 36rpx;
  height: 36rpx;
  border: 6rpx solid #ffffff;
  border-radius: 50%;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.35);
  transform: translate(-50%, -50%);
  box-sizing: border-box;
}

.background-hue-slider {
  position: relative;
  height: 32rpx;
  margin-top: 24rpx;
  border-radius: 999rpx;
  background: linear-gradient(to right, #ff3b30, #ffcc00, #34c759, #0a84ff, #5856d6, #af52de, #ff3b30);
}

.background-hue-slider slider {
  position: absolute;
  left: 0;
  right: 0;
  top: 50%;
  z-index: 2;
  width: 100%;
  margin: 0;
  transform: translateY(-50%);
}

.background-hue-thumb {
  position: absolute;
  top: 50%;
  z-index: 1;
  width: 44rpx;
  height: 44rpx;
  border: 6rpx solid #ffffff;
  border-radius: 50%;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.3);
  transform: translate(-50%, -50%);
  box-sizing: border-box;
  pointer-events: none;
}

.background-hex-input {
  height: 84rpx;
  margin-top: 28rpx;
  padding: 0 28rpx;
  color: #212529;
  font-size: 26rpx;
  font-weight: 700;
  border-radius: 999rpx;
  background: #f5f6f7;
  box-sizing: border-box;
}

.background-color-preview-bar {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-top: 20rpx;
  padding: 16rpx 24rpx;
  border: 1rpx solid #e9ecef;
  border-radius: 40rpx;
}

.background-color-preview-chip {
  width: 80rpx;
  height: 56rpx;
  flex: none;
  border: 1rpx solid #e9ecef;
  border-radius: 20rpx;
}

.background-color-preview-text {
  color: #868e96;
  font-size: 24rpx;
}

.component-picker-confirm {
  width: 148rpx;
  height: 60rpx;
  margin: 0;
  padding: 0;
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 800;
  line-height: 60rpx;
  border-radius: 999rpx;
  background: #212529;
}

.page-setting-panel .form-row {
  padding-bottom: 0;
  border-bottom: 0;
}

.background-color-row,
.bottom-nav-count-row,
.editor-menu-bar,
.editor-menu-rename {
  display: flex;
  align-items: center;
}

.background-color-row {
  gap: 20rpx;
  margin-top: 16rpx;
}

.background-color-swatch {
  width: 56rpx;
  height: 56rpx;
  flex: none;
  border: 1rpx solid #dee2e6;
  border-radius: 50%;
  box-sizing: border-box;
}

.background-color-swatch.active {
  box-shadow: 0 0 0 4rpx #ffffff, 0 0 0 8rpx #212529;
}

.bottom-nav-count-row {
  gap: 12rpx;
  margin-top: 16rpx;
}

.bottom-nav-count-option {
  flex: 1;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #212529;
  font-size: 24rpx;
  font-weight: 700;
  border-radius: 999rpx;
  background: #f1f3f5;
}

.bottom-nav-count-option.active {
  color: #ffffff;
  background: #212529;
}

.editor-menu-bar {
  gap: 8rpx;
  margin-top: 20rpx;
  padding: 8rpx;
  border-radius: 999rpx;
  background: #212529;
}

.editor-menu-item {
  flex: 1;
  min-width: 0;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: rgba(255, 255, 255, 0.62);
  font-size: 24rpx;
  font-weight: 700;
  border-radius: 999rpx;
  gap: 10rpx;
}

.editor-menu-item.active {
  color: #212529;
  background: #ffffff;
}

.editor-menu-rename {
  gap: 16rpx;
  margin-top: 16rpx;
}

.editor-menu-title-input {
  flex: 1;
  height: 72rpx;
  padding: 0 24rpx;
  font-size: 24rpx;
  font-weight: 700;
  border-radius: 999rpx;
  background: #f1f3f5;
  box-sizing: border-box;
}

.editor-menu-title-count {
  flex: none;
  color: #adb5bd;
  font-size: 22rpx;
}

.editor-menu-remove {
  height: 64rpx;
  margin: 0;
  padding: 0 22rpx;
  color: #b55656;
  font-size: 22rpx;
  line-height: 64rpx;
  border-radius: 999rpx;
  background: #fff1f1;
}

.component-move-target {
  display: flex;
  align-items: center;
}

.component-move-sheet-panel {
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
}

.component-move-target-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  padding: 0 28rpx 24rpx;
}

.component-move-target {
  justify-content: space-between;
  min-height: 104rpx;
  padding: 18rpx 22rpx;
  border: 1rpx solid #e1e7ec;
  border-radius: 24rpx;
  background: #f8f9fa;
  box-sizing: border-box;
}

.component-move-target-copy {
  min-width: 0;
}

.component-move-target-title {
  color: #212529;
  font-size: 26rpx;
  font-weight: 900;
}

.component-move-target-count {
  margin-top: 6rpx;
  color: #8a98a8;
  font-size: 22rpx;
}

.link-button::after,
.action-button::after,
.background-custom-button::after,
.component-move-button::after,
.component-remove-button::after,
.editor-menu-remove::after,
.component-picker-cancel::after,
.component-picker-confirm::after,
.editor-close::after,
.sheet-cancel::after,
.sheet-confirm::after {
  border: 0;
}
