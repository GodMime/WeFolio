.portfolio-edit-page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  background: #f5f7fb;
}

.edit-scroll {
  flex: 1;
  min-height: 0;
}

.edit-content {
  padding: 28rpx 28rpx calc(156rpx + env(safe-area-inset-bottom));
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  box-sizing: border-box;
}

.panel {
  background: rgba(255, 255, 255, 0.96);
  border: 1rpx solid #d9e2eb;
  border-radius: 16rpx;
  box-shadow: 0 18rpx 48rpx rgba(23, 32, 42, 0.06);
  box-sizing: border-box;
}

.share-panel,
.component-panel {
  padding: 28rpx;
}

.panel-heading,
.field-heading,
.component-row,
.bottom-actions,
.link-button,
.action-button,
.status-pill,
.component-order,
.component-drag-handle,
.component-row-arrow,
.component-remove-button,
.component-picker-heading,
.component-picker-count,
.component-picker-actions,
.component-picker-cancel,
.component-option,
.component-option-plus,
.component-option-added,
.cover-row,
.cover-preview,
.cover-empty {
  display: flex;
  align-items: center;
}

.panel-heading,
.component-row {
  justify-content: space-between;
}

.panel-heading {
  gap: 20rpx;
}

.heading-copy,
.component-copy {
  flex: 1 1 auto;
  min-width: 0;
}

.component-copy {
  display: flex;
  align-items: center;
}

.section-title {
  color: #17202a;
  font-size: 32rpx;
  font-weight: 900;
  line-height: 1.25;
}

.section-desc {
  margin-top: 8rpx;
  color: #697786;
  font-size: 24rpx;
  line-height: 1.45;
}

.status-pill {
  flex: none;
  min-width: 96rpx;
  height: 48rpx;
  justify-content: center;
  padding: 0 18rpx;
  color: #9a6312;
  font-size: 22rpx;
  font-weight: 800;
  line-height: 1;
  border: 1rpx solid #eac265;
  border-radius: 999rpx;
  background: #fff4d7;
  box-sizing: border-box;
}

.status-pill.published {
  color: #0f5f59;
  border-color: #9fd7d0;
  background: #e6f7f4;
}

.status-pill.muted {
  color: #697786;
  border-color: #d5dee8;
  background: #f1f4f7;
}

.form-row {
  margin-top: 24rpx;
}

.field-heading {
  justify-content: space-between;
}

.field-label {
  color: #5f6b7a;
  font-size: 24rpx;
  font-weight: 800;
  line-height: 1.3;
}

.field-limit {
  flex: none;
  color: #8b96a3;
  font-size: 22rpx;
  font-weight: 700;
  line-height: 1.3;
}

.field-help {
  margin-top: 10rpx;
  color: #8b96a3;
  font-size: 21rpx;
}

.input {
  width: 100%;
  min-height: 84rpx;
  margin-top: 12rpx;
  padding: 0 22rpx;
  color: #17202a;
  font-size: 28rpx;
  line-height: 84rpx;
  border-radius: 16rpx;
  background: #f6f8fb;
  box-sizing: border-box;
}

.cover-row {
  gap: 20rpx;
  margin-top: 12rpx;
  align-items: flex-start;
}

.cover-preview {
  width: 360rpx;
  height: 288rpx;
  flex: 0 0 360rpx;
  justify-content: center;
  overflow: hidden;
  border: 1rpx solid #dbe5ef;
  border-radius: 16rpx;
  background: #f6f8fb;
  box-sizing: border-box;
}

.cover-preview.disabled {
  opacity: 0.65;
}

.cover-preview image {
  width: 100%;
  height: 100%;
}

.cover-empty {
  justify-content: center;
  width: 100%;
  height: 100%;
  color: #8793a0;
  font-size: 24rpx;
  font-weight: 800;
}

.link-button {
  width: 136rpx;
  min-width: 136rpx;
  max-width: 136rpx;
  height: 56rpx;
  flex: 0 0 136rpx;
  justify-content: center;
  margin: 0;
  padding: 0;
  color: #2d5f9a;
  font-size: 24rpx;
  font-weight: 900;
  line-height: 1;
  border: 1rpx solid #cbd7e3;
  border-radius: 999rpx;
  background: #edf5fb;
  box-sizing: border-box;
}

.component-empty {
  margin-top: 24rpx;
  padding: 36rpx 0;
  color: #8a98a8;
  font-size: 24rpx;
  text-align: center;
}

.component-list {
  margin-top: 24rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.component-swipe-row {
  position: relative;
  overflow: hidden;
  border-radius: 14rpx;
}

.component-swipe-row.dragging {
  z-index: 3;
  overflow: visible;
}

.component-row {
  position: relative;
  z-index: 2;
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 116rpx;
  gap: 16rpx;
  padding: 18rpx;
  border: 1rpx solid #e1e8ef;
  border-radius: 14rpx;
  background: #f8fafc;
  box-shadow: 0 6rpx 22rpx rgba(23, 32, 42, 0.04);
  box-sizing: border-box;
  transition: transform 180ms ease, box-shadow 160ms ease, border-color 160ms ease, background 160ms ease;
}

.component-row.editable {
  background: #fcfdfd;
}

.component-swipe-row.revealed .component-row {
  transform: translateX(-140rpx);
}

.component-row.dragging {
  border-color: #b8c9dc;
  background: #eef5fb;
  box-shadow: 0 12rpx 28rpx rgba(23, 32, 42, 0.1);
}

.component-row.drag-target {
  border-color: #c28b37;
}

.component-remove-pane {
  position: absolute;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 1;
  width: 128rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  transform: translateX(100%);
  opacity: 0;
  pointer-events: none;
  transition: transform 180ms ease, opacity 160ms ease;
}

.component-swipe-row.revealed .component-remove-pane {
  transform: translateX(0);
  opacity: 1;
  pointer-events: auto;
}

.component-swipe-row.dragging .component-remove-pane {
  transform: translateX(100%);
  opacity: 0;
  pointer-events: none;
}

.component-remove-button {
  width: 108rpx;
  min-width: 108rpx;
  height: 64rpx;
  min-height: 64rpx;
  justify-content: center;
  margin: 0;
  padding: 0;
  color: #a9354f;
  font-size: 22rpx;
  font-weight: 800;
  line-height: 64rpx;
  border-radius: 14rpx;
  background: #feecef;
  box-sizing: border-box;
}

.component-order {
  width: 48rpx;
  height: 48rpx;
  flex: none;
  align-self: center;
  justify-content: center;
  color: #ffffff;
  font-size: 22rpx;
  font-weight: 900;
  line-height: 48rpx;
  border-radius: 14rpx;
  background: #17202a;
}

.component-drag-handle {
  width: 42rpx;
  height: 48rpx;
  flex: none;
  align-self: center;
  justify-content: center;
  border-radius: 12rpx;
  background: linear-gradient(to bottom, transparent 0, transparent 10rpx, #6f7f90 10rpx, #6f7f90 14rpx, transparent 14rpx, transparent 22rpx, #6f7f90 22rpx, #6f7f90 26rpx, transparent 26rpx, transparent 34rpx, #6f7f90 34rpx, #6f7f90 38rpx, transparent 38rpx, transparent 48rpx);
  background-position: center center;
  background-size: 22rpx 48rpx;
  background-repeat: no-repeat;
}

.component-title {
  overflow: hidden;
  color: #17202a;
  font-size: 28rpx;
  font-weight: 900;
  line-height: 48rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.component-row-arrow {
  width: 28rpx;
  height: 48rpx;
  flex: none;
  align-self: center;
  justify-content: center;
  color: #697786;
  font-size: 0;
  font-weight: 700;
  line-height: 0;
}

.component-row-arrow-icon {
  width: 16rpx;
  height: 16rpx;
  border-right: 5rpx solid #697786;
  border-bottom: 5rpx solid #697786;
  transform: rotate(-45deg);
  box-sizing: border-box;
}

.component-picker-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 30;
  display: flex;
  align-items: flex-end;
  padding: 28rpx;
  opacity: 0;
  pointer-events: none;
  background: rgba(17, 24, 39, 0.35);
  transition: opacity 225ms ease-out;
  box-sizing: border-box;
}

.component-picker-mask.visible {
  opacity: 1;
  pointer-events: auto;
}

.component-picker-panel {
  width: 100%;
  max-height: 72vh;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  padding: 18rpx 24rpx calc(24rpx + env(safe-area-inset-bottom));
  border: 1rpx solid #d7dee5;
  border-radius: 24rpx 24rpx 18rpx 18rpx;
  background: #fcfdfd;
  box-shadow: 0 -20rpx 48rpx rgba(17, 24, 39, 0.18);
  box-sizing: border-box;
  transform: translateY(36rpx);
  transition: transform 225ms cubic-bezier(0.2, 0, 0.1, 1);
}

.component-picker-mask.visible .component-picker-panel {
  transform: translateY(0);
}

.component-picker-grabber {
  width: 72rpx;
  height: 8rpx;
  align-self: center;
  border-radius: 999rpx;
  background: #cbd6df;
}

.component-picker-heading {
  justify-content: space-between;
  gap: 20rpx;
}

.component-picker-title {
  flex: 1;
  min-width: 0;
  color: #111827;
  font-size: 30rpx;
  line-height: 1.25;
  font-weight: 800;
}

.component-picker-count {
  min-height: 48rpx;
  flex: none;
  padding: 0 18rpx;
  color: #536b82;
  font-size: 22rpx;
  font-weight: 800;
  border: 1rpx solid #cbd6df;
  border-radius: 999rpx;
  background: #eef3f7;
  white-space: nowrap;
}

.component-option-scroll {
  height: 46vh;
  min-height: 320rpx;
  max-height: 46vh;
  flex: 1 1 auto;
}

.component-option-list-content {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.component-option {
  width: 100%;
  min-width: 100%;
  max-width: 100%;
  min-height: 106rpx;
  justify-content: space-between;
  margin: 0;
  padding: 18rpx 20rpx;
  border: 1rpx solid #d9e2eb;
  border-radius: 14rpx;
  background: #f8fafc;
  box-sizing: border-box;
}

.component-option.disabled {
  opacity: 0.5;
}

.component-option-copy {
  min-width: 0;
  flex: 1 1 auto;
  text-align: left;
}

.component-option-name {
  color: #17202a;
  font-size: 26rpx;
  font-weight: 900;
  line-height: 1.25;
}

.component-option-desc {
  overflow: hidden;
  margin-top: 8rpx;
  color: #697786;
  font-size: 22rpx;
  line-height: 1.3;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.component-option-plus {
  width: 44rpx;
  height: 44rpx;
  flex: none;
  justify-content: center;
  margin-left: 18rpx;
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 900;
  line-height: 1;
  border-radius: 50%;
  background: #17202a;
}

.component-option-added {
  width: auto;
  min-width: 104rpx;
  height: 44rpx;
  flex: none;
  justify-content: center;
  margin-left: 18rpx;
  padding: 0 18rpx;
  color: #ffffff;
  font-size: 22rpx;
  font-weight: 800;
  line-height: 1;
  border-radius: 999rpx;
  background: #17202a;
  box-sizing: border-box;
  white-space: nowrap;
}

.component-picker-actions {
  justify-content: flex-end;
}

.component-picker-cancel {
  width: 148rpx;
  height: 60rpx;
  justify-content: center;
  margin: 0;
  padding: 0;
  color: #536b82;
  font-size: 24rpx;
  font-weight: 800;
  line-height: 1;
  border: 1rpx solid #cbd6df;
  border-radius: 999rpx;
  background: #eef3f7;
  box-sizing: border-box;
}

.component-editor-mask,
.share-cover-crop-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 35;
  display: flex;
  align-items: flex-end;
  padding: 28rpx;
  opacity: 0;
  pointer-events: none;
  background: rgba(17, 24, 39, 0.35);
  transition: opacity 225ms ease-out;
  box-sizing: border-box;
}

.component-editor-mask.visible,
.share-cover-crop-mask.visible {
  opacity: 1;
  pointer-events: auto;
}

.component-editor-panel,
.share-cover-crop-panel {
  width: 100%;
  max-height: 76vh;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  padding: 18rpx 24rpx calc(24rpx + env(safe-area-inset-bottom));
  border: 1rpx solid #d7dee5;
  border-radius: 24rpx 24rpx 18rpx 18rpx;
  background: #fcfdfd;
  box-shadow: 0 -20rpx 48rpx rgba(17, 24, 39, 0.18);
  box-sizing: border-box;
  transform: translateY(36rpx);
  transition: transform 225ms cubic-bezier(0.2, 0, 0.1, 1);
}

.component-editor-mask.visible .component-editor-panel,
.share-cover-crop-mask.visible .share-cover-crop-panel {
  transform: translateY(0);
}

.share-cover-crop-panel {
  max-height: calc(100vh - 56rpx - env(safe-area-inset-bottom));
  overflow-y: auto;
}

.editor-heading {
  flex: none;
}

.editor-close {
  flex: none;
  margin: 0;
  padding: 0 10rpx;
  color: #536b82;
  background: transparent;
  font-size: 24rpx;
  font-weight: 800;
}

.component-editor-scroll {
  height: 58vh;
  min-height: 320rpx;
  max-height: 58vh;
  flex: 1 1 auto;
}

.component-editor-content {
  padding: 2rpx 0 12rpx;
}

.editor-notice,
.source-state {
  padding: 16rpx;
  color: #685019;
  font-size: 23rpx;
  border-radius: 12rpx;
  background: #fff3cf;
}

.source-error {
  color: #a53636;
  background: #ffebec;
}

.source-error button {
  margin-top: 10rpx;
}

.share-cover-crop-stage {
  position: relative;
  width: 100%;
  aspect-ratio: 5 / 4;
  overflow: hidden;
  border-radius: 16rpx;
  background: #17202a;
}

.share-cover-crop-image {
  display: block;
  width: 100%;
  height: 100%;
}

.share-cover-crop-frame {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  border: 3rpx solid rgba(255, 255, 255, 0.9);
  box-sizing: border-box;
}

.sheet-actions {
  display: flex;
  flex: none;
  gap: 16rpx;
}

.sheet-actions button {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 1 1 0;
  height: 72rpx;
  margin: 0;
  padding: 0;
  line-height: 1;
  border-radius: 14rpx;
  box-sizing: border-box;
}

.sheet-cancel {
  color: #536b82;
  background: #eef3f7;
}

.sheet-confirm {
  color: #ffffff;
  background: #17202a;
}

.page-state {
  padding: 120rpx 40rpx;
  color: #697786;
  text-align: center;
}

.state-retry {
  width: 180rpx;
  margin-top: 24rpx;
}

.error-state {
  color: #a9354f;
}

.bottom-actions {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 10;
  display: flex;
  gap: 12rpx;
  padding: 18rpx 28rpx calc(18rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid rgba(23, 32, 42, 0.08);
  background: rgba(255, 255, 255, 0.96);
  box-shadow: 0 -12rpx 36rpx rgba(23, 32, 42, 0.08);
  box-sizing: border-box;
}

.action-button {
  flex: 1 1 0;
  min-width: 0;
  height: 88rpx;
  justify-content: center;
  margin: 0;
  padding: 0 12rpx;
  font-size: 28rpx;
  font-weight: 900;
  line-height: 1;
  border-radius: 16rpx;
  box-sizing: border-box;
}

.preview-action-stack {
  flex: 1 1 0;
  min-width: 0;
}

.preview-action-stack .action-button {
  width: 100%;
}

.preview-draft-button {
  flex-direction: column;
  gap: 6rpx;
}

.preview-action-title {
  color: #17202a;
  font-size: 28rpx;
  font-weight: 900;
  line-height: 1;
}

.preview-action-note {
  color: #697786;
  font-size: 20rpx;
  font-weight: 700;
  line-height: 1;
  text-align: center;
}

.primary-button {
  color: #ffffff;
  background: #17202a;
  box-shadow: 0 18rpx 44rpx rgba(23, 32, 42, 0.16);
}

.secondary-button {
  color: #17202a;
  background: #eef2f6;
}

.publish-button {
  color: #ffffff;
  background: #0f766e;
  box-shadow: 0 18rpx 44rpx rgba(15, 118, 110, 0.16);
}

.link-button::after,
.action-button::after,
.component-remove-button::after,
.component-picker-cancel::after,
.editor-close::after,
.sheet-cancel::after,
.sheet-confirm::after {
  border: 0;
}
