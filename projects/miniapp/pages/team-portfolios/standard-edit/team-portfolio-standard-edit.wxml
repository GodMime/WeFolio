<wxs module="componentRows" src="./component-rows.wxs"></wxs>

<view class="page-shell portfolio-edit-page team-portfolio-edit-page">
  <navigation-bar title="标准团队作品集" color="#17202a" background="rgba(245, 247, 251, 0.94)" back="{{true}}"></navigation-bar>

  <view wx:if="{{loading}}" class="page-state">加载中...</view>
  <view wx:elif="{{errorMessage}}" class="page-state error-state">
    <view>{{errorMessage}}</view>
    <button class="state-retry" bindtap="handleRetry">重试</button>
  </view>

  <scroll-view wx:else class="edit-scroll" scroll-y type="list">
    <view class="edit-content">
      <view class="panel share-panel">
        <view class="panel-heading">
          <view class="heading-copy">
            <view class="section-title">分享信息</view>
            <view class="section-desc">用于微信分享卡片说明</view>
          </view>
          <view class="status-pill {{statusTone}}">{{statusText}}</view>
        </view>

        <view class="form-row cover-form-row">
          <view class="field-heading">
            <view class="field-label">分享封面</view>
          </view>
          <view class="cover-row">
            <view class="cover-preview {{!canMaintain || shareCoverUploading ? 'disabled' : ''}}" bindtap="handleCoverChoose" aria-role="button" aria-label="选择分享封面">
              <image wx:if="{{config.share.coverUrl}}" src="{{config.share.coverUrl}}" mode="aspectFill"></image>
              <view wx:else class="cover-empty">封面</view>
            </view>
          </view>
        </view>

        <view class="form-row">
          <view class="field-heading">
            <view class="field-label">作品集标题</view>
            <view class="field-limit">{{shareTitleCounter}}</view>
          </view>
          <input class="input" placeholder="未命名团队作品集" value="{{config.share.title}}" data-field="title" bindinput="handleShareInput" maxlength="50" disabled="{{!canMaintain}}" />
        </view>
      </view>

      <view class="panel component-panel">
        <view class="panel-heading">
          <view class="heading-copy">
            <view class="section-title">组件编排</view>
            <view class="section-desc">访客将按当前顺序浏览作品集内容</view>
          </view>
          <button class="link-button" bindtap="handleOpenComponentSheet" disabled="{{!canMaintain}}">添加组件</button>
        </view>

        <view wx:if="{{!componentList.length}}" class="component-empty">暂未添加组件</view>
        <view wx:else class="component-list">
          <view
            wx:for="{{componentList}}"
            wx:key="componentKey"
            class="component-swipe-row {{revealedComponentKey === item.componentKey ? 'revealed' : ''}} {{draggingIndex === index ? 'dragging' : ''}}"
            data-index="{{index}}"
            data-key="{{item.componentKey}}"
            data-type="{{item.componentType}}"
            bindtouchstart="handleComponentTouchStart"
            bindlongpress="handleComponentDragStart"
            bindtouchmove="handleComponentTouchMove"
            bindtouchend="handleComponentTouchEnd"
            bindtouchcancel="handleComponentTouchCancel"
          >
            <view class="component-remove-pane" catchtap="noop">
              <button class="component-remove-button" data-key="{{item.componentKey}}" catchtap="handleRemoveComponent">删除</button>
            </view>
            <view
              class="component-row editable {{draggingIndex === index ? 'dragging' : ''}} {{dragTargetIndex === index && draggingIndex !== -1 ? 'drag-target' : ''}}"
              style="{{draggingIndex === index ? componentDragStyle : ''}}"
              data-key="{{item.componentKey}}"
              data-type="{{item.componentType}}"
              catchtap="handleComponentTap"
              aria-role="button"
              aria-label="编辑{{item.displayName}}"
            >
              <view class="component-order">{{index + 1}}</view>
              <view class="component-copy">
                <view class="component-title">{{item.displayName}}</view>
              </view>
              <view class="component-drag-handle"></view>
              <view class="component-row-arrow"><view class="component-row-arrow-icon"></view></view>
            </view>
          </view>
        </view>
      </view>
    </view>
  </scroll-view>

  <view class="component-picker-mask {{componentSheetVisible ? 'visible' : ''}}" catchtap="handleCloseComponentSheet">
    <view class="component-picker-panel" catchtap="noop">
      <view class="component-picker-grabber"></view>
      <view class="component-picker-heading">
        <view class="component-picker-title">选择组件</view>
        <view class="component-picker-count">{{componentOptions.length}} 个可选</view>
      </view>
      <scroll-view class="component-option-scroll" scroll-y type="list">
        <view class="component-option-list-content">
          <view
            wx:for="{{componentOptions}}"
            wx:key="componentType"
            class="component-option {{item.disabled ? 'disabled' : ''}}"
            data-type="{{item.componentType}}"
            data-disabled="{{item.disabled}}"
            catchtap="handleSelectComponent"
            aria-role="button"
            aria-label="添加{{item.name}}组件"
          >
            <view class="component-option-copy">
              <view class="component-option-name">{{item.name}}</view>
              <view class="component-option-desc">{{item.description}}</view>
            </view>
            <view class="{{item.disabled ? 'component-option-added' : 'component-option-plus'}}">{{item.disabled ? '已添加' : '+'}}</view>
          </view>
        </view>
      </scroll-view>
      <view class="component-picker-actions"><button class="component-picker-cancel" catchtap="handleCloseComponentSheet">取消</button></view>
    </view>
  </view>

  <view class="text-section-sheet-mask component-picker-mask {{textSectionSheetVisible ? 'visible' : ''}}" catchtap="handleCloseTextSectionSheet">
    <view class="text-section-sheet-panel component-picker-panel" catchtap="noop">
      <view class="component-picker-grabber"></view>
      <view class="component-picker-heading">
        <view class="component-picker-title">编辑文字说明</view>
        <view class="component-picker-count">{{textSectionFieldCounters.content}}</view>
      </view>

      <view class="text-section-form">
        <view class="form-row">
          <view class="field-heading">
            <view class="field-label">说明</view>
            <view class="field-limit">{{textSectionFieldCounters.content}}</view>
          </view>
          <textarea class="input textarea text-section-sheet-textarea" value="{{textSectionForm.content}}" placeholder="请输入给访客看的说明文字" maxlength="{{textSectionMaxLength}}" bindinput="handleTextSectionInput"></textarea>
        </view>

        <view class="form-row">
          <view class="field-heading"><view class="field-label">对齐方式</view></view>
          <view class="text-section-alignment-list">
            <view wx:for="{{textSectionAlignmentOptions}}" wx:key="value" class="text-section-alignment-option {{textSectionForm.alignment === item.value ? 'active' : ''}}" data-value="{{item.value}}" catchtap="handleTextSectionAlignmentTap" aria-role="radio" aria-checked="{{textSectionForm.alignment === item.value}}">
              <view class="text-section-alignment-radio"></view>
              <view class="text-section-alignment-label">{{item.label}}</view>
            </view>
          </view>
        </view>
      </view>

      <view class="text-section-actions">
        <button class="text-section-cancel" catchtap="handleCloseTextSectionSheet">取消</button>
        <button class="text-section-confirm" catchtap="handleConfirmTextSectionConfig">完成</button>
      </view>
    </view>
  </view>

  <view class="contact-form-sheet-mask component-picker-mask {{contactFormSheetVisible ? 'visible' : ''}}" catchtap="handleCloseContactFormSheet">
    <view class="contact-form-sheet-panel component-picker-panel" catchtap="noop">
      <view class="component-picker-grabber"></view>
      <view class="component-picker-heading">
        <view class="component-picker-title">编辑预留联系信息</view>
        <view class="component-picker-count">{{contactFormConfigForm.displayMode === 'INLINE_FORM' ? '直接' : '弹层'}}</view>
      </view>
      <view class="contact-form-sheet-form">
        <view class="form-row">
          <view class="field-heading"><view class="field-label">展示方式</view></view>
          <view class="contact-form-display-mode-list">
            <view wx:for="{{contactFormDisplayModeOptions}}" wx:key="value" class="contact-form-display-mode-option {{contactFormConfigForm.displayMode === item.value ? 'active' : ''}}" data-value="{{item.value}}" catchtap="handleContactFormDisplayModeTap" aria-role="radio" aria-checked="{{contactFormConfigForm.displayMode === item.value}}">
              <view class="contact-form-display-mode-radio"></view>
              <view class="contact-form-display-mode-label">{{item.label}}</view>
            </view>
          </view>
        </view>
      </view>
      <view class="contact-form-sheet-actions">
        <button class="contact-form-sheet-cancel" catchtap="handleCloseContactFormSheet">取消</button>
        <button class="contact-form-sheet-confirm" catchtap="handleConfirmContactFormConfig">完成</button>
      </view>
    </view>
  </view>

  <view class="schedule-query-sheet-mask component-picker-mask {{scheduleQuerySheetVisible ? 'visible' : ''}}" catchtap="handleCloseScheduleQuerySheet">
    <view class="schedule-query-sheet-panel component-picker-panel" catchtap="noop">
      <view class="component-picker-grabber"></view>
      <view class="component-picker-heading"><view class="component-picker-title">编辑档期查询</view><view class="component-picker-count">{{scheduleQueryForm.displayMode === 'INLINE_CALENDAR' ? '内联' : '弹层'}}</view></view>
      <view class="schedule-query-sheet-form"><view class="form-row"><view class="field-heading"><view class="field-label">展示方式</view></view><view class="schedule-query-display-mode-list"><view wx:for="{{scheduleQueryDisplayModeOptions}}" wx:key="value" class="schedule-query-display-mode-option {{scheduleQueryForm.displayMode === item.value ? 'active' : ''}}" data-value="{{item.value}}" catchtap="handleScheduleQueryDisplayModeTap" aria-role="radio" aria-checked="{{scheduleQueryForm.displayMode === item.value}}"><view class="schedule-query-display-mode-radio"></view><view class="schedule-query-display-mode-label">{{item.label}}</view></view></view></view></view>
      <view class="schedule-query-sheet-actions"><button class="schedule-query-sheet-cancel" catchtap="handleCloseScheduleQuerySheet">取消</button><button class="schedule-query-sheet-confirm" catchtap="handleConfirmScheduleQueryConfig">完成</button></view>
    </view>
  </view>

  <view class="divider-sheet-mask component-picker-mask {{dividerSheetVisible ? 'visible' : ''}}" catchtap="handleCloseDividerSheet">
    <view class="divider-sheet-panel component-picker-panel" catchtap="noop">
      <view class="component-picker-grabber"></view>
      <view class="component-picker-heading"><view class="component-picker-title">编辑分割线</view><view class="component-picker-count">{{dividerForm.heightPx}}px</view></view>
      <view class="divider-sheet-form"><view class="form-row"><view class="field-heading"><view class="field-label">颜色</view></view><view class="divider-color-list"><view wx:for="{{dividerColorOptions}}" wx:key="value" class="divider-color-option {{dividerForm.color === item.value ? 'active' : ''}}" data-value="{{item.value}}" catchtap="handleDividerColorTap" aria-role="radio" aria-checked="{{dividerForm.color === item.value}}"><view class="divider-color-swatch" style="background-color: {{item.colorValue}};"></view><view class="divider-color-label">{{item.label}}</view></view></view></view><view class="form-row"><view class="field-heading"><view class="field-label">高度(px)</view></view><input class="input divider-height-input" type="number" value="{{dividerForm.heightPx}}" placeholder="16" bindinput="handleDividerHeightInput" /></view></view>
      <view class="divider-sheet-actions"><button class="divider-sheet-cancel" catchtap="handleCloseDividerSheet">取消</button><button class="divider-sheet-confirm" catchtap="handleConfirmDividerConfig">完成</button></view>
    </view>
  </view>

  <view class="component-editor-mask {{componentEditorVisible ? 'visible' : ''}}" catchtap="handleCloseComponentEditor">
    <view class="component-editor-panel" catchtap="noop">
      <view class="component-picker-grabber"></view>
      <view class="component-picker-heading">
        <view class="component-picker-title">编辑{{activeComponentName}}</view>
      </view>
      <view wx:if="{{!portfolioId && activeComponentNeedsPortfolio}}" class="editor-notice">请先保存草稿，再选择团队成员内容</view>
      <view wx:if="{{activeComponentSource.loadingFingerprint}}" class="source-state">正在加载团队内容...</view>
      <view wx:if="{{activeComponentSource.errorMessage}}" class="source-state source-error">
        <view>{{activeComponentSource.errorMessage}}</view>
        <button wx:if="{{activeComponentType === 'CAROUSEL'}}" data-key="{{activeComponentKey}}" bindtap="handleCarouselRetrySource">重试</button>
        <button wx:if="{{activeComponentType === 'SINGLE_WORK'}}" data-key="{{activeComponentKey}}" bindtap="handleSingleWorkRetrySource">重试</button>
        <button wx:if="{{activeComponentType === 'MEMBER_PORTFOLIO_GRID'}}" data-key="{{activeComponentKey}}" bindtap="handleGridRetrySource">重试</button>
        <button wx:if="{{activeComponentType === 'MEMBER_PORTFOLIO_LIST'}}" data-key="{{activeComponentKey}}" bindtap="handleListRetrySource">重试</button>
      </view>
      <scroll-view class="component-editor-scroll" scroll-y type="list">
        <view class="component-editor-content">
          <team-profile wx:if="{{activeComponentType === 'TEAM_PROFILE'}}" id="active-component-editor" data-key="{{activeComponentKey}}" team="{{activeComponent.config.team}}" visible-fields="{{activeComponent.config.visibleFields}}" edit-mode="{{true}}" refreshing="{{teamProfileRefreshing}}" bindchooseavatar="handleTeamProfileChooseAvatar" bindrefresh="handleTeamProfileRefresh" bindsave="handleComponentSave" />
          <team-carousel wx:if="{{activeComponentType === 'CAROUSEL'}}" id="active-component-editor" data-key="{{activeComponentKey}}" portfolio-id="{{portfolioId}}" items="{{activeComponent.config.items}}" members="{{activeComponentSource.members}}" works="{{activeComponentSource.works}}" edit-mode="{{true}}" bindloadmembers="handleCarouselLoadMembers" bindmemberchange="handleCarouselMemberChange" bindsave="handleComponentSave" />
          <team-single-work wx:if="{{activeComponentType === 'SINGLE_WORK'}}" id="active-component-editor" data-key="{{activeComponentKey}}" component-key="{{activeComponentKey}}" portfolio-id="{{portfolioId}}" config="{{activeComponent.config}}" members="{{activeComponentSource.members}}" works="{{activeComponentSource.works}}" edit-mode="{{true}}" bindloadmembers="handleSingleWorkLoadMembers" bindmemberchange="handleSingleWorkMemberChange" bindsave="handleComponentSave" />
          <team-member-portfolio-grid wx:if="{{activeComponentType === 'MEMBER_PORTFOLIO_GRID'}}" id="active-component-editor" data-key="{{activeComponentKey}}" portfolio-id="{{portfolioId}}" items="{{activeComponent.config.items}}" show-member-name="{{activeComponent.config.showMemberName}}" members="{{activeComponentSource.members}}" portfolios="{{activeComponentSource.portfolios}}" edit-mode="{{true}}" bindloadmembers="handleGridLoadMembers" bindmemberchange="handleGridMemberChange" bindsave="handleComponentSave" />
          <team-member-portfolio-list wx:if="{{activeComponentType === 'MEMBER_PORTFOLIO_LIST'}}" id="active-component-editor" data-key="{{activeComponentKey}}" portfolio-id="{{portfolioId}}" items="{{activeComponent.config.items}}" show-member-name="{{activeComponent.config.showMemberName}}" members="{{activeComponentSource.members}}" portfolios="{{activeComponentSource.portfolios}}" edit-mode="{{true}}" bindloadmembers="handleListLoadMembers" bindmemberchange="handleListMemberChange" bindsave="handleComponentSave" />
          <team-qr-contact wx:if="{{activeComponentType === 'QR_CONTACT'}}" id="active-component-editor" data-key="{{activeComponentKey}}" config="{{activeComponent.config}}" edit-mode="{{true}}" choosing="{{qrContactChoosing}}" bindchoose="handleQrChoose" bindsave="handleComponentSave" />
        </view>
      </scroll-view>
      <view class="component-editor-actions">
        <button class="component-editor-cancel" catchtap="handleCloseComponentEditor">取消</button>
        <button class="component-editor-confirm" catchtap="handleConfirmComponentEditor">完成</button>
      </view>
    </view>
  </view>

  <view class="share-cover-crop-mask {{shareCoverCropVisible ? 'visible' : ''}}" catchtap="handleCloseShareCoverCrop">
    <view class="share-cover-crop-panel" catchtap="noop">
      <view class="component-picker-grabber"></view>
      <view class="component-picker-heading">
        <view class="component-picker-title">裁剪分享封面</view>
        <view class="component-picker-count">5:4</view>
      </view>
      <view class="share-cover-crop-stage">
        <image wx:if="{{shareCoverCropPath}}" class="share-cover-crop-image" src="{{shareCoverCropPath}}" mode="aspectFill"></image>
        <view class="share-cover-crop-frame"></view>
      </view>
      <view class="sheet-actions split">
        <button class="sheet-cancel" catchtap="handleCloseShareCoverCrop">取消</button>
        <button class="sheet-confirm" catchtap="handleConfirmShareCoverCrop" loading="{{shareCoverUploading}}" disabled="{{shareCoverUploading}}">完成</button>
      </view>
    </view>
  </view>

  <view class="qr-contact-crop-mask {{qrContactCropVisible ? 'visible' : ''}}">
    <view class="qr-contact-crop-backdrop" bindtap="handleCloseQrContactCrop"></view>
    <view class="qr-contact-crop-panel" catchtap="noop">
      <view class="component-picker-grabber"></view>
      <view class="component-picker-heading">
        <view class="component-picker-title">裁剪二维码</view>
        <view class="component-picker-count">1:1</view>
      </view>
      <view
        wx:if="{{qrContactCropState}}"
        class="qr-contact-crop-stage"
        style="{{qrContactCropState.cropBoxStyle}}"
        catchtouchstart="handleQrContactCropTouchStart"
        catchtouchmove="handleQrContactCropTouchMove"
        catchtouchend="handleQrContactCropTouchEnd"
        catchtouchcancel="handleQrContactCropTouchCancel"
      >
        <image class="qr-contact-crop-image" src="{{qrContactCropState.imagePath}}" mode="scaleToFill" style="{{qrContactCropState.imageStyle}}"></image>
        <view class="qr-contact-crop-frame"></view>
      </view>
      <view wx:if="{{qrContactCropErrorText}}" class="qr-contact-crop-error">{{qrContactCropErrorText}}</view>
      <view class="sheet-actions split">
        <button class="sheet-cancel" catchtap="handleCloseQrContactCrop" disabled="{{qrContactCropSaving}}">取消</button>
        <button class="sheet-confirm" catchtap="handleConfirmQrContactCrop" loading="{{qrContactCropSaving}}" disabled="{{qrContactCropSaving}}">完成</button>
      </view>
    </view>
  </view>

  <canvas
    id="teamQrContactCropCanvas"
    type="2d"
    class="qr-contact-crop-canvas"
    style="width: {{qrContactCropCanvasWidth}}px; height: {{qrContactCropCanvasHeight}}px;"
  ></canvas>

  <view class="bottom-actions">
    <button class="action-button primary-button" bindtap="handleSaveTap" loading="{{saving}}" disabled="{{!canMaintain || saving || publishing || hasInvalidComponents}}">保存草稿</button>
    <view class="preview-action-stack">
      <button class="action-button secondary-button preview-draft-button" bindtap="handlePreviewTap" disabled="{{!canMaintain || !portfolioId || saving || publishing}}">
        <view class="preview-action-title">预览草稿</view>
        <view class="preview-action-note">请保存后预览</view>
      </button>
    </view>
    <button wx:if="{{showPublishAction}}" class="action-button publish-button" bindtap="handlePublishTap" loading="{{publishing}}" disabled="{{!canMaintain || saving || publishing || hasInvalidComponents}}">发布</button>
  </view>
</view>
