<navigation-bar title="编辑团队作品集" back="{{true}}" />
<view class="page-shell">
  <view wx:if="{{loading}}" class="state">加载中...</view>
  <view wx:elif="{{errorMessage}}" class="state"><text>{{errorMessage}}</text><button bindtap="handleRetry">重试</button></view>
  <block wx:else>
    <view class="panel">
      <input data-field="title" value="{{config.share.title}}" bindinput="handleShareInput" placeholder="分享标题" disabled="{{!canMaintain}}" />
      <textarea data-field="description" value="{{config.share.description}}" bindinput="handleShareInput" placeholder="分享说明" disabled="{{!canMaintain}}" />
      <image wx:if="{{config.share.coverUrl}}" src="{{config.share.coverUrl}}" mode="aspectFill" class="cover" />
      <button class="primary" bindtap="handleCoverChoose" loading="{{shareCoverUploading}}" disabled="{{!canMaintain || !portfolioId || shareCoverUploading}}">选择分享封面</button>
    </view>
    <view class="panel">
      <view class="component-header"><view class="panel-title">页面组件</view><button class="primary" bindtap="handleOpenLibrary" loading="{{openingLibrary}}" disabled="{{!canMaintain || openingLibrary}}">添加组件</button></view>
      <view class="component-stack">
        <view wx:for="{{componentBuckets.teamProfile}}" wx:key="componentKey" class="component-wrapper" style="order:{{item.sortOrder}}"><view class="component-heading">团队资料</view><team-profile data-key="{{item.componentKey}}" team="{{item.config.team}}" edit-mode="{{canMaintain}}" bindmaintainteam="handleMaintainTeam" bindsave="handleComponentSave" /><view class="arrange"><button data-key="{{item.componentKey}}" data-direction="-1" bindtap="handleMove" disabled="{{!canMaintain}}">上移</button><button data-key="{{item.componentKey}}" data-direction="1" bindtap="handleMove" disabled="{{!canMaintain}}">下移</button><button data-key="{{item.componentKey}}" bindtap="handleComponentDelete" disabled="{{!canMaintain}}">删除</button></view></view>
        <view wx:for="{{componentBuckets.carousel}}" wx:key="componentKey" class="component-wrapper" style="order:{{item.sortOrder}}"><view class="component-heading">轮播图</view><view wx:if="{{componentSources[item.componentKey].loadingFingerprint}}" class="source-state">正在加载成员来源...</view><view wx:if="{{componentSources[item.componentKey].errorMessage}}" class="source-state source-error"><text>{{componentSources[item.componentKey].errorMessage}}</text><button data-key="{{item.componentKey}}" bindtap="handleCarouselRetrySource">重试成员来源</button></view><team-carousel data-key="{{item.componentKey}}" portfolio-id="{{portfolioId}}" items="{{item.config.items}}" members="{{componentSources[item.componentKey].members}}" works="{{componentSources[item.componentKey].works}}" edit-mode="{{canMaintain}}" bindloadmembers="handleCarouselLoadMembers" bindmemberchange="handleCarouselMemberChange" bindsave="handleComponentSave" /><view class="arrange"><button data-key="{{item.componentKey}}" data-direction="-1" bindtap="handleMove" disabled="{{!canMaintain}}">上移</button><button data-key="{{item.componentKey}}" data-direction="1" bindtap="handleMove" disabled="{{!canMaintain}}">下移</button><button data-key="{{item.componentKey}}" bindtap="handleComponentDelete" disabled="{{!canMaintain}}">删除</button></view></view>
        <view wx:for="{{componentBuckets.divider}}" wx:key="componentKey" class="component-wrapper" style="order:{{item.sortOrder}}"><view class="component-heading">分割线</view><team-divider data-key="{{item.componentKey}}" config="{{item.config}}" edit-mode="{{canMaintain}}" bindsave="handleComponentSave" /><view class="arrange"><button data-key="{{item.componentKey}}" data-direction="-1" bindtap="handleMove" disabled="{{!canMaintain}}">上移</button><button data-key="{{item.componentKey}}" data-direction="1" bindtap="handleMove" disabled="{{!canMaintain}}">下移</button><button data-key="{{item.componentKey}}" bindtap="handleComponentDelete" disabled="{{!canMaintain}}">删除</button></view></view>
        <view wx:for="{{componentBuckets.grid}}" wx:key="componentKey" class="component-wrapper" style="order:{{item.sortOrder}}"><view class="component-heading">双列作品集</view><view wx:if="{{componentSources[item.componentKey].loadingFingerprint}}" class="source-state">正在加载成员来源...</view><view wx:if="{{componentSources[item.componentKey].errorMessage}}" class="source-state source-error"><text>{{componentSources[item.componentKey].errorMessage}}</text><button data-key="{{item.componentKey}}" bindtap="handleGridRetrySource">重试成员来源</button></view><team-member-portfolio-grid data-key="{{item.componentKey}}" portfolio-id="{{portfolioId}}" items="{{item.config.items}}" members="{{componentSources[item.componentKey].members}}" portfolios="{{componentSources[item.componentKey].portfolios}}" edit-mode="{{canMaintain}}" bindloadmembers="handleGridLoadMembers" bindmemberchange="handleGridMemberChange" bindsave="handleComponentSave" /><view class="arrange"><button data-key="{{item.componentKey}}" data-direction="-1" bindtap="handleMove" disabled="{{!canMaintain}}">上移</button><button data-key="{{item.componentKey}}" data-direction="1" bindtap="handleMove" disabled="{{!canMaintain}}">下移</button><button data-key="{{item.componentKey}}" bindtap="handleComponentDelete" disabled="{{!canMaintain}}">删除</button></view></view>
        <view wx:for="{{componentBuckets.list}}" wx:key="componentKey" class="component-wrapper" style="order:{{item.sortOrder}}"><view class="component-heading">单列作品集</view><view wx:if="{{componentSources[item.componentKey].loadingFingerprint}}" class="source-state">正在加载成员来源...</view><view wx:if="{{componentSources[item.componentKey].errorMessage}}" class="source-state source-error"><text>{{componentSources[item.componentKey].errorMessage}}</text><button data-key="{{item.componentKey}}" bindtap="handleListRetrySource">重试成员来源</button></view><team-member-portfolio-list data-key="{{item.componentKey}}" portfolio-id="{{portfolioId}}" items="{{item.config.items}}" members="{{componentSources[item.componentKey].members}}" portfolios="{{componentSources[item.componentKey].portfolios}}" edit-mode="{{canMaintain}}" bindloadmembers="handleListLoadMembers" bindmemberchange="handleListMemberChange" bindsave="handleComponentSave" /><view class="arrange"><button data-key="{{item.componentKey}}" data-direction="-1" bindtap="handleMove" disabled="{{!canMaintain}}">上移</button><button data-key="{{item.componentKey}}" data-direction="1" bindtap="handleMove" disabled="{{!canMaintain}}">下移</button><button data-key="{{item.componentKey}}" bindtap="handleComponentDelete" disabled="{{!canMaintain}}">删除</button></view></view>
        <view wx:for="{{componentBuckets.text}}" wx:key="componentKey" class="component-wrapper" style="order:{{item.sortOrder}}"><view class="component-heading">文字说明</view><team-text-section data-key="{{item.componentKey}}" config="{{item.config}}" edit-mode="{{canMaintain}}" bindsave="handleComponentSave" /><view class="arrange"><button data-key="{{item.componentKey}}" data-direction="-1" bindtap="handleMove" disabled="{{!canMaintain}}">上移</button><button data-key="{{item.componentKey}}" data-direction="1" bindtap="handleMove" disabled="{{!canMaintain}}">下移</button><button data-key="{{item.componentKey}}" bindtap="handleComponentDelete" disabled="{{!canMaintain}}">删除</button></view></view>
        <view wx:for="{{componentBuckets.schedule}}" wx:key="componentKey" class="component-wrapper" style="order:{{item.sortOrder}}"><view class="component-heading">档期查询</view><team-schedule-query data-key="{{item.componentKey}}" component-key="{{item.componentKey}}" config="{{item.config}}" edit-mode="{{canMaintain}}" bindsave="handleComponentSave" /><view class="arrange"><button data-key="{{item.componentKey}}" data-direction="-1" bindtap="handleMove" disabled="{{!canMaintain}}">上移</button><button data-key="{{item.componentKey}}" data-direction="1" bindtap="handleMove" disabled="{{!canMaintain}}">下移</button><button data-key="{{item.componentKey}}" bindtap="handleComponentDelete" disabled="{{!canMaintain}}">删除</button></view></view>
        <view wx:for="{{componentBuckets.contact}}" wx:key="componentKey" class="component-wrapper" style="order:{{item.sortOrder}}"><view class="component-heading">预留联系信息</view><team-contact-form data-key="{{item.componentKey}}" config="{{item.config}}" edit-mode="{{canMaintain}}" bindsave="handleComponentSave" /><view class="arrange"><button data-key="{{item.componentKey}}" data-direction="-1" bindtap="handleMove" disabled="{{!canMaintain}}">上移</button><button data-key="{{item.componentKey}}" data-direction="1" bindtap="handleMove" disabled="{{!canMaintain}}">下移</button><button data-key="{{item.componentKey}}" bindtap="handleComponentDelete" disabled="{{!canMaintain}}">删除</button></view></view>
        <view wx:for="{{componentBuckets.qr}}" wx:key="componentKey" class="component-wrapper" style="order:{{item.sortOrder}}"><view class="component-heading">二维码联系</view><team-qr-contact id="{{item.componentKey}}" data-key="{{item.componentKey}}" config="{{item.config}}" edit-mode="{{canMaintain}}" uploading="{{shareCoverUploading}}" bindchoose="handleQrChoose" bindsave="handleComponentSave" /><view class="arrange"><button data-key="{{item.componentKey}}" data-direction="-1" bindtap="handleMove" disabled="{{!canMaintain}}">上移</button><button data-key="{{item.componentKey}}" data-direction="1" bindtap="handleMove" disabled="{{!canMaintain}}">下移</button><button data-key="{{item.componentKey}}" bindtap="handleComponentDelete" disabled="{{!canMaintain}}">删除</button></view></view>
      </view>
    </view>
    <view class="bottom-actions"><button bindtap="handleSaveTap" loading="{{saving}}" disabled="{{!canMaintain || saving || publishing || hasInvalidComponents}}">保存草稿</button><button bindtap="handlePreviewTap" disabled="{{!canMaintain || !portfolioId || saving || publishing}}">预览草稿</button><button class="primary" bindtap="handlePublishTap" loading="{{publishing}}" disabled="{{!canMaintain || saving || publishing || hasInvalidComponents}}">发布</button></view>
  </block>
</view>
