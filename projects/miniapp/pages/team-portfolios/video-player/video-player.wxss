page { height:100%; background:#000; color:#fff; }
.portfolio-video-page { min-height:100%; display:flex; flex-direction:column; justify-content:center; background:#000; }
.portfolio-video { display:block; width:100%; height:56.25vw; flex-shrink:0; background:#000; }
.portfolio-video-title { padding:32rpx; font-size:30rpx; line-height:1.5; word-break:break-all; }
.portfolio-video-button { min-height:88rpx; margin:0; padding:0 24rpx; border:1rpx solid #555; border-radius:16rpx; background:#222; color:#fff; font-size:28rpx; line-height:86rpx; }
.portfolio-video-button::after { border:0; }
.portfolio-video-message { display:flex; flex-direction:column; align-items:center; justify-content:center; gap:32rpx; padding:48rpx 32rpx; color:#ccc; font-size:28rpx; }
