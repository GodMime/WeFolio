<navigation-bar title="团队线索" back="{{true}}" />
<view class="page-shell"><view wx:if="{{loading}}" class="state">加载中...</view><view wx:elif="{{errorMessage}}" class="state"><text>{{errorMessage}}</text><button bindtap="handleRetry">重试</button></view><view wx:elif="{{!items.length}}" class="state">暂无联系线索</view><scroll-view wx:else scroll-y class="list" bindscrolltolower="handleReachBottom"><view wx:for="{{items}}" wx:key="leadId" class="lead"><text class="name">{{item.contactName}}</text><text>手机：{{item.phone}}</text><text>微信：{{item.wechat}}</text><text>意向档期：{{item.desiredSchedule}}</text><text>需求：{{item.needs}}</text><text>团队来源：{{item.teamName || teamName}}</text><text>作品集来源：{{item.portfolioTitle}} {{item.sourceText}}</text><text>跟进：{{item.followStatusText || item.followStatus}} {{item.followNote}}</text><view class="actions"><button data-phone="{{item.phone}}" bindtap="handleCall">拨号</button><button data-wechat="{{item.wechat}}" bindtap="handleCopyWechat">复制微信</button><button wx:if="{{canUpdateFollow}}" data-item="{{item}}" bindtap="handleEditFollow">更新跟进</button></view></view><view wx:if="{{loadingMore}}" class="state">加载更多...</view></scroll-view><view wx:if="{{followEditor}}" class="editor"><view wx:for="{{followStatuses}}" wx:key="*this" class="status {{followEditor.followStatus === item ? 'selected' : ''}}" data-status="{{item}}" bindtap="handleFollowStatus">{{item}}</view><textarea data-field="followNote" value="{{followEditor.followNote}}" bindinput="handleFollowInput" placeholder="跟进备注"/><button class="primary" loading="{{updatingLeadId === followEditor.leadId}}" bindtap="handleFollowSave">保存跟进</button></view></view>
