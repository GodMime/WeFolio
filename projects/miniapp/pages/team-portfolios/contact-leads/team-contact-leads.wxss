.page-shell{min-height:100vh;padding:24rpx 28rpx;background:#f5f7fb;color:#17202a}.list{height:calc(100vh - 150rpx)}.lead{display:flex;flex-direction:column;gap:10rpx;min-width:0;margin-bottom:16rpx;padding:24rpx;background:#fff;border-radius:12rpx;overflow-wrap:anywhere}.lead text{min-width:0;overflow-wrap:anywhere}.name{font-weight:600;font-size:32rpx}.actions{display:flex;gap:12rpx;flex-wrap:wrap;min-width:0}.actions button{font-size:24rpx}.state{min-width:0;padding:80rpx 20rpx;text-align:center;color:#5b6775;overflow-wrap:anywhere}.editor{position:fixed;right:0;bottom:0;left:0;min-width:0;padding:24rpx 28rpx calc(24rpx + env(safe-area-inset-bottom));background:#fff;box-shadow:0 -4rpx 20rpx rgba(23,32,42,.08);overflow-wrap:anywhere}.status{display:inline-block;margin:0 12rpx 12rpx 0;padding:10rpx 14rpx;background:#eef1f4}.status.selected{background:#0f766e;color:#fff}.editor textarea{width:100%;box-sizing:border-box;padding:16rpx;background:#f5f7fb}.primary{margin-top:12rpx;background:#0f766e;color:#fff}
