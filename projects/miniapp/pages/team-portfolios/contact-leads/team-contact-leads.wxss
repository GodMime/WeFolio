.page-shell{min-height:100vh;padding:20rpx 32rpx 56rpx;background:#f5f6f7;color:#212529;box-sizing:border-box}.list{height:calc(100vh - 150rpx)}.lead{display:flex;flex-direction:column;gap:12rpx;min-width:0;margin-bottom:20rpx;padding:28rpx;background:#fff;border:1rpx solid #e9ecef;border-radius:48rpx;overflow-wrap:anywhere;box-sizing:border-box}.lead text{min-width:0;color:#6c757d;overflow-wrap:anywhere}.lead .name{color:#212529;font-weight:800;font-size:32rpx}.actions{display:flex;gap:12rpx;flex-wrap:wrap;min-width:0;margin-top:8rpx}.actions button{min-height:64rpx;margin:0;padding:0 20rpx;color:#212529;font-size:24rpx;border:1rpx solid #e9ecef;border-radius:999rpx;background:#fff}.state{min-width:0;padding:80rpx 20rpx;text-align:center;color:#868e96;overflow-wrap:anywhere}.editor{position:fixed;right:0;bottom:0;left:0;min-width:0;padding:28rpx 32rpx calc(32rpx + env(safe-area-inset-bottom));background:#fff;border-radius:56rpx 56rpx 0 0;box-shadow:0 -12rpx 36rpx rgba(33,37,41,.12);overflow-wrap:anywhere}.status{display:inline-block;margin:0 12rpx 12rpx 0;padding:10rpx 16rpx;color:#6c757d;border:1rpx solid #e9ecef;border-radius:999rpx;background:#fff}.status.selected{border-color:#212529;background:#212529;color:#fff}.editor textarea{width:100%;min-height:156rpx;box-sizing:border-box;padding:20rpx;color:#212529;border:1rpx solid #e9ecef;border-radius:40rpx;background:#f5f6f7}.primary{min-height:84rpx;margin-top:20rpx;color:#fff;border-radius:999rpx;background:#212529}
