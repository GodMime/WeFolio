@import "../../../../styles/portfolio-text-typography.wxss";

.timeline-editor-mask { position: fixed; top: 0; right: 0; bottom: 0; left: 0; background: rgba(17,24,39,.42); z-index: 1500; opacity: 0; pointer-events: none; transition: opacity .2s; }
.timeline-editor-mask.is-visible { opacity: 1; pointer-events: auto; }
.timeline-editor-sheet { --timeline-surface: #FFFFFF; --timeline-input: #F5F6F7; --timeline-text: #212529; --timeline-muted: #868E96; --timeline-rule: #E9ECEF; --timeline-strong-rule: #DEE2E6; --timeline-selected: #F1F3F5; --timeline-danger: #B55656; position: fixed; left: 0; right: 0; bottom: 0; z-index: 1501; height: 88vh; max-height: calc(100vh - 176rpx - env(safe-area-inset-top)); display: flex; flex-direction: column; box-sizing: border-box; overflow: hidden; background: var(--timeline-surface); color: var(--timeline-text); border-radius: var(--pe-radius-sheet, 56rpx) var(--pe-radius-sheet, 56rpx) 0 0; transform: translateY(105%); pointer-events: none; transition: transform .2s; }
.timeline-editor-sheet.is-visible { transform: translateY(0); pointer-events: auto; }
.timeline-editor-dark { --timeline-surface: #202328; --timeline-input: #30343A; --timeline-text: #F8F9FA; --timeline-muted: #C1C7CE; --timeline-rule: #51565E; --timeline-strong-rule: #737C88; --timeline-selected: #343941; --timeline-danger: #EF9C97; }
.timeline-editor-grabber { width: 72rpx; height: 8rpx; flex-shrink: 0; border-radius: 999rpx; background: var(--timeline-strong-rule); align-self: center; margin: 20rpx 0; }
.timeline-editor-header { display: flex; align-items: center; justify-content: space-between; gap: 20rpx; flex-shrink: 0; padding: 12rpx 32rpx 24rpx; font-size: 32rpx; font-weight: 800; line-height: 1.35; }
/* 两侧等宽，节点标题始终居中；返回热区独立于可见圆形按钮。 */
.timeline-node-header { display: flex; align-items: center; gap: 12rpx; flex-shrink: 0; padding: 4rpx 32rpx 24rpx; }
.timeline-node-header-side { display: flex; align-items: center; flex: none; width: 128rpx; min-height: 88rpx; }
.timeline-node-header-title { flex: 1; min-width: 0; text-align: center; font-size: 28rpx; font-weight: 600; line-height: 1.5; }
.timeline-node-header-meta { justify-content: flex-end; }
.timeline-header-back { display: flex; align-items: center; justify-content: center; width: 88rpx; height: 88rpx; min-width: 44px; min-height: 44px; }
.timeline-header-back-circle { display: flex; align-items: center; justify-content: center; width: 76rpx; height: 76rpx; border-radius: 999rpx; background: var(--timeline-input); color: var(--timeline-text); }
.timeline-header-back-icon { width: 14rpx; height: 14rpx; margin-left: 6rpx; border-left: 3rpx solid currentColor; border-bottom: 3rpx solid currentColor; transform: rotate(45deg); }
.timeline-header-back-pressed { opacity: .6; }
.timeline-meta { flex-shrink: 0; padding: 8rpx 16rpx; color: var(--timeline-muted); background: var(--timeline-surface); border: 1rpx solid var(--timeline-rule); border-radius: 999rpx; font-size: 22rpx; font-weight: 400; line-height: 1.2; }
.timeline-editor-tabs { position: relative; display: flex; flex-shrink: 0; min-height: 72rpx; margin: 0 32rpx 20rpx; border-bottom: 1rpx solid var(--timeline-rule); }
.timeline-tab { display: flex; align-items: center; justify-content: center; flex: 1; min-width: 0; height: 72rpx; font-size: 26rpx; line-height: 1; font-weight: 500; color: var(--timeline-muted); }
.timeline-tab.selected { color: var(--timeline-text); font-weight: 600; }
.timeline-tab-indicator { position: absolute; left: 25%; bottom: -1rpx; width: 48rpx; height: 5rpx; margin-left: -24rpx; background: var(--timeline-text); border-radius: 999rpx; pointer-events: none; transition: left .22s; }
.timeline-tab-indicator.style-active { left: 75%; }
/* 显式滚动高度与底栏收缩约束，避免 Skyline 下表单挤占操作区。 */
.timeline-editor-stage { position: relative; flex: 1; min-height: 0; height: 0; overflow: hidden; }
/* 两个面板常驻，进入向左、返回向右；仅活动面板接收点击和辅助功能焦点。 */
.timeline-editor-panel { position: absolute; top: 0; left: 0; display: flex; flex-direction: column; width: 100%; height: 100%; opacity: 0; pointer-events: none; }
.timeline-list-panel { transform: translateX(-48rpx); }
.timeline-node-panel { transform: translateX(48rpx); }
.timeline-editor-stage.is-node-navigation .timeline-editor-panel { transition: transform .22s cubic-bezier(.22, 1, .36, 1), opacity .22s ease; }
.timeline-editor-panel.is-active { z-index: 1; opacity: 1; transform: translateX(0); pointer-events: auto; }
.timeline-editor-scroll { flex: 1; min-height: 0; height: 0; }
.timeline-editor-body { padding: 4rpx 32rpx 28rpx; }
.timeline-field-group { margin-bottom: 32rpx; }
.timeline-label { display: block; margin: 0 0 16rpx; font-size: 28rpx; font-weight: 600; line-height: 1.5; }
.timeline-help { display: block; margin: 12rpx 0 0; color: var(--timeline-muted); font-size: 22rpx; line-height: 1.6; }
.timeline-label-row, .timeline-editor-row { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; min-height: 60rpx; margin-bottom: 14rpx; }
.timeline-label-row .timeline-label, .timeline-label-row .timeline-help, .timeline-editor-row .timeline-label { margin: 0; }
.timeline-label-row > .timeline-help { flex-shrink: 0; }
.timeline-kicker-copy { flex: 1; min-width: 0; }
.timeline-kicker-example { display: block; margin-top: 8rpx; font-size: 20rpx; line-height: 1.5; letter-spacing: 2rpx; color: var(--timeline-muted); }
.timeline-switch { flex-shrink: 0; transform: scale(.82); transform-origin: right center; }
/* 单行 input 显式声明高度并使用原生垂直居中，仅保留左右内边距，避免 WebView 文字下移。 */
.timeline-input { display: block; width: 100%; height: 88rpx; min-height: 88rpx; box-sizing: border-box; padding: 0 24rpx; border: 1rpx solid var(--timeline-rule); border-radius: var(--pe-radius-control, 28rpx); background: var(--timeline-input); color: var(--timeline-text); font-size: 26rpx; line-height: 1.5; }
.timeline-textarea { display: block; width: 100%; min-height: 220rpx; box-sizing: border-box; padding: 20rpx 24rpx; border: 1rpx solid var(--timeline-rule); border-radius: var(--pe-radius-control, 28rpx); background: var(--timeline-input); color: var(--timeline-text); font-size: 26rpx; line-height: 1.6; }
.timeline-placeholder { color: var(--timeline-muted); }
.timeline-empty { padding: 32rpx 24rpx; border-radius: 28rpx; background: var(--timeline-input); color: var(--timeline-muted); text-align: center; font-size: 24rpx; line-height: 1.6; }
.timeline-node-row { position: relative; margin-bottom: 16rpx; border-radius: var(--pe-radius-control, 28rpx); background: var(--timeline-input); }
.timeline-node-row.row-dragging { z-index: 2; }
.timeline-node-row.drag-target { outline: 2rpx dashed var(--timeline-strong-rule); outline-offset: 4rpx; }
.timeline-node-main { position: relative; display: flex; align-items: center; min-height: 120rpx; box-sizing: border-box; border: 1rpx solid var(--timeline-rule); border-radius: var(--pe-radius-control, 28rpx); background: var(--timeline-surface); transition: transform .15s; }
.timeline-node-main.dragging { z-index: 2; opacity: 1; border-color: var(--timeline-text); box-shadow: 0 12rpx 32rpx rgba(0,0,0,.12); transition: none; }
.timeline-drag-handle { display: flex; flex-direction: column; justify-content: center; align-items: center; gap: 6rpx; align-self: stretch; flex: none; width: 64rpx; min-height: 116rpx; }
.timeline-drag-handle > view { width: 22rpx; height: 3rpx; border-radius: 3rpx; background: var(--timeline-muted); }
.timeline-drag-handle.disabled { opacity: .3; }
.timeline-node-edit { display: flex; align-items: center; flex: 1; min-width: 0; gap: 18rpx; min-height: 116rpx; padding: 16rpx 22rpx 16rpx 0; box-sizing: border-box; }
.timeline-node-number { display: flex; align-items: center; justify-content: center; width: 40rpx; height: 40rpx; flex: none; background: var(--timeline-input); border-radius: 999rpx; font-size: 22rpx; font-weight: 600; }
.timeline-node-copy { flex: 1; min-width: 0; }
.timeline-node-mark { display: block; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; margin-bottom: 6rpx; color: var(--timeline-muted); font-size: 22rpx; line-height: 1.5; }
.timeline-node-title { display: block; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: 26rpx; line-height: 1.5; font-weight: 600; }
.timeline-chevron { flex: none; color: var(--timeline-muted); font-size: 36rpx; line-height: 1; }
/* 操作按钮显式重置尺寸，兼容全局 button 重置和微信默认按钮宽度。 */
.timeline-editor-body .timeline-add, .timeline-editor-body .timeline-delete { display: flex; align-items: center; justify-content: center; width: 100%; min-height: 80rpx; margin: 20rpx 0 0; padding: 20rpx; box-sizing: border-box; border: 2rpx dashed var(--timeline-strong-rule); border-radius: 999rpx; background: transparent; color: var(--timeline-text); font-size: 26rpx; font-weight: 700; line-height: 1.5; }
.timeline-editor-body .timeline-delete { margin: 8rpx 0 28rpx; border: 1rpx solid var(--timeline-rule); color: var(--timeline-danger); font-weight: 500; }
.timeline-add::after, .timeline-delete::after, .timeline-more-fonts::after, .timeline-stepper button::after, .timeline-editor-footer button::after { border: 0; }
.timeline-add[disabled] { opacity: .45; }
.timeline-detail-heading { display: flex; align-items: center; gap: 24rpx; min-height: 72rpx; margin: 0 0 22rpx; font-size: 28rpx; font-weight: 600; }
.timeline-back { display: flex; align-items: center; justify-content: center; min-width: 104rpx; min-height: 72rpx; color: var(--timeline-muted); font-size: 24rpx; font-weight: 400; }
.timeline-options { display: flex; flex-wrap: wrap; gap: 12rpx; margin-bottom: 20rpx; }
.timeline-option { display: flex; align-items: center; justify-content: center; min-height: 64rpx; padding: 12rpx 20rpx; box-sizing: border-box; border: 1rpx solid var(--timeline-rule); border-radius: 999rpx; background: var(--timeline-input); color: var(--timeline-text); font-size: 24rpx; line-height: 1.5; }
.timeline-option.selected { background: var(--timeline-text); color: var(--timeline-surface); border-color: var(--timeline-text); font-weight: 600; }
.timeline-precision-options { flex-wrap: nowrap; }
.timeline-precision-options .timeline-option { flex: 1; min-width: 0; padding: 12rpx 8rpx; }
.timeline-role-options .timeline-option { flex: 1 1 40%; }
.timeline-date-inputs { display: flex; gap: 16rpx; }
.timeline-date-part { flex: 1; min-width: 0; }
.timeline-date-part:first-child { flex: 1.5; }
.timeline-date-label { display: block; margin-bottom: 10rpx; font-size: 22rpx; color: var(--timeline-muted); }
.timeline-date-part .timeline-input { padding: 0 16rpx; }
.timeline-custom-label-row { margin-top: 20rpx; }
/* 标记预览保留为普通文字，长标签完整换行。 */
.timeline-date-preview { display: flex; align-items: baseline; gap: 12rpx; margin-top: 18rpx; color: var(--timeline-muted); font-size: 22rpx; line-height: 1.7; }
.timeline-date-preview > text:first-child { flex-shrink: 0; }
.timeline-date-value { min-width: 0; color: var(--timeline-text); font-size: 26rpx; font-weight: 600; white-space: pre-wrap; word-break: break-all; overflow-wrap: anywhere; }
.timeline-date-pending .timeline-date-value { color: var(--timeline-muted); font-size: 22rpx; font-weight: 400; }
.timeline-variants { display: flex; gap: 14rpx; }
.timeline-variant { flex: 1; min-width: 0; padding: 16rpx 14rpx 22rpx; box-sizing: border-box; border: 1rpx solid var(--timeline-strong-rule); border-radius: 28rpx; background: var(--timeline-surface); color: var(--timeline-muted); text-align: center; font-size: 22rpx; line-height: 1.4; }
.timeline-variant.selected { border-color: var(--timeline-text); background: var(--timeline-input); color: var(--timeline-text); box-shadow: inset 0 0 0 1rpx var(--timeline-text); }
.variant-label { display: flex; align-items: center; justify-content: space-between; font-size: 20rpx; font-weight: 600; }
.variant-check { width: 28rpx; height: 28rpx; line-height: 28rpx; border-radius: 50%; background: var(--timeline-text); color: var(--timeline-surface); visibility: hidden; }
.variant-check.checked { visibility: visible; }
.variant-sketch { height: 100rpx; position: relative; margin: 14rpx 0 18rpx; }
.sketch-line { position: absolute; left: 24rpx; top: 8rpx; width: 2rpx; height: 84rpx; background: currentColor; opacity: .4; }
.sketch-node { position: absolute; left: 20rpx; right: 4rpx; display: flex; align-items: center; gap: 8rpx; }
.sketch-first { top: 12rpx; }
.sketch-second { top: 60rpx; }
.sketch-dot { width: 10rpx; height: 10rpx; border-radius: 50%; background: currentColor; flex: none; }
.sketch-copy { flex: 1; }
.sketch-copy > view { height: 3rpx; background: currentColor; margin: 7rpx 0; opacity: .6; }
.sketch-copy > view:last-child { width: 65%; }
.variant-sketch-DATE_COLUMN .sketch-node { left: 0; gap: 5rpx; font-size: 16rpx; }
.variant-sketch-DATE_COLUMN .sketch-line { left: 48rpx; }
.variant-sketch-MILESTONE_CARD .sketch-copy { border: 1rpx solid currentColor; border-radius: 7rpx; padding: 3rpx 7rpx; }
.variant-sketch-MILESTONE_CARD .sketch-dot { border-radius: 2rpx; }
.timeline-directions { display: flex; gap: 16rpx; }
.timeline-direction { display: flex; align-items: center; justify-content: center; flex: 1; min-width: 0; gap: 20rpx; min-height: 112rpx; padding: 16rpx; box-sizing: border-box; border: 1rpx solid var(--timeline-rule); border-radius: 28rpx; color: var(--timeline-muted); font-size: 24rpx; }
.timeline-direction.selected { border-color: var(--timeline-text); color: var(--timeline-text); background: var(--timeline-input); }
.direction-sketch { position: relative; display: flex; align-items: center; justify-content: space-between; width: 58rpx; height: 44rpx; }
.direction-sketch::before { content: ''; position: absolute; left: 0; right: 0; top: 21rpx; height: 2rpx; background: currentColor; opacity: .35; }
.direction-sketch > view { position: relative; width: 8rpx; height: 8rpx; border-radius: 50%; background: currentColor; }
.direction-VERTICAL { width: 44rpx; height: 58rpx; flex-direction: column; }
.direction-VERTICAL::before { top: 0; bottom: 0; left: 21rpx; width: 2rpx; height: auto; }
.timeline-spacing-value { display: flex; align-items: center; gap: 10rpx; font-size: 22rpx; color: var(--timeline-muted); }
.timeline-spacing-value input { width: 108rpx; height: 64rpx; box-sizing: border-box; text-align: center; border: 1rpx solid var(--timeline-rule); border-radius: 16rpx; background: var(--timeline-input); color: var(--timeline-text); font-size: 26rpx; }
.timeline-slider { margin: 24rpx 12rpx 16rpx; }
.timeline-range-labels { display: flex; justify-content: space-between; color: var(--timeline-muted); font-size: 22rpx; }
.timeline-spacing-note { display: flex; gap: 16rpx; margin-top: 24rpx; padding: 24rpx; border-radius: 24rpx; background: var(--timeline-input); font-size: 24rpx; font-weight: 500; line-height: 1.5; }
.timeline-spacing-note .timeline-help { margin-top: 6rpx; font-weight: 400; }
.timeline-auto-icon { font-size: 34rpx; flex: none; }
.timeline-style-entries { overflow: hidden; border: 1rpx solid var(--timeline-rule); border-radius: 28rpx; }
.timeline-style-entry { display: flex; align-items: center; gap: 16rpx; min-height: 92rpx; padding: 20rpx 24rpx; box-sizing: border-box; border-bottom: 1rpx solid var(--timeline-rule); font-size: 26rpx; line-height: 1.5; }
.timeline-style-entry:last-child { border-bottom: 0; }
.timeline-entry-summary { flex: 1; min-width: 0; text-align: right; color: var(--timeline-muted); font-size: 22rpx; }
.timeline-preview { border: 1rpx solid var(--timeline-rule); border-radius: 28rpx; overflow: hidden; }
.timeline-editor-body .timeline-more-fonts { display: flex; align-items: center; justify-content: center; width: auto; min-width: 144rpx; min-height: 72rpx; padding: 16rpx 24rpx; box-sizing: border-box; margin: 0; border: 1rpx solid var(--timeline-rule); border-radius: 999rpx; background: var(--timeline-input); color: var(--timeline-text); font-size: 24rpx; line-height: 1.5; font-weight: 500; }
.timeline-fonts { display: flex; flex-wrap: wrap; gap: 16rpx; margin-top: 18rpx; }
.timeline-font { flex: 1 1 40%; min-width: 0; padding: 20rpx; box-sizing: border-box; border: 1rpx solid var(--timeline-rule); border-radius: 28rpx; background: var(--timeline-input); font-size: 24rpx; line-height: 1.6; }
.timeline-font.selected { color: var(--timeline-surface); background: var(--timeline-text); border-color: var(--timeline-text); }
.timeline-font.disabled { opacity: .5; }
.timeline-font.selected.disabled { opacity: 1; }
.timeline-font.selected .timeline-help { color: inherit; }
.timeline-font-name { display: block; font-weight: 600; }
.timeline-font-language, .timeline-font-sample { display: block; margin-top: 8rpx; }
.timeline-font-language { font-size: 22rpx; }
.timeline-font-preview { display: block; width: 240rpx; max-width: 100%; margin-top: 8rpx; }
.timeline-stepper { display: flex; align-items: center; flex-shrink: 0; background: var(--timeline-input); border-radius: 999rpx; overflow: hidden; }
.timeline-stepper button { width: 76rpx; height: 80rpx; min-width: 0; padding: 0; margin: 0; border: 0; background: transparent; color: var(--timeline-text); font-size: 32rpx; line-height: 80rpx; }
.timeline-stepper button[disabled] { opacity: .35; }
.timeline-stepper input { width: 76rpx; height: 80rpx; text-align: center; color: var(--timeline-text); font-size: 32rpx; font-weight: 700; }
.timeline-stepper text { padding-right: 8rpx; font-size: 22rpx; color: var(--timeline-muted); }
.timeline-link { display: flex; align-items: center; justify-content: center; min-height: 72rpx; padding: 12rpx 0; color: var(--timeline-text); text-decoration: underline; font-size: 24rpx; line-height: 1.5; }
.timeline-reset-options { display: flex; flex-wrap: wrap; gap: 12rpx; }
.timeline-reset-options > view { flex: 1 1 25%; display: flex; align-items: center; justify-content: center; min-height: 72rpx; padding: 12rpx; box-sizing: border-box; border: 1rpx solid var(--timeline-rule); border-radius: 20rpx; font-size: 22rpx; line-height: 1.5; text-align: center; }
.timeline-total { margin-top: 24rpx; }
.timeline-error { display: block; margin-top: 20rpx; color: var(--timeline-danger); font-size: 25rpx; line-height: 1.6; }
.timeline-editor-footer { display: flex; gap: 16rpx; flex-shrink: 0; padding: 24rpx 32rpx calc(32rpx + env(safe-area-inset-bottom)); background: var(--timeline-surface); }
.timeline-editor-footer button { display: flex; align-items: center; justify-content: center; flex: 1 1 0; width: 0; min-width: 0; min-height: 80rpx; box-sizing: border-box; margin: 0; padding: 20rpx; border: 1rpx solid var(--timeline-rule); border-radius: 999rpx; background: var(--timeline-selected); color: var(--timeline-text); font-size: 26rpx; font-weight: 700; line-height: 1.5; }
.timeline-editor-footer .timeline-confirm { background: var(--timeline-text); color: var(--timeline-surface); border-color: var(--timeline-text); }
.timeline-editor-footer button[disabled] { opacity: .45; }
