@import "../../styles/team-portfolio-theme.wxss";

:host { display: block; }
.schedule-query { padding: 8rpx 34rpx; color: #212529; text-align: center; overflow-wrap: anywhere; box-sizing: border-box; }
.schedule-query.editor-mode { padding: 0; }
.editor-form { display: flex; flex-direction: column; gap: 20rpx; padding: 4rpx 0 8rpx; }
.editor-card { display: flex; flex-direction: column; gap: 20rpx; padding: 28rpx; border: 1rpx solid #e9ecef; border-radius: 48rpx; background: #fff; box-sizing: border-box; }
.editor-field { width: 100%; }
.editor-label { color: #6c757d; font-size: 24rpx; font-weight: 800; }
.editor-input { width: 100%; min-height: 84rpx; margin-top: 12rpx; padding: 0 22rpx; color: #212529; font-size: 28rpx; line-height: 84rpx; border: 1rpx solid #e9ecef; border-radius: 24rpx; background: #f5f6f7; box-sizing: border-box; }
.editor-textarea { height: 160rpx; padding-top: 20rpx; padding-bottom: 20rpx; line-height: 1.55; }
.editor-choice-list { display: flex; flex-direction: column; gap: 12rpx; margin-top: 16rpx; }
.editor-choice { width: 100%; min-height: 88rpx; display: flex; align-items: center; gap: 16rpx; margin: 0; padding: 0 20rpx; color: #212529; font-size: 28rpx; font-weight: 800; text-align: left; border: 1rpx solid #e9ecef; border-radius: 28rpx; background: #f5f6f7; box-sizing: border-box; }
.editor-choice.active { border-color: #212529; background: #fff; }
.editor-choice-radio { width: 28rpx; height: 28rpx; flex: none; border: 3rpx solid #b6c4d2; border-radius: 50%; background: #fff; box-sizing: border-box; }
.editor-choice.active .editor-choice-radio { border-color: #212529; background: #212529; box-shadow: inset 0 0 0 7rpx #fff; }
.editor-subfield { margin-top: 20rpx; padding-top: 20rpx; border-top: 1rpx solid #e1e8ef; }
.editor-date-range { display: flex; gap: 12rpx; margin-top: 20rpx; }
.editor-date-range picker { min-width: 0; flex: 1 1 0; }
.editor-date-field { padding: 22rpx 16rpx; color: #6c757d; font-size: 24rpx; text-align: center; border: 1rpx solid #e9ecef; border-radius: 28rpx; background: #f5f6f7; }
.editor-error { padding: 16rpx 18rpx; color: #b55656; font-size: 22rpx; border-radius: 28rpx; background: #fbefef; }
.editor-actions { display: flex; justify-content: flex-end; gap: 16rpx; margin-top: 20rpx; }
.editor-cancel, .editor-confirm { width: 148rpx; height: 64rpx; display: flex; align-items: center; justify-content: center; margin: 0; padding: 0; font-size: 24rpx; font-weight: 900; line-height: 1; border-radius: 999rpx; box-sizing: border-box; }
.editor-cancel { color: #536b82; border: 1rpx solid #cbd6df; background: #eef3f7; }
.editor-confirm { color: #fff; background: #212529; }
.schedule-query-entry,
.schedule-query-inline-shell { box-sizing: border-box; }
.schedule-query-entry-spacer { height: 44rpx; }
.component-title { padding: 0 24rpx; color: #212529; font-size: 32rpx; font-weight: 900; line-height: 1.35; box-sizing: border-box; }
.section-desc { margin-top: 8rpx; color: #868e96; font-size: 26rpx; line-height: 1.75; white-space: pre-wrap; }
.schedule-query-open-button { width: 320rpx; height: 72rpx; margin: 24rpx auto 0; padding: 0; color: #fff; font-size: 26rpx; line-height: 72rpx; border: 0; border-radius: 999rpx; background: #212529; box-sizing: border-box; }
.schedule-query-open-button:active { opacity: .92; }
.schedule-query-inline-shell .schedule-query-calendar { margin-top: 24rpx; }
.schedule-query-modal-mask { position: fixed; left: 0; right: 0; top: 0; bottom: 0; z-index: 90; display: flex; align-items: flex-end; padding: 0; opacity: 0; pointer-events: none; background: rgba(17, 24, 39, .42); transition: opacity 180ms ease; box-sizing: border-box; }
.schedule-query-modal-mask.visible { opacity: 1; pointer-events: auto; }
.schedule-query-modal-panel { width: 100%; max-height: 82vh; overflow-y: auto; padding: 24rpx 32rpx calc(32rpx + env(safe-area-inset-bottom)); border-radius: 56rpx 56rpx 0 0; background: #fff; box-shadow: 0 -18rpx 46rpx rgba(17, 24, 39, .18); box-sizing: border-box; transform: translateY(32rpx); transition: transform 180ms ease; }
.schedule-query-modal-mask.visible .schedule-query-modal-panel { transform: translateY(0); }
.schedule-query-modal-heading { display: flex; align-items: center; justify-content: space-between; gap: 18rpx; margin-bottom: 18rpx; }
.schedule-query-modal-title { flex: 1 1 auto; min-width: 0; color: #212529; font-size: 30rpx; font-weight: 900; line-height: 1.3; text-align: left; }
.schedule-query-close { width: 56rpx; height: 56rpx; display: flex; align-items: center; justify-content: center; flex: none; color: #59636f; font-size: 36rpx; font-weight: 700; line-height: 1; border-radius: 50%; background: #f3f6f9; }
.schedule-query-calendar { padding: 24rpx; border: 1rpx solid #e9ecef; border-radius: 48rpx; background: #fff; box-sizing: border-box; }
.schedule-query-month-bar { display: flex; align-items: center; justify-content: flex-start; gap: 12rpx; }
.schedule-query-month-button { width: 60rpx; height: 60rpx; display: flex; align-items: center; justify-content: center; flex: none; color: #212529; font-size: 40rpx; font-weight: 700; line-height: 1; border: 1rpx solid #dee2e6; border-radius: 999rpx; background: #f5f6f7; box-sizing: border-box; }
.schedule-query-month-text { min-width: 0; flex: 1 1 auto; color: #212529; font-size: 28rpx; font-weight: 900; line-height: 1.3; text-align: left; white-space: nowrap; }
.schedule-query-month-picker { flex: none; }
.schedule-query-month-picker-button { height: 56rpx; display: flex; align-items: center; justify-content: center; padding: 0 18rpx; color: #36516e; font-size: 22rpx; font-weight: 800; line-height: 1; border: 1rpx solid #d8dee5; border-radius: 999rpx; background: #f8fbfd; box-sizing: border-box; white-space: nowrap; }
.schedule-query-weekdays { display: flex; align-items: center; margin: 20rpx -4rpx 0; color: #adb5bd; font-size: 22rpx; font-weight: 600; line-height: 1.4; }
.schedule-query-weekdays > view { width: calc(14.285714% - 8rpx); min-width: 0; min-height: 40rpx; display: flex; align-items: center; justify-content: center; flex: 0 0 calc(14.285714% - 8rpx); margin: 0 4rpx; text-align: center; box-sizing: border-box; }
.schedule-query-days { display: flex; flex-wrap: wrap; margin: 12rpx -4rpx 0; }
.schedule-calendar-day { width: calc(14.285714% - 8rpx); min-width: 0; min-height: 88rpx; display: flex; align-items: center; justify-content: space-between; flex: 0 0 calc(14.285714% - 8rpx); flex-direction: column; margin: 4rpx; padding: 8rpx 4rpx; color: #212529; border: 0; border-radius: 28rpx; background: transparent; box-sizing: border-box; }
.schedule-calendar-day.muted { color: #ced4da; background: transparent; }
.schedule-calendar-day.disabled { color: #dee2e6; background: transparent; opacity: .58; }
.schedule-calendar-day.selected { color: #212529; background: transparent; box-shadow: none; }
.schedule-query-day-stack { width: 54rpx; height: 54rpx; max-width: 100%; min-width: 0; display: flex; align-items: center; justify-content: center; flex: none; flex-direction: column; gap: 2rpx; }
.schedule-calendar-day.selected .schedule-query-day-stack { color: #fff; border-radius: 50%; background: #212529; box-shadow: 0 0 0 9rpx #212529; }
.schedule-query-day-number { font-size: 30rpx; font-weight: 600; line-height: 1; }
.schedule-query-day-meta { max-width: 100%; overflow: hidden; color: #adb5bd; font-size: 20rpx; font-weight: 500; line-height: 1.1; text-overflow: ellipsis; white-space: nowrap; }
.schedule-calendar-day.muted .schedule-query-day-meta,
.schedule-calendar-day.disabled .schedule-query-day-meta { color: #dee2e6; }
.schedule-calendar-day.selected .schedule-query-day-meta { color: #fff; }
.schedule-query-day-dots { height: 10rpx; display: flex; align-items: center; justify-content: center; gap: 6rpx; margin-top: 6rpx; }
.schedule-query-day-dot { width: 10rpx; height: 10rpx; border-radius: 50%; }
.schedule-query-selected-date { min-height: 40rpx; margin-top: 16rpx; color: #59636f; font-size: 24rpx; line-height: 40rpx; text-align: center; }
.schedule-query-submit { width: 260rpx; height: 72rpx; margin: 24rpx auto 0; padding: 0; color: #fff; font-size: 26rpx; line-height: 72rpx; border-radius: 999rpx; background: #212529; }
.schedule-query-submit[disabled] { color: #a9b1ba; background: #e4e8ed; }
.member-results { margin-top: 22rpx; border-top: 1rpx solid #e4e9ea; }
.member-result { display: flex; align-items: center; gap: 16rpx; padding: 18rpx 0; text-align: left; border-bottom: 1rpx solid #e4e9ea; }
.member-result image { width: 64rpx; height: 64rpx; flex: none; border-radius: 50%; background: #eef2f2; }
.member-name { flex: 1 1 0; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.state { flex: none; font-size: 24rpx; }
.state.available { color: #5c9e6e; }
.state.partial { color: #c08a3e; }
.state.full { color: #b55656; }
.state.unavailable { color: #868e96; }
.error { display: block; margin-top: 16rpx; color: #b55656; }
