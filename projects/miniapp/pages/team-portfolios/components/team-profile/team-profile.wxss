:host { display: block; }
.team-profile { padding: 32rpx; color: #212529; text-align: center; overflow-wrap: anywhere; }
.team-profile.editor-mode { padding: 0; }
.editor-form { display: flex; flex-direction: column; gap: 16rpx; padding: 4rpx 0 8rpx; text-align: left; }
.editor-profile-card { display: flex; align-items: center; gap: 16rpx; padding: 28rpx; border: 1rpx solid #e9ecef; border-radius: 48rpx; background: #fff; box-sizing: border-box; }
.editor-avatar-wrap { flex: none; }
.editor-avatar { width: 96rpx; height: 96rpx; flex: none; border-radius: 50%; background: #eef3f7; }
.editor-avatar-empty { display: flex; align-items: center; justify-content: center; color: #8a98a8; font-size: 22rpx; font-weight: 800; }
.editor-profile-copy { min-width: 0; flex: 1 1 0; }
.editor-profile-name, .editor-profile-intro { display: block; overflow: hidden; text-overflow: ellipsis; }
.editor-profile-name { color: #212529; font-size: 28rpx; font-weight: 900; white-space: nowrap; }
.editor-profile-intro { margin-top: 8rpx; color: #697786; font-size: 22rpx; line-height: 1.4; display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 2; }
.editor-assist { min-width: 128rpx; height: 56rpx; flex: none; margin: 0; padding: 0 18rpx; color: #212529; font-size: 22rpx; font-weight: 900; line-height: 56rpx; border: 1rpx solid #dee2e6; border-radius: 999rpx; background: #f5f6f7; box-sizing: border-box; }
.editor-field { padding: 28rpx; border: 1rpx solid #e9ecef; border-radius: 48rpx; background: #fff; }
.editor-field-heading { display: flex; align-items: center; justify-content: space-between; margin-bottom: 14rpx; color: #263747; font-size: 24rpx; font-weight: 800; }
.editor-counter { color: #8a98a8; font-size: 20rpx; font-weight: 600; }
.editor-input, .editor-textarea { width: 100%; color: #212529; font-size: 26rpx; line-height: 1.6; box-sizing: border-box; }
.editor-textarea { min-height: 180rpx; }
.editor-visibility-section { padding: 28rpx; border: 1rpx solid #e9ecef; border-radius: 48rpx; background: #fff; }
.editor-visibility-title { margin-bottom: 6rpx; color: #263747; font-size: 24rpx; font-weight: 800; }
.editor-visibility-list { display: flex; flex-direction: column; }
.editor-visibility-option { min-height: 80rpx; display: flex; align-items: center; justify-content: space-between; gap: 20rpx; border-bottom: 1rpx solid #edf1f4; }
.editor-visibility-option:last-child { border-bottom: 0; }
.editor-visibility-label { color: #263747; font-size: 24rpx; font-weight: 700; }
.editor-tip { padding: 18rpx 20rpx; color: #697786; font-size: 22rpx; line-height: 1.5; border-radius: 14rpx; background: #f8fafc; }
.editor-refresh { width: 100%; height: 68rpx; margin: 0; color: #212529; font-size: 24rpx; font-weight: 900; line-height: 68rpx; border: 1rpx solid #dee2e6; border-radius: 999rpx; background: #f5f6f7; box-sizing: border-box; }
.editor-error { padding: 16rpx 18rpx; color: #b55656; font-size: 22rpx; border-radius: 28rpx; background: #fbefef; }
.editor-actions { display: flex; justify-content: flex-end; gap: 16rpx; margin-top: 20rpx; }
.editor-cancel, .editor-confirm { width: 148rpx; height: 64rpx; display: flex; align-items: center; justify-content: center; margin: 0; padding: 0; font-size: 24rpx; font-weight: 900; line-height: 1; border-radius: 999rpx; box-sizing: border-box; }
.editor-cancel { color: #536b82; border: 1rpx solid #cbd6df; background: #eef3f7; }
.editor-confirm { color: #fff; background: #212529; }
.avatar { display: block; width: 144rpx; height: 144rpx; margin: 0 auto; border-radius: 50%; background: #eef2f2; }
.name { display: block; margin-top: 20rpx; font-size: 36rpx; font-weight: 600; }
.intro { display: block; margin: 16rpx auto 0; max-width: 620rpx; color: #5e6b73; line-height: 1.7; white-space: pre-wrap; }
