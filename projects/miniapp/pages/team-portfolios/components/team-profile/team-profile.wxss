:host { display: block; }
.team-profile { padding: 32rpx; color: #17202a; text-align: center; overflow-wrap: anywhere; }
.avatar { width: 144rpx; height: 144rpx; border-radius: 50%; background: #eef2f2; }
.maintain-button { margin-top: 20rpx; border-radius: 6px; color: #0f766e; }
.name { display: block; margin-top: 20rpx; font-size: 36rpx; font-weight: 600; }
.intro { display: block; margin: 16rpx auto 0; max-width: 620rpx; color: #5e6b73; line-height: 1.7; white-space: pre-wrap; }
.actions { display: flex; gap: 20rpx; margin-top: 28rpx; }
.actions button { flex: 1; border-radius: 6px; }
.primary { background: #0f766e; color: #fff; }
.error { display: block; margin-top: 16rpx; color: #b42318; text-align: left; }
