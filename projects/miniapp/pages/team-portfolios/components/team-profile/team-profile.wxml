<view class="team-profile {{editMode ? 'editor-mode' : ''}}">
  <block wx:if="{{editMode}}">
    <view class="editor-form">
      <view class="editor-profile-card">
        <view class="editor-avatar-wrap" bindtap="chooseAvatar">
          <image wx:if="{{draft.team.avatarUrl}}" class="editor-avatar" src="{{draft.team.avatarUrl}}" mode="aspectFill" />
          <view wx:else class="editor-avatar editor-avatar-empty">团队</view>
        </view>
        <view class="editor-profile-copy">
          <text class="editor-profile-name">团队头像</text>
          <text class="editor-profile-intro">仅用于当前作品集展示</text>
        </view>
        <button class="editor-assist" bindtap="chooseAvatar">更换头像</button>
      </view>
      <view class="editor-field">
        <view class="editor-field-heading"><text>团队名称</text><text class="editor-counter">{{teamNameCounter}}</text></view>
        <input class="editor-input" value="{{draft.team.teamName}}" maxlength="100" data-field="teamName" bindinput="handleInput" />
      </view>
      <view class="editor-field">
        <view class="editor-field-heading"><text>团队简介</text><text class="editor-counter">{{introCounter}}</text></view>
        <textarea class="editor-textarea" value="{{draft.team.intro}}" maxlength="1000" data-field="intro" bindinput="handleInput"></textarea>
      </view>
      <view class="editor-visibility-section">
        <view class="editor-visibility-title">展示字段</view>
        <view class="editor-visibility-list">
          <view wx:for="{{visibleFieldOptions}}" wx:key="field" class="editor-visibility-option">
            <text class="editor-visibility-label">{{item.label}}</text>
            <switch checked="{{item.checked}}" color="#17202a" data-field="{{item.field}}" bindchange="handleVisibleFieldChange" />
          </view>
        </view>
      </view>
      <view class="editor-tip">初始内容来自团队资料，修改只保存在当前作品集内。</view>
      <button class="editor-refresh" loading="{{refreshing}}" disabled="{{refreshing}}" bindtap="refreshFromTeam">从团队资料刷新</button>
      <view wx:if="{{errorMessage}}" class="editor-error">{{errorMessage}}</view>
    </view>
  </block>
  <block wx:else>
    <image wx:if="{{draft.visibleFields.avatar && draft.team.avatarUrl}}" class="avatar" src="{{draft.team.avatarUrl}}" mode="aspectFill" />
    <text wx:if="{{draft.visibleFields.teamName && draft.team.teamName}}" class="name">{{draft.team.teamName}}</text>
    <text wx:if="{{draft.visibleFields.intro && draft.team.intro}}" class="intro">{{draft.team.intro}}</text>
  </block>
</view>
