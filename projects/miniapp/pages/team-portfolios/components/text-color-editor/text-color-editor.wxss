.text-color-options { display: flex; flex-wrap: wrap; gap: 12rpx; }
.text-color-options.is-inactive { pointer-events: none; }
.text-color-option { padding: 14rpx 20rpx; border: 2rpx solid #E9ECEF; background: #F5F6F7; border-radius: 999rpx; color: #868E96; font-size: 24rpx; line-height: 1.5; }
.text-color-option.selected { border-color: #212529; background: #212529; color: #FFFFFF; }
.text-color-custom { display: flex; align-items: center; gap: 10rpx; }
.text-color-swatch { width: 26rpx; height: 26rpx; border: 2rpx solid #DEE2E6; border-radius: 50%; flex-shrink: 0; }
.text-color-mask { position: fixed; top: 0; right: 0; bottom: 0; left: 0; z-index: 1600; display: flex; align-items: flex-end; background: rgba(0,0,0,.4); opacity: 0; visibility: hidden; pointer-events: none; transition: opacity .2s ease; }
.text-color-mask.is-mounted { visibility: visible; pointer-events: auto; }
.text-color-mask.is-visible { opacity: 1; pointer-events: auto; }
.text-color-panel { width: 100%; padding: 0 32rpx calc(32rpx + env(safe-area-inset-bottom)); box-sizing: border-box; background: #FFFFFF; border-radius: 40rpx 40rpx 0 0; color: #212529; transform: translateY(100%); pointer-events: none; transition: transform .2s ease; }
.text-color-mask.is-visible .text-color-panel { transform: translateY(0); pointer-events: auto; }
.text-color-grabber { width: 64rpx; height: 8rpx; margin: 16rpx auto 24rpx; border-radius: 8rpx; background: #DEE2E6; }
.text-color-heading { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; margin-bottom: 24rpx; }
.text-color-title { font-size: 32rpx; line-height: 1.4; font-weight: 700; }
.text-color-meta { color: #868E96; font-size: 24rpx; }
.text-color-pad { position: relative; height: 360rpx; overflow: hidden; border: 1rpx solid #E9ECEF; border-radius: 40rpx; }
.text-color-pad-white, .text-color-pad-black { position: absolute; left: 0; right: 0; top: 0; bottom: 0; pointer-events: none; }
.text-color-pad-white { background: linear-gradient(to right, #FFFFFF, rgba(255,255,255,0)); }
.text-color-pad-black { background: linear-gradient(to top, #000000, rgba(0,0,0,0)); }
.text-color-pad-dot { position: absolute; width: 36rpx; height: 36rpx; border: 6rpx solid #FFFFFF; border-radius: 50%; box-shadow: 0 2rpx 8rpx rgba(0,0,0,.35); transform: translate(-50%,-50%); box-sizing: border-box; pointer-events: none; }
/* 色标对应滑条的 0–359°，位置按角度 / 359 计算，避免轨道与实际取色不一致。 */
.text-color-hue-slider { position: relative; height: 32rpx; margin-top: 24rpx; border-radius: 999rpx; background: linear-gradient(to right, #FF0000 0%, #FFFF00 16.7131%, #00FF00 33.4262%, #00FFFF 50.1393%, #0000FF 66.8524%, #FF00FF 83.5655%, #FF0004 100%); }
.text-color-hue-slider slider { position: absolute; left: 0; right: 0; top: 50%; z-index: 2; width: 100%; margin: 0; transform: translateY(-50%); }
.text-color-hue-thumb { position: absolute; top: 50%; z-index: 1; width: 44rpx; height: 44rpx; border: 6rpx solid #FFFFFF; border-radius: 50%; box-shadow: 0 2rpx 8rpx rgba(0,0,0,.3); transform: translate(-50%,-50%); box-sizing: border-box; pointer-events: none; }
.text-color-hex-input { width: 100%; margin-top: 28rpx; min-height: 80rpx; box-sizing: border-box; padding: 20rpx 24rpx; border: 2rpx solid #E9ECEF; border-radius: 24rpx; background: #F8F9FA; font-size: 28rpx; line-height: 1.5; font-weight: 700; }
.text-color-error { min-height: 32rpx; margin-top: 8rpx; font-size: 22rpx; color: #A33B32; line-height: 1.4; }
.text-color-preview-bar { display: flex; align-items: center; gap: 20rpx; margin-top: 12rpx; padding: 16rpx 24rpx; border: 1rpx solid #E9ECEF; border-radius: 40rpx; }
.text-color-preview-chip { width: 80rpx; height: 56rpx; flex-shrink: 0; border: 1rpx solid #E9ECEF; border-radius: 20rpx; }
.text-color-preview-text { color: #868E96; font-size: 24rpx; }
.text-color-actions { display: flex; gap: 16rpx; margin-top: 28rpx; }
.text-color-actions button { display: flex; align-items: center; justify-content: center; flex: 1; width: 0; min-width: 0; min-height: 80rpx; box-sizing: border-box; margin: 0; padding: 20rpx; border: 2rpx solid #E9ECEF; border-radius: 999rpx; font-size: 26rpx; line-height: 1.5; font-weight: 400; color: #212529; background: #F5F6F7; }
.text-color-actions button::after { border: 0; }
.text-color-actions .text-color-confirm { color: #FFFFFF; background: #212529; border-color: #212529; }
.text-color-actions .text-color-confirm[disabled] { opacity: .45; }
