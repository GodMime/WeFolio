@import "../../styles/team-portfolio-theme.wxss";

:host { display: block; width: 100%; min-width: 0; }
.list-component { width: 100%; padding: 0; color: #212529; overflow-wrap: anywhere; box-sizing: border-box; }
.list-component.editor-mode { padding: 0; }
.editor-form { display: flex; flex-direction: column; gap: 20rpx; padding: 4rpx 0 8rpx; }
.editor-field { padding: 28rpx; border: 1rpx solid #e9ecef; border-radius: 48rpx; background: #fff; box-sizing: border-box; }
.editor-field-heading { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; }
.editor-label { color: #6c757d; font-size: 24rpx; font-weight: 800; }
.editor-limit { color: #8b96a3; font-size: 22rpx; font-weight: 700; }
.editor-member-scroll { width: 100%; height: 56rpx; margin-top: 16rpx; white-space: nowrap; }
.editor-member-row { width: auto; min-width: 0; height: 56rpx; display: inline-flex; align-items: center; gap: 12rpx; }
.editor-member-choice { display: inline-flex; width: auto; min-width: 0; height: 56rpx; align-items: center; justify-content: center; flex: 0 0 auto; margin: 0; padding: 0 20rpx; color: #6c757d; font-size: 22rpx; font-weight: 800; line-height: 1; white-space: nowrap; border: 1rpx solid #dee2e6; border-radius: 999rpx; background: #fff; box-sizing: border-box; }
.editor-member-choice.active { color: #fff; border-color: #212529; background: #212529; }
.editor-content-field { min-height: 220rpx; }
.editor-switch-field { display: flex; align-items: center; justify-content: space-between; gap: 20rpx; }
.editor-switch-copy { min-width: 0; flex: 1 1 0; }
.editor-switch-desc { margin-top: 8rpx; color: #8b96a3; font-size: 22rpx; line-height: 1.5; }
.editor-option-list { display: flex; flex-direction: column; gap: 12rpx; margin-top: 16rpx; }
.editor-option { position: relative; width: 100%; min-height: 112rpx; display: flex; align-items: center; gap: 16rpx; margin: 0; padding: 12rpx 60rpx 12rpx 12rpx; overflow: hidden; text-align: left; border: 1rpx solid #e9ecef; border-radius: 28rpx; background: #f5f6f7; box-sizing: border-box; }
.editor-option.selected { border-color: #212529; background: #fff; }
.editor-option image { width: 116rpx; height: 88rpx; flex: none; border-radius: 12rpx; background: #eef3f7; }
.editor-option-copy { min-width: 0; flex: 1 1 0; padding: 0; }
.editor-option-title, .editor-option-meta { display: block; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.editor-option-title { color: #212529; font-size: 24rpx; font-weight: 900; }
.editor-option-meta { margin-top: 8rpx; color: #697786; font-size: 20rpx; }
.editor-option-order { position: absolute; right: 16rpx; width: 40rpx; height: 40rpx; display: flex; align-items: center; justify-content: center; color: #fff; font-size: 20rpx; font-weight: 900; border: 2rpx solid #212529; border-radius: 50%; background: #212529; box-sizing: border-box; }
.editor-option:not(.selected) .editor-option-order { color: transparent; border-color: #cbd6df; background: #fff; }
.editor-empty { min-height: 150rpx; display: flex; align-items: center; justify-content: center; color: #8a98a8; font-size: 22rpx; text-align: center; }
.editor-error { padding: 16rpx 18rpx; color: #b55656; font-size: 22rpx; border-radius: 28rpx; background: #fbefef; }
.editor-actions { display: flex; justify-content: flex-end; gap: 16rpx; margin-top: 20rpx; }
.editor-cancel, .editor-confirm { width: 148rpx; height: 64rpx; display: flex; align-items: center; justify-content: center; margin: 0; padding: 0; font-size: 24rpx; font-weight: 900; line-height: 1; border-radius: 999rpx; box-sizing: border-box; }
.editor-cancel { color: #536b82; border: 1rpx solid #cbd6df; background: #eef3f7; }
.editor-confirm { color: #fff; background: #212529; }
.portfolio-display { width: 100%; min-width: 0; }
.work-section-title { padding: 0 24rpx; color: #000; font-size: 34rpx; font-weight: 900; line-height: 1.35; box-sizing: border-box; }
.portfolio-list { width: 100%; display: flex; flex-direction: column; gap: 24rpx; padding: 22rpx 20rpx 0; box-sizing: border-box; }
.portfolio-options { display: flex; flex-direction: column; gap: 16rpx; }
.portfolio-card { width: 100%; min-width: 0; flex: 0 0 100%; margin: 0; padding: 0; color: #212529; border-radius: 0; background: transparent; overflow: hidden; text-align: left; line-height: normal; box-sizing: border-box; }
.portfolio-cover { display: block; width: 100%; border-radius: 40rpx; background: #f1f3f5; }
.portfolio-title, .portfolio-description, .member-name { display: block; overflow: hidden; text-overflow: ellipsis; }
.portfolio-title { margin-top: 10rpx; color: #212529; font-size: 24rpx; font-weight: 700; line-height: 1.35; white-space: nowrap; }
.portfolio-description { margin-top: 6rpx; color: #59636f; font-size: 26rpx; line-height: 1.75; white-space: pre-wrap; }
.member-name { margin-top: 6rpx; color: #8a8f98; font-size: 22rpx; line-height: 1.45; white-space: nowrap; }
.option { display: flex; align-items: center; gap: 18rpx; min-width: 0; padding: 0; border-radius: 6px; background: #fff; overflow: hidden; text-align: left; }
.option image { width: 220rpx; height: 164rpx; flex: none; background: #e8eeef; }
.option view { flex: 1 1 0; min-width: 0; padding: 18rpx 18rpx 18rpx 0; }
.empty { display: block; padding: 28rpx 0; text-align: center; color: #708087; }
