:host { display: block; }
.list-component { padding: 24rpx; color: #17202a; overflow-wrap: anywhere; }
.list-component.editor-mode { padding: 0; }
.editor-form { display: flex; flex-direction: column; gap: 20rpx; padding: 4rpx 0 8rpx; }
.editor-field { padding: 22rpx; border: 1rpx solid rgba(23, 32, 42, .06); border-radius: 16rpx; background: rgba(255, 255, 255, .94); box-sizing: border-box; }
.editor-field-heading { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; }
.editor-label { color: #5f6b7a; font-size: 24rpx; font-weight: 800; }
.editor-limit { color: #8b96a3; font-size: 22rpx; font-weight: 700; }
.editor-member-scroll { width: 100%; margin-top: 16rpx; white-space: nowrap; }
.editor-member-row { display: inline-flex; gap: 12rpx; }
.editor-member-choice { width: auto; height: 56rpx; flex: none; margin: 0; padding: 0 20rpx; color: #536b82; font-size: 22rpx; font-weight: 800; line-height: 56rpx; border: 1rpx solid #d4dee8; border-radius: 999rpx; background: #fff; box-sizing: border-box; }
.editor-member-choice.active { color: #fff; border-color: #17202a; background: #17202a; }
.editor-content-field { min-height: 220rpx; }
.editor-option-list { display: flex; flex-direction: column; gap: 12rpx; margin-top: 16rpx; }
.editor-option { position: relative; width: 100%; min-height: 112rpx; display: flex; align-items: center; gap: 16rpx; margin: 0; padding: 12rpx 60rpx 12rpx 12rpx; overflow: hidden; text-align: left; border: 1rpx solid #d9e2eb; border-radius: 14rpx; background: #f8fafc; box-sizing: border-box; }
.editor-option.selected { border-color: #17202a; background: #fff; }
.editor-option image { width: 116rpx; height: 88rpx; flex: none; border-radius: 12rpx; background: #eef3f7; }
.editor-option-copy { min-width: 0; flex: 1 1 0; padding: 0; }
.editor-option-title, .editor-option-meta { display: block; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.editor-option-title { color: #17202a; font-size: 24rpx; font-weight: 900; }
.editor-option-meta { margin-top: 8rpx; color: #697786; font-size: 20rpx; }
.editor-option-order { position: absolute; right: 16rpx; width: 40rpx; height: 40rpx; display: flex; align-items: center; justify-content: center; color: #fff; font-size: 20rpx; font-weight: 900; border: 2rpx solid #17202a; border-radius: 50%; background: #17202a; box-sizing: border-box; }
.editor-option:not(.selected) .editor-option-order { color: transparent; border-color: #cbd6df; background: #fff; }
.editor-empty { min-height: 150rpx; display: flex; align-items: center; justify-content: center; color: #8a98a8; font-size: 22rpx; text-align: center; }
.editor-error { padding: 16rpx 18rpx; color: #a9354f; font-size: 22rpx; border-radius: 14rpx; background: #fff1f2; }
.editor-actions { display: flex; justify-content: flex-end; gap: 16rpx; margin-top: 20rpx; }
.editor-cancel, .editor-confirm { width: 148rpx; height: 64rpx; display: flex; align-items: center; justify-content: center; margin: 0; padding: 0; font-size: 24rpx; font-weight: 900; line-height: 1; border-radius: 999rpx; box-sizing: border-box; }
.editor-cancel { color: #536b82; border: 1rpx solid #cbd6df; background: #eef3f7; }
.editor-confirm { color: #fff; background: #17202a; }
.portfolio-list, .portfolio-options { display: flex; flex-direction: column; gap: 16rpx; }
.portfolio-row, .option { display: grid; grid-template-columns: 220rpx minmax(0, 1fr); gap: 18rpx; min-width: 0; padding: 0; border-radius: 6px; background: #fff; overflow: hidden; text-align: left; }
.portfolio-row image, .option image { width: 220rpx; height: 164rpx; background: #e8eeef; }
.meta, .option view { min-width: 0; padding: 18rpx 18rpx 18rpx 0; }
.title, .description, .member-name { display: block; overflow: hidden; text-overflow: ellipsis; }
.title { font-weight: 600; white-space: nowrap; }
.description { margin-top: 10rpx; color: #5e6b73; font-size: 24rpx; line-height: 1.5; }
.member-name { margin-top: 10rpx; color: #0f766e; font-size: 22rpx; white-space: nowrap; }
.empty { display: block; padding: 28rpx 0; text-align: center; color: #708087; }
