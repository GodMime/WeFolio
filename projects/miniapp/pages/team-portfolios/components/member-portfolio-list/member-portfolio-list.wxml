<view class="list-component">
  <block wx:if="{{editMode}}">
    <scroll-view class="member-strip" scroll-x><button wx:for="{{members}}" wx:key="memberUserId" class="member {{selectedMemberId === item.memberUserId ? 'active' : ''}}" data-id="{{item.memberUserId}}" bindtap="selectMember">{{item.displayName}}</button></scroll-view>
    <text wx:if="{{!sourceAvailable}}" class="empty">成员授权已关闭，原引用已移除</text>
    <view wx:elif="{{selectedMemberId && portfolios.length}}" class="portfolio-options"><button wx:for="{{portfolios}}" wx:key="portfolioId" class="option" data-item="{{item}}" bindtap="togglePortfolio"><image src="{{item.coverUrl}}" mode="aspectFill" /><view><text class="title">{{item.title}}</text><text class="description">已发布版本 {{item.publishedRevision}}</text></view></button></view>
    <text wx:elif="{{selectedMemberId}}" class="empty">该成员暂无已发布个人作品集</text>
    <text wx:else class="empty">请先选择团队成员</text>
    <text wx:if="{{errorMessage}}" class="error">{{errorMessage}}</text>
    <view class="actions"><button bindtap="cancelEdit">取消</button><button class="primary" bindtap="saveEdit">确认</button></view>
  </block>
  <view wx:else class="portfolio-list"><button wx:for="{{items}}" wx:key="portfolioId" class="portfolio-row" data-id="{{item.portfolioId}}" data-share-code="{{item.shareCode}}" bindtap="previewPortfolio"><image src="{{item.coverUrl}}" mode="aspectFill" /><view class="meta"><text class="title">{{item.title}}</text><text class="description">{{item.description}}</text><text class="member-name">{{item.memberDisplayName}}</text></view></button></view>
</view>
