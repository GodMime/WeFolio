:host { display: block; }
.qr-contact { padding: 28rpx 24rpx; color: #17202a; text-align: center; overflow-wrap: anywhere; }
.qr-contact.editor-mode { padding: 0; }
.editor-form { display: flex; flex-direction: column; gap: 20rpx; padding: 4rpx 0 8rpx; text-align: left; }
.editor-field { padding: 22rpx; border: 1rpx solid rgba(23, 32, 42, .06); border-radius: 16rpx; background: rgba(255, 255, 255, .94); }
.editor-label { color: #5f6b7a; font-size: 24rpx; font-weight: 800; }
.editor-input { width: 100%; min-height: 84rpx; margin-top: 12rpx; padding: 0 22rpx; color: #17202a; font-size: 28rpx; line-height: 84rpx; border-radius: 16rpx; background: #f6f8fb; box-sizing: border-box; }
.editor-textarea { height: 160rpx; padding-top: 20rpx; padding-bottom: 20rpx; line-height: 1.55; }
.editor-qr-row { display: flex; align-items: center; gap: 18rpx; margin-top: 14rpx; }
.editor-qr-preview { width: 160rpx; height: 160rpx; flex: none; overflow: hidden; border: 1rpx solid #dbe5ef; border-radius: 16rpx; background: #f6f8fb; box-sizing: border-box; }
.editor-qr-preview image { width: 100%; height: 100%; }
.editor-qr-empty { width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; color: #8a98a8; font-size: 22rpx; font-weight: 800; }
.editor-qr-copy { min-width: 0; flex: 1 1 0; }
.editor-qr-state { color: #8b96a3; font-size: 22rpx; font-weight: 700; }
.editor-assist { min-width: 144rpx; height: 56rpx; flex: none; margin: 0; padding: 0 18rpx; color: #2d5f9a; font-size: 22rpx; font-weight: 900; line-height: 56rpx; border: 1rpx solid #cbd7e3; border-radius: 999rpx; background: #edf5fb; box-sizing: border-box; }
.editor-error { padding: 16rpx 18rpx; color: #a9354f; font-size: 22rpx; border-radius: 14rpx; background: #fff1f2; }
.editor-actions { display: flex; justify-content: flex-end; gap: 16rpx; margin-top: 20rpx; }
.editor-cancel, .editor-confirm { width: 148rpx; height: 64rpx; display: flex; align-items: center; justify-content: center; margin: 0; padding: 0; font-size: 24rpx; font-weight: 900; line-height: 1; border-radius: 999rpx; box-sizing: border-box; }
.editor-cancel { color: #536b82; border: 1rpx solid #cbd6df; background: #eef3f7; }
.editor-confirm { color: #fff; background: #17202a; }
.title { display: block; margin-bottom: 20rpx; font-weight: 600; }
.description { display: block; margin-bottom: 20rpx; color: #5e6b73; line-height: 1.6; white-space: pre-wrap; }
.qr-image { width: min(520rpx, 100%); height: 520rpx; margin: 0 auto; border-radius: 8px; background: #fff; }
.empty { display: block; padding: 60rpx 0; color: #708087; word-break: break-word; }
