:host { display: block; }
.qr-contact { padding: 28rpx 24rpx; color: #17202a; text-align: center; overflow-wrap: anywhere; }
.title { display: block; margin-bottom: 20rpx; font-weight: 600; }
.description { display: block; margin-bottom: 20rpx; color: #5e6b73; line-height: 1.6; white-space: pre-wrap; }
.field { box-sizing: border-box; width: 100%; margin-bottom: 16rpx; padding: 18rpx; border: 1rpx solid #d7dfe1; border-radius: 6px; text-align: left; }
.description-input { min-height: 140rpx; }
.qr-image { width: min(520rpx, 100%); height: 520rpx; margin: 0 auto; border-radius: 8px; background: #fff; }
.choose-button { margin-top: 20rpx; border-radius: 6px; color: #0f766e; }
.actions { display: flex; gap: 20rpx; margin-top: 24rpx; }
.actions button { flex: 1; border-radius: 6px; }
.primary { background: #0f766e; color: #fff; }
.error { display: block; margin-top: 16rpx; color: #b42318; }
.empty { display: block; padding: 60rpx 0; color: #708087; word-break: break-word; }
