@import "../../styles/team-portfolio-theme.wxss";

:host { display: block; }
.qr-contact { padding: 28rpx 24rpx; color: #212529; text-align: center; overflow-wrap: anywhere; }
.qr-contact.editor-mode { padding: 0; }
.editor-form { display: flex; flex-direction: column; gap: 20rpx; padding: 4rpx 0 8rpx; text-align: left; }
.editor-field { padding: 28rpx; border: 1rpx solid #e9ecef; border-radius: 48rpx; background: #fff; }
.editor-label { color: #6c757d; font-size: 24rpx; font-weight: 800; }
.editor-qr-row { display: flex; align-items: center; gap: 18rpx; margin-top: 14rpx; }
.editor-qr-preview { width: 160rpx; height: 160rpx; flex: none; overflow: hidden; border: 1rpx solid #e9ecef; border-radius: 40rpx; background: #f5f6f7; box-sizing: border-box; }
.editor-qr-preview image { width: 100%; height: 100%; }
.editor-qr-empty { width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; color: #8a98a8; font-size: 22rpx; font-weight: 800; }
.editor-qr-copy { min-width: 0; flex: 1 1 0; }
.editor-qr-state { color: #8b96a3; font-size: 22rpx; font-weight: 700; }
.editor-assist { min-width: 144rpx; height: 56rpx; flex: none; margin: 0; padding: 0 18rpx; color: #212529; font-size: 22rpx; font-weight: 900; line-height: 56rpx; border: 1rpx solid #dee2e6; border-radius: 999rpx; background: #f5f6f7; box-sizing: border-box; }
.editor-error { padding: 16rpx 18rpx; color: #b55656; font-size: 22rpx; border-radius: 28rpx; background: #fbefef; }
.editor-actions { display: flex; justify-content: flex-end; gap: 16rpx; margin-top: 20rpx; }
.editor-cancel, .editor-confirm { width: 148rpx; height: 64rpx; display: flex; align-items: center; justify-content: center; margin: 0; padding: 0; font-size: 24rpx; font-weight: 900; line-height: 1; border-radius: 999rpx; box-sizing: border-box; }
.editor-cancel { color: #536b82; border: 1rpx solid #cbd6df; background: #eef3f7; }
.editor-confirm { color: #fff; background: #212529; }
.qr-image { display: block; width: 280rpx; height: 280rpx; margin: 24rpx auto 0; border-radius: 40rpx; background: #fff; }
.empty { display: block; padding: 60rpx 0; color: #708087; word-break: break-word; }
