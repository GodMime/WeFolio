<view class="structured-text {{background.enabled ? 'has-background' : ''}}" style="{{frameStyle}}">
  <video wx:if="{{background.videoUrl && !backgroundVideoFailed}}" id="textBackgroundVideo" class="text-background-video"
    src="{{background.videoUrl}}" data-src="{{background.videoUrl}}" poster="{{background.posterUrl}}"
    autoplay="{{backgroundVideoVisible}}" loop="{{true}}" muted="{{true}}" controls="{{false}}"
    show-center-play-btn="{{false}}" show-play-btn="{{false}}" show-fullscreen-btn="{{false}}"
    enable-progress-gesture="{{false}}" enable-play-gesture="{{false}}" object-fit="cover"
    bindloadedmetadata="handleBackgroundLoad" bindplay="handleBackgroundVideoPlay" bindtimeupdate="handleBackgroundVideoTimeUpdate" binderror="handleBackgroundVideoError" aria-hidden="true" />
  <image wx:if="{{background.videoUrl && background.posterUrl && (!backgroundVideoStarted || backgroundVideoFailed)}}" class="text-background-poster" src="{{background.posterUrl}}" mode="aspectFill" aria-hidden="true" />
  <image wx:if="{{background.enabled && background.imageUrl && !imageFailed}}" class="text-background-image" src="{{background.imageUrl}}" data-src="{{background.imageUrl}}" mode="aspectFill" webp="{{true}}" binderror="handleBackgroundError" bindload="handleBackgroundLoad" aria-hidden="true"></image>
  <view wx:if="{{background.enabled}}" class="text-background-mask {{background.treatmentClass}}" aria-hidden="true"></view>
  <view class="structured-content">
    <view wx:for="{{blocks}}" wx:key="blockKey" class="structured-block {{item.fontClass}}" style="{{item.style}}">
      <block wx:if="{{item.type === 'SPACER'}}"></block>
      <view wx:elif="{{item.type === 'LIST'}}" class="structured-list">
        <text wx:for="{{item.listItems}}" wx:for-item="line" wx:key="key" class="structured-line-text" style="color:{{item.displayColor}};{{item.lineHeightStyle}}" space="nbsp">· {{line.content}}</text>
      </view>
      <text wx:else class="structured-line-text" style="color:{{item.displayColor}};{{item.lineHeightStyle}}" space="nbsp">{{item.content}}</text>
    </view>
    <view wx:if="{{showRepairHint || (repairMode && backgroundVideoFailed)}}" class="text-background-repair">背景作品不可用，请重新选择或关闭背景</view>
  </view>
</view>
