@import "../../../../styles/portfolio-text-typography.wxss";

:host { display: block; }
.structured-text { position: relative; width: 100%; padding: 32rpx; box-sizing: border-box; }
.has-background { background: #212529; }
.text-background-image, .text-background-video, .text-background-poster, .text-background-mask { position: absolute; top: 0; left: 0; width: 100%; height: 100%; }
/* 遮罩只作用于独立媒体层，不降低文字不透明度。 */
.text-background--dark-mask { background: rgba(0, 0, 0, 0.4); }
.text-background--gradient { background: linear-gradient(to bottom, rgba(0, 0, 0, 0.12) 0%, rgba(0, 0, 0, 0.4) 50%, rgba(0, 0, 0, 0.88) 100%); }
.structured-content { position: relative; z-index: 1; display: flex; flex-direction: column; min-width: 0; }
/* flex 子项的上下 margin 不折叠，留白仅使用自己的高度。 */
.structured-block { flex-shrink: 0; min-width: 0; }
.structured-line-text { display: block; white-space: pre-wrap; overflow-wrap: anywhere; word-break: break-word; line-height: 1.6; }
.text-background-repair { margin-top: 16rpx; padding: 16rpx; background: rgba(0, 0, 0, 0.6); color: #F8F9FA; font-size: 24rpx; line-height: 1.5; border-radius: 8rpx; }

/* 视频只承载背景，滚动和点击交给文字与页面。 */
.text-background-video, .text-background-poster { z-index: 0; pointer-events: none; }
.text-background-mask { pointer-events: none; }
