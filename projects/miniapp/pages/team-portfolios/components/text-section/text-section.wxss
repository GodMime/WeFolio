@import "../../../../styles/portfolio-text-typography.wxss";
@import "../../styles/team-portfolio-theme.wxss";

:host { display: block; }
.text-section { padding: 28rpx 24rpx; color: #212529; overflow-wrap: anywhere; }
.align-LEFT { text-align: left; }
.align-CENTER { text-align: center; }
.align-RIGHT { text-align: right; }
.content { display: block; line-height: 1.75; white-space: pre-wrap; word-break: break-word; }
.text-section.has-background { position: relative; box-sizing: border-box; width: 100%; display: flex; flex-direction: column; color: #F8F9FA; background: #212529; }
.has-background .content { position: relative; z-index: 1; width: 100%; flex-shrink: 0; color: #F8F9FA; }
.vertical-TOP { justify-content: flex-start; }
.vertical-CENTER { justify-content: center; }
.vertical-BOTTOM { justify-content: flex-end; }
.text-background-image, .text-background-mask { position: absolute; top: 0; left: 0; width: 100%; height: 100%; }
.text-background--dark-mask .text-background-mask { background: rgba(0, 0, 0, 0.4); }
.text-background--gradient .text-background-mask { background: linear-gradient(to bottom, rgba(0, 0, 0, 0.12) 0%, rgba(0, 0, 0, 0.4) 50%, rgba(0, 0, 0, 0.88) 100%); }
.text-background-repair { position: relative; z-index: 1; color: #F8F9FA; font-size: 24rpx; margin-top: 16rpx; }
