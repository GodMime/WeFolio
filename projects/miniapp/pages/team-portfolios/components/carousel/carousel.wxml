<wxs module="selection" src="../editor-selection.wxs"></wxs>

<view class="carousel {{editMode ? 'editor-mode' : ''}}">
  <block wx:if="{{editMode}}">
    <view class="editor-form">
      <view class="editor-field">
        <view class="editor-field-heading"><view class="editor-label">选择团队成员</view><view class="editor-limit">已选 {{draftItems.length}} / 9</view></view>
        <scroll-view class="editor-member-scroll" scroll-x type="list"><view class="editor-member-row"><button wx:for="{{members}}" wx:key="memberUserId" class="editor-member-choice {{selectedMemberId === item.memberUserId ? 'active' : ''}}" data-id="{{item.memberUserId}}" bindtap="selectMember">{{item.displayName}}</button></view></scroll-view>
      </view>
      <view class="editor-field editor-content-field">
        <view class="editor-label">图片作品</view>
        <view wx:if="{{selectedMemberId && works.length}}" class="editor-option-grid">
          <button wx:for="{{works}}" wx:key="workId" class="editor-option {{selection.order(draftItems, 'workId', item.workId) ? 'selected' : ''}}" data-item="{{item}}" bindtap="toggleWork">
            <image src="{{item.coverUrl || item.mediaUrl}}" mode="aspectFill" />
            <view class="editor-option-copy"><text class="editor-option-title">{{item.title}}</text></view>
            <view class="editor-option-order">{{selection.order(draftItems, 'workId', item.workId) || ''}}</view>
          </button>
        </view>
        <view wx:elif="{{selectedMemberId}}" class="editor-empty">该成员暂无审核通过的图片作品</view>
        <view wx:else class="editor-empty">请先选择团队成员</view>
      </view>
      <view wx:if="{{errorMessage}}" class="editor-error">{{errorMessage}}</view>
    </view>
    <view class="editor-actions"><button class="editor-cancel" bindtap="cancelEdit">取消</button><button class="editor-confirm" bindtap="saveEdit">完成</button></view>
  </block>
  <block wx:else>
    <swiper wx:if="{{items.length}}" class="swiper" style="aspect-ratio: {{frameAspectRatio}};" current="{{current}}" interval="{{interval}}" autoplay="{{autoplay}}" circular="{{circular}}" bindchange="handleChange">
      <swiper-item wx:for="{{items}}" wx:key="workId"><image class="slide" src="{{item.mediaUrl || item.coverUrl}}" mode="aspectFit" data-item="{{item}}" data-index="{{index}}" bindtap="previewItem" /></swiper-item>
    </swiper>
    <text wx:else class="empty">暂无轮播图片</text>
    <text wx:if="{{items.length > 1}}" class="progress">{{current + 1}} / {{items.length}}</text>
  </block>
</view>
