:host { display: block; }
.carousel { position: relative; padding: 24rpx 0; color: #17202a; overflow-wrap: anywhere; }
.swiper { width: 100%; overflow: hidden; background: #e8eeef; transition: aspect-ratio .2s ease; }
.slide { width: 100%; height: 100%; }
.progress { position: absolute; right: 20rpx; bottom: 40rpx; padding: 6rpx 12rpx; border-radius: 6px; background: rgba(23, 32, 42, .72); color: #fff; font-size: 22rpx; }
.member-strip { box-sizing: border-box; width: 100%; padding: 0 24rpx; white-space: nowrap; }
.member { display: inline-block; width: auto; margin-right: 12rpx; border-radius: 6px; background: #eef2f2; font-size: 26rpx; }
.member.active { background: #0f766e; color: #fff; }
.work-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12rpx; padding: 20rpx 24rpx; }
.work-option { min-width: 0; padding: 0; border-radius: 6px; background: #fff; font-size: 22rpx; overflow: hidden; }
.work-option image { width: 100%; aspect-ratio: 1; }
.work-option text { display: block; padding: 8rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.actions { display: flex; gap: 20rpx; padding: 20rpx 24rpx 0; }
.actions button { flex: 1; border-radius: 6px; }
.primary { background: #0f766e; color: #fff; }
.empty, .error { display: block; padding: 28rpx; text-align: center; color: #708087; }
.error { color: #b42318; }
