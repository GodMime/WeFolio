:host { display: block; }
.grid-component { padding: 24rpx; color: #17202a; overflow-wrap: anywhere; }
.grid-component.editor-mode { padding: 0; }
.editor-form { display: flex; flex-direction: column; gap: 20rpx; padding: 4rpx 0 8rpx; }
.editor-field { padding: 22rpx; border: 1rpx solid rgba(23, 32, 42, .06); border-radius: 16rpx; background: rgba(255, 255, 255, .94); box-sizing: border-box; }
.editor-field-heading { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; }
.editor-label { color: #5f6b7a; font-size: 24rpx; font-weight: 800; }
.editor-limit { color: #8b96a3; font-size: 22rpx; font-weight: 700; }
.editor-member-scroll { width: 100%; margin-top: 16rpx; white-space: nowrap; }
.editor-member-row { display: inline-flex; gap: 12rpx; }
.editor-member-choice { width: auto; height: 56rpx; flex: none; margin: 0; padding: 0 20rpx; color: #536b82; font-size: 22rpx; font-weight: 800; line-height: 56rpx; border: 1rpx solid #d4dee8; border-radius: 999rpx; background: #fff; box-sizing: border-box; }
.editor-member-choice.active { color: #fff; border-color: #17202a; background: #17202a; }
.editor-content-field { min-height: 220rpx; }
.editor-option-grid { display: flex; flex-wrap: wrap; gap: 14rpx; margin-top: 16rpx; }
.editor-option { position: relative; width: calc(50% - 7rpx); min-width: 0; margin: 0; padding: 0; overflow: hidden; text-align: left; border: 1rpx solid #d9e2eb; border-radius: 14rpx; background: #f8fafc; box-sizing: border-box; }
.editor-option.selected { border-color: #17202a; background: #fff; box-shadow: 0 8rpx 18rpx rgba(23, 32, 42, .12); }
.editor-option image { width: 100%; height: 150rpx; display: block; background: #eef3f7; }
.editor-option-copy { min-width: 0; padding: 12rpx; }
.editor-option-title { display: block; overflow: hidden; color: #17202a; font-size: 22rpx; font-weight: 900; text-overflow: ellipsis; white-space: nowrap; }
.editor-option-order { position: absolute; top: 8rpx; right: 8rpx; width: 38rpx; height: 38rpx; display: flex; align-items: center; justify-content: center; color: #fff; font-size: 20rpx; font-weight: 900; border: 2rpx solid rgba(255, 255, 255, .9); border-radius: 50%; background: rgba(23, 32, 42, .78); box-sizing: border-box; }
.editor-option:not(.selected) .editor-option-order { color: transparent; background: rgba(255, 255, 255, .9); border-color: #cbd6df; }
.editor-empty { min-height: 150rpx; display: flex; align-items: center; justify-content: center; color: #8a98a8; font-size: 22rpx; text-align: center; }
.editor-error { padding: 16rpx 18rpx; color: #a9354f; font-size: 22rpx; border-radius: 14rpx; background: #fff1f2; }
.editor-actions { display: flex; justify-content: flex-end; gap: 16rpx; margin-top: 20rpx; }
.editor-cancel, .editor-confirm { width: 148rpx; height: 64rpx; display: flex; align-items: center; justify-content: center; margin: 0; padding: 0; font-size: 24rpx; font-weight: 900; line-height: 1; border-radius: 999rpx; box-sizing: border-box; }
.editor-cancel { color: #536b82; border: 1rpx solid #cbd6df; background: #eef3f7; }
.editor-confirm { color: #fff; background: #17202a; }
.portfolio-grid, .portfolio-options { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16rpx; }
.portfolio-card, .option { min-width: 0; padding: 0; border-radius: 6px; background: #fff; overflow: hidden; text-align: left; }
.portfolio-card image, .option image { width: 100%; aspect-ratio: 4 / 3; background: #e8eeef; }
.title, .member-name, .option text { display: block; padding: 12rpx 14rpx 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.member-name { padding-top: 4rpx; padding-bottom: 14rpx; color: #708087; font-size: 22rpx; }
.empty { display: block; padding: 28rpx 0; text-align: center; color: #708087; }
