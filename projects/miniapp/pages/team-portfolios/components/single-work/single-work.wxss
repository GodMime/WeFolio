@import "../../styles/team-portfolio-theme.wxss";

:host { display: block; }
.single-work { width: 100%; color: #212529; overflow-wrap: anywhere; }
.single-work.editor-mode { overflow: visible; }
.editor-form { display: flex; flex-direction: column; gap: 20rpx; padding: 4rpx 0 8rpx; }
.editor-field { padding: 28rpx; border: 1rpx solid #e9ecef; border-radius: 48rpx; background: #fff; box-sizing: border-box; }
.editor-label { color: #6c757d; font-size: 24rpx; font-weight: 800; }
.editor-member-scroll { width: 100%; height: 56rpx; margin-top: 16rpx; white-space: nowrap; }
.editor-member-row { width: auto; min-width: 0; height: 56rpx; display: inline-flex; align-items: center; gap: 12rpx; }
.editor-member-choice { display: inline-flex; width: auto; min-width: 0; height: 56rpx; align-items: center; justify-content: center; flex: 0 0 auto; margin: 0; padding: 0 18rpx; color: #6c757d; font-size: 22rpx; font-weight: 800; line-height: 1; white-space: nowrap; border: 1rpx solid #dee2e6; border-radius: 999rpx; background: #fff; box-sizing: border-box; }
.editor-member-choice.active { color: #fff; border-color: #212529; background: #212529; }
.editor-content-field { min-height: 220rpx; }
.editor-current-work { min-height: 154rpx; margin-bottom: 22rpx; padding: 18rpx 20rpx; border: 1rpx solid #dee2e6; border-radius: 32rpx; background: #fff; box-sizing: border-box; }
.editor-current-work.empty { min-height: 112rpx; }
.editor-current-label { margin-bottom: 12rpx; color: #adb5bd; font-size: 20rpx; font-weight: 800; line-height: 1; }
.editor-current-content { min-width: 0; display: flex; align-items: center; gap: 18rpx; }
.editor-current-thumb { width: 104rpx; height: 104rpx; flex: none; overflow: hidden; border-radius: 26rpx; background: #eef3f7; }
.editor-current-thumb image, .editor-current-placeholder { width: 100%; height: 100%; }
.editor-current-placeholder { display: flex; align-items: center; justify-content: center; color: #8a98a8; font-size: 20rpx; }
.editor-current-copy { min-width: 0; flex: 1; }
.editor-current-title, .editor-current-meta { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.editor-current-title { font-size: 26rpx; font-weight: 900; }
.editor-current-meta, .editor-current-empty { color: #8a98a8; font-size: 21rpx; line-height: 1.4; }
.editor-current-meta { margin-top: 8rpx; }
.editor-work-scroll { width: 100%; height: 286rpx; margin-top: 16rpx; white-space: nowrap; }
.editor-option-row { width: max-content; min-width: 100%; min-height: 262rpx; display: flex; align-items: stretch; gap: 12rpx; padding-right: 48rpx; box-sizing: border-box; }
.editor-option { position: relative; width: 248rpx; min-height: 246rpx; flex: 0 0 248rpx; padding: 10rpx; border: 2rpx solid #e9ecef; border-radius: 30rpx; background: #fff; box-sizing: border-box; }
.editor-option.selected { border-color: #212529; }
.editor-option-thumb { position: relative; width: 100%; height: 148rpx; overflow: hidden; border-radius: 22rpx; background: #eef3f7; }
.editor-option-thumb image, .editor-option-placeholder { width: 100%; height: 100%; }
.editor-option-placeholder { display: flex; align-items: center; justify-content: center; color: #8a98a8; font-size: 20rpx; }
.editor-option-title, .editor-option-meta { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.editor-option-title { margin-top: 10rpx; font-size: 24rpx; font-weight: 900; line-height: 1.3; }
.editor-option-meta { margin-top: 6rpx; color: #697786; font-size: 20rpx; line-height: 1.3; }
.editor-option-radio { position: absolute; top: 12rpx; right: 12rpx; width: 32rpx; height: 32rpx; display: flex; align-items: center; justify-content: center; border: 2rpx solid #dee2e6; border-radius: 50%; background: #fff; box-sizing: border-box; }
.editor-option-radio.selected { border-color: #212529; }
.editor-option-radio-dot { width: 10rpx; height: 10rpx; border-radius: 50%; background: #212529; }
.editor-work-tail { width: 152rpx; min-height: 246rpx; flex: 0 0 152rpx; display: flex; align-items: center; justify-content: center; padding: 0 16rpx; color: #8a98a8; font-size: 20rpx; font-weight: 700; line-height: 1.4; text-align: center; white-space: normal; box-sizing: border-box; }
.editor-work-tail-retry { color: #212529; }
.editor-empty { min-height: 150rpx; display: flex; align-items: center; justify-content: center; color: #8a98a8; font-size: 22rpx; }
.editor-switch-row { min-height: 88rpx; display: flex; align-items: center; justify-content: space-between; gap: 24rpx; padding: 14rpx 6rpx; border-top: 1rpx solid #edf1f5; }
.editor-switch-label { font-size: 26rpx; font-weight: 900; }
.editor-switch-note { color: #8a98a8; font-size: 21rpx; }
.editor-error { padding: 16rpx 18rpx; color: #b55656; font-size: 22rpx; border-radius: 28rpx; background: #fbefef; }
.single-work-image, .single-work-video, .single-work-video-poster { width: 100%; display: block; overflow: hidden; border-radius: 40rpx; }
.single-work-image { background: transparent; }
.single-work-video, .single-work-video-poster { height: 399rpx; background: #000; }
.single-work-video-poster { position: relative; overflow: hidden; }
.single-work-video-cover { width: 100%; height: 100%; display: block; }
.single-work-play { position: absolute; right: 20rpx; bottom: 20rpx; width: 58rpx; height: 58rpx; display: flex; align-items: center; justify-content: center; color: #fff; border-radius: 50%; background: rgba(0, 0, 0, .56); }
.single-work-empty { min-height: 220rpx; display: flex; align-items: center; justify-content: center; color: #8a98a8; background: #f3f4f6; }
.single-work-copy { min-height: 16rpx; padding-top: 16rpx; box-sizing: border-box; }
.single-work-title { color: #212529; font-size: 28rpx; font-weight: 800; line-height: 1.45; }
.single-work-description { color: #59636f; font-size: 26rpx; line-height: 1.75; white-space: pre-wrap; overflow-wrap: break-word; word-break: break-word; }
