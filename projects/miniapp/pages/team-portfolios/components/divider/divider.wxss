@import "../../styles/team-portfolio-theme.wxss";

:host { display: block; }
.divider-component { box-sizing: border-box; width: calc(100% + 56rpx); margin-left: -28rpx; padding: 16rpx 0; color: #212529; overflow-wrap: anywhere; }
.divider-component.editor-mode { width: 100%; margin-left: 0; padding: 0; }
.editor-form { display: flex; flex-direction: column; gap: 22rpx; padding: 4rpx 0 8rpx; }
.editor-field { padding: 28rpx; border: 1rpx solid #e9ecef; border-radius: 48rpx; background: #fff; }
.editor-label { color: #6c757d; font-size: 24rpx; font-weight: 800; }
.editor-choice-row { display: flex; gap: 12rpx; margin-top: 16rpx; }
.editor-choice { min-width: 0; min-height: 88rpx; flex: 1 1 0; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 8rpx; margin: 0; padding: 12rpx 8rpx; border: 1rpx solid #e9ecef; border-radius: 28rpx; background: #f5f6f7; box-sizing: border-box; }
.editor-choice.active { border-color: #212529; background: #fff; }
.editor-swatch { width: 42rpx; height: 24rpx; border: 1rpx solid #cbd7e3; border-radius: 6rpx; box-sizing: border-box; }
.editor-choice-label { color: #212529; font-size: 22rpx; font-weight: 800; }
.editor-input { width: 100%; height: 84rpx; margin-top: 12rpx; padding: 0 22rpx; color: #212529; font-size: 28rpx; line-height: 84rpx; border: 1rpx solid #e9ecef; border-radius: 24rpx; background: #f5f6f7; box-sizing: border-box; }
.editor-error { padding: 16rpx 18rpx; color: #b55656; font-size: 22rpx; border-radius: 28rpx; background: #fbefef; }
.editor-actions { display: flex; justify-content: flex-end; gap: 16rpx; margin-top: 20rpx; }
.editor-cancel, .editor-confirm { width: 148rpx; height: 64rpx; display: flex; align-items: center; justify-content: center; margin: 0; padding: 0; font-size: 24rpx; font-weight: 900; line-height: 1; border-radius: 999rpx; box-sizing: border-box; }
.editor-cancel { color: #536b82; border: 1rpx solid #cbd6df; background: #eef3f7; }
.editor-confirm { color: #fff; background: #212529; }
.line { width: 100%; }
