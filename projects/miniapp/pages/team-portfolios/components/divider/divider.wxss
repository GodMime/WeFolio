:host { display: block; }
.divider-component { box-sizing: border-box; width: 100%; padding: 16rpx 24rpx; color: #17202a; overflow-wrap: anywhere; }
.line { width: 100%; }
.color-row { display: flex; gap: 20rpx; }
.swatch { width: 64rpx; height: 64rpx; padding: 0; border: 1rpx solid #b9c3c7; border-radius: 6px; }
.swatch.active { border: 4rpx solid #0f766e; }
.height-field { display: flex; align-items: center; justify-content: space-between; margin-top: 24rpx; }
.height-field input { width: 180rpx; padding: 12rpx; border: 1rpx solid #d7dfe1; border-radius: 6px; text-align: right; }
.actions { display: flex; gap: 20rpx; margin-top: 24rpx; }
.actions button { flex: 1; border-radius: 6px; }
.primary { background: #0f766e; color: #fff; }
.error { display: block; margin-top: 16rpx; color: #b42318; }
