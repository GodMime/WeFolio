:host { display: block; }
.divider-component { box-sizing: border-box; width: 100%; padding: 16rpx 24rpx; color: #17202a; overflow-wrap: anywhere; }
.divider-component.editor-mode { padding: 0; }
.editor-form { display: flex; flex-direction: column; gap: 22rpx; padding: 4rpx 0 8rpx; }
.editor-field { padding: 22rpx; border: 1rpx solid rgba(23, 32, 42, .06); border-radius: 16rpx; background: rgba(255, 255, 255, .94); }
.editor-label { color: #5f6b7a; font-size: 24rpx; font-weight: 800; }
.editor-choice-row { display: flex; gap: 12rpx; margin-top: 16rpx; }
.editor-choice { min-width: 0; min-height: 88rpx; flex: 1 1 0; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 8rpx; margin: 0; padding: 12rpx 8rpx; border: 1rpx solid #e1e8ef; border-radius: 14rpx; background: #f8fafc; box-sizing: border-box; }
.editor-choice.active { border-color: #2d5f9a; background: #edf5fb; }
.editor-swatch { width: 42rpx; height: 24rpx; border: 1rpx solid #cbd7e3; border-radius: 6rpx; box-sizing: border-box; }
.editor-choice-label { color: #17202a; font-size: 22rpx; font-weight: 800; }
.editor-input { width: 100%; height: 84rpx; margin-top: 12rpx; padding: 0 22rpx; color: #17202a; font-size: 28rpx; line-height: 84rpx; border-radius: 16rpx; background: #f6f8fb; box-sizing: border-box; }
.editor-error { padding: 16rpx 18rpx; color: #a9354f; font-size: 22rpx; border-radius: 14rpx; background: #fff1f2; }
.editor-actions { display: flex; justify-content: flex-end; gap: 16rpx; margin-top: 20rpx; }
.editor-cancel, .editor-confirm { width: 148rpx; height: 64rpx; display: flex; align-items: center; justify-content: center; margin: 0; padding: 0; font-size: 24rpx; font-weight: 900; line-height: 1; border-radius: 999rpx; box-sizing: border-box; }
.editor-cancel { color: #536b82; border: 1rpx solid #cbd6df; background: #eef3f7; }
.editor-confirm { color: #fff; background: #17202a; }
.line { width: 100%; }
