.page-shell{height:100vh;background:#fff;color:#17202a}.preview-toolbar{display:flex;align-items:center;gap:16rpx;padding:20rpx 24rpx;border-bottom:1rpx solid #eef1f4;box-sizing:border-box}.preview-note{flex:1;min-width:0;color:#7a8490;font-size:22rpx;line-height:1.4;}.content{display:flex;flex-direction:column;min-width:0}.folio-component{display:block;width:100%;min-width:0;margin-top:34rpx;box-sizing:border-box}.state{min-width:0;padding:100rpx 28rpx;text-align:center;color:#5b6775;overflow-wrap:anywhere}.folio-brand-footer{display:flex;flex-direction:column;align-items:center;gap:12rpx;padding:56rpx 0 calc(160rpx + env(safe-area-inset-bottom));box-sizing:border-box}.folio-brand-logo{width:56rpx;height:56rpx}.folio-brand-name{color:#a1a9b3;font-size:24rpx;font-weight:800;line-height:1.4}
