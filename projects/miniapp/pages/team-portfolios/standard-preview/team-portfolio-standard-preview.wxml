<navigation-bar title="团队作品集预览" back="{{true}}" color="{{navigationColor}}" background="{{backgroundColor}}" />
<scroll-view scroll-y class="page-shell theme-{{themeMode}} {{portfolio.bottomNav.enabled ? 'with-bottom-nav' : ''}}" style="background-color:{{backgroundColor}};" scroll-top="{{portfolioScrollTop}}">
  <view class="preview-toolbar">
    <view class="preview-note">预览模式：禁用真实提交，不统计访问，不扣积分。</view>
  </view>
  <view wx:if="{{loading}}" class="state">加载中...</view>
  <view wx:elif="{{errorMessage}}" class="state"><text>{{errorMessage}}</text><button bindtap="handleRetry">重试</button></view>
  <view wx:else class="team-portfolio-menu-transition-content {{teamPortfolioMenuTransitionClass}}">
    <view wx:if="{{empty}}" class="state">当前菜单暂无内容</view>
    <view wx:else class="content">
      <team-profile theme-mode="{{themeMode}}" class="folio-component" wx:for="{{componentBuckets.teamProfile}}" wx:key="componentKey" style="order:{{item.sortOrder}}" team="{{item.data.team}}" />
      <team-carousel theme-mode="{{themeMode}}" class="folio-component" wx:for="{{componentBuckets.carousel}}" wx:key="componentKey" style="order:{{item.sortOrder}}" items="{{item.data.items}}" bindpreview="handleImagePreview" />
      <team-video-carousel theme-mode="{{themeMode}}" class="folio-component" wx:for="{{componentBuckets.videoCarousel}}" wx:key="componentKey" style="order:{{item.sortOrder}}" component-key="{{item.componentKey}}" title="{{item.data.title}}" works="{{item.data.works}}" show-title="{{item.data.showTitle}}" show-swipe-hint="{{item.data.showSwipeHint}}" bindplay="handleVideoCarouselPlay" />
      <team-single-work theme-mode="{{themeMode}}" class="folio-component team-single-work-instance" wx:for="{{componentBuckets.singleWork}}" wx:key="componentKey" style="order:{{item.sortOrder}}" component-key="{{item.componentKey}}" work="{{item.data.work}}" show-title="{{item.data.showTitle}}" show-description="{{item.data.showDescription}}" active-video-key="{{activeSingleWorkVideoKey}}" bindpreview="handleSingleWorkPreview" bindactivate="handleSingleWorkActivate" bindvideoerror="handleSingleWorkVideoError" />
      <team-divider theme-mode="{{themeMode}}" class="folio-component" wx:for="{{componentBuckets.divider}}" wx:key="componentKey" style="order:{{item.sortOrder}}" config="{{item.data}}" />
      <team-member-portfolio-grid theme-mode="{{themeMode}}" class="folio-component" wx:for="{{componentBuckets.grid}}" wx:key="componentKey" style="order:{{item.sortOrder}}" items="{{item.data.items}}" show-member-name="{{item.data.showMemberName}}" bindpreview="handleMemberPortfolio" />
      <team-member-portfolio-list theme-mode="{{themeMode}}" class="folio-component" wx:for="{{componentBuckets.list}}" wx:key="componentKey" style="order:{{item.sortOrder}}" items="{{item.data.items}}" show-member-name="{{item.data.showMemberName}}" bindpreview="handleMemberPortfolio" />
      <team-text-section theme-mode="{{themeMode}}" repair-mode="{{true}}" class="folio-component" wx:for="{{componentBuckets.text}}" wx:key="componentKey" style="order:{{item.sortOrder}}" config="{{item.data}}" />
      <team-structured-text-section theme-mode="{{themeMode}}" class="folio-component" wx:for="{{componentBuckets.structuredText}}" wx:key="componentKey" style="order:{{item.sortOrder}}" config="{{item.data}}" repair-mode="{{true}}" />
      <team-schedule-query theme-mode="{{themeMode}}" class="folio-component" wx:for="{{componentBuckets.schedule}}" wx:key="componentKey" id="schedule-{{item.componentKey}}" style="order:{{item.sortOrder}}" portfolio-id="{{portfolioId}}" component-key="{{item.componentKey}}" preview="{{true}}" preview-scope="{{scope}}" config="{{item.data}}" result="{{scheduleResults[item.componentKey]}}" bindschedulequery="handleScheduleQuery" />
      <team-contact-form theme-mode="{{themeMode}}" class="folio-component" wx:for="{{componentBuckets.contact}}" wx:key="componentKey" style="order:{{item.sortOrder}}" data-key="{{item.componentKey}}" config="{{item.data}}" form="{{contactForms[item.componentKey]}}" modal-visible="{{contactModalVisible[item.componentKey]}}" bindcontactinput="handleContactInput" bindopenmodal="handleContactOpen" bindclosemodal="handleContactClose" bindsubmit="handleContactSubmit" />
      <team-qr-contact theme-mode="{{themeMode}}" class="folio-component" wx:for="{{componentBuckets.qr}}" wx:key="componentKey" style="order:{{item.sortOrder}}" component-key="{{item.componentKey}}" config="{{item.data}}" bindpreview="handleQrPreview" />
    </view>
    <view class="folio-brand-footer">
      <image wx:if="{{themeMode === 'dark'}}" class="folio-brand-logo" src="/assets/system/folio-logo-stack-bold-dark-50kb.png" mode="aspectFit"></image>
      <image wx:else class="folio-brand-logo" src="/assets/system/folio-logo-stack-bold-small-50kb.png" mode="aspectFit"></image>
      <view class="folio-brand-name">映期Folio</view>
    </view>
  </view>
</scroll-view>
<portfolio-bottom-nav
  navigation="{{portfolio.bottomNav}}"
  active-menu-key="{{portfolio.activeMenuKey}}"
  theme-mode="{{themeMode}}"
  bindchange="handleMenuTap"
></portfolio-bottom-nav>
<root-portal wx:if="{{videoPreviewVisible}}">
  <view class="work-video-mask visible" catchtap="handleCloseVideoPreview">
    <view class="work-video-panel" catchtap="handleVideoPreviewPanelTap">
      <view class="work-video-heading"><view class="work-video-title">{{videoPreview.title}}</view><view class="work-video-close" catchtap="handleCloseVideoPreview">×</view></view>
      <video id="teamPortfolioWorkVideo" class="work-video-player" src="{{videoPreviewUrl}}" poster="{{videoPreview.poster}}" controls="{{true}}" autoplay="{{true}}" show-fullscreen-btn="{{true}}" show-center-play-btn="{{true}}" enable-progress-gesture="{{true}}" object-fit="contain" binderror="handleVideoPreviewError"></video>
    </view>
  </view>
</root-portal>
