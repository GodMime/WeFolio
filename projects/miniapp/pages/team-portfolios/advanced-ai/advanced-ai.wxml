<template name="selected-strip">
  <scroll-view class="selected-scroll" wx:if="{{selectedSources.length}}" scroll-x enhanced show-scrollbar="{{false}}">
    <view class="selected-strip">
      <view wx:for="{{selectedSources}}" wx:key="sourceNo" class="selected-item {{item.available === false ? 'unavailable' : ''}}">
        <button class="selected-source" data-no="{{item.sourceNo}}" bindtap="handleSelectedSourceTap" disabled="{{waiting || adopting || submitting || submissionUncertain}}" aria-label="{{item.sourceNo}}号 {{item.title}}">
          <view class="selected-cover">
            <image wx:if="{{item.thumbnailUrl}}" class="selected-thumbnail" src="{{item.thumbnailUrl}}" mode="aspectFill"></image>
            <view wx:else class="selected-placeholder">{{item.kind === 'MEMBER_PORTFOLIO' ? '作品集' : item.mediaTypeLabel || '作品'}}</view>
            <text class="source-number">{{item.sourceNo}}</text>
            <text wx:if="{{item.kind === 'MEMBER_PORTFOLIO'}}" class="source-kind-mark">集</text>
          </view>
          <text class="selected-label">{{item.sourceNo}}号{{item.kind === 'MEMBER_PORTFOLIO' ? ' · 作品集' : ''}}</text>
        </button>
        <view wx:if="{{step === 'sources'}}" class="remove-source" data-no="{{item.sourceNo}}" catchtap="handleRemoveSelected" aria-role="button" aria-label="移除{{item.sourceNo}}号">×</view>
      </view>
    </view>
  </scroll-view>
</template>
<view class="page-shell advanced-ai-page">
  <navigation-bar title="{{managingSources ? '管理已选内容' : mode === 'CREATE' ? (step === 'sources' ? '选择内容' : '描述你的想法') : 'AI 修改'}}" back="{{true}}" color="#212529" background="#ffffff"></navigation-bar>
  <view wx:if="{{loading}}" class="panel page-state">正在加载...</view>
  <view wx:elif="{{errorMessage}}" class="panel page-state"><text>{{errorMessage}}</text><button class="secondary-button" bindtap="bootstrap">重试</button></view>
  <block wx:else>
    <scroll-view class="ai-scroll" scroll-y type="list" bindscrolltolower="handleLoadMore">
      <view class="ai-content">
        <view wx:if="{{mode === 'CREATE'}}" class="steps">
          <view class="step {{step === 'sources' ? 'active' : ''}}"><text class="step-circle">1</text><text>选内容</text></view>
          <view class="step-line"></view>
          <view class="step {{step === 'prompt' ? 'active' : ''}}"><text class="step-circle">2</text><text>描述需求</text></view>
          <view class="step-line"></view>
          <view class="step"><text class="step-circle">3</text><text>查看与编辑</text></view>
        </view>
        <view wx:if="{{!capabilities.enabled}}" class="notice">AI 服务暂未开放，可继续管理内容；已有作品集仍可手动编辑、保存和发布。</view>
        <view wx:if="{{activeTaskId}}" class="notice notice-action"><text>已有等待或执行任务</text><button class="text-button" bindtap="handleCancel">取消该任务</button></view>
        <view wx:if="{{mode === 'CREATE' && !managingSources}}" class="source-mode-options"><button class="source-mode {{sourceMode === 'SELECTED_SOURCES' ? 'active' : ''}}" data-value="SELECTED_SOURCES" bindtap="handleSourceMode" disabled="{{waiting || submitting || submissionUncertain}}">使用已选内容</button><button wx:if="{{textOnlyAvailable}}" class="source-mode {{sourceMode === 'TEXT_ONLY' ? 'active' : ''}}" data-value="TEXT_ONLY" bindtap="handleSourceMode" disabled="{{waiting || submitting || submissionUncertain}}">仅用文字描述</button></view>
        <view wx:if="{{!v2Available && capabilities.enabled}}" class="notice">当前服务暂不支持此版本生成，可保留草稿并继续手动编辑。</view>
        <view wx:if="{{sourceMode === 'TEXT_ONLY'}}" class="notice">无需选择作品，请在描述中写出真实经历和日期。不会自动编造履历。</view>
        <block wx:if="{{step === 'sources'}}">
          <view class="selection-heading">
            <view class="selection-title">{{managingSources ? '管理已选内容' : '先选内容，再告诉 AI 怎么排'}}</view>
            <view wx:if="{{mode === 'CREATE' && !managingSources}}" class="selection-subtitle-row">
              <text class="help-text">{{team ? '作品与成员作品集可以一起选择' : '选择你想展示的作品'}}</text>
              <button class="tutorial-entry" bindtap="handleOpenTutorial" aria-label="播放高级作品集教学视频"><view class="tutorial-entry-face"><image class="tutorial-icon" src="/assets/system/video-tutorial.svg" mode="aspectFit"></image><text>教程</text></view></button>
            </view>
            <text wx:else class="help-text">{{team ? '作品与成员作品集可以一起选择' : '选择你想展示的作品'}}</text>
          </view>
          <view wx:if="{{team}}" class="source-tabs">
            <button class="source-tab {{sourceKind === 'WORK' ? 'active' : ''}}" data-kind="WORK" bindtap="handleKindTap">成员作品</button>
            <button class="source-tab {{sourceKind === 'MEMBER_PORTFOLIO' ? 'active' : ''}}" data-kind="MEMBER_PORTFOLIO" bindtap="handleKindTap">成员作品集</button>
          </view>
          <scroll-view wx:if="{{team && members.length}}" scroll-x class="filter-scroll" enhanced show-scrollbar="{{false}}">
            <view class="filter-row"><button class="filter-chip {{memberIndex === 0 ? 'active' : ''}}" data-index="0" bindtap="handleMemberTap">全部成员</button><button wx:for="{{members}}" wx:key="memberUserId" class="filter-chip {{memberIndex === index + 1 ? 'active' : ''}}" data-index="{{index + 1}}" bindtap="handleMemberTap">{{item.memberName}}</button></view>
          </scroll-view>
          <view wx:if="{{team && sourceKind === 'MEMBER_PORTFOLIO'}}" class="notice">作为整体入口展示；需要其中的作品，请单独选择。</view>
          <view class="search-row"><input class="search-input" placeholder="{{team ? '搜索内容名称' : '搜索作品名称'}}" placeholder-class="input-placeholder" value="{{keyword}}" bindinput="handleKeywordInput" bindconfirm="handleSearch" confirm-type="search" /><button class="search-button" bindtap="handleSearch" aria-label="搜索作品">搜索</button></view>
          <scroll-view wx:if="{{!team}}" scroll-x class="filter-scroll" enhanced show-scrollbar="{{false}}">
            <view class="filter-row">
              <button class="filter-chip {{!tagId ? 'active' : ''}}" data-id="" bindtap="handleTagTap">全部</button>
              <button wx:for="{{tags}}" wx:key="id" class="filter-chip {{tagId === item.id ? 'active' : ''}}"
                style="color: {{item.color && tagId === item.id ? '#ffffff' : item.color}}; background: {{item.color ? (tagId === item.id ? item.color : '#ffffff') : ''}}; border-color: {{item.color}};"
                data-id="{{item.id}}" bindtap="handleTagTap">{{item.name}}</button>
            </view>
          </scroll-view>
          <view wx:if="{{sourceError}}" class="notice error notice-action"><text>{{sourceError}}</text><button class="text-button" bindtap="handleSearch">重试</button></view>
          <view class="source-grid">
            <view wx:for="{{sourceOptions}}" wx:key="key" class="source-cell {{index % 2 === 0 ? 'source-cell-left' : 'source-cell-right'}}">
              <view class="source-card {{item.selected ? 'selected' : ''}} {{item.available === false ? 'unavailable' : ''}}" data-index="{{index}}" bindtap="handleSourceTap" aria-role="button" aria-label="{{item.selected ? '已选' : '选择'}}{{item.title}}">
                <view class="source-cover"><image wx:if="{{item.thumbnailUrl}}" class="source-image" src="{{item.thumbnailUrl}}" mode="aspectFill"></image><view wx:else class="source-placeholder">{{item.mediaTypeLabel}}</view><text class="selection-circle">{{item.selected ? item.sourceNo : ''}}</text><text class="type-tag">{{item.mediaTypeLabel}}</text><view wx:if="{{item.mediaType === 'VIDEO'}}" class="play-badge"><view class="play-triangle"></view></view></view>
                <view class="source-body"><text class="source-title">{{item.title}}</text><text class="source-meta">{{item.memberName ? item.memberName + ' · ' : ''}}{{item.available === false ? (item.unavailableReason || '当前不可用') : item.kind === 'MEMBER_PORTFOLIO' ? '已发布' : '审核通过'}}</text></view>
              </view>
            </view>
          </view>
          <view wx:if="{{sourceLoading}}" class="page-state">加载中...</view><view wx:elif="{{!sourceOptions.length}}" class="page-state">没有符合条件的内容，请清空关键词或切回全部。</view>
          <button wx:if="{{hasMore}}" class="secondary-button full-width" bindtap="handleLoadMore" disabled="{{sourceLoading}}">加载更多</button>
          <text class="help-text selection-tip">筛选与搜索保留已选内容。取消后重新选回同一内容，保留原序号。</text>
        </block>
        <block wx:elif="{{result && (result.kind === 'CANDIDATE' || result.available === false)}}">
          <view class="selection-heading"><view class="selection-title">{{candidateTitle}}</view><text class="help-text">{{result.available === false ? '现有内容已保留' : '候选效果 · 尚未采用'}}</text></view>
          <view class="panel candidate-panel">
            <block wx:if="{{result.available === false}}">
              <view class="field-label">失败原因</view>
              <view class="notice error">{{taskError}}</view>
              <text class="help-text">已选内容与描述已保留，可修改描述后再生成。</text>
            </block>
            <block wx:else>
              <view class="notice success">{{result.hasChanges === false ? '当前内容已满足要求' : '候选已准备好，当前内容已保留。'}}</view>
              <view class="section-title">{{mode === 'CREATE' ? '页面编排' : '本次变化'}}</view>
              <text class="summary-text">{{summaryText}}</text>
              <view wx:if="{{taskError}}" class="notice error">{{taskError}}</view>
              <block wx:for="{{aiReferenceAttachments}}" wx:key="localKey"><text wx:if="{{item.saveDeadlineText}}" class="help-text">{{item.referenceNo}} · {{item.saveDeadlineText}}</text></block>
              <button wx:if="{{result.available && result.renderData}}" class="secondary-button full-width" bindtap="handleCandidatePreview">查看完整效果 →</button>
              <text class="help-text">采用只更新编辑内容，保存与发布仍由你决定。</text>
            </block>
            <view wx:if="{{tokenUsageText}}" class="token-usage">{{tokenUsageText}}</view>
          </view>
        </block>
        <block wx:else>
          <view class="selection-heading">
            <view class="selection-title">{{task.status === 'FAILED' && taskError ? '生成失败' : mode === 'CREATE' ? '你想怎样展示？' : '想怎样调整作品集？'}}</view>
            <view wx:if="{{mode === 'CREATE' && !managingSources}}" class="selection-subtitle-row">
              <text class="help-text">说出重点、顺序和风格就好。</text>
              <button class="tutorial-entry" bindtap="handleOpenTutorial" aria-label="播放高级作品集教学视频"><view class="tutorial-entry-face"><image class="tutorial-icon" src="/assets/system/video-tutorial.svg" mode="aspectFit"></image><text>教程</text></view></button>
            </view>
            <text wx:else class="help-text">{{mode === 'CREATE' ? '说出重点、顺序和风格就好。' : '描述整体修改需求，AI 会基于当前编辑内容调整，包括未保存的修改。'}}</text>
          </view>
          <view wx:if="{{task.status === 'FAILED' && taskError}}" class="panel failure-panel"><view class="field-label">失败原因</view><view class="notice error">{{taskError}}</view><text class="help-text">已选内容与描述已保留，可修改描述后再生成。</text><view wx:if="{{tokenUsageText}}" class="token-usage">{{tokenUsageText}}</view></view>
          <view class="panel selected-panel"><view class="card-heading"><view class="section-title">{{mode === 'CREATE' ? '已选内容' : '可引用的内容'}}</view><button class="text-button" bindtap="handleBackToSources" disabled="{{waiting || adopting || submitting || submissionUncertain}}">{{mode === 'CREATE' ? '调整' : '管理内容'}}</button></view><template is="selected-strip" data="{{selectedSources, step, waiting, adopting, submitting, submissionUncertain}}"></template><text wx:if="{{!selectedSources.length}}" class="help-text">尚未选内容；修改已有文字、样式与顺序可以不选来源。</text><text wx:else class="help-text">点击缩略图，将序号插入描述。</text></view>
          <view wx:if="{{waiting}}" class="panel generation-panel"><view class="generation-mark"><image class="generation-mark-icon" src="/assets/system/ai-sparkle.svg" mode="aspectFit"></image></view><view class="section-title">{{statusText}}</view><text class="help-text">已选内容与描述已保留，完成后先查看候选效果。</text><view wx:if="{{taskError}}" class="notice error">{{taskError}}</view></view>
          <view wx:else class="panel prompt-panel">
            <view class="field-label">{{mode === 'CREATE' ? '描述你的想法' : '描述整体修改需求'}}</view>
            <textarea class="prompt-input" placeholder-class="input-placeholder" value="{{prompt}}" bindinput="handlePromptInput" disabled="{{adopting || submitting || submissionUncertain}}" maxlength="-1" placeholder="例如：把1号放在顶部，再放一段简短介绍，最后放档期查询。"></textarea>
            <view class="counter {{promptCount > promptMaxLength ? 'over-limit' : ''}}"><text class="counter-value">{{promptCount}} / {{promptMaxLength}}</text></view>
            <view class="prompt-example"><text class="help-text">试试这样说</text><button class="text-button example-button" bindtap="handleOpenReferenceExample" disabled="{{adopting || submitting || submissionUncertain}}">查看示例 ↗</button></view>
            <view class="reference-section">
              <button class="reference-add" bindtap="handleOpenReferencePicker" disabled="{{referenceCapabilityChecking || waiting || adopting || submitting || submissionUncertain}}" aria-label="添加参考附件，选填">
                <view class="reference-entry-title"><image class="reference-clip" src="/assets/system/reference-attachment.svg" mode="aspectFit"></image><text>{{referenceCapabilityChecking ? '正在检查附件服务' : aiReferenceAttachments.length ? '参考附件' : '添加参考附件'}}</text><text class="reference-optional">· 选填</text></view><text class="reference-plus">＋</text>
              </button>
              <text class="reference-subtitle">仅供 AI 参考，不展示在作品集中。
随作品集保存；删除作品集时一并删除。</text>
              <text wx:if="{{capabilityError}}" class="reference-subtitle">暂时无法检查附件服务，请点击 ＋ 重试。</text>
              <text wx:elif="{{!capabilities.referenceAttachments.enabled}}" class="reference-subtitle">参考附件暂未开放，可点击 ＋ 重新检查。仍可使用已选内容生成作品集。</text>
              <view wx:for="{{aiReferenceAttachments}}" wx:key="localKey" class="reference-item">
                <view class="reference-top">
                  <button class="reference-preview" data-key="{{item.localKey}}" bindtap="handlePreviewReference" disabled="{{item.status !== 'READY' || !item.available}}" aria-label="预览参考附件{{item.referenceNo}}">
                    <image wx:if="{{item.thumbnailPath}}" class="reference-thumbnail" src="{{item.thumbnailPath}}" mode="aspectFill"></image>
                    <text wx:else>{{item.mediaType === 'VIDEO' ? '视频' : '图片'}}</text>
                    <text class="reference-number">{{item.referenceNo}}</text>
                    <view wx:if="{{item.mediaType === 'VIDEO'}}" class="reference-play"><view class="reference-play-triangle"></view></view>
                  </button>
                  <view class="reference-info">
                    <text class="reference-name">{{item.originalFileName}}</text><text class="reference-meta">{{item.detailsText}}</text>
                    <view class="reference-status {{item.status === 'FAILED' || !item.available ? 'warning' : ''}}"><view wx:if="{{item.status !== 'READY' && item.status !== 'FAILED'}}" class="reference-spinner"></view><text>{{item.available ? item.statusText : '暂不可用'}}{{item.status === 'UPLOADING' ? ' ' + item.progress + '%' : ''}}</text></view>
                    <view wx:if="{{item.status === 'UPLOADING'}}" class="reference-progress"><view class="reference-progress-fill" style="width: {{item.progress}}%;"></view></view>
                    <text wx:if="{{item.saveDeadlineText}}" class="reference-meta">{{item.saveDeadlineText}}</text>
                  </view>
                  <button class="reference-remove" data-key="{{item.localKey}}" bindtap="handleRemoveReference" disabled="{{waiting || adopting || submitting || submissionUncertain}}" aria-label="移除参考附件{{item.referenceNo}}">×</button>
                </view>
                <view class="reference-actions">
                  <block wx:if="{{item.status === 'READY' && item.available}}"><button class="text-button" data-key="{{item.localKey}}" bindtap="handleToggleReferenceNote" disabled="{{waiting || adopting || submitting || submissionUncertain}}">{{referenceNoteOpen[item.localKey] ? '收起参考重点' : item.note ? '编辑参考重点' : '＋ 参考重点 · 选填'}}</button><button class="text-button" data-key="{{item.localKey}}" bindtap="handleQuoteReference" disabled="{{waiting || adopting || submitting || submissionUncertain}}">引用 {{item.referenceNo}}</button></block>
                  <block wx:elif="{{item.status === 'FAILED' || !item.available}}"><button wx:if="{{item.status === 'FAILED'}}" class="text-button" data-key="{{item.localKey}}" bindtap="handleRetryReference" disabled="{{waiting || adopting || submitting || submissionUncertain}}">重试</button><button class="text-button" data-key="{{item.localKey}}" bindtap="handleReplaceReference" disabled="{{waiting || adopting || submitting || submissionUncertain}}">更换文件</button></block>
                  <button wx:if="{{index > 0}}" class="text-button" data-key="{{item.localKey}}" bindtap="handleMoveReference" disabled="{{waiting || adopting || submitting || submissionUncertain}}">上移</button>
                </view>
                <textarea wx:if="{{referenceNoteOpen[item.localKey]}}" class="reference-note" placeholder="例如：只参考配色与留白，不使用图中的文字。" placeholder-class="input-placeholder" value="{{item.note}}" maxlength="-1" data-key="{{item.localKey}}" bindinput="handleReferenceNote" disabled="{{waiting || adopting || submitting || submissionUncertain}}"></textarea>
                <text wx:if="{{item.errorMessage}}" class="reference-error">{{item.errorMessage}}</text>
              </view>
              <view wx:if="{{aiReferenceAttachments.length}}" class="reference-summary"><button class="text-button" bindtap="handleOpenReferencePicker" disabled="{{referenceCapabilityChecking || waiting || adopting || submitting || submissionUncertain}}">＋ 继续添加</button><text>{{aiReferenceAttachments.length}}/{{referenceUi.maxCount}} 个 · 视频 {{referenceUi.videoCount}}/{{referenceUi.maxVideos}} · {{referenceUi.totalMB}} MB</text></view>
              <view wx:if="{{referenceUi.warning}}" class="reference-warning"><text>{{referenceUi.warning}}</text><button wx:if="{{referenceUi.pendingCount}}" class="text-button" bindtap="handleRemovePendingReferences" disabled="{{waiting || adopting || submitting || submissionUncertain}}">移除未就绪附件，继续生成</button></view>
            </view>
            <view wx:for="{{questions}}" wx:key="id" class="question"><view class="field-label">{{item.prompt}}</view><button wx:for="{{item.options}}" wx:for-item="option" wx:key="id" class="secondary-button question-option {{clarificationAnswer.optionId === option.id ? 'chosen' : ''}}" data-id="{{item.id}}" data-option="{{option.id}}" data-value="{{option.answerText}}" bindtap="handleQuestionOption">{{option.label}}</button><input class="question-input" placeholder="或说明你的选择" placeholder-class="input-placeholder" data-id="{{item.id}}" bindinput="handleQuestionInput" /></view>
            <view wx:if="{{statusText && task.status !== 'FAILED'}}" class="notice">{{statusText}}</view><view wx:if="{{taskError && task.status !== 'FAILED'}}" class="notice error">{{taskError}}</view>
          </view>
          <!-- 生成期间保留附件信息和预览入口，修改操作仍由描述页承接。 -->
          <view wx:if="{{waiting && aiReferenceAttachments.length}}" class="panel generation-references">
            <view class="section-title">参考附件 {{aiReferenceAttachments.length}} 个 <text class="reference-optional">· 仅供 AI 参考</text></view>
            <text class="reference-subtitle">生成中可查看附件，取消生成后可修改。</text>
              <view wx:for="{{aiReferenceAttachments}}" wx:key="localKey" class="reference-item">
                <view class="reference-top">
                  <button class="reference-preview" data-key="{{item.localKey}}" bindtap="handlePreviewReference" disabled="{{item.status !== 'READY' || !item.available}}" aria-label="预览参考附件{{item.referenceNo}}">
                    <image wx:if="{{item.thumbnailPath}}" class="reference-thumbnail" src="{{item.thumbnailPath}}" mode="aspectFill"></image>
                    <text wx:else>{{item.mediaType === 'VIDEO' ? '视频' : '图片'}}</text>
                    <text class="reference-number">{{item.referenceNo}}</text>
                    <view wx:if="{{item.mediaType === 'VIDEO'}}" class="reference-play"><view class="reference-play-triangle"></view></view>
                  </button>
                  <view class="reference-info">
                    <text class="reference-name">{{item.originalFileName}}</text><text class="reference-meta">{{item.detailsText}}</text>
                    <view class="reference-status {{item.status === 'FAILED' || !item.available ? 'warning' : ''}}"><view wx:if="{{item.status !== 'READY' && item.status !== 'FAILED'}}" class="reference-spinner"></view><text>{{item.available ? item.statusText : '暂不可用'}}{{item.status === 'UPLOADING' ? ' ' + item.progress + '%' : ''}}</text></view>
                    <view wx:if="{{item.status === 'UPLOADING'}}" class="reference-progress"><view class="reference-progress-fill" style="width: {{item.progress}}%;"></view></view>
                    <text wx:if="{{item.saveDeadlineText}}" class="reference-meta">{{item.saveDeadlineText}}</text>
                  </view>
                </view>
                <text wx:if="{{item.note}}" class="reference-readonly-note">参考重点：{{item.note}}</text>
              </view>
          </view>
          <text class="help-text form-tip">AI 会使用现有作品集组件生成，可继续手动调整。</text>
        </block>
      </view>
    </scroll-view>
    <view class="ai-footer">
      <text wx:if="{{step === 'prompt' && !waiting && !result && referenceUi.warning}}" class="reference-footer-warning">{{referenceUi.warning}}</text>
      <block wx:if="{{step === 'sources'}}"><template wx:if="{{selectedSources.length}}" is="selected-strip" data="{{selectedSources, step, waiting, adopting, submitting, submissionUncertain}}"></template><view class="footer-actions"><view class="footer-copy">已选 <text class="footer-count">{{selectedSources.length}}</text> 项</view><button class="primary-button next-button" bindtap="handleNext" disabled="{{mode === 'CREATE' && !selectedSources.length}}">{{managingSources ? '完成选择' : '下一步'}}</button></view></block>
      <view wx:elif="{{result && (result.kind === 'CANDIDATE' || result.available === false)}}" class="footer-actions"><button class="secondary-button" bindtap="handleDiscard" disabled="{{adopting || submitting}}">{{result.available === false ? '修改描述' : '放弃结果'}}</button><button wx:if="{{result.available === false}}" class="primary-button" bindtap="handleGenerate" loading="{{submitting}}" disabled="{{submitting || adopting || !capabilities.enabled}}">重新生成</button><button wx:elif="{{canAdopt}}" class="primary-button" bindtap="handleAdopt" loading="{{adopting}}" disabled="{{adopting}}">{{mode === 'CREATE' ? '采用并编辑' : '采用修改'}}</button><button wx:elif="{{!canAdopt && result.hasChanges !== false}}" class="primary-button" bindtap="queryTask" disabled="{{adopting || submitting}}">重试查询</button></view>
      <view wx:elif="{{waiting}}" class="footer-actions"><button wx:if="{{taskError}}" class="secondary-button" bindtap="queryTask">重试查询</button><button class="secondary-button" bindtap="handleCancel">取消生成</button></view>
      <view wx:elif="{{cancelFailed}}" class="footer-actions"><button class="secondary-button" bindtap="handleCancel">重试取消</button></view>
      <view wx:else class="footer-actions"><button class="secondary-button" bindtap="handleBackToSources" disabled="{{adopting || submitting || submissionUncertain}}">{{mode === 'CREATE' ? '上一步' : '管理内容'}}</button><button class="primary-button" bindtap="handleGenerate" loading="{{submitting}}" disabled="{{submitting || adopting || !capabilities.enabled || !!activeTaskId || (referenceUi.blocked && !submissionUncertain)}}"><text wx:if="{{!submissionUncertain && !questions.length && !taskError}}" class="ai-spark">✧</text>{{submissionUncertain ? '重试提交' : questions.length ? '回答后继续' : taskError ? '重试生成' : mode === 'CREATE' ? '生成作品集' : '生成修改'}}</button></view>
    </view>
  </block>
  <view wx:if="{{referenceSheet}}" class="reference-overlay">
    <view class="reference-mask" bindtap="handleCloseReferenceSheet"></view>
    <view class="reference-sheet" aria-role="dialog" aria-label="{{referenceSheet === 'picker' ? '添加参考附件' : '参考附件可以这样用'}}">
      <view class="reference-sheet-handle"></view>
      <view class="reference-sheet-heading"><text>{{referenceSheet === 'picker' ? (referenceReplacingKey ? '更换参考附件' : '添加参考附件') : '参考附件可以这样用'}}</text><button class="reference-sheet-close" bindtap="handleCloseReferenceSheet" aria-label="关闭">×</button></view>
      <scroll-view class="reference-sheet-scroll" scroll-y type="list">
        <block wx:if="{{referenceSheet === 'picker'}}">
          <text class="help-text">供 AI 参考风格或内容，不直接展示到作品集。</text>
          <view class="reference-choices">
            <button class="reference-choice" data-media-type="image" bindtap="handleChooseReference" disabled="{{!referenceUi.canAdd}}"><text class="reference-choice-icon">▧</text><text>选择图片</text><text class="reference-choice-hint">每张不超过 {{referenceUi.imageMaxMB}} MB</text></button>
            <button class="reference-choice" data-media-type="video" bindtap="handleChooseReference" disabled="{{!referenceUi.canChooseVideo}}"><text class="reference-choice-icon">▷</text><text>选择视频</text><text class="reference-choice-hint">{{referenceUi.canChooseVideo ? '最长 ' + referenceUi.videoMaxMinutes + ' 分钟' : '视频数量已达上限'}}</text></button>
          </view>
          <view class="reference-sheet-limits">
            <text>最多 {{referenceUi.maxCount}} 个附件，其中视频最多 {{referenceUi.maxVideos}} 个。</text>
            <text>图片最终 ≤ {{referenceUi.imageMaxMB}} MB；视频最终 ≤ {{referenceUi.videoMaxMB}} MB、≤ {{referenceUi.videoMaxMinutes}} 分钟。</text>
            <text>视频源文件 ≤ {{referenceUi.sourceVideoMaxMB}} MB；超过 {{referenceUi.videoMaxMB}} MB 将先在手机压缩。</text>
            <text>全部附件最终总量 ≤ {{referenceUi.totalMaxMB}} MB（1 MB = 1,000,000 B）。</text>
            <text>原视频直接供 AI 参考；超过可用上下文时，请截短视频后重试。</text>
            <text>随作品集保存；删除作品集时一并删除。</text>
          </view>
        </block>
        <block wx:else>
          <text class="help-text">参考文件搭配一句说明，让 AI 更容易理解重点。</text>
          <text class="reference-example-quote">{{referenceExampleText}}</text>
          <view class="reference-example-item"><text class="field-label">图片 · 色调、版式、构图</text><text class="help-text">参考重点可以写：只参考配色与留白，不使用图中的文字。</text></view>
          <view class="reference-example-item"><text class="field-label">视频 · 氛围、节奏、内容要点</text><text class="help-text">原视频直接供 AI 参考，不会把视频放进生成的页面。</text></view>
          <button class="primary-button reference-use-example" bindtap="handleUseReferenceExample">使用文字示例</button>
          <text class="reference-subtitle">未添加附件时，示例只插入作品与风格描述。</text>
        </block>
      </scroll-view>
    </view>
  </view>
</view>
