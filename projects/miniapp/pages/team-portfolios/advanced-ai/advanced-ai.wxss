/* 高级流程沿用设计稿的中性色；显式按钮尺寸避免全局复位造成塌陷。 */
.advanced-ai-page { height: 100vh; min-height: 0; display: flex; flex-direction: column; overflow: hidden; color: #212529; background: #f5f6f7; }
.ai-scroll { flex: 1; height: 0; min-height: 0; width: 100%; }
.ai-content { padding: 24rpx 24rpx 32rpx; box-sizing: border-box; }
.advanced-ai-page button { display: flex; align-items: center; justify-content: center; box-sizing: border-box; margin: 0; padding: 0; border: 0; font-weight: 600; line-height: 1.45; }
.advanced-ai-page button::after { border: 0; }
.advanced-ai-page button[disabled] { opacity: .45; }
.steps { display: flex; align-items: center; justify-content: center; margin-bottom: 28rpx; }
.step { display: flex; align-items: center; color: #a0a7ac; font-size: 22rpx; white-space: nowrap; }
.step-circle { width: 38rpx; height: 38rpx; margin-right: 12rpx; border-radius: 50%; display: flex; align-items: center; justify-content: center; color: #a0a7ac; background: #e8ecef; font-size: 22rpx; }
.step.active { color: #384634; font-weight: 600; }
.step.active .step-circle { color: #fff; background: #293628; }
.step-line { height: 1rpx; width: 40rpx; margin: 0 18rpx; background: #dfe4e7; flex-shrink: 0; }
.selection-heading { margin: 4rpx 2rpx 24rpx; }
.selection-title { font-size: 36rpx; font-weight: 700; line-height: 1.5; }
.selection-heading .help-text { margin-top: 8rpx; }
/* 教程与副标题同排；图标保持轻量，按钮留足独立点击区域。 */
.selection-subtitle-row { display: flex; align-items: center; justify-content: space-between; min-height: 88rpx; }
.selection-heading .selection-subtitle-row .help-text { flex: 1; min-width: 0; margin-top: 0; }
.advanced-ai-page .tutorial-entry { flex: none; width: auto; min-height: 88rpx; padding: 0 0 0 20rpx; background: transparent; color: #52674a; font-size: 22rpx; }
.tutorial-entry-face { display: flex; align-items: center; padding: 10rpx 18rpx; border: 2rpx solid #dee7d8; border-radius: 40rpx; background: #eaf0e6; white-space: nowrap; }
.tutorial-icon { display: block; flex: none; width: 32rpx; height: 32rpx; margin-right: 10rpx; }
.help-text { display: block; color: #7c858e; font-size: 22rpx; line-height: 1.65; }
.panel { box-sizing: border-box; padding: 24rpx; margin-bottom: 20rpx; background: #fff; border: 2rpx solid #e9ecef; border-radius: 36rpx; }
.card-heading { display: flex; align-items: center; justify-content: space-between; margin-bottom: 16rpx; }
.section-title { color: #212529; font-size: 28rpx; font-weight: 650; line-height: 1.45; }
.notice { padding: 22rpx 24rpx; border-radius: 24rpx; background: #f1f3f5; color: #858f97; font-size: 22rpx; line-height: 1.7; margin-bottom: 24rpx; box-sizing: border-box; }
.notice-action { display: flex; align-items: center; justify-content: space-between; }
.notice-action text { flex: 1; min-width: 0; margin-right: 16rpx; }
.notice.warning, .notice.error { background: #faf4e8; color: #9b824f; }
.notice.error { white-space: pre-wrap; overflow-wrap: break-word; word-break: break-word; }
.notice.success { background: #edf3eb; color: #60795a; }
.search-row { display: flex; align-items: center; height: 86rpx; padding: 0 24rpx; border: 2rpx solid #e9ecef; border-radius: 26rpx; margin-bottom: 22rpx; box-sizing: border-box; background: #fff; }
.search-input { flex: 1; min-width: 0; height: 80rpx; font-size: 26rpx; color: #212529; }
.input-placeholder { color: #9da4ab; }
.advanced-ai-page .search-button { flex: none; width: 76rpx; height: 80rpx; margin-left: 12rpx; background: transparent; color: #7c858e; font-size: 22rpx; }
.filter-scroll { width: 100%; height: 82rpx; margin-bottom: 12rpx; white-space: nowrap; }
.filter-row { display: flex; align-items: center; flex-wrap: nowrap; padding: 2rpx 0 6rpx; }
.advanced-ai-page .filter-chip { flex: none; width: auto; min-width: 0; height: 58rpx; padding: 0 22rpx; margin-right: 14rpx; border: 2rpx solid #e9ecef; border-radius: 32rpx; color: #8c949b; background: #fff; font-size: 22rpx; font-weight: 400; white-space: nowrap; }
.advanced-ai-page .filter-chip.active { color: #4e6449; background: #eaf0e7; border-color: #d6e2d0; }
.source-tabs { display: flex; align-items: center; border-bottom: 2rpx solid #e9ecef; margin-bottom: 28rpx; }
.advanced-ai-page .source-tab { flex: none; width: auto; position: relative; height: 74rpx; margin-right: 42rpx; padding: 0 0 20rpx; font-size: 26rpx; color: #929aa1; background: transparent; }
.advanced-ai-page .source-tab.active { color: #212529; font-weight: 700; }
.source-tab.active::after { content: ""; position: absolute; bottom: -2rpx; left: 50%; width: 42rpx; height: 6rpx; transform: translateX(-50%); border-radius: 6rpx; background: #212529; }
/* 间距放入百分比列内，避免 rpx 取整后两列总宽溢出而换行。 */
.source-grid { display: flex; flex-direction: row; flex-wrap: wrap; margin-bottom: 30rpx; }
.source-cell { flex: 0 0 50%; width: 50%; min-width: 0; padding-bottom: 20rpx; box-sizing: border-box; }
.source-cell-left { padding-right: 10rpx; }
.source-cell-right { padding-left: 10rpx; }
.source-card { width: 100%; min-width: 0; box-sizing: border-box; border: 2rpx solid #e9ecef; border-radius: 28rpx; overflow: hidden; background: #fff; }
.source-card.selected { border-color: #212529; box-shadow: 0 0 0 4rpx rgba(33,37,41,.08); }
.unavailable { opacity: .6; }
.source-cover { position: relative; height: 286rpx; width: 100%; background: #e7e7e2; overflow: hidden; }
.source-image { display: block; width: 100%; height: 100%; }
.source-placeholder { display: flex; align-items: center; justify-content: center; height: 100%; color: #899087; font-size: 26rpx; }
.selection-circle { position: absolute; top: 16rpx; right: 16rpx; width: 46rpx; height: 46rpx; display: flex; align-items: center; justify-content: center; box-sizing: border-box; border: 2rpx solid #dee2e6; border-radius: 50%; background: rgba(255,255,255,.85); color: #adb5bd; font-size: 24rpx; font-weight: 650; }
.selected .selection-circle { background: #212529; border-color: #212529; color: #fff; }
.type-tag { position: absolute; left: 14rpx; bottom: 14rpx; padding: 4rpx 12rpx; border-radius: 10rpx; color: #fff; background: rgba(28,37,31,.55); font-size: 22rpx; line-height: 1.4; }
.play-badge { position: absolute; left: 50%; top: 50%; transform: translate(-50%,-50%); width: 64rpx; height: 64rpx; display: flex; align-items: center; justify-content: center; border-radius: 50%; background: rgba(255,255,255,.8); }
.play-triangle { width: 0; height: 0; margin-left: 6rpx; border-left: 18rpx solid #465741; border-top: 12rpx solid transparent; border-bottom: 12rpx solid transparent; }
.source-body { padding: 20rpx 20rpx 22rpx; }
.source-title { display: block; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: 24rpx; line-height: 1.5; font-weight: 650; }
.source-meta { display: block; margin-top: 6rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: 22rpx; line-height: 1.5; color: #7c858e; }
.selection-tip { padding: 0 8rpx; }
/* Skyline 真机横向滚动区需明确占位高度，覆盖封面、编号和间距，避免内容溢出压住后续卡片。 */
.selected-scroll { flex: none; width: 100%; height: 176rpx; white-space: nowrap; }
.selected-strip { display: flex; align-items: flex-start; padding: 8rpx 0 18rpx; }
.selected-item { position: relative; flex: none; width: 116rpx; margin-right: 20rpx; }
.advanced-ai-page .selected-source { display: flex; flex-direction: column; align-items: flex-start; width: 116rpx; text-align: left; font-weight: 400; background: transparent; }
.selected-cover { position: relative; width: 116rpx; height: 98rpx; border-radius: 18rpx; overflow: hidden; background: #e9ece6; }
.selected-thumbnail { display: block; width: 100%; height: 100%; }
.selected-placeholder { display: flex; align-items: center; justify-content: center; width: 100%; height: 100%; font-size: 22rpx; color: #7c858e; }
.source-number { position: absolute; top: 8rpx; left: 8rpx; min-width: 34rpx; height: 34rpx; padding: 0 4rpx; box-sizing: border-box; display: flex; align-items: center; justify-content: center; border-radius: 50%; color: #fff; background: #212529; font-size: 22rpx; line-height: 1; }
.source-kind-mark { position: absolute; right: 6rpx; bottom: 6rpx; width: 32rpx; height: 32rpx; display: flex; align-items: center; justify-content: center; border-radius: 8rpx; font-size: 22rpx; color: #fff; background: rgba(39,60,39,.73); }
.selected-label { display: block; margin-top: 12rpx; font-size: 22rpx; line-height: 1.4; white-space: nowrap; color: #7f8a92; }
.remove-source { position: absolute; right: -8rpx; top: -4rpx; width: 36rpx; height: 36rpx; display: flex; align-items: center; justify-content: center; border-radius: 50%; color: #7c858e; background: #fff; border: 2rpx solid #e9ecef; font-size: 28rpx; box-sizing: border-box; }
.field-label { margin-bottom: 12rpx; font-size: 24rpx; color: #495057; font-weight: 600; line-height: 1.5; }
.prompt-input { display: block; width: 100%; height: 192rpx; padding: 18rpx 22rpx; box-sizing: border-box; border: 2rpx solid #e9ecef; border-radius: 26rpx; font-size: 26rpx; line-height: 1.65; color: #212529; background: #f5f6f7; }
/* 字数使用独立文本节点与显式行高，预留上下空间，避免 Skyline 匿名文本行裁切字形。 */
.counter { display: flex; flex-shrink: 0; align-items: center; justify-content: flex-end; min-height: 44rpx; margin-top: 10rpx; padding: 4rpx 0; box-sizing: border-box; color: #a1a9ae; }
.counter-value { display: block; flex: none; font-size: 22rpx; line-height: 36rpx; white-space: nowrap; }
.counter.over-limit { color: #b55656; }
.prompt-example { display: flex; align-items: center; justify-content: space-between; padding: 8rpx 20rpx; margin-top: 16rpx; border-radius: 22rpx; background: #f4f6f7; }
.advanced-ai-page .text-button { width: auto; min-width: 0; min-height: 44rpx; flex: none; padding: 6rpx 0; background: transparent; color: #495057; font-size: 22rpx; }
.advanced-ai-page .example-button { color: #6c805f; }
.question { margin-top: 28rpx; }
.question-input { box-sizing: border-box; width: 100%; height: 86rpx; padding: 0 24rpx; border: 2rpx solid #e9ecef; border-radius: 26rpx; background: #f5f6f7; color: #212529; font-size: 26rpx; }
.advanced-ai-page .question-option { width: 100%; margin-bottom: 16rpx; }
.advanced-ai-page .question-option.chosen { color: #4e6449; background: #eaf0e7; }
.form-tip { padding: 4rpx 14rpx; }
.summary-text { display: block; margin: 14rpx 0 20rpx; color: #495057; white-space: pre-wrap; overflow-wrap: break-word; word-break: break-word; font-size: 24rpx; line-height: 1.8; }
.token-usage { margin-top: 24rpx; color: #8b939b; font-size: 22rpx; font-weight: 400; text-align: right; line-height: 1.6; }
.generation-panel { padding: 32rpx 24rpx; text-align: center; }
/* 用对称矢量图替代文字星标，避免不同设备的字体基线造成视觉偏移。 */
.generation-mark { width: 72rpx; height: 72rpx; display: flex; align-items: center; justify-content: center; margin: 0 auto 16rpx; border-radius: 24rpx; background: #edf3eb; }
.generation-mark-icon { display: block; flex: none; width: 48rpx; height: 48rpx; }
.generation-panel .help-text { margin-top: 12rpx; }
.page-state { padding: 48rpx 24rpx; text-align: center; color: #7c858e; font-size: 24rpx; line-height: 1.7; }
.ai-footer { flex: none; width: 100%; padding: 20rpx 28rpx calc(24rpx + env(safe-area-inset-bottom)); box-sizing: border-box; border-top: 2rpx solid #e9ecef; background: #fff; }
.ai-footer .selected-strip { padding-top: 0; padding-bottom: 20rpx; }
.footer-actions { display: flex; align-items: center; gap: 18rpx; }
.footer-copy { flex: 1; min-width: 0; font-size: 24rpx; color: #8b969e; }
.footer-count { font-size: 32rpx; color: #354333; font-weight: 650; }
.advanced-ai-page .primary-button, .advanced-ai-page .secondary-button { flex: 1; min-width: 0; min-height: 84rpx; padding: 20rpx 24rpx; border-radius: 44rpx; font-size: 26rpx; line-height: 1.45; }
.advanced-ai-page .primary-button { color: #fff; background: #212529; }
.advanced-ai-page .secondary-button { color: #212529; background: #f1f3f5; }
.advanced-ai-page .next-button { flex: none; min-width: 270rpx; }
.advanced-ai-page .full-width { width: 100%; margin: 20rpx 0 24rpx; }
.ai-spark { margin-right: 12rpx; font-size: 34rpx; line-height: 1; }

/* 附件是描述的选填补充，规格收进选择面板，默认只保留轻量入口。 */
.reference-section { margin-top: 20rpx; padding-top: 18rpx; border-top: 2rpx solid #edf0ed; }
.advanced-ai-page .reference-add { display: flex; align-items: center; justify-content: space-between; width: 100%; min-height: 56rpx; background: transparent; color: #212529; text-align: left; }
.reference-entry-title { display: flex; align-items: center; font-size: 22rpx; font-weight: 650; }
.reference-clip { width: 28rpx; height: 28rpx; margin-right: 12rpx; flex: none; }
.reference-optional { margin-left: 8rpx; font-size: 20rpx; font-weight: 400; color: #8b9490; }
.reference-plus { color: #8d968c; font-size: 28rpx; font-weight: 400; }
.reference-subtitle { display: block; color: #8b9490; font-size: 20rpx; line-height: 1.7; margin-top: 8rpx; white-space: pre-wrap; }
.reference-item { margin-top: 14rpx; padding: 16rpx; border: 2rpx solid #e5e9e2; border-radius: 20rpx; background: #fbfcfa; box-sizing: border-box; }
.reference-top { display: flex; align-items: center; }
.advanced-ai-page .reference-preview { position: relative; flex: none; width: 96rpx; height: 96rpx; margin-right: 20rpx; border-radius: 16rpx; overflow: hidden; background: #eef2ed; font-size: 22rpx; color: #60795a; }
.reference-thumbnail { display: block; width: 100%; height: 100%; }
.reference-number { position: absolute; left: 8rpx; top: 8rpx; z-index: 1; padding: 2rpx 8rpx; border-radius: 8rpx; background: #33402e; color: #fff; font-size: 18rpx; line-height: 1.4; }
.reference-play { position: absolute; left: 50%; top: 50%; transform: translate(-50%, -50%); display: flex; align-items: center; justify-content: center; width: 38rpx; height: 38rpx; border-radius: 50%; background: rgba(255,255,255,.8); }
.reference-play-triangle { width: 0; height: 0; margin-left: 4rpx; border-left: 12rpx solid #354333; border-top: 8rpx solid transparent; border-bottom: 8rpx solid transparent; }
.reference-info { flex: 1; min-width: 0; }
.reference-name { display: block; font-size: 22rpx; font-weight: 600; line-height: 1.5; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.reference-meta { display: block; margin-top: 6rpx; font-size: 18rpx; color: #8d9588; line-height: 1.55; overflow-wrap: break-word; }
.reference-status { display: flex; align-items: center; margin-top: 6rpx; color: #6c805f; font-size: 18rpx; line-height: 1.5; }
.reference-status.warning { color: #977a43; }
.reference-spinner { width: 16rpx; height: 16rpx; margin-right: 8rpx; flex: none; box-sizing: border-box; border: 2rpx solid #d7ddcc; border-top-color: #7e8f71; border-radius: 50%; animation: reference-spin 1s linear infinite; }
@keyframes reference-spin { to { transform: rotate(360deg); } }
.reference-progress { height: 6rpx; margin-top: 12rpx; border-radius: 6rpx; background: #e7eadf; overflow: hidden; }
.reference-progress-fill { height: 100%; background: #849579; }
.advanced-ai-page .reference-remove { flex: none; align-self: flex-start; width: 46rpx; height: 46rpx; margin-left: 10rpx; border-radius: 50%; background: #edf0ea; color: #8a9185; font-size: 32rpx; font-weight: 400; line-height: 1; }
.reference-actions { display: flex; align-items: center; flex-wrap: wrap; margin: 10rpx 0 0 116rpx; }
.reference-actions .text-button { margin-right: 20rpx; min-height: 48rpx; color: #697a60; font-size: 20rpx; font-weight: 400; }
.reference-note { display: block; width: 100%; box-sizing: border-box; height: 112rpx; margin-top: 12rpx; padding: 14rpx 18rpx; border: 2rpx solid #e1e6dc; border-radius: 16rpx; background: #fff; color: #66705f; font-size: 22rpx; line-height: 1.6; }
.reference-error { display: block; margin-top: 10rpx; color: #977a43; font-size: 20rpx; line-height: 1.6; overflow-wrap: break-word; }
.reference-summary { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; margin-top: 16rpx; color: #84907b; font-size: 18rpx; line-height: 1.6; }
.reference-summary .text-button { color: #56684c; font-size: 20rpx; margin-right: 12rpx; }
.reference-warning { margin-top: 20rpx; padding: 18rpx 20rpx; background: #faf4e8; border-radius: 18rpx; color: #977a43; font-size: 20rpx; line-height: 1.65; }
.reference-warning .text-button { color: #977a43; font-size: 20rpx; text-decoration: underline; text-align: left; }
.reference-footer-warning { display: block; margin-bottom: 16rpx; font-size: 20rpx; color: #977a43; line-height: 1.6; }
/* 选择面板独立于主滚动区，保留足够高度展示规格并适配底部安全区。 */
.reference-overlay { position: fixed; z-index: 1000; top: 0; right: 0; bottom: 0; left: 0; display: flex; flex-direction: column; justify-content: flex-end; }
.reference-mask { position: absolute; top: 0; right: 0; bottom: 0; left: 0; background: rgba(18,26,20,.45); }
.reference-sheet { position: relative; width: 100%; max-height: 82vh; display: flex; flex-direction: column; padding: 18rpx 32rpx calc(32rpx + env(safe-area-inset-bottom)); box-sizing: border-box; background: #fff; border-radius: 44rpx 44rpx 0 0; }
.reference-sheet-handle { width: 68rpx; height: 8rpx; flex: none; margin: 2rpx auto 24rpx; border-radius: 8rpx; background: #d9ded5; }
.reference-sheet-heading { display: flex; align-items: center; justify-content: space-between; flex: none; margin-bottom: 16rpx; font-size: 32rpx; font-weight: 650; }
.advanced-ai-page .reference-sheet-close { flex: none; width: 60rpx; height: 60rpx; background: transparent; color: #899281; font-size: 38rpx; font-weight: 400; }
.reference-sheet-scroll { width: 100%; height: 650rpx; min-height: 0; flex-shrink: 1; }
.reference-choices { display: flex; margin: 28rpx 0 20rpx; }
.advanced-ai-page .reference-choice { display: flex; flex: 1; min-width: 0; flex-direction: column; padding: 28rpx 12rpx; border: 2rpx solid #e5e9e0; border-radius: 32rpx; background: #f8faf5; font-size: 24rpx; }
.reference-choice + .reference-choice { margin-left: 20rpx; }
.reference-choice-icon { font-size: 50rpx; font-weight: 400; line-height: 1; color: #7c8f6d; margin-bottom: 16rpx; }
.reference-choice-hint { font-size: 18rpx; font-weight: 400; color: #8b977f; margin-top: 12rpx; }
.reference-sheet-limits { color: #90998a; font-size: 20rpx; line-height: 1.9; }
.reference-sheet-limits text { display: block; }
.reference-example-quote { display: block; margin: 26rpx 0; padding: 26rpx; border-left: 4rpx solid #a5b798; background: #f4f7ef; color: #5c6c51; font-size: 24rpx; line-height: 1.9; }
.reference-example-item { margin-top: 24rpx; }
.advanced-ai-page .reference-use-example { width: 100%; margin-top: 32rpx; }

/* 生成期间完整展示参考重点，保留换行与长文本换行。 */
.reference-readonly-note { display: block; margin-top: 12rpx; color: #66705f; font-size: 22rpx; line-height: 1.6; white-space: pre-wrap; overflow-wrap: break-word; }
