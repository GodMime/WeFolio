<navigation-bar title="团队作品集" back="{{true}}" />
<scroll-view scroll-y class="page-shell"><view wx:if="{{loading}}" class="state">加载中...</view><view wx:elif="{{errorMessage}}" class="state"><text>{{errorMessage}}</text><button bindtap="handleRetry">重新打开</button></view><view wx:elif="{{underMaintenance}}" class="state">该团队作品集维护中</view><view wx:elif="{{empty}}" class="state">暂无展示内容</view><view wx:else class="content"><team-profile wx:for="{{componentBuckets.teamProfile}}" wx:key="componentKey" style="order:{{item.sortOrder}}" team="{{item.data.team}}"/><team-carousel wx:for="{{componentBuckets.carousel}}" wx:key="componentKey" data-key="{{item.componentKey}}" style="order:{{item.sortOrder}}" items="{{item.data.items}}" bindpreview="handleImagePreview"/><team-divider wx:for="{{componentBuckets.divider}}" wx:key="componentKey" style="order:{{item.sortOrder}}" config="{{item.data}}"/><team-member-portfolio-grid wx:for="{{componentBuckets.grid}}" wx:key="componentKey" data-key="{{item.componentKey}}" style="order:{{item.sortOrder}}" items="{{item.data.items}}" bindpreview="handleMemberPortfolio"/><team-member-portfolio-list wx:for="{{componentBuckets.list}}" wx:key="componentKey" data-key="{{item.componentKey}}" style="order:{{item.sortOrder}}" items="{{item.data.items}}" bindpreview="handleMemberPortfolio"/><team-text-section wx:for="{{componentBuckets.text}}" wx:key="componentKey" style="order:{{item.sortOrder}}" config="{{item.data}}"/><team-schedule-query wx:for="{{componentBuckets.schedule}}" wx:key="componentKey" id="schedule-{{item.componentKey}}" style="order:{{item.sortOrder}}" share-code="{{shareCode}}" component-key="{{item.componentKey}}" config="{{item.data}}" result="{{scheduleResults[item.componentKey]}}" bindschedulequery="handleScheduleQuery"/><team-contact-form wx:for="{{componentBuckets.contact}}" wx:key="componentKey" id="contact-form-{{item.componentKey}}" data-key="{{item.componentKey}}" style="order:{{item.sortOrder}}" config="{{item.data}}" form="{{contactForms[item.componentKey]}}" modal-visible="{{contactModalVisible[item.componentKey]}}" submitting="{{contactSubmitting[item.componentKey]}}" bindcontactinput="handleContactInput" bindopenmodal="handleContactOpen" bindclosemodal="handleContactClose" bindsubmit="handleContactSubmit"/><team-qr-contact wx:for="{{componentBuckets.qr}}" wx:key="componentKey" style="order:{{item.sortOrder}}" component-key="{{item.componentKey}}" config="{{item.data}}" visitor-mode="{{true}}" bindinteract="handleQrInteract"/></view><view class="footer">映期 Folio</view></scroll-view><view wx:if="{{visitorProfileAuthVisible}}" class="profile-mask"><view class="profile-panel"><input data-field="nickname" value="{{visitorProfileForm.nickname}}" bindinput="handleProfileInput" placeholder="昵称"/><button bindtap="handleChooseAvatar">选择头像</button><text wx:if="{{visitorProfileForm.avatarPath}}">已选择头像</text><button class="primary" loading="{{visitorProfileSaving}}" bindtap="handleProfileSave">保存资料</button><button bindtap="handleProfileSkip">暂不填写</button></view></view>
