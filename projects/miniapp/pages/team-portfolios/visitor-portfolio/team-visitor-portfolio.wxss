.page-shell{height:100vh;background:#fff;color:#17202a}.content{display:flex;flex-direction:column;min-width:0}.folio-component{display:block;width:100%;min-width:0;margin-top:34rpx;box-sizing:border-box}.state{min-width:0;padding:100rpx 28rpx;text-align:center;color:#5b6775;overflow-wrap:anywhere}.folio-brand-footer{display:flex;flex-direction:column;align-items:center;gap:12rpx;padding:56rpx 0 calc(160rpx + env(safe-area-inset-bottom));box-sizing:border-box}.folio-brand-logo{width:56rpx;height:56rpx}.folio-brand-name{color:#a1a9b3;font-size:24rpx;font-weight:800;line-height:1.4}.profile-mask{position:fixed;inset:0;display:flex;align-items:flex-end;background:rgba(23,32,42,.42)}.profile-panel{display:flex;flex:1;flex-direction:column;gap:16rpx;min-width:0;padding:32rpx;background:#fff;border-radius:16rpx 16rpx 0 0;overflow-wrap:anywhere}.profile-panel input{padding:18rpx;background:#f5f7fb}.primary{background:#0f766e;color:#fff}
