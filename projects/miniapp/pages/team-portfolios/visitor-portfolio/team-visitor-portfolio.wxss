.page-shell{height:100vh;background:#fff;color:#17202a}.content{display:flex;flex-direction:column;gap:20rpx;min-width:0;padding:28rpx}.state{min-width:0;padding:100rpx 28rpx;text-align:center;color:#5b6775;overflow-wrap:anywhere}.footer{min-width:0;padding:48rpx;text-align:center;color:#8a97a3;font-size:24rpx;overflow-wrap:anywhere}.profile-mask{position:fixed;inset:0;display:flex;align-items:flex-end;background:rgba(23,32,42,.42)}.profile-panel{display:flex;flex:1;flex-direction:column;gap:16rpx;min-width:0;padding:32rpx;background:#fff;border-radius:16rpx 16rpx 0 0;overflow-wrap:anywhere}.profile-panel input{padding:18rpx;background:#f5f7fb}.primary{background:#0f766e;color:#fff}
