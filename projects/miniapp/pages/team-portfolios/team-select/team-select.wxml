<navigation-bar title="选择团队" back="{{true}}" />
<view class="page-shell"><view wx:if="{{loading}}" class="state">加载中...</view><view wx:elif="{{errorMessage}}" class="state"><text>{{errorMessage}}</text><button bindtap="handleRetry">重试</button></view><view wx:elif="{{empty}}" class="state">暂无可维护团队</view><block wx:else><view wx:for="{{teams}}" wx:key="teamId" class="team {{selectedTeamId === item.teamId ? 'selected' : ''}}" data-id="{{item.teamId}}" bindtap="handleTeamTap"><image wx:if="{{item.avatarUrl}}" src="{{item.avatarUrl}}"/><text>{{item.teamName}}</text><text>{{item.currentRole}}</text></view><button class="primary" loading="{{creating}}" disabled="{{!selectedTeamId || creating}}" bindtap="handleConfirm">创建作品集</button></block></view>
