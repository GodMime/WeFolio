.page-shell{min-height:100vh;padding:20rpx 32rpx 56rpx;background:#f5f6f7;color:#212529;box-sizing:border-box}.team{display:flex;align-items:center;gap:16rpx;min-width:0;margin-bottom:20rpx;padding:28rpx;background:#fff;border:1rpx solid #e9ecef;border-radius:48rpx;overflow-wrap:anywhere;box-sizing:border-box}.team.selected{border-color:#212529;box-shadow:0 12rpx 32rpx rgba(33,37,41,.08)}.team image{width:72rpx;height:72rpx;border-radius:50%;background:#e9ecef}.team text{min-width:0;overflow-wrap:anywhere}.team text:last-child{margin-left:auto;color:#868e96}.state{min-width:0;padding:80rpx 20rpx;text-align:center;color:#868e96;overflow-wrap:anywhere}.state button,.primary{min-height:84rpx;padding:0 28rpx;border-radius:999rpx}.primary{margin-top:24rpx;background:#212529;color:#fff}
