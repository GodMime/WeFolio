.page-shell{min-height:100vh;padding:28rpx;background:#f5f7fb;color:#17202a}.team{display:flex;align-items:center;gap:16rpx;min-width:0;margin-bottom:16rpx;padding:24rpx;background:#fff;border-radius:12rpx;overflow-wrap:anywhere}.team.selected{outline:3rpx solid #0f766e}.team image{width:64rpx;height:64rpx;border-radius:50%}.team text{min-width:0;overflow-wrap:anywhere}.team text:last-child{margin-left:auto;color:#5b6775}.state{min-width:0;padding:80rpx 20rpx;text-align:center;color:#5b6775;overflow-wrap:anywhere}.primary{margin-top:24rpx;background:#0f766e;color:#fff}
