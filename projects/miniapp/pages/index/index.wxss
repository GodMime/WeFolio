.mine-page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  background-color: #f5f6f7;
}

.mine-scroll {
  flex: 1;
  min-height: 0;
}

.mine-content {
  padding: 20rpx 32rpx 172rpx;
  box-sizing: border-box;
}

.panel {
  background: #ffffff;
  border: 1rpx solid #e9ecef;
  border-radius: 48rpx;
  box-shadow: none;
}

.profile-panel {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  min-height: 150rpx;
  padding: 28rpx;
  box-sizing: border-box;
}

.profile-main {
  display: flex;
  align-items: center;
  min-width: 0;
  gap: 20rpx;
}

.avatar {
  width: 96rpx;
  height: 96rpx;
  flex: none;
  overflow: hidden;
  border-radius: 50%;
  background: #e9ecef;
}

.avatar-image,
.avatar-fallback {
  width: 100%;
  height: 100%;
}

.avatar-fallback {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #f7fbfa;
  font-size: 28rpx;
  font-weight: 700;
  background: #868e96;
}

.profile-text {
  min-width: 0;
}

.profile-name {
  max-width: 360rpx;
  overflow: hidden;
  color: #212529;
  font-size: 32rpx;
  font-weight: 700;
  line-height: 1.35;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.profile-subtitle {
  max-width: 390rpx;
  margin-top: 8rpx;
  overflow: hidden;
  color: #868e96;
  font-size: 24rpx;
  line-height: 1.4;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.code-pill {
  flex: none;
  max-width: 180rpx;
  padding: 12rpx 16rpx;
  overflow: hidden;
  color: #495057;
  font-size: 22rpx;
  font-weight: 700;
  line-height: 1;
  text-overflow: ellipsis;
  white-space: nowrap;
  border-radius: 999rpx;
  border: 1rpx solid #e9ecef;
  background: #ffffff;
}

.balance-band {
  margin-top: 20rpx;
  padding: 28rpx;
  color: #212529;
  border: 1rpx solid #e9ecef;
  border-radius: 48rpx;
  background: #ffffff;
  box-shadow: none;
}

.balance-top,
.balance-bottom,
.panel-heading,
.entry-row,
.tabbar,
.tab {
  display: flex;
  align-items: center;
}

.balance-top,
.balance-bottom,
.panel-heading {
  justify-content: space-between;
}

.balance-top {
  width: 100%;
}

.balance-copy {
  flex: 1;
  min-width: 0;
}

.balance-label {
  color: #868e96;
  font-size: 24rpx;
}

.balance-value {
  margin-top: 8rpx;
  font-size: 64rpx;
  font-weight: 800;
  line-height: 1;
}

.light-button {
  min-width: 128rpx;
  height: 76rpx;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  flex: none;
  margin-left: auto;
  padding: 0 28rpx;
  color: #ffffff;
  font-size: 26rpx;
  font-weight: 800;
  line-height: 1;
  white-space: nowrap;
  border-radius: 999rpx;
  background: #212529;
  box-shadow: none;
  box-sizing: border-box;
}

.balance-bottom {
  margin-top: 20rpx;
  padding-top: 20rpx;
  color: #868e96;
  font-size: 24rpx;
  border-top: 1rpx solid #f1f3f5;
}

.warning-pill {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  padding: 0;
  color: #c08a3e;
  font-size: 22rpx;
  background: transparent;
}

.warning-pill::before {
  width: 12rpx;
  height: 12rpx;
  flex: none;
  content: "";
  border-radius: 50%;
  background: #c08a3e;
}

.metric-grid {
  display: flex;
  gap: 0;
  margin-top: 20rpx;
  padding: 24rpx 0;
  border: 1rpx solid #e9ecef;
  border-radius: 48rpx;
  background: #ffffff;
}

.metric {
  flex: 1 1 0;
  min-width: 0;
  min-height: 0;
  padding: 0 16rpx;
  text-align: center;
  box-sizing: border-box;
  border: 0;
  border-radius: 0;
  background: transparent;
}

.metric + .metric {
  border-left: 1rpx solid #f1f3f5;
}

.metric-value {
  color: #212529;
  font-size: 38rpx;
  font-weight: 800;
  line-height: 1.1;
}

.metric-label {
  margin-top: 12rpx;
  color: #868e96;
  font-size: 22rpx;
  line-height: 1.25;
}

.action-panel {
  margin-top: 20rpx;
  padding: 28rpx;
}

.panel-title {
  color: #212529;
  font-size: 28rpx;
  font-weight: 800;
}

.panel-meta {
  color: #868e96;
  font-size: 22rpx;
}

.entry-list {
  margin-top: 16rpx;
}

.entry-row {
  width: 100%;
  min-height: 118rpx;
  justify-content: flex-start;
  margin: 0;
  padding: 18rpx 0;
  line-height: 1;
  text-align: left;
  border-top: 1rpx solid #f1f3f5;
  border-radius: 0;
  background: transparent;
  box-sizing: border-box;
}

.entry-row:first-child {
  border-top: 0;
}

.entry-row::after {
  border: 0;
}

.entry-icon {
  display: block;
  width: 92rpx;
  height: 92rpx;
  flex: none;
  margin-right: 22rpx;
  border-radius: 22rpx;
}

.entry-arrow::before,
.schedule-tab-icon::before,
.schedule-tab-icon::after,
.work-tab-icon::before,
.work-tab-icon::after,
.portfolio-tab-icon::before,
.portfolio-tab-icon::after,
.mine-tab-icon::before,
.mine-tab-icon::after {
  position: absolute;
  content: "";
  box-sizing: border-box;
}

.entry-copy {
  flex: 1;
  min-width: 0;
}

.entry-side {
  display: flex;
  align-items: center;
  flex: none;
  gap: 12rpx;
  margin-left: 14rpx;
}

.entry-badge {
  min-width: 36rpx;
  height: 36rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 10rpx;
  color: #ffffff;
  font-size: 20rpx;
  font-weight: 800;
  line-height: 1;
  border-radius: 999rpx;
  background: #212529;
  box-sizing: border-box;
}

.entry-title {
  color: #212529;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 1.3;
}

.entry-desc {
  margin-top: 6rpx;
  overflow: hidden;
  color: #868e96;
  font-size: 23rpx;
  line-height: 1.35;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.entry-arrow {
  position: relative;
  width: 28rpx;
  height: 28rpx;
  flex: none;
}

.entry-arrow::before {
  right: 6rpx;
  top: 5rpx;
  width: 16rpx;
  height: 16rpx;
  border-top: 3rpx solid #a7b0ba;
  border-right: 3rpx solid #a7b0ba;
  transform: rotate(45deg);
}

.empty-state {
  min-height: 520rpx;
  padding: 90rpx 36rpx;
  text-align: center;
  box-sizing: border-box;
}

.empty-icon {
  width: 92rpx;
  height: 92rpx;
  margin: 0 auto 26rpx;
  border-radius: 50%;
  background: #dce7e4;
}

.empty-title {
  color: #212529;
  font-size: 32rpx;
  font-weight: 800;
}

.empty-desc {
  margin-top: 12rpx;
  color: #868e96;
  font-size: 24rpx;
  line-height: 1.5;
}

.primary-button {
  color: #fff;
  font-size: 28rpx;
  font-weight: 700;
  border-radius: 999rpx;
  background: #212529;
}

.primary-button.compact {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 176rpx;
  height: 76rpx;
  margin-top: 30rpx;
}

.skeleton-panel {
  min-height: 120rpx;
  border-color: transparent;
  background: linear-gradient(90deg, #eef1f4 0%, #f8fafb 52%, #eef1f4 100%);
  background-size: 400rpx 100%;
  animation: skeleton 1.2s ease-in-out infinite;
}

.tabbar {
  position: fixed;
  left: 28rpx;
  right: 28rpx;
  bottom: calc(28rpx + env(safe-area-inset-bottom));
  z-index: 10;
  height: 116rpx;
  padding: 0;
  justify-content: space-around;
  box-sizing: border-box;
  border: 2rpx solid #e9ecef;
  border-radius: 999rpx;
  background: #ffffff;
  box-shadow: 0 24rpx 56rpx rgba(33, 37, 41, 0.1);
}

.tab {
  position: relative;
  width: 25%;
  height: 116rpx;
  flex-direction: column;
  justify-content: center;
  color: #868e96;
  background: transparent;
}

.tab.active {
  color: #212529;
}

.tab-icon-wrap {
  width: 68rpx;
  height: 52rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #ffffff;
  border-radius: 999rpx;
}

.tab.active .tab-icon-wrap {
  color: #ffffff;
  background: #212529;
}

.tab-icon-image {
  display: block;
  width: 38rpx;
  height: 38rpx;
}

.tab-icon {
  position: relative;
  z-index: 1;
  width: 42rpx;
  height: 42rpx;
}

.schedule-tab-icon::before {
  left: 6rpx;
  top: 6rpx;
  width: 30rpx;
  height: 30rpx;
  border: 4rpx solid currentColor;
  border-radius: 10rpx;
}

.schedule-tab-icon::after {
  left: 12rpx;
  top: 18rpx;
  width: 18rpx;
  height: 4rpx;
  border-radius: 999rpx;
  background: currentColor;
}

.work-tab-icon::before {
  left: 6rpx;
  top: 6rpx;
  width: 30rpx;
  height: 30rpx;
  border: 4rpx solid currentColor;
  border-radius: 10rpx;
}

.work-tab-icon::after {
  left: 13rpx;
  bottom: 11rpx;
  width: 18rpx;
  height: 14rpx;
  border-left: 4rpx solid currentColor;
  border-bottom: 4rpx solid currentColor;
  transform: rotate(-45deg);
  transform-origin: center;
}

.portfolio-tab-icon::before {
  left: 10rpx;
  top: 8rpx;
  width: 28rpx;
  height: 28rpx;
  border: 4rpx solid currentColor;
  border-radius: 8rpx;
  background: rgba(255, 255, 255, 0.96);
  z-index: 2;
}

.portfolio-tab-icon::after {
  left: 4rpx;
  top: 14rpx;
  width: 28rpx;
  height: 28rpx;
  border: 4rpx solid currentColor;
  border-radius: 8rpx;
  z-index: 1;
}

.mine-tab-icon::before {
  left: 13rpx;
  top: 6rpx;
  width: 16rpx;
  height: 16rpx;
  border: 4rpx solid currentColor;
  border-radius: 50%;
}

.mine-tab-icon::after {
  left: 6rpx;
  bottom: 6rpx;
  width: 30rpx;
  height: 16rpx;
  border: 4rpx solid currentColor;
  border-bottom-width: 3rpx;
  border-radius: 20rpx 20rpx 8rpx 8rpx;
}

.tab-label {
  position: relative;
  z-index: 1;
  margin-top: 4rpx;
  font-size: 18rpx;
  font-weight: 500;
  line-height: 1.2;
}

@keyframes skeleton {
  0% {
    background-position: -320rpx 0;
  }
  100% {
    background-position: 320rpx 0;
  }
}
