.unavailable-page {
  background: #f5f7fb;
}

.unavailable-card {
  margin: 28rpx;
  padding: 40rpx 28rpx;
  background: #ffffff;
  border-radius: 12rpx;
  border: 1rpx solid #e2e8f0;
}

.unavailable-title {
  font-size: 36rpx;
  font-weight: 800;
}

.unavailable-desc {
  margin-top: 16rpx;
  color: #6b7787;
  line-height: 1.6;
}
