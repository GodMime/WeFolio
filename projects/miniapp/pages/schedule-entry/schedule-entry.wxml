<view class="page-shell schedule-entry-page">
  <navigation-bar title="维护档期" back="{{true}}" color="#17202a" background="rgba(245, 247, 251, 0.94)"></navigation-bar>

  <scroll-view class="entry-scroll" scroll-y type="list">
    <view class="entry-content">
      <block wx:if="{{loading}}">
        <view class="panel skeleton-panel"></view>
        <view class="panel skeleton-panel tall"></view>
      </block>

      <block wx:elif="{{errorMessage}}">
        <view class="empty-state">
          <view class="empty-icon"></view>
          <view class="empty-title">加载失败</view>
          <view class="empty-desc">{{errorMessage}}</view>
          <button class="primary-button compact" bindtap="handleRetry">重试</button>
        </view>
      </block>

      <block wx:else>
        <view class="panel date-panel">
          <view class="panel-heading">
            <view>
              <view class="panel-title">{{overview.selectedDate.titleText}}</view>
              <view class="panel-meta">从已定义档位中选择当天档期，并记录联系人和档期备注</view>
            </view>
            <view class="count-pill">{{overview.selectedDate.schedules.length}} 条</view>
          </view>
        </view>

        <view class="panel">
          <view class="panel-heading">
            <view class="panel-title">选择档位定义</view>
            <view class="panel-meta">不在这里修改时间颜色</view>
          </view>
          <view class="slot-grid">
            <view
              wx:for="{{overview.slotDefinitions}}"
              wx:key="id"
              class="slot-card {{form.slotDefinitionId === item.id ? 'active' : ''}} {{item.enabled ? '' : 'disabled'}}"
              data-id="{{item.id}}"
              bindtap="handleSlotTap"
            >
              <view class="slot-card-top">
                <view class="slot-name">{{item.name}}</view>
                <view class="swatch" style="{{item.colorStyle}}"></view>
              </view>
              <view class="slot-time">{{item.timeRangeText}}</view>
            </view>
          </view>
          <view wx:if="{{overview.slotDefinitions.length === 0}}" class="inline-empty">
            <view class="empty-title small">暂无可选档位</view>
            <view class="empty-desc">请先回到档期页新增档位定义</view>
          </view>
        </view>

        <view class="panel">
          <view class="panel-heading">
            <view class="panel-title">本条档期信息</view>
            <view class="status-pill">{{form.status}}</view>
          </view>

          <view class="field-label standalone">档位状态</view>
          <view class="status-row">
            <view
              wx:for="{{statusOptions}}"
              wx:key="value"
              class="status-choice {{form.status === item.value ? 'active' : ''}} {{item.tone}}"
              data-status="{{item.value}}"
              bindtap="handleStatusTap"
            >{{item.text}}</view>
          </view>

          <view class="form-grid">
            <view class="form-row">
              <view class="field-label">联系人姓名</view>
              <input class="field-input" value="{{form.contactName}}" maxlength="50" data-field="contactName" bindinput="handleInput" placeholder="如 陈女士" />
              <view class="counter">{{counters.contactName}}</view>
            </view>
            <view class="form-row">
              <view class="field-label">联系电话</view>
              <input class="field-input" value="{{form.contactPhone}}" maxlength="50" data-field="contactPhone" bindinput="handleInput" placeholder="手机号 / 微信号" />
              <view class="counter">{{counters.contactPhone}}</view>
            </view>
          </view>

          <view class="form-row full">
            <view class="field-label">档期备注</view>
            <textarea class="field-input textarea" value="{{form.note}}" maxlength="1000" data-field="note" bindinput="handleInput" placeholder="仅维护者可见，访客端不展示"></textarea>
            <view class="counter">{{counters.note}}</view>
          </view>

          <view class="cost-note">访客端仅展示日期、档位名称、时间段和可约状态。</view>
        </view>

        <view class="button-row">
          <button class="secondary-button" loading="{{deleting}}" bindtap="handleDelete">删除本条</button>
          <button class="primary-button" loading="{{saving}}" bindtap="handleSave">保存档期</button>
        </view>
      </block>
    </view>
  </scroll-view>
</view>
