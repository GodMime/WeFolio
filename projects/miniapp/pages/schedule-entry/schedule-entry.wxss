.schedule-entry-page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  background-color: #f5f7fb;
}

.entry-scroll {
  flex: 1;
  min-height: 0;
}

.entry-content {
  padding: 28rpx 28rpx calc(42rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.panel {
  margin-top: 22rpx;
  padding: 24rpx;
  border: 1rpx solid rgba(23, 32, 42, 0.06);
  border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.94);
  box-shadow: 0 18rpx 48rpx rgba(23, 32, 42, 0.06);
  box-sizing: border-box;
}

.date-panel {
  margin-top: 0;
}

.panel-heading,
.slot-card-top,
.slot-grid,
.status-row,
.form-grid,
.button-row {
  display: flex;
  align-items: center;
}

.panel-heading,
.slot-card-top,
.button-row {
  justify-content: space-between;
}

.panel-title {
  color: #17202a;
  font-size: 28rpx;
  font-weight: 800;
  line-height: 1.3;
}

.panel-meta,
.empty-desc,
.slot-time,
.counter,
.cost-note {
  color: #758190;
  font-size: 23rpx;
  line-height: 1.4;
}

.count-pill,
.status-pill {
  flex: none;
  padding: 8rpx 14rpx;
  color: #0f766e;
  font-size: 22rpx;
  font-weight: 800;
  line-height: 1;
  border-radius: 999rpx;
  background: #dcf7f1;
}

.slot-grid {
  display: flex;
  flex-wrap: wrap;
  align-items: stretch;
  gap: 16rpx;
  margin-top: 18rpx;
}

.slot-card {
  width: calc(50% - 8rpx);
  min-height: 126rpx;
  padding: 20rpx;
  border: 2rpx solid #e1e8ef;
  border-radius: 16rpx;
  background: #f7fafc;
  box-sizing: border-box;
}

.slot-card.active {
  border-color: #17202a;
  background: #eef4f3;
}

.slot-card.disabled {
  opacity: 0.48;
}

.slot-name {
  min-width: 0;
  overflow: hidden;
  color: #17202a;
  font-size: 27rpx;
  font-weight: 800;
  line-height: 1.3;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.swatch {
  width: 22rpx;
  height: 22rpx;
  flex: none;
  border-radius: 50%;
}

.slot-time {
  margin-top: 16rpx;
}

.field-label {
  color: #758190;
  font-size: 22rpx;
  font-weight: 700;
}

.field-label.standalone {
  margin-top: 20rpx;
}

.status-row {
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 12rpx;
}

.status-choice {
  height: 58rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 22rpx;
  color: #66727f;
  font-size: 24rpx;
  font-weight: 800;
  border-radius: 999rpx;
  background: #eef2f6;
}

.status-choice.active.teal {
  color: #0f766e;
  background: #dcf7f1;
}

.status-choice.active.amber {
  color: #8a4b09;
  background: #fff0d7;
}

.status-choice.active.rose {
  color: #a9354f;
  background: #fde7ed;
}

.status-choice.active.muted {
  color: #44505c;
  background: #e8edf2;
}

.form-grid {
  gap: 16rpx;
  margin-top: 22rpx;
}

.form-row {
  flex: 1 1 0;
  min-width: 0;
}

.form-row.full {
  margin-top: 22rpx;
}

.field-input {
  width: 100%;
  height: 76rpx;
  margin-top: 10rpx;
  padding: 0 18rpx;
  color: #17202a;
  font-size: 26rpx;
  border-radius: 14rpx;
  background: #f5f8fb;
  box-sizing: border-box;
}

.field-input.textarea {
  min-height: 168rpx;
  padding-top: 18rpx;
  line-height: 1.45;
}

.counter {
  margin-top: 8rpx;
  text-align: right;
}

.cost-note {
  margin-top: 22rpx;
  padding: 18rpx;
  border-radius: 14rpx;
  background: #fff8ea;
}

.button-row {
  gap: 16rpx;
  margin-top: 22rpx;
}

.primary-button,
.secondary-button {
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 1 1 0;
  min-width: 0;
  margin: 0;
  font-size: 28rpx;
  font-weight: 800;
  border-radius: 18rpx;
}

.primary-button {
  color: #ffffff;
  background: #17202a;
}

.secondary-button {
  color: #a9354f;
  border: 1rpx solid #f0c5cf;
  background: #fff5f7;
}

.primary-button.compact {
  display: inline-flex;
  min-width: 176rpx;
  height: 76rpx;
  margin-top: 30rpx;
  padding: 0 30rpx;
  flex: none;
}

.primary-button::after,
.secondary-button::after {
  border: 0;
}

.inline-empty,
.empty-state {
  padding: 72rpx 28rpx;
  text-align: center;
  box-sizing: border-box;
}

.empty-state {
  min-height: 520rpx;
}

.empty-icon {
  width: 92rpx;
  height: 92rpx;
  margin: 0 auto 26rpx;
  border-radius: 50%;
  background: #dce7e4;
}

.empty-title {
  color: #17202a;
  font-size: 32rpx;
  font-weight: 800;
}

.empty-title.small {
  font-size: 28rpx;
}

.skeleton-panel {
  min-height: 120rpx;
  border-color: transparent;
  background: linear-gradient(90deg, #eef1f4 0%, #f8fafb 52%, #eef1f4 100%);
  background-size: 400rpx 100%;
  animation: skeleton 1.2s ease-in-out infinite;
}

.skeleton-panel.tall {
  min-height: 560rpx;
}

@keyframes skeleton {
  0% {
    background-position: -320rpx 0;
  }
  100% {
    background-position: 320rpx 0;
  }
}
