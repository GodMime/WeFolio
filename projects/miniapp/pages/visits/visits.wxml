<view class="page-shell visits-page">
  <navigation-bar title="访问记录" back="{{true}}" color="#17202a" background="rgba(245, 247, 251, 0.94)"></navigation-bar>

  <scroll-view class="visits-scroll" scroll-y type="list">
    <view class="visits-content">
      <block wx:if="{{loading}}">
        <view class="metric-grid">
          <view class="metric skeleton-panel"></view>
          <view class="metric skeleton-panel"></view>
          <view class="metric skeleton-panel"></view>
        </view>
        <view class="panel trend-panel skeleton-panel"></view>
        <view class="panel visit-detail-panel skeleton-panel"></view>
      </block>

      <block wx:elif="{{errorMessage}}">
        <view class="empty-state">
          <view class="empty-icon"></view>
          <view class="empty-title">加载失败</view>
          <view class="empty-desc">{{errorMessage}}</view>
          <button class="primary-button compact" bindtap="handleRetry">重试</button>
        </view>
      </block>

      <block wx:else>
        <view class="metric-grid">
          <view class="metric" wx:for="{{visitData.metrics}}" wx:key="label">
            <view class="metric-value">{{item.value}}</view>
            <view class="metric-label">{{item.label}}</view>
          </view>
        </view>

        <view class="panel trend-panel">
          <view class="panel-heading">
            <view class="section-title">近 7 日访问趋势</view>
            <view class="trend-pill">{{visitData.trend.changeText}}</view>
          </view>
          <view class="trend-bars">
            <view class="trend-column" wx:for="{{visitData.trend.points}}" wx:key="label">
              <view class="trend-track">
                <view class="trend-fill" style="height: {{item.height}}%;"></view>
              </view>
              <view class="trend-label">{{item.label}}</view>
            </view>
          </view>
        </view>

        <view class="panel visit-detail-panel">
          <view class="panel-heading">
            <view class="section-title">访问明细</view>
            <view class="panel-desc">来源与行为摘要</view>
          </view>
          <view class="visit-list" wx:if="{{visitData.records.length}}">
            <view class="visit-row" wx:for="{{visitData.records}}" wx:key="id">
              <view class="visitor-icon {{item.followTone}}">{{item.visitorInitial}}</view>
              <view class="visit-copy">
                <view class="visitor-name">{{item.visitorLabel}}</view>
                <view class="visit-source">{{item.sourceText}}</view>
                <view class="visit-summary">{{item.summaryText}}</view>
              </view>
              <view class="{{item.followToneClass}}">{{item.followStatusText}}</view>
            </view>
          </view>
          <view wx:else class="visit-empty">
            <view class="empty-title small">暂无访问记录</view>
            <view class="empty-desc">作品集被打开后会在这里展示访客来源和行为摘要。</view>
          </view>
        </view>
      </block>
    </view>
  </scroll-view>
</view>
