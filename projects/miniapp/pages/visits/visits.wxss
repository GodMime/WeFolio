.visits-page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  background-color: #f5f7fb;
}

.visits-scroll {
  flex: 1;
  min-height: 0;
}

.visits-content {
  padding: 28rpx;
  box-sizing: border-box;
}

.panel {
  background: rgba(255, 255, 255, 0.94);
  border: 1rpx solid rgba(23, 32, 42, 0.06);
  border-radius: 16rpx;
  box-shadow: 0 18rpx 48rpx rgba(23, 32, 42, 0.06);
  box-sizing: border-box;
}

.metric-grid {
  display: flex;
  gap: 16rpx;
}

.metric {
  flex: 1 1 0;
  min-width: 0;
  min-height: 136rpx;
  padding: 24rpx 12rpx;
  text-align: center;
  border: 1rpx solid rgba(23, 32, 42, 0.06);
  border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.94);
  box-sizing: border-box;
}

.metric-value {
  color: #17202a;
  font-size: 38rpx;
  font-weight: 800;
  line-height: 1.1;
}

.metric-label {
  margin-top: 12rpx;
  color: #758190;
  font-size: 22rpx;
  line-height: 1.25;
}

.trend-panel,
.visit-detail-panel {
  margin-top: 22rpx;
  padding: 24rpx;
}

.panel-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.section-title {
  color: #17202a;
  font-size: 28rpx;
  font-weight: 800;
  line-height: 1.35;
}

.panel-desc {
  flex: none;
  color: #8b96a3;
  font-size: 22rpx;
  line-height: 1.3;
}

.trend-pill,
.follow-pill {
  flex: none;
  padding: 8rpx 14rpx;
  font-size: 22rpx;
  font-weight: 800;
  line-height: 1;
  border-radius: 999rpx;
  box-sizing: border-box;
}

.trend-pill {
  color: #0f766e;
  background: #dcf7f1;
}

.trend-chart {
  width: 100%;
  height: 156rpx;
  margin-top: 24rpx;
}

.trend-line-canvas {
  width: 100%;
  height: 156rpx;
  display: block;
}

.trend-label-row {
  display: flex;
  gap: 8rpx;
  margin-top: 8rpx;
}

.trend-label {
  flex: 1 1 0;
  min-width: 0;
  color: #8b96a3;
  font-size: 20rpx;
  line-height: 1;
  text-align: center;
  white-space: nowrap;
}

.visit-detail-panel {
  padding-bottom: 12rpx;
}

.visit-list {
  max-height: 660rpx;
  margin-top: 10rpx;
  overflow-y: auto;
}

.visit-row {
  display: flex;
  gap: 18rpx;
  align-items: center;
  min-height: 128rpx;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #edf1f5;
  box-sizing: border-box;
}

.visit-row:last-child {
  border-bottom: 0;
}

.visitor-icon {
  width: 76rpx;
  height: 76rpx;
  flex: none;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #536b82;
  font-size: 28rpx;
  font-weight: 900;
  line-height: 1;
  border-radius: 50%;
  background: #eaf0f6;
  box-shadow: 0 10rpx 26rpx rgba(83, 107, 130, 0.18);
}

.visitor-icon.rose {
  color: #b84a62;
  background: #ffe9ef;
}

.visitor-icon.teal {
  color: #0f766e;
  background: #dcf7f1;
}

.visitor-icon.blue {
  color: #2d5f9a;
  background: #e6efff;
}

.visit-copy {
  flex: 1;
  min-width: 0;
}

.visitor-name {
  overflow: hidden;
  color: #17202a;
  font-size: 28rpx;
  font-weight: 800;
  line-height: 1.28;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.visit-source,
.visit-summary {
  overflow: hidden;
  color: #758190;
  font-size: 22rpx;
  line-height: 1.38;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.visit-source {
  margin-top: 6rpx;
}

.visit-summary {
  margin-top: 4rpx;
}

.follow-pill {
  max-width: 116rpx;
  overflow: hidden;
  text-align: center;
  text-overflow: ellipsis;
  white-space: nowrap;
  color: #536b82;
  background: #eaf0f6;
}

.follow-pill.rose {
  color: #a9354f;
  background: #ffe9ef;
}

.follow-pill.teal {
  color: #0f766e;
  background: #dcf7f1;
}

.follow-pill.blue {
  color: #2d5f9a;
  background: #e6efff;
}

.visit-empty,
.empty-state {
  min-height: 420rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
  text-align: center;
  box-sizing: border-box;
}

.visit-empty {
  min-height: 260rpx;
}

.empty-icon {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: #dfe8e5;
}

.empty-title {
  margin-top: 24rpx;
  color: #17202a;
  font-size: 30rpx;
  font-weight: 800;
  line-height: 1.3;
}

.empty-title.small {
  margin-top: 0;
  font-size: 28rpx;
}

.empty-desc {
  margin-top: 10rpx;
  color: #778392;
  font-size: 24rpx;
  line-height: 1.55;
}

.primary-button {
  min-width: 180rpx;
  min-height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 22rpx;
  padding: 0 28rpx;
  color: #fff;
  font-size: 24rpx;
  font-weight: 800;
  line-height: 1;
  border-radius: 16rpx;
  background: #17202a;
  box-sizing: border-box;
}

.primary-button::after {
  border: 0;
}

.skeleton-panel {
  min-height: 136rpx;
  border-color: transparent;
  background: linear-gradient(90deg, #eef2f6 0%, #f7f9fc 48%, #eef2f6 100%);
  background-size: 280% 100%;
  animation: skeleton-loading 1.4s ease-in-out infinite;
}

.trend-panel.skeleton-panel {
  min-height: 260rpx;
}

.visit-detail-panel.skeleton-panel {
  min-height: 380rpx;
}

@keyframes skeleton-loading {
  0% {
    background-position: 100% 50%;
  }
  100% {
    background-position: 0 50%;
  }
}
