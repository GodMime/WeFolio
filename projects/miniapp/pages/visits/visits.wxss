.visits-page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  background-color: #f5f6f7;
}

.visits-scroll {
  flex: 1;
  min-height: 0;
}

.visits-content {
  padding: 20rpx 32rpx calc(56rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.panel {
  background: #ffffff;
  border: 1rpx solid #e9ecef;
  border-radius: 48rpx;
  box-shadow: 0 18rpx 48rpx rgba(33, 37, 41, 0.06);
  box-sizing: border-box;
}

.metric-grid {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.metric-row {
  display: flex;
  overflow: hidden;
  border: 1rpx solid #e9ecef;
  border-radius: 40rpx;
  background: #ffffff;
  box-sizing: border-box;
}

.metric-cell {
  position: relative;
  flex: 1 1 0;
  width: 50%;
  min-width: 0;
  box-sizing: border-box;
}

.metric-divider {
  position: absolute;
  top: 24rpx;
  bottom: 24rpx;
  left: 0;
  z-index: 1;
  width: 1rpx;
  background: #e9ecef;
}

.metric {
  width: 100%;
  height: 100%;
  min-width: 0;
  min-height: 136rpx;
  padding: 24rpx 12rpx;
  text-align: center;
  border: 0;
  border-radius: 0;
  background: transparent;
  box-sizing: border-box;
}

.metric.interactive:active {
  opacity: 0.78;
}

.metric-cell.interactive:active .metric {
  opacity: 0.78;
}

.metric-arrow {
  position: absolute;
  top: 50%;
  right: 24rpx;
  width: 16rpx;
  height: 16rpx;
  border-top: 4rpx solid #ced4da;
  border-right: 4rpx solid #ced4da;
  box-sizing: border-box;
  transform: translateY(-50%) rotate(45deg);
  pointer-events: none;
}

.metric-value {
  color: #212529;
  font-size: 38rpx;
  font-weight: 800;
  line-height: 1.1;
}

.metric-label {
  margin-top: 12rpx;
  color: #868e96;
  font-size: 22rpx;
  line-height: 1.25;
}

.trend-panel,
.visit-detail-panel {
  margin-top: 22rpx;
  padding: 24rpx;
}

.panel-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.section-title {
  color: #212529;
  font-size: 28rpx;
  font-weight: 800;
  line-height: 1.35;
}

.panel-desc {
  flex: none;
  color: #868e96;
  font-size: 22rpx;
  line-height: 1.3;
}

.trend-pill,
.follow-pill {
  flex: none;
  padding: 8rpx 14rpx;
  font-size: 22rpx;
  font-weight: 800;
  line-height: 1;
  border-radius: 999rpx;
  box-sizing: border-box;
}

.trend-pill {
  color: #5c9e6e;
  background: #eef6f0;
}

.trend-chart {
  width: 100%;
  height: 156rpx;
  margin-top: 24rpx;
}

.trend-line-image {
  width: 646rpx;
  max-width: 100%;
  height: 156rpx;
  display: block;
  margin: 0 auto;
}

.trend-label-row {
  display: flex;
  gap: 8rpx;
  margin-top: 8rpx;
}

.trend-label {
  flex: 1 1 0;
  min-width: 0;
  color: #868e96;
  font-size: 20rpx;
  line-height: 1;
  text-align: center;
  white-space: nowrap;
}

.visit-detail-panel {
  padding-bottom: 12rpx;
}

.visit-list {
  margin-top: 10rpx;
}

.visit-record-load-more {
  padding: 22rpx 0 8rpx;
  color: #8b96a3;
  font-size: 22rpx;
  line-height: 1.4;
  text-align: center;
}

.visit-swipe-row {
  position: relative;
  overflow: hidden;
}

.visit-follow-pane {
  position: absolute;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 1;
  width: 168rpx;
  display: flex;
  align-items: stretch;
  justify-content: center;
  background: #212529;
  transform: translateX(100%);
  opacity: 0;
  pointer-events: none;
  transition: transform 180ms ease, opacity 120ms ease;
}

.visit-follow-button {
  width: 168rpx;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0;
  padding: 0 14rpx;
  color: #ffffff;
  font-size: 22rpx;
  font-weight: 900;
  line-height: 1.18;
  border: 0;
  border-radius: 0;
  background: #212529;
  box-shadow: none;
  box-sizing: border-box;
}

.visit-follow-button-label {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 2rpx;
}

.visit-swipe-row.revealed .visit-follow-pane {
  transform: translateX(0);
  opacity: 1;
  pointer-events: auto;
}

.visit-row {
  position: relative;
  z-index: 2;
  display: flex;
  gap: 18rpx;
  align-items: center;
  min-height: 128rpx;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #e9ecef;
  background: #ffffff;
  box-sizing: border-box;
  transition: transform 180ms ease;
}

.visit-row:active {
  opacity: 0.78;
}

.visit-swipe-row.revealed .visit-row {
  transform: translateX(-168rpx);
}

.visit-swipe-row:last-child .visit-row {
  border-bottom: 0;
}

.visitor-icon,
.visitor-avatar {
  width: 76rpx;
  height: 76rpx;
  flex: none;
  border-radius: 50%;
}

.visitor-icon {
  width: 76rpx;
  height: 76rpx;
  flex: none;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #6c757d;
  font-size: 28rpx;
  font-weight: 900;
  line-height: 1;
  border-radius: 50%;
  background: #e9ecef;
  box-shadow: 0 10rpx 26rpx rgba(33, 37, 41, 0.08);
}

.visitor-avatar {
  display: block;
  background: #e9ecef;
  box-shadow: 0 10rpx 26rpx rgba(33, 37, 41, 0.08);
}

.visitor-icon.rose {
  color: #6c757d;
  background: #e9ecef;
}

.visitor-icon.teal {
  color: #6c757d;
  background: #e9ecef;
}

.visitor-icon.blue {
  color: #6c757d;
  background: #e9ecef;
}

.visit-copy {
  flex: 1;
  min-width: 0;
}

.visitor-name {
  overflow: hidden;
  color: #212529;
  font-size: 28rpx;
  font-weight: 800;
  line-height: 1.28;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.visit-source,
.visit-summary {
  overflow: hidden;
  color: #868e96;
  font-size: 22rpx;
  line-height: 1.38;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.visit-source {
  margin-top: 6rpx;
}

.visit-summary {
  margin-top: 4rpx;
}

.follow-pill {
  max-width: 116rpx;
  overflow: hidden;
  text-align: center;
  text-overflow: ellipsis;
  white-space: nowrap;
  color: #6c757d;
  background: #e9ecef;
}

.follow-pill.rose {
  color: #b55656;
  background: #fbefef;
}

.follow-pill.teal {
  color: #5c9e6e;
  background: #eef6f0;
}

.follow-pill.blue {
  color: #212529;
  background: #f1f3f5;
}

.visit-row .follow-pill {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 0;
  border-radius: 0;
  background: transparent;
}

.visit-follow-status-dot {
  width: 12rpx;
  height: 12rpx;
  flex: none;
  border-radius: 50%;
  background: #6c757d;
}

.follow-pill.rose .visit-follow-status-dot {
  background: #b55656;
}

.follow-pill.teal .visit-follow-status-dot {
  background: #5c9e6e;
}

.follow-pill.blue .visit-follow-status-dot {
  background: #212529;
}

.visit-event-sheet-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 90;
  display: flex;
  align-items: flex-end;
  justify-content: center;
  padding: 0;
  background: rgba(17, 24, 39, 0.42);
  box-sizing: border-box;
}

.visit-detail-sheet-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 90;
  display: flex;
  align-items: flex-end;
  justify-content: center;
  padding: 0;
  background: rgba(17, 24, 39, 0.42);
  box-sizing: border-box;
}

.visit-event-sheet-panel {
  width: 100%;
  height: 84vh;
  max-height: calc(100vh - 56rpx);
  display: flex;
  flex-direction: column;
  padding: 24rpx 32rpx calc(32rpx + env(safe-area-inset-bottom));
  overflow: hidden;
  border-radius: 56rpx 56rpx 0 0;
  background: #ffffff;
  box-shadow: 0 -18rpx 52rpx rgba(17, 24, 39, 0.22);
  box-sizing: border-box;
}

.visit-detail-sheet-panel {
  width: 100%;
  height: 84vh;
  max-height: calc(100vh - 56rpx);
  display: flex;
  flex-direction: column;
  padding: 24rpx 32rpx calc(32rpx + env(safe-area-inset-bottom));
  overflow: hidden;
  border-radius: 56rpx 56rpx 0 0;
  background: #ffffff;
  box-shadow: 0 -18rpx 52rpx rgba(17, 24, 39, 0.22);
  box-sizing: border-box;
}

.sheet-grabber {
  width: 72rpx;
  height: 8rpx;
  flex: none;
  margin: 0 auto 22rpx;
  border-radius: 999rpx;
  background: #dee2e6;
}

.visit-event-heading {
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.visit-detail-sheet-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #e9ecef;
}

.event-avatar {
  box-shadow: none;
}

.visit-event-heading-copy {
  flex: 1;
  min-width: 0;
}

.visit-event-close {
  width: 58rpx;
  height: 58rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
  color: #59636f;
  font-size: 36rpx;
  font-weight: 700;
  line-height: 1;
  border-radius: 50%;
  background: #f3f4f6;
}

.visit-event-summary-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-top: 18rpx;
  padding: 16rpx 0 20rpx;
  border-bottom: 1rpx solid #edf1f5;
}

.visit-event-meta {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  color: #868e96;
  font-size: 22rpx;
  line-height: 1.3;
  text-align: right;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.visit-event-list {
  flex: 1;
  min-height: 0;
}

.visit-detail-sheet-list {
  flex: 1;
  min-height: 0;
}

.visit-event-item {
  display: flex;
  gap: 18rpx;
  padding: 22rpx 0;
  border-bottom: 1rpx solid #e9ecef;
  box-sizing: border-box;
}

.visit-detail-sheet-item {
  padding: 24rpx 0;
  border-bottom: 1rpx solid #e9ecef;
  box-sizing: border-box;
}

.visit-detail-sheet-item:last-child {
  border-bottom: 0;
}

.visit-detail-item-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.visit-detail-person {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.detail-avatar {
  width: 64rpx;
  height: 64rpx;
  font-size: 24rpx;
  box-shadow: none;
}

.visit-detail-main-copy {
  flex: 1;
  min-width: 0;
}

.detail-status {
  max-width: 148rpx;
  flex: none;
  display: flex;
  align-items: center;
  gap: 8rpx;
  overflow: hidden;
  padding: 0;
  font-size: 22rpx;
  font-weight: 800;
  line-height: 1;
  text-align: center;
  text-overflow: ellipsis;
  white-space: nowrap;
  border: 0;
  background: transparent;
  box-sizing: border-box;
}

.detail-status.rose {
  color: #b55656;
}

.detail-status.teal {
  color: #5c9e6e;
}

.detail-status-dot {
  width: 12rpx;
  height: 12rpx;
  flex: none;
  border-radius: 50%;
  background: currentColor;
}

.contact-lead-layout {
  position: relative;
  display: flex;
  align-items: stretch;
  gap: 18rpx;
  padding-right: 190rpx;
}

.contact-lead-main {
  flex: 1;
  min-width: 0;
}

.contact-lead-title-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.contact-lead-title-row .visitor-name {
  flex: 0 1 auto;
  min-width: 0;
}

.contact-lead-status {
  position: absolute;
  top: 0;
  right: 0;
  flex: none;
  max-width: 156rpx;
  display: flex;
  justify-content: flex-end;
  z-index: 1;
}

.contact-lead-status .follow-pill {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  padding: 0;
  font-size: 25rpx;
  border-radius: 0;
  background: transparent;
}

.contact-lead-status-dot {
  width: 12rpx;
  height: 12rpx;
  flex: none;
  border-radius: 50%;
  background: currentColor;
}

.contact-lead-action-column {
  position: absolute;
  top: 0;
  right: 14rpx;
  bottom: 0;
  flex: none;
  width: 176rpx;
  max-width: 176rpx;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  justify-content: center;
  gap: 8rpx;
}

.contact-method-list {
  margin-top: 14rpx;
}

.contact-method-row {
  min-height: 46rpx;
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.contact-method-row + .contact-method-row {
  margin-top: 8rpx;
}

.contact-method-copy {
  flex: 0 1 auto;
  max-width: 100%;
  min-width: 0;
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.contact-method-label {
  flex: none;
  width: 42rpx;
  color: #868e96;
  font-size: 22rpx;
  line-height: 1.35;
}

.contact-value-copy {
  flex: none;
  max-width: calc(100% - 52rpx);
  min-width: 0;
  display: inline-flex;
  align-items: center;
  gap: 4rpx;
}

.contact-method-value {
  flex: 0 1 auto;
  min-width: 0;
  overflow: hidden;
  color: #212529;
  font-size: 25rpx;
  font-weight: 800;
  line-height: 1.35;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.contact-copy-icon-button {
  flex: none;
  width: 38rpx;
  min-width: 38rpx;
  max-width: 38rpx;
  height: 38rpx;
  min-height: 38rpx;
  max-height: 38rpx;
  margin: 0;
  padding: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  font-size: 0;
  line-height: 1;
  border: 0;
  border-radius: 8rpx;
  background: transparent;
  box-sizing: border-box;
}

.contact-copy-icon-button::after {
  border: 0;
}

.contact-copy-icon {
  width: 30rpx;
  height: 30rpx;
  display: block;
}

.contact-detail-list {
  margin-top: 14rpx;
}

.contact-detail-row {
  min-height: 42rpx;
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
}

.contact-detail-row + .contact-detail-row {
  margin-top: 6rpx;
}

.contact-detail-label {
  flex: none;
  width: 112rpx;
  color: #868e96;
  font-size: 22rpx;
  line-height: 1.45;
}

.contact-detail-value {
  min-width: 0;
  color: #495057;
  font-size: 22rpx;
  line-height: 1.45;
  overflow-wrap: anywhere;
}

.contact-portfolio-value {
  min-width: 0;
  flex: 1;
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 8rpx;
}

.portfolio-type-tag {
  flex: none;
  padding: 5rpx 10rpx;
  color: #868e96;
  font-size: 19rpx;
  font-weight: 800;
  line-height: 1;
  border: 1rpx solid #dee2e6;
  border-radius: 999rpx;
  background: #ffffff;
  box-sizing: border-box;
}

.visit-detail-meta-row {
  margin-top: 8rpx;
  display: flex;
  align-items: flex-end;
  gap: 14rpx;
}

.visit-detail-meta-row .visit-detail-meta {
  flex: 1;
  min-width: 0;
}

.contact-lead-follow-button {
  flex: none;
  width: 176rpx;
  min-width: 176rpx;
  max-width: 176rpx;
  height: 54rpx;
  min-height: 54rpx;
  max-height: 54rpx;
  margin: 0;
  padding: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  color: #5c9e6e;
  font-size: 24rpx;
  font-weight: 800;
  line-height: 1;
  text-align: center;
  border: 1rpx solid rgba(92, 158, 110, 0.28);
  border-radius: 999rpx;
  background: #ffffff;
  box-sizing: border-box;
}

.contact-lead-follow-button::after {
  border: 0;
}

.contact-lead-follow-button[disabled] {
  opacity: 0.68;
}

.visit-detail-primary,
.visit-detail-secondary,
.visit-detail-meta {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.visit-detail-primary {
  margin-top: 14rpx;
  color: #212529;
  font-size: 25rpx;
  font-weight: 800;
  line-height: 1.4;
}

.visit-detail-secondary {
  margin-top: 6rpx;
  color: #868e96;
  font-size: 22rpx;
  line-height: 1.45;
}

.visit-detail-meta {
  margin-top: 8rpx;
  color: #adb5bd;
  font-size: 21rpx;
  line-height: 1.4;
}

.visit-event-item:last-child {
  border-bottom: 0;
}

.visit-event-dot {
  width: 18rpx;
  height: 18rpx;
  flex: none;
  margin-top: 8rpx;
  border: 4rpx solid #ffffff;
  border-radius: 50%;
  background: #9aa6b2;
  box-shadow: 0 0 0 4rpx #eaf0f6;
  box-sizing: border-box;
}

.visit-event-dot.rose {
  background: #b55656;
  box-shadow: 0 0 0 4rpx #fbefef;
}

.visit-event-dot.teal {
  background: #5c9e6e;
  box-shadow: 0 0 0 4rpx #eef6f0;
}

.visit-event-dot.blue {
  background: #212529;
  box-shadow: 0 0 0 4rpx #f1f3f5;
}

.visit-event-content {
  flex: 1;
  min-width: 0;
}

.visit-event-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.visit-event-title {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  color: #212529;
  font-size: 26rpx;
  font-weight: 800;
  line-height: 1.35;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.visit-event-time {
  flex: none;
  color: #495057;
  font-size: 22rpx;
  font-weight: 800;
  line-height: 1.3;
}

.visit-event-detail,
.visit-event-date {
  overflow: hidden;
  color: #868e96;
  font-size: 22rpx;
  line-height: 1.45;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.visit-event-detail {
  margin-top: 6rpx;
}

.visit-event-date {
  margin-top: 2rpx;
  color: #adb5bd;
}

.visit-event-loading,
.visit-event-empty {
  min-height: 260rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 34rpx;
  text-align: center;
  box-sizing: border-box;
}

.visit-event-loading {
  color: #868e96;
  font-size: 24rpx;
  line-height: 1.5;
}

.visit-event-load-more {
  padding: 22rpx 0 8rpx;
  color: #868e96;
  font-size: 22rpx;
  line-height: 1.4;
  text-align: center;
}

.visit-detail-load-more {
  padding: 22rpx 0 8rpx;
  color: #868e96;
  font-size: 22rpx;
  line-height: 1.4;
  text-align: center;
}

.visit-empty,
.empty-state {
  min-height: 420rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
  text-align: center;
  box-sizing: border-box;
}

.visit-empty {
  min-height: 260rpx;
}

.empty-icon {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: #dfe8e5;
}

.empty-title {
  margin-top: 24rpx;
  color: #212529;
  font-size: 30rpx;
  font-weight: 800;
  line-height: 1.3;
}

.empty-title.small {
  margin-top: 0;
  font-size: 28rpx;
}

.empty-desc {
  margin-top: 10rpx;
  color: #868e96;
  font-size: 24rpx;
  line-height: 1.55;
}

.primary-button {
  min-width: 180rpx;
  min-height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 22rpx;
  padding: 0 28rpx;
  color: #fff;
  font-size: 24rpx;
  font-weight: 800;
  line-height: 1;
  border-radius: 999rpx;
  background: #212529;
  box-sizing: border-box;
}

.primary-button::after {
  border: 0;
}

.skeleton-panel {
  min-height: 136rpx;
  border-color: transparent;
  background: linear-gradient(90deg, #eef2f6 0%, #f7f9fc 48%, #eef2f6 100%);
  background-size: 280% 100%;
  animation: skeleton-loading 1.4s ease-in-out infinite;
}

.trend-panel.skeleton-panel {
  min-height: 260rpx;
}

.visit-detail-panel.skeleton-panel {
  min-height: 380rpx;
}

@keyframes skeleton-loading {
  0% {
    background-position: 100% 50%;
  }
  100% {
    background-position: 0 50%;
  }
}
