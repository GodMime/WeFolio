.member-add-page {
  min-height: 100vh;
  background: #f5f6f7;
}

.member-add-scroll {
  height: 100vh;
}

.member-add-content {
  padding: 176rpx 32rpx 56rpx;
  box-sizing: border-box;
}

.panel {
  border: 1rpx solid #e9ecef;
  border-radius: 48rpx;
  background: #ffffff;
  box-shadow: 0 18rpx 48rpx rgba(33, 37, 41, 0.06);
  box-sizing: border-box;
}

.stack-panel {
  margin-top: 22rpx;
  padding: 26rpx;
}

.stack-panel:first-of-type {
  margin-top: 0;
}

.form-row + .form-row {
  margin-top: 24rpx;
}

.label {
  color: #6c757d;
  font-size: 24rpx;
  font-weight: 700;
}

.input {
  width: 100%;
  min-height: 84rpx;
  margin-top: 12rpx;
  padding: 0 24rpx;
  color: #212529;
  font-size: 28rpx;
  line-height: 84rpx;
  border: 1rpx solid #e9ecef;
  border-radius: 40rpx;
  background: #ffffff;
  box-sizing: border-box;
}

.lookup-row {
  display: flex;
  align-items: flex-end;
  gap: 16rpx;
}

.lookup-input {
  flex: 1;
  min-width: 0;
}

.lookup-button {
  flex: none;
  width: 132rpx;
  min-height: 84rpx;
  margin-top: 12rpx;
}

.primary-button,
.secondary-button,
.segment,
.permission-row {
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.primary-button,
.secondary-button {
  min-height: 88rpx;
  padding: 0 28rpx;
  font-size: 28rpx;
  font-weight: 800;
  line-height: 1;
  border-radius: 999rpx;
}

.primary-button {
  color: #fff;
  background: #212529;
}

.secondary-button {
  color: #212529;
  background: #f1f3f5;
}

.candidate-card {
  min-height: 118rpx;
  display: flex;
  align-items: center;
  gap: 18rpx;
  margin-top: 24rpx;
  padding-top: 22rpx;
  border-top: 1rpx solid #e9ecef;
}

.member-avatar {
  width: 76rpx;
  height: 76rpx;
  flex: none;
  overflow: hidden;
  border-radius: 50%;
  background: #e9ecef;
}

.member-avatar-image,
.member-avatar-fallback {
  width: 100%;
  height: 100%;
}

.member-avatar-fallback {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #212529;
  font-size: 26rpx;
  font-weight: 900;
}

.candidate-copy {
  flex: 1;
  min-width: 0;
}

.candidate-name {
  overflow: hidden;
  color: #212529;
  font-size: 28rpx;
  font-weight: 800;
  line-height: 1.3;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.candidate-summary,
.confirm-desc,
.error-banner {
  color: #6c757d;
  font-size: 24rpx;
  line-height: 1.5;
}

.candidate-summary {
  margin-top: 6rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.segmented {
  display: flex;
  margin-top: 12rpx;
  padding: 8rpx;
  border: 1rpx solid #e9ecef;
  border-radius: 999rpx;
  background: #ffffff;
  box-sizing: border-box;
}

.segment {
  flex: 1 1 0;
  min-width: 0;
  min-height: 68rpx;
  margin: 0;
  color: #6c757d;
  font-size: 24rpx;
  font-weight: 800;
  border-radius: 999rpx;
  background: transparent;
}

.segment.active {
  color: #ffffff;
  background: #212529;
}

.permission-list {
  margin-top: 12rpx;
}

.permission-row {
  justify-content: flex-start;
  min-height: 72rpx;
  gap: 16rpx;
  padding: 0 18rpx;
  border-bottom: 1rpx solid #e9ecef;
  color: #6c757d;
  font-size: 26rpx;
  font-weight: 700;
}

.permission-row:last-child {
  border-bottom: 0;
}

.permission-row.active {
  color: #5c9e6e;
}

.permission-check {
  width: 28rpx;
  height: 28rpx;
  border: 2rpx solid #ced4da;
  border-radius: 50%;
  background: #fff;
  box-sizing: border-box;
}

.permission-row.active .permission-check {
  border-color: #5c9e6e;
  background: #5c9e6e;
}

.permission-label {
  flex: 1;
}

.confirm-panel {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 22rpx;
  padding: 24rpx 26rpx;
  flex-wrap: wrap;
}

.row-title {
  color: #212529;
  font-size: 28rpx;
  font-weight: 800;
}

.confirm-desc {
  width: 100%;
}

.role-pill {
  min-height: 38rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
  padding: 0 14rpx;
  font-size: 22rpx;
  font-weight: 800;
  line-height: 1;
  border-radius: 999rpx;
  box-sizing: border-box;
}

.role-pill.teal {
  color: #5c9e6e;
  background: #eef6f0;
}

.role-pill.amber {
  color: #c08a3e;
  background: #fbf3e7;
}

.role-pill.muted {
  color: #868e96;
  background: #f1f3f5;
}

.button-row {
  display: flex;
  gap: 18rpx;
  margin-top: 24rpx;
}

.action-button {
  flex: 1 1 0;
  min-width: 0;
}

.error-banner {
  margin-bottom: 18rpx;
  padding: 18rpx 22rpx;
  border-radius: 40rpx;
  background: #fbf3e7;
  color: #c08a3e;
  box-sizing: border-box;
}
