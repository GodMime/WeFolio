<view class="page-shell team-maintenance-page">
  <navigation-bar title="团队维护" back="{{true}}" color="#212529" background="rgba(245, 246, 247, 0.94)"></navigation-bar>

  <scroll-view class="maintenance-scroll" scroll-y type="list">
    <view class="maintenance-content">
      <!-- 详情页保持加载、错误、内容三态，缺少 teamId 或接口失败都进入错误态。 -->
      <block wx:if="{{loading}}">
        <view class="panel profile-panel skeleton-panel"></view>
        <view class="panel members-panel skeleton-panel"></view>
      </block>

      <block wx:elif="{{errorMessage}}">
        <view class="empty-state">
          <view class="empty-icon"></view>
          <view class="empty-title">加载失败</view>
          <view class="empty-desc">{{errorMessage}}</view>
          <button class="primary-button compact" bindtap="handleRetry">重试</button>
        </view>
      </block>

      <block wx:else>
        <view class="panel profile-panel">
          <view class="team-identity">
            <button wx:if="{{detail.team.canMaintain}}" class="team-logo large avatar-picker" open-type="chooseAvatar" bindchooseavatar="handleChooseAvatar" disabled="{{saving}}" aria-label="编辑团队图标">
              <image wx:if="{{form.avatarUrl}}" class="team-logo-image" src="{{form.avatarUrl}}" mode="aspectFill"></image>
              <view wx:else class="team-logo-fallback">TM</view>
            </button>
            <view wx:else class="team-logo large">
              <image wx:if="{{form.avatarUrl}}" class="team-logo-image" src="{{form.avatarUrl}}" mode="aspectFill"></image>
              <view wx:else class="team-logo-fallback">TM</view>
            </view>
            <view class="team-heading">
              <view class="team-name">{{detail.team.name}}</view>
              <view class="pill-row">
                <view class="role-pill blue">{{detail.team.memberText}}</view>
                <view class="role-pill blue">{{detail.team.roleText}}</view>
                <view class="role-pill teal team-code-button" data-code="{{detail.team.uniqueCode}}" bindtap="handleCopyTeamCode" aria-role="button" aria-label="复制团队唯一码 {{detail.team.uniqueCode}}">{{detail.team.displayUniqueCode}}</view>
              </view>
            </view>
          </view>

          <view class="form-row">
            <view class="field-heading">
              <view class="label">团队名称</view>
              <view class="field-limit">{{fieldCounters.name}}</view>
            </view>
            <input class="input" value="{{form.name}}" data-field="name" bindinput="handleInput" maxlength="100" disabled="{{!detail.team.canMaintain}}" />
          </view>
          <view class="form-row">
            <view class="field-heading">
              <view class="label">团队简介</view>
              <view class="field-limit">{{fieldCounters.intro}}</view>
            </view>
            <textarea class="input textarea" value="{{form.intro}}" data-field="intro" bindinput="handleInput" maxlength="1000" auto-height disabled="{{!detail.team.canMaintain}}" />
          </view>
          <button wx:if="{{detail.team.canMaintain}}" class="primary-button full" loading="{{saving}}" bindtap="handleSaveTeam">保存修改</button>
        </view>

        <!-- 搜索和状态筛选只在本地过滤 visibleMembers，不触发后端请求。 -->
        <view class="search-row">
          <input class="search-input" value="{{keyword}}" bindinput="handleSearchInput" placeholder="输入姓名、团队身份或个人唯一码" />
        </view>

        <view class="segmented">
          <button
            class="segment {{statusFilter === item.key ? 'active' : ''}}"
            wx:for="{{statusFilters}}"
            wx:key="key"
            data-key="{{item.key}}"
            bindtap="handleStatusFilterTap"
          >
            {{item.label}}
          </button>
        </view>

        <view class="panel team-members-panel">
          <view class="panel-heading">
            <view class="section-title">团队成员</view>
            <view wx:if="{{detail.team.canManageMembers}}" class="add-member-button" bindtap="handleAddMember" aria-role="button" aria-label="添加团队成员">添加成员</view>
          </view>
          <view wx:if="{{visibleMembers.length}}" class="member-list">
            <view
              class="member-row {{openedMemberActionId === item.memberId ? 'actions-open' : ''}}"
              wx:for="{{visibleMembers}}"
              wx:key="memberId"
              data-member-id="{{item.memberId}}"
              bindtap="handleMemberRowTap"
              bindtouchstart="handleMemberTouchStart"
              bindtouchend="handleMemberTouchEnd"
            >
              <view wx:if="{{detail.team.canManageMembers && item.role !== 'OWNER' && item.joinStatus === 'JOINED'}}" class="member-action-buttons" catchtap="noop">
                <button class="member-action-button transfer" data-member-id="{{item.memberId}}" bindtap="handleTransferOwner">转让团队</button>
                <button class="member-action-button remove" data-member-id="{{item.memberId}}" bindtap="handleRemoveMember">移除成员</button>
              </view>
              <view class="member-row-main">
                <view class="member-avatar">
                  <image wx:if="{{item.avatarUrl}}" class="member-avatar-image" src="{{item.avatarUrl}}" mode="aspectFill"></image>
                  <view wx:else class="member-avatar-fallback">{{item.initial}}</view>
                </view>
                <view class="member-copy">
                  <view class="member-name">{{item.displayName}}</view>
                  <view class="member-summary">{{item.summaryText}}</view>
                </view>
                <!--
                  成员状态标签分两层：
                  1. joinStatusText/statusTone 是团队成员关系状态，后端已映射好颜色 token，始终展示。
                  2. userStatusText/userStatusTone 是账号状态，只有非 ACTIVE 时展示，例如“已停用”。
                  这样维护页能区分“成员已加入但账号停用”和“成员资料缺失”。
                -->
                <view class="member-status">
                  <view class="role-pill {{item.statusTone}}">{{item.joinStatusText}}</view>
                  <view wx:if="{{item.pendingChange}}" class="role-pill amber pending-change-pill">{{item.pendingChangeText}}</view>
                  <view wx:if="{{item.userStatusVisible}}" class="role-pill {{item.userStatusTone}}">{{item.userStatusText}}</view>
                </view>
              </view>
            </view>
          </view>
          <view wx:else class="member-empty">
            <view class="empty-title small">暂无匹配成员</view>
            <view class="empty-desc">换个关键词或筛选状态试试。</view>
          </view>
        </view>
      </block>
    </view>
  </scroll-view>

  <view class="member-change-sheet-overlay {{memberChangeVisible ? 'visible' : ''}}" catchtap="handleMemberChangeCancel">
    <view class="member-change-sheet" catchtap="noop">
      <view class="sheet-grabber"></view>
      <view class="panel-heading member-sheet-heading">
        <view>
          <view class="section-title">成员信息</view>
          <view class="sheet-meta">{{selectedMember.displayName}}</view>
        </view>
      </view>

      <view class="member-sheet-section">
        <view class="form-row">
          <view class="label">团队角色</view>
          <view class="segmented member-role-segmented">
            <button
              class="segment {{memberChangeForm.role === item.key ? 'active' : ''}}"
              wx:for="{{memberRoleOptions}}"
              wx:key="key"
              data-role="{{item.key}}"
              bindtap="handleMemberChangeRoleTap"
            >
              {{item.label}}
            </button>
          </view>
        </view>

        <view class="form-row">
          <view class="label">团队身份</view>
          <input class="input" value="{{memberChangeForm.profession}}" bindinput="handleMemberChangeProfessionInput" maxlength="50" placeholder="用于团队内展示" />
        </view>

        <view class="form-row">
          <view class="label">可被团队作品集引用</view>
          <view class="permission-list">
            <view
              class="permission-row {{memberChangeForm.allowPortfolio ? 'active' : ''}}"
              data-field="allowPortfolio"
              bindtap="handleMemberChangePermissionTap"
              aria-role="checkbox"
              aria-checked="{{memberChangeForm.allowPortfolio}}"
            >
              <view class="permission-check"></view>
              <view class="permission-label">个人作品集</view>
            </view>
            <view
              class="permission-row {{memberChangeForm.allowProfile ? 'active' : ''}}"
              data-field="allowProfile"
              bindtap="handleMemberChangePermissionTap"
              aria-role="checkbox"
              aria-checked="{{memberChangeForm.allowProfile}}"
            >
              <view class="permission-check"></view>
              <view class="permission-label">头像资料</view>
            </view>
            <view
              class="permission-row {{memberChangeForm.allowWorks ? 'active' : ''}}"
              data-field="allowWorks"
              bindtap="handleMemberChangePermissionTap"
              aria-role="checkbox"
              aria-checked="{{memberChangeForm.allowWorks}}"
            >
              <view class="permission-check"></view>
              <view class="permission-label">个人作品素材</view>
            </view>
          </view>
        </view>
      </view>

      <view class="member-confirm-row">
        <view class="row-title">生效方式</view>
        <view class="role-pill amber">需本人同意</view>
        <view class="confirm-desc">保存后将发送站内信，成员同意后修改才会生效。</view>
      </view>

      <view class="button-row">
        <button class="secondary-button" bindtap="handleMemberChangeCancel">取消</button>
        <button class="primary-button" loading="{{saving}}" bindtap="handleSaveMemberChange">发送确认</button>
      </view>
    </view>
  </view>

  <view class="member-add-sheet-overlay {{memberAddVisible ? 'visible' : ''}}" catchtap="handleMemberAddCancel">
    <view class="member-add-sheet" catchtap="noop">
      <view class="sheet-grabber"></view>
      <view class="panel-heading member-sheet-heading">
        <view>
          <view class="section-title">添加成员</view>
          <view class="sheet-meta">按个人唯一码匹配成员并发送团队邀请</view>
        </view>
      </view>

      <view wx:if="{{memberAddErrorMessage}}" class="error-banner">{{memberAddErrorMessage}}</view>

      <view class="member-sheet-section">
        <view class="form-row">
          <view class="label">个人唯一码</view>
          <view class="lookup-row">
            <input class="input lookup-input" value="{{memberUniqueCode}}" bindinput="handleMemberUniqueCodeInput" maxlength="16" placeholder="输入成员个人唯一码" />
            <button class="secondary-button lookup-button" loading="{{memberSearching}}" bindtap="handleSearchCandidate">匹配</button>
          </view>
        </view>

        <view wx:if="{{candidateVisible}}" class="candidate-card">
          <view class="member-avatar">
            <image wx:if="{{candidate.avatarUrl}}" class="member-avatar-image" src="{{candidate.avatarUrl}}" mode="aspectFill"></image>
            <view wx:else class="member-avatar-fallback">{{candidate.initial}}</view>
          </view>
          <view class="candidate-copy">
            <view class="candidate-name">{{candidate.displayName}}</view>
            <view class="candidate-summary">{{candidate.summaryText}}</view>
          </view>
          <view class="role-pill {{candidate.statusTone}}">{{candidate.reason}}</view>
        </view>
      </view>

      <view class="member-sheet-section">
        <view class="form-row">
          <view class="label">团队角色</view>
          <view class="segmented member-role-segmented">
            <button
              class="segment {{memberInviteForm.role === item.key ? 'active' : ''}}"
              wx:for="{{memberRoleOptions}}"
              wx:key="key"
              data-role="{{item.key}}"
              bindtap="handleMemberRoleTap"
            >
              {{item.label}}
            </button>
          </view>
        </view>

        <view class="form-row">
          <view class="label">团队身份</view>
          <input class="input" value="{{memberInviteForm.profession}}" bindinput="handleMemberProfessionInput" maxlength="50" placeholder="用于团队内展示" />
        </view>

        <view class="form-row">
          <view class="label">可被团队作品集引用</view>
          <view class="permission-list">
            <view
              class="permission-row {{memberInviteForm.allowPortfolio ? 'active' : ''}}"
              data-field="allowPortfolio"
              bindtap="handleMemberPermissionTap"
              aria-role="checkbox"
              aria-checked="{{memberInviteForm.allowPortfolio}}"
            >
              <view class="permission-check"></view>
              <view class="permission-label">个人作品集</view>
            </view>
            <view
              class="permission-row {{memberInviteForm.allowProfile ? 'active' : ''}}"
              data-field="allowProfile"
              bindtap="handleMemberPermissionTap"
              aria-role="checkbox"
              aria-checked="{{memberInviteForm.allowProfile}}"
            >
              <view class="permission-check"></view>
              <view class="permission-label">头像资料</view>
            </view>
            <view
              class="permission-row {{memberInviteForm.allowWorks ? 'active' : ''}}"
              data-field="allowWorks"
              bindtap="handleMemberPermissionTap"
              aria-role="checkbox"
              aria-checked="{{memberInviteForm.allowWorks}}"
            >
              <view class="permission-check"></view>
              <view class="permission-label">个人作品素材</view>
            </view>
          </view>
        </view>
      </view>

      <view class="member-confirm-row">
        <view class="row-title">加入确认</view>
        <view class="role-pill amber">需本人确认</view>
        <view class="confirm-desc">发送邀请后，成员会在小程序内收到加入确认。确认前仅在管理端展示。</view>
      </view>

      <view class="button-row">
        <button class="secondary-button" bindtap="handleMemberAddCancel">取消</button>
        <button class="primary-button" loading="{{saving}}" bindtap="handleInviteMember">发送邀请</button>
      </view>
    </view>
  </view>
</view>
