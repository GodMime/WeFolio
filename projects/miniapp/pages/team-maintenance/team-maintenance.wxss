.team-maintenance-page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  background-color: #f5f7fb;
}

.maintenance-scroll {
  flex: 1;
  min-height: 0;
}

.maintenance-content {
  padding: 28rpx;
  box-sizing: border-box;
}

.panel {
  background: rgba(255, 255, 255, 0.94);
  border: 1rpx solid rgba(23, 32, 42, 0.06);
  border-radius: 16rpx;
  box-shadow: 0 18rpx 48rpx rgba(23, 32, 42, 0.06);
  box-sizing: border-box;
}

.profile-panel,
.team-members-panel {
  padding: 24rpx;
}

.team-identity,
.panel-heading,
.field-heading,
.pill-row,
.member-row {
  display: flex;
  align-items: center;
}

.team-identity {
  gap: 20rpx;
  align-items: flex-start;
}

.team-heading,
.member-copy {
  flex: 1;
  min-width: 0;
}

.team-heading {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  padding-top: 2rpx;
}

.team-logo {
  width: 92rpx;
  height: 92rpx;
  flex: none;
  overflow: hidden;
  border-radius: 22rpx;
  background: #dfe8e5;
}

.team-logo.large {
  width: 116rpx;
  height: 116rpx;
  border-radius: 28rpx;
}

.avatar-picker {
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0;
  padding: 0;
  border: 0;
  line-height: 1;
}

.team-logo-image,
.team-logo-fallback,
.member-avatar-image,
.member-avatar-fallback {
  width: 100%;
  height: 100%;
}

.team-logo-fallback,
.member-avatar-fallback {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #f7fbfa;
  font-weight: 900;
  background: linear-gradient(135deg, #17202a 0%, #2e7d73 100%);
}

.team-logo-fallback {
  font-size: 28rpx;
}

.team-name {
  overflow: hidden;
  color: #17202a;
  font-size: 32rpx;
  font-weight: 800;
  line-height: 1.3;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.team-code-label,
.team-code-value,
.member-summary,
.empty-desc {
  color: #778392;
  font-size: 24rpx;
  line-height: 1.45;
}

.team-code-button {
  max-width: 100%;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  margin-top: 8rpx;
  padding: 0;
  overflow: hidden;
  background: transparent;
  box-sizing: border-box;
}

.team-code-label,
.team-code-value {
  max-width: 100%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.team-code-value {
  margin-top: 2rpx;
  font-weight: 700;
}

.pill-row {
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 12rpx;
}

.role-pill {
  flex: none;
  max-width: 132rpx;
  padding: 8rpx 14rpx;
  overflow: hidden;
  font-size: 22rpx;
  font-weight: 800;
  line-height: 1;
  text-overflow: ellipsis;
  white-space: nowrap;
  border-radius: 999rpx;
  box-sizing: border-box;
}

.role-pill.blue {
  color: #2d5f9a;
  background: #e6efff;
}

.role-pill.teal {
  color: #0f766e;
  background: #dcf7f1;
}

.role-pill.amber {
  color: #8a4b09;
  background: #fff2cf;
}

.role-pill.muted {
  color: #667085;
  background: #eef2f6;
}

.form-row {
  margin-top: 22rpx;
}

.field-heading,
.panel-heading {
  justify-content: space-between;
  gap: 16rpx;
}

.label {
  color: #5f6b7a;
  font-size: 24rpx;
  font-weight: 700;
}

.field-limit {
  color: #8b96a3;
  font-size: 22rpx;
  font-weight: 700;
}

.input,
.search-input {
  width: 100%;
  min-height: 84rpx;
  padding: 0 22rpx;
  color: #17202a;
  font-size: 28rpx;
  line-height: 84rpx;
  border-radius: 16rpx;
  background: #f6f8fb;
  box-sizing: border-box;
}

.input {
  margin-top: 12rpx;
}

.textarea {
  min-height: 168rpx;
  padding-top: 20rpx;
  padding-bottom: 20rpx;
  line-height: 1.55;
}

.primary-button,
.secondary-button,
.mini-action,
.segment {
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.primary-button,
.secondary-button {
  min-height: 88rpx;
  padding: 0 28rpx;
  font-size: 28rpx;
  font-weight: 800;
  line-height: 1;
  border-radius: 16rpx;
}

.primary-button {
  color: #fff;
  background: #17202a;
}

.secondary-button {
  color: #17202a;
  background: #eef2f6;
}

.full {
  width: 100%;
  margin-top: 22rpx;
}

.profile-panel > .primary-button.full {
  width: 100%;
  min-width: 100%;
  max-width: 100%;
  margin-left: 0;
  margin-right: 0;
}

.search-row,
.segmented,
.team-members-panel {
  margin-top: 22rpx;
}

.segmented {
  display: flex;
  gap: 12rpx;
}

.segmented .segment {
  flex: 1 1 0;
  min-width: 0;
}

.segment {
  min-height: 68rpx;
  color: #667085;
  font-size: 24rpx;
  font-weight: 800;
  border-radius: 16rpx;
  background: #eef2f6;
}

.segment.active {
  color: #fff;
  background: #17202a;
}

.section-title {
  color: #17202a;
  font-size: 28rpx;
  font-weight: 800;
}

.mini-action {
  min-width: 116rpx;
  min-height: 56rpx;
  padding: 0 18rpx;
  color: #17202a;
  font-size: 23rpx;
  font-weight: 800;
  border-radius: 999rpx;
  background: #eef2f6;
}

.member-list {
  margin-top: 10rpx;
}

.member-row {
  min-height: 118rpx;
  gap: 18rpx;
  padding: 18rpx 0;
  border-bottom: 1rpx solid #edf1f5;
}

.member-row:last-child {
  border-bottom: 0;
}

.member-avatar {
  width: 76rpx;
  height: 76rpx;
  flex: none;
  overflow: hidden;
  border-radius: 50%;
  background: #dfe8e5;
}

.member-avatar-fallback {
  font-size: 26rpx;
}

.member-name {
  overflow: hidden;
  color: #17202a;
  font-size: 28rpx;
  font-weight: 800;
  line-height: 1.3;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.member-summary {
  margin-top: 6rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.member-status {
  /* 两个状态标签按竖向排列：团队加入状态常驻，账号停用状态按需出现，避免挤压成员姓名。 */
  max-width: 150rpx;
  flex: none;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 8rpx;
}

.member-empty,
.empty-state {
  min-height: 320rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
  text-align: center;
  box-sizing: border-box;
}

.empty-icon {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: #dfe8e5;
}

.empty-title {
  margin-top: 24rpx;
  color: #17202a;
  font-size: 30rpx;
  font-weight: 800;
}

.empty-title.small {
  margin-top: 0;
  font-size: 28rpx;
}

.compact {
  width: 180rpx;
  min-height: 72rpx;
  margin-top: 22rpx;
  font-size: 24rpx;
}

.skeleton-panel {
  min-height: 180rpx;
  border-color: transparent;
  background: linear-gradient(90deg, #eef2f6 0%, #f7f9fc 48%, #eef2f6 100%);
  background-size: 280% 100%;
  animation: skeleton-loading 1.4s ease-in-out infinite;
}

.members-panel.skeleton-panel {
  min-height: 480rpx;
}

button::after {
  border: 0;
}

@keyframes skeleton-loading {
  0% {
    background-position: 100% 50%;
  }
  100% {
    background-position: 0 50%;
  }
}
