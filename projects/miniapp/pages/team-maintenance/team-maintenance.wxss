.team-maintenance-page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  background-color: #f5f7fb;
}

.maintenance-scroll {
  flex: 1;
  min-height: 0;
}

.maintenance-content {
  padding: 28rpx;
  box-sizing: border-box;
}

.panel {
  background: rgba(255, 255, 255, 0.94);
  border: 1rpx solid rgba(23, 32, 42, 0.06);
  border-radius: 16rpx;
  box-shadow: 0 18rpx 48rpx rgba(23, 32, 42, 0.06);
  box-sizing: border-box;
}

.profile-panel,
.team-members-panel {
  padding: 24rpx;
}

.team-identity,
.panel-heading,
.field-heading,
.pill-row {
  display: flex;
  align-items: center;
}

.team-identity {
  gap: 20rpx;
  align-items: flex-start;
}

.team-heading,
.member-copy {
  flex: 1;
  min-width: 0;
}

.team-heading {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  padding-top: 2rpx;
}

.team-logo {
  width: 92rpx;
  height: 92rpx;
  flex: none;
  overflow: hidden;
  border-radius: 22rpx;
  background: #dfe8e5;
}

.team-logo.large {
  width: 116rpx;
  height: 116rpx;
  border-radius: 28rpx;
}

.avatar-picker {
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0;
  padding: 0;
  border: 0;
  line-height: 1;
}

.team-logo-image,
.team-logo-fallback,
.member-avatar-image,
.member-avatar-fallback {
  width: 100%;
  height: 100%;
}

.team-logo-fallback,
.member-avatar-fallback {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #f7fbfa;
  font-weight: 900;
  background: linear-gradient(135deg, #17202a 0%, #2e7d73 100%);
}

.team-logo-fallback {
  font-size: 28rpx;
}

.team-name {
  overflow: hidden;
  color: #17202a;
  font-size: 32rpx;
  font-weight: 800;
  line-height: 1.3;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.member-summary,
.empty-desc {
  color: #778392;
  font-size: 24rpx;
  line-height: 1.45;
}

.pill-row {
  width: 100%;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 12rpx;
}

.role-pill {
  flex: none;
  display: flex;
  align-items: center;
  justify-content: center;
  max-width: 132rpx;
  height: 38rpx;
  min-height: 38rpx;
  padding: 0 14rpx;
  overflow: hidden;
  font-size: 22rpx;
  font-weight: 800;
  line-height: 1;
  text-overflow: ellipsis;
  white-space: nowrap;
  border-radius: 999rpx;
  box-sizing: border-box;
}

.role-pill.blue {
  color: #2d5f9a;
  background: #e6efff;
}

.role-pill.teal {
  color: #0f766e;
  background: #dcf7f1;
}

.role-pill.team-code-button {
  width: 200rpx;
  min-width: 200rpx;
  max-width: 200rpx;
  margin-left: auto;
  text-align: center;
}

.role-pill.amber {
  color: #8a4b09;
  background: #fff2cf;
}

.role-pill.muted {
  color: #667085;
  background: #eef2f6;
}

.form-row {
  margin-top: 22rpx;
}

.field-heading,
.panel-heading {
  justify-content: space-between;
  gap: 16rpx;
}

.label {
  color: #5f6b7a;
  font-size: 24rpx;
  font-weight: 700;
}

.field-limit {
  color: #8b96a3;
  font-size: 22rpx;
  font-weight: 700;
}

.input,
.search-input {
  width: 100%;
  min-height: 84rpx;
  padding: 0 22rpx;
  color: #17202a;
  font-size: 28rpx;
  line-height: 84rpx;
  border-radius: 16rpx;
  background: #f6f8fb;
  box-sizing: border-box;
}

.input {
  margin-top: 12rpx;
}

.textarea {
  min-height: 168rpx;
  padding-top: 20rpx;
  padding-bottom: 20rpx;
  line-height: 1.55;
}

.primary-button,
.secondary-button,
.add-member-button,
.segment {
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.primary-button,
.secondary-button {
  min-height: 88rpx;
  padding: 0 28rpx;
  font-size: 28rpx;
  font-weight: 800;
  line-height: 1;
  border-radius: 16rpx;
}

.primary-button {
  color: #fff;
  background: #17202a;
}

.secondary-button {
  color: #17202a;
  background: #eef2f6;
}

.full {
  width: 100%;
  margin-top: 22rpx;
}

.profile-panel > .primary-button.full {
  width: 100%;
  min-width: 100%;
  max-width: 100%;
  margin-left: 0;
  margin-right: 0;
}

.search-row,
.segmented,
.team-members-panel {
  margin-top: 22rpx;
}

.segmented {
  display: flex;
  padding: 8rpx;
  border: 1rpx solid #d8e0e8;
  border-radius: 18rpx;
  background: rgba(255, 255, 255, 0.94);
  box-sizing: border-box;
}

.segmented .segment {
  flex: 1 1 0;
  min-width: 0;
  margin: 0;
  background: transparent;
}

.segment {
  min-height: 68rpx;
  margin: 0;
  color: #667085;
  font-size: 24rpx;
  font-weight: 800;
  border-radius: 14rpx;
  background: transparent;
}

.segment.active {
  color: #fff;
  background: #17202a;
}

.section-title {
  color: #17202a;
  font-size: 28rpx;
  font-weight: 800;
}

.add-member-button {
  flex: none;
  width: 128rpx;
  min-width: 0;
  min-height: 56rpx;
  margin-left: auto;
  margin-right: 0;
  padding: 0 12rpx;
  color: #536579;
  font-size: 23rpx;
  font-weight: 800;
  border: 1rpx solid #cbd6e2;
  border-radius: 999rpx;
  background: #f7fafc;
}

.member-list {
  margin-top: 10rpx;
}

.member-row {
  position: relative;
  min-height: 118rpx;
  overflow: hidden;
  border-bottom: 1rpx solid #edf1f5;
}

.member-row:last-child {
  border-bottom: 0;
}

.member-row-main {
  position: relative;
  z-index: 2;
  min-height: 118rpx;
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 18rpx 0;
  background: #ffffff;
  box-sizing: border-box;
  transition: transform 160ms ease;
}

.member-row.actions-open .member-row-main {
  transform: translateX(-360rpx);
}

.member-avatar {
  width: 76rpx;
  height: 76rpx;
  flex: none;
  overflow: hidden;
  border-radius: 50%;
  background: #dfe8e5;
}

.member-avatar-fallback {
  font-size: 26rpx;
}

.member-name {
  overflow: hidden;
  color: #17202a;
  font-size: 28rpx;
  font-weight: 800;
  line-height: 1.3;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.member-summary {
  margin-top: 6rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.member-status {
  /* 两个状态标签按竖向排列：团队加入状态常驻，账号停用状态按需出现，避免挤压成员姓名。 */
  max-width: 190rpx;
  flex: none;
  align-self: stretch;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  justify-content: center;
  gap: 8rpx;
}

.member-status .role-pill {
  height: 40rpx;
  min-height: 40rpx;
  line-height: 40rpx;
}

.pending-change-pill {
  max-width: 190rpx;
}

.member-action-buttons {
  position: absolute;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 1;
  width: 320rpx;
  height: 100%;
  flex: none;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: flex-end;
  gap: 20rpx;
  box-sizing: border-box;
  opacity: 0;
  pointer-events: none;
  transition: opacity 160ms ease;
}

.member-row.actions-open .member-action-buttons {
  opacity: 1;
  pointer-events: auto;
}

.member-action-button {
  width: 148rpx;
  min-width: 148rpx;
  height: 60rpx;
  min-height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0;
  padding: 0;
  color: #17202a;
  font-size: 21rpx;
  font-weight: 800;
  line-height: 60rpx;
  border-radius: 12rpx;
  background: #eef2f6;
  box-sizing: border-box;
}

.member-action-button.remove {
  color: #b42318;
  background: #fee4e2;
}

.member-empty,
.empty-state {
  min-height: 320rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
  text-align: center;
  box-sizing: border-box;
}

.empty-icon {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: #dfe8e5;
}

.empty-title {
  margin-top: 24rpx;
  color: #17202a;
  font-size: 30rpx;
  font-weight: 800;
}

.empty-title.small {
  margin-top: 0;
  font-size: 28rpx;
}

.compact {
  width: 180rpx;
  min-height: 72rpx;
  margin-top: 22rpx;
  font-size: 24rpx;
}

.skeleton-panel {
  min-height: 180rpx;
  border-color: transparent;
  background: linear-gradient(90deg, #eef2f6 0%, #f7f9fc 48%, #eef2f6 100%);
  background-size: 280% 100%;
  animation: skeleton-loading 1.4s ease-in-out infinite;
}

.members-panel.skeleton-panel {
  min-height: 480rpx;
}

.member-add-sheet-overlay {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 30;
  display: flex;
  align-items: flex-end;
  padding: 28rpx;
  opacity: 0;
  pointer-events: none;
  background: rgba(23, 32, 42, 0.36);
  transition: opacity 180ms ease;
  box-sizing: border-box;
}

.member-change-sheet-overlay {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 30;
  display: flex;
  align-items: flex-end;
  padding: 28rpx;
  opacity: 0;
  pointer-events: none;
  background: rgba(23, 32, 42, 0.36);
  transition: opacity 180ms ease;
  box-sizing: border-box;
}

.member-add-sheet-overlay.visible {
  opacity: 1;
  pointer-events: auto;
}

.member-change-sheet-overlay.visible {
  opacity: 1;
  pointer-events: auto;
}

.member-add-sheet {
  width: 100%;
  max-height: calc(90vh - env(safe-area-inset-bottom));
  padding: 24rpx;
  overflow-y: auto;
  border-radius: 24rpx 24rpx 18rpx 18rpx;
  background: #ffffff;
  box-sizing: border-box;
  transform: translateY(32rpx);
  transition: transform 180ms ease;
}

.member-change-sheet {
  width: 100%;
  max-height: calc(90vh - env(safe-area-inset-bottom));
  padding: 24rpx;
  overflow-y: auto;
  border-radius: 24rpx 24rpx 18rpx 18rpx;
  background: #ffffff;
  box-sizing: border-box;
  transform: translateY(32rpx);
  transition: transform 180ms ease;
}

.member-add-sheet-overlay.visible .member-add-sheet {
  transform: translateY(0);
}

.member-change-sheet-overlay.visible .member-change-sheet {
  transform: translateY(0);
}

.sheet-grabber {
  width: 72rpx;
  height: 8rpx;
  margin: 0 auto 22rpx;
  border-radius: 999rpx;
  background: #d8e0e8;
}

.member-sheet-heading {
  align-items: flex-start;
}

.sheet-meta,
.candidate-summary,
.confirm-desc,
.error-banner {
  color: #667085;
  font-size: 24rpx;
  line-height: 1.5;
}

.sheet-meta {
  margin-top: 6rpx;
}

.member-sheet-section {
  padding: 22rpx 0;
  border-bottom: 1rpx solid #edf1f5;
}

.member-sheet-section > .form-row:first-child {
  margin-top: 0;
}

.member-add-sheet .form-row + .form-row {
  margin-top: 24rpx;
}

.lookup-row,
.candidate-card,
.permission-row,
.member-confirm-row,
.button-row {
  display: flex;
  align-items: center;
  box-sizing: border-box;
}

.lookup-row {
  align-items: flex-end;
  gap: 16rpx;
}

.lookup-input {
  flex: 1 1 0;
  width: 0;
  min-width: 0;
}

.lookup-button {
  flex: 0 0 112rpx;
  width: 112rpx;
  min-width: 112rpx;
  max-width: 112rpx;
  min-height: 84rpx;
  margin-top: 12rpx;
  padding: 0;
}

.candidate-card {
  min-height: 118rpx;
  gap: 18rpx;
  margin-top: 24rpx;
  padding-top: 22rpx;
  border-top: 1rpx solid #edf1f5;
}

.candidate-copy {
  flex: 1;
  min-width: 0;
}

.candidate-name {
  overflow: hidden;
  color: #17202a;
  font-size: 28rpx;
  font-weight: 800;
  line-height: 1.3;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.candidate-summary {
  margin-top: 6rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.candidate-card .role-pill {
  max-width: 180rpx;
}

.member-role-segmented {
  margin-top: 12rpx;
}

.permission-list {
  margin-top: 12rpx;
}

.permission-row {
  display: flex;
  align-items: center;
  justify-content: flex-start;
  min-height: 72rpx;
  gap: 16rpx;
  padding: 0 18rpx;
  border-bottom: 1rpx solid #edf1f5;
  color: #667085;
  font-size: 26rpx;
  font-weight: 700;
}

.permission-row:last-child {
  border-bottom: 0;
}

.permission-row.active {
  color: #0f766e;
}

.permission-check {
  width: 28rpx;
  height: 28rpx;
  flex: none;
  border: 2rpx solid #cbd6e2;
  border-radius: 50%;
  background: #fff;
  box-sizing: border-box;
}

.permission-row.active .permission-check {
  border-color: #0f766e;
  background: #0f766e;
}

.permission-label {
  flex: 1;
  min-width: 0;
}

.member-confirm-row {
  align-items: flex-start;
  flex-wrap: wrap;
  gap: 16rpx;
  padding-top: 22rpx;
}

.row-title {
  color: #17202a;
  font-size: 28rpx;
  font-weight: 800;
}

.confirm-desc {
  width: 100%;
}

.error-banner {
  margin-top: 18rpx;
  padding: 18rpx 22rpx;
  border-radius: 16rpx;
  color: #8a4b09;
  background: #fff1d6;
  box-sizing: border-box;
}

.button-row {
  gap: 16rpx;
  margin-top: 24rpx;
}

.button-row .primary-button,
.button-row .secondary-button {
  flex: 1 1 0;
  min-width: 0;
}

button::after {
  border: 0;
}

@keyframes skeleton-loading {
  0% {
    background-position: 100% 50%;
  }
  100% {
    background-position: 0 50%;
  }
}
