<view class="page-shell messages-page">
  <navigation-bar title="我的消息" back="{{true}}" color="#17202a" background="rgba(245, 247, 251, 0.94)"></navigation-bar>

  <scroll-view class="messages-scroll" scroll-y type="list" bindscrolltolower="handleLoadMore" lower-threshold="120">
    <view class="messages-content">
      <block wx:if="{{loading}}">
        <view class="panel summary-panel skeleton-panel"></view>
        <view class="panel list-panel skeleton-panel"></view>
      </block>

      <block wx:elif="{{errorMessage}}">
        <view class="empty-state">
          <view class="empty-icon"></view>
          <view class="empty-title">加载失败</view>
          <view class="empty-desc">{{errorMessage}}</view>
          <button class="primary-button compact" bindtap="handleRetry">重试</button>
        </view>
      </block>

      <block wx:else>
        <view class="panel summary-panel">
          <view class="summary-copy">
            <view class="summary-label">未读消息</view>
            <view class="summary-value">{{messageData.summary.unreadText}}</view>
          </view>
          <view class="invite-pill">{{messageData.summary.invitationText}}</view>
        </view>

        <view class="filter-tabs">
          <view
            class="filter-tab {{activeFilter === item.key ? 'active' : ''}}"
            wx:for="{{filters}}"
            wx:key="key"
            data-filter="{{item.key}}"
            bindtap="handleFilterTap"
            aria-role="button"
          >{{item.label}}</view>
        </view>

        <view class="action-row">
          <button class="outline-button" loading="{{saving}}" bindtap="handleMarkSelectedRead">批量已读</button>
          <button class="solid-button" loading="{{saving}}" bindtap="handleMarkAllRead">全部已读</button>
        </view>

        <view class="panel list-panel">
          <view wx:if="{{messageData.messages.length}}" class="message-list">
            <view
              class="message-row {{item.unread ? 'unread' : 'read'}}"
              wx:for="{{messageData.messages}}"
              wx:key="id"
            >
              <view class="select-dot {{item.selected ? 'selected' : ''}}" data-message-id="{{item.id}}" bindtap="handleToggleSelect" aria-role="checkbox"></view>
              <view class="{{item.unreadDotClass}}"></view>
              <view class="message-copy">
                <view class="message-meta">
                  <view class="category-pill {{item.tone}}">{{item.categoryText}}</view>
                  <view class="message-time">{{item.createdAtText}}</view>
                </view>
                <view class="message-title">{{item.title}}</view>
                <view class="message-content">{{item.content}}</view>
                <view class="message-actions">
                  <button wx:if="{{item.actionVisible}}" class="message-action" data-action-url="{{item.actionUrl}}" bindtap="handleActionTap">{{item.actionText}}</button>
                  <button wx:if="{{item.unread}}" class="message-action ghost" data-message-id="{{item.id}}" bindtap="handleMarkOneRead">标为已读</button>
                </view>
              </view>
            </view>
            <view wx:if="{{loadingMore}}" class="load-more-text">加载中...</view>
          </view>

          <view wx:else class="message-empty">
            <view class="empty-title small">暂无消息</view>
            <view class="empty-desc">系统提醒、团队邀请和积分提示会出现在这里。</view>
          </view>
        </view>
      </block>
    </view>
  </scroll-view>
</view>
