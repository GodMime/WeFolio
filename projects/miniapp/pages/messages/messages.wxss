.messages-page {
  min-height: 100vh;
  background: #f5f6f7;
}

.messages-scroll {
  height: 100vh;
}

.messages-content {
  padding: 20rpx 32rpx 56rpx;
  box-sizing: border-box;
}

.panel {
  background: #ffffff;
  border: 1rpx solid #e9ecef;
  border-radius: 48rpx;
  box-shadow: 0 18rpx 48rpx rgba(33, 37, 41, 0.06);
}

.summary-panel {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  min-height: 156rpx;
  padding: 28rpx;
  box-sizing: border-box;
}

.summary-copy {
  min-width: 0;
}

.summary-label,
.message-time,
.empty-desc {
  color: #868e96;
  font-size: 23rpx;
}

.summary-value {
  margin-top: 8rpx;
  color: #212529;
  font-size: 48rpx;
  font-weight: 800;
  line-height: 1;
}

.invite-pill,
.category-pill {
  flex: none;
  border-radius: 999rpx;
  font-weight: 800;
  line-height: 1;
  white-space: nowrap;
}

.invite-pill {
  padding: 12rpx 16rpx;
  color: #c08a3e;
  font-size: 22rpx;
  background: #fbf3e7;
}

.filter-tabs {
  display: flex;
  gap: 8rpx;
  margin-top: 22rpx;
  padding: 8rpx;
  border: 1rpx solid #e9ecef;
  border-radius: 999rpx;
  background: #ffffff;
  box-sizing: border-box;
}

.filter-tab {
  flex: 1 1 0;
  min-width: 0;
  min-height: 68rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #6c757d;
  font-size: 24rpx;
  font-weight: 800;
  border-radius: 999rpx;
}

.filter-tab.active {
  color: #ffffff;
  background: #212529;
}

.action-row {
  display: flex;
  gap: 16rpx;
  margin-top: 22rpx;
}

.outline-button,
.solid-button,
.message-action {
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0;
  box-sizing: border-box;
}

.outline-button,
.solid-button {
  flex: 1 1 0;
  min-width: 0;
  min-height: 76rpx;
  font-size: 25rpx;
  font-weight: 800;
  border-radius: 999rpx;
}

.outline-button {
  color: #212529;
  border: 1rpx solid #dee2e6;
  background: #ffffff;
}

.solid-button {
  color: #ffffff;
  background: #212529;
}

.list-panel {
  margin-top: 22rpx;
  overflow: hidden;
}

.message-list {
  padding: 0 24rpx;
}

.message-row {
  display: flex;
  align-items: flex-start;
  gap: 14rpx;
  padding: 24rpx 0;
  border-top: 1rpx solid #e9ecef;
}

.message-row:first-child {
  border-top: 0;
}

.select-dot,
.unread-dot {
  flex: none;
  box-sizing: border-box;
  border-radius: 50%;
}

.select-dot {
  width: 34rpx;
  height: 34rpx;
  margin-top: 8rpx;
  border: 2rpx solid #ced4da;
  background: #ffffff;
}

.select-dot.selected {
  border-color: #212529;
  background: #212529;
}

.unread-dot {
  width: 14rpx;
  height: 14rpx;
  margin-top: 18rpx;
}

.unread-dot.amber {
  background: #212529;
}

.unread-dot.muted {
  background: #adb5bd;
}

.message-copy {
  flex: 1;
  min-width: 0;
}

.message-meta,
.message-actions {
  display: flex;
  align-items: center;
}

.message-meta {
  justify-content: space-between;
  gap: 16rpx;
}

.category-pill {
  padding: 8rpx 12rpx;
  font-size: 20rpx;
}

.category-pill.team {
  color: #5c9e6e;
  background: #eef6f0;
}

.category-pill.point {
  color: #c08a3e;
  background: #fbf3e7;
}

.category-pill.system {
  color: #6c757d;
  background: #f1f3f5;
}

.message-time {
  flex: none;
}

.message-title {
  margin-top: 12rpx;
  overflow: hidden;
  color: #212529;
  font-size: 28rpx;
  font-weight: 800;
  line-height: 1.35;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.message-content {
  margin-top: 8rpx;
  color: #6c757d;
  font-size: 24rpx;
  line-height: 1.45;
}

.message-actions {
  gap: 14rpx;
  margin-top: 16rpx;
}

.message-action {
  min-width: 120rpx;
  min-height: 54rpx;
  padding: 0 18rpx;
  color: #ffffff;
  font-size: 23rpx;
  font-weight: 800;
  border-radius: 999rpx;
  background: #212529;
}

.message-action.ghost {
  color: #6c757d;
  border: 1rpx solid #dee2e6;
  background: #ffffff;
}

.message-empty,
.empty-state {
  padding: 72rpx 28rpx;
  text-align: center;
}

.load-more-text {
  padding: 10rpx 0 28rpx;
  color: #868e96;
  font-size: 23rpx;
  text-align: center;
}

.empty-icon {
  width: 96rpx;
  height: 96rpx;
  margin: 0 auto 20rpx;
  border-radius: 50%;
  background: #dfe8e5;
}

.empty-title {
  color: #212529;
  font-size: 30rpx;
  font-weight: 800;
}

.empty-title.small {
  font-size: 26rpx;
}

.empty-desc {
  margin-top: 10rpx;
  line-height: 1.45;
}

.primary-button.compact {
  width: 200rpx;
  min-height: 72rpx;
  margin-top: 28rpx;
  color: #ffffff;
  font-size: 25rpx;
  font-weight: 800;
  border-radius: 999rpx;
  background: #212529;
}
