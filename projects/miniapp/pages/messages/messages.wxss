.messages-page {
  min-height: 100vh;
  background: #f5f7fb;
}

.messages-scroll {
  height: 100vh;
}

.messages-content {
  padding: 28rpx 28rpx 56rpx;
  box-sizing: border-box;
}

.panel {
  background: rgba(255, 255, 255, 0.94);
  border: 1rpx solid rgba(23, 32, 42, 0.06);
  border-radius: 16rpx;
  box-shadow: 0 18rpx 48rpx rgba(23, 32, 42, 0.06);
}

.summary-panel {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  min-height: 156rpx;
  padding: 28rpx;
  box-sizing: border-box;
}

.summary-copy {
  min-width: 0;
}

.summary-label,
.message-time,
.empty-desc {
  color: #758190;
  font-size: 23rpx;
}

.summary-value {
  margin-top: 8rpx;
  color: #17202a;
  font-size: 48rpx;
  font-weight: 800;
  line-height: 1;
}

.invite-pill,
.category-pill {
  flex: none;
  border-radius: 999rpx;
  font-weight: 800;
  line-height: 1;
  white-space: nowrap;
}

.invite-pill {
  padding: 12rpx 16rpx;
  color: #8a4b09;
  font-size: 22rpx;
  background: #ffe8b5;
}

.filter-tabs {
  display: flex;
  gap: 8rpx;
  margin-top: 22rpx;
  padding: 8rpx;
  border: 1rpx solid #d8e0e8;
  border-radius: 18rpx;
  background: rgba(255, 255, 255, 0.94);
  box-sizing: border-box;
}

.filter-tab {
  flex: 1 1 0;
  min-width: 0;
  min-height: 68rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #667085;
  font-size: 24rpx;
  font-weight: 800;
  border-radius: 14rpx;
}

.filter-tab.active {
  color: #ffffff;
  background: #17202a;
}

.action-row {
  display: flex;
  gap: 16rpx;
  margin-top: 22rpx;
}

.outline-button,
.solid-button,
.message-action {
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0;
  box-sizing: border-box;
}

.outline-button,
.solid-button {
  flex: 1 1 0;
  min-width: 0;
  min-height: 76rpx;
  font-size: 25rpx;
  font-weight: 800;
  border-radius: 16rpx;
}

.outline-button {
  color: #17202a;
  border: 1rpx solid #cbd6e2;
  background: #ffffff;
}

.solid-button {
  color: #ffffff;
  background: #0f766e;
}

.list-panel {
  margin-top: 22rpx;
  overflow: hidden;
}

.message-list {
  padding: 0 24rpx;
}

.message-row {
  display: flex;
  align-items: flex-start;
  gap: 14rpx;
  padding: 24rpx 0;
  border-top: 1rpx solid #edf1f5;
}

.message-row:first-child {
  border-top: 0;
}

.select-dot,
.unread-dot {
  flex: none;
  box-sizing: border-box;
  border-radius: 50%;
}

.select-dot {
  width: 34rpx;
  height: 34rpx;
  margin-top: 8rpx;
  border: 2rpx solid #cbd6e2;
  background: #ffffff;
}

.select-dot.selected {
  border-color: #0f766e;
  background: #0f766e;
}

.unread-dot {
  width: 14rpx;
  height: 14rpx;
  margin-top: 18rpx;
}

.unread-dot.amber {
  background: #d9901f;
}

.unread-dot.muted {
  background: #cbd6e2;
}

.message-copy {
  flex: 1;
  min-width: 0;
}

.message-meta,
.message-actions {
  display: flex;
  align-items: center;
}

.message-meta {
  justify-content: space-between;
  gap: 16rpx;
}

.category-pill {
  padding: 8rpx 12rpx;
  font-size: 20rpx;
}

.category-pill.team {
  color: #0f766e;
  background: #dcf7f1;
}

.category-pill.point {
  color: #8a4b09;
  background: #ffe8b5;
}

.category-pill.system {
  color: #536579;
  background: #eef2f6;
}

.message-time {
  flex: none;
}

.message-title {
  margin-top: 12rpx;
  overflow: hidden;
  color: #17202a;
  font-size: 28rpx;
  font-weight: 800;
  line-height: 1.35;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.message-content {
  margin-top: 8rpx;
  color: #536579;
  font-size: 24rpx;
  line-height: 1.45;
}

.message-actions {
  gap: 14rpx;
  margin-top: 16rpx;
}

.message-action {
  min-width: 120rpx;
  min-height: 54rpx;
  padding: 0 18rpx;
  color: #ffffff;
  font-size: 23rpx;
  font-weight: 800;
  border-radius: 999rpx;
  background: #17202a;
}

.message-action.ghost {
  color: #536579;
  border: 1rpx solid #cbd6e2;
  background: #ffffff;
}

.message-empty,
.empty-state {
  padding: 72rpx 28rpx;
  text-align: center;
}

.load-more-text {
  padding: 10rpx 0 28rpx;
  color: #758190;
  font-size: 23rpx;
  text-align: center;
}

.empty-icon {
  width: 96rpx;
  height: 96rpx;
  margin: 0 auto 20rpx;
  border-radius: 50%;
  background: #dfe8e5;
}

.empty-title {
  color: #17202a;
  font-size: 30rpx;
  font-weight: 800;
}

.empty-title.small {
  font-size: 26rpx;
}

.empty-desc {
  margin-top: 10rpx;
  line-height: 1.45;
}

.primary-button.compact {
  width: 200rpx;
  min-height: 72rpx;
  margin-top: 28rpx;
  color: #ffffff;
  font-size: 25rpx;
  font-weight: 800;
  border-radius: 16rpx;
  background: #17202a;
}
