.recharge-records-page { height: 100vh; display: flex; flex-direction: column; overflow: hidden; background: #f5f6f7; }
.records-scroll { flex: 1; min-height: 0; }
.records-content { padding: 20rpx 32rpx 56rpx; box-sizing: border-box; }
.order-card { margin-bottom: 20rpx; padding: 28rpx; border: 1rpx solid #e9ecef; border-radius: 48rpx; background: #ffffff; box-sizing: border-box; }
.order-heading, .order-values { display: flex; align-items: center; justify-content: space-between; }
.package-name { color: #212529; font-size: 30rpx; font-weight: 900; }
.order-time { margin-top: 8rpx; color: #868e96; font-size: 21rpx; }
.order-status { flex: none; display: inline-flex; align-items: center; gap: 8rpx; padding: 0; font-size: 22rpx; font-weight: 800; background: transparent; }
.order-status::before { width: 12rpx; height: 12rpx; flex: none; content: ""; border-radius: 50%; background: currentColor; }
.order-status.success { color: #5c9e6e; background: transparent; }
.order-status.pending { color: #c08a3e; background: transparent; }
.order-status.muted { color: #868e96; background: transparent; }
.order-values { margin-top: 24rpx; padding: 22rpx 0; border-top: 1rpx solid #f1f3f5; border-bottom: 1rpx solid #f1f3f5; }
.order-values > view:last-child { text-align: right; }
.value-label { color: #868e96; font-size: 21rpx; }
.value-text { margin-top: 8rpx; color: #212529; font-size: 28rpx; font-weight: 900; }
.value-text.points { color: #212529; }
.order-meta { margin-top: 18rpx; color: #868e96; font-size: 21rpx; line-height: 1.5; }
.order-no { margin-top: 8rpx; overflow-wrap: break-word; word-break: break-all; }
.skeleton-panel { min-height: 240rpx; background: #e9eef3; }
.empty-state { padding: 150rpx 32rpx; text-align: center; }
.empty-title { color: #212529; font-size: 32rpx; font-weight: 900; }
.empty-desc { margin-top: 14rpx; color: #868e96; font-size: 24rpx; line-height: 1.6; }
.retry-button { width: 220rpx; height: 84rpx; display: flex; align-items: center; justify-content: center; margin: 28rpx auto 0; color: #ffffff; font-weight: 900; border-radius: 999rpx; background: #212529; }
.load-more-text { padding: 24rpx 0 8rpx; color: #adb5bd; font-size: 22rpx; text-align: center; }
