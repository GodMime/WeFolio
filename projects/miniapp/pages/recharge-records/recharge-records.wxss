.recharge-records-page { height: 100vh; display: flex; flex-direction: column; overflow: hidden; background: #f5f7fb; }
.records-scroll { flex: 1; min-height: 0; }
.records-content { padding: 28rpx 28rpx 56rpx; box-sizing: border-box; }
.order-card { margin-bottom: 18rpx; padding: 26rpx; border: 1rpx solid rgba(23, 32, 42, 0.08); border-radius: 18rpx; background: rgba(255, 255, 255, 0.96); box-sizing: border-box; }
.order-heading, .order-values { display: flex; align-items: center; justify-content: space-between; }
.package-name { color: #17202a; font-size: 30rpx; font-weight: 900; }
.order-time { margin-top: 8rpx; color: #758190; font-size: 21rpx; }
.order-status { flex: none; padding: 9rpx 18rpx; font-size: 22rpx; font-weight: 800; border-radius: 999rpx; }
.order-status.success { color: #0f766e; background: #def4ef; }
.order-status.pending { color: #8a4b09; background: #fff1d6; }
.order-status.muted { color: #657283; background: #edf1f5; }
.order-values { margin-top: 24rpx; padding: 22rpx 0; border-top: 1rpx solid #edf1f5; border-bottom: 1rpx solid #edf1f5; }
.order-values > view:last-child { text-align: right; }
.value-label { color: #758190; font-size: 21rpx; }
.value-text { margin-top: 8rpx; color: #17202a; font-size: 28rpx; font-weight: 900; }
.value-text.points { color: #0f766e; }
.order-meta { margin-top: 18rpx; color: #758190; font-size: 21rpx; line-height: 1.5; }
.order-no { margin-top: 8rpx; overflow-wrap: break-word; word-break: break-all; }
.skeleton-panel { min-height: 240rpx; background: #e9eef3; }
.empty-state { padding: 150rpx 32rpx; text-align: center; }
.empty-title { color: #17202a; font-size: 32rpx; font-weight: 900; }
.empty-desc { margin-top: 14rpx; color: #758190; font-size: 24rpx; line-height: 1.6; }
.retry-button { width: 220rpx; height: 82rpx; display: flex; align-items: center; justify-content: center; margin: 28rpx auto 0; color: #ffffff; font-weight: 900; border-radius: 18rpx; background: #17202a; }
.load-more-text { padding: 24rpx 0 8rpx; color: #8b95a1; font-size: 22rpx; text-align: center; }
