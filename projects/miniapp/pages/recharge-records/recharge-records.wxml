<view class="page-shell recharge-records-page">
  <navigation-bar title="充值记录" back="{{true}}" color="#17202a" background="rgba(245, 247, 251, 0.94)"></navigation-bar>

  <scroll-view class="records-scroll" scroll-y type="list" bindscrolltolower="handleLoadMore" lower-threshold="120">
    <view class="records-content">
      <block wx:if="{{loading}}">
        <view class="order-card skeleton-panel" wx:for="{{recordSkeletons}}" wx:key="*this"></view>
      </block>

      <view wx:elif="{{errorMessage}}" class="empty-state">
        <view class="empty-title">加载失败</view>
        <view class="empty-desc">{{errorMessage}}</view>
        <button class="retry-button" bindtap="handleRetry">重试</button>
      </view>

      <view wx:elif="{{!orderData.records.length}}" class="empty-state">
        <view class="empty-title">暂无充值记录</view>
        <view class="empty-desc">完成套餐充值后，订单与到账状态会显示在这里。</view>
      </view>

      <block wx:else>
        <view class="order-card" wx:for="{{orderData.records}}" wx:key="merchantOrderNo">
          <view class="order-heading">
            <view>
              <view class="package-name">{{item.packageName}}</view>
              <view class="order-time">{{item.timeText}}</view>
            </view>
            <view class="order-status {{item.statusTone}}">{{item.statusText}}</view>
          </view>
          <view class="order-values">
            <view>
              <view class="value-label">支付金额</view>
              <view class="value-text">{{item.amountText}}</view>
            </view>
            <view>
              <view class="value-label">到账积分</view>
              <view class="value-text points">{{item.pointsText}}</view>
            </view>
          </view>
          <view class="order-meta">
            <view>{{item.bonusText}}</view>
            <view class="order-no">订单号 {{item.merchantOrderNo}}</view>
          </view>
        </view>
        <view wx:if="{{loadingMore}}" class="load-more-text">加载中...</view>
        <view wx:elif="{{!orderData.hasMore}}" class="load-more-text">已加载全部记录</view>
      </block>
    </view>
  </scroll-view>
</view>
