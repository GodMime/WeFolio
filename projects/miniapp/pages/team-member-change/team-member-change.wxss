.team-member-change-page {
  min-height: 100vh;
  background: #f5f7fb;
}

.change-scroll {
  height: 100vh;
}

.change-content {
  padding: 176rpx 28rpx 56rpx;
  box-sizing: border-box;
}

.panel {
  border: 1rpx solid #e5ebf2;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.96);
  box-shadow: 0 18rpx 48rpx rgba(23, 32, 42, 0.08);
  box-sizing: border-box;
}

.change-panel {
  padding: 28rpx;
}

.team-row {
  min-height: 112rpx;
  display: flex;
  align-items: flex-start;
  gap: 18rpx;
}

.team-logo {
  width: 82rpx;
  height: 82rpx;
  flex: none;
  overflow: hidden;
  border-radius: 22rpx;
  background: #dfe8e5;
}

.team-logo-image,
.team-logo-fallback {
  width: 100%;
  height: 100%;
}

.team-logo-fallback {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #0f766e;
  font-size: 26rpx;
  font-weight: 900;
}

.team-copy {
  flex: 1;
  min-width: 0;
}

.team-name {
  overflow: hidden;
  color: #17202a;
  font-size: 32rpx;
  font-weight: 900;
  line-height: 1.3;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.team-summary,
.info-label,
.empty-desc,
.processed-note,
.change-before {
  color: #667085;
  font-size: 24rpx;
  line-height: 1.5;
}

.team-summary {
  margin-top: 8rpx;
}

.role-pill {
  min-height: 38rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
  padding: 0 14rpx;
  font-size: 22rpx;
  font-weight: 800;
  line-height: 1;
  border-radius: 999rpx;
  box-sizing: border-box;
}

.role-pill.teal {
  color: #0f766e;
  background: #dcf7f1;
}

.role-pill.amber {
  color: #8a4b09;
  background: #fff1d6;
}

.role-pill.muted {
  color: #667085;
  background: #edf1f5;
}

.info-list,
.change-list {
  margin-top: 24rpx;
  border-top: 1rpx solid #edf1f5;
}

.info-row,
.change-row {
  min-height: 76rpx;
  display: flex;
  align-items: center;
  gap: 20rpx;
  border-bottom: 1rpx solid #edf1f5;
}

.info-row:last-child,
.change-row:last-child {
  border-bottom: 0;
}

.info-label,
.change-label {
  width: 132rpx;
  flex: none;
}

.change-label,
.info-value,
.change-after {
  color: #17202a;
  font-size: 26rpx;
  font-weight: 800;
  line-height: 1.5;
}

.info-value,
.change-values {
  flex: 1;
  min-width: 0;
}

.change-values {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.change-before,
.change-after {
  flex: 1 1 0;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.change-arrow {
  flex: none;
  color: #98a2b3;
  font-size: 24rpx;
  font-weight: 900;
}

.primary-button,
.secondary-button {
  min-height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 28rpx;
  font-size: 28rpx;
  font-weight: 800;
  line-height: 1;
  border-radius: 16rpx;
  box-sizing: border-box;
}

.primary-button {
  color: #fff;
  background: #17202a;
}

.secondary-button {
  color: #17202a;
  background: #eef2f6;
}

.change-actions {
  display: flex;
  gap: 18rpx;
  margin-top: 24rpx;
}

.action-button {
  flex: 1 1 0;
  min-width: 0;
}

.processed-note {
  min-height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 24rpx;
  border-radius: 16rpx;
  background: #edf1f5;
  font-weight: 800;
}

.empty-state {
  min-height: 420rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
  text-align: center;
  box-sizing: border-box;
}

.empty-icon {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: #dfe8e5;
}

.empty-title {
  margin-top: 24rpx;
  color: #17202a;
  font-size: 30rpx;
  font-weight: 800;
}

.compact {
  width: 180rpx;
  min-height: 72rpx;
  margin-top: 22rpx;
  font-size: 24rpx;
}

.skeleton-panel {
  min-height: 260rpx;
  border-color: transparent;
  background: linear-gradient(90deg, #eef2f6 0%, #f7f9fc 48%, #eef2f6 100%);
  background-size: 280% 100%;
  animation: skeleton-loading 1.4s ease-in-out infinite;
}

@keyframes skeleton-loading {
  0% {
    background-position: 100% 0;
  }

  100% {
    background-position: 0 0;
  }
}
