<view class="page-shell team-member-change-page">
  <navigation-bar title="信息变更" back="{{true}}" color="#212529" background="rgba(245, 246, 247, 0.94)"></navigation-bar>

  <scroll-view class="change-scroll" scroll-y type="list">
    <view class="change-content">
      <block wx:if="{{loading}}">
        <view class="panel skeleton-panel"></view>
      </block>

      <block wx:elif="{{errorMessage}}">
        <view class="empty-state">
          <view class="empty-icon"></view>
          <view class="empty-title">加载失败</view>
          <view class="empty-desc">{{errorMessage}}</view>
          <button class="primary-button compact" bindtap="handleRetry">重试</button>
        </view>
      </block>

      <block wx:else>
        <view class="panel change-panel">
          <view class="team-row">
            <view class="team-logo">
              <image wx:if="{{changeDetail.teamAvatarUrl}}" class="team-logo-image" src="{{changeDetail.teamAvatarUrl}}" mode="aspectFill"></image>
              <view wx:else class="team-logo-fallback">TM</view>
            </view>
            <view class="team-copy">
              <view class="team-name">{{changeDetail.titleText}}</view>
              <view class="team-summary">{{changeDetail.summaryText}}</view>
            </view>
            <view class="role-pill {{changeDetail.statusTone}}">{{changeDetail.statusText}}</view>
          </view>

          <view class="info-list">
            <view class="info-row">
              <view class="info-label">成员</view>
              <view class="info-value">{{changeDetail.targetName}}</view>
            </view>
            <view class="info-row">
              <view class="info-label">发起时间</view>
              <view class="info-value">{{changeDetail.requestedAtText}}</view>
            </view>
          </view>

          <view class="change-list">
            <view class="change-row" wx:for="{{changeDetail.changeRows}}" wx:key="label">
              <view class="change-label">{{item.label}}</view>
              <view class="change-values">
                <view class="change-before">{{item.before}}</view>
                <view class="change-arrow">→</view>
                <view class="change-after">{{item.after}}</view>
              </view>
            </view>
          </view>
        </view>

        <view wx:if="{{changeDetail.canRespond}}" class="change-actions">
          <button class="secondary-button action-button" loading="{{saving}}" bindtap="handleReject">拒绝</button>
          <button class="primary-button action-button" loading="{{saving}}" bindtap="handleAccept">同意</button>
        </view>
        <view wx:else class="processed-note">信息变更已处理</view>
      </block>
    </view>
  </scroll-view>
</view>
