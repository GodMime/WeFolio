.share-sheet-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 90;
  display: flex;
  align-items: flex-end;
  justify-content: center;
  padding: 0;
  background: rgba(17, 24, 39, 0.42);
  box-sizing: border-box;
  animation: share-sheet-mask-in 225ms ease-out both;
}

.share-sheet-panel {
  width: 100%;
  padding: 24rpx 32rpx calc(32rpx + env(safe-area-inset-bottom));
  border: 0;
  border-radius: 56rpx 56rpx 0 0;
  background: #ffffff;
  box-shadow: 0 -20rpx 48rpx rgba(17, 24, 39, 0.18);
  box-sizing: border-box;
  animation: share-sheet-panel-in 225ms cubic-bezier(0.2, 0, 0.1, 1) both;
}

.share-sheet-grabber {
  width: 72rpx;
  height: 8rpx;
  margin: 0 auto 22rpx;
  border-radius: 999rpx;
  background: #cbd6df;
}

.share-sheet-title {
  margin-bottom: 20rpx;
  color: #212529;
  font-size: 30rpx;
  font-weight: 900;
  line-height: 1.3;
}

.share-sheet-actions {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.share-sheet-action {
  width: 100%;
  min-width: 100%;
  max-width: 100%;
  height: 136rpx;
  min-height: 136rpx;
  display: flex;
  align-items: center;
  gap: 18rpx;
  margin: 0;
  padding: 20rpx 18rpx;
  color: #212529;
  line-height: normal;
  text-align: left;
  border: 1rpx solid #e9ecef;
  border-radius: 32rpx;
  background: #f5f6f7;
  box-sizing: border-box;
}

.share-sheet-action::after,
.share-sheet-cancel::after {
  border: 0;
}

.share-sheet-action:active {
  border-color: #ced4da;
  background: #e9ecef;
}

.share-sheet-action[disabled],
.share-sheet-cancel[disabled] {
  opacity: 0.48;
}

.share-sheet-icon {
  width: 88rpx;
  height: 88rpx;
  flex: none;
  border-radius: 20rpx;
  background: #e9ecef;
  overflow: hidden;
}

.share-sheet-action-copy {
  min-width: 0;
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  justify-content: center;
}

.share-sheet-action-title {
  width: 100%;
  color: #212529;
  font-size: 28rpx;
  font-weight: 850;
  line-height: 1.35;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.share-sheet-action-desc {
  width: 100%;
  margin-top: 6rpx;
  color: #687787;
  font-size: 23rpx;
  line-height: 1.4;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.share-sheet-cancel {
  width: 100%;
  min-width: 100%;
  max-width: 100%;
  height: 96rpx;
  margin: 16rpx 0 0;
  color: #526171;
  line-height: 96rpx;
  font-size: 26rpx;
  font-weight: 800;
  border-radius: 999rpx;
  background: #e9ecef;
}

@keyframes share-sheet-mask-in {
  from { opacity: 0; }
  to { opacity: 1; }
}

@keyframes share-sheet-panel-in {
  from { transform: translateY(36rpx); }
  to { transform: translateY(0); }
}
