.form-section,
.form-entry-section {
  padding: 8rpx 34rpx;
  text-align: center;
  box-sizing: border-box;
}

.component-title {
  padding: 0 24rpx;
  color: #212529;
  font-size: 32rpx;
  font-weight: 900;
  line-height: 1.35;
  box-sizing: border-box;
}

.section-desc {
  color: #868e96;
  font-size: 26rpx;
  line-height: 1.75;
  white-space: pre-wrap;
}

.primary-button {
  width: 260rpx;
  height: 96rpx;
  margin: 24rpx auto 0;
  padding: 0;
  color: #ffffff;
  font-size: 26rpx;
  line-height: 96rpx;
  border-radius: 999rpx;
  background: #212529;
}

.contact-form-entry-button {
  width: 320rpx;
  height: 72rpx;
  line-height: 72rpx;
}

.field {
  width: 100%;
  min-height: 84rpx;
  margin-top: 16rpx;
  padding: 0 20rpx;
  color: #212529;
  font-size: 26rpx;
  line-height: 84rpx;
  text-align: left;
  border: 1rpx solid #e9ecef;
  border-radius: 24rpx;
  background: #f5f6f7;
  box-sizing: border-box;
}

.date-field.placeholder {
  color: #8b95a1;
}

.textarea {
  height: 156rpx;
  padding-top: 18rpx;
  line-height: 1.6;
  border-radius: 40rpx;
}

.contact-form-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 82;
  display: flex;
  align-items: flex-end;
  justify-content: center;
  padding: 0;
  opacity: 0;
  pointer-events: none;
  background: rgba(17, 24, 39, 0.42);
  box-sizing: border-box;
  transition: opacity 180ms ease;
}

.contact-form-mask.visible {
  opacity: 1;
  pointer-events: auto;
}

.contact-form-panel {
  width: 100%;
  max-height: 82vh;
  overflow-y: auto;
  padding: 28rpx 32rpx calc(32rpx + env(safe-area-inset-bottom));
  border-radius: 56rpx 56rpx 0 0;
  background: #ffffff;
  box-sizing: border-box;
  transform: translateY(24rpx);
  transition: transform 220ms cubic-bezier(0.18, 0, 0.12, 1);
}

.contact-form-mask.visible .contact-form-panel {
  transform: translateY(0);
}

.contact-form-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.contact-form-heading .component-title {
  flex: 1 1 auto;
  min-width: 0;
  padding: 0;
  text-align: left;
}

.contact-form-close {
  width: 58rpx;
  height: 58rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
  color: #59636f;
  font-size: 36rpx;
  font-weight: 700;
  line-height: 1;
  border-radius: 50%;
  background: #f1f3f5;
}
