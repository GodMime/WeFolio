.editor{padding:24rpx;color:#17202a}.help{font-size:24rpx;color:#6b7280;margin-bottom:20rpx;line-height:1.6}.block-card{border:1rpx solid #d7dadd;border-radius:20rpx;padding:20rpx;margin:20rpx 0;background:#fff}.row{display:flex;align-items:center;justify-content:space-between;gap:12rpx;margin:16rpx 0}.row>text{font-size:24rpx;flex-shrink:0}.row input{flex:1;min-width:0;background:#f5f7fb;border-radius:10rpx;padding:12rpx;box-sizing:border-box;text-align:right;font-size:26rpx}.actions{display:flex;flex-wrap:wrap;gap:8rpx}.actions button{margin:0;flex-shrink:0;font-size:23rpx}.choice{padding:14rpx;background:#f5f7fb;border-radius:12rpx;font-size:24rpx}.add{text-align:center;color:#0f766e}.footer{margin-top:24rpx;justify-content:flex-end}.footer button{flex:1}.error{display:block;color:#b42318;margin:16rpx 0;font-size:24rpx}textarea{width:100%;min-height:80rpx;background:#f5f7fb;padding:16rpx;box-sizing:border-box;border-radius:12rpx;font-size:28rpx}.paragraph{margin:16rpx 0;padding:16rpx;background:#f5f7fb;border-radius:12rpx}.run-editor{background:#fff;padding:12rpx;border-radius:12rpx;margin:12rpx 0}.selected{color:#0f766e!important;border:2rpx solid #0f766e}.media-list{display:flex;flex-wrap:wrap;gap:12rpx}.media-choice{width:160rpx;padding:8rpx;border:2rpx solid transparent;border-radius:12rpx;box-sizing:border-box}.media-choice image,.video-placeholder{width:140rpx;height:100rpx;border-radius:8rpx}.video-placeholder{display:flex;align-items:center;justify-content:center;background:#17202a;color:#fff}.media-choice text{display:block;font-size:22rpx;margin-top:8rpx}
.editor-tabs{display:flex;gap:8rpx;padding:8rpx;border-radius:999rpx;background:#f1f3f5}.editor-tab{flex:1;padding:14rpx;text-align:center;border-radius:999rpx;color:#6b7280;font-size:25rpx;font-weight:700}.editor-tab.active{color:#fff;background:#17202a}.summary-list{display:flex;flex-direction:column;gap:12rpx}.summary-row{display:flex;align-items:center;justify-content:space-between;gap:12rpx;padding:16rpx;border:2rpx solid #e4e7e7;border-radius:16rpx}.summary-row.selected{color:#17202a!important;border-color:#17202a;background:#f5f7fb}.summary-copy{display:flex;min-width:0;flex:1;flex-direction:column;gap:6rpx}.summary-copy text:last-child{overflow:hidden;color:#6b7280;font-size:23rpx;text-overflow:ellipsis;white-space:nowrap}.detail-title{font-size:27rpx;font-weight:700}.detail-card{margin-top:16rpx}.empty,.background-tab-hint{margin:24rpx 0;padding:28rpx;border-radius:16rpx;background:#f5f7fb;color:#6b7280;font-size:24rpx;line-height:1.6}
.field-label{margin:20rpx 0 12rpx;font-size:24rpx;font-weight:700}.font-choice-list{display:flex;gap:12rpx}.font-choice{display:flex;min-width:0;flex:1;flex-direction:column;gap:6rpx;padding:16rpx;border:2rpx solid #e4e7e7;border-radius:14rpx;font-size:24rpx}.font-choice text:not(:first-child){color:#6b7280;font-size:21rpx;line-height:1.4}.font-choice.disabled{opacity:.5}.font-choice.selected{opacity:1;color:#17202a!important;border-color:#17202a;background:#f5f7fb}
