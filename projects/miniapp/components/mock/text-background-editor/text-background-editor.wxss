.editor{padding:24rpx;color:#17202a}.help{font-size:24rpx;color:#6b7280;margin:12rpx 0 20rpx;line-height:1.6}.row{display:flex;align-items:center;justify-content:space-between;gap:12rpx;margin:16rpx 0}.row>text{font-size:24rpx;flex-shrink:0}.choice,.background-selection{padding:18rpx;background:#f5f7fb;border-radius:12rpx;font-size:24rpx;margin:12rpx 0}.background-selection{border:1rpx solid #e4e7e7}.background-picker{display:flex;flex-direction:column;gap:16rpx}.background-search{display:flex;align-items:center;gap:12rpx}.background-search-input{min-width:0;height:72rpx;flex:1;padding:0 18rpx;border:1rpx solid #e4e7e7;border-radius:14rpx;background:#fff;box-sizing:border-box;font-size:24rpx}.background-search-button{width:auto;min-width:88rpx;margin:0;padding:0 16rpx;font-size:22rpx}.selected{color:#0f766e!important;border:2rpx solid #0f766e}.media-list{display:flex;flex-wrap:wrap;gap:12rpx}.media-choice{width:160rpx;padding:8rpx;border:2rpx solid transparent;border-radius:12rpx;box-sizing:border-box}.media-choice image,.video-placeholder{width:140rpx;height:100rpx;border-radius:8rpx}.video-placeholder{display:flex;align-items:center;justify-content:center;background:#17202a;color:#fff}.media-choice text{display:block;font-size:22rpx;margin-top:8rpx}
