<template name="colorPickerContent">
  <view class="text-color-heading">
    <view class="text-color-title">自定义{{label}}</view>
    <view class="text-color-meta">{{draftColor}}</view>
  </view>
  <view class="text-color-pad" style="background-color: {{hueColor}};" bindtouchstart="handleColorPadTouch" catchtouchmove="handleColorPadTouch">
    <view class="text-color-pad-white"></view>
    <view class="text-color-pad-black"></view>
    <view class="text-color-pad-dot" style="{{padDotStyle}}"></view>
  </view>
  <view class="text-color-hue-slider">
    <slider min="0" max="359" value="{{colorHsv.hue}}" bindchanging="handleHueChange" bindchange="handleHueChange" backgroundColor="transparent" activeColor="transparent" block-color="transparent" block-size="22" disabled="{{!pickerVisible || !active}}"></slider>
    <view class="text-color-hue-thumb" style="left: {{huePosition}}%; background-color: {{hueColor}};"></view>
  </view>
  <view class="text-color-hex-row">
    <input class="text-color-hex-input" type="text" value="{{hexInput}}" bindinput="handleHexInput" bindblur="handleHexBlur" maxlength="7" placeholder="#000000" disabled="{{!pickerVisible || !active}}" aria-label="十六进制{{label}}" />
    <button class="text-color-copy" catchtap="handleCopyHex" disabled="{{!pickerVisible || !active}}" aria-label="复制{{label}}色值">复制</button>
  </view>
  <view class="text-color-error">{{errorMessage}}</view>
  <view class="text-color-preview-bar">
    <view class="text-color-preview-chip" style="background-color: {{draftColor}};"></view>
    <view class="text-color-preview-text">预览 {{draftColor}}</view>
  </view>
  <view class="text-color-actions">
    <button class="text-color-cancel" catchtap="handleCancelCustom">{{inline ? '取消自定义' : '取消'}}</button>
    <button class="text-color-confirm" catchtap="handleConfirmCustom" disabled="{{!!errorMessage || !pickerVisible || !active}}">确定</button>
  </view>
</template>
<view class="text-color-options {{active ? '' : 'is-inactive'}}">
  <view wx:for="{{presets}}" wx:key="color" class="text-color-option {{selectedColor === item.color ? 'selected' : ''}}" data-color="{{item.color}}" catchtap="handlePreset" aria-role="button" aria-label="{{item.label}}">{{item.label}}</view>
  <view class="text-color-option text-color-custom {{customSelected ? 'selected' : ''}}" catchtap="handleOpenCustom" aria-role="button" aria-label="自定义{{label}}">
    <view wx:if="{{customSelected}}" class="text-color-swatch" style="background-color: {{selectedColor}};"></view>
    <text>自定义{{customSelected ? ' ' + selectedColor : ''}}</text>
  </view>
</view>
<!-- 内联配置随父层滚动，常驻节点通过高度和透明度展开、收起。 -->
<view wx:if="{{inline}}" class="text-color-inline {{pickerVisible && active ? 'is-visible' : ''}}">
  <view class="text-color-inline-body">
    <template is="colorPickerContent" data="{{draftColor, hueColor, padDotStyle, colorHsv, pickerVisible, active, huePosition, hexInput, errorMessage, inline, label}}" />
  </view>
</view>
<!-- 其他入口保留根节点弹层，避免父编辑器的滚动和位移裁切。 -->
<root-portal wx:else>
  <view class="text-color-mask {{pickerMounted && active ? 'is-mounted' : ''}} {{pickerVisible && active ? 'is-visible' : ''}}" catchtap="handleCancelCustom" catchtouchmove="noop">
    <view class="text-color-panel" catchtap="noop">
      <view class="text-color-grabber"></view>
      <template is="colorPickerContent" data="{{draftColor, hueColor, padDotStyle, colorHsv, pickerVisible, active, huePosition, hexInput, errorMessage, inline, label}}" />
    </view>
  </view>
</root-portal>
