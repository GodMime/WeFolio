.hyperlink-editor{padding:8rpx 0;color:#202528}.field-row{display:flex;align-items:center;justify-content:space-between;gap:20rpx;margin:20rpx 0;font-size:28rpx}.field-label{display:block;font-size:26rpx;margin:28rpx 0 14rpx}.editor-hint{display:block;color:#777d82;font-size:24rpx;line-height:1.6;margin-top:10rpx}.small-button{flex-shrink:0;margin:0;padding:8rpx 18rpx;font-size:24rpx;line-height:1.7;background:#edf6f3;color:#0f766e;border-radius:12rpx}.small-button::after{border:0}.work-card{display:flex;gap:20rpx;align-items:center;padding:16rpx;border-radius:18rpx;background:#f5f6f6;font-size:28rpx}.work-card image{width:120rpx;height:120rpx;border-radius:12rpx;flex-shrink:0}.choices{display:flex;flex-wrap:wrap;gap:14rpx}.choices.vertical{flex-direction:column;flex-wrap:nowrap}.choice{display:flex;flex-direction:column;gap:6rpx;padding:18rpx 22rpx;border:2rpx solid #e4e7e7;border-radius:14rpx;font-size:25rpx}.choice-title{font-weight:600}.choice-description{color:#777d82;font-size:23rpx;line-height:1.5}.selected{border-color:#0f766e;background:#edf6f3;color:#0f766e}.selected .choice-description{color:#396e60}.target-card{display:flex;flex-direction:column;padding:24rpx;border:2rpx solid #0f766e;border-radius:16rpx;font-size:28rpx}.field-input,.field-textarea{box-sizing:border-box;width:100%;background:#f5f6f6;border:1rpx solid #e8ebeb;border-radius:16rpx;padding:20rpx 24rpx;font-size:28rpx}.field-input{height:88rpx}.field-textarea{height:240rpx}
