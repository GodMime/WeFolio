.tabbar,
.tab {
  display: flex;
  align-items: center;
}

.tabbar {
  position: fixed;
  left: 28rpx;
  right: 28rpx;
  bottom: calc(28rpx + env(safe-area-inset-bottom));
  z-index: 10;
  height: 116rpx;
  padding: 0;
  justify-content: space-around;
  border: 2rpx solid #e9ecef;
  border-radius: 999rpx;
  background: #ffffff;
  box-shadow: 0 24rpx 56rpx rgba(33, 37, 41, 0.1);
  box-sizing: border-box;
}

.tab {
  position: relative;
  width: 25%;
  height: 116rpx;
  flex-direction: column;
  justify-content: center;
  color: #868e96;
  background: transparent;
}

.tab.active {
  color: #212529;
}

.tab-icon-wrap {
  width: 68rpx;
  height: 52rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 999rpx;
}

.tab.active .tab-icon-wrap {
  background: #212529;
}

.tab-icon-image {
  display: block;
  width: 38rpx;
  height: 38rpx;
}

.tab-label {
  position: relative;
  z-index: 1;
  margin-top: 4rpx;
  font-size: 18rpx;
  font-weight: 500;
  line-height: 1.2;
}

.tab::after {
  border: 0;
}
