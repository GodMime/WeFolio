.section{position:relative;overflow:hidden;display:flex;flex-direction:column}.with-background{padding:32rpx;box-sizing:border-box;background:#212529}.align-CENTER{justify-content:center}.align-BOTTOM{justify-content:flex-end}.background,.background-poster{position:absolute;left:0;top:0;width:100%;height:100%;pointer-events:none}.background-poster{z-index:0}.content{position:relative;width:100%;z-index:1}.text-block{white-space:pre-wrap;word-break:break-word;line-height:1.7}.legacy-title{display:block;font-size:34rpx;font-weight:600;margin-bottom:16rpx}.treatment-DARK_MASK{background:rgba(0,0,0,.4)}.treatment-GRADIENT{background:linear-gradient(180deg,rgba(0,0,0,.12) 0%,rgba(0,0,0,.4) 50%,rgba(0,0,0,.88) 100%)}.font-wechat-sans-ss{font-family:"WeFolioWechatSansSS",-apple-system,BlinkMacSystemFont,"Helvetica Neue",Arial,sans-serif}
.simple-text .text-block { line-height: 1.75; }
.background-error{position:relative;z-index:2;display:flex;align-items:center;justify-content:space-between;gap:16rpx;margin-top:20rpx;padding:16rpx 20rpx;border-radius:12rpx;background:#f5f7fb;color:#495057;font-size:24rpx;line-height:1.5}.background-retry{flex-shrink:0;margin:0;padding:8rpx 16rpx;min-height:64rpx;background:#fff;color:#0f766e;font-size:24rpx;line-height:48rpx}
