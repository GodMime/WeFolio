.contact-editor{padding:8rpx 0;color:#202528}.editor-heading,.field-row{display:flex;align-items:center;justify-content:space-between;gap:20rpx;margin:20rpx 0;font-size:28rpx}.editor-heading{font-weight:600}.editor-hint{display:block;color:#777d82;font-size:24rpx;line-height:1.6}.field-label{display:block;font-size:26rpx;margin:28rpx 0 14rpx}.field-input{box-sizing:border-box;width:100%;height:88rpx;background:#f5f6f6;border:1rpx solid #e8ebeb;border-radius:16rpx;padding:0 24rpx;font-size:28rpx}.small-button{flex-shrink:0;margin:0;padding:8rpx 18rpx;font-size:24rpx;line-height:1.7;background:#edf6f3;color:#0f766e;border-radius:12rpx}.small-button::after{border:0}.contact-border-settings{padding:4rpx 20rpx 24rpx;border-radius:18rpx;background:#f8f9fa}.contact-preview{padding:20rpx;border:1rpx solid #e8ebeb;border-radius:18rpx;background:#fff}
