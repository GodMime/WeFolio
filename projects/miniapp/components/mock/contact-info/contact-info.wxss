.contact-spacing,.contact-card{box-sizing:border-box;min-width:0}.contact-card{padding:24rpx;border-radius:24rpx;color:#212529}.contact-row{display:flex;align-items:center;padding:18rpx 0;gap:24rpx}.contact-content{flex:1;min-width:0}.contact-label{display:block;font-size:24rpx;opacity:.6;margin-bottom:8rpx}.contact-value{font-size:30rpx;word-break:break-all;white-space:pre-wrap}.copy-button{display:flex;align-items:center;justify-content:center;flex:0 0 164rpx;width:164rpx;min-width:164rpx;min-height:44px;box-sizing:border-box;margin:0;padding:12rpx 0;border:0;border-radius:18rpx;background:transparent;color:#62646c;font-size:26rpx;font-weight:400;line-height:1}.copy-button::after{border:0}.copy-button-face{display:flex;align-items:center;justify-content:center;gap:10rpx;width:100%;height:64rpx;box-sizing:border-box;padding:0 16rpx;border:1rpx solid #dcdde1;border-radius:18rpx;background:rgba(127,127,127,.06)}.copy-button-text{flex-shrink:0;white-space:nowrap}.copy-icon{position:relative;flex-shrink:0;width:28rpx;height:28rpx}.copy-icon::before,.copy-icon::after{content:'';position:absolute;box-sizing:border-box;width:20rpx;height:20rpx;border:3rpx solid currentColor;border-radius:4rpx}.copy-icon::before{top:1rpx;left:1rpx;border-right:0;border-bottom:0}.copy-icon::after{right:1rpx;bottom:1rpx}.copy-button.is-copied{color:#2e6b48}.copy-button.is-copied .copy-button-face{border-color:#c7dfcf;background:#eef7f1}.copy-button.is-copied .copy-icon::before{display:none}.copy-button.is-copied .copy-icon::after{top:6rpx;left:4rpx;right:auto;bottom:auto;width:20rpx;height:12rpx;border-top:0;border-right:0;border-radius:0;transform:rotate(-45deg)}.copy-button-pressed .copy-button-face{background:#e9eaed}.theme-dark .contact-card{color:#fff}.theme-dark .copy-button{color:#c7c7ce}.theme-dark .copy-button-face{border-color:#303034;background:rgba(127,127,127,.1)}.theme-dark .copy-button.is-copied{color:#a4d1b6}.theme-dark .copy-button.is-copied .copy-button-face{border-color:#2a4334;background:#0c1811}.theme-dark .copy-button-pressed .copy-button-face{background:#242426}
