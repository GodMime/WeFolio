@import "../../../styles/portfolio-theme.wxss";
@import "../../../styles/portfolio-text-typography.wxss";


.profile-spacing {
  box-sizing: border-box;
}

.profile-section {
  padding: 12rpx 32rpx;
  text-align: center;
  box-sizing: border-box;
}

.profile-avatar {
  display: block;
  margin: 0 auto;
  width: 132rpx;
  height: 132rpx;
  border-radius: 50%;
}

.profile-name {
  margin-top: 18rpx;
  color: var(--portfolio-text-primary);
  font-size: 36rpx;
  font-weight: 900;
  line-height: 1.25;
}

.profile-line,
.profile-bio {
  color: var(--portfolio-text-secondary);
  font-size: 26rpx;
  line-height: 1.75;
  white-space: pre-wrap;
}

.profile-line {
  margin-top: 8rpx;
}

/* 简介的换行行为由上方与 .profile-line 的组合规则统一保证。 */
.profile-bio {
  display: block;
  margin: 22rpx auto 0;
  max-width: 620rpx;
  overflow-wrap: break-word;
  word-break: break-word;
}

.profile-tags {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-wrap: wrap;
  gap: 22rpx;
  margin-top: 22rpx;
}

.profile-tag {
  min-height: 48rpx;
  display: inline-flex;
  align-items: center;
  padding: 0 20rpx;
  color: #0f766e;
  font-size: 24rpx;
  line-height: 1.4;
  border: 1rpx solid #0f766e;
  border-radius: 999rpx;
  background: #ffffff;
  box-sizing: border-box;
}

.profile-tag-dot {
  width: 12rpx;
  height: 12rpx;
  flex: none;
  margin-right: 12rpx;
  border-radius: 50%;
}

.qr-image {
  display: block;
  width: 280rpx;
  height: 280rpx;
  margin: 24rpx auto 0;
  border-radius: 32rpx;
}
.profile-section {
  color: var(--portfolio-text-primary);
}

.profile-horizontal {
  text-align: left;
}

.profile-bordered {
  padding: 32rpx;
  border-style: solid;
  border-radius: 24rpx;
}

/* 加框后正文宽度收窄，纵向布局的长英文姓名和职业也需要自然换行。 */
.profile-bordered .profile-identity {
  min-width: 0;
  overflow-wrap: break-word;
  word-break: break-word;
}

.profile-horizontal .profile-heading {
  display: flex;
  align-items: center;
  gap: 28rpx;
}

.profile-horizontal .profile-avatar {
  flex: none;
  margin: 0;
}

/* 姓名与职业过长时自然换行，隐藏头像后文字区占满可用宽度。 */
.profile-horizontal .profile-identity {
  flex: 1;
  min-width: 0;
  overflow-wrap: break-word;
  word-break: break-word;
}

.profile-horizontal .profile-name {
  margin-top: 0;
}

.profile-horizontal .profile-bio {
  margin-left: 0;
  margin-right: 0;
  max-width: 100%;
}

.profile-horizontal .profile-tags {
  justify-content: flex-start;
}

.profile-horizontal .qr-image {
  margin-left: 0;
  max-width: 100%;
}

.work-section-title {
  padding: 0 24rpx;
  color: #212529;
  font-size: 34rpx;
  font-weight: 900;
  line-height: 1.35;
  box-sizing: border-box;
}

.display-tag-scroll {
  height: 56rpx;
  margin-top: 24rpx;
  overflow: hidden;
  white-space: nowrap;
}

.display-tags {
  display: flex;
  align-items: center;
  gap: 28rpx;
  min-width: 100%;
  height: 56rpx;
  padding: 0 24rpx;
  white-space: nowrap;
  box-sizing: border-box;
}

.display-tag {
  flex: 0 0 auto;
  color: var(--portfolio-text-secondary);
  font-size: 28rpx;
  line-height: 56rpx;
  white-space: nowrap;
}

.display-tag.active {
  color: var(--portfolio-text-primary);
  font-weight: 900;
}

.work-grid {
  display: flex;
  flex-wrap: wrap;
  padding: 22rpx 6rpx 0;
  box-sizing: border-box;
}

.work-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  padding: 22rpx 20rpx 0;
  box-sizing: border-box;
}

.work-card {
  min-width: 0;
  box-sizing: border-box;
}

.grid-card {
  width: 50%;
  padding: 0 6rpx 18rpx;
  box-sizing: border-box;
}

.work-cover-wrap {
  position: relative;
  width: 100%;
  overflow: hidden;
  background: #f1f3f5;
}

.grid-cover {
  height: 236rpx;
  border-radius: 32rpx;
}

.list-cover {
  height: 430rpx;
  border-radius: 40rpx;
}

.work-cover {
  display: block;
  width: 100%;
  height: 100%;
}

.work-play-badge,
.single-work-play-badge {
  position: absolute;
  right: 16rpx;
  bottom: 16rpx;
  width: 54rpx;
  height: 54rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2rpx solid rgba(255, 255, 255, 0.82);
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.48);
  box-sizing: border-box;
}

.work-play-icon {
  width: 0;
  height: 0;
  margin-left: 5rpx;
  border-top: 10rpx solid transparent;
  border-bottom: 10rpx solid transparent;
  border-left: 16rpx solid #ffffff;
}

.work-copy {
  min-height: 10rpx;
  padding-top: 10rpx;
  box-sizing: border-box;
}

.work-title {
  overflow: hidden;
  color: #212529;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 1.35;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.work-desc {
  color: #868e96;
  font-size: 26rpx;
  line-height: 1.75;
  white-space: pre-wrap;
  overflow-wrap: break-word;
  word-break: break-word;
}

.single-work {
  padding: 0 20rpx;
  box-sizing: border-box;
}

.single-work-video,
.single-work-video-poster,
.single-work-image,
.single-work-media-placeholder {
  display: block;
  width: 100%;
  overflow: hidden;
  border-radius: 40rpx;
  background: #f1f3f5;
  box-sizing: border-box;
}

.single-work-video-poster {
  position: relative;
}

.single-work-video-cover {
  display: block;
  width: 100%;
  height: 100%;
}

.single-work-media-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 236rpx;
  color: #868e96;
  font-size: 24rpx;
}

.single-work-copy {
  min-height: 16rpx;
  padding-top: 16rpx;
  box-sizing: border-box;
}

.single-work-title {
  color: #212529;
  font-size: 30rpx;
  font-weight: 800;
  line-height: 1.35;
}

.qr-section {
  padding: 12rpx 32rpx;
  text-align: center;
  box-sizing: border-box;
  color: var(--portfolio-text-primary);
}

.text-section {
  padding: 8rpx 34rpx;
  text-align: center;
  box-sizing: border-box;
}

.component-title {
  padding: 0 24rpx;
  color: #212529;
  font-size: 32rpx;
  font-weight: 900;
  line-height: 1.35;
  box-sizing: border-box;
}

.text-content {
  display: block;
  color: #868e96;
  font-size: 26rpx;
  line-height: 1.75;
  white-space: pre-wrap;
  overflow-wrap: break-word;
  word-break: break-word;
}

.qr-image {
  display: block;
  width: 280rpx;
  height: 280rpx;
  margin: 24rpx auto 0;
  border-radius: 32rpx;
}

.text-section.align-left {
  text-align: left;
}

.text-section.align-center {
  text-align: center;
}

.text-section.align-right {
  text-align: right;
}

.divider-section {
  width: 100%;
  box-sizing: border-box;
}
.portfolio-theme-dark .profile-name,
.portfolio-theme-dark .component-title,
.portfolio-theme-dark .work-section-title,
.portfolio-theme-dark .work-title,
.portfolio-theme-dark .single-work-title {
  color: var(--portfolio-text-primary);
}

.portfolio-theme-dark .profile-line,
.portfolio-theme-dark .profile-bio,
.portfolio-theme-dark .work-desc,
.portfolio-theme-dark .text-content {
  color: var(--portfolio-text-secondary);
}
