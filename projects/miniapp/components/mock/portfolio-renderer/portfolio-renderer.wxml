<view class="portfolio-theme-{{themeMode}}">
<view wx:if="{{component.unsupported}}" class="single-work-media-placeholder">{{component.errorMessage || '暂不支持的组件'}}</view>
<block wx:elif="{{component.componentType === 'PROFILE'}}">
<view class="profile-spacing" style="{{component.profile.spacingStyle}}">
  <view class="profile-section portfolio-theme-{{themeMode}} {{component.profile.layout === 'HORIZONTAL' ? 'profile-horizontal' : ''}} {{component.profile.borderVisible ? 'profile-bordered' : ''}}" style="{{component.profile.style}}">
    <view class="profile-heading">
      <image wx:if="{{component.profile.visibleFields.avatar && component.profile.avatarUrl}}" class="profile-avatar" src="{{component.profile.avatarUrl}}" mode="aspectFill"></image>
      <view class="profile-identity">
        <view wx:if="{{component.profile.visibleFields.displayName && component.profile.displayName}}" class="profile-name">{{component.profile.displayName}}</view>
        <view wx:if="{{component.profile.visibleFields.profession && component.profile.profession}}" class="profile-line">{{component.profile.profession}}</view>
        <view wx:if="{{component.profile.visibleFields.city && component.profile.city}}" class="profile-line">{{component.profile.city}}</view>
      </view>
    </view>
    <text wx:if="{{component.profile.visibleFields.bio && component.profile.bio}}" class="profile-bio" space="nbsp">{{component.profile.bio}}</text>
    <view wx:if="{{component.profile.visibleFields.tags && component.profile.tags.length}}" class="profile-tags">
      <view
        wx:for="{{component.profile.tags}}"
        wx:key="name"
        wx:for-item="tag"
        class="profile-tag"
        style="color: {{tag.color || '#0f766e'}}; border-color: {{tag.color || '#0f766e'}};"
      >
        <view class="profile-tag-dot" style="background: {{tag.color || '#0f766e'}};"></view>
        <text>{{tag.name}}</text>
      </view>
    </view>
    <image
      wx:if="{{component.profile.visibleFields.wechatQr && component.profile.wechatQrUrl}}"
      class="profile-qr-image qr-image"
      src="{{component.profile.wechatQrUrl}}"
      mode="aspectFit"
      bindtap="handleProfileQr"
    ></image>
  </view>
</view>
</block>

<block wx:elif="{{component.componentType === 'WORK_GRID'}}">
  <view class="work-section-title">作品列表</view>
  <scroll-view wx:if="{{component.displayTags.length}}" scroll-x class="display-tag-scroll">
    <view class="display-tags">
      <view
        wx:for="{{component.displayTags}}"
        wx:key="groupKey"
        wx:for-item="tag"
        class="display-tag {{tag.active ? 'active' : ''}}"
        data-group-key="{{tag.groupKey}}"
        bindtap="handleDisplayTagTap"
      >{{tag.name}}</view>
    </view>
  </scroll-view>
  <view class="work-grid">
    <view wx:for="{{component.activeGroup.works}}" wx:key="workId" wx:for-item="work" class="work-card grid-card">
      <view
        class="work-cover-wrap grid-cover"
        data-work-id="{{work.workId}}"
        data-media-type="{{work.mediaType}}"
        data-media-url="{{work.previewUrl}}"
        data-cover-url="{{work.thumbnailUrl}}"
        data-title="{{work.title}}"
        bindtap="handleWorkTap"
        aria-role="button"
        aria-label="{{work.isVideo ? '播放视频' : '查看原图'}}{{work.title}}"
      >
        <image wx:if="{{work.thumbnailUrl}}" class="work-cover" src="{{work.thumbnailUrl}}" mode="aspectFill"></image><view wx:else class="single-work-media-placeholder">暂无视频封面</view>
        <view wx:if="{{work.isVideo}}" class="work-play-badge" aria-hidden="true"><view class="work-play-icon"></view></view>
      </view>
      <view class="work-copy">
        <view wx:if="{{component.showTitle && work.title}}" class="work-title">{{work.title}}</view>
        <view wx:if="{{component.layout === 'grid' && component.showDescription && work.description}}" class="work-desc">{{work.description}}</view>
      </view>
    </view>
  </view>
</block>

<block wx:elif="{{component.componentType === 'WORK_LIST'}}">
  <view class="work-section-title">作品列表</view>
  <scroll-view wx:if="{{component.displayTags.length}}" scroll-x class="display-tag-scroll">
    <view class="display-tags">
      <view
        wx:for="{{component.displayTags}}"
        wx:key="groupKey"
        wx:for-item="tag"
        class="display-tag {{tag.active ? 'active' : ''}}"
        data-group-key="{{tag.groupKey}}"
        bindtap="handleDisplayTagTap"
      >{{tag.name}}</view>
    </view>
  </scroll-view>
  <view class="work-list">
    <view wx:for="{{component.activeGroup.works}}" wx:key="workId" wx:for-item="work" class="work-card list-card">
      <view
        class="work-cover-wrap list-cover"
        data-work-id="{{work.workId}}"
        data-media-type="{{work.mediaType}}"
        data-media-url="{{work.previewUrl}}"
        data-cover-url="{{work.thumbnailUrl}}"
        data-title="{{work.title}}"
        bindtap="handleWorkTap"
        aria-role="button"
        aria-label="{{work.isVideo ? '播放视频' : '查看原图'}}{{work.title}}"
      >
        <image wx:if="{{work.thumbnailUrl}}" class="work-cover" src="{{work.thumbnailUrl}}" mode="aspectFill"></image><view wx:else class="single-work-media-placeholder">暂无视频封面</view>
        <view wx:if="{{work.isVideo}}" class="work-play-badge" aria-hidden="true"><view class="work-play-icon"></view></view>
      </view>
      <view class="work-copy">
        <view wx:if="{{component.showTitle && work.title}}" class="work-title">{{work.title}}</view>
        <view wx:if="{{component.layout === 'grid' && component.showDescription && work.description}}" class="work-desc">{{work.description}}</view>
        <view wx:if="{{component.showDescription && work.description}}" class="work-desc">{{work.description}}</view>
      </view>
    </view>
  </view>
</block>

<block wx:elif="{{component.componentType === 'SINGLE_WORK'}}">
  <view wx:if="{{!component.work}}" class="single-work-media-placeholder">请选择可用的图片、视频或动图</view>
  <view wx:if="{{component.work}}" class="single-work">
    <video
      wx:if="{{component.work.isVideo && activeSingleWorkVideoKey === component.componentKey}}"
      id="singleWorkVideo-{{component.componentKey}}"
      class="single-work-video"
      style="{{component.work.aspectRatioStyle}}"
      src="{{component.work.previewUrl}}"
      poster="{{component.work.thumbnailUrl}}"
      controls="{{true}}"
      autoplay="{{true}}"
      show-fullscreen-btn="{{true}}"
      show-center-play-btn="{{true}}"
      enable-progress-gesture="{{true}}"
      object-fit="cover"
      binderror="handleSingleWorkVideoError"
    ></video>
    <view
      wx:elif="{{component.work.isVideo}}"
      class="single-work-video-poster"
      style="{{component.work.aspectRatioStyle}}"
      data-work-id="{{component.work.workId}}"
      data-media-type="{{component.work.mediaType}}"
      data-media-url="{{component.work.previewUrl}}"
      data-cover-url="{{component.work.thumbnailUrl}}"
      data-title="{{component.work.title}}"
      bindtap="handleSingleWorkTap"
      aria-role="button"
      aria-label="播放视频{{component.work.title}}"
    >
      <image wx:if="{{component.work.thumbnailUrl}}" class="single-work-video-cover" src="{{component.work.thumbnailUrl}}" mode="aspectFill"></image>
      <view wx:else class="single-work-media-placeholder">暂无视频封面</view>
      <view class="single-work-play-badge" aria-hidden="true"><view class="work-play-icon"></view></view>
    </view>
    <image
      wx:elif="{{component.work.isAnimation && !singleWorkAnimationFailed}}"
      class="single-work-image"
      binderror="handleSingleWorkAnimationError"
      src="{{component.work.previewUrl}}"
      mode="widthFix"
      webp="{{true}}"
      data-work-id="{{component.work.workId}}"
      data-media-type="{{component.work.mediaType}}"
      data-media-url="{{component.work.previewUrl}}"
      data-cover-url="{{component.work.thumbnailUrl}}"
      data-title="{{component.work.title}}"
      bindtap="handleSingleWorkTap"
      aria-role="button"
      aria-label="查看原动图{{component.work.title}}"
    ></image>
    <image
      wx:elif="{{component.work.isAnimation}}"
      class="single-work-image"
      src="{{component.work.thumbnailUrl}}"
      mode="widthFix"
      data-work-id="{{component.work.workId}}"
      data-media-type="{{component.work.mediaType}}"
      data-media-url="{{component.work.thumbnailUrl}}"
      data-cover-url="{{component.work.thumbnailUrl}}"
      data-title="{{component.work.title}}"
      bindtap="handleSingleWorkTap"
      aria-role="button"
      aria-label="查看动图封面{{component.work.title}}"
    ></image>
    <image
      wx:elif="{{component.work.previewUrl && !imageFailed}}"
      class="single-work-image"
      binderror="handleImageError"
      src="{{component.work.previewUrl}}"
      mode="widthFix"
      data-work-id="{{component.work.workId}}"
      data-media-type="{{component.work.mediaType}}"
      data-media-url="{{component.work.previewUrl}}"
      data-cover-url="{{component.work.thumbnailUrl}}"
      data-title="{{component.work.title}}"
      bindtap="handleSingleWorkTap"
      aria-role="button"
      aria-label="查看原图{{component.work.title}}"
    ></image>
    <view wx:if="{{imageFailed}}" class="single-work-media-placeholder" bindtap="handleImageRetry">图片加载失败，点击重试</view>
    <view class="single-work-copy">
      <view wx:if="{{component.showTitle && component.work.title}}" class="single-work-title">{{component.work.title}}</view>
      <view wx:if="{{component.showDescription && component.work.description}}" class="work-desc">{{component.work.description}}</view>
    </view>
  </view>
</block>

<block wx:elif="{{component.componentType === 'QR_CONTACT'}}">
  <view class="qr-section">
    <image
      wx:if="{{component.qrContact.qrUrl}}"
      class="qr-image"
      src="{{component.qrContact.qrUrl}}"
      mode="aspectFit"
      bindtap="handlePreviewQr"
    ></image>
  </view>
</block>

<mock-structured-text-section wx:elif="{{component.componentType === 'TEXT_SECTION' || component.componentType === 'STRUCTURED_TEXT_SECTION'}}" view-model="{{component.viewModel}}" active="{{active}}" />
<mock-text-grid class="mock-opening-grid" wx:elif="{{component.componentType === 'TEXT_GRID'}}" view-model="{{component.viewModel}}" bindmeasure="handleGridMeasure" />
<mock-contact-info wx:elif="{{component.componentType === 'CONTACT_INFO'}}" config="{{component.config}}" copied-field="{{copiedField}}" theme-mode="{{themeMode}}" bindcopy="handleCopy" />
<mock-hyperlink wx:elif="{{component.componentType === 'HYPERLINK'}}" config="{{component.config}}" work="{{component.work}}" theme-mode="{{themeMode}}" bindhyperlink="handleHyperlink" />
<mock-video-carousel wx:elif="{{component.componentType === 'VIDEO_CAROUSEL'}}" config="{{component.config}}" works="{{component.works}}" component-key="{{component.componentKey}}" theme-mode="{{themeMode}}" bindworktap="handleWorkTap" />

<block wx:elif="{{component.componentType === 'DIVIDER'}}">
  <view class="divider-section" style="{{component.divider.style}}"></view>
</block>
</view>
