.hyperlink{--click-icon-bg:#212529;width:100%;min-width:0;color:#202528}.hyperlink.theme-dark{--click-icon-bg:#fff;color:#fff}.hyperlink-tap,.media-wrap{width:100%;box-sizing:border-box}.media-wrap{position:relative;overflow:hidden;border-radius:24rpx;background:transparent}.display-image{display:block;width:100%;min-height:180rpx}.click-icon{width:76rpx;height:76rpx;border-radius:50%;background-color:var(--click-icon-bg)}.click-icon.overlay{position:absolute;width:88rpx;height:88rpx;display:flex;align-items:center;justify-content:center;border:3rpx solid rgba(255,255,255,.9);border-radius:50%;box-shadow:0 8rpx 24rpx rgba(0,0,0,.16)}.click-icon.overlay-bottom-right{right:28rpx;bottom:28rpx}.click-icon.overlay-bottom-center{left:50%;bottom:28rpx;transform:translateX(-50%)}.click-icon.overlay-center{left:50%;top:50%;transform:translate(-50%,-50%)}.click-icon.overlay::before{content:'';position:absolute;left:-14rpx;right:-14rpx;top:-14rpx;bottom:-14rpx;border:3rpx solid rgba(33,37,41,.28);border-radius:50%;box-sizing:border-box}.theme-dark .click-icon.overlay::before{border-color:rgba(255,255,255,.35)}.click-icon-image{width:107%;height:107%;margin:-3.5%;border-radius:50%}.click-icon-row{display:flex;justify-content:center;padding-top:16rpx}.click-icon.below{width:76rpx;height:76rpx;flex:none}.empty{display:flex;align-items:center;justify-content:center;flex-direction:column;min-height:160rpx;background:rgba(127,127,127,.08);font-size:26rpx;border-radius:24rpx}.empty button{font-size:24rpx;margin:20rpx 0 0}
