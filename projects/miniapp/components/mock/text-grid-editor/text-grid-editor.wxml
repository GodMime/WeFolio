<view class="editor">
  <view class="editor-tabs"><view class="editor-tab {{tab === 'layout' ? 'active' : ''}}" data-value="layout" bindtap="handleTab">布局</view><view class="editor-tab {{tab === 'content' ? 'active' : ''}}" data-value="content" bindtap="handleTab">内容</view><view class="editor-tab {{tab === 'appearance' ? 'active' : ''}}" data-value="appearance" bindtap="handleTab">外观</view></view>
  <block wx:if="{{tab === 'layout'}}">
    <view class="help">最多 8 行 × 5 列。点选连续完整的矩形区域后合并。</view>
    <view class="row"><text>行数</text><input type="number" value="{{draft.rows}}" data-field="rows" bindinput="handleDimension"/><text>列数</text><input type="number" value="{{draft.columns}}" data-field="columns" bindinput="handleDimension"/><button size="mini" data-type="resize" bindtap="handleOperation">调整</button></view>
    <view class="cell-selector"><view wx:for="{{draft.cells}}" wx:key="cellKey" class="cell-option {{selectedMap[item.cellKey] ? 'selected' : ''}}" data-key="{{item.cellKey}}" bindtap="handleSelect">{{item.row + 1}}-{{item.column + 1}}</view></view>
    <view class="actions"><button size="mini" data-type="merge" bindtap="handleOperation">合并选中</button><button size="mini" data-type="split" bindtap="handleOperation">拆分选中</button><button size="mini" data-type="undo" bindtap="handleOperation">撤销 {{undoCount}}</button></view>
    <view class="row" wx:for="{{draft.columnWeights}}" wx:key="index"><text>第 {{index+1}} 列比例（1–4）</text><input type="number" value="{{item}}" data-field="columnWeights" data-array-index="{{index}}" bindinput="handleInput"/></view>
  </block>
  <block wx:elif="{{tab === 'content'}}">
    <view class="help">先选择单元格，再选择段落和文字片段。</view>
    <view class="cell-selector"><view wx:for="{{draft.cells}}" wx:key="cellKey" class="cell-option {{focusedCellIndex === index ? 'selected' : ''}}" data-index="{{index}}" bindtap="handleFocusCell">{{item.row + 1}}-{{item.column + 1}}</view></view>
    <block wx:if="{{focusedCell}}">
      <view class="detail-heading">{{focusedCell.row + 1}} 行 {{focusedCell.column + 1}} 列</view>
      <view class="row"><text>格内垂直对齐</text><picker range="{{choiceLabels.verticalAlignment}}" value="{{optionIndexes[focusedCell.verticalAlignment]}}" data-cell-index="{{focusedCellIndex}}" data-field="verticalAlignment" bindchange="handleChoice"><view class="choice">{{optionLabels[focusedCell.verticalAlignment]}}</view></picker></view>
      <view class="focus-options"><view wx:for="{{focusedCell.blocks}}" wx:key="blockKey" class="focus-option {{focusedBlockIndex === index ? 'selected' : ''}}" data-index="{{index}}" bindtap="handleSelectBlock">段落 {{index + 1}}</view><button size="mini" data-type="addParagraph" data-cell-index="{{focusedCellIndex}}" bindtap="handleOperation">＋ 段落</button></view>
      <block wx:if="{{focusedBlock}}">
        <view class="row"><text>段落对齐</text><picker range="{{choiceLabels.alignment}}" value="{{optionIndexes[focusedBlock.alignment]}}" data-cell-index="{{focusedCellIndex}}" data-block-index="{{focusedBlockIndex}}" data-field="alignment" bindchange="handleChoice"><view class="choice">{{optionLabels[focusedBlock.alignment]}}</view></picker><button size="mini" data-type="removeParagraph" data-cell-index="{{focusedCellIndex}}" data-block-index="{{focusedBlockIndex}}" bindtap="handleOperation">删除段</button></view>
        <view class="row"><text>行距 0.5–3.0</text><view class="stepper"><button data-scope="block" data-field="lineHeight" data-delta="-0.1" bindtap="handleStep" disabled="{{focusedBlock.lineHeight <= 0.5}}">−</button><input type="digit" value="{{focusedBlock.lineHeight}}" placeholder="沿用默认" data-cell-index="{{focusedCellIndex}}" data-block-index="{{focusedBlockIndex}}" data-field="lineHeight" bindinput="handleInput"/><button data-scope="block" data-field="lineHeight" data-delta="0.1" bindtap="handleStep" disabled="{{focusedBlock.lineHeight >= 3}}">＋</button></view></view>
        <view class="row"><text>上间距 0–128</text><view class="stepper"><button data-scope="block" data-field="marginTopRpx" data-delta="-1" bindtap="handleStep" disabled="{{focusedBlock.marginTopRpx <= 0}}">−</button><input type="number" value="{{focusedBlock.marginTopRpx}}" data-cell-index="{{focusedCellIndex}}" data-block-index="{{focusedBlockIndex}}" data-field="marginTopRpx" bindinput="handleInput"/><button data-scope="block" data-field="marginTopRpx" data-delta="1" bindtap="handleStep" disabled="{{focusedBlock.marginTopRpx >= 128}}">＋</button></view></view>
        <view class="row"><text>下间距 0–128</text><view class="stepper"><button data-scope="block" data-field="marginBottomRpx" data-delta="-1" bindtap="handleStep" disabled="{{focusedBlock.marginBottomRpx <= 0}}">−</button><input type="number" value="{{focusedBlock.marginBottomRpx}}" data-cell-index="{{focusedCellIndex}}" data-block-index="{{focusedBlockIndex}}" data-field="marginBottomRpx" bindinput="handleInput"/><button data-scope="block" data-field="marginBottomRpx" data-delta="1" bindtap="handleStep" disabled="{{focusedBlock.marginBottomRpx >= 128}}">＋</button></view></view>
        <view class="focus-options"><view wx:for="{{focusedBlock.runs}}" wx:key="runKey" class="focus-option {{focusedRunIndex === index ? 'selected' : ''}}" data-index="{{index}}" bindtap="handleSelectRun">片段 {{index + 1}}</view><button size="mini" data-type="addRun" data-cell-index="{{focusedCellIndex}}" data-block-index="{{focusedBlockIndex}}" bindtap="handleOperation">＋ 片段</button></view>
        <view wx:if="{{focusedRun}}" class="run-editor">
          <textarea value="{{focusedRun.text}}" auto-height maxlength="-1" data-cell-index="{{focusedCellIndex}}" data-block-index="{{focusedBlockIndex}}" data-run-index="{{focusedRunIndex}}" data-field="text" bindinput="handleInput" placeholder="输入文字片段"/>
          <view class="grid-label">字体</view><view class="font-choice-list"><view wx:for="{{fontOptions}}" wx:key="value" class="font-choice {{focusedRun.fontFamily === item.value ? 'selected' : ''}} {{item.available ? '' : 'disabled'}}" data-value="{{item.value}}" bindtap="handleFontTap" aria-disabled="{{!item.available}}"><text>{{item.label}}</text><text wx:if="{{!item.available}}">当前设备不可用</text><text wx:if="{{!item.available && focusedRun.fontFamily === item.value}}">已保存字体保留，当前以系统字体预览</text></view></view>
          <picker range="{{choiceLabels.fontWeight}}" value="{{optionIndexes[focusedRun.fontWeight]}}" data-cell-index="{{focusedCellIndex}}" data-block-index="{{focusedBlockIndex}}" data-run-index="{{focusedRunIndex}}" data-field="fontWeight" bindchange="handleChoice"><view class="choice">字重：{{optionLabels[focusedRun.fontWeight]}}</view></picker>
          <view class="row"><text>字号 10–96</text><view class="stepper"><button data-scope="run" data-field="fontSizeRpx" data-delta="-1" bindtap="handleStep" disabled="{{focusedRun.fontSizeRpx <= 10}}">−</button><input type="number" value="{{focusedRun.fontSizeRpx}}" data-cell-index="{{focusedCellIndex}}" data-block-index="{{focusedBlockIndex}}" data-run-index="{{focusedRunIndex}}" data-field="fontSizeRpx" bindinput="handleInput"/><button data-scope="run" data-field="fontSizeRpx" data-delta="1" bindtap="handleStep" disabled="{{focusedRun.fontSizeRpx >= 96}}">＋</button></view></view>
          <view class="grid-label">文字颜色</view><mock-text-color-editor color="{{focusedRun.color}}" active="{{tab === 'content'}}" bindchange="handleRunColor" />
          <button size="mini" data-type="removeRun" data-cell-index="{{focusedCellIndex}}" data-block-index="{{focusedBlockIndex}}" data-run-index="{{focusedRunIndex}}" bindtap="handleOperation">删除当前片段</button>
        </view>
      </block>
    </block>
  </block>
  <block wx:elif="{{tab === 'appearance'}}">
    <view class="row"><text>显示边框</text><switch checked="{{draft.cellBorder}}" bindchange="handleBorder"/></view>
    <view class="grid-label">格子底色</view><mock-text-color-editor inline="{{true}}" label="格子底色" black-color="#000000" color="{{draft.cellBackground}}" active="{{tab === 'appearance'}}" data-field="cellBackground" bindchange="handleGridColor" />
    <block wx:if="{{draft.cellBorder}}"><view class="grid-label">线框颜色</view><mock-text-color-editor inline="{{true}}" palette="border" label="线框颜色" color="{{draft.cellBorderColor}}" active="{{tab === 'appearance'}}" data-field="cellBorderColor" bindchange="handleGridColor" /><view class="row"><text>线宽 1–12</text><view class="stepper"><button data-scope="grid" data-field="cellBorderWidthRpx" data-delta="-1" bindtap="handleStep" disabled="{{draft.cellBorderWidthRpx <= 1}}">−</button><input type="number" value="{{draft.cellBorderWidthRpx}}" data-field="cellBorderWidthRpx" bindinput="handleInput"/><button data-scope="grid" data-field="cellBorderWidthRpx" data-delta="1" bindtap="handleStep" disabled="{{draft.cellBorderWidthRpx >= 12}}">＋</button></view></view><slider class="grid-border-width-slider" min="1" max="12" step="1" value="{{draft.cellBorderWidthRpx}}" bindchange="handleBorderWidth" activeColor="#212529" backgroundColor="#E9ECEF" block-color="#212529" block-size="20" /></block>
    <view class="row"><text>水平留白 0–96</text><view class="stepper"><button data-scope="grid" data-field="horizontalMarginRpx" data-delta="-1" bindtap="handleStep" disabled="{{draft.horizontalMarginRpx <= 0}}">−</button><input type="number" value="{{draft.horizontalMarginRpx}}" data-field="horizontalMarginRpx" bindinput="handleInput"/><button data-scope="grid" data-field="horizontalMarginRpx" data-delta="1" bindtap="handleStep" disabled="{{draft.horizontalMarginRpx >= 96}}">＋</button></view></view>
    <view class="row"><text>垂直留白 0–96</text><view class="stepper"><button data-scope="grid" data-field="verticalMarginRpx" data-delta="-1" bindtap="handleStep" disabled="{{draft.verticalMarginRpx <= 0}}">−</button><input type="number" value="{{draft.verticalMarginRpx}}" data-field="verticalMarginRpx" bindinput="handleInput"/><button data-scope="grid" data-field="verticalMarginRpx" data-delta="1" bindtap="handleStep" disabled="{{draft.verticalMarginRpx >= 96}}">＋</button></view></view>
    <view class="row"><text>格间距 0–48</text><view class="stepper"><button data-scope="grid" data-field="gapRpx" data-delta="-1" bindtap="handleStep" disabled="{{draft.gapRpx <= 0}}">−</button><input type="number" value="{{draft.gapRpx}}" data-field="gapRpx" bindinput="handleInput"/><button data-scope="grid" data-field="gapRpx" data-delta="1" bindtap="handleStep" disabled="{{draft.gapRpx >= 48}}">＋</button></view></view>
    <view class="row"><text>内边距 0–48</text><view class="stepper"><button data-scope="grid" data-field="cellPaddingRpx" data-delta="-1" bindtap="handleStep" disabled="{{draft.cellPaddingRpx <= 0}}">−</button><input type="number" value="{{draft.cellPaddingRpx}}" data-field="cellPaddingRpx" bindinput="handleInput"/><button data-scope="grid" data-field="cellPaddingRpx" data-delta="1" bindtap="handleStep" disabled="{{draft.cellPaddingRpx >= 48}}">＋</button></view></view>
    <view class="row"><text>圆角 0–48</text><view class="stepper"><button data-scope="grid" data-field="cellRadiusRpx" data-delta="-1" bindtap="handleStep" disabled="{{draft.cellRadiusRpx <= 0}}">−</button><input type="number" value="{{draft.cellRadiusRpx}}" data-field="cellRadiusRpx" bindinput="handleInput"/><button data-scope="grid" data-field="cellRadiusRpx" data-delta="1" bindtap="handleStep" disabled="{{draft.cellRadiusRpx >= 48}}">＋</button></view></view>
    <view class="row" wx:for="{{draft.rowMinHeightsRpx}}" wx:key="index"><text>第 {{index+1}} 行高（80–600）</text><view class="stepper"><button data-scope="row" data-field="rowMinHeightsRpx" data-array-index="{{index}}" data-delta="-1" bindtap="handleStep" disabled="{{item <= 80}}">−</button><input type="number" value="{{item}}" data-field="rowMinHeightsRpx" data-array-index="{{index}}" bindinput="handleInput"/><button data-scope="row" data-field="rowMinHeightsRpx" data-array-index="{{index}}" data-delta="1" bindtap="handleStep" disabled="{{item >= 600}}">＋</button></view></view>
  </block>
  <text wx:if="{{error}}" class="error">{{error}}</text>
  <view class="preview-title">效果预览</view><view wx:if="{{previewViewModel.cells && previewViewModel.cells.length}}" class="preview-card"><mock-text-grid view-model="{{previewViewModel}}" bindmeasure="handlePreviewMeasure" /></view><view wx:else class="help preview-empty">配置有效后显示预览</view>
</view>
