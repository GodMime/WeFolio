.editor{padding:24rpx;color:#17202a}.help{font-size:24rpx;color:#6b7280;margin-bottom:20rpx;line-height:1.6}.block-card{border:1rpx solid #d7dadd;border-radius:20rpx;padding:20rpx;margin:20rpx 0;background:#fff}.row{display:flex;align-items:center;justify-content:space-between;gap:12rpx;margin:16rpx 0}.row>text{font-size:24rpx;flex-shrink:0}.row input{flex:1;min-width:0;background:#f5f7fb;border-radius:10rpx;padding:12rpx;box-sizing:border-box;text-align:right;font-size:26rpx}.actions{display:flex;flex-wrap:wrap;gap:8rpx}.actions button{margin:0;flex-shrink:0;font-size:23rpx}.choice{padding:14rpx;background:#f5f7fb;border-radius:12rpx;font-size:24rpx}.add{text-align:center;color:#0f766e}.footer{margin-top:24rpx;justify-content:flex-end}.footer button{flex:1}.error{display:block;color:#b42318;margin:16rpx 0;font-size:24rpx}textarea{width:100%;min-height:80rpx;background:#f5f7fb;padding:16rpx;box-sizing:border-box;border-radius:12rpx;font-size:28rpx}.paragraph{margin:16rpx 0;padding:16rpx;background:#f5f7fb;border-radius:12rpx}.run-editor{background:#fff;padding:12rpx;border-radius:12rpx;margin:12rpx 0}.selected{color:#0f766e!important;border:2rpx solid #0f766e}.media-list{display:flex;flex-wrap:wrap;gap:12rpx}.media-choice{width:160rpx;padding:8rpx;border:2rpx solid transparent;border-radius:12rpx;box-sizing:border-box}.media-choice image,.video-placeholder{width:140rpx;height:100rpx;border-radius:8rpx}.video-placeholder{display:flex;align-items:center;justify-content:center;background:#17202a;color:#fff}.media-choice text{display:block;font-size:22rpx;margin-top:8rpx}
.editor-tabs{display:flex;gap:8rpx;margin-bottom:20rpx;padding:8rpx;border-radius:999rpx;background:#f1f3f5}.editor-tab{flex:1;padding:14rpx;text-align:center;border-radius:999rpx;color:#6b7280;font-size:25rpx;font-weight:700}.editor-tab.active{color:#fff;background:#17202a}.cell-selector,.focus-options{display:flex;flex-wrap:wrap;gap:10rpx;margin:16rpx 0}.cell-option,.focus-option{padding:14rpx 18rpx;border:2rpx solid #e4e7e7;border-radius:12rpx;background:#fff;font-size:24rpx}.cell-option.selected,.focus-option.selected{color:#fff!important;border-color:#17202a;background:#17202a}.focus-options button{margin:0;font-size:23rpx}.detail-heading,.preview-title{margin-top:24rpx;font-size:27rpx;font-weight:700}.preview-card{margin-top:14rpx;padding:16rpx;border:1rpx solid #e4e7e7;border-radius:18rpx;background:#fff}.preview-empty{margin-top:12rpx;padding:24rpx;border-radius:16rpx;background:#f5f7fb}
.stepper{display:flex;align-items:center;flex:1;max-width:360rpx}.stepper button{width:72rpx;min-width:72rpx;height:64rpx;margin:0;padding:0;border-radius:10rpx;font-size:30rpx;line-height:64rpx}.stepper button::after{border:0}.stepper input{height:64rpx;margin:0 8rpx;padding:8rpx;text-align:center}.font-choice-list{display:flex;flex-direction:column;gap:10rpx;margin:12rpx 0 18rpx}.font-choice{display:flex;flex-wrap:wrap;justify-content:space-between;gap:8rpx;padding:16rpx 18rpx;border:2rpx solid #e4e7e7;border-radius:12rpx;background:#fff;font-size:24rpx}.font-choice.selected{border-color:#0f766e;background:#ecfdf5}.font-choice.disabled{color:#9ca3af;background:#f5f7fb}.font-choice.disabled.selected{border-color:#9ca3af;background:#f5f7fb}.grid-label{margin-top:18rpx;font-size:24rpx;font-weight:700}.grid-border-width-slider{margin:0 8rpx 20rpx}
