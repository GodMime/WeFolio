@import "../../styles/portfolio-theme.wxss";

.schedule-query {
  padding: 8rpx 34rpx;
  text-align: center;
  box-sizing: border-box;
}

.schedule-query-entry,
.schedule-query-inline-shell {
  box-sizing: border-box;
}

.schedule-query-entry-spacer {
  height: 44rpx;
}

.component-title {
  padding: 0 24rpx;
  color: #212529;
  font-size: 32rpx;
  font-weight: 900;
  line-height: 1.35;
  box-sizing: border-box;
}

.section-desc {
  margin-top: 8rpx;
  color: #868e96;
  font-size: 26rpx;
  line-height: 1.75;
  white-space: pre-wrap;
}

.schedule-query-open-button {
  width: 320rpx;
  height: 72rpx;
  margin: 24rpx auto 0;
  padding: 0;
  color: #ffffff;
  font-size: 26rpx;
  line-height: 72rpx;
  border: 0;
  border-radius: 999rpx;
  background: #212529;
  box-sizing: border-box;
}

.schedule-query-open-button:active {
  opacity: 0.92;
}

.schedule-query-inline-shell .schedule-query-calendar {
  margin-top: 24rpx;
}

.schedule-query-modal-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 90;
  display: flex;
  align-items: flex-end;
  padding: 0;
  opacity: 0;
  pointer-events: none;
  background: rgba(17, 24, 39, 0.42);
  transition: opacity 180ms ease;
  box-sizing: border-box;
}

.schedule-query-modal-mask.visible {
  opacity: 1;
  pointer-events: auto;
}

.schedule-query-modal-panel {
  width: 100%;
  max-height: 82vh;
  overflow-y: auto;
  padding: 24rpx 32rpx calc(32rpx + env(safe-area-inset-bottom));
  border-radius: 56rpx 56rpx 0 0;
  background: #ffffff;
  box-shadow: 0 -18rpx 46rpx rgba(17, 24, 39, 0.18);
  box-sizing: border-box;
  transform: translateY(32rpx);
  transition: transform 180ms ease;
}

.schedule-query-modal-mask.visible .schedule-query-modal-panel {
  transform: translateY(0);
}

.schedule-query-modal-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  margin-bottom: 18rpx;
}

.schedule-query-modal-title {
  flex: 1 1 auto;
  min-width: 0;
  color: #212529;
  font-size: 30rpx;
  font-weight: 900;
  line-height: 1.3;
  text-align: left;
}

.schedule-query-close {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
  color: #59636f;
  font-size: 36rpx;
  font-weight: 700;
  line-height: 1;
  border-radius: 50%;
  background: #f3f6f9;
}

.schedule-query-calendar {
  padding: 24rpx;
  border: 1rpx solid #e9ecef;
  border-radius: 48rpx;
  background: #ffffff;
  box-sizing: border-box;
}

.schedule-query-month-bar {
  display: flex;
  align-items: center;
  justify-content: flex-start;
  gap: 12rpx;
}

.schedule-query-month-button {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
  color: #212529;
  font-size: 40rpx;
  font-weight: 700;
  line-height: 1;
  border: 1rpx solid #dee2e6;
  border-radius: 999rpx;
  background: #f5f6f7;
  box-sizing: border-box;
}

.schedule-query-month-text {
  flex: 1 1 auto;
  min-width: 0;
  color: #212529;
  font-size: 28rpx;
  font-weight: 900;
  line-height: 1.3;
  text-align: left;
  white-space: nowrap;
}

.schedule-query-month-picker {
  flex: none;
}

.schedule-query-month-picker-button {
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 18rpx;
  color: #495057;
  font-size: 22rpx;
  font-weight: 800;
  line-height: 1;
  border: 1rpx solid #dee2e6;
  border-radius: 999rpx;
  background: #f5f6f7;
  box-sizing: border-box;
  white-space: nowrap;
}

.schedule-query-state {
  min-height: 220rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-direction: column;
  gap: 16rpx;
  color: #868e96;
  font-size: 26rpx;
  line-height: 1.4;
}

.schedule-query-state.error {
  color: #b55656;
}

.schedule-query-retry {
  min-width: 120rpx;
  height: 52rpx;
  padding: 0 20rpx;
  color: #212529;
  font-size: 24rpx;
  font-weight: 800;
  line-height: 52rpx;
  border-radius: 999rpx;
  background: #e9ecef;
  box-sizing: border-box;
}

.schedule-query-weekdays {
  display: flex;
  align-items: center;
  margin: 20rpx -4rpx 0;
  color: #8793a0;
  font-size: 22rpx;
  font-weight: 800;
  line-height: 1.4;
}

.schedule-query-weekdays > view {
  width: calc(14.285714% - 8rpx);
  flex: 0 0 calc(14.285714% - 8rpx);
  min-width: 0;
  margin: 0 4rpx;
  text-align: center;
  box-sizing: border-box;
}

.schedule-query-days {
  display: flex;
  flex-wrap: wrap;
  margin: 8rpx -4rpx 0;
}

.schedule-calendar-day {
  width: calc(14.285714% - 8rpx);
  flex: 0 0 calc(14.285714% - 8rpx);
  min-width: 0;
  min-height: 92rpx;
  margin: 4rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-direction: column;
  gap: 6rpx;
  border: 1rpx solid #e9ecef;
  border-radius: 20rpx;
  background: #ffffff;
  box-sizing: border-box;
}

.schedule-calendar-day.muted {
  color: #b7c0ca;
  background: #f5f6f7;
}

.schedule-calendar-day.filled {
  border-color: #dee2e6;
  background: #f1f3f5;
}

.schedule-calendar-day.selected {
  color: #ffffff;
  border-color: #212529;
  background: #212529;
}

.schedule-query-day-number {
  font-size: 24rpx;
  font-weight: 900;
  line-height: 1;
}

.schedule-query-day-stack {
  max-width: 100%;
  min-width: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-direction: column;
  gap: 6rpx;
}

.schedule-query-day-meta {
  max-width: 100%;
  overflow: hidden;
  color: #697786;
  font-size: 18rpx;
  font-weight: 800;
  line-height: 1.1;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.schedule-calendar-day.muted .schedule-query-day-meta {
  color: #b7c0ca;
}

.schedule-calendar-day.selected .schedule-query-day-meta {
  color: #ffffff;
}

.schedule-query-day-dots {
  height: 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
}

.schedule-query-day-dot {
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
}

.schedule-query-slot-section {
  margin-top: 22rpx;
  text-align: left;
}

.schedule-query-slot-heading {
  color: #212529;
  font-size: 26rpx;
  font-weight: 900;
  line-height: 1.35;
}

.schedule-query-empty {
  min-height: 72rpx;
  margin-top: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #8793a0;
  font-size: 24rpx;
  border: 1rpx dashed #d8dee5;
  border-radius: 24rpx;
  background: #ffffff;
}

.schedule-query-slot-list {
  margin-top: 12rpx;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.schedule-query-slot {
  min-height: 82rpx;
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 12rpx 14rpx;
  border: 1rpx solid #e2e8f0;
  border-radius: 24rpx;
  background: #ffffff;
  box-sizing: border-box;
}

.schedule-query-slot.selected {
  border-color: #212529;
  background: #f5f6f7;
}

.schedule-query-slot-color {
  width: 18rpx;
  height: 44rpx;
  flex: none;
  border-radius: 999rpx;
}

.schedule-query-slot-copy {
  flex: 1 1 0;
  min-width: 0;
}

.schedule-query-slot-name {
  overflow: hidden;
  color: #212529;
  font-size: 26rpx;
  font-weight: 900;
  line-height: 1.25;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.schedule-query-slot-time {
  margin-top: 6rpx;
  color: #697786;
  font-size: 22rpx;
  line-height: 1.25;
}

.schedule-query-slot-check {
  width: 36rpx;
  height: 36rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
  color: #ffffff;
  font-size: 22rpx;
  font-weight: 900;
  border-radius: 50%;
  background: #212529;
}

.schedule-query-day-summary {
  margin-top: 16rpx;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.schedule-query-summary-item {
  min-height: 52rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 14rpx;
  padding: 0 14rpx;
  color: #59636f;
  font-size: 22rpx;
  border-radius: 8rpx;
  background: #f3f6f9;
  box-sizing: border-box;
}

.schedule-query-result {
  margin-top: 18rpx;
  padding: 16rpx;
  border-radius: 24rpx;
  text-align: left;
  box-sizing: border-box;
}

.schedule-query-result.available {
  color: #5c9e6e;
  background: #f1f7f2;
}

.schedule-query-result.unavailable {
  color: #b55656;
  background: #faf2f2;
}

.schedule-query-result-title {
  font-size: 26rpx;
  font-weight: 900;
  line-height: 1.35;
}

.schedule-query-result-desc {
  margin-top: 6rpx;
  font-size: 22rpx;
  line-height: 1.4;
}

.schedule-query-submit {
  width: 100%;
  height: 96rpx;
  margin: 22rpx 0 0;
  padding: 0;
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 900;
  line-height: 96rpx;
  border-radius: 999rpx;
  background: #212529;
  box-sizing: border-box;
}

.schedule-query-submit[disabled] {
  color: #ffffff;
  background: #a9b3bf;
}

.schedule-query-open-button::after,
.schedule-query-submit::after {
  border: 0;
}
.schedule-query {
  color: var(--portfolio-text-primary);
}

.schedule-query > .schedule-query-inline-shell .component-title,
.schedule-query > .schedule-query-entry .component-title {
  color: var(--portfolio-text-primary);
}

.schedule-query > .schedule-query-inline-shell .section-desc,
.schedule-query > .schedule-query-entry .section-desc {
  color: var(--portfolio-text-secondary);
}

.schedule-query.portfolio-theme-dark .schedule-query-open-button {
  color: var(--portfolio-text-primary);
  background: var(--portfolio-surface-muted);
}

.schedule-query.portfolio-theme-dark .schedule-query-inline-shell .schedule-query-calendar {
  color: var(--portfolio-text-primary);
  border-color: var(--portfolio-border);
  background: var(--portfolio-surface);
}

.schedule-query.portfolio-theme-dark .schedule-query-inline-shell .schedule-query-month-button,
.schedule-query.portfolio-theme-dark .schedule-query-inline-shell .schedule-query-month-picker-button {
  color: var(--portfolio-text-primary);
  border-color: var(--portfolio-border);
  background: var(--portfolio-surface-muted);
}

.schedule-query.portfolio-theme-dark .schedule-query-inline-shell .schedule-query-month-text,
.schedule-query.portfolio-theme-dark .schedule-query-inline-shell .schedule-query-slot-heading,
.schedule-query.portfolio-theme-dark .schedule-query-inline-shell .schedule-query-slot-name {
  color: var(--portfolio-text-primary);
}

.schedule-query.portfolio-theme-dark .schedule-query-inline-shell .schedule-query-state,
.schedule-query.portfolio-theme-dark .schedule-query-inline-shell .schedule-query-weekdays,
.schedule-query.portfolio-theme-dark .schedule-query-inline-shell .schedule-query-day-meta,
.schedule-query.portfolio-theme-dark .schedule-query-inline-shell .schedule-query-slot-time {
  color: var(--portfolio-text-secondary);
}

.schedule-query.portfolio-theme-dark .schedule-query-inline-shell .schedule-query-state.error {
  color: #dc9999;
}

.schedule-query.portfolio-theme-dark .schedule-query-inline-shell .schedule-query-retry {
  color: #212529;
  background: var(--portfolio-text-primary);
}

.schedule-query.portfolio-theme-dark .schedule-query-inline-shell .schedule-calendar-day {
  color: var(--portfolio-text-primary);
  border-color: var(--portfolio-border);
  background: var(--portfolio-surface-muted);
}

.schedule-query.portfolio-theme-dark .schedule-query-inline-shell .schedule-calendar-day.muted {
  color: var(--portfolio-text-muted);
  background: var(--portfolio-surface);
}

.schedule-query.portfolio-theme-dark .schedule-query-inline-shell .schedule-calendar-day.filled {
  border-color: var(--portfolio-border);
  background: var(--portfolio-surface);
}

.schedule-query.portfolio-theme-dark .schedule-query-inline-shell .schedule-calendar-day.muted .schedule-query-day-meta {
  color: var(--portfolio-text-muted);
}

.schedule-query.portfolio-theme-dark .schedule-query-inline-shell .schedule-calendar-day.selected {
  color: #212529;
  border-color: var(--portfolio-text-primary);
  background: var(--portfolio-text-primary);
}

.schedule-query.portfolio-theme-dark .schedule-query-inline-shell .schedule-calendar-day.selected .schedule-query-day-meta {
  color: #212529;
}

.schedule-query.portfolio-theme-dark .schedule-query-inline-shell .schedule-query-empty,
.schedule-query.portfolio-theme-dark .schedule-query-inline-shell .schedule-query-slot {
  color: var(--portfolio-text-secondary);
  border-color: var(--portfolio-border);
  background: var(--portfolio-surface-muted);
}

.schedule-query.portfolio-theme-dark .schedule-query-inline-shell .schedule-query-slot.selected {
  border-color: var(--portfolio-text-primary);
  background: var(--portfolio-surface);
}

.schedule-query.portfolio-theme-dark .schedule-query-inline-shell .schedule-query-slot-check {
  color: #212529;
  background: var(--portfolio-text-primary);
}

.schedule-query.portfolio-theme-dark .schedule-query-inline-shell .schedule-query-summary-item {
  color: var(--portfolio-text-secondary);
  background: var(--portfolio-surface-muted);
}

.schedule-query.portfolio-theme-dark .schedule-query-inline-shell .schedule-query-result.available {
  color: #8fc99e;
  background: rgba(92, 158, 110, 0.16);
}

.schedule-query.portfolio-theme-dark .schedule-query-inline-shell .schedule-query-result.unavailable {
  color: #dc9999;
  background: rgba(181, 86, 86, 0.16);
}

.schedule-query.portfolio-theme-dark .schedule-query-inline-shell .schedule-query-submit {
  color: #212529;
  background: var(--portfolio-text-primary);
}

.schedule-query.portfolio-theme-dark .schedule-query-inline-shell .schedule-query-submit[disabled] {
  color: var(--portfolio-text-muted);
  background: var(--portfolio-surface-muted);
}

.schedule-query-modal-panel {
  color: #212529;
}
